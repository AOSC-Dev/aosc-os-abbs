PKGNAME=sqlite
PKGSEC=database
PKGDEP="readline"
PKGDES="Full-featured and self-contained SQL database engine" 

ABTYPE=autosetup
AUTOSETUP_AFTER=(
    '--soname=0'
    '--prefix=/usr'
    '--enable-largefile'
    '--enable-threadsafe'
    '--disable-tcl'
    '--disable-editline'
    '--enable-readline'
    '--disable-amalgamation'
    '--enable-load-extension'
    '--enable-math'
    '--disable-json'
    '--enable-memsys5'
    '--enable-memsys3'
    '--enable-fts3'
    '--enable-fts4'
    '--enable-fts5'
    '--enable-update-limit'
    '--enable-geopoly'
    '--enable-rtree'
    '--enable-session'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
