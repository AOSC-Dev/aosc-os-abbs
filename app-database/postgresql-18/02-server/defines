PKGNAME=postgresql-18
PKGSEC=database
PKGDEP="postgresql-runtime-18 krb5 libxml2 linux-pam openssl python-3
        readline tcl util-linux llvm-runtime libxslt icu"
PKGDEP__ALPHA="${PKGDEP/llvm-runtime/}"
PKGDEP__IA64="${PKGDEP/llvm-runtime/}"
