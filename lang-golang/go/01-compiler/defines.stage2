PKGNAME=go
PKGSEC=devel
PKGDEP="glibc llvm"
PKGDEP__LOONGSON3="${PKGDEP/llvm/}"
BUILDDEP="inetutils llvm mercurial"
BUILDDEP__LOONGSON3="${BUILDDEP/llvm/}"
PKGDES="The Go language compiler and tools"

NOSTATIC=0
FAIL_ARCH="!(amd64|i486|armv6hf|armv7hf|arm64|loongarch64|loongarch64_nosimd|loongson3|ppc64el|riscv64)"

USECLANG=1
USECLANG__LOONGSON3=0
