PKGNAME=libgudev
PKGSEC=libs
PKGDEP="glib systemd"
BUILDDEP="gobject-introspection vala"
BUILDDEP__RETRO=""
PKGDES="GObject bindings for UDev"

MESON_AFTER=(
    '-Dintrospection=enabled'
    '-Dvapi=enabled'
    '-Dgtk_doc=false'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=disabled'
    '-Dvapi=disabled'
)

PKGBREAK="systemd<=1:247.2"
PKGREP="systemd<=1:247.2"
