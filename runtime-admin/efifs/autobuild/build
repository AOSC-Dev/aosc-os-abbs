if ab_match_arch amd64; then
    export EFI_ARCH="X64"
elif ab_match_arch arm64; then
    export EFI_ARCH="AARCH64"
elif ab_match_arch loongarch64 \
  || ab_match_arch loongarch64_nosimd; then
    export EFI_ARCH="LOONGARCH64"
elif ab_match_arch riscv64; then
    export EFI_ARCH="RISCV64"
elif ab_match_arch armv4; then
    export EFI_ARCH="ARM"
elif ab_match_arch i486; then
    export EFI_ARCH="IA32"
else
    aberr "Unsupported architecture."
fi

abinfo "Setting up EDK II ..."
make -C "$SRCDIR"/BaseTools
source "$SRCDIR"/edksetup.sh --reconfig

abinfo "Building EFI filesystem drivers ..."
"$SRCDIR"/EfiFsPkg/set_grub_cpu.sh "$EFI_ARCH"
build -a "$EFI_ARCH" -b RELEASE -t GCC -p EfiFsPkg/EfiFsPkg.dsc

abinfo "Installing EFI filesystem drivers ..."
install -Dvm644 "$SRCDIR"/Build/EfiFs/RELEASE_GCC/"$EFI_ARCH"/*.efi \
    -t "$PKGDIR"/usr/lib/efifs/
