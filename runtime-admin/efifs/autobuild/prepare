abinfo "Patching grub submodule ..."
cd "$SRCDIR"/../EfiFs/grub
ab_apply_patches "$SRCDIR"/../EfiFs/0001-GRUB-fixes.patch

abinfo "Patching EfiFS ..."
cd "$SRCDIR"/../EfiFs
ab_apply_patches "$SRCDIR"/autobuild/patches/*.patch.efifs

abinfo "Symlinking EfiFs to edk2/EfiFsPkg ..."
cd "$SRCDIR"
ln -sv ../EfiFs EfiFsPkg

if ab_match_arch riscv64; then
    # FIXME: /usr/include/gnu/stubs.h:14:11: fatal error: gnu/stubs-lp64.h: No such file or directory
    # Workaround comes from https://github.com/pbatard/EfiFs/blob/bfc6ae29ac15516bddb97928eaf1eda187a6d242/.github/workflows/linux_gcc_edk2.yml#L78
    abinfo "Symlinking missing header on riscv64 ..."
    ln -sv stubs-lp64d.h /usr/include/gnu/stubs-lp64.h
fi
