From f196853869b590ffdf5bdec2946b10f7b9dffcb6 Mon Sep 17 00:00:00 2001
From: Mikura Kyouka <13207280@qq.com>
Date: Wed, 30 Sep 2026 14:51:54 +0800
Subject: [PATCH 14/14] update-m1n1: adapt for new kernel DTB layout

---
 update-m1n1 | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/update-m1n1 b/update-m1n1
index 2fbd918..cdb6789 100755
--- a/update-m1n1
+++ b/update-m1n1
@@ -13,7 +13,7 @@ else
     . /usr/share/asahi-scripts/functions.sh
 fi
 
-if ! ls -d /usr/lib/aosc-os-arm64-boot/dtbs-kernel-$(basename $(ls -d /usr/lib/modules/*-aosc-asahi | sort -rV | head -1 ))/*.dtb 2>&1 >/dev/null; then
+if ! ls -d /usr/lib/aosc-os-arm64-boot/dtbs-kernel-$(basename $(ls -d /usr/lib/modules/*-aosc-asahi | sort -rV | head -1 )) 2>&1 >/dev/null; then
     echo "No kernel and device tree available, skipping update ..."
     exit 0
 fi
@@ -22,7 +22,7 @@ fi
 : ${M1N1:="$SOURCE/m1n1.bin"}
 : ${U_BOOT:="$SOURCE/u-boot-nodtb.bin"}
 : ${TARGET:="$1"}
-: ${DTBS:=/usr/lib/aosc-os-arm64-boot/dtbs-kernel-$(basename $(ls -d /usr/lib/modules/*-aosc-asahi | sort -rV | head -1 ))/*.dtb}
+: ${DTBS:=/usr/lib/aosc-os-arm64-boot/dtbs-kernel-$(basename $(ls -d /usr/lib/modules/*-aosc-asahi | sort -rV | head -1 ))}
 : ${CONFIG:=/etc/m1n1.conf}
 
 if [ -z "$DTBS" ]; then
-- 
2.55.0

