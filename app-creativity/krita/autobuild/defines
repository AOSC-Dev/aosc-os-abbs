PKGNAME=krita
PKGSEC=graphics
PKGDEP="exiv2 fftw fontconfig freetype fribidi gcc-runtime glibc gsl \
        harfbuzz imath kcompletion-5 kconfig-5 kcoreaddons-5 kcrash-5 \
        kguiaddons-5 ki18n-5 kitemviews-5 kseexpr kwidgetsaddons-5 \
        kwindowsystem-5 lcms2 libheif libjpeg-turbo libjxl libkdcraw-5 \
        libmypaint libpng libtiff libunibreak libwebp mlt opencolorio \
        openexr openjpeg poppler pyqt5 qt-5 quazip x11-lib zlib"
BUILDDEP="eigen extra-cmake-modules immer kdoctools lager sip xsimd zug"
BUILDDEP__AMD64="${BUILDDEP} vc"
PKGDES="Digital painting and graphics design program"

ABTYPE=cmakeninja
# Note: -DENABLE_UPDATERS=OFF, Enable updaters/update notifications.
CMAKE_AFTER=(
    '-DBUILD_COVERAGE=OFF'
    '-DBUILD_KRITA_QT_DESIGNER_PLUGINS=ON'
    '-DBUILD_TESTING=OFF'

    # Note: Still recommended by the upstream, by specifying this, Krita
    # built from 6.x source trees will still self-advertise as Krita 5.x.
    #
    # See release notes for version correspondence.
    '-DBUILD_WITH_QT6=OFF'

    '-DENABLE_BSYMBOLICFUNCTIONS=OFF'
    '-DENABLE_UPDATERS=OFF'
    '-DFOUNDATION_BUILD=OFF'
    '-DKDE_INSTALL_PREFIX_SCRIPT=OFF'
    '-DKDE_INSTALL_USE_QT_SYS_PATHS=ON'
    '-DHAVE_BACKTRACE_SUPPORT=OFF'
    '-DHAVE_MEMORY_LEAK_TRACKER=OFF'
    '-DHIDE_SAFE_ASSERTS=ON'
    '-DINSTALL_BENCHMARKS=OFF'
    '-DKRITA_DEVS=OFF'
    '-DKRITA_ENABLE_BROKEN_TESTS=OFF'
    '-DKRITA_ENABLE_PCH=ON'
    '-DLIMIT_LONG_TESTS=ON'
    '-DUSE_LOCK_FREE_HASH_TABLE=ON'
)

PKGBREAK="calligra<=3.0.0 calligra-l10n<=2.90"
PKGREP="$PKGBREAK"
