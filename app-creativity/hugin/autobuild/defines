PKGNAME=hugin
PKGSEC=graphics
PKGDEP="boost desktop-file-utils enblend-enfuse exiv2 openblas lensfun libpano13 \
        make perl-image-exiftool python-3 wxgtk3"
BUILDDEP="cmake swig tclap patchelf texlive"
PKGDES="Panorama photo stitcher"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    # despite the name of this option
    # it probes both lapack and openblas
    # and uses whatever found first
    "-DENABLE_LAPACK=ON"
    "-DBUILD_HSI=ON"
    "-DCMAKE_SKIP_RPATH=ON"
)
