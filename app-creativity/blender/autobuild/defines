PKGNAME=blender
PKGSEC=graphics
PKGDEP="desktop-file-utils ffmpeg fftw freetype glew pugixml \
        hicolor-icon-theme jack jemalloc libpng libsndfile libspnav libtiff \
        openal-soft opencollada opencolorio openexr openimageio openvdb\
        openjpeg opensubdiv libraw opencv numpy libxdg-basedir libdecor \
        materialx alembic shaderc libepoxy vulkan openshadinglanguage \
        ptex requests shared-mime-info xdg-utils libcl python-3 libharu \
        libwebp potrace rubberband pulseaudio pipewire libxkbcommon \
        draco tbb harfbuzz manifold"
PKGDEP__AMD64="${PKGDEP} embree openimagedenoise openpgl openusd rocm-base rocm-hiprt intel-oneapi-basekit"
PKGDEP__ARM64="${PKGDEP} embree openimagedenoise openusd rocm-base rocm-hiprt intel-oneapi-basekit"
PKGDEP__LOONGARCH64="${PKGDEP} embree rocm-base rocm-hiprt"
BUILDDEP="cmake jack boost llvm mold"
BUILDDEP__AMD64="${BUILDDEP} cuda"
BUILDDEP__ARM64="${BUILDDEP} cuda"
PKGDES="Fully integrated 3D graphics creation suite"

# Common options
ABTYPE=cmakeninja

CMAKE_AFTER=(
	"-C$SRCDIR/build_files/cmake/config/blender_full.cmake"
	'-DCMAKE_BUILD_TYPE=Release'
	'-DCMAKE_INSTALL_PREFIX=/usr'
	'-DWITH_LINKER_MOLD=ON'
	'-DWITH_NANOVDB=ON'
	'-DWITH_INSTALL_PORTABLE=OFF'
	"-DPYTHON_VERSION=${ABPY3VER}"
	'-DPYTHON_LIBPATH=/usr/lib'
	"-DPYTHON_LIBRARY=python${ABPY3VER}"
	"-DPYTHON_INCLUDE_DIRS=/usr/include/python${ABPY3VER}"
	'-DWITH_CYCLES_DEVICE_OPTIX=ON'
	'-DWITH_CYCLES=ON'
	'-DWITH_OPENSUBDIV=ON'
	'-DWITH_INTERNATIONAL=ON'
	'-DWITH_JACK_DYNLOAD=ON'
	'-DWITH_LLVM=ON'
	'-DWITH_MATERIALX=ON'
	'-DWITH_PYTHON_INSTALL=OFF'
	'-DWITH_PYTHON_INSTALL_NUMPY=OFF'
	'-DWITH_PYTHON_INSTALL_REQUESTS=OFF'
	'-DWITH_MEM_JEMALLOC=ON'
	'-DWITH_IMAGE_OPENJPEG=ON'
	'-DWITH_INPUT_NDOF=ON'
	'-DWITH_LINKER_GOLD=ON'
	'-DWITH_MOD_OCEANSIM=ON'
	'-DWITH_CYCLES_EMBREE=OFF'
	'-DWITH_HARFBUZZ=ON'
	'-DWITH_DRACO=ON'
)

# Feature set
CMAKE_AFTER__CUDA=(
	'-DCYCLES_CUDA_BINARIES_ARCH=sm_75;sm_80;sm_86;sm_87;sm_88;sm_89;sm_90;sm_100;sm_103;sm_110;sm_120;sm_121;compute_75;compute_121'
	'-DWITH_CYCLES_CUDA_BINARIES=ON'
)

CMAKE_AFTER__EMBREE=(
	'-DWITH_CYCLES_EMBREE=ON'
)

# Only amd64/arm64 has cuda and embree
CMAKE_AFTER__AMD64=(
	"${CMAKE_AFTER[@]}"
	"${CMAKE_AFTER__CUDA[@]}"
	"${CMAKE_AFTER__EMBREE[@]}"
	'-DWITH_CYCLES_ONEAPI_BINARIES=ON'
	'-DWITH_CYCLES_HIP_BINARIES=ON'
	'-DWITH_CYCLES_DEVICE_ONEAPI=OFF'
	'-DWITH_CYCLES_DEVICE_HIPRT=OFF'
	'-DHIP_ROOT_DIR=/usr/lib/rocm'
	'-DHIPRT_INCLUDE_DIR=/usr/lib/rocm/include'
)
CMAKE_AFTER__ARM64=(
	"${CMAKE_AFTER[@]}"
	"${CMAKE_AFTER__CUDA[@]}"
	"${CMAKE_AFTER__EMBREE[@]}"
	'-DWITH_CYCLES_HIP_BINARIES=ON'
	'-DWITH_CYCLES_DEVICE_HIPRT=OFF'
	'-DHIP_ROOT_DIR=/usr/lib/rocm'
	'-DHIPRT_INCLUDE_DIR=/usr/lib/rocm/include'
)
CMAKE_AFTER__LOONGARCH64=(
	"${CMAKE_AFTER[@]}"
	"${CMAKE_AFTER__EMBREE[@]}"
	'-DWITH_CYCLES_HIP_BINARIES=ON'
	'-DWITH_CYCLES_DEVICE_HIPRT=OFF'
	'-DHIP_ROOT_DIR=/usr/lib/rocm'
	'-DHIPRT_INCLUDE_DIR=/usr/lib/rocm/include'
)

AB_FLAGS_O3=1

# FIXME: Not enough RAM on any of our MIPS builders.
NOLTO__LOONGSON3=1
