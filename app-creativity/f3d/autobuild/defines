PKGNAME=f3d
PKGSEC=graphics
PKGDEP="vtk netcdf freetype openexr alembic assimp \
        opencascade libtiff python-3 hdf5 \
        draco openjdk libwebp utfcpp"
PKGDEP__AMD64="${PKGDEP} openusd"
PKGDEP__ARM64="${PKGDEP} openusd"
BUILDDEP="nlohmann-json pybind11 eigen"
PKGDES="Fast and minimalist 3D viewerfast and minimalist 3D viewer"
CMAKE_AFTER=(
	'-DF3D_BINDINGS_C=ON'
	'-DF3D_BINDINGS_JAVA=ON'
	'-DF3D_BINDINGS_PYTHON=ON'
	'-DF3D_BINDINGS_PYTHON_GENERATE_STUBS=OFF'
	'-DF3D_MODULE_EXR=ON'
	'-DF3D_MODULE_WEBP=ON'
	'-DF3D_MODULE_RAYTRACING=OFF'
	'-DF3D_PLUGIN_BUILD_ALEMBIC=ON'
	'-DF3D_PLUGIN_BUILD_ASSIMP=ON'
	'-DF3D_PLUGIN_BUILD_VDB=ON'
	'-DF3D_PLUGIN_BUILD_OCCT=ON'
	'-DF3D_PLUGIN_BUILD_DRACO=ON'
	'-DF3D_PLUGIN_BUILD_USD=OFF'
)

CMAKE_AFTER__OPENUSD=(
	'-DF3D_PLUGIN_BUILD_USD=ON'
)

CMAKE_AFTER__AMD64=(
	"${CMAKE_AFTER[@]}"
	"${CMAKE_AFTER__EMBREE[@]}"
)
CMAKE_AFTER__ARM64=(
	"${CMAKE_AFTER[@]}"
	"${CMAKE_AFTER__EMBREE[@]}"
)
