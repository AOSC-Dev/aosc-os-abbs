From 9bbf9ef9470c12e42b964d627aa5874c7dfaf880 Mon Sep 17 00:00:00 2001
From: Suyun <suyun@aosc.io>
Date: Mon, 23 Nov 2026 00:05:01 +0800
Subject: [PATCH] hadrian/rts: fix unregisterised build for gcc 15+

Ref: e22ad9972091e29ae56ed77686d3c8f1f492e219.
---
 rts/include/rts/NonMoving.h    | 8 ++++++++
 rts/include/stg/MiscClosures.h | 4 ++++
 2 files changed, 12 insertions(+)

diff --git a/rts/include/rts/NonMoving.h b/rts/include/rts/NonMoving.h
index 35a04fe940..1d25418c28 100644
--- a/rts/include/rts/NonMoving.h
+++ b/rts/include/rts/NonMoving.h
@@ -18,6 +18,14 @@ struct StgClosure_;
 struct StgThunk_;
 struct Capability_;
 
+#if IN_STG_CODE
+
+EFF_(updateRemembSetPushClosure_);
+
+EFF_(updateRemembSetPushThunk_);
+
+#else
+
 /* This is called by the code generator */
 extern DLL_IMPORT_RTS
 void updateRemembSetPushClosure_(StgRegTable *reg, struct StgClosure_ *p);
diff --git a/rts/include/stg/MiscClosures.h b/rts/include/stg/MiscClosures.h
index 541548d4ed..47c3267711 100644
--- a/rts/include/stg/MiscClosures.h
+++ b/rts/include/stg/MiscClosures.h
@@ -664,7 +664,11 @@ extern StgWord      CCS_SYSTEM[];
 //    'GHC.StgToCmm.Prof'
 // as opposed to real prototype declared in
 //    'rts/include/rts/prof/CCS.h'
+#if IN_STG_CODE
+EFF_(enterFunCCS);
+#else
 void enterFunCCS (void *reg, void *ccsfn);
+#endif
 void * pushCostCentre (void *ccs, void *cc);
 
 // Capability.c
-- 
2.47.3

