PKGNAME=alsa-plugins
PKGDES="Extra ALSA plugins"
PKGSEC=libs
PKGDEP="alsa-lib"
# Note: Soft dependencies used, as the plugins are not loaded at runtime
# if not specified.
BUILDDEP="pulseaudio speex jack libsamplerate ffmpeg"
BUILDDEP__RETRO=""

AUTOTOOLS_AFTER=(
    '--disable-oss'
    '--enable-mix'
    '--enable-usbstream'
    '--enable-arcamav'
    '--enable-jack'
    '--enable-pulseaudio'
    '--enable-samplerate'
    '--disable-maemo-plugin'
    '--disable-maemo-resource-manager'
    '--enable-libav'
    '--enable-a52'
    '--enable-lavrate'
    '--enable-speexdsp'
    '--enable-aaf'
    '--with-speex=lib'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-jack'
    '--disable-pulseaudio'
    '--disable-samplerate'
    '--disable-libav'
    '--disable-speexdsp'
    '--without-speex'
)
