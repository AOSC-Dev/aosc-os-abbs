PKGNAME=openal-soft
PKGSEC=libs
PKGDEP="ffmpeg sdl2 sdl-sound"
PKGDEP__RETRO="ffmpeg"
BUILDDEP="pulseaudio jack portaudio libsndfile"
BUILDDEP__RETRO=""
PKGDES="Cross platform 3D audio library"

ABTYPE=cmakeninja
PKGPROV="openal libal libal-soft"

# FIXME: When PipeWire is enabled but the daemon is not launched, OpenAL would
# fail to produce any audio (we still default to PulseAudio).
CMAKE_AFTER=(
    '-DALSOFT_BACKEND_PIPEWIRE=OFF'
)
CMAKE_AFTER__ARM64=(
    "${CMAKE_AFTER[@]}"
    '-DALSOFT_CPUEXT_NEON=OFF'
)
CMAKE_AFTER__PPC64EL=(
    # FIXME: 
    # /var/cache/acbs/build/acbs.1mk29k76/openal-soft/alsoft-modules/phase_shifter.cppm:22:8: internal compiler error: Segmentation fault 
    # https://gitlab.com/freedesktop-sdk/freedesktop-sdk/-/work_items/2006
    "${CMAKE_AFTER[@]}"
    '-DALSOFT_ENABLE_MODULES=OFF'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
