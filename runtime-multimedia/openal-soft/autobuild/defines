PKGNAME=openal-soft
PKGSEC=libs
PKGDEP="ffmpeg sdl2 sdl-sound"
PKGDEP__RETRO="ffmpeg"
BUILDDEP="pulseaudio jack portaudio libsndfile"
BUILDDEP__RETRO=""
PKGDES="Cross platform 3D audio library"

# FIXME: Possible regression with CMake 4.5's handling of toolchain module
# manifests, when building with Ninja.
#
#   FAILED: [code=1] CMakeFiles/@cmake_cxx_std@synth_0.dir/f6733e1179a8.bmi.ddi
#   /usr/bin/g++   -O2 -g -DNDEBUG -std=gnu++20 -Wunused -Wall -Wextra -Wshadow -Wconversion -Wcast-align -Wpedantic -Wformat -Wformat=2 -Wold-style-cast -Wnon-virtual-dtor -Woverloaded-virtual -Wtrampolines -Wbidi-chars=any -Wno-interference-size -Werror=undef -Werror=format-security -ftrivial-auto-var-init=pattern -fno-math-errno -fmodule-only -E -x c++ /usr/lib/gcc/x86_64-aosc-linux-gnu/16/include/c++/bits/std.compat.cc -MT CMakeFiles/@cmake_cxx_std@synth_0.dir/f6733e1179a8.bmi.ddi -MD -MF CMakeFiles/@cmake_cxx_std@synth_0.dir/f6733e1179a8.bmi.ddi.d -fmodules-ts -fdeps-file=CMakeFiles/@cmake_cxx_std@synth_0.dir/f6733e1179a8.bmi.ddi -fdeps-target=CMakeFiles/@cmake_cxx_std@synth_0.dir/f6733e1179a8.bmi -fdeps-format=p1689r5 -o CMakeFiles/@cmake_cxx_std@synth_0.dir/f6733e1179a8.bmi.ddi.i
#   /usr/lib/gcc/x86_64-aosc-linux-gnu/16/include/c++/bits/std.compat.cc:356:5: error: ‘__cpp_lib_math_special_functions’ is not defined, evaluates to ‘0’ [-Werror=undef]
#     356 | #if __cpp_lib_math_special_functions && !defined(STD_COMPAT)
#         |     ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#   cc1plus: some warnings being treated as errors
#
# On LoongArch, we see a different error during CMake configuration:
#
#   No SOURCES given to target: @cmake_cxx_std@synth_0
#
# This does not happen with GNU Make, so use it as a workaround for now.
ABTYPE=cmake
PKGPROV="openal libal libal-soft"

# FIXME: When PipeWire is enabled but the daemon is not launched, OpenAL would
# fail to produce any audio (we still default to PulseAudio).
CMAKE_AFTER=(
    '-DALSOFT_BACKEND_PIPEWIRE=OFF'
)
CMAKE_AFTER__ARM64=(
    "${CMAKE_AFTER[@]}"
    '-DALSOFT_CPUEXT_NEON=OFF'
)
CMAKE_AFTER__PPC64EL=(
    # FIXME: 
    # /var/cache/acbs/build/acbs.1mk29k76/openal-soft/alsoft-modules/phase_shifter.cppm:22:8: internal compiler error: Segmentation fault 
    # https://gitlab.com/freedesktop-sdk/freedesktop-sdk/-/work_items/2006
    "${CMAKE_AFTER[@]}"
    '-DALSOFT_ENABLE_MODULES=OFF'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
