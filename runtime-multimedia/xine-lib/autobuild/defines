PKGNAME=xine-lib
PKGDES="A multimedia playback engine"
PKGSEC=libs
PKGDEP="ffmpeg a52dec aalib faad2 gdk-pixbuf glu imagemagick jack \
        libbluray libcaca dcadec libdvdnav libmad libmng libmodplug libmpcdec \
        libvdpau samba vcdimager wavpack libnsl2"
PKGDEP__RETRO=" \
        ffmpeg faad2 gdk-pixbuf glu imagemagick \
        libdvdnav libmad libmng libmodplug libmpcdec \
        samba vcdimager wavpack libnsl2"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--with-wavpack'
    '--enable-vdpau'
    '--with-external-dvdnav'
    '--disable-optimizations'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-vdpau'
    '--disable-w32dll'
)

# FIXME: configure: error: source directory already configured; run "make dist clean" there first
ABSHADOW=0
FAIL_ARCH="!(mainline|retro)"
