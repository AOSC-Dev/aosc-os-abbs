PKGNAME=libde265
PKGDES="An H.265 video codec implementation"
PKGDEP="gcc-runtime"
BUILDDEP="gdk-pixbuf"
PKGSEC=libs

ABTYPE=cmakeninja
# Note: sherlock265 requires Qt.
CMAKE_AFTER=(
    '-DENABLE_SHERLOCK265=OFF'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
