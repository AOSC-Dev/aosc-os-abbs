PKGNAME=farstream
PKGSEC=net
PKGDEP="gstreamer libnice"
# Note: gtk-doc is required for re-generation.
BUILDDEP="gobject-introspection gtk-doc"
PKGDES="Audio/video communications framework"

# FIXME: Build fails with parallelism.
#
# libtool:   error: cannot find the library 'libfarstream-0.2.la' or unhandled argument 'libfarstream-0.2.la'
NOPARALLEL=1

AUTOTOOLS_AFTER=(
    '--enable-introspection'
    '--disable-gtk-doc'
)
