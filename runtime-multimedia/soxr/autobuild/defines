PKGNAME=soxr
PKGSEC=libs
PKGDEP="glibc"
PKGDES="Library for constant resampling ratio"

CMAKE_AFTER=(
    '-DBUILD_EXAMPLES=OFF'
    '-DBUILD_SHARED_LIBS=ON'
    '-DVISIBILITY_HIDDENL=ON'
    '-DWITH_AVFFT=ON'
    '-DWITH_DOUBLE_PRECISION=ON'
    '-DWITH_LSR_BINDINGS=ON'
    '-DWITH_OPENMP=ON'
    '-DWITH_PFFFT=ON'
    '-DWITH_SIMD=ON'
    '-DLIB_INSTALL_DIR=/usr/lib'
)
CMAKE_AFTER__ARMV4=(
    "${CMAKE_AFTER[@]}"
# Note: CR32S requires SIMD and only NEON is supported.
    '-DWITH_CR32S=OFF'
)
CMAKE_AFTER__ARMV5TE=(
    "${CMAKE_AFTER[@]}"
# Note: CR32S requires SIMD and only NEON is supported.
    '-DWITH_CR32S=OFF'
)
CMAKE_AFTER__ARMV6HF=(
    "${CMAKE_AFTER[@]}"
# Note: CR32S requires SIMD and only NEON is supported.
    '-DWITH_CR32S=OFF'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
