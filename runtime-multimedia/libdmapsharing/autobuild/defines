PKGNAME=libdmapsharing
PKGSEC=libs
PKGDEP="libsoup avahi gstreamer gdk-pixbuf"
# Note: gtk-doc is required for re-generation.
BUILDDEP="gtk-doc"
PKGDES="Library to implement the DMAP family of protocols"

ABTYPE=autotools
# FIXME: Build system installs gtk-doc HTML regardless of
# --disable-gtk-doc, removing manually in beyond.
AUTOTOOLS_AFTER=(
    '--with-mdns=avahi'
    '--disable-gtk-doc'
    '--disable-tests'
)

# FIXME: make[2]: *** No rule to make target '*.c', needed by 'unit-test.stamp'.  Stop.
ABSHADOW=0

PKGBREAK="rhythmbox<=3.4.7 grilo-plugins<=0.3.15-1"
