PKGNAME=aom
PKGDES="AV1 Video Codec Library"
PKGDEP="gcc-runtime"
BUILDDEP__AMD64="${BUILDDEP} yasm"
BUILDDEP__I486="${BUILDDEP} yasm"
PKGSEC="libs"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    "-DBUILD_SHARED_LIBS=1"
    "-DENABLE_DOCS=OFF"
)
CMAKE_AFTER__ARM_NO_NEON=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_NEON=OFF'
    '-DENABLE_NEON_DOTPROD=OFF'
    '-DENABLE_NEON_I8MM=OFF'
)
# Note: ARMv4, ARMv5TE, and ARMv6 (Hard Float) are not NEON targets.
CMAKE_AFTER__ARMV4=(
    "${CMAKE_AFTER__ARM_NO_NEON[@]}"
)
CMAKE_AFTER__ARMV5TE=(
    "${CMAKE_AFTER__ARM_NO_NEON[@]}"
)
CMAKE_AFTER__ARMV6HF=(
    "${CMAKE_AFTER__ARM_NO_NEON[@]}"
)

# FIXME: lto1: fatal error: target specific builtin not available
NOLTO__RISCV64=1

# FIXME: lto1: error: target attribute or pragma changes AltiVec ABI
NOLTO__POWERPC=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
