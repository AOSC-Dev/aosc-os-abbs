PKGNAME=dav1d
PKGDES="A fast AV1 decoder implementation from VideoLAN"
PKGDEP="glibc"
BUILDDEP="nasm"
PKGSEC=libs

ABUSECMAKEBUILD=0

ABTYPE="meson"
MESON_AFTER=(
    '-Denable_docs=false'
)
# FIXME: rvv asm functions referred to but not build on riscv32
MESON_AFTER__RISCV32=(
    "${MESON_AFTER[@]}"
    '-Denable_asm=false'
)
MESON_AFTER__RISCV32IMA=(
    "${MESON_AFTER[@]}"
    '-Denable_asm=false'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
