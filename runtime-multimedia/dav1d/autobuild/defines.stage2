PKGNAME=dav1d
PKGDES="Fast AV1 decoder implementation from VideoLAN"
PKGDEP="glibc"
# NOTE: nasm is only required for x86 assembly.
BUILDDEP=""
BUILDDEP__AMD64="${BUILDDEP} nasm"
BUILDDEP__I486="${BUILDDEP} nasm"
PKGSEC=libs

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
