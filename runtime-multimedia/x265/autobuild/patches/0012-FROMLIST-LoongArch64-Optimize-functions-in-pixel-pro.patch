+    vilvl.w         vr3,   vr4,  vr3
+    vilvl.d         vr9,   vr3,  vr1
+    vilvl.w         vr5,   vr6,  vr5
+    vilvl.w         vr7,   vr8,  vr7
+    vilvl.d         vr10,  vr7,  vr5
+
+    slli.d          t0,    a1,   2
+    slli.d          t1,    a3,   2
+    add.d           a0,    a0,   t0
