From 32e47c4ece0cba20765e943d400b3d1e7363b47d Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Thu, 24 Sep 2026 16:54:47 +0800
Subject: [PATCH 3/3] AOSCOS: cmake: only specify necessary flags for ARM
 optimisation targets

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 source/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/source/CMakeLists.txt b/source/CMakeLists.txt
index ac7824a58..0d703ab07 100755
--- a/source/CMakeLists.txt
+++ b/source/CMakeLists.txt
@@ -253,10 +253,10 @@ if(GCC)
     elseif(ARM)
         find_package(Neon)
         if(CPU_HAS_NEON)
-            set(ARM_ARGS -mcpu=native -mfloat-abi=hard -mfpu=neon -marm -fPIC)
+            set(ARM_ARGS -mfloat-abi=hard -mfpu=neon -fPIC)
             add_definitions(-DHAVE_NEON)
         else()
-            set(ARM_ARGS -mcpu=native -mfloat-abi=hard -mfpu=vfp -marm)
+            set(ARM_ARGS -mfloat-abi=hard -mfpu=vfp)
         endif()
     endif()
 	if(ARM64 OR CROSS_COMPILE_ARM64)
-- 
2.55.0

