PKGNAME=x265
PKGSEC=libs
PKGDEP="glibc"
BUILDDEP__AMD64="${BUILDDEP} nasm"
PKGDES="Open source H265/HEVC video encoder"

# Note: -DENABLE_HDR10_PLUS=ON, some applications (e.g., Sunshine) might
# want this.
CMAKE_AFTER=(
    '-DENABLE_HDR10_PLUS=ON'
)
CMAKE_AFTER__PPC64=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_ALTIVEC=OFF'
)
# FIXME: x265 decides whether to build SVE/SVE2 code paths by reading the
# build host's /proc/cpuinfo (source/cmake/FindSVE*.cmake), then adds
# "-march=armv8-a+sve(2)" to the compile flags. A build host that has SVE
# therefore produces a library containing SVE instructions, which crashes
# with SIGILL on target devices without SVE - SVE is optional in ARMv8.2-A
# and consumer SoCs such as the Snapdragon 8cx Gen 3 do not implement it.
# Turn both off explicitly here, on top of
# 0004-AOSCOS-cmake-do-not-enable-SVE-from-build-host.patch, which makes the
# safe choice the default for anyone building x265 outside of ABBS.
# Remove this block once x265 is updated to 4.3 or newer, which does runtime
# feature detection instead of trusting the build host.
CMAKE_AFTER__ARM64=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_SVE=OFF'
    '-DENABLE_SVE2=OFF'
)

PKGBREAK="avidemux<=2.8.1 digikam<=7.9.0-2 vlc<=3.0.20-3 xpra<=5.0.8 \
          gstreamer<=1.22.0-5 ffmpeg<=4.4.4-3 libheif<=1.17.6-1"

AB_FLAGS_O3=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
