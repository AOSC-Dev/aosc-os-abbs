PKGNAME=x265
PKGSEC=libs
PKGDEP="glibc"
BUILDDEP__AMD64="${BUILDDEP} nasm"
PKGDES="Open source H265/HEVC video encoder"

# Note: -DENABLE_HDR10_PLUS=ON, some applications (e.g., Sunshine) might
# want this.
CMAKE_AFTER=(
    '-DENABLE_HDR10_PLUS=ON'
)
CMAKE_AFTER__PPC64=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_ALTIVEC=OFF'
)
# FIXME: fail at linking step on riscv32 targets
# /usr/bin/ld: libx265.so.217: undefined reference to `__sync_fetch_and_add_8'
# /usr/bin/ld: libx265.so.217: undefined reference to `__sync_lock_test_and_set_8'
CMAKE_AFTER__RISCV32=(
    '-DNO_ATOMICS=ON'
)
CMAKE_AFTER__RISCV32IMA=(
    '-DNO_ATOMICS=ON'
)

PKGBREAK="avidemux<=2.8.1 digikam<=7.9.0-2 vlc<=3.0.20-3 xpra<=5.0.8 \
          gstreamer<=1.22.0-5 ffmpeg<=4.4.4-3 libheif<=1.17.6-1"

AB_FLAGS_O3=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
