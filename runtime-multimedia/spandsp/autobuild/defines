PKGNAME=spandsp
PKGSEC=libs
PKGDEP="glibc libjpeg-turbo libtiff libwebp xz zstd"
BUILDDEP="docbook-xsl libxslt"
PKGDES="A low-level signal processing library that modulates and demodulates signals commonly used in telephony"

ABSHADOW=0

AUTOTOOLS_AFTER=(
    "--enable-v32bis"
    "--enable-v34"
    "--enable-sslfax"
    "--disable-builtin-tiff"
    "--disable-doc"
    "--disable-fixed-point"  # NOTE: if the hardware have FPU, disable it.
)
AUTOTOOLS_AFTER__AMD64=(
    "${AUTOTOOLS_AFTER}"
    "--enable-mmx"
    "--enable-sse"
    "--enable-sse2"
    "--disable-sse3"
    "--disable-ssse3"
    "--disable-sse4-1"
    "--disable-sse4-2"
    "--disable-avx"
    "--disable-avx2"
)
AUTOTOOLS_AFTER__ARM64=(
    "${AUTOTOOLS_AFTER}"
    "--enable-neon"
)

PKGBREAK="bluez-alsa<=4.1.1 gstreamer<=1.26.4-2 wireshark<=4.4.9-1"
