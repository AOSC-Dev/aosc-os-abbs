From 81d1e58e23a64b82c2538d08045c51cfb8177f02 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Fri, 26 Jun 2026 23:12:36 +0800
Subject: [PATCH] AOSCOS: qml: drop KNewStuff functions/buttons

The "Get new ..." button may sound like a good idea, but in reality may
cause issue as plugins may be shipped as binaries, and in worse cases,
contain malware.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/ui/main.qml | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/src/ui/main.qml b/src/ui/main.qml
index 3bf0a88..0ed42f6 100644
--- a/src/ui/main.qml
+++ b/src/ui/main.qml
@@ -14,7 +14,6 @@ import QtQuick.Window 2.15
 
 import org.kde.kcmutils as KCM
 import org.kde.kirigami as Kirigami
-import org.kde.newstuff 1.81 as NewStuff
 import org.kde.private.kcms.sddm 1.0
 
 KCM.GridViewKCM {
@@ -34,13 +33,6 @@ KCM.GridViewKCM {
             text: i18nc("@action:button", "Install From File…")
             icon.name: "document-import"
             onTriggered: themeDialog.open()
-        },
-        NewStuff.Action {
-            text: i18nc("@action:button as in, \"get new SDDM themes\"", "Get New…")
-            configFile: "sddmtheme.knsrc"
-            onEntryEvent: function(entry, event) {
-                kcm.themesModel.populate();
-            }
         }
     ]
 
-- 
2.52.0

