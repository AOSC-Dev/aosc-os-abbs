From 5c63a755ecf8870c37c42ef2f71f974f20a6ae6e Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Sat, 27 Jun 2026 11:19:56 +0800
Subject: [PATCH] AOSCOS: gui: drop KNewStuff functions/buttons

The "Get new ..." button may sound like a good idea, but in reality may
cause issue as plugins may be shipped as binaries, and in worse cases,
contain malware.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 CMakeLists.txt      |  2 --
 gui/CMakeLists.txt  |  4 ----
 gui/Workspace.cpp   | 39 ---------------------------------------
 gui/Workspace.h     |  2 --
 gui/ksysguard.cpp   | 15 ---------------
 gui/ksysguard.h     |  3 ---
 gui/ksysguard.knsrc |  5 -----
 7 files changed, 70 deletions(-)
 delete mode 100644 gui/ksysguard.knsrc

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8e72fb54..914a656e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -43,8 +43,6 @@ find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS
     IconThemes
     ItemViews
     KIO
-    NewStuffCore
-    NewStuff
     Auth
     Notifications
     WindowSystem
diff --git a/gui/CMakeLists.txt b/gui/CMakeLists.txt
index 3b67f644..053c7ee5 100644
--- a/gui/CMakeLists.txt
+++ b/gui/CMakeLists.txt
@@ -58,8 +58,6 @@ target_link_libraries(ksysguard
     KF6::DBusAddons
     KF6::ItemViews
     KF6::KIOWidgets
-    KF6::NewStuffCore
-    KF6::NewStuffWidgets
     KF6::Notifications
     KF6::I18n
     KF6::IconThemes
@@ -73,5 +71,3 @@ install( PROGRAMS org.kde.ksysguard.desktop  DESTINATION  ${KDE_INSTALL_APPDIR}
 install( FILES org.kde.ksysguard.appdata.xml DESTINATION ${KDE_INSTALL_METAINFODIR} )
 install( FILES ProcessTable.sgrd SystemLoad2.sgrd DESTINATION  ${KDE_INSTALL_DATADIR}/ksysguard )
 install( FILES ksysguardui.rc  DESTINATION  ${KDE_INSTALL_KXMLGUIDIR}/ksysguard )
-install( FILES ksysguard.knsrc DESTINATION ${KDE_INSTALL_KNSRCDIR})
-
