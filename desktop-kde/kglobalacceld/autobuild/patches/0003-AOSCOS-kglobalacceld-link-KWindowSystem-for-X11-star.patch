From df50be9388c428e4d2eb69bba12d28afbb5610ac Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 18:11:20 +0800
Subject: [PATCH 3/4] AOSCOS: kglobalacceld: link KWindowSystem for X11 startup
 IDs

Upstream-Id: 07097414801458abc3469b2e3dc0f9dc63278baf

Restore the KWindowSystem link for KStartupInfo, because X11 application
launches must avoid querying the X server from the launching thread.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 src/CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 2dbeb1d..3eb2037 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -46,6 +46,7 @@ target_link_libraries(KGlobalAccelD
         KF6::Service
         KF6::KIOGui
         KF6::JobWidgets
+        KF6::WindowSystem
 )
 
 set_target_properties(KGlobalAccelD PROPERTIES VERSION ${KGLOBALACCELD_VERSION}
