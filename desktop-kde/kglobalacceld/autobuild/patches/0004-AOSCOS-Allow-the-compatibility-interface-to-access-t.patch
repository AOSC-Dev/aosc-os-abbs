From 81c8302d7bd3635152bbfea7d814b826b6087908 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 18:11:43 +0800
Subject: [PATCH 4/4] AOSCOS: Allow the compatibility interface to access the
 registry

Upstream-Id: 099b1e9dcb52ea2524718ac56f4ce3339b534873

Restore the friendship needed by the compatibility adapter after upstream
dissolved KGlobalAccelInterface into the registry. The plugin-loading and
grabKey changes are background dependencies, not sources of this one-line
change.

Assisted-by: gpt-6.1-sol
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 src/globalshortcutsregistry.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/globalshortcutsregistry.h b/src/globalshortcutsregistry.h
index 11aba44..80a4b8d 100644
--- a/src/globalshortcutsregistry.h
+++ b/src/globalshortcutsregistry.h
@@ -146,6 +146,7 @@ private:
     friend struct KGlobalAccelDPrivate;
     friend class Component;
     friend class KGlobalAccelD;
+    friend class KGlobalAccelInterface;
 
     Component *createComponent(const QString &uniqueName, const QString &friendlyName);
     KServiceActionComponent *createServiceActionComponent(const QString &uniqueName);
