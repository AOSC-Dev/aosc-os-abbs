From 3bc4ac1cf40b3fb8c95a352051d00eea0e92b5a5 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 17:48:04 +0800
Subject: [PATCH 3/8] AOSCOS: libkscreen: select XRandR backend on X11

Upstream-Id: bcf0026223933994ca5709bc09ff46369df78c25

Build the restored XRandR backend into libkscreen and select it for xcb,
because the Plasma 6.8 backend manager otherwise constructs only Wayland.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 src/CMakeLists.txt     | 10 ++++++++++
 src/backendmanager.cpp |  6 ++++++
 2 files changed, 16 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 1bd6f36..af1ea75 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -26,6 +26,15 @@ set(libkscreen_SRCS
     ../backends/fake/parser.cpp
     ../backends/fake/fake.h
     ../backends/fake/parser.h
+
+    ../backends/xrandr/xrandr.cpp ../backends/xrandr/xrandr.h
+    ../backends/xrandr/xrandrconfig.cpp ../backends/xrandr/xrandrconfig.h
+    ../backends/xrandr/xrandrcrtc.cpp ../backends/xrandr/xrandrcrtc.h
+    ../backends/xrandr/xrandroutput.cpp ../backends/xrandr/xrandroutput.h
+    ../backends/xrandr/xrandrmode.cpp ../backends/xrandr/xrandrmode.h
+    ../backends/xrandr/xrandrscreen.cpp ../backends/xrandr/xrandrscreen.h
+    ../backends/xcbwrapper.cpp ../backends/xcbwrapper.h
+    ../backends/xcbeventlistener.cpp ../backends/xcbeventlistener.h
 )
 
 qt_add_dbus_interface(libkscreen_SRCS ../backends/kwayland/org.kde.KWin.TabletModeManager.xml tabletmodemanager_interface)
@@ -76,6 +85,7 @@ target_link_libraries(KF6Screen
     Qt::GuiPrivate # for QX11Info
     Qt::WaylandClient
     Wayland::Client
+    ${XCB_LIBRARIES}
 )
 
 set_target_properties(KF6Screen PROPERTIES
diff --git a/src/backendmanager.cpp b/src/backendmanager.cpp
index 9cd9a17..cb49491 100644
--- a/src/backendmanager.cpp
+++ b/src/backendmanager.cpp
@@ -10,9 +10,12 @@
 
 #include "../backends/fake/fake.h"
 #include "../backends/kwayland/waylandbackend.h"
+#include "../backends/xrandr/xrandr.h"
 #include "abstractbackend.h"
 #include "configmonitor.h"
 
+#include <QGuiApplication>
+
 using namespace KScreen;
 
 BackendManager *BackendManager::sInstance = nullptr;
@@ -57,6 +60,9 @@ KScreen::AbstractBackend *BackendManager::loadBackendInProcess()
     if (qgetenv("KSCREEN_BACKEND") == QLatin1StringView("Fake")) {
         mInProcessBackend = new Fake;
         mInProcessBackend->init(mBackendArguments);
+    } else if (QGuiApplication::platformName().startsWith(QLatin1String("xcb"))) {
+        mInProcessBackend = new XRandR;
+        mInProcessBackend->init(mBackendArguments);
     } else {
         mInProcessBackend = new WaylandBackend;
         mInProcessBackend->init(mBackendArguments);
