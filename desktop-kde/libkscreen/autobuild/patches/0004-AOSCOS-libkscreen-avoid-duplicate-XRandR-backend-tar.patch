From 1b0858ecb2e08b886726a97efd58b5137c8d7b9f Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 18:20:51 +0800
Subject: [PATCH 4/8] AOSCOS: libkscreen: avoid duplicate XRandR backend target

Upstream-Id: 5963d10e22cd25abd9f6c17c1b921c15f0c50823

Remove the legacy backend subdirectory from the top-level build, because
Plasma 6.8 links XRandR directly into libkscreen and would otherwise create
a duplicate target.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 CMakeLists.txt | 1 -
 1 file changed, 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9ae5774..5848377 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -65,7 +65,6 @@ ecm_set_disabled_deprecation_versions(QT 5.15.0
 )
 
 add_subdirectory(src)
-add_subdirectory(backends)
 if(BUILD_TESTING)
    add_subdirectory(autotests)
    add_subdirectory(tests)
