From f8f7fd8caa186e52028777672f4110faa9cb01b5 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 22:44:45 +0800
Subject: [PATCH 37/37] AOSCOS: Keep input KCMs in the current build layout

Upstream-Id: 80c424b5b980348f119e2de752a85bbd7f14a847

Keep the keyboard, mouse and touchpad KCM entry points in the current shared
build layout; select platform backends inside the modules rather than
through the obsolete top-level mouse guard.

Assisted-by: gpt-6.1-sol
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 kcms/CMakeLists.txt | 14 +++-----------
 1 file changed, 3 insertions(+), 11 deletions(-)

diff --git a/kcms/CMakeLists.txt b/kcms/CMakeLists.txt
index eea8e071d..9db9c83aa 100644
--- a/kcms/CMakeLists.txt
+++ b/kcms/CMakeLists.txt
@@ -1,11 +1,7 @@
 remove_definitions(-DQT_NO_CAST_FROM_ASCII -DQT_STRICT_ITERATORS -DQT_NO_CAST_FROM_BYTEARRAY -DQT_NO_KEYWORDS)
 
 add_subdirectory(libkwindevices)
-
-if(X11_Xkb_FOUND AND XCB_XKB_FOUND)
-    add_subdirectory( keyboard )
-endif()
-
+add_subdirectory( keyboard )
 add_subdirectory( access )
 add_subdirectory( dateandtime )
 add_subdirectory( ksplash )
@@ -33,13 +29,9 @@ if (KF6Baloo_FOUND)
 endif()
 add_subdirectory(solid_actions)
 
-if (BUILD_KCM_MOUSE_KWIN_WAYLAND OR BUILD_KCM_MOUSE_X11)
-    add_subdirectory(mouse)
-endif()
+add_subdirectory(mouse)
 
-if (BUILD_KCM_TOUCHPAD_KWIN_WAYLAND)
-    add_subdirectory(touchpad)
-endif()
+add_subdirectory(touchpad)
 
 if(BUILD_KCM_TABLET)
     add_subdirectory(tablet)
