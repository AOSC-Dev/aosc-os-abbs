From 62dbc626f27ec130256b1a778d1026be28fda736 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Tue, 25 Aug 2026 11:02:52 +0800
Subject: [PATCH 14/16] AOSCOS: touchpad: hide unsupported X11 scroll speed row

Hide the scroll speed controls on X11, because Plasma 6.8 does not support
the setting and exposing it would mislead users.
---
 kcms/touchpad/ui/main.qml | 90 ++++++++++++++-------------------------
 1 file changed, 31 insertions(+), 59 deletions(-)

diff --git a/kcms/touchpad/ui/main.qml b/kcms/touchpad/ui/main.qml
index 027939301..894141706 100644
--- a/kcms/touchpad/ui/main.qml
+++ b/kcms/touchpad/ui/main.qml
@@ -124,8 +124,10 @@ KCMUtils.SimpleKCM {
                 contentItem: QQC2.CheckBox {
                     id: disableEventsOnExternalMouse
                     text: i18ndc("kcm_touchpad", "@option:check", "Disable while mouse is connected")
-                    leftPadding: mirrored ? disableEventsOnExternalMouse.padding : (deviceEnabled.indicator.width + deviceEnabled.spacing)
-                    rightPadding: mirrored ? (deviceEnabled.indicator.width + deviceEnabled.spacing) : disableEventsOnExternalMouse.padding
+                    leftPadding: Application.layoutDirection === Qt.LeftToRight ?
+                        deviceEnabled.contentItem.leftPadding : disableEventsOnExternalMouse.padding
+                    rightPadding: Application.layoutDirection === Qt.RightToLeft ?
+                        deviceEnabled.contentItem.rightPadding : disableEventsOnExternalMouse.padding
                     enabled: root.device?.supportsDisableEventsOnExternalMouse ?? false
                     checked: enabled && (root.device?.disableEventsOnExternalMouse ?? false)
 
@@ -143,8 +145,10 @@ KCMUtils.SimpleKCM {
                     id: dwt
                     text: i18ndc("kcm_touchpad", "option:check", "Disable while typing")
                     Accessible.description: i18ndc("kcm_touchpad", "@label 'this' refers to the 'disable touchpad while typing' feature", "This can interfere with video games.")
-                    leftPadding: mirrored ? disableEventsOnExternalMouse.padding : (deviceEnabled.indicator.width + deviceEnabled.spacing)
-                    rightPadding: mirrored ? (deviceEnabled.indicator.width + deviceEnabled.spacing) : disableEventsOnExternalMouse.padding
+                    leftPadding: Application.layoutDirection === Qt.LeftToRight ?
+                        deviceEnabled.contentItem.leftPadding : disableEventsOnExternalMouse.padding
+                    rightPadding: Application.layoutDirection === Qt.RightToLeft ?
+                        deviceEnabled.contentItem.rightPadding : disableEventsOnExternalMouse.padding
                     enabled: root.device?.supportsDisableWhileTyping ?? false
                     checked: enabled && (root.device?.disableWhileTyping ?? false)
 
@@ -301,32 +305,13 @@ KCMUtils.SimpleKCM {
         Kirigami.FormGroup {
             // Scroll Speed aka scroll Factor
             Kirigami.FormEntry {
+                visible: root.device?.supportsScrollFactor ?? false
                 contentItem: GridLayout {
-                    id: scrollProfile
                     Kirigami.FormData.label: i18ndc("kcm_touchpad", "@label:slider", "Scrolling speed:")
                     Kirigami.FormData.buddyFor: scrollFactor
                     Layout.fillWidth: true
 
-                    visible: root.device?.supportsScrollFactor ?? false
-                    columns: 4
-
-                    readonly property list<real> values: [
-                        0.1,
-                        0.3,
-                        0.5,
-                        0.75,
-                        1, // default
-                        1.5,
-                        2,
-                        3,
-                        4,
-                        5,
-                        7,
-                        9,
-                        12,
-                        15,
-                        20
-                    ]
+                    columns: 3
 
                     QQC2.Slider {
                         id: scrollFactor
@@ -339,51 +324,38 @@ KCMUtils.SimpleKCM {
                         Kirigami.StyleHints.tickMarkStepSize: 1
                         enabled: root.device
 
+                        readonly property list<real> values: [
+                            0.1,
+                            0.3,
+                            0.5,
+                            0.75,
+                            1, // default
+                            1.5,
+                            2,
+                            3,
+                            4,
+                            5,
+                            7,
+                            9,
+                            12,
+                            15,
+                            20
+                        ]
+
                         function indexOf(val) {
-                            const index = scrollProfile.values.indexOf(val)
-                            return index === -1 ? scrollProfile.values.indexOf(1) : index
+                            const index = values.indexOf(val)
+                            return index === -1 ? values.indexOf(1) : index
                         }
                         value: indexOf(root.device?.scrollFactor ?? 1)
 
                         onMoved: {
                             if (root.device) {
-                                root.device.scrollFactor = scrollProfile.values[value]
+                                root.device.scrollFactor = values[value]
                             }
                         }
                     }
 
                     //row 2
-                    QQC2.SpinBox {
-                        id: scrollFactorSpinBox
-
-                        Layout.minimumWidth: Kirigami.Units.gridUnit * 4
-
-                        from: 0
-                        to: 14
-                        stepSize: 1
-
-                        function indexOf(val: real): int {
-                            const index = scrollProfile.values.indexOf(val)
-                            return index === -1 ? scrollProfile.values.indexOf(1) : index
-                        }
-                        value: indexOf(root.device?.scrollFactor ?? 1)
-
-                        onValueChanged: {
-                            if (root.device) {
-                                root.device.scrollFactor = scrollProfile.values[value]
-                            }
-                        }
-
-                        textFromValue: function(val, locale) {
-                            return Number(val + 1).toLocaleString(locale, "d", 0)
-                        }
-
-                        valueFromText: function(text, locale) {
-                            return Number.fromLocaleString(locale, text) - 1
-                        }
-                    }
-
-                    //row 3
                     QQC2.Label {
                         text: i18ndc("kcm_touchpad", "@item:inrange Slower Scroll", "Slower")
                         textFormat: Text.PlainText
-- 
2.56.0

