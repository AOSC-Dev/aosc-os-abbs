From 8eda69ca8c2953f1a3b479f08978392b132007f5 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 22:44:32 +0800
Subject: [PATCH 12/37] AOSCOS: Revert "Drop kapplymousetheme"

Upstream-Id: 887bad29199305bfe4b283c2812eb93bed10298e

Retain the X11 build guard established by the mouse backend patch and add
cursor-theme initialization to the current KCM implementation.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 kcms/mouse/CMakeLists.txt       |  1 +
 kcms/mouse/kapplymousetheme.cpp | 38 +++++++++++++++++++++++++++++++++
 kcms/mouse/kcm.cpp              | 33 +++++++++++++++++++++++++++-
 3 files changed, 71 insertions(+), 1 deletion(-)
 create mode 100644 kcms/mouse/kapplymousetheme.cpp

diff --git a/kcms/mouse/CMakeLists.txt b/kcms/mouse/CMakeLists.txt
index 18f8879e2..d1f232f7c 100644
--- a/kcms/mouse/CMakeLists.txt
+++ b/kcms/mouse/CMakeLists.txt
@@ -35,6 +35,7 @@ if (BUILD_KCM_MOUSE_X11)
         cursortheme.cpp
         cursortheme.h
     )
+    target_link_libraries(kcm_mouse PRIVATE Qt6::GuiPrivate X11::Xcursor)
 endif()
 
 ecm_qt_declare_logging_category(kcm_mouse
diff --git a/kcms/mouse/kapplymousetheme.cpp b/kcms/mouse/kapplymousetheme.cpp
new file mode 100644
index 000000000..fdd01c4ad
--- /dev/null
+++ b/kcms/mouse/kapplymousetheme.cpp
@@ -0,0 +1,38 @@
+/*
+    SPDX-FileCopyrightText: 1999 Matthias Hoelzer-Kluepfel <hoelzer@kde.org>
+    SPDX-FileCopyrightText: 2005 Lubos Lunak <l.lunak@kde.org>
+    SPDX-FileCopyrightText: 2017 Xuetian Weng <wengxt@gmail.com>
+    SPDX-FileCopyrightText: 2018 Roman Gilg <subdiff@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "cursortheme.h"
+
+#include <KWindowSystem>
+
+#include <QDebug>
+#include <QFile>
+#include <QGuiApplication>
+
+int main(int argc, char *argv[])
+{
+    int ret = 0;
+    QGuiApplication::setDesktopSettingsAware(false);
+    QGuiApplication app(argc, argv);
+    if (argc != 3)
+        return 1;
+    QString theme = QFile::decodeName(argv[1]);
+    QString size = QFile::decodeName(argv[2]);
+
+    if (!KWindowSystem::isPlatformX11()) {
+        qDebug() << "X11 backend not detected. Exit.";
+        return 2;
+    }
+
+    // Note: If you update this code, update kcm.cpp as well.
+
+    CursorTheme::applyCursorTheme(theme, size.toInt());
+
+    return ret;
+}
diff --git a/kcms/mouse/kcm.cpp b/kcms/mouse/kcm.cpp
index 58c3d9870..f06bf0d78 100644
--- a/kcms/mouse/kcm.cpp
+++ b/kcms/mouse/kcm.cpp
@@ -6,6 +6,7 @@
 */
 
 #include "kcm.h"
+#include "cursortheme.h"
 #include "inputbackend.h"
 #include "logging.h"
 #include "mousemoduledata.h"
@@ -25,6 +26,29 @@ using namespace Qt::StringLiterals;
 
 K_PLUGIN_FACTORY_WITH_JSON(KCMMouseFactory, "kcm_mouse.json", registerPlugin<KCMMouse>(); registerPlugin<MouseModuleData>();)
 
+extern "C" {
+Q_DECL_EXPORT void kcminit()
+{
+    std::unique_ptr<InputBackend> backend = InputBackend::create();
+    if (backend) {
+        backend->kcmInit();
+    }
+
+#if BUILD_KCM_MOUSE_X11
+    if (KWindowSystem::isPlatformX11()) {
+        auto config = KSharedConfig::openConfig(u"kcminputrc"_s, KConfig::NoGlobals);
+        KConfigGroup group = config->group(QStringLiteral("Mouse"));
+        const QString theme = group.readEntry("cursorTheme", QStringLiteral("breeze_cursors"));
+        const int size = group.readEntry("cursorSize", 24);
+
+        // Note: If you update this code, update kapplymousetheme as well.
+
+        CursorTheme::applyCursorTheme(theme, size);
+    }
+#endif
+}
+}
+
 Message::Message() = default;
 
 Message::Message(MessageType::MessageType type, const QString &text)
@@ -56,7 +80,14 @@ KCMMouse::KCMMouse(QObject *parent, const KPluginMetaData &data, [[maybe_unused]
     qmlRegisterUncreatableType<InputDevice>(uri, 1, 0, "InputDevice", QString());
     InputBackend::registerImplementationTypes(uri);
 
-    m_inputBackend = std::make_unique<InputBackend>();
+    m_inputBackend = InputBackend::create();
+
+    if (!m_inputBackend) {
+        m_initError = true;
+        setSaveLoadMessage(Message::error(i18n("Not able to select appropriate backend")));
+        qCCritical(KCM_MOUSE) << "Not able to select appropriate backend.";
+        return;
+    }
 
     m_initError = !m_inputBackend->errorString().isNull();
 
