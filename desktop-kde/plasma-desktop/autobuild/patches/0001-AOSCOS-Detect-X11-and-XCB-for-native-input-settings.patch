From 0594a2e13da1d2cac05ec6cb184794b1848a675f Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Sun, 15 Nov 2026 22:38:52 +0800
Subject: [PATCH 01/16] AOSCOS: Detect X11 and XCB for native input settings

Share X11 build detection across the input KCMs without changing the
Wayland backend selection.

Upstream-Id: 80c424b5b980348f119e2de752a85bbd7f14a847
Upstream-Id: 50ca366dfd29d787f00720c570d0cda5b164d171
Upstream-Id: 44dfb7cffd78146c81de4eb19df27616931fd686
Upstream-Id: 2721020359c3ffd76977f124c19f74abab497273
Upstream-Id: 1dcad1f3cca8e2bc2355896529e9a9ec257b9795
Upstream-Id: 9096535eeb9947920ee9cad90a5c4f41af817678

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 CMakeLists.txt               | 20 +++++++++++++++++++-
 config-build-options.h.cmake |  4 ++++
 2 files changed, 23 insertions(+), 1 deletion(-)
 create mode 100644 config-build-options.h.cmake

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 410992685..987d3790a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -37,6 +37,10 @@ include(ECMQmlModule)
 include(ECMConfiguredInstall)
 
 option(BUILD_DOC "Whether to build the documentation" ON)
+option(BUILD_KCM_MOUSE_KWIN_WAYLAND "Build the Mouse KCM's KWin+Wayland backend" ON)
+option(BUILD_KCM_MOUSE_X11 "Build the Mouse KCM's X11 backend" ON)
+option(BUILD_KCM_TOUCHPAD_KWIN_WAYLAND "Build the Touchpad KCM's KWin+Wayland backend" ON)
+option(BUILD_KCM_TOUCHPAD_X11 "Build the Touchpad KCM's X11 backend" ON)
 option(BUILD_KCM_TABLET "Build the Tablet KCM" ON)
 
 find_package(Qt6 ${QT_MIN_VERSION} CONFIG REQUIRED COMPONENTS
@@ -210,7 +214,20 @@ set_package_properties(UDev PROPERTIES
     TYPE OPTIONAL
 )
 
-find_package(XCB REQUIRED COMPONENTS XCB)
+find_package(XCB
+    REQUIRED COMPONENTS
+        XCB SHM IMAGE
+    OPTIONAL_COMPONENTS
+        XKB XINPUT ATOM RECORD
+)
+
+if (BUILD_KCM_TOUCHPAD_X11)
+    find_package(X11_XCB)
+    set_package_properties(X11_XCB PROPERTIES
+        PURPOSE "Required for touchpad KCM (X11 backend) when option BUILD_KCM_TOUCHPAD_X11=ON"
+        TYPE REQUIRED
+    )
+endif()
 
 pkg_check_modules(XKBREGISTRY xkbregistry REQUIRED IMPORTED_TARGET)
 
@@ -253,6 +270,7 @@ add_definitions(
 )
 
 configure_file(config-workspace.h.cmake ${CMAKE_CURRENT_BINARY_DIR}/config-workspace.h)
+configure_file(config-build-options.h.cmake ${CMAKE_CURRENT_BINARY_DIR}/config-build-options.h)
 
 plasma_install_package(desktoppackage org.kde.plasma.desktop shells shell)
 
diff --git a/config-build-options.h.cmake b/config-build-options.h.cmake
new file mode 100644
index 000000000..1a8a94231
--- /dev/null
+++ b/config-build-options.h.cmake
@@ -0,0 +1,4 @@
+#cmakedefine01 BUILD_KCM_MOUSE_KWIN_WAYLAND
+#cmakedefine01 BUILD_KCM_MOUSE_X11
+#cmakedefine01 BUILD_KCM_TOUCHPAD_KWIN_WAYLAND
+#cmakedefine01 BUILD_KCM_TOUCHPAD_X11
-- 
