From 6338b6361f866c12c3872a510ae2d9922d7e241f Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 22:44:45 +0800
Subject: [PATCH 33/37] AOSCOS: Initialize the restored X11 touchpad settings
 at login

Upstream-Id: 2ac04a2463b4604a1c67b907033215edb1d00ce2

Reconnect kcminit to the native X11 backend so saved touchpad properties are
applied when the session starts.

Assisted-by: gpt-6.1-sol
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 kcms/touchpad/kcm.cpp | 22 ++++++++++++++++++++++
 kcms/touchpad/kcm.h   | 10 ++++++----
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/kcms/touchpad/kcm.cpp b/kcms/touchpad/kcm.cpp
index 0f83aaef9..bafe18c4f 100644
--- a/kcms/touchpad/kcm.cpp
+++ b/kcms/touchpad/kcm.cpp
@@ -22,6 +22,17 @@
 
 K_PLUGIN_FACTORY_WITH_JSON(KCMTouchpadFactory, "kcm_touchpad.json", registerPlugin<KCMTouchpad>(); registerPlugin<TouchpadModuleData>();)
 
+extern "C" {
+Q_DECL_EXPORT void kcminit()
+{
+#if BUILD_KCM_TOUCHPAD_X11
+    if (KWindowSystem::isPlatformX11()) {
+        KCMTouchpad::kcmInit();
+    }
+#endif
+}
+}
+
 Message::Message() = default;
 
 Message::Message(MessageType::MessageType type, const QString &text)
@@ -93,6 +104,17 @@ void KCMTouchpad::setCurrentDeviceIndex(int index)
     }
 }
 
+void KCMTouchpad::kcmInit()
+{
+#if BUILD_KCM_TOUCHPAD_X11
+    TouchpadBackend *backend = TouchpadBackend::implementation();
+    if (backend->getMode() == TouchpadInputBackendMode::XLibinput) {
+        backend->load();
+        backend->save();
+    }
+#endif
+}
+
 void KCMTouchpad::load()
 {
     // in case of critical init error in backend, don't try
diff --git a/kcms/touchpad/kcm.h b/kcms/touchpad/kcm.h
index 1e9380023..8872dbf04 100644
--- a/kcms/touchpad/kcm.h
+++ b/kcms/touchpad/kcm.h
@@ -9,7 +9,7 @@
 #include <KPluginMetaData>
 #include <KQuickConfigModule>
 
-class KWinWaylandBackend;
+class TouchpadBackend;
 class TouchpadConfigPlugin;
 
 namespace MessageType
@@ -48,13 +48,15 @@ class KCMTouchpad : public KQuickConfigModule
     Q_OBJECT
     Q_PROPERTY(Message saveLoadMessage MEMBER m_saveLoadMessage NOTIFY saveLoadMessageChanged FINAL)
     Q_PROPERTY(Message hotplugMessage MEMBER m_hotplugMessage NOTIFY hotplugMessageChanged FINAL)
-    Q_PROPERTY(KWinWaylandBackend *backend READ backend CONSTANT FINAL)
+    Q_PROPERTY(TouchpadBackend *backend READ backend CONSTANT FINAL)
     Q_PROPERTY(int currentDeviceIndex READ currentDeviceIndex WRITE setCurrentDeviceIndex NOTIFY currentDeviceIndexChanged FINAL)
 
 public:
     explicit KCMTouchpad(QObject *parent, const KPluginMetaData &data);
 
-    KWinWaylandBackend *backend() const;
+    static void kcmInit();
+
+    TouchpadBackend *backend() const;
 
     int currentDeviceIndex() const;
     void setCurrentDeviceIndex(int index);
@@ -80,7 +82,7 @@ private:
 
     Message m_saveLoadMessage;
     Message m_hotplugMessage;
-    KWinWaylandBackend *m_backend;
+    TouchpadBackend *m_backend;
     bool m_initError = false;
     int m_currentDeviceIndex = 0;
 };
