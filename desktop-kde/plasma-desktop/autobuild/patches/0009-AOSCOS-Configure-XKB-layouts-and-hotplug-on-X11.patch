+configure_file(config-keyboard.h.cmake ${CMAKE_CURRENT_BINARY_DIR}/config-keyboard.h)
+
 # Declarative module
 ecm_add_qml_module(kcm_keyboard_declarative
     URI "org.kde.plasma.private.kcm_keyboard"
@@ -89,5 +154,3 @@ if(BUILD_TESTING)
 endif()
 
