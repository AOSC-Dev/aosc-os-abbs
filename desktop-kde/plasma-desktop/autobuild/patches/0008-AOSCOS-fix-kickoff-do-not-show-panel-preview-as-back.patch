From 0e615d77b8f7eaa195f956f271eb57bbc45e478d Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Sun, 6 Sep 2026 15:29:47 +0800
Subject: [PATCH 8/8] AOSCOS: fix(kickoff): do not show panel preview as
 background for launcher icon

The current implementation does not take currentColor hint into
consideration, making the user-specified icon practically invisible when
using a dark theme.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 applets/kickoff/ConfigGeneral.qml | 2 --
 1 file changed, 2 deletions(-)

diff --git a/applets/kickoff/ConfigGeneral.qml b/applets/kickoff/ConfigGeneral.qml
index ae480517ff..926bf2968a 100644
--- a/applets/kickoff/ConfigGeneral.qml
+++ b/applets/kickoff/ConfigGeneral.qml
@@ -70,8 +70,6 @@ KCM.SimpleKCM {
             KSvg.FrameSvgItem {
                 id: previewFrame
                 anchors.centerIn: parent
-                imagePath: Plasmoid.formFactor === PlasmaCore.Types.Vertical || Plasmoid.formFactor === PlasmaCore.Types.Horizontal
-                        ? "widgets/panel-background" : "widgets/background"
                 width: Kirigami.Units.iconSizes.large + fixedMargins.left + fixedMargins.right
                 height: Kirigami.Units.iconSizes.large + fixedMargins.top + fixedMargins.bottom
 
-- 
2.55.0

