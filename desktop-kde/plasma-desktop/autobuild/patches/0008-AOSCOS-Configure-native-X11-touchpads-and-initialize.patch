+    void showOsd();
+
+    TouchpadBackend *m_backend;
+    QDBusServiceWatcher m_dependencies;
+
+    bool m_touchpadSuspended = false;
+    bool m_userRequestedSuspend = false;
+
+    bool m_preparingForSleep = false;
+};
