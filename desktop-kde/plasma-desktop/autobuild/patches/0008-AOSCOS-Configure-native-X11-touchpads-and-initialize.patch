+
+public:
+    TouchpadDisabler(QObject *, const QVariantList &);
+
+public Q_SLOTS:
+    Q_SCRIPTABLE Q_NOREPLY void toggle();
+    Q_SCRIPTABLE Q_NOREPLY void disable();
+    Q_SCRIPTABLE Q_NOREPLY void enable();
+
+private Q_SLOTS:
+    void updateCurrentState();
