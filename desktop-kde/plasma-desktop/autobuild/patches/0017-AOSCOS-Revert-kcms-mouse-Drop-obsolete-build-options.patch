From da52cae4d855c490735e248905298af879f3dcab Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 22:44:38 +0800
Subject: [PATCH 17/37] AOSCOS: Revert "kcms/mouse: Drop obsolete build
 options"

Upstream-Id: 80c424b5b980348f119e2de752a85bbd7f14a847

Adapt the input backend interface to the current device model. Build-option
and backend wiring are completed by the following feature-detection and API
adaptation patches instead of duplicating the old Wayland-only source lists.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 CMakeLists.txt                     | 13 -----
 config-build-options.h.cmake       |  2 -
 kcms/CMakeLists.txt                |  4 +-
 kcms/mouse/backends/CMakeLists.txt | 18 ------
 kcms/mouse/inputbackend.cpp        | 22 --------
 kcms/mouse/inputbackend.h          | 90 ++++++++++++++++++------------
 kcms/touchpad/kcm.cpp              | 22 --------
 kcms/touchpad/touchpadbackend.h    |  5 --
 8 files changed, 54 insertions(+), 122 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ab6375a26..ee977bf46 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,8 +39,6 @@ include(ECMConfiguredInstall)
 option(BUILD_DOC "Whether to build the documentation" ON)
 option(BUILD_KCM_MOUSE_KWIN_WAYLAND "Build the Mouse KCM's KWin+Wayland backend" ON)
 option(BUILD_KCM_MOUSE_X11 "Build the Mouse KCM's X11 backend" ON)
-option(BUILD_KCM_TOUCHPAD_KWIN_WAYLAND "Build the Touchpad KCM's KWin+Wayland backend" ON)
-option(BUILD_KCM_TOUCHPAD_X11 "Build the Touchpad KCM's X11 backend" ON)
 option(BUILD_KCM_TABLET "Build the Tablet KCM" ON)
 
 find_package(Qt6 ${QT_MIN_VERSION} CONFIG REQUIRED COMPONENTS
@@ -227,20 +225,9 @@ find_package(XCB
         XKB XINPUT ATOM RECORD
 )
 
-if (BUILD_KCM_TOUCHPAD_X11)
-    find_package(X11_XCB)
-    set_package_properties(X11_XCB PROPERTIES
-        PURPOSE "Required for touchpad KCM (X11 backend) when option BUILD_KCM_TOUCHPAD_X11=ON"
-        TYPE REQUIRED
-    )
-endif()
-
-
 set_package_properties(XCB PROPERTIES TYPE REQUIRED)
 add_feature_info("XCB-XKB" XCB_XKB_FOUND "Required for building kcm/keyboard")
 
-pkg_check_modules(XORGLIBINPUT xorg-libinput IMPORTED_TARGET)
-pkg_check_modules(XORGSERVER xorg-server IMPORTED_TARGET)
 pkg_check_modules(XKBREGISTRY xkbregistry REQUIRED IMPORTED_TARGET)
 
 ecm_find_qmlmodule(org.kde.pipewire 0.1)
