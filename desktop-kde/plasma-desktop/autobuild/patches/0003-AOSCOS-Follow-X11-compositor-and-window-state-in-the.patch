From 1069e8e6d59e96bd615cab8f1bbb1b3d58b167ee Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Sun, 15 Nov 2026 22:38:52 +0800
Subject: [PATCH 03/16] AOSCOS: Follow X11 compositor and window state in the
 desktop package

Select X11 panel behavior from the actual compositor state.

Upstream-Id: ac1ebb8419eea9797dee03532bdba645bbe20b05

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 desktoppackage/contents/views/Desktop.qml | 4 ++++
 desktoppackage/contents/views/Panel.qml   | 7 ++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/desktoppackage/contents/views/Desktop.qml b/desktoppackage/contents/views/Desktop.qml
index e2f4d4674..728281c84 100644
--- a/desktoppackage/contents/views/Desktop.qml
+++ b/desktoppackage/contents/views/Desktop.qml
@@ -8,6 +8,7 @@
 import QtQuick
 
 import org.kde.plasma.core as PlasmaCore
+import org.kde.kwindowsystem
 import org.kde.plasma.activityswitcher as ActivitySwitcher
 import org.kde.plasma.plasmoid
 import "../activitymanager"
@@ -273,6 +274,9 @@ Item {
                     }
                 }
                 sidePanel.visible = true;
+                if (KWindowSystem.isPlatformX11) {
+                    KX11Extras.forceActiveWindow(sidePanel);
+                }
             }
             onStateChanged: {
                 if (state === "closed") {
diff --git a/desktoppackage/contents/views/Panel.qml b/desktoppackage/contents/views/Panel.qml
index aea1844c5..71f154b78 100644
--- a/desktoppackage/contents/views/Panel.qml
+++ b/desktoppackage/contents/views/Panel.qml
@@ -188,7 +188,8 @@ Item {
     property bool isTransparent: panel.opacityMode === Panel.Translucent
     property bool isAdaptive: panel.opacityMode === Panel.Adaptive
     property bool floating: panel.floating
-    property var stateTriggers: [floating, touchingWindowOrKeyboard, isOpaque, isAdaptive, isTransparent, containment, panel.floatingApplets]
+    property bool hasCompositing: KWindowSystem.isPlatformX11 ? KX11Extras.compositingActive : true
+    property var stateTriggers: [floating, touchingWindowOrKeyboard, isOpaque, isAdaptive, isTransparent, hasCompositing, containment, panel.floatingApplets]
     onStateTriggersChanged: {
         let opaqueApplets = false
         let floatingApplets = false
@@ -219,6 +220,10 @@ Item {
             floatingnessTarget = 1
             floatingApplets = true
         }
+        if (!KWindowSystem.isPlatformWayland && !KX11Extras.compositingActive) {
+            opaqueApplets = false
+            panelOpacity = 0
+        }
 
         // Not using panelOpacity to check as it has a NumberAnimation, and it will thus
         // be still read as the initial value here, before the animation starts.
-- 
2.56.0

