+    Prop<bool> m_scrollOnButtonDown{this, &X11LibinputDummyDevice::scrollOnButtonDownChanged, u"XLbInptScrollOnButtonDown"_s};
+
+    std::unique_ptr<LibinputSettings> m_settings;
+    Display *m_dpy = nullptr;
+};
