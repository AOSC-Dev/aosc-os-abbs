Subject: [PATCH 07/37] AOSCOS: Revert "applets/pager: Allow to build without
 X11-enabled KWindowSystem and PW"

Upstream-Id: 7138c3b72d329aa12530774c823814eb06116359

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 applets/pager/pagermodel.cpp  | 15 +++++----------
 applets/pager/pagermodel.h    |  3 ++-
 applets/pager/windowmodel.cpp |  8 --------
 3 files changed, 7 insertions(+), 19 deletions(-)

diff --git a/applets/pager/pagermodel.cpp b/applets/pager/pagermodel.cpp
index 80ce4770a..1bcbef86e 100644
--- a/applets/pager/pagermodel.cpp
+++ b/applets/pager/pagermodel.cpp
@@ -9,15 +9,11 @@
 #include "pagermodel.h"
 #include "windowmodel.h"
 
-#include <config-X11.h>
-
 #include <activityinfo.h>
 #include <virtualdesktopinfo.h>
 #include <waylandtasksmodel.h>
 #include <windowtasksmodel.h>
-#if HAVE_X11
 #include <xwindowtasksmodel.h>
-#endif
 
 #include <QDBusConnection>
 #include <QDBusMessage>
@@ -29,6 +25,8 @@
 
 #include <KWindowSystem>
 
+#include <config-X11.h>
+
 #include <PlasmaActivities/Controller>
 
 using namespace TaskManager;
@@ -563,14 +561,11 @@ void PagerModel::drop(QMimeData *mimeData, int modifiers, const QVariant &itemId
 
     bool ok = false;
     QList<QModelIndex> indices;
-    if (KWindowSystem::isPlatformWayland()) {
-        indices = findWindows(TaskManager::WaylandTasksModel::winIdsFromMimeData(mimeData, &ok));
-    }
-#if HAVE_X11
-    else if (KWindowSystem::isPlatformX11()) {
+    if (KWindowSystem::isPlatformX11()) {
         indices = findWindows(TaskManager::XWindowTasksModel::winIdsFromMimeData(mimeData, &ok));
+    } else if (KWindowSystem::isPlatformWayland()) {
+        indices = findWindows(TaskManager::WaylandTasksModel::winIdsFromMimeData(mimeData, &ok));
     }
-#endif
     if (!ok) {
         return;
     }
