From 6f004cc73faada327d66528fad1c915c8986daca Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 22:44:38 +0800
Subject: [PATCH 18/37] AOSCOS: Revert "kcms/touchpad: Drop obsolete
 BUILD_KCM_TOUCHPAD_KWIN_WAYLAND option"

Upstream-Id: 50ca366dfd29d787f00720c570d0cda5b164d171

Restore the build option and discover the Xorg libinput dependencies in the
current top-level build. The following API adaptation reconnects both
touchpad backends instead of restoring an obsolete Wayland-only source list.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 CMakeLists.txt                        |  3 +++
 config-build-options.h.cmake          |  1 +
 kcms/CMakeLists.txt                   |  4 +++-
 kcms/touchpad/backends/CMakeLists.txt | 33 ---------------------------
 kcms/touchpad/touchpadbackend.cpp     | 14 ------------
 kcms/touchpad/touchpadbackend.h       |  2 ++
 6 files changed, 9 insertions(+), 48 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ee977bf46..006ade7ab 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,7 @@ include(ECMConfiguredInstall)
 option(BUILD_DOC "Whether to build the documentation" ON)
 option(BUILD_KCM_MOUSE_KWIN_WAYLAND "Build the Mouse KCM's KWin+Wayland backend" ON)
 option(BUILD_KCM_MOUSE_X11 "Build the Mouse KCM's X11 backend" ON)
+option(BUILD_KCM_TOUCHPAD_KWIN_WAYLAND "Build the Touchpad KCM's KWin+Wayland backend" ON)
 option(BUILD_KCM_TABLET "Build the Tablet KCM" ON)
 
 find_package(Qt6 ${QT_MIN_VERSION} CONFIG REQUIRED COMPONENTS
@@ -228,6 +229,8 @@ find_package(XCB
 set_package_properties(XCB PROPERTIES TYPE REQUIRED)
 add_feature_info("XCB-XKB" XCB_XKB_FOUND "Required for building kcm/keyboard")
 
+pkg_check_modules(XORGLIBINPUT xorg-libinput IMPORTED_TARGET)
+pkg_check_modules(XORGSERVER xorg-server IMPORTED_TARGET)
 pkg_check_modules(XKBREGISTRY xkbregistry REQUIRED IMPORTED_TARGET)
 
 ecm_find_qmlmodule(org.kde.pipewire 0.1)
diff --git a/config-build-options.h.cmake b/config-build-options.h.cmake
index 77fbbaa9a..2f67d3c67 100644
--- a/config-build-options.h.cmake
+++ b/config-build-options.h.cmake
@@ -1,2 +1,3 @@
 #cmakedefine01 BUILD_KCM_MOUSE_KWIN_WAYLAND
 #cmakedefine01 BUILD_KCM_MOUSE_X11
+#cmakedefine01 BUILD_KCM_TOUCHPAD_KWIN_WAYLAND
diff --git a/kcms/CMakeLists.txt b/kcms/CMakeLists.txt
index b8858482e..eea8e071d 100644
--- a/kcms/CMakeLists.txt
+++ b/kcms/CMakeLists.txt
@@ -37,7 +37,9 @@ if (BUILD_KCM_MOUSE_KWIN_WAYLAND OR BUILD_KCM_MOUSE_X11)
     add_subdirectory(mouse)
 endif()
 
-add_subdirectory(touchpad)
+if (BUILD_KCM_TOUCHPAD_KWIN_WAYLAND)
+    add_subdirectory(touchpad)
+endif()
 
 if(BUILD_KCM_TABLET)
     add_subdirectory(tablet)
diff --git a/kcms/touchpad/backends/CMakeLists.txt b/kcms/touchpad/backends/CMakeLists.txt
index cffc8e27f..d5dd14ceb 100644
--- a/kcms/touchpad/backends/CMakeLists.txt
+++ b/kcms/touchpad/backends/CMakeLists.txt
@@ -10,36 +10,3 @@ if (BUILD_KCM_TOUCHPAD_KWIN_WAYLAND)
     )
     target_link_libraries(touchpad_common PUBLIC KF6::I18n kwindevices)
 endif()
-
-if (BUILD_KCM_TOUCHPAD_X11)
-    target_sources(touchpad_common
-        PUBLIC
-            x11/propertyinfo.cpp
-            x11/xlibbackend.cpp
-            x11/xlibtouchpad.cpp
-            x11/xcbatom.cpp
-            x11/xlibnotifications.cpp
-            x11/libinputtouchpad.cpp
-    )
-
-    target_link_libraries(touchpad_common
-        PUBLIC
-            Qt::GuiPrivate
-            XCB::ATOM
-            XCB::RECORD
-            X11::X11
-            X11::Xi
-            X11::XCB
-            PkgConfig::XORGSERVER
-            PkgConfig::XORGLIBINPUT
-    )
-
-    add_executable(kcm-touchpad-list-devices x11/listdevices.cpp)
-    target_link_libraries(kcm-touchpad-list-devices
-        X11::X11
-        X11::Xi
-    )
-    install(TARGETS kcm-touchpad-list-devices
-            DESTINATION ${KDE_INSTALL_TARGETS_DEFAULT_ARGS}
-    )
-endif()
diff --git a/kcms/touchpad/touchpadbackend.cpp b/kcms/touchpad/touchpadbackend.cpp
index 39796eea0..8da4698b2 100644
--- a/kcms/touchpad/touchpadbackend.cpp
+++ b/kcms/touchpad/touchpadbackend.cpp
@@ -10,9 +10,6 @@
 #if BUILD_KCM_TOUCHPAD_KWIN_WAYLAND
 #include "backends/kwin_wayland/kwinwaylandbackend.h"
 #endif
-#if BUILD_KCM_TOUCHPAD_X11
-#include "backends/x11/xlibbackend.h"
-#endif
 
 #include "logging.h"
 
@@ -27,17 +24,6 @@ void TouchpadBackend::setMode(TouchpadInputBackendMode mode)
 
 TouchpadBackend *TouchpadBackend::implementation()
 {
-    // There are multiple possible backends
-#if BUILD_KCM_TOUCHPAD_X11
-    if (KWindowSystem::isPlatformX11()) {
-        static QThreadStorage<std::shared_ptr<XlibBackend>> backend;
-        if (!backend.hasLocalData()) {
-            qCDebug(KCM_TOUCHPAD) << "Using X11 backend";
-            backend.setLocalData(std::shared_ptr<XlibBackend>(XlibBackend::initialize()));
-        }
-        return backend.localData().get();
-    }
-#endif
 #if BUILD_KCM_TOUCHPAD_KWIN_WAYLAND
     // TODO: test on kwin_wayland specifically? What about possibly other compositors under Wayland?
     if (KWindowSystem::isPlatformWayland()) {
diff --git a/kcms/touchpad/touchpadbackend.h b/kcms/touchpad/touchpadbackend.h
index b621c9c44..b414b9bdb 100644
--- a/kcms/touchpad/touchpadbackend.h
+++ b/kcms/touchpad/touchpadbackend.h
@@ -17,7 +17,9 @@
 
 enum class TouchpadInputBackendMode {
     Unset = 0,
+#if BUILD_KCM_TOUCHPAD_KWIN_WAYLAND
     WaylandLibinput = 1,
+#endif
 };
 
 class Q_DECL_EXPORT TouchpadBackend : public QObject
