+{
+    Q_OBJECT
+
+public:
+    LibinputTouchpad(Display *display, int deviceId);
+    ~LibinputTouchpad() override
+    {
+    }
+
+    bool load() override;
+    bool save() override;
+    bool defaults() override;
+    bool isSaveNeeded() const override;
