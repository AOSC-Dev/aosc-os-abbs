+
+#include "xcbatom.h"
+
+class LibinputTouchpad;
+class XlibNotifications;
+
+class XlibBackend : public TouchpadBackend
+{
+    Q_OBJECT
+
+public:
+    static XlibBackend *initialize(QObject *parent = nullptr);
+    ~XlibBackend();
+
+    bool save() override;
+    bool load() override;
+    bool defaults() override;
