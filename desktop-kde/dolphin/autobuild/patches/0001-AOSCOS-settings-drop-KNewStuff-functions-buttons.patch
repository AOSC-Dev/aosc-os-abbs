From 975528af0221b4733b11f2c89d1947be5bcb0b43 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Thu, 2 Jul 2026 17:02:14 +0800
Subject: [PATCH] AOSCOS: settings: drop KNewStuff functions/buttons

The "Get new ..." button may sound like a good idea, but in reality may
cause issue as plugins may be shipped as binaries, and in worse cases,
contain malware.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 CMakeLists.txt                                       |  1 -
 src/CMakeLists.txt                                   |  1 -
 src/settings/contextmenu/contextmenusettingspage.cpp | 12 ------------
 src/settings/contextmenu/servicemenu.knsrc           |  8 --------
 4 files changed, 22 deletions(-)
 delete mode 100644 src/settings/contextmenu/servicemenu.knsrc

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e3e3439b58..52de087d0b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -68,7 +68,6 @@ endif()
 
 find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS
     KCMUtils
-    NewStuff
     CoreAddons
     I18n
     DBusAddons
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 4faabe9d5a..8b9e5cf136 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -225,7 +225,6 @@ target_link_libraries(
     KF6::Completion
     KF6::TextWidgets
     KF6::ConfigCore
-    KF6::NewStuffWidgets    # KNSWidgets::Button
     KF6::Parts
     KF6::WindowSystem
     KF6::WidgetsAddons
diff --git a/src/settings/contextmenu/contextmenusettingspage.cpp b/src/settings/contextmenu/contextmenusettingspage.cpp
index 9c29e77f43..3aa01bd8a0 100644
--- a/src/settings/contextmenu/contextmenusettingspage.cpp
+++ b/src/settings/contextmenu/contextmenusettingspage.cpp
@@ -63,18 +63,6 @@ ContextMenuSettingsPage::ContextMenuSettingsPage(QWidget *parent, const KActionC
     });
     searchLayout->addWidget(m_searchLineEdit);
 
-#ifndef Q_OS_WIN
-    using NewStuffButton = KNSWidgets::Button;
-    auto *downloadButton = new NewStuffButton(i18nc("@action:button", "Download Services…"), QStringLiteral("servicemenu.knsrc"), this);
-    connect(downloadButton, &NewStuffButton::dialogFinished, this, [this](const auto &changedEntries) {
-        if (!changedEntries.isEmpty()) {
-            m_serviceModel->clear();
-            loadServices();
-        }
-    });
-    searchLayout->addWidget(downloadButton);
-#endif // Q_OS_WIN
-
 #if KIO_VERSION >= QT_VERSION_CHECK(6, 24, 0)
     auto *shortcutsButton = new QPushButton(QIcon::fromTheme(QStringLiteral("configure-shortcuts")), i18nc("@action:button", "Shortcuts…"), this);
     connect(shortcutsButton, &QPushButton::clicked, this, [this] {
diff --git a/src/settings/contextmenu/servicemenu.knsrc b/src/settings/contextmenu/servicemenu.knsrc
deleted file mode 100644
index f0e6ddbf14..0000000000
--- a/src/settings/contextmenu/servicemenu.knsrc
+++ /dev/null
@@ -1,8 +0,0 @@
-[KNewStuff3]
-ProvidersUrl=https://autoconfig.kde.org/ocs/providers.xml
-Categories=Dolphin Service Menus
-ContentWarning=Executables
-TargetDir=servicemenu-download
-Uncompress=never
-InstallationCommand=servicemenuinstaller install %f
-UninstallCommand=servicemenuinstaller uninstall %f
-- 
2.52.0

