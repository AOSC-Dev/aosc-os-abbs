From 3a7edea1d5c44159f87baab10e5e7d09dd25a60b Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Thu, 23 Jul 2026 14:11:46 +0800
Subject: [PATCH 2/2] fix initial width of folder panel

---
 src/panels/places/placespanel.cpp | 10 ++++++++++
 src/panels/places/placespanel.h   |  2 +-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/panels/places/placespanel.cpp b/src/panels/places/placespanel.cpp
index ed2341872..fd24c912d 100644
--- a/src/panels/places/placespanel.cpp
+++ b/src/panels/places/placespanel.cpp
@@ -30,6 +30,16 @@
 
 #include <Solid/StorageAccess>
 
+QSize PlacesPanel::sizeHint() const
+{
+    // The size hint will be requested already when starting Dolphin even
+    // if the panel is invisible. For performance reasons most panels delay
+    // the creation and initialization of widgets until a showEvent() is called.
+    // Because of this the size-hint of the embedded widgets cannot be used
+    // and a default size is provided:
+    return QSize(180, 180);
+}
+
 PlacesPanel::PlacesPanel(QWidget *parent)
     : KFilePlacesView(parent)
 {
diff --git a/src/panels/places/placespanel.h b/src/panels/places/placespanel.h
index 3bacfcb94..f7b73d3af 100644
--- a/src/panels/places/placespanel.h
+++ b/src/panels/places/placespanel.h
@@ -42,7 +42,7 @@ public:
 
     void requestTearDown();
     void proceedWithTearDown();
-
+    QSize sizeHint() const override;
 public Q_SLOTS:
     void readSettings();
 
