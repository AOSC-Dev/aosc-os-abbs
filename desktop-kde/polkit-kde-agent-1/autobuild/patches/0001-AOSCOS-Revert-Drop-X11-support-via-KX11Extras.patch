From 0bdd7933fcc557dc360e48c0a58a105e37a021ea Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 17:46:44 +0800
Subject: [PATCH] AOSCOS: Revert "Drop X11 support via KX11Extras"

Upstream-Id: 66ce28ab32d9f3286f4ce6a305d3059b782027b0

Keep the upstream activation-token storage and D-Bus interface unchanged.
Only select native X11 activation when showing the authentication dialog;
Wayland continues to use the upstream token path.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 policykitlistener.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/policykitlistener.cpp b/policykitlistener.cpp
index 0fc8b51..cd384cf 100644
--- a/policykitlistener.cpp
+++ b/policykitlistener.cpp
@@ -12,6 +12,7 @@
 
 #include <KLocalizedString>
 #include <KWindowSystem>
+#include <KX11Extras>
 
 #include <PolkitQt1/ActionDescription>
 #include <PolkitQt1/Agent/Session>
@@ -117,7 +118,9 @@ void PolicyKitListener::initiateAuthentication(const QString &actionId,
 
     m_dialog->show();
 
-    if (!activationToken.isEmpty()) {
+    if (KWindowSystem::isPlatformX11()) {
+        KX11Extras::forceActiveWindow(m_dialog->windowHandle()->winId());
+    } else if (!activationToken.isEmpty()) {
         handleWaylandActivation(actionId, activationToken);
     }
 
