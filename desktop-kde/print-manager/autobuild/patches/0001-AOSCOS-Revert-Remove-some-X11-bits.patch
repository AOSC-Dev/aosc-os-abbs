From 84b1b304800ddfcda40cc8780850e5b07820bb61 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 17:46:47 +0800
Subject: [PATCH] AOSCOS: Revert "Remove some X11 bits"

Upstream-Id: 277bab4292850ae72f4528836538c435376b3ca0

Keep the QWindow include needed by the existing Wayland requestActivate call
while adding native X11 dialog activation.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 src/configure-printer/ConfigurePrinterInterface.cpp | 8 +++++++-
 src/libkcups/KCupsPasswordDialog.cpp                | 4 ++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/configure-printer/ConfigurePrinterInterface.cpp b/src/configure-printer/ConfigurePrinterInterface.cpp
index de77465..8c5de24 100644
--- a/src/configure-printer/ConfigurePrinterInterface.cpp
+++ b/src/configure-printer/ConfigurePrinterInterface.cpp
@@ -13,6 +13,8 @@
 #include <KCupsPrinter.h>
 #include <KCupsRequest.h>
 
+#include <KWindowSystem>
+#include <KX11Extras>
 #include <QDBusConnection>
 #include <QDialog>
 #include <QPointer>
@@ -91,7 +93,11 @@ void ConfigurePrinterInterface::ConfigurePrinter(const QString &destName)
 
     // Check if it's not reserved
     if (m_uis.value(destName)) {
-        m_uis.value(destName)->windowHandle()->requestActivate();
+        if (KWindowSystem::isPlatformX11()) {
+            KX11Extras::forceActiveWindow(m_uis.value(destName)->winId());
+        } else {
+            m_uis.value(destName)->windowHandle()->requestActivate();
+        }
     }
 }
 
diff --git a/src/libkcups/KCupsPasswordDialog.cpp b/src/libkcups/KCupsPasswordDialog.cpp
index 9054529..30a5a4f 100644
--- a/src/libkcups/KCupsPasswordDialog.cpp
+++ b/src/libkcups/KCupsPasswordDialog.cpp
@@ -11,6 +11,7 @@
 #include <KLocalizedString>
 #include <KPasswordDialog>
 #include <KWindowSystem>
+#include <KX11Extras>
 
 KCupsPasswordDialog::KCupsPasswordDialog(QObject *parent)
     : QObject(parent)
@@ -48,6 +49,9 @@ void KCupsPasswordDialog::exec(const QString &username, bool wrongPassword)
         dialog->setAttribute(Qt::WA_NativeWindow, true);
         KWindowSystem::setMainWindow(dialog->windowHandle(), m_mainwindow);
     }
+    if (KWindowSystem::isPlatformX11()) {
+        KX11Extras::forceActiveWindow(dialog->winId());
+    }
 
     // Do not return from this method now
     dialog->exec();
