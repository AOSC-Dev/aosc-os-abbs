From 7e16f12a4531f6b061749421dd2c186d9c372633 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Fri, 26 Jun 2026 22:51:04 +0800
Subject: [PATCH] AOSCOS: kcm: drop KNewStuff functions/buttons

The "Get new ..." button may sound like a good idea, but in reality may
cause issue as plugins may be shipped as binaries, and in worse cases,
contain malware.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/kcms/decoration/ui/main.qml | 13 -------------
 src/kcms/effects/ui/main.qml    | 12 ------------
 src/kcms/scripts/ui/main.qml    | 11 -----------
 src/kcms/tabbox/main.cpp        | 17 -----------------
 4 files changed, 53 deletions(-)

diff --git a/src/kcms/decoration/ui/main.qml b/src/kcms/decoration/ui/main.qml
index 88d0db4ab4..5e306a906a 100644
--- a/src/kcms/decoration/ui/main.qml
+++ b/src/kcms/decoration/ui/main.qml
@@ -11,7 +11,6 @@ import QtQuick.Controls as QQC2
 
 import org.kde.kcmutils as KCM
 import org.kde.kirigami 2.20 as Kirigami
-import org.kde.newstuff as NewStuff
 
 KCM.AbstractKCM {
     id: root
@@ -48,18 +47,6 @@ KCM.AbstractKCM {
             text: i18nc("button text", "Configure Titlebar Buttons…")
 
             onTriggered: kcm.push("ConfigureTitlebar.qml")
-        },
-        NewStuff.Action {
-            configFile: "window-decorations-x11.knsrc"
-            text: i18nc("@action:button as in, \"Get New Window Decorations\"", "Get New…")
-
-            onEntryEvent: (entry, event) => {
-                if (event === NewStuff.Engine.StatusChangedEvent) {
-                    kcm.reloadKWinSettings();
-                } else if (event === NewStuff.Engine.EntryAdoptedEvent) {
-                    kcm.load();
-                }
-            }
         }
     ]
 
diff --git a/src/kcms/effects/ui/main.qml b/src/kcms/effects/ui/main.qml
index b0c67f1caf..343436abf0 100644
--- a/src/kcms/effects/ui/main.qml
+++ b/src/kcms/effects/ui/main.qml
@@ -13,7 +13,6 @@ import QtQuick.Layouts
 import org.kde.kcmutils
 import org.kde.config
 import org.kde.kirigami 2 as Kirigami
-import org.kde.newstuff as NewStuff
 
 import org.kde.private.kcms.kwin.effects as Private
 
@@ -21,17 +20,6 @@ ScrollViewKCM {
     implicitHeight: Kirigami.Units.gridUnit * 30
     implicitWidth: Kirigami.Units.gridUnit * 40
 
-    actions: NewStuff.Action {
-        text: i18nc("@action:button get new KWin effects", "Get New…")
-        visible: KAuthorized.authorize(KAuthorized.GHNS)
-        configFile: "kwineffect-x11.knsrc"
-        onEntryEvent: (entry, event) => {
-            if (event === NewStuff.Engine.StatusChangedEvent) {
-                kcm.onGHNSEntriesChanged()
-            }
-        }
-    }
-
     header: RowLayout {
         spacing: Kirigami.Units.smallSpacing
 
diff --git a/src/kcms/scripts/ui/main.qml b/src/kcms/scripts/ui/main.qml
index 1282252ad2..c9db732b36 100644
--- a/src/kcms/scripts/ui/main.qml
+++ b/src/kcms/scripts/ui/main.qml
@@ -10,7 +10,6 @@ import QtQuick.Layouts
 
 import org.kde.config
 import org.kde.kirigami 2 as Kirigami
-import org.kde.newstuff as NewStuff
 import org.kde.kcmutils as KCMUtils
 
 KCMUtils.ScrollViewKCM {
@@ -22,16 +21,6 @@ KCMUtils.ScrollViewKCM {
             icon.name: "document-import"
             text: i18n("Install from File…")
             onTriggered: kcm.importScript()
-        },
-        NewStuff.Action {
-            text: i18nc("@action:button get new KWin scripts", "Get New…")
-            visible: KAuthorized.authorize(KAuthorized.GHNS)
-            configFile: "kwinscripts-x11.knsrc"
-            onEntryEvent: (entry, event) => {
-                if (event === NewStuff.Engine.StatusChangedEvent) {
-                    kcm.onGHNSEntriesChanged()
-                }
-            }
         }
     ]
 
diff --git a/src/kcms/tabbox/main.cpp b/src/kcms/tabbox/main.cpp
index c58dd486cc..a4a288b5f6 100644
--- a/src/kcms/tabbox/main.cpp
+++ b/src/kcms/tabbox/main.cpp
@@ -30,7 +30,6 @@
 
 // KDE
 #include <KLocalizedString>
-#include <KNSWidgets/Button>
 #include <KPluginFactory>
 #include <KSeparator>
 #include <KTitleWidget>
@@ -74,21 +73,6 @@ KWinTabBoxConfig::KWinTabBoxConfig(QObject *parent, const KPluginMetaData &data)
     tabWidget->addTab(m_primaryTabBoxUi, i18n("Main"));
     tabWidget->addTab(m_alternativeTabBoxUi, i18n("Alternative"));
 
-    KNSWidgets::Button *ghnsButton = new KNSWidgets::Button(i18n("Get New Task Switcher Styles…"), QStringLiteral("kwinswitcher-x11.knsrc"), widget());
-    connect(ghnsButton, &KNSWidgets::Button::dialogFinished, this, [this](auto changedEntries) {
-        if (!changedEntries.isEmpty()) {
-            initLayoutLists();
-        }
-    });
-
-    QHBoxLayout *buttonBar = new QHBoxLayout();
-    QStyle *style = widget()->style();
-
-    buttonBar->setContentsMargins(style->pixelMetric(QStyle::PM_LayoutLeftMargin), 0, style->pixelMetric(QStyle::PM_LayoutRightMargin), style->pixelMetric(QStyle::PM_LayoutBottomMargin));
-    QSpacerItem *buttonBarSpacer = new QSpacerItem(40, 20, QSizePolicy::Expanding, QSizePolicy::Minimum);
-    buttonBar->addItem(buttonBarSpacer);
-    buttonBar->addWidget(ghnsButton);
-
     QVBoxLayout *layout = new QVBoxLayout(widget());
     layout->setContentsMargins(0, 0, 0, 0);
     KTitleWidget *infoLabel = new KTitleWidget(tabWidget);
@@ -99,7 +83,6 @@ KWinTabBoxConfig::KWinTabBoxConfig(QObject *parent, const KPluginMetaData &data)
     layout->addWidget(tabWidget, 1);
     KSeparator *separator = new KSeparator();
     layout->addWidget(separator);
-    layout->addLayout(buttonBar);
     widget()->setLayout(layout);
 
     addConfig(m_data->tabBoxConfig(), m_primaryTabBoxUi);
-- 
2.52.0

