From 1b461e33268349e4d8f83c5c203407f590ea93c7 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Sun, 15 Nov 2026 22:38:49 +0800
Subject: [PATCH] AOSCOS: Activate the Bluetooth PIN dialog on X11

Keep the existing pairing dialog and request focus after showing it on X11.

Upstream-Id: 6df63252a1ce64da93f4a7d7a6fe52fb0f336785

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 src/kded/helpers/requestpin.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/kded/helpers/requestpin.cpp b/src/kded/helpers/requestpin.cpp
index 4a01aec0..917a6e86 100644
--- a/src/kded/helpers/requestpin.cpp
+++ b/src/kded/helpers/requestpin.cpp
@@ -18,6 +18,8 @@
 
 #include <KLocalizedString>
 #include <KNotification>
+#include <KWindowSystem>
+#include <KX11Extras>
 
 RequestPin::RequestPin(BluezQt::DevicePtr device, bool numeric, QObject *parent)
     : QObject(parent)
@@ -86,6 +88,10 @@ void RequestPin::introducePin()
     dialog->setWindowFlags(Qt::WindowStaysOnTopHint);
 
     dialog->show();
+
+    if (KWindowSystem::isPlatformX11()) {
+        KX11Extras::forceActiveWindow(dialog->winId());
+    }
 }
 
 void RequestPin::checkPin(const QString &pin)
-- 
2.56.0

