PKGNAME=kseexpr
PKGSEC=libs
PKGDEP="libffi libpng ki18n-5 libxml2 ncurses qt-5 zlib"
BUILDDEP="extra-cmake-modules"
PKGDES="Embeddable expression evaluation engine"

ABTYPE=cmakeninja
# FIXME: -DENABLE_LLVM_BACKEND=OFF, does not support current LLVM version (14).
CMAKE_AFTER=(
    '-DBUILD_DEMOS=OFF'
    '-DBUILD_DOC=OFF'
    '-DBUILD_TESTS=OFF'
    '-DBUILD_UTILS=ON'
    '-DENABLE_LLVM_BACKEND=OFF'
    '-DENABLE_PERFORMANCE_STATS=OFF'
    '-DENABLE_QT5=ON'
    '-DENABLE_SLOW_TESTS=OFF'
    '-DFLAVOR=optimize'
    '-DUSE_PREGENERATED_FILES=OFF'
)
