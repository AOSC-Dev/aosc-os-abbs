From 44a2aaada8626ddd7c64ba0b19af10f933208e53 Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Mon, 7 Sep 2026 16:40:04 +0800
Subject: [PATCH] panelview: Recompute struts when the screen layout changes

The strut a panel sets on X11 is relative to the combined geometry of all
screens, but it was only recomputed when the screen the panel follows changed
its geometry or when the panel itself moved or was resized. Disconnecting or
resizing another screen therefore left the panel with a stale strut computed
for the previous, larger screen layout. That shrank the work area of the
remaining screens, so maximized windows no longer filled them.

Recompute the panel strut whenever any screen is added, removed or changes
geometry instead of only when the panel itself is affected.

Assisted-by: Deepseek <noreply@deepseek.com>
---
 shell/panelview.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/shell/panelview.cpp b/shell/panelview.cpp
index e5bf1c7..42630cc 100644
--- a/shell/panelview.cpp
+++ b/shell/panelview.cpp
@@ -119,6 +119,24 @@ PanelView::PanelView(ShellCorona *corona, QScreen *targetScreen, QWindow *parent
     m_strutsTimer.setSingleShot(true);
     connect(&m_strutsTimer, &QTimer::timeout, this, &PanelView::updateExclusiveZone);
 
+    // On X11 the strut a panel sets is relative to the combined geometry of all screens, so
+    // it has to be recomputed whenever the screen layout changes, even if this panel stays on
+    // the same screen. Otherwise a panel can keep a stale strut computed for the previous
+    // (e.g. larger) layout, which shrinks the work area of the remaining screens so that
+    // maximized windows no longer fill them.
+    const auto scheduleStrutsUpdate = [this]() {
+        m_strutsTimer.start(STRUTSTIMERDELAY);
+    };
+    const auto watchScreenLayout = [this, scheduleStrutsUpdate](QScreen *screen) {
+        connect(screen, &QScreen::geometryChanged, this, scheduleStrutsUpdate, Qt::UniqueConnection);
+        connect(screen, &QScreen::virtualGeometryChanged, this, scheduleStrutsUpdate, Qt::UniqueConnection);
+    };
+    for (QScreen *screen : qGuiApp->screens()) {
+        watchScreenLayout(screen);
+    }
+    connect(qGuiApp, &QGuiApplication::screenAdded, this, watchScreenLayout);
+    connect(qGuiApp, &QGuiApplication::screenRemoved, this, scheduleStrutsUpdate);
+
     connect(m_corona, &Plasma::Corona::editModeChanged, this, &PanelView::updateEditModeLabel);
 
     // Register enums
