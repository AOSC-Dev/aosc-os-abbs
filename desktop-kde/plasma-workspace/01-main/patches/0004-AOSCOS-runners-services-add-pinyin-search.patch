+++ b/CMakeLists.txt
@@ -42,6 +42,21 @@ include(ECMDeprecationSettings)
 include(ECMQmlModule)
 
 find_package(PkgConfig REQUIRED)
+pkg_check_modules(LibPinyin QUIET IMPORTED_TARGET libpinyin)
+set(HAVE_LIBPINYIN FALSE)
+if(LibPinyin_FOUND)
+    pkg_get_variable(LIBPINYIN_PKG_DATA_DIR libpinyin pkgdatadir)
+    if(EXISTS "${LIBPINYIN_PKG_DATA_DIR}/table.conf")
+        set(LIBPINYIN_DATA_DIR "${LIBPINYIN_PKG_DATA_DIR}")
+        set(HAVE_LIBPINYIN TRUE)
+    elseif(EXISTS "${LIBPINYIN_PKG_DATA_DIR}/data/table.conf")
+        set(LIBPINYIN_DATA_DIR "${LIBPINYIN_PKG_DATA_DIR}/data")
+        set(HAVE_LIBPINYIN TRUE)
+    else()
+        message(WARNING "Found libpinyin, but could not find its data files under ${LIBPINYIN_PKG_DATA_DIR}; pinyin application search will be disabled")
+    endif()
+endif()
+add_feature_info(LibPinyin HAVE_LIBPINYIN "Pinyin application search")
 pkg_check_modules(Flatpak IMPORTED_TARGET flatpak>=0.11.8)
 pkg_check_modules(PipeWire QUIET IMPORTED_TARGET libpipewire-0.3)
