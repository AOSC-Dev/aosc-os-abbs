From aa58e32d4c01d3ef27d689ceee562f2578893232 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 18:00:55 +0800
Subject: [PATCH 22/31] AOSCOS: Revert "ksmserver: Drop acting as a
 screenlocker"

Upstream-Id: 62614325fd8b2c557263df337e4caeca5ee05c42

Reuse the plasma_session option forwarding already restored in the shared
startup code rather than adding the same launch-site change again.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 CMakeLists.txt           |  2 ++
 ksmserver/CMakeLists.txt |  1 +
 ksmserver/main.cpp       | 19 +++++++++++++++++++
 ksmserver/server.cpp     |  9 +++++++++
 ksmserver/server.h       |  2 ++
 5 files changed, 33 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 88304c94e7..ceb23450fa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -201,6 +201,8 @@ if(WITH_X11)
 
     find_package(XCB MODULE REQUIRED COMPONENTS AUX XCB CURSOR RANDR IMAGE)
     set_package_properties(XCB PROPERTIES TYPE REQUIRED)
+
+    find_package(KScreenLocker ${PROJECT_DEP_VERSION} REQUIRED)
 else()
     set(HAVE_X11 0)
     set(HAVE_XCURSOR 0)
diff --git a/ksmserver/CMakeLists.txt b/ksmserver/CMakeLists.txt
index 07ac7da4e9..b93a7280bf 100644
--- a/ksmserver/CMakeLists.txt
+++ b/ksmserver/CMakeLists.txt
@@ -31,6 +31,7 @@ configure_package_config_file(KSMServerDBusInterfaceConfig.cmake.in
     INSTALL_DESTINATION ${CMAKECONFIG_INSTALL_DIR})
 
 target_link_libraries(ksmserver
+    PW::KScreenLocker
     PW::KWorkspace
     KF6::XmlGui
     KF6::I18n
diff --git a/ksmserver/main.cpp b/ksmserver/main.cpp
index 28871b094c..dbe5a69a4c 100644
--- a/ksmserver/main.cpp
+++ b/ksmserver/main.cpp
@@ -118,6 +118,13 @@ int main(int argc, char *argv[])
     QCommandLineOption nolocalOption(QStringLiteral("nolocal"), i18n("Also allow remote connections"));
     parser.addOption(nolocalOption);
 
+    QCommandLineOption lockscreenOption(QStringLiteral("lockscreen"), i18n("Starts the session in locked mode"));
+    parser.addOption(lockscreenOption);
+
+    QCommandLineOption noLockscreenOption(QStringLiteral("no-lockscreen"),
+                                          i18n("Starts without lock screen support. Only needed if other component provides the lock screen."));
+    parser.addOption(noLockscreenOption);
+
     parser.process(*a);
 
     bool only_local = !parser.isSet(nolocalOption);
@@ -136,6 +143,18 @@ int main(int argc, char *argv[])
     if (only_local) {
         flags |= KSMServer::InitFlag::OnlyLocal;
     }
+    if (parser.isSet(lockscreenOption)) {
+        flags |= KSMServer::InitFlag::ImmediateLockScreen;
+    }
+    if (parser.isSet(noLockscreenOption)) {
+        flags |= KSMServer::InitFlag::NoLockScreen;
+    }
+
+    // we use the session_type here as ksmserver is already forced as X above
+    // in wayland, kwin manages the lock screen
+    if (qgetenv("XDG_SESSION_TYPE") == QByteArrayLiteral("wayland")) {
+        flags |= KSMServer::InitFlag::NoLockScreen;
+    }
 
     auto server = new KSMServer(flags);
 
diff --git a/ksmserver/server.cpp b/ksmserver/server.cpp
index 11a073fa97..72bc34518b 100644
--- a/ksmserver/server.cpp
+++ b/ksmserver/server.cpp
@@ -69,6 +69,8 @@
 #include <KIO/DesktopExecParser>
 #include <KService>
 
+#include <KScreenLocker/KsldApp>
+
 #include <QStandardPaths>
 #include <krandom.h>
 #include <startup_interface.h>
@@ -510,6 +512,13 @@ KSMServer::KSMServer(InitFlags flags)
     , m_kwinInterface(new OrgKdeKWinSessionInterface(QStringLiteral("org.kde.KWin"), QStringLiteral("/Session"), QDBusConnection::sessionBus(), this))
     , sockets{-1, -1}
 {
+    if (!flags.testFlag(InitFlag::NoLockScreen)) {
+        ScreenLocker::KSldApp::self()->initialize();
+        if (flags.testFlag(InitFlag::ImmediateLockScreen)) {
+            ScreenLocker::KSldApp::self()->lock(ScreenLocker::EstablishLock::Immediate);
+        }
+    }
+
     if (::socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0) {
         qFatal("Could not create socket pair, error %d (%s)", errno, strerror(errno));
     }
diff --git a/ksmserver/server.h b/ksmserver/server.h
index 5e2b705331..079be92937 100644
--- a/ksmserver/server.h
+++ b/ksmserver/server.h
@@ -62,6 +62,8 @@ public:
     enum class InitFlag {
         None = 0,
         OnlyLocal = 1 << 0,
+        ImmediateLockScreen = 1 << 1,
+        NoLockScreen = 1 << 2,
     };
 
     Q_DECLARE_FLAGS(InitFlags, InitFlag)
