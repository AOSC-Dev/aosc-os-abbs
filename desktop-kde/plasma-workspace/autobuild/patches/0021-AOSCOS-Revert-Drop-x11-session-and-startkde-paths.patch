+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#pragma once
+
+enum CheckRunningState {
+    PlasmaRunning,
+    NoPlasmaRunning,
+    NoX11,
+};
+
+CheckRunningState kCheckRunning();
