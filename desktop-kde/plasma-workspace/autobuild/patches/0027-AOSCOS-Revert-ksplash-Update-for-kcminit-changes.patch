From cd4b7cb35b61550c85e3d776e04a3a94ba7b48f5 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 18:01:41 +0800
Subject: [PATCH 27/31] AOSCOS: Revert "ksplash: Update for kcminit changes"

Upstream-Id: b8d8e340d475358e528cd9209db21e2b3c917d4b

Wait for kcminit in X11 sessions while keeping the current wm stage for
Wayland startup.

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 ksplash/ksplashqml/splashapp.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/ksplash/ksplashqml/splashapp.cpp b/ksplash/ksplashqml/splashapp.cpp
index c0dfc2c874..81f85b007d 100644
--- a/ksplash/ksplashqml/splashapp.cpp
+++ b/ksplash/ksplashqml/splashapp.cpp
@@ -29,7 +29,7 @@
  * There are 6 stages in ksplash
  *  - initial (from this class)
  *  - startPlasma (from startplasma)
- *  - kcminit (dropped)
+ *  - kcminit
  *  - ksmserver
  *  - wm (for X11 from KWin, for Wayland from this class)
  *  - desktop (from shellcorona)
@@ -70,8 +70,11 @@ SplashApp::SplashApp(int &argc, char **argv)
     }
 
     setStage(QStringLiteral("initial"));
-    setStage(QStringLiteral("kcminit"));
-    setStage(QStringLiteral("wm"));
+    if (KWindowSystem::isPlatformWayland()) {
+        setStage(QStringLiteral("wm"));
+    } else {
+        setStage(QStringLiteral("kcminit"));
+    }
 
     if (m_testing) {
         m_timer.start(TEST_STEP_INTERVAL, this);
