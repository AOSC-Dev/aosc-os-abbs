From 0fdc2e833a01554982dd5a2c80c1c1941b81c392 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 17:57:35 +0800
Subject: [PATCH 06/31] AOSCOS: Revert "plasmashell/CMake: don't search or link
 to x11 anymore"

Upstream-Id: 5c37d1b98ad7ea1798e978eecf6d8cac26d323c8

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 shell/CMakeLists.txt           | 4 ++++
 shell/autotests/CMakeLists.txt | 4 ++++
 shell/config-plasma.h.cmake    | 1 +
 shell/tests/CMakeLists.txt     | 4 ++++
 4 files changed, 13 insertions(+)

diff --git a/shell/CMakeLists.txt b/shell/CMakeLists.txt
index 05393e8838..58913c85a8 100644
--- a/shell/CMakeLists.txt
+++ b/shell/CMakeLists.txt
@@ -148,6 +148,10 @@ endif()
 target_include_directories(plasmashell PRIVATE "${CMAKE_BINARY_DIR}")
 target_compile_definitions(plasmashell PRIVATE -DPROJECT_VERSION="${PROJECT_VERSION}")
 
+if(HAVE_X11)
+  target_link_libraries(plasmashell PRIVATE XCB::XCB XCB::RANDR)
+endif()
+
 if(PROJECT_VERSION_PATCH GREATER_EQUAL 80 OR PROJECT_VERSION_MINOR GREATER_EQUAL 80)
     target_link_libraries(plasmashell PRIVATE KF6::KIOGui)
 endif()
diff --git a/shell/autotests/CMakeLists.txt b/shell/autotests/CMakeLists.txt
index 7c94c19127..db70efc7e9 100644
--- a/shell/autotests/CMakeLists.txt
+++ b/shell/autotests/CMakeLists.txt
@@ -61,6 +61,10 @@ MACRO(PLASMASHELL_UNIT_TESTS)
                             SharedClientTest
                                      )
                target_link_libraries(${_testname} KF6::ConfigQml)
+               if(HAVE_X11)
+                  target_link_libraries(${_testname} XCB::XCB XCB::RANDR)
+                  target_link_libraries(${_testname} Qt::GuiPrivate)
+               endif()
                if(QT_QTOPENGL_FOUND)
                    target_link_libraries(${_testname} Qt::OpenGL)
                endif()
diff --git a/shell/config-plasma.h.cmake b/shell/config-plasma.h.cmake
index 99fa0f67da..d25435f1ad 100644
--- a/shell/config-plasma.h.cmake
+++ b/shell/config-plasma.h.cmake
@@ -1 +1,2 @@
+#cmakedefine01 HAVE_X11
 #cmakedefine01 USE_SCRIPTING
diff --git a/shell/tests/CMakeLists.txt b/shell/tests/CMakeLists.txt
index fb8d83d64b..3536b9fb5f 100644
--- a/shell/tests/CMakeLists.txt
+++ b/shell/tests/CMakeLists.txt
@@ -23,6 +23,10 @@ target_link_libraries(screenpoolmanualtest
             Wayland::Client
             PW::KWorkspace
                         )
+if(HAVE_X11)
+    target_link_libraries(screenpoolmanualtest XCB::XCB XCB::RANDR)
+    target_link_libraries(screenpoolmanualtest Qt::GuiPrivate)
+endif()
 if(QT_QTOPENGL_FOUND)
     target_link_libraries(screenpoolmanualtest Qt::OpenGL)
 endif()
