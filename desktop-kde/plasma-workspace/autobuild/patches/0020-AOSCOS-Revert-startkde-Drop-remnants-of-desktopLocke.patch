From 75f2451b8a75e47572bbbd5296246d89bb4be6d5 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 18:00:22 +0800
Subject: [PATCH 20/31] AOSCOS: Revert "startkde: Drop remnants of
 desktopLockedAtStart"

Upstream-Id: 65b3c6625fcc21268da8580fa54dbccc06d8f24d

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 startkde/startplasma.cpp | 22 +++++++++++++++-------
 1 file changed, 15 insertions(+), 7 deletions(-)

diff --git a/startkde/startplasma.cpp b/startkde/startplasma.cpp
index 5f25cd5ed2..3a428bfac5 100644
--- a/startkde/startplasma.cpp
+++ b/startkde/startplasma.cpp
@@ -551,16 +551,24 @@ bool syncDBusEnvironment()
     return true;
 }
 
+static bool desktopLockedAtStart = false;
+
 QProcess *setupKSplash()
 {
+    const auto dlstr = qgetenv("DESKTOP_LOCKED");
+    desktopLockedAtStart = dlstr == "true" || dlstr == "1";
+    qunsetenv("DESKTOP_LOCKED"); // Don't want it in the environment
+
     QProcess *p = nullptr;
-    const KConfig cfg(QStringLiteral("ksplashrc"));
-    // the splashscreen and progress indicator
-    KConfigGroup ksplashCfg = cfg.group(QStringLiteral("KSplash"));
-    if (ksplashCfg.readEntry("Engine", QStringLiteral("KSplashQML")) == QLatin1String("KSplashQML")) {
-        p = new QProcess;
-        p->setProcessChannelMode(QProcess::ForwardedChannels);
-        p->start(QStringLiteral("ksplashqml"), {ksplashCfg.readEntry("Theme", QStringLiteral("Breeze"))});
+    if (!desktopLockedAtStart) {
+        const KConfig cfg(QStringLiteral("ksplashrc"));
+        // the splashscreen and progress indicator
+        KConfigGroup ksplashCfg = cfg.group(QStringLiteral("KSplash"));
+        if (ksplashCfg.readEntry("Engine", QStringLiteral("KSplashQML")) == QLatin1String("KSplashQML")) {
+            p = new QProcess;
+            p->setProcessChannelMode(QProcess::ForwardedChannels);
+            p->start(QStringLiteral("ksplashqml"), {ksplashCfg.readEntry("Theme", QStringLiteral("Breeze"))});
+        }
     }
     return p;
 }
