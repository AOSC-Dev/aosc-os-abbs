+bool XWindowTasksModel::Private::demandsAttention(WId window)
+{
+    if (windows.contains(window)) {
+        return ((windowInfo(window)->hasState(NET::DemandsAttention)) || transientsDemandingAttention.contains(window));
+    }
+
+    return false;
+}
