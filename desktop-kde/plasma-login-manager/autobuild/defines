PKGNAME=plasma-login-manager
PKGSEC=x11
PKGDEP="qt-6"
PKGDEP="kauth kconfig kdbusaddons ki18n kcmutils kio kpackage kwindowsystem layer-shell-qt \
        libplasma plasma-workspace qt-6"
BUILDDEP="docutils extra-cmake-modules"
PKGDES="WIP Display Manager for KDE Plasma"

CMAKE_AFTER="-DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d \
             -DBUILD_MAN_PAGES=ON \
             -DBUILD_WITH_QT6=ON  \
             -DDBUS_CONFIG_FILENAME=plasmalogin_org.freedesktop.DisplayManager.conf \
             -DINSTALL_PAM_CONFIGURATION:BOOL=OFF"
