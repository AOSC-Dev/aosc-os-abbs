From fecba712cef0ec561a791fa7e1175b6c7d65c054 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 22:38:57 +0800
Subject: [PATCH 2/5] AOSCOS: Revert "remove some leftovers from X11 mirroring
 code"

Upstream-Id: 6ae686a5c1530870f5f6c89201b76142f1277029

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 kcm/output_model.cpp | 13 +++++++++----
 kcm/output_model.h   |  1 +
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/kcm/output_model.cpp b/kcm/output_model.cpp
index 8a884271..d9de1fa7 100644
--- a/kcm/output_model.cpp
+++ b/kcm/output_model.cpp
@@ -879,12 +879,17 @@ QList<float> OutputModel::refreshRates(const KScreen::OutputPtr &output) const
     return hits;
 }
 
+int OutputModel::replicationSourceId(const Output &output) const
+{
+    return output.ptr->replicationSource();
+}
+
 std::optional<QList<KScreen::OutputPtr>> OutputModel::possibleReplicationSources(const KScreen::OutputPtr &output) const
 {
     QList<KScreen::OutputPtr> ret;
     for (const auto &out : m_outputs) {
         if (out.ptr->id() != output->id()) {
-            const int outSourceId = out.ptr->replicationSource();
+            const int outSourceId = replicationSourceId(out);
             if (outSourceId == output->id()) {
                 // 'output' is already source for replication, can't be replica itself
                 return std::nullopt;
@@ -947,7 +952,7 @@ bool OutputModel::setReplicationSourceIndex(int outputIndex, int sourceIndex)
     }
 
     Output &output = m_outputs[outputIndex];
-    const int oldSourceId = output.ptr->replicationSource();
+    const int oldSourceId = replicationSourceId(output);
 
     const auto optSources = possibleReplicationSources(output.ptr);
     if (!optSources.has_value() || sourceIndex >= optSources->size()) {
@@ -991,7 +996,7 @@ bool OutputModel::setReplicationSourceIndex(int outputIndex, int sourceIndex)
 
 int OutputModel::replicationSourceIndex(int outputIndex) const
 {
-    const int sourceId = m_outputs[outputIndex].ptr->replicationSource();
+    const int sourceId = replicationSourceId(m_outputs[outputIndex]);
     if (!sourceId) {
         return 0;
     }
@@ -1010,7 +1015,7 @@ QVariantList OutputModel::replicasModel(const KScreen::OutputPtr &output) const
     for (int i = 0; i < m_outputs.size(); i++) {
         const Output &out = m_outputs[i];
         if (out.ptr->id() != output->id()) {
-            if (out.ptr->replicationSource() == output->id()) {
+            if (replicationSourceId(out) == output->id()) {
                 ret << i;
             }
         }
diff --git a/kcm/output_model.h b/kcm/output_model.h
index 8eb1d994..42162db8 100644
--- a/kcm/output_model.h
+++ b/kcm/output_model.h
@@ -174,6 +174,7 @@ private:
     QVariantList replicationSourceModelWithNumbers(const KScreen::OutputPtr &output) const;
     bool setReplicationSourceIndex(int outputIndex, int sourceIndex);
     int replicationSourceIndex(int outputIndex) const;
+    int replicationSourceId(const Output &output) const;
 
     QVariantList replicasModel(const KScreen::OutputPtr &output) const;
 
