From 06a88188b31cb372c0d273d2498adfa82ac5e0d4 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Fri, 13 Nov 2026 17:49:44 +0800
Subject: [PATCH 1/5] AOSCOS: Revert "CMake: Cleanup unused WITH_X11 option and
 X11/XCB dependencies"

Upstream-Id: b4b9762f47fecc2e6b425906b731c68e8a415587

Assisted-by: deepseek-v4-flash
Signed-off-by: SignKirigami <prcups@krgm.moe>
---
 CMakeLists.txt     | 16 ++++++++++++++++
 config-X11.h.cmake |  2 ++
 2 files changed, 18 insertions(+)
 create mode 100644 config-X11.h.cmake

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 34a1cf63..f9509aa9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -74,9 +74,25 @@ set_package_properties(WaylandProtocols PROPERTIES
     URL "https://gitlab.freedesktop.org/wayland/wayland-protocols/"
 )
 
+option(WITH_X11 "Enable X11 support" ON)
+
+if(WITH_X11)
+    find_package(X11)
+    set_package_properties(X11 PROPERTIES
+        DESCRIPTION "X11 libraries"
+        URL "https://www.x.org"
+        PURPOSE "Required for touchscreen XInput mapping to internal display"
+        TYPE REQUIRED
+    )
+    find_package(X11_XCB REQUIRED)
+    find_package(XCB REQUIRED COMPONENTS XCB ATOM)
+endif()
+
 ecm_find_qmlmodule(org.kde.kitemmodels REQUIRED)
 ecm_find_qmlmodule(org.kde.plasma.plasma5support REQUIRED)
 
+configure_file(config-X11.h.cmake ${CMAKE_CURRENT_BINARY_DIR}/config-X11.h)
+
 ecm_set_disabled_deprecation_versions(QT 6.8.0
     KF 6.12.0
 )
diff --git a/config-X11.h.cmake b/config-X11.h.cmake
new file mode 100644
index 00000000..a238d1e8
--- /dev/null
+++ b/config-X11.h.cmake
@@ -0,0 +1,2 @@
+/* Define if you have X11 at all */
+#cmakedefine01 WITH_X11
