From 16b1de175d2476230deac58b2554ccd3feafab5a Mon Sep 17 00:00:00 2001
From: Signal Kirigami <prcups@krgm.moe>
Date: Fri, 19 Sep 2025 00:00:52 +0800
Subject: [PATCH 2/2] Fix x11 lock race with suspend

Co-authored-by: Ruikai Liu <rickliu2000@foxmail.com>
---
 greeter/greeterapp.cpp |  1 +
 greeter/greeterapp.h   |  2 ++
 x11locker.cpp          | 13 ++++++++++++-
 x11locker.h            |  1 +
 4 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/greeter/greeterapp.cpp b/greeter/greeterapp.cpp
index 53228318..8be73db9 100644
--- a/greeter/greeterapp.cpp
+++ b/greeter/greeterapp.cpp
@@ -40,6 +40,7 @@ SPDX-License-Identifier: GPL-2.0-or-later
 // Qt
 #include <QAbstractNativeEventFilter>
 #include <QClipboard>
+#include <QDBusAbstractAdaptor>
 #include <QDBusConnection>
 #include <QFile>
 #include <QKeyEvent>
diff --git a/greeter/greeterapp.h b/greeter/greeterapp.h
index 65499790..922ed093 100644
--- a/greeter/greeterapp.h
+++ b/greeter/greeterapp.h
@@ -35,6 +35,7 @@ namespace ScreenLocker
 {
 class WallpaperIntegration;
 class ShellIntegration;
+class X11NotifyAdaptor;
 
 class UnlockApp : public QGuiApplication
 {
@@ -94,6 +95,7 @@ private:
 
     KPackage::Package m_wallpaperPackage;
     ShellIntegration *m_shellIntegration;
+    X11NotifyAdaptor *m_x11NotifyObject;
     LogindIntegration *m_logindIntegration;
 };
 } // namespace
diff --git a/x11locker.cpp b/x11locker.cpp
index 64e4d2ca..e9a6029d 100644
--- a/x11locker.cpp
+++ b/x11locker.cpp
@@ -12,6 +12,7 @@ SPDX-License-Identifier: GPL-2.0-or-later
 // KDE
 // Qt
 #include <QApplication>
+#include <QDBusConnection>
 #include <QScreen>
 // X11
 #include "x11info.h"
@@ -81,6 +82,12 @@ void X11Locker::initialize()
     for (auto *screen : screens) {
         connect(screen, &QScreen::geometryChanged, this, &X11Locker::updateGeo);
     }
+    QDBusConnection::sessionBus().connect(QStringLiteral("org.kde.kscreenlocker.greetapp"),
+                                          QStringLiteral("/org/kde/x11NotifyService"),
+                                          QStringLiteral("org.kde.kscreenlocker_greet"),
+                                          QStringLiteral("x11LockWindowShown"),
+                                          this,
+                                          SLOT(onX11Notify()));
 }
 
 void X11Locker::showLockWindow()
@@ -383,7 +390,6 @@ bool X11Locker::nativeEventFilter(const QByteArray &eventType, void *message, qi
             }
             if (xm->window == m_background->winId()) {
                 m_background->update();
-                Q_EMIT lockWindowShown();
                 ret = false;
             } else {
                 ret = true;
@@ -549,6 +555,11 @@ void X11Locker::addAllowedWindow(quint32 window)
     }
 }
 
+void X11Locker::onX11Notify()
+{
+    qCDebug(KSCREENLOCKER) << "x11LockWindowShown received";
+    Q_EMIT lockWindowShown();
+}
 }
 
 #include "moc_x11locker.cpp"
diff --git a/x11locker.h b/x11locker.h
index d320f0ae..1956632c 100644
--- a/x11locker.h
+++ b/x11locker.h
@@ -35,6 +35,7 @@ public:
 
 private Q_SLOTS:
     void updateGeo();
+    void onX11Notify();
 
 private:
     void initialize();
-- 
