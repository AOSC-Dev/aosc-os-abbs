From e60e9e689aa9e277704b32ad78f216d275fabd5a Mon Sep 17 00:00:00 2001
From: Yemu Lu <prcups@krgm.moe>
Date: Fri, 3 Oct 2025 17:00:36 +0800
Subject: [PATCH 3/3] AOSCOS: Fix race between sleep entry and locking

---
 greeter/greeterapp.h | 1 -
 x11locker.cpp        | 2 +-
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/greeter/greeterapp.h b/greeter/greeterapp.h
index 84bb119..6d29e5d 100644
--- a/greeter/greeterapp.h
+++ b/greeter/greeterapp.h
@@ -83,7 +83,6 @@ private:
     PamAuthenticators *m_authenticators;
     int m_graceTime;
     bool m_noLock;
-
     QString m_userName, m_userImage;
 
     KPackage::Package m_wallpaperPackage;
diff --git a/x11locker.cpp b/x11locker.cpp
index 0058ff1..38abe09 100644
--- a/x11locker.cpp
+++ b/x11locker.cpp
@@ -402,7 +402,6 @@ bool X11Locker::nativeEventFilter(const QByteArray &eventType, void *message, qi
             }
             if (xm->window == m_background->winId()) {
                 m_background->update();
-                Q_EMIT lockWindowShown();
                 ret = false;
             } else {
                 ret = true;
@@ -566,6 +565,7 @@ void X11Locker::addAllowedWindow(quint32 window)
         m_lockWindows.prepend(window);
         stayOnTop();
     }
+    Q_EMIT lockWindowShown();
 }
 
 }
