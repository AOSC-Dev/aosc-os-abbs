From dac090d7ec4b0852c884b9bfdac877ac5199e846 Mon Sep 17 00:00:00 2001
From: Yemu Lu <prcups@krgm.moe>
Date: Fri, 3 Oct 2025 17:00:36 +0800
Subject: [PATCH 2/2] AOSCOS: Fix race between sleep entry and locking

---
 greeter/greeterapp.cpp | 21 ++++++++++++---------
 greeter/greeterapp.h   |  1 +
 x11locker.cpp          |  2 +-
 3 files changed, 14 insertions(+), 10 deletions(-)

diff --git a/greeter/greeterapp.cpp b/greeter/greeterapp.cpp
index 53228318..d6c0a531 100644
--- a/greeter/greeterapp.cpp
+++ b/greeter/greeterapp.cpp
@@ -132,6 +132,7 @@ UnlockApp::UnlockApp(int &argc, char **argv)
     , m_immediateLock(false)
     , m_graceTime(0)
     , m_noLock(false)
+    , m_ksldDelayAddWindow(false)
     , m_shellIntegration(new ShellIntegration(this))
     , m_logindIntegration(new LogindIntegration(this))
 {
@@ -319,12 +320,6 @@ PlasmaQuick::QuickViewSharedEngine *UnlockApp::createViewForScreen(QScreen *scre
         }
     }
 
-    if (m_ksldInterface) {
-        view->create();
-        org_kde_ksld_x11window(m_ksldInterface, view->winId());
-        wl_display_flush(m_display);
-    }
-
     // engine stuff
     QQmlContext *context = view->engine()->rootContext();
     connect(view->engine().get(), &QQmlEngine::quit, this, [this]() {
@@ -433,6 +428,12 @@ PlasmaQuick::QuickViewSharedEngine *UnlockApp::createViewForScreen(QScreen *scre
 
     auto onFrameSwapped = [this, view] {
         markViewsAsVisible(view);
+        if (m_ksldInterface) {
+            org_kde_ksld_x11window(m_ksldInterface, view->winId());
+            wl_display_flush(m_display);
+        } else {
+            m_ksldDelayAddWindow = true;
+        }
     };
     connect(view, &QQuickWindow::frameSwapped, this, onFrameSwapped, static_cast<Qt::ConnectionType>(Qt::QueuedConnection | Qt::SingleShotConnection));
 
@@ -634,9 +635,11 @@ void UnlockApp::setKsldSocket(int socket)
         auto self = static_cast<UnlockApp *>(data);
         // bind version 1 as we dropped all the V2 features
         self->m_ksldInterface = static_cast<org_kde_ksld *>(wl_registry_bind(registry, name, &org_kde_ksld_interface, 1));
-        for (auto v : std::as_const(self->m_views)) {
-            org_kde_ksld_x11window(self->m_ksldInterface, v->winId());
-            wl_display_flush(self->m_display);
+        if (self->m_ksldDelayAddWindow) {
+            for (auto v : std::as_const(self->m_views)) {
+                org_kde_ksld_x11window(self->m_ksldInterface, v->winId());
+                wl_display_flush(self->m_display);
+            }
         }
     };
     auto noopGlobalRemove = [](void *, struct wl_registry *, uint32_t) {};
diff --git a/greeter/greeterapp.h b/greeter/greeterapp.h
index 65499790..49b723b1 100644
--- a/greeter/greeterapp.h
+++ b/greeter/greeterapp.h
@@ -86,6 +86,7 @@ private:
     PamAuthenticators *m_authenticators;
     int m_graceTime;
     bool m_noLock;
+    bool m_ksldDelayAddWindow;
 
     QString m_userName, m_userImage;
 
diff --git a/x11locker.cpp b/x11locker.cpp
index 64e4d2ca..ef5f4fe3 100644
--- a/x11locker.cpp
+++ b/x11locker.cpp
@@ -383,7 +383,6 @@ bool X11Locker::nativeEventFilter(const QByteArray &eventType, void *message, qi
             }
             if (xm->window == m_background->winId()) {
                 m_background->update();
-                Q_EMIT lockWindowShown();
                 ret = false;
             } else {
                 ret = true;
@@ -547,6 +546,7 @@ void X11Locker::addAllowedWindow(quint32 window)
         m_lockWindows.prepend(window);
         stayOnTop();
     }
+    Q_EMIT lockWindowShown();
 }
 
 }
-- 
2.52.0

