abinfo "Building plasma-integration (Qt 5) ..."
CMAKE_AFTER=(
    "${CMAKE_AFTER[@]}"
    '-DBUILD_QT5=ON'
    '-DBUILD_QT6=OFF'
)
build_cmakeninja_configure
build_cmakeninja_build
build_cmakeninja_install

abinfo "Cleaning up ..."
rm -rv "$BLDDIR"

abinfo "Building plasma-integration (Qt 6) ..."
CMAKE_AFTER=(
    "${CMAKE_AFTER[@]}"
    '-DBUILD_QT5=OFF'
    '-DBUILD_QT6=ON'
)
build_cmakeninja_configure
build_cmakeninja_build
build_cmakeninja_install
