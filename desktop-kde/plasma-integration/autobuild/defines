        kcompletion kcompletion-5 kconfig kconfig-5 kconfigwidgets \
        kconfigwidgets-5 kcoreaddons kcoreaddons-5 ki18n ki18n-5 \
        kiconthemes kiconthemes-5 kio kio-5 kitemviews kitemviews-5 \
        kjobwidgets kjobwidgets-5 knotifications knotifications-5 \
        kservice kservice-5 kwayland kwayland-5 kwidgetsaddons \
        kwidgetsaddons-5 kwindowsystem kwindowsystem-5 kxmlgui kxmlgui-5 \
        kstatusnotifieritem noto-fonts solid solid-5"
