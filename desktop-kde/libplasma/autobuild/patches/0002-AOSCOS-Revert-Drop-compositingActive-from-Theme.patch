 void ThemePrivate::updateKSvgSelectors()
 {
+#if HAVE_X11
+    if (KWindowSystem::isPlatformX11()) {
+        compositingActive = KX11Extras::compositingActive();
+    } else {
+        compositingActive = true;
+    }
