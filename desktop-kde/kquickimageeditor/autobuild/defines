PKGNAME=kquickimageeditor
PKGSEC=kde
PKGDEP="highway kconfig kirigami qt-6"
BUILDDEP="extra-cmake-modules"
BUILDDEP__LOONGSON3="${BUILDDEP} llvm"
BUILDDEP__LOONGARCH64_NOSIMD="${BUILDDEP} llvm"
BUILDDEP__RISCV64="${BUILDDEP} llvm"
PKGDES="QtQuick components providing basic image editing capabilities"

#FIXME: The EMU128 mode of highway is broken on GCC < 16, causing architectures 
#       with no native highway support fallback to scalar mode.
#       Starting from kquickimageeditor v0.7.0, stackblur requires 4-channel
#       SIMD group: src/annotations/stackblur.cpp:268 hn::FixedTag<uint16_t, 4>
#       And using scalar mode will cause assertions like: 
#       /usr/include/hwy/ops/shared-inl.h:369:27: 
#       error: static assertion failed: Too many lanes
#       369 |   static_assert(kNumLanes <= HWY_LANES(T), "Too many lanes");
#       Here we use llvm on loongarch64_nosimd, loongson3 and riscv64 
#       to enable EMU128. 
USECLANG__LOONGSON3=1
USECLANG__LOONGARCH64_NOSIMD=1
USECLANG__RISCV64=1
ABTYPE=cmakeninja
