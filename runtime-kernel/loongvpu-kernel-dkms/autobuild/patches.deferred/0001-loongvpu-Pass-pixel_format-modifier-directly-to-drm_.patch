From 07a95f06b980ccef7f9be2ebc4c091a6731730c6 Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Mon, 13 Oct 2025 11:00:22 +0800
Subject: [PATCH 01/15] loongvpu: Pass pixel_format+modifier directly to
 drm_get_format_info()

Link: https://patchwork.freedesktop.org/patch/msgid/20250701090722.13645-3-ville.syrjala@linux.intel.com
---
 conftest.sh          | 12 ++++++++++++
 hantro/hantro.Kbuild |  1 +
 hantro/hantro_drm.c  |  4 ++++
 3 files changed, 17 insertions(+)

diff --git a/conftest.sh b/conftest.sh
index da0daa2..a0a679d 100644
--- a/conftest.sh
+++ b/conftest.sh
@@ -916,6 +916,18 @@ compile_test() {
             $CC $CFLAGS -E -P conftest$$.c
             rm -f conftest$$.c
         ;;
+        drm_get_format_info_use_pixel_format)
+            #
+            # Determine if drm_get_format_info uses pixel_format as argument
+            #
+            CODE="#include <drm/drm.h>
+            #include <drm/drm_fourcc.h>
+            void conftest_drm_get_format_info_use_pixel_format(struct drm_device *dev) {
+                drm_get_format_info(dev, 0, 0);
+            }"
+
+            compile_check_conftest "$CODE" "LG_DRM_GET_FORMAT_INFO_USE_PIXEL_FORMAT" "" "types"
+        ;;
 
         # When adding a new conftest entry, please use the correct format for
         # specifying the relevant upstream Linux kernel commit.  Please
diff --git a/hantro/hantro.Kbuild b/hantro/hantro.Kbuild
index 9bcdb0e..77141a7 100644
--- a/hantro/hantro.Kbuild
+++ b/hantro/hantro.Kbuild
@@ -173,3 +173,4 @@ LG_CONFTEST_TYPE_COMPILE_TESTS += dma_resv_reserve_fences
 LG_CONFTEST_TYPE_COMPILE_TESTS += drm_gem_object_reference
 LG_CONFTEST_TYPE_COMPILE_TESTS += drm_driver_prime_flag_present
 LG_CONFTEST_TYPE_COMPILE_TESTS += drm_gem_object_put_unlocked
+LG_CONFTEST_TYPE_COMPILE_TESTS += drm_get_format_info_use_pixel_format
diff --git a/hantro/hantro_drm.c b/hantro/hantro_drm.c
index 0d95923..96f9a28 100644
--- a/hantro/hantro_drm.c
+++ b/hantro/hantro_drm.c
@@ -714,7 +714,11 @@ static int hantro_fb_create2(struct drm_device *dev, void *data,
 	struct hantro_drm_fb *vsifb;
 	struct drm_gem_object *objs[4];
 	struct drm_gem_object *obj;
+#if defined(LG_DRM_GET_FORMAT_INFO_USE_PIXEL_FORMAT)
+	const struct drm_format_info *info = drm_get_format_info(dev, mode_cmd->pixel_format, mode_cmd->modifier[0]);
+#else
 	const struct drm_format_info *info = drm_get_format_info(dev, mode_cmd);
+#endif
 	unsigned int hsub;
 	unsigned int vsub;
 	int num_planes;
-- 
2.54.0

