From e9b5c3748b56cdd818f3abd7a5ec71fc9a8f03a7 Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Mon, 13 Oct 2025 11:22:11 +0800
Subject: [PATCH 04/15] loongvpu: pass string literal parameter to
 MODULE_IMPORT_NS for Linux >= 6.13

References: cdd30ebb1b9f ("module: Convert symbol namespace to string literal")
---
 hantro/hantro_drv.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/hantro/hantro_drv.c b/hantro/hantro_drv.c
index ff7ad87..d72d2b5 100644
--- a/hantro/hantro_drv.c
+++ b/hantro/hantro_drv.c
@@ -1269,8 +1269,12 @@ int __init hantro_init(void)
 module_init(hantro_init);
 module_exit(hantro_cleanup);
 #if defined(MODULE_IMPORT_NS)
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0))
+MODULE_IMPORT_NS("DMA_BUF");
+#else
 MODULE_IMPORT_NS(DMA_BUF);
 #endif
+#endif
 /* module description */
 MODULE_LICENSE("GPL v2");
 MODULE_AUTHOR("Verisilicon");
-- 
2.54.0

