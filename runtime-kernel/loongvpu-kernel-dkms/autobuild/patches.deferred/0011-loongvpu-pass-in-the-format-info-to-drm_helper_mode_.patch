From af05e760173cefdcaefadc27373f1261a4397a73 Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Mon, 13 Oct 2025 11:33:03 +0800
Subject: [PATCH 11/15] loongvpu: pass in the format info to
 drm_helper_mode_fill_fb_struct()

Link: https://patchwork.freedesktop.org/patch/msgid/20250701090722.13645-6-ville.syrjala@linux.intel.com
---
 conftest.sh          | 14 ++++++++++++++
 hantro/hantro.Kbuild |  1 +
 hantro/hantro_drm.c  |  4 ++++
 3 files changed, 19 insertions(+)

diff --git a/conftest.sh b/conftest.sh
index a0a679d..f44f254 100644
--- a/conftest.sh
+++ b/conftest.sh
@@ -928,6 +928,20 @@ compile_test() {
 
             compile_check_conftest "$CODE" "LG_DRM_GET_FORMAT_INFO_USE_PIXEL_FORMAT" "" "types"
         ;;
+        drm_helper_mode_fill_fb_struct_passes_info)
+            #
+            # Determine if drm_helper_mode_fill_fb_struct function accepts a format info argument.
+            #
+            CODE="#include <drm/drm_modeset_helper.h>
+            void conftest_drm_helper_mode_fill_fb_struct_passes_info(
+                    struct drm_device *dev,
+                    struct drm_framebuffer *fb,
+				    const struct drm_mode_fb_cmd2 *mode_cmd) {
+                return drm_helper_mode_fill_fb_struct(dev, fb, 0, mode_cmd);
+            }"
+
+            compile_check_conftest "$CODE" "LG_DRM_HELPER_MODE_FILL_FB_STRUCT_PASSES_INFO" "" "types"
+        ;;
 
         # When adding a new conftest entry, please use the correct format for
         # specifying the relevant upstream Linux kernel commit.  Please
diff --git a/hantro/hantro.Kbuild b/hantro/hantro.Kbuild
index 77141a7..3500e4d 100644
--- a/hantro/hantro.Kbuild
+++ b/hantro/hantro.Kbuild
@@ -174,3 +174,4 @@ LG_CONFTEST_TYPE_COMPILE_TESTS += drm_gem_object_reference
 LG_CONFTEST_TYPE_COMPILE_TESTS += drm_driver_prime_flag_present
 LG_CONFTEST_TYPE_COMPILE_TESTS += drm_gem_object_put_unlocked
 LG_CONFTEST_TYPE_COMPILE_TESTS += drm_get_format_info_use_pixel_format
+LG_CONFTEST_TYPE_COMPILE_TESTS += drm_helper_mode_fill_fb_struct_passes_info
diff --git a/hantro/hantro_drm.c b/hantro/hantro_drm.c
index 9c06919..7946989 100644
--- a/hantro/hantro_drm.c
+++ b/hantro/hantro_drm.c
@@ -747,7 +747,11 @@ static int hantro_fb_create2(struct drm_device *dev, void *data,
 	vsifb = kzalloc(sizeof(*vsifb), GFP_KERNEL);
 	if (!vsifb)
 		return -ENOMEM;
+#if defined(LG_DRM_HELPER_MODE_FILL_FB_STRUCT_PASSES_INFO)
+	drm_helper_mode_fill_fb_struct(dev, &vsifb->fb, NULL, mode_cmd);
+#else
 	drm_helper_mode_fill_fb_struct(dev, &vsifb->fb, mode_cmd);
+#endif
 	for (i = 0; i < num_planes; i++)
 		vsifb->obj[i] = objs[i];
 	ret = drm_framebuffer_init(dev, &vsifb->fb, &hantro_drm_fb_funcs);
-- 
2.54.0

