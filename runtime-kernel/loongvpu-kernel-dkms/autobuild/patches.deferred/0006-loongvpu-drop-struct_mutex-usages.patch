From 69dc45fc0fe8d847327a711373c983f70550a03b Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Mon, 13 Oct 2025 16:17:45 +0800
Subject: [PATCH 06/15] loongvpu: drop struct_mutex usages

Link: https://lore.kernel.org/r/20250908131518.36625-2-luiz.mello@estudante.ufscar.br
---
 hantro/hantro_drm.c   | 39 ++++++++++++++++-----------------------
 include/hantro_priv.h |  1 +
 2 files changed, 17 insertions(+), 23 deletions(-)

diff --git a/hantro/hantro_drm.c b/hantro/hantro_drm.c
index 50f2aae..300a911 100644
--- a/hantro/hantro_drm.c
+++ b/hantro/hantro_drm.c
@@ -114,8 +114,6 @@ static int hantro_gem_dumb_create_internal(struct drm_file *file_priv,
 	config = pslice->config;
 
 	args->handle = 0;
-	if (mutex_lock_interruptible(&dev->struct_mutex))
-		return -EBUSY;
 
 	cma_obj = kzalloc(sizeof(*cma_obj), GFP_KERNEL);
 	if (!cma_obj) {
@@ -159,7 +157,6 @@ static int hantro_gem_dumb_create_internal(struct drm_file *file_priv,
 	cma_obj->handle = args->handle;
 
 out:
-	mutex_unlock(&dev->struct_mutex);
 	return ret;
 }
 
@@ -204,11 +201,8 @@ static int hantro_destroy_dumb(struct drm_device *dev, void *data,
 	struct drm_gem_object *obj;
 	struct drm_gem_hantro_object *cma_obj;
 
-	if (mutex_lock_interruptible(&dev->struct_mutex))
-		return -EBUSY;
 	obj = hantro_gem_object_lookup(dev, file_priv, args->handle);
 	if (!obj) {
-		mutex_unlock(&dev->struct_mutex);
 		return -EINVAL;
 	}
 	hantro_unref_drmobj(obj);
@@ -216,7 +210,6 @@ static int hantro_destroy_dumb(struct drm_device *dev, void *data,
 	cma_obj = to_drm_gem_hantro_obj(obj);
 
 	drm_gem_handle_delete(file_priv, args->handle);
-	mutex_unlock(&dev->struct_mutex);
 	return 0;
 }
 
@@ -370,15 +363,15 @@ int hantro_gem_prime_mmap(struct drm_gem_object *obj,
 		return ret;
 	lg_vm_flags_set(vma, vma->vm_flags & ~VM_PFNMAP);
 	vma->vm_pgoff = 0;
-	if (mutex_lock_interruptible(&hantro_dev.drm_dev->struct_mutex))
+	if (mutex_lock_interruptible(&hantro_dev.struct_mutex))
 		return -EBUSY;
 	if (dma_mmap_coherent(obj->dev->dev, vma, cma_obj->vaddr,
 			      cma_obj->paddr, vma->vm_end - vma->vm_start)) {
 		drm_gem_vm_close(vma);
-		mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+		mutex_unlock(&hantro_dev.struct_mutex);
 		return -EAGAIN;
 	}
-	mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+	mutex_unlock(&hantro_dev.struct_mutex);
 	vma->vm_private_data = cma_obj;
 	return ret;
 }
@@ -1002,7 +995,7 @@ static int hantro_getmagic(struct drm_device *dev, void *data,
 	struct drm_auth *auth = data;
 	int ret = 0;
 
-	mutex_lock(&dev->struct_mutex);
+	mutex_lock(&dev->master_mutex);
 	if (!file_priv->magic) {
 		ret = idr_alloc(&file_priv->master->magic_map, file_priv, 1, 0,
 				GFP_KERNEL);
@@ -1011,7 +1004,7 @@ static int hantro_getmagic(struct drm_device *dev, void *data,
 	}
 	auth->magic = file_priv->magic;
 	DBG("kmagic %d\n", auth->magic);
-	mutex_unlock(&dev->struct_mutex);
+	mutex_unlock(&dev->master_mutex);
 
 	return ret < 0 ? ret : 0;
 }
@@ -1022,14 +1015,14 @@ static int hantro_authmagic(struct drm_device *dev, void *data,
 	struct drm_auth *auth = data;
 	struct drm_file *file;
 
-	mutex_lock(&dev->struct_mutex);
+	mutex_lock(&dev->master_mutex);
 	file = idr_find(&file_priv->master->magic_map, auth->magic);
 	DBG("get kmagic %d\n", auth->magic);
 	if (file) {
 		file->authenticated = 1;
 		idr_replace(&file_priv->master->magic_map, NULL, auth->magic);
 	}
-	mutex_unlock(&dev->struct_mutex);
+	mutex_unlock(&dev->master_mutex);
 
 	return file ? 0 : -EINVAL;
 }
@@ -1498,7 +1491,7 @@ static int hantro_mmap(struct file *filp, struct vm_area_struct *vma)
 	hantro_mmaplog("%s :%lx", __func__, vma->vm_pgoff);
 	if (vma->vm_pgoff < VSI_MMAP_ADDRES_CEIL_MMAP)
 		return hantro_map_internal_address(filp, vma);
-	if (mutex_lock_interruptible(&hantro_dev.drm_dev->struct_mutex))
+	if (mutex_lock_interruptible(&hantro_dev.struct_mutex))
 		return -EBUSY;
 	
 	vma->vm_pgoff -= VSI_MMAP_ADDRES_CEIL_MMAP;
@@ -1516,20 +1509,20 @@ static int hantro_mmap(struct file *filp, struct vm_area_struct *vma)
 	drm_vma_offset_unlock_lookup(hantro_dev.drm_dev->vma_offset_manager);
 
 	if (!obj) {
-		mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+		mutex_unlock(&hantro_dev.struct_mutex);
 		return -EINVAL;
 	}
 	hantro_unref_drmobj(obj);
 	cma_obj = to_drm_gem_hantro_obj(obj);
 
 	if (page_num > cma_obj->num_pages) {
-		mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+		mutex_unlock(&hantro_dev.struct_mutex);
 		return -EINVAL;
 	}
 	if (!(cma_obj->flag & HANTRO_GEM_FLAG_IMPORT)) {
 		pslice = getslicenode(cma_obj->sliceidx);
 		if (!pslice) {
-			mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+			mutex_unlock(&hantro_dev.struct_mutex);
 			return -EINVAL;
 		}
 		dev = pslice->dev;
@@ -1538,14 +1531,14 @@ static int hantro_mmap(struct file *filp, struct vm_area_struct *vma)
 	}
 	if ((cma_obj->flag & HANTRO_GEM_FLAG_IMPORT) == 0) {
 		if (cma_obj->vaddr == 0) {
-			mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+			mutex_unlock(&hantro_dev.struct_mutex);
 			return -EINVAL;
 		}
 		ret = hantro_drm_gem_mmap_obj(
 			obj, drm_vma_node_size(node) << PAGE_SHIFT, vma);
 
 		if (ret) {
-			mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+			mutex_unlock(&hantro_dev.struct_mutex);
 			return ret;
 		}
 	} else {
@@ -1580,7 +1573,7 @@ static int hantro_mmap(struct file *filp, struct vm_area_struct *vma)
 					unref_page(pages);
 					address += PAGE_SIZE;
 				}
-				mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+				mutex_unlock(&hantro_dev.struct_mutex);
 				return -ENOMEM;
 			}
 			ref_page(pages);
@@ -1592,7 +1585,7 @@ static int hantro_mmap(struct file *filp, struct vm_area_struct *vma)
 		vma->vm_pgoff = 0;
 		if (dma_mmap_coherent(dev, vma, cma_obj->vaddr, cma_obj->paddr,
 				      page_num << PAGE_SHIFT)) {
-			mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+			mutex_unlock(&hantro_dev.struct_mutex);
 			return -EAGAIN;
 		}
 #else
@@ -1602,7 +1595,7 @@ static int hantro_mmap(struct file *filp, struct vm_area_struct *vma)
 #endif
 	}
 	vma->vm_private_data = cma_obj;
-	mutex_unlock(&hantro_dev.drm_dev->struct_mutex);
+	mutex_unlock(&hantro_dev.struct_mutex);
 	return ret;
 }
 
diff --git a/include/hantro_priv.h b/include/hantro_priv.h
index be69edb..dcb0b41 100644
--- a/include/hantro_priv.h
+++ b/include/hantro_priv.h
@@ -101,6 +101,7 @@ struct hantro_device_handle {
 #ifdef PCIE_EN
 	void *dev;
 #endif
+	struct mutex struct_mutex; /* protect drm_device */
 };
 
 struct hantro_mem_handle {
-- 
2.54.0

