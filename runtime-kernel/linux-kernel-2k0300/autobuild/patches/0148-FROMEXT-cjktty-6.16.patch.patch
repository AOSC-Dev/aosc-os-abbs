 		if (con_should_update(vc))
-			con_putc(vc, old, oldy, oldx);
+			con_putc(vc, (old_utf << 16) | old, oldy, oldx);
 		notify_update(vc);
 	}
 
@@ -764,13 +777,15 @@ void complement_pos(struct vc_data *vc, int offset)
