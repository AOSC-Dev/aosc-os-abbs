From 8855b12759355cb574bf3d5bd5d368e4e625dbf1 Mon Sep 17 00:00:00 2001
From: Ilikara <3435193369@qq.com>
Date: Mon, 16 Nov 2026 20:13:35 +0800
Subject: [PATCH 457/457] AOSCOS: adjust mdio reg to make ly1211a work

Signed-off-by: Ilikara <3435193369@qq.com>
---
 arch/loongarch/boot/dts/ls2k300_99pi.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/loongarch/boot/dts/ls2k300_99pi.dtsi b/arch/loongarch/boot/dts/ls2k300_99pi.dtsi
index a7a6309ad49b..f0ef5d6c900d 100644
--- a/arch/loongarch/boot/dts/ls2k300_99pi.dtsi
+++ b/arch/loongarch/boot/dts/ls2k300_99pi.dtsi
@@ -111,15 +111,15 @@ dc_out_rgb0: endpoint {
 
 &gmac0 {
 	status = "okay";
-	phy-handle = <&yt8511h0>;
+	phy-handle = <&eth_phy0>;
 	mdio {
 		compatible = "snps,dwmac-mdio";
 		#address-cells = <1>;
 		#size-cells = <0>;
 
-		yt8511h0: ethernet-phy@0 {
+		eth_phy0: ethernet-phy@1 {
 			compatible = "ethernet-phy-ieee802.3-c22";
-			reg = <0>;
+			reg = <1>;
 			motorcomm,led0_cfg = <0x40>; //千兆常亮
 			motorcomm,led1_cfg = <0x30>; //百兆 十兆常亮
 			motorcomm,led2_cfg = <0x2600>; //有数据时闪烁
-- 
2.56.0

