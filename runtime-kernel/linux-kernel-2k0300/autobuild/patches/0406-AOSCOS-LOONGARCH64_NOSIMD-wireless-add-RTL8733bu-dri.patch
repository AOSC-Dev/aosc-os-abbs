+	return true;
+#endif
+#if ((DM_ODM_SUPPORT_TYPE & ODM_AP) || (DM_ODM_SUPPORT_TYPE == ODM_CE))
+	return _phy_query_rf_path_switch_8733b(dm);
+#else
+	return _phy_query_rf_path_switch_8733b(adapter);
+#endif
