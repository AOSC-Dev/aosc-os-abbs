+void
+cfg_mac_clk_87xx(struct halmac_adapter *adapter)
+{
+	u8 value8;
+	struct halmac_api *api = (struct halmac_api *)adapter->halmac_api;
+
+	//jerry_zhou
+	/*
+	value32 = HALMAC_REG_R32(REG_SPS_LDO_VOLT_CTRL1) & ~(BIT(20) | BIT(21));
+	value32 |= (MAC_CLK_HW_DEF_80M << BIT_SHIFT_MAC_CLK_SEL);
+	HALMAC_REG_W32(REG_SPS_LDO_VOLT_CTRL1, value32);
+	*/
+
+	//mac clk 20M
+	value8 = HALMAC_REG_R8(REG_SPS_LDO_VOLT_CTRL1+2);
+	value8 = value8 &0xCF;
+	value8 = value8 | 0x10;//bit4=1
+	HALMAC_REG_W8(REG_SPS_LDO_VOLT_CTRL1+2, value8);
+
+	//sec clk 160M
+	value8 = HALMAC_REG_R8(REG_EXT_SYS_CLK_CTRL);
+	value8=value8 &0xF3;
+	HALMAC_REG_W8(REG_EXT_SYS_CLK_CTRL, value8);
+
+	HALMAC_REG_W8(REG_USTIME_TSF, MAC_CLK_SPEED);
+	HALMAC_REG_W8(REG_USTIME_EDCA, MAC_CLK_SPEED);
+}
