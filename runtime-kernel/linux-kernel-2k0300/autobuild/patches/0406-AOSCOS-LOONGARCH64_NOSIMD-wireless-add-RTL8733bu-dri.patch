+static void hw_var_set_bcn_func(PADAPTER adapter, u8 enable)
+{
+	u8 val8 = 0;
+
+	if (enable) {
+		/* enable TX BCN report
+		 *  Reg REG_FWHW_TXQ_CTRL_8733B[2] = 1
+		 *  Reg REG_BCN_CTRL_8733B[3][5] = 1
+		 */
+		val8 = rtw_read8(adapter, REG_FWHW_TXQ_CTRL_8733B);
+		val8 |= BIT_EN_BCN_TRXRPT_8733B;
+		rtw_write8(adapter, REG_FWHW_TXQ_CTRL_8733B, val8);
+
+		
+		switch (adapter->hw_port) {
+		case HW_PORT0:
+			val8 =  BIT_EN_BCN_FUNCTION_8733B | BIT_P0_EN_TXBCN_RPT_8733B;
+			hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), BIT_P0_EN_RXBCN_RPT_8733B);
+			break;
+#ifdef CONFIG_CONCURRENT_MODE
+		case HW_PORT1:
+			val8 =  BIT_CLI0_EN_BCN_FUNCTION_8733B;
+			hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), BIT_CLI0_EN_RXBCN_RPT_8733B);
+			break;
+		case HW_PORT2:
+			val8 =  BIT_CLI1_EN_BCN_FUNCTION_8733B;
+			hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), BIT_CLI1_EN_RXBCN_RPT_8733B);
+			break;
+		case HW_PORT3:
+			val8 =  BIT_CLI2_EN_BCN_FUNCTION_8733B;
+			hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), BIT_CLI2_EN_RXBCN_RPT_8733B);
+			break;
+		case HW_PORT4:
+			val8 =  BIT_CLI3_EN_BCN_FUNCTION_8733B;
+			hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), BIT_CLI3_EN_RXBCN_RPT_8733B);
+			break;
+#endif /* CONFIG_CONCURRENT_MODE */
+		default:
+			RTW_ERR(FUNC_ADPT_FMT" Unknow hw port(%d) \n", FUNC_ADPT_ARG(adapter), adapter->hw_port);
+			rtw_warn_on(1);
+			break;
+
+		}
+		hw_bcn_ctrl_add(adapter, get_hw_port(adapter), val8);
+	} else {
+
+		switch (adapter->hw_port) {
+		case HW_PORT0:
+			val8 =  BIT_EN_BCN_FUNCTION_8733B | BIT_P0_EN_TXBCN_RPT_8733B;
+#ifdef CONFIG_BT_COEXIST
+			/* Always enable port0 beacon function for PSTDMA */
+			if (GET_HAL_DATA(adapter)->EEPROMBluetoothCoexist)
+				val8 = BIT_P0_EN_TXBCN_RPT_8733B;
+#endif /* CONFIG_BT_COEXIST */
+			break;
+#ifdef CONFIG_CONCURRENT_MODE
+		case HW_PORT1:
+			val8 =  BIT_CLI0_EN_BCN_FUNCTION_8733B;
+			break;
+		case HW_PORT2:
+			val8 =  BIT_CLI1_EN_BCN_FUNCTION_8733B;
+			break;
+		case HW_PORT3:
+			val8 =  BIT_CLI2_EN_BCN_FUNCTION_8733B;
+			break;
+		case HW_PORT4:
+			val8 =  BIT_CLI3_EN_BCN_FUNCTION_8733B;
+			break;
+#endif /* CONFIG_CONCURRENT_MODE */
+		default:
+			RTW_ERR(FUNC_ADPT_FMT" Unknow hw port(%d) \n", FUNC_ADPT_ARG(adapter), adapter->hw_port);
+			rtw_warn_on(1);
+			break;
+		}
+
+		hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), val8);
+	}
+}
