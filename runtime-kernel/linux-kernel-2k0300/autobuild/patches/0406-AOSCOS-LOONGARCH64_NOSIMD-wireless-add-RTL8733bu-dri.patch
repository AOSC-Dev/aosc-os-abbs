+static void hw_var_set_sec_dk_cfg(PADAPTER adapter, u8 enable)
+{
+	struct security_priv *sec = &adapter->securitypriv;
+	u8 reg_scr = rtw_read8(adapter, REG_SECCFG_8733B);
+
+	if (enable) {
+		/* Enable default key related setting */
+		reg_scr |= BIT_TXBCUSEDK_8733B;
+		if (sec->dot11AuthAlgrthm != dot11AuthAlgrthm_8021X)
+			reg_scr |= BIT_RXUHUSEDK_8733B | BIT_TXUHUSEDK_8733B;
+	} else {
+		/* Disable default key related setting */
+		reg_scr &= ~(BIT_RXBCUSEDK_8733B | BIT_TXBCUSEDK_8733B | BIT_RXUHUSEDK_8733B | BIT_TXUHUSEDK_8733B);
+	}
+
+	rtw_write8(adapter, REG_SECCFG_8733B, reg_scr);
+
+	RTW_INFO("%s: [HW_VAR_SEC_DK_CFG] 0x%x=0x%08x\n", __FUNCTION__,
+		 REG_SECCFG_8733B, rtw_read32(adapter, REG_SECCFG_8733B));
+}
