+BOOLEAN rtw_file_efuse_IsMasked(PADAPTER pAdapter, u16 Offset, u8 *maskbuf)
+{
+	int r = Offset / 16;
+	int c = (Offset % 16) / 2;
+	int result = 0;
+
+	if (pAdapter->registrypriv.boffefusemask)
+		return FALSE;
+
+	if (c < 4) /* Upper double word */
+		result = (maskbuf[r] & (0x10 << c));
+	else
+		result = (maskbuf[r] & (0x01 << (c - 4)));
+
+	return (result > 0) ? 0 : 1;
+}
