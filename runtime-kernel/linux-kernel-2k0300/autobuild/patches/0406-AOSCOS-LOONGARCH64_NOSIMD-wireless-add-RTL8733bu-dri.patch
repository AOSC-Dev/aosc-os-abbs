+{
+	struct dm_struct *dm = (struct dm_struct *)dm_void;
+	struct dm_dpk_info *dpk_info = &dm->dpk_info;
+
+	u32	i = 0;
+	u32	array_len = sizeof(array_mp_8733b_cal_init) / sizeof(u32);
