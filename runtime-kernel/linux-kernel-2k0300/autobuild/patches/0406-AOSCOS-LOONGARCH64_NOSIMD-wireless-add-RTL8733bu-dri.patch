+__inline static u32 bitshift(u32 bitmask)
+{
+	u32 i;
+
+	for (i = 0; i <= 31; i++)
+		if (((bitmask >> i) &  0x1) == 1)
+			break;
+
+	return i;
+}
+
+static inline int largest_bit(u32 bitmask)
+{
+	int i;
+
+	for (i = 31; i >= 0; i--)
+		if (bitmask & BIT(i))
+			break;
+
+	return i;
+}
+
+static inline int largest_bit_64(u64 bitmask)
+{
+	int i;
+
+	for (i = 63; i >= 0; i--)
+		if (bitmask & BIT_ULL(i))
+			break;
+
+	return i;
+}
