+		phy_dpk_track_8721d(dm);
+		break;
+#endif
+
+#if (RTL8733B_SUPPORT == 1)
+	case ODM_RTL8733B:
+		dpk_track_8733b(dm);
+		break;
+#endif
+
+#if (DM_ODM_SUPPORT_TYPE & (ODM_AP))
+
+#if (RTL8197F_SUPPORT == 1)
+	case ODM_RTL8197F:
+		phy_dpk_track_8197f(dm);
