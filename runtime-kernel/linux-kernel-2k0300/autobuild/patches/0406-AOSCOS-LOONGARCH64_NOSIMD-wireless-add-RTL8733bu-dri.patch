+void config_halrf_path_adda_setting_trigger(void *dm_void)
+{
+	struct dm_struct *dm = (struct dm_struct *)dm_void;
+	
+#if (RTL8814B_SUPPORT == 1)
+	if (dm->support_ic_type & ODM_RTL8814B)
+		config_phydm_path_adda_setting_8814b(dm);
+#endif
+	
+}
