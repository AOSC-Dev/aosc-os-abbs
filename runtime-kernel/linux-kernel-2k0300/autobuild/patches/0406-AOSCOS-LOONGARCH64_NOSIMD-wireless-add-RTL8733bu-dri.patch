+
+		/*===[CCK]===*/
+		switch (dm->num_rf_path) {
+#ifdef PHYSTS_3RD_TYPE_SUPPORT
+	#if (defined(PHYDM_COMPILE_ABOVE_4SS))
+		case 4:
+			RT_SPRINTF(buf, DBGM_CLI_BUF_SIZE,
+				   "* %-8s Cnt=((%.3d)) RSSI:{%.2d, %.2d, %.2d, %.2d}\n",
