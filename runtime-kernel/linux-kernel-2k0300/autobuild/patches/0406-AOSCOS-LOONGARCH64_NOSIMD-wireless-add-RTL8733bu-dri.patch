+	for (i = 0; i < reg_num; i++) {
+		odm_set_bb_reg(dm, reg[i], MASKDWORD, reg_backup[i]);
+		/*RF_DBG(dm, DBG_RF_TX_PWR_TRACK, "[RF][TSSI] Reload BB 0x%x = 0x%x\n",
+			reg[i], reg_backup[i]);*/
