+			utility_on = (ht_ok_max_on << 7) / ht_fail_max_on;
+			utility_off = (ht_ok_max_off << 7) / ht_fail_max_off;
+			crc_taget = (utility_on == utility_off) ?
+				    (soml_tab->soml_last_state) :
+				    ((utility_on > utility_off) ? SOML_ON :
+				    SOML_OFF);
+
+		} else if (!on_above && !off_above) {
+			if (ht_ok_max_on == 0)
+				ht_ok_max_on = 1;
+			if (ht_ok_max_off == 0)
+				ht_ok_max_off = 1;
