+			tdma_case = 14;
+		else
+			tdma_case = 13;
+	} else { /* Non-Shared-Ant */
+		table_case = 121;
+		tdma_case = 113;
+	}
+
+	rtw_btc_table(btc, NM_EXCU, table_case);
+	rtw_btc_tdma(btc, NM_EXCU, tdma_case | slot_type);
+}
