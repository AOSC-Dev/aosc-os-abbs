+		}
+		for (i = 0; i < rate_num; i++) {
+			ss_shift = 10 * i;
+			PHYDM_DBG(dm, DBG_ADPTV_SOML,
+				  "*vht_crc_fail_cnt_off  VHT-%d ss MCS[0:9] = {%d, %d, %d, %d, %d, %d, %d, %d, %d, %d}\n",
+				  (i + 1),
+				  soml_tab->vht_crc_fail_cnt_off[ss_shift + 0],
+				  soml_tab->vht_crc_fail_cnt_off[ss_shift + 1],
