+static u8 hw_var_get_bcn_valid(PADAPTER adapter)
+{
+	u8 val8 = 0;
+	u8 ret = _FALSE;
+
+	val8 = rtw_read8(adapter, REG_DWBCN0_CTRL_8733B + 2);
+	ret = (BIT(0) & val8) ? _TRUE : _FALSE;
+
+	return ret;
+}
