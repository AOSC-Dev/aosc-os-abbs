+static void hw_var_hw_port_cfg(_adapter *adapter, u8 enable)
+{
+	if (enable)
+		hw_bcn_ctrl_add(adapter, get_hw_port(adapter),
+				(BIT_P0_EN_RXBCN_RPT_8733B
+				 | BIT_DIS_TSF_UDT_8733B
+				 | BIT_EN_BCN_FUNCTION_8733B));
+	else
+		hw_bcn_ctrl_clr(adapter, get_hw_port(adapter), BIT_EN_BCN_FUNCTION);
+}
