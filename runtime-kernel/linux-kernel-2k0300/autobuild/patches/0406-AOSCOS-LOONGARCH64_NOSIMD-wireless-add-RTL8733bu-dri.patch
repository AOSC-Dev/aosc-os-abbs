+	phydm_keep_rx_ack_ant_by_tx_ant_time(dm, 0);
+	/* Timming issue: keep Rx ant after tx for ACK(5 x 3.2 mu = 16mu sec)*/
+
+	/* @2 [---Set TX Antenna---] */
