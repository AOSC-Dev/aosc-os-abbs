+
+
+	if (*dm->mp_mode == 1) { //mp mode define
+		if (cali_info->txpowertrack_control >= 3) //tssi on/cal
+			return;
+	} else {
+		if (rf->power_track_type >= 4 && rf->power_track_type <= 7)
