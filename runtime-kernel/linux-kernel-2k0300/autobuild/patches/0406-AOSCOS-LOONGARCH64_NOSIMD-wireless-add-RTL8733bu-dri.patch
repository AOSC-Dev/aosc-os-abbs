+				  soml_tab->vht_cnt_on[ss_shift + 5],
+				  soml_tab->vht_cnt_on[ss_shift + 6],
+				  soml_tab->vht_cnt_on[ss_shift + 7],
+				  soml_tab->vht_cnt_on[ss_shift + 8],
