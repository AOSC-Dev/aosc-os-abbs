+	hdr_info.sub_cmd_id = SUB_CMD_ID_SEND_SCAN_PKT;
+	hdr_info.content_size = 8;
+	hdr_info.ack = 1;
+	set_h2c_pkt_hdr_87xx(adapter, h2c_buf, &hdr_info, &seq_num);
+	adapter->halmac_state.scan_pkt_state.seq_num = seq_num;
