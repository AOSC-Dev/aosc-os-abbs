+void rx_query_moinfo(struct rx_pkt_attrib *a, u8 *desc)
+{
+	switch (a->drvinfo_sz) {
+	case 40:
+		_rtw_memcpy(a->moif, &desc[32], 8);
+		break;
+	case 48:
+		_rtw_memcpy(a->moif, &desc[32], 12);
+		break;
+	case 32:
+		/* passthrough */
+	default:
+		break;
+	}
+}
