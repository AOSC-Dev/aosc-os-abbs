+	func_lck phy_lc_calibrate;
+	func_tssi_dck do_tssi_dck;
+	func_swing get_delta_swing_table;
+	func_swing8814only get_delta_swing_table8814only;
+	func_swing_xtal get_delta_swing_xtal_table;
