+u8 hw_rate_to_m_rate(u8 hw_rate)
+{
+	u8 rate = MGN_1M; /* default value */
+
+	if (hw_rate < DESC_RATE_NUM)
+		rate = _hw_rate_to_m_rate[hw_rate];
+	else
+		RTW_WARN("Invalid hw_rate 0x%x in %s\n", hw_rate, __FUNCTION__);
+
+	return rate;
+}
