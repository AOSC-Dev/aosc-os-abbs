+#ifdef CONFIG_RTL8814A
+void mpt_ToggleIG_8814A(PADAPTER	pAdapter)
+{
+	u8 Path;
+	u32 IGReg = rA_IGI_Jaguar, IGvalue = 0;
+
+	for (Path = 0; Path <= RF_PATH_D; Path++) {
+		switch (Path) {
+		case RF_PATH_B:
