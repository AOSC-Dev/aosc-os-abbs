+#elif (RTL8192F_SUPPORT == 1 || RTL8197F_SUPPORT == 1 ||RTL8197G_SUPPORT == 1 ||\
+	RTL8822C_SUPPORT == 1 || RTL8812F_SUPPORT == 1 || RTL8733B_SUPPORT == 1)
