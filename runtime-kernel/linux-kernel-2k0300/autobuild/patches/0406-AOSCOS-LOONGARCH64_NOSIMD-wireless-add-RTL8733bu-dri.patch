+static void
+rtw_btc_set_wl_pri_mask(struct btc_coexist *btc, u8 bitmap, u8 data)
+{
+	u32 addr;
+
+	addr = REG_BT_COEX_TABLE_H + (bitmap / 8);
+	bitmap = bitmap % 8;
+
+	btc->btc_write_1byte_bitmask(btc, addr, BIT(bitmap), data);
