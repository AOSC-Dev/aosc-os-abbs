+	u32	lut_5g[KPATH][GROUP_5G][64];			/*path/group/LUT data*/
+	u32	lut_2g[KPATH][3][64];			/*path/group/LUT data*/
+	u8	rxbb[4];			/*path/group*/
+	u8	txbb[4];			/*path/group*/
