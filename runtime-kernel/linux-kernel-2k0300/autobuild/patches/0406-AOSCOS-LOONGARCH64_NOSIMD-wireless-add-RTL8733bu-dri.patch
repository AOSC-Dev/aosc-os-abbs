+#endif
+
+#if (RTL8195B_SUPPORT == 1 || RTL8721D_SUPPORT == 1)
+		u8	dpk_txagc;
+		/*2G DPK data*/
+	u8	dpk_2g_result[KPATH][3];			/*path/group*/
+	u8	pwsf_2g[KPATH][3];			/*path/group*/
+	u32	lut_2g_even[KPATH][3][16];		/*path/group/LUT data*/
+	u32	lut_2g_odd[KPATH][3][16];		/*path/group/LUT data*/
