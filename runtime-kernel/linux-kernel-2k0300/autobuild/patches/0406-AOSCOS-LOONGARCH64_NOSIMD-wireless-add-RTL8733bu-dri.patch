+		if (power_trim_info->flag & KFREE_FLAG_ON_2G) {
+			odm_set_rf_reg(dm, RF_PATH_A, RF_0x33, RFREGOFFSETMASK, 0x0);
+			odm_set_rf_reg(dm, RF_PATH_A, RF_0x3f, 0x0000003f,
