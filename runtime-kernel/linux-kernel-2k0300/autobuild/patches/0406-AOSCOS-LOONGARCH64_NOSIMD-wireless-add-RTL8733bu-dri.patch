+			rf->rf_shift_band = HAL_RF_2P5;
+			halrf_lck_trigger(dm);
+			PDM_SNPF(out_len, used, output + used, out_len - used,
+				 "\n[rf_shift_band] = %d\nRF Band Shift to 2.5G!\n",
