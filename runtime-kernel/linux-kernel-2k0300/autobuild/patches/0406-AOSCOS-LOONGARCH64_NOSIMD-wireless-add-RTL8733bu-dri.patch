+ * more details.
+ *
+ *****************************************************************************/
+#define _RTL8733BU_XMIT_C_
+
+#include <drv_types.h>			/* PADAPTER, rtw_xmit.h and etc. */
+#include <hal_data.h>			/* HAL_DATA_TYPE */
+#include "../../hal_halmac.h"		/* halmac api */
+#include "../rtl8733b.h"		/* rtl8733b_update_txdesc() */
+#include "rtl8733bu.h"			/* OFFSET_SZ MAX_TX_AGG_PACKET_NUMBER_8733B */
+
+static void update_txdesc_h2c_pkt(struct xmit_frame *pxmitframe, u8 *pmem, s32 sz)
+{
+	u8 *ptxdesc =  pmem;
+	_adapter *padapter = pxmitframe->padapter;
+
+	_rtw_memset(ptxdesc, 0, TXDESC_SIZE);
+	SET_TX_DESC_TXPKTSIZE_8733B(ptxdesc, sz);
+	SET_TX_DESC_QSEL_8733B(ptxdesc, HALMAC_TXDESC_QSEL_H2C_CMD);
+	rtl8733b_cal_txdesc_chksum(padapter, ptxdesc);
+	rtl8733b_dbg_dump_tx_desc(padapter, pxmitframe->frame_tag, ptxdesc);
+}
+
+static s32 update_txdesc(struct xmit_frame *pxmitframe, u8 *pmem, s32 sz, u8 bagg_pkt)
+{
+	int pull = 0;
+	uint qsel;
+	u8 data_rate, pwr_status, offset;
+	_adapter *padapter = pxmitframe->padapter;
+	struct mlme_priv *pmlmepriv = &padapter->mlmepriv;
+	struct pkt_attrib *pattrib = &pxmitframe->attrib;
+	HAL_DATA_TYPE *pHalData = GET_HAL_DATA(padapter);
+	u8 *ptxdesc =  pmem;
+	struct mlme_ext_priv *pmlmeext = &padapter->mlmeextpriv;
+	struct mlme_ext_info *pmlmeinfo = &(pmlmeext->mlmext_info);
+	sint bmcst = IS_MCAST(pattrib->ra);
+	u16 SWDefineContent = 0x0;
+	u8 DriverFixedRate = 0x0;
+	u8 hw_port = rtw_hal_get_port(padapter);
+
+#ifndef CONFIG_USE_USB_BUFFER_ALLOC_TX
+	if (padapter->registrypriv.mp_mode == 0) {
+		if ((PACKET_OFFSET_SZ != 0) && (!bagg_pkt)
+		    && (rtw_usb_bulk_size_boundary(padapter, (TXDESC_SIZE + sz)) == _FALSE)) {
+			ptxdesc = (pmem + PACKET_OFFSET_SZ);
+			/* RTW_INFO("==> non-agg-pkt,shift pointer...\n"); */
+			pull = 1;
+		}
+	}
+#endif	/* !CONFIG_USE_USB_BUFFER_ALLOC_TX */
+
+	_rtw_memset(ptxdesc, 0, TXDESC_SIZE);
+
+	/* offset 0 */
+	/* RTW_INFO("%s==> pkt_len=%d,bagg_pkt=%02x\n",__FUNCTION__,sz,bagg_pkt); */
+	SET_TX_DESC_TXPKTSIZE_8733B(ptxdesc, sz);
+
+	offset = TXDESC_SIZE + OFFSET_SZ;
+
+#ifdef CONFIG_TX_EARLY_MODE
+	if (bagg_pkt)
+		offset += EARLY_MODE_INFO_SIZE;
+#endif
+	/* RTW_INFO("%s==>offset(0x%02x)\n",__FUNCTION__,offset); */
+	SET_TX_DESC_OFFSET_8733B(ptxdesc, offset);
+
+	if (bmcst)
+		SET_TX_DESC_BMC_8733B(ptxdesc, 1);
+
+#ifndef CONFIG_USE_USB_BUFFER_ALLOC_TX
+	if (padapter->registrypriv.mp_mode == 0) {
+		if ((PACKET_OFFSET_SZ != 0) && (!bagg_pkt)) {
+			if ((pull) && (pxmitframe->pkt_offset > 0))
+				pxmitframe->pkt_offset = pxmitframe->pkt_offset - 1;
+		}
+	}
+#endif /* !CONFIG_USE_USB_BUFFER_ALLOC_TX */
+
+	/* offset 4 */
+	/* RTW_INFO("%s, pkt_offset=0x%02x\n",__FUNCTION__,pxmitframe->pkt_offset); */
+	/* pkt_offset, unit:8 bytes padding */
+	if (pxmitframe->pkt_offset > 0)
+		SET_TX_DESC_PKT_OFFSET_8733B(ptxdesc, pxmitframe->pkt_offset);
+
+	SET_TX_DESC_MACID_8733B(ptxdesc, pattrib->mac_id);
+	SET_TX_DESC_RATE_ID_8733B(ptxdesc, pattrib->raid);
+
+	SET_TX_DESC_QSEL_8733B(ptxdesc,  pattrib->qsel);
+
+	/* offset 12 */
+	if (!pattrib->qos_en) {
+		/* HW sequence, to fix to use 0 queue. todo: 4AC packets to use auto queue select */
+		SET_TX_DESC_EN_HWSEQ_8733B(ptxdesc, 1);/* Hw set sequence number */
+		SET_TX_DESC_HW_SSN_SEL_8733B(ptxdesc, pattrib->hw_ssn_sel);
+	} else
+		SET_TX_DESC_SW_SEQ_8733B(ptxdesc, pattrib->seqnum);
+
+	if ((pxmitframe->frame_tag & 0x0f) == DATA_FRAMETAG) {
+		/* RTW_INFO("pxmitframe->frame_tag == DATA_FRAMETAG\n");	*/
+		rtl8733b_fill_txdesc_sectype(pattrib, ptxdesc);
+#ifdef CONFIG_TCP_CSUM_OFFLOAD_TX
+	if (pattrib->hw_csum == 1) {
+		int offset = 48 + pxmitframe->pkt_offset*8 + 24;
+
+		SET_TX_DESC_OFFSET_8733B(ptxdesc, offset);
+		SET_TX_DESC_CHK_EN_8733B(ptxdesc, 1);
+		SET_TX_DESC_WHEADER_LEN_8733B(ptxdesc, (pattrib->hdrlen + pattrib->iv_len + XATTRIB_GET_MCTRL_LEN(pattrib))>>1);
+	}
+#endif
+
+		/* offset 20 */
+#ifdef CONFIG_USB_TX_AGGREGATION
+		if (pxmitframe->agg_num > 1) {
+			/* RTW_INFO("%s agg_num:%d\n",__FUNCTION__,pxmitframe->agg_num); */
+			SET_TX_DESC_DMA_TXAGG_NUM_8733B(ptxdesc, pxmitframe->agg_num);
+		}
+#endif /* CONFIG_USB_TX_AGGREGATION */
+
+		rtl8733b_fill_txdesc_vcs(padapter, pattrib, ptxdesc);
+
+		if (bmcst)
+			rtl8733b_fill_txdesc_force_bmc_camid(pattrib, ptxdesc);
+
+		if ((pattrib->ether_type != 0x888e) &&
+		    (pattrib->ether_type != 0x0806) &&
+		    (pattrib->ether_type != 0x88b4) &&
+		    (pattrib->dhcp_pkt != 1)
+#ifdef CONFIG_AUTO_AP_MODE
+		    && (pattrib->pctrl != _TRUE)
+#endif
+		   ) {
+			/* Non EAP & ARP & DHCP type data packet */
+			if (pattrib->ampdu_en == _TRUE) {
+				SET_TX_DESC_AGG_EN_8733B(ptxdesc, 1);
+				SET_TX_DESC_MAX_AGG_NUM_8733B(ptxdesc, 0x1f);
+				/* Set A-MPDU aggregation */
+				SET_TX_DESC_AMPDU_DENSITY_8733B(ptxdesc, pattrib->ampdu_spacing);
+			} else
+				SET_TX_DESC_BK_8733B(ptxdesc, 1);
+
+			rtl8733b_fill_txdesc_phy(padapter, pattrib, ptxdesc);
+
+			/* compatibility for MCC consideration, use pmlmeext->cur_channel */
+			if (!bmcst) {
+				if (pmlmeext->cur_channel > 14)
+					/* for 5G. OFDM 6M */
+					SET_TX_DESC_DATA_RTY_LOWEST_RATE_8733B(ptxdesc, 4);
+				else
+					/* for 2.4G. CCK 1M */
+					SET_TX_DESC_DATA_RTY_LOWEST_RATE_8733B(ptxdesc, 0);
+			}
+
+			if (pHalData->fw_ractrl == _FALSE) {
+				SET_TX_DESC_USE_RATE_8733B(ptxdesc, 1);
+				DriverFixedRate = 0x01;
+
+				if (pHalData->INIDATA_RATE[pattrib->mac_id] & BIT(7))
+					SET_TX_DESC_DATA_SHORT_8733B(ptxdesc, 1);
+
+				SET_TX_DESC_DATARATE_8733B(ptxdesc, (pHalData->INIDATA_RATE[pattrib->mac_id] & 0x7F));
+			}
+			if (bmcst) {
+				DriverFixedRate = 0x01;
+				rtl8733b_fill_txdesc_bmc_tx_rate(pattrib, ptxdesc);
+			}
+
+			/* modify data rate by iwpriv or proc */
+			if (padapter->fix_rate != 0xFF) {
+				SET_TX_DESC_USE_RATE_8733B(ptxdesc, 1);
+
+				DriverFixedRate = 0x01;
+				if (padapter->fix_rate & BIT(7))
+					SET_TX_DESC_DATA_SHORT_8733B(ptxdesc, 1);
+
+				SET_TX_DESC_DATARATE_8733B(ptxdesc, (padapter->fix_rate & 0x7F));
+
+				if (!padapter->data_fb)
+					SET_TX_DESC_DISDATAFB_8733B(ptxdesc, 1);
+			}
+
+			if (pattrib->ldpc)
+				SET_TX_DESC_DATA_LDPC_8733B(ptxdesc, 1);
+
+			if (pattrib->stbc)
+				SET_TX_DESC_DATA_STBC_8733B(ptxdesc, 1);
+
+#ifdef CONFIG_WMMPS_STA
+			if (pattrib->trigger_frame)
+				SET_TX_DESC_TRI_FRAME_8733B (ptxdesc, 1);
+#endif /* CONFIG_WMMPS_STA */			
+
+		} else {
+			/*
+				EAP data packet and ARP packet and DHCP.
+				Use the 1M data rate to send the EAP/ARP packet.
+				This will maybe make the handshake smooth.
+			*/
+
+			SET_TX_DESC_USE_RATE_8733B(ptxdesc, 1);
+			DriverFixedRate = 0x01;
+			SET_TX_DESC_BK_8733B(ptxdesc, 1);
+
+			/* HW will ignore this setting if the transmission rate is legacy OFDM */
+			if (pmlmeinfo->preamble_mode == PREAMBLE_SHORT)
+				SET_TX_DESC_DATA_SHORT_8733B(ptxdesc, 1);
+#ifdef CONFIG_IP_R_MONITOR
+			if((pattrib->ether_type == ETH_P_ARP) &&
+				(IsSupportedTxOFDM(padapter->registrypriv.wireless_mode))) {
+				SET_TX_DESC_DATARATE_8733B(ptxdesc, MRateToHwRate(IEEE80211_OFDM_RATE_6MB));
+				#ifdef DBG_IP_R_MONITOR
+				RTW_INFO(FUNC_ADPT_FMT ": SP Packet(0x%04X) rate=0x%x SeqNum = %d\n",
+					FUNC_ADPT_ARG(padapter), pattrib->ether_type, MRateToHwRate(pmlmeext->tx_rate), pattrib->seqnum);
+				#endif/*DBG_IP_R_MONITOR*/
+			 } else
+#endif/*CONFIG_IP_R_MONITOR*/
+			SET_TX_DESC_DATARATE_8733B(ptxdesc, MRateToHwRate(pmlmeext->tx_rate));
+		}
+
+#ifdef CONFIG_TDLS
+#ifdef CONFIG_XMIT_ACK
+		/* CCX-TXRPT ack for xmit data frames */
+		if (pxmitframe->ack_report) {
+			SET_TX_DESC_SPE_RPT_8733B(ptxdesc, 1);
+#ifdef DBG_CCX
+			RTW_INFO("%s set tx report\n", __func__);
+#endif
+		}
+#endif /* CONFIG_XMIT_ACK */
+#endif
+	} else if ((pxmitframe->frame_tag & 0x0f) == MGNT_FRAMETAG) {
+		/* RTW_INFO("pxmitframe->frame_tag == MGNT_FRAMETAG\n");	*/
+		SET_TX_DESC_MBSSID_8733B(ptxdesc, pattrib->mbssid & 0xF);
+
+		SET_TX_DESC_USE_RATE_8733B(ptxdesc, 1);
+		DriverFixedRate = 0x01;
+
+		SET_TX_DESC_DATARATE_8733B(ptxdesc, MRateToHwRate(pattrib->rate));
+
+		SET_TX_DESC_RTY_LMT_EN_8733B(ptxdesc, 1);
+		if (pattrib->retry_ctrl == _TRUE)
+			SET_TX_DESC_RTS_DATA_RTY_LMT_8733B(ptxdesc, 6);
+		else
+			SET_TX_DESC_RTS_DATA_RTY_LMT_8733B(ptxdesc, 12);
+
+		/* VHT NDPA or HT NDPA Packet for Beamformer. */
+		rtl8733b_fill_txdesc_mgnt_bf(pxmitframe, ptxdesc);
+
+#ifdef CONFIG_XMIT_ACK
+		/* CCX-TXRPT ack for xmit mgmt frames */
+		if (pxmitframe->ack_report) {
+			SET_TX_DESC_SPE_RPT_8733B(ptxdesc, 1);
+#ifdef DBG_CCX
+			RTW_INFO("%s set tx report\n", __func__);
+#endif
+		}
+#endif /* CONFIG_XMIT_ACK */
+	} else if ((pxmitframe->frame_tag & 0x0f) == TXAGG_FRAMETAG)
+		RTW_INFO("pxmitframe->frame_tag == TXAGG_FRAMETAG\n");
+
+#ifdef CONFIG_MP_INCLUDED
+	else if (((pxmitframe->frame_tag & 0x0f) == MP_FRAMETAG) &&
+		 (padapter->registrypriv.mp_mode == 1))
+
+		fill_txdesc_for_mp(padapter, ptxdesc);
+#endif
+
+	else {
+		RTW_INFO("pxmitframe->frame_tag = %d\n", pxmitframe->frame_tag);
+
+		SET_TX_DESC_USE_RATE_8733B(ptxdesc, 1);
+		DriverFixedRate = 0x01;
+		SET_TX_DESC_DATARATE_8733B(ptxdesc, MRateToHwRate(pmlmeext->tx_rate));
+	}
+
+	rtl8733b_fill_txdesc_bf(pxmitframe, ptxdesc);
+
+	if (DriverFixedRate)
+		SWDefineContent |= 0x01;
+
+	SET_TX_DESC_SW_DEFINE_8733B(ptxdesc, SWDefineContent);
+
+	SET_TX_DESC_MULTI_PORT_ID_8733B(ptxdesc, hw_port);
+
+	rtl8733b_cal_txdesc_chksum(padapter, ptxdesc);
+	rtl8733b_dbg_dump_tx_desc(padapter, pxmitframe->frame_tag, ptxdesc);
+
+	return pull;
+}
+
+
+
+#ifdef CONFIG_XMIT_THREAD_MODE
+/*
+ * Description
+ *	Transmit xmitbuf to hardware tx fifo
+ *
+ * Return
+ *	_SUCCESS	ok
+ *	_FAIL		something error
+ */
+s32 rtl8733bu_xmit_buf_handler(PADAPTER padapter)
+{
+	PHAL_DATA_TYPE phal;
+	struct xmit_priv *pxmitpriv;
+	struct xmit_buf *pxmitbuf;
+	struct xmit_frame *pxmitframe;
+	s32 ret;
+
+
+	phal = GET_HAL_DATA(padapter);
+	pxmitpriv = &padapter->xmitpriv;
+
+	ret = _rtw_down_sema(&pxmitpriv->xmit_sema);
+	if (_FAIL == ret)
+		return _FAIL;
+
+	if (RTW_CANNOT_RUN(padapter)) {
+		RTW_DBG(FUNC_ADPT_FMT "- bDriverStopped(%s) bSurpriseRemoved(%s)\n",
+			FUNC_ADPT_ARG(padapter),
+			rtw_is_drv_stopped(padapter) ? "True" : "False",
+			rtw_is_surprise_removed(padapter) ? "True" : "False");
+		return _FAIL;
+	}
+
+	if (check_pending_xmitbuf(pxmitpriv) == _FALSE)
+		return _SUCCESS;
+
+#ifdef CONFIG_LPS_LCLK
+	ret = rtw_register_tx_alive(padapter);
+	if (ret != _SUCCESS) {
+		return _SUCCESS;
+	}
+#endif /* CONFIG_LPS_LCLK */
+
+	do {
+		pxmitbuf = dequeue_pending_xmitbuf(pxmitpriv);
+		if (pxmitbuf == NULL)
+			break;
+
+		pxmitframe = (struct xmit_frame *) pxmitbuf->priv_data;
+		/* only XMITBUF_DATA & XMITBUF_MGNT */
+		rtw_write_port_and_wait(padapter, pxmitbuf->ff_hwaddr, pxmitbuf->len, (unsigned char *)pxmitbuf, 500);
+		rtw_free_xmitframe(pxmitpriv, pxmitframe);
+	} while (1);
+
+#ifdef CONFIG_LPS_LCLK
+	rtw_unregister_tx_alive(padapter);
+#endif /*CONFIG_LPS_LCLK */
+
+	return _SUCCESS;
+}
+#endif /* CONFIG_XMIT_THREAD_MODE */
