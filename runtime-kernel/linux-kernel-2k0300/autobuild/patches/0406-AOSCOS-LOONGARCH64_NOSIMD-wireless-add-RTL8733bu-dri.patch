+#include <hal_data.h>
+
+#ifndef RTW_WNM_DBG
+	#define RTW_WNM_DBG	0
+#endif
+#if RTW_WNM_DBG
+	#define RTW_WNM_INFO(fmt, arg...)	\
+		RTW_INFO(fmt, arg)
+	#define RTW_WNM_DUMP(str, data, len)	\
