+			break;
+#endif
+#if (RTL8197G_SUPPORT == 1)
+		case ODM_RTL8197G:
+			do_dpk_8197g(dm);
+			break;
+#endif
+
+#endif
+
+#if (RTL8814B_SUPPORT == 1)
+		case ODM_RTL8814B:
+			do_dpk_8814b(dm);
+			break;
+#endif
+#if (RTL8733B_SUPPORT == 1)
+		case ODM_RTL8733B:
+			do_dpk_8733b(dm);
+			break;
+#endif
+
+#if (DM_ODM_SUPPORT_TYPE & (ODM_IOT))
+#if (RTL8195B_SUPPORT == 1)
