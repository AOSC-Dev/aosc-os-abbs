+
+	odm_set_bb_reg(dm, 0x1b1c, 0xfff, 0xd21);
+	odm_set_bb_reg(dm, 0x1b1c, 0xfff00000, 0x821);
+	odm_set_bb_reg(dm, 0x1b28, MASKDWORD, 0x0);
+	odm_set_bb_reg(dm, 0x1bcc, 0x3f, 0x3f);	
