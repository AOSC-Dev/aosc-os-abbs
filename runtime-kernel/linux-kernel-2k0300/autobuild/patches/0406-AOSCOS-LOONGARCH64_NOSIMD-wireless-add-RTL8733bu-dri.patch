+
+static enum halmac_ret_status
+iddma_en_87xx(struct halmac_adapter *adapter, u32 src, u32 dest, u32 ctrl);
+
+static enum halmac_ret_status
+check_fw_chksum_87xx(struct halmac_adapter *adapter, u32 mem_addr);
+
+static void
+fw_fatal_status_debug_87xx(struct halmac_adapter *adapter);
+
+static enum halmac_ret_status
+start_dlfw_87xx(struct halmac_adapter *adapter, u8 *fw_bin, u32 size,
+		u32 dl_addr, u8 emem_only);
+
+static enum halmac_ret_status
+chk_fw_size_87xx(struct halmac_adapter *adapter, u8 *fw_bin, u32 size);
+
+static void
+chk_h2c_ver_87xx(struct halmac_adapter *adapter, u8 *fw_bin);
+
+static void
+wlan_cpu_en_87xx(struct halmac_adapter *adapter, u8 enable);
+
+static void
+pltfm_reset_87xx(struct halmac_adapter *adapter);
+
+/*
+static enum halmac_ret_status
+proc_send_general_info_87xx(struct halmac_adapter *adapter,
+			    struct halmac_general_info *info);
+
+static enum halmac_ret_status
+proc_send_phydm_info_87xx(struct halmac_adapter *adapter,
+			  struct halmac_general_info *info);
+*/
+u8 sec_fwdl_handshk_cnt = 0;
+/**
+ * download_firmware_87xx() - download Firmware
+ * @adapter : the adapter of halmac
+ * @fw_bin : firmware bin
+ * @size : firmware size
+ * Author : KaiYuan Chang/Ivan Lin
+ * Return : enum halmac_ret_status
+ * More details of status code can be found in prototype document
+ */
+enum halmac_ret_status
+download_firmware_87xx(struct halmac_adapter *adapter, u8 *fw_bin, u32 size)
+{
+	u8 value8, secure_ctrl;
+	u32 bckp_idx = 0;
+	u32 lte_coex_backup = 0;
+	struct halmac_backup_info bckp[DLFW_RESTORE_REG_NUM];
+	enum halmac_ret_status status;
+	struct halmac_api *api = (struct halmac_api *)adapter->halmac_api;
+	//enable 3081 platform clock
+	HALMAC_REG_W8(REG_EXT_SYS_CLK_CTRL, HALMAC_REG_R8(REG_EXT_SYS_CLK_CTRL)|0x02);
+	//enable IRAM2/IRAM3 power cut and isolation
+	HALMAC_REG_W32(REG_EXT_SYS_FUNC_EN, (HALMAC_REG_R32(REG_EXT_SYS_FUNC_EN)|0x00003000)&0xFFFFFF3F);
+	secure_ctrl = HALMAC_REG_R8(REG_SECURE_CTRL);
+	if (adapter->halmac_state.mac_pwr == HALMAC_MAC_POWER_OFF)
+		return HALMAC_RET_POWER_STATE_INVALID;
+
+	PLTFM_MSG_TRACE("[TRACE]%s ===>\n", __func__);
+
+	if((secure_ctrl&0x03)==0x00){    // FW security enable
+		PLTFM_MSG_ERR("[ERR]Don't check FW size!\n");
+	}
+	else{
+		status = chk_fw_size_87xx(adapter, fw_bin, size);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+	}
+
+	chk_h2c_ver_87xx(adapter, fw_bin);
+
+	if (adapter->halmac_state.wlcpu_mode == HALMAC_WLCPU_ENTER_SLEEP)
+		PLTFM_MSG_WARN("[WARN]Enter Sleep..zZZ\n");
+
+	adapter->halmac_state.dlfw_state = HALMAC_DLFW_NONE;
+
+#if !HALMAC_8733B_SUPPORT
+	status = ltecoex_reg_read_87xx(adapter, 0x38, &lte_coex_backup);
+	if (status != HALMAC_RET_SUCCESS)
+		return status;
+#endif
+	wlan_cpu_en_87xx(adapter, 0);
+
+	/* set HIQ to hi priority */
+	bckp[bckp_idx].length = 1;
+	bckp[bckp_idx].mac_register = REG_TXDMA_PQ_MAP + 1;
+	bckp[bckp_idx].value = HALMAC_REG_R8(REG_TXDMA_PQ_MAP + 1);
+	bckp_idx++;
+	value8 = HALMAC_DMA_MAPPING_HIGH << 6;
+	HALMAC_REG_W8(REG_TXDMA_PQ_MAP + 1, value8);
+
+	/* DLFW only use HIQ, map HIQ to hi priority */
+	adapter->pq_map[HALMAC_PQ_MAP_HI] = HALMAC_DMA_MAPPING_HIGH;
+	bckp[bckp_idx].length = 1;
+	bckp[bckp_idx].mac_register = REG_CR;
+	bckp[bckp_idx].value = HALMAC_REG_R8(REG_CR);
+	bckp_idx++;
+	value8 = BIT_HCI_TXDMA_EN | BIT_TXDMA_EN;
+	HALMAC_REG_W8(REG_CR, value8);
+
+	/* Config hi priority queue and public priority queue page number */
+	bckp[bckp_idx].length = 1;
+	bckp[bckp_idx].mac_register = REG_RQPN_CTRL_HLPQ;
+	bckp[bckp_idx].value = HALMAC_REG_R8(REG_RQPN_CTRL_HLPQ);
+	bckp_idx++;
+	bckp[bckp_idx].length = 1;
+	bckp[bckp_idx].mac_register = REG_RQPN_CTRL_HLPQ+1;
+	bckp[bckp_idx].value = HALMAC_REG_R8(REG_RQPN_CTRL_HLPQ+1);
+	bckp_idx++;
+	bckp[bckp_idx].length = 1;
+	bckp[bckp_idx].mac_register = REG_RQPN_CTRL_HLPQ+2;
+	bckp[bckp_idx].value = HALMAC_REG_R8(REG_RQPN_CTRL_HLPQ+2);
+	bckp_idx++;
+	HALMAC_REG_W8(REG_RQPN_CTRL_HLPQ, 0xD0);
+	HALMAC_REG_W8(REG_RQPN_CTRL_HLPQ+1, 0x00);
+	HALMAC_REG_W8(REG_RQPN_CTRL_HLPQ+2, 0x20);
+	HALMAC_REG_W8(REG_RQPN_CTRL_HLPQ+3, 0x80);
+
+	/* Disable beacon related functions */
+	value8 = HALMAC_REG_R8(REG_BCN_CTRL);
+	bckp[bckp_idx].length = 1;
+	bckp[bckp_idx].mac_register = REG_BCN_CTRL;
+	bckp[bckp_idx].value = value8;
+	bckp_idx++;
+	value8 = (u8)((value8 & (~BIT(3))) | BIT(4));
+	HALMAC_REG_W8(REG_BCN_CTRL, value8);
+
+	if (adapter->intf == HALMAC_INTERFACE_SDIO)
+	{
+		HALMAC_REG_R32(REG_SDIO_FREE_TXPG);
+		HALMAC_REG_R16(REG_SDIO_FREE_TXPG+4);
+	}
+
+	pltfm_reset_87xx(adapter);
+
+	status = start_dlfw_87xx(adapter, fw_bin, size, 0, 0);
+
+	restore_mac_reg_87xx(adapter, bckp, DLFW_RESTORE_REG_NUM);
+
+	if (status != HALMAC_RET_SUCCESS)
+		goto DLFW_FAIL;
+
+	status = dlfw_end_flow_87xx(adapter);
+	if (status != HALMAC_RET_SUCCESS)
+		goto DLFW_FAIL;
+#if !HALMAC_8733B_SUPPORT
+	status = ltecoex_reg_write_87xx(adapter, 0x38, lte_coex_backup);
+	if (status != HALMAC_RET_SUCCESS)
+		return status;
+#endif
+	adapter->halmac_state.dlfw_state = HALMAC_DLFW_DONE;
+
+	PLTFM_MSG_TRACE("[TRACE]%s <===\n", __func__);
+
+	return HALMAC_RET_SUCCESS;
+
+DLFW_FAIL:
+
+	/* Disable FWDL_EN */
+	/*value8 = HALMAC_REG_R8(REG_MCUFW_CTRL);
+	value8 &= ~BIT(0);
+	HALMAC_REG_W8(REG_MCUFW_CTRL, value8);*/
+
+	value8 = HALMAC_REG_R8(REG_SYS_FUNC_EN + 1);
+	value8 |= BIT(2);
+	HALMAC_REG_W8(REG_SYS_FUNC_EN + 1, value8);
+
+#if !HALMAC_8733B_SUPPORT
+	if (ltecoex_reg_write_87xx(adapter, 0x38, lte_coex_backup) !=
+	    HALMAC_RET_SUCCESS)
+		return HALMAC_RET_LTECOEX_READY_FAIL;
+#endif
+
+	return status;
+}
+
+static enum halmac_ret_status
+start_dlfw_87xx(struct halmac_adapter *adapter, u8 *fw_bin, u32 size,
+		u32 dl_addr, u8 emem_only)
+{
+	u8 *cur_fw, secure_ctrl;
+	u16 value16;
+	u32 imem_size;
+	u32 dmem_size;
+	u32 emem_size = 0;
+	u32 addr=0;
+	struct halmac_api *api = (struct halmac_api *)adapter->halmac_api;
+	enum halmac_ret_status status;
+	secure_ctrl = HALMAC_REG_R8(REG_SECURE_CTRL);
+
+	if((secure_ctrl&0x03) == 0x00){	//secure download
+		HALMAC_REG_W8(REG_DL_HANDSHK_DRV2FW, 0);
+		sec_fwdl_handshk_cnt = 0;
+		wlan_cpu_en_87xx(adapter, 0);
+		wlan_cpu_en_87xx(adapter, 1);
+		dmem_size =
+			rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_DMEM_SIZE)));
+		imem_size =
+			rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_IMEM_SIZE)));
+		if (0 != ((*(fw_bin + WLAN_FW_HDR_MEM_USAGE)) & BIT(4)))
+			emem_size =
+			rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_EMEM_SIZE)));
+
+		dmem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+		imem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+		if (emem_size != 0)
+			emem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+
+		if (emem_only == 1) {
+			if (!emem_size)
+				return HALMAC_RET_SUCCESS;
+			goto DLFW_EMEM;
+		}
+
+		value16 = (u16)(HALMAC_REG_R16(REG_MCUFW_CTRL) & 0x3800);
+		value16 |= BIT(0);
+		HALMAC_REG_W16(REG_MCUFW_CTRL, value16);
+
+		//download FWHDR + SECHDR
+		cur_fw = fw_bin;
+		status = sec_dlfw_to_mem_87xx(adapter, cur_fw, 0, WLAN_FW_HDR_SIZE + WLAN_FW_SEC_HDR_SIZE);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+
+		cur_fw = fw_bin + WLAN_FW_HDR_SIZE + WLAN_FW_SEC_HDR_SIZE;
+		addr = rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_DMEM_ADDR)));
+		addr &= ~BIT(31);
+		status = sec_dlfw_to_mem_87xx(adapter, cur_fw, 0, dmem_size);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+
+		cur_fw = fw_bin + WLAN_FW_HDR_SIZE + WLAN_FW_SEC_HDR_SIZE + dmem_size;
+		addr = rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_IMEM_ADDR)));
+		addr &= ~BIT(31);
+		status = sec_dlfw_to_mem_87xx(adapter, cur_fw, 0, imem_size);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+
+	DLFW_EMEM:
+		if (emem_size) {
+			cur_fw = fw_bin + WLAN_FW_HDR_SIZE +
+					dmem_size + imem_size;
+			addr = rtk_le32_to_cpu(*((__le32 *)(fw_bin +
+						   WLAN_FW_HDR_EMEM_ADDR)));
+			addr &= ~BIT(31);
+			status = dlfw_to_mem_87xx(adapter, cur_fw, dl_addr << 7, addr,
+						  emem_size);
+			if (status != HALMAC_RET_SUCCESS)
+				return status;
+
+			if (emem_only == 1)
+				return HALMAC_RET_SUCCESS;
+		}
+
+		//download secure data section
+		cur_fw = fw_bin + WLAN_FW_HDR_SIZE + WLAN_FW_SEC_HDR_SIZE + dmem_size + imem_size;
+		status = sec_dlfw_to_mem_87xx(adapter, cur_fw, 0, FW_SECURE_DATA_LEN);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+
+		update_fw_info_87xx(adapter, fw_bin);
+		init_ofld_feature_state_machine_87xx(adapter);
+	}
+	else{    //non secure download
+		dmem_size =
+			rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_DMEM_SIZE)));
+		imem_size =
+			rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_IMEM_SIZE)));
+		if (0 != ((*(fw_bin + WLAN_FW_HDR_MEM_USAGE)) & BIT(4)))
+			emem_size =
+			rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_EMEM_SIZE)));
+
+		dmem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+		imem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+		if (emem_size != 0)
+			emem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+
+		if (emem_only == 1) {
+			if (!emem_size)
+				return HALMAC_RET_SUCCESS;
+			goto DLFW_EMEM;
+		}
+
+		value16 = (u16)(HALMAC_REG_R16(REG_MCUFW_CTRL) & 0x3800);
+		value16 |= BIT(0);
+		HALMAC_REG_W16(REG_MCUFW_CTRL, value16);
+
+		cur_fw = fw_bin + WLAN_FW_HDR_SIZE;
+		addr = rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_DMEM_ADDR)));
+		addr &= ~BIT(31);
+		status = dlfw_to_mem_87xx(adapter, cur_fw, 0, addr, dmem_size);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+
+		cur_fw = fw_bin + WLAN_FW_HDR_SIZE + dmem_size;
+		addr = rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_IMEM_ADDR)));
+		addr &= ~BIT(31);
+		status = dlfw_to_mem_87xx(adapter, cur_fw, 0, addr, imem_size);
+		if (status != HALMAC_RET_SUCCESS)
+			return status;
+	/*
+	SEC_DLFW_EMEM:
+		if (emem_size) {
+			cur_fw = fw_bin + WLAN_FW_HDR_SIZE +
+					dmem_size + imem_size;
+			addr = rtk_le32_to_cpu(*((__le32 *)(fw_bin +
+						   WLAN_FW_HDR_EMEM_ADDR)));
+			addr &= ~BIT(31);
+			status = dlfw_to_mem_87xx(adapter, cur_fw, dl_addr << 7, addr,
+						  emem_size);
+			if (status != HALMAC_RET_SUCCESS)
+				return status;
+
+			if (emem_only == 1)
+				return HALMAC_RET_SUCCESS;
+		}
+		*/
+		update_fw_info_87xx(adapter, fw_bin);
+		init_ofld_feature_state_machine_87xx(adapter);
+	}
+	
+	return HALMAC_RET_SUCCESS;
+}
+
+static void
+chk_h2c_ver_87xx(struct halmac_adapter *adapter, u8 *fw_bin)
+{
+	u16 halmac_h2c_ver;
+	u16 fw_h2c_ver;
+
+	fw_h2c_ver = rtk_le16_to_cpu(*((__le16 *)(fw_bin +
+						  WLAN_FW_HDR_H2C_FMT_VER)));
+	halmac_h2c_ver = H2C_FORMAT_VERSION;
+
+	PLTFM_MSG_TRACE("[TRACE]halmac h2c ver = %x, fw h2c ver = %x!!\n",
+			halmac_h2c_ver, fw_h2c_ver);
+}
+
+static enum halmac_ret_status
+chk_fw_size_87xx(struct halmac_adapter *adapter, u8 *fw_bin, u32 size)
+{
+	u32 imem_size;
+	u32 dmem_size;
+	u32 emem_size = 0;
+	u32 real_size;
+
+	if (size < WLAN_FW_HDR_SIZE) {
+		PLTFM_MSG_ERR("[ERR]FW size error!\n");
+		return HALMAC_RET_FW_SIZE_ERR;
+	}
+
+	dmem_size =
+		rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_DMEM_SIZE)));
+	imem_size =
+		rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_IMEM_SIZE)));
+	if (0 != ((*(fw_bin + WLAN_FW_HDR_MEM_USAGE)) & BIT(4)))
+		emem_size =
+		rtk_le32_to_cpu(*((__le32 *)(fw_bin + WLAN_FW_HDR_EMEM_SIZE)));
+
+	dmem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+	imem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+	if (emem_size != 0)
+		emem_size += WLAN_FW_HDR_CHKSUM_SIZE;
+
+	real_size = WLAN_FW_HDR_SIZE + dmem_size + imem_size + emem_size;
+	if (size != real_size) {
+		PLTFM_MSG_ERR("[ERR]size != real size!\n");
+		return HALMAC_RET_FW_SIZE_ERR;
+	}
+
+	return HALMAC_RET_SUCCESS;
+}
+
+static void
+wlan_cpu_en_87xx(struct halmac_adapter *adapter, u8 enable)
+{
+	u8 value8;
+	struct halmac_api *api = (struct halmac_api *)adapter->halmac_api;
+
+	if (enable == 1) {
+#if 0 //8733B don't has this setting
+		/* cpu io interface enable or disable */
+		value8 = HALMAC_REG_R8(REG_RSV_CTRL + 1);
+		value8 |= BIT(0);
+		HALMAC_REG_W8(REG_RSV_CTRL + 1, value8);
+#endif
+		/* cpu enable or disable */
+		value8 = HALMAC_REG_R8(REG_SYS_FUNC_EN + 1);
+		value8 |= BIT(2);
+		HALMAC_REG_W8(REG_SYS_FUNC_EN + 1, value8);
+
+	} else {
+		/* cpu enable or disable */
+		value8 = HALMAC_REG_R8(REG_SYS_FUNC_EN + 1);
+		value8 &= ~BIT(2);
+		HALMAC_REG_W8(REG_SYS_FUNC_EN + 1, value8);
+#if 0 //8733B don't has this setting
+		/* cpu io interface enable or disable */
+		value8 = HALMAC_REG_R8(REG_RSV_CTRL + 1);
+		value8 &= ~BIT(0);
+		HALMAC_REG_W8(REG_RSV_CTRL + 1, value8);
+#endif
+	}
+}
+
+static void
+pltfm_reset_87xx(struct halmac_adapter *adapter)
+{
+	u8 value8;
+	struct halmac_api *api = (struct halmac_api *)adapter->halmac_api;
+
+	value8 = HALMAC_REG_R8(REG_EXT_SYS_FUNC_EN+2) & ~BIT(0);
+	HALMAC_REG_W8(REG_EXT_SYS_FUNC_EN+2, value8);
+
+	value8 = HALMAC_REG_R8(REG_EXT_SYS_FUNC_EN+2) | BIT(0);
+	HALMAC_REG_W8(REG_EXT_SYS_FUNC_EN+2, value8);
+}
+
+/**
+ * free_download_firmware_87xx() - download specific memory firmware
+ * @adapter
+ * @mem_sel : memory selection
+ * @fw_bin : firmware bin
+ * @size : firmware size
+ * Author : KaiYuan Chang/Ivan Lin
+ * Return : enum halmac_ret_status
+ */
+enum halmac_ret_status
+free_download_firmware_87xx(struct halmac_adapter *adapter,
+			    enum halmac_dlfw_mem mem_sel, u8 *fw_bin, u32 size)
+{
+	u8 tx_pause_bckp;
+	u32 dl_addr;
+	u32 dlfw_size_bckp;
+	enum halmac_ret_status status;
+	struct halmac_api *api = (struct halmac_api *)adapter->halmac_api;
+
+	if (halmac_fw_validate(adapter) != HALMAC_RET_SUCCESS)
+		return HALMAC_RET_NO_DLFW;
+
+	PLTFM_MSG_TRACE("[TRACE]%s ===>\n", __func__);
+
+	status = chk_fw_size_87xx(adapter, fw_bin, size);
+	if (status != HALMAC_RET_SUCCESS)
+		return status;
+
+	if (((*(fw_bin + WLAN_FW_HDR_MEM_USAGE)) & BIT(4)) == 0)
+		return HALMAC_RET_SUCCESS;
+
+	dlfw_size_bckp = adapter->dlfw_pkt_size;
+	if (mem_sel == HALMAC_DLFW_MEM_EMEM) {
+		dl_addr = 0;
+	} else {
+		dl_addr = adapter->txff_alloc.rsvd_h2c_info_addr;
+		adapter->dlfw_pkt_size = (dlfw_size_bckp > DLFW_RSVDPG_SIZE) ?
+					DLFW_RSVDPG_SIZE : dlfw_size_bckp;
+	}
+
+	tx_pause_bckp = HALMAC_REG_R8(REG_TXPAUSE);
+	HALMAC_REG_W8(REG_TXPAUSE, tx_pause_bckp | BIT(7));
+
+	status = start_dlfw_87xx(adapter, fw_bin, size, dl_addr, 1);
+	if (status != HALMAC_RET_SUCCESS)
+		goto DL_FREE_FW_END;
+
+	status = free_dl_fw_end_flow_87xx(adapter);
+
+DL_FREE_FW_END:
+	HALMAC_REG_W8(REG_TXPAUSE, tx_pause_bckp);
+	adapter->dlfw_pkt_size = dlfw_size_bckp;
+
+	PLTFM_MSG_TRACE("[TRACE]%s <===\n", __func__);
+
+	return status;
+}
+
+/**
+ * reset_wifi_fw_87xx() - reset wifi fw
+ * @adapter : the adapter of halmac
+ * Author : LIN YONG-CHING
+ * Return : enum halmac_ret_status
+ * More details of status code can be found in prototype document
+ */
+enum halmac_ret_status
+reset_wifi_fw_87xx(struct halmac_adapter *adapter)
+{
+	enum halmac_ret_status status;
+	u32 lte_coex_backup = 0;
+
+	PLTFM_MSG_TRACE("[TRACE]%s ===>\n", __func__);
+
+	status = ltecoex_reg_read_87xx(adapter, 0x38, &lte_coex_backup);
+	if (status != HALMAC_RET_SUCCESS)
+		return status;
+
+	wlan_cpu_en_87xx(adapter, 0);
+	pltfm_reset_87xx(adapter);
+	init_ofld_feature_state_machine_87xx(adapter);
+	wlan_cpu_en_87xx(adapter, 1);
+
+	status = ltecoex_reg_write_87xx(adapter, 0x38, lte_coex_backup);
+	if (status != HALMAC_RET_SUCCESS)
+		return status;
+
+	PLTFM_MSG_TRACE("[TRACE]%s <===\n", __func__);
+
+	return HALMAC_RET_SUCCESS;
+}
+
+/**
+ * get_fw_version_87xx() - get FW version
+ * @adapter : the adapter of halmac
+ * @ver : fw version info
+ * Author : Ivan Lin
+ * Return : enum halmac_ret_status
+ * More details of status code can be found in prototype document
+ */
+enum halmac_ret_status
+get_fw_version_87xx(struct halmac_adapter *adapter,
+		    struct halmac_fw_version *ver)
+{
+	struct halmac_fw_version *info = &adapter->fw_ver;
+
+	if (!ver)
+		return HALMAC_RET_NULL_POINTER;
+
+	if (adapter->halmac_state.dlfw_state == HALMAC_DLFW_NONE)
+		return HALMAC_RET_NO_DLFW;
+
+	ver->version = info->version;
+	ver->sub_version = info->sub_version;
+	ver->sub_index = info->sub_index;
+	ver->h2c_version = info->h2c_version;
+	ver->build_time.month = info->build_time.month;
+	ver->build_time.date = info->build_time.date;
+	ver->build_time.hour = info->build_time.hour;
+	ver->build_time.min = info->build_time.min;
+	ver->build_time.year = info->build_time.year;
+
+	return HALMAC_RET_SUCCESS;
+}
