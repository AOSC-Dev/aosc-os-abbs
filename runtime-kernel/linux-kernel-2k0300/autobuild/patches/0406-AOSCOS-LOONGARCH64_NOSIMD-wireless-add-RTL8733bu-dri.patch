+	config_phydm_write_txagc_ref_8733b(dm, ref_pow_ofdm[1], RF_PATH_B,
+					   PDM_OFDM);
+
+	/* === [Power By Rate] ==============================================*/
+	odm_move_memory(dm, diff_tab, dm->txagc_buff, NUM_RATE_N_1SS * 2);
