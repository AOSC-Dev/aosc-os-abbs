+static void hw_var_set_mlme_disconnect(PADAPTER adapter)
+{
+	u8 val8;
+	struct mi_state mstate;
+
+#ifdef CONFIG_CONCURRENT_MODE
+	if (rtw_mi_check_status(adapter, MI_LINKED) == _FALSE)
+#endif
+		/* reject all data frames under not link state */
+		rtw_write16(adapter, REG_RXFLTMAP2_8733B, 0);
+
+#ifdef CONFIG_CONCURRENT_MODE
+	if (adapter->hw_port == HW_PORT1) {
+		/* reset TSF1(CLINT0) */
+		rtw_write8(adapter, REG_DUAL_TSF_RST_8733B, BIT_TSFTR_CLI0_RST_8733B);
+
+		/* disable update TSF1(CLINT0) */
+		rtw_iface_disable_tsf_update(adapter);
+
+		/* disable Port1's beacon function */
+		val8 = rtw_read8(adapter, REG_BCN_CTRL_CLINT0_8733B);
+		val8 &= ~BIT_CLI0_EN_BCN_FUNCTION_8733B;
+		rtw_write8(adapter, REG_BCN_CTRL_CLINT0_8733B, val8);
+	} else
+#endif
+	{
+		/* reset TSF */
+		rtw_write8(adapter, REG_DUAL_TSF_RST_8733B, BIT_TSFTR_RST_8733B);
+
+		/* disable update TSF */
+		rtw_iface_disable_tsf_update(adapter);
+	}
+
+	rtw_mi_status_no_self(adapter, &mstate);
+
+	/* clear update TSF only BSSID match for no linked station */
+	if (MSTATE_STA_LD_NUM(&mstate) == 0 && MSTATE_STA_LG_NUM(&mstate) == 0)
+		rtl8733b_rx_tsf_addr_filter_config(adapter, 0);
+
+#ifdef CONFIG_CLIENT_PORT_CFG
+	if (MLME_IS_STA(adapter))
+		rtw_hw_client_port_clr(adapter);
+#endif
+
+}
