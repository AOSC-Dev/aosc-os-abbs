+u8 phydm_pw_2_percent(s8 ant_power)
+{
+	if ((ant_power <= -100) || ant_power >= 20)
+		return 0;
+	else if (ant_power >= 0)
+		return 100;
+	else
+		return 100 + ant_power;
+}
