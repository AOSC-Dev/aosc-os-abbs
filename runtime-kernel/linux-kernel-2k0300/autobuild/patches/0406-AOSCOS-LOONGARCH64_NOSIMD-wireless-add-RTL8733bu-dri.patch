+		HALMAC_REG_W16(REG_SOUNDING_CFG0, param->csi_para);
+		break;
+	case 1:
+		HALMAC_REG_W32(REG_SOUNDING_CFG2, mac_addr_l);
+		HALMAC_REG_W16(REG_SOUNDING_CFG2 + 4, mac_addr_h);
+		HALMAC_REG_W16(REG_SOUNDING_CFG2 + 6, param->paid);
+		HALMAC_REG_W16(REG_SOUNDING_CFG0 + 2, param->csi_para);
+		break;
+	default:
+		return HALMAC_RET_INVALID_SOUNDING_SETTING;
+	}
+
+	PLTFM_MSG_TRACE("[TRACE]%s <===\n", __func__);
+
+	return HALMAC_RET_SUCCESS;
