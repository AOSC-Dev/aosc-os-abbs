+/*
+ * Description:
+ *	In normal chip, we should send some packet to HW which will be used by FW
+ *	in FW LPS mode.
+ *	The function is to fill the Tx descriptor of this packets,
+ *	then FW can tell HW to send these packet directly.
+ */
+static void fill_fake_txdesc(PADAPTER adapter, u8 *pDesc, u32 BufferLen,
+			     u8 IsPsPoll, u8 IsBTQosNull, u8 bDataFrame)
+{
+	/* Clear all status */
+	struct mlme_ext_priv	*pmlmeext = &adapter->mlmeextpriv;
+	struct xmit_priv		*pxmitpriv = &adapter->xmitpriv;
+	u32 desc_size;
+	u8 hw_port = rtw_hal_get_port(adapter);
+
+	desc_size = rtl8733b_get_tx_desc_size(adapter);
+	_rtw_memset(pDesc, 0, desc_size);
+
+	SET_TX_DESC_OFFSET_8733B(pDesc, desc_size);
+
+	SET_TX_DESC_TXPKTSIZE_8733B(pDesc, BufferLen);
+	SET_TX_DESC_QSEL_8733B(pDesc, QSLT_MGNT); /* Fixed queue of Mgnt queue */
+
+	if (pmlmeext->cur_wireless_mode & WIRELESS_11B)
+		SET_TX_DESC_RATE_ID_8733B(pDesc, RATEID_IDX_B);
+	else
+		SET_TX_DESC_RATE_ID_8733B(pDesc, RATEID_IDX_G);
+
+	/* Set NAVUSEHDR to prevent Ps-poll AId filed to be changed to error vlaue by HW */
+	if (_TRUE == IsPsPoll)
+		SET_TX_DESC_NAVUSEHDR_8733B(pDesc, 1);
+	else {
+		SET_TX_DESC_EN_HWSEQ_8733B(pDesc, 1);
+		SET_TX_DESC_HW_SSN_SEL_8733B(pDesc, pxmitpriv->hw_ssn_seq_no);/*pattrib->hw_ssn_sel*/
+	}
+
+	if (_TRUE == IsBTQosNull)
+		SET_TX_DESC_BT_NULL_8733B(pDesc, 1);
+
+	SET_TX_DESC_USE_RATE_8733B(pDesc, 1);
+	SET_TX_DESC_DATARATE_8733B(pDesc, MRateToHwRate(pmlmeext->tx_rate));
+
+#ifdef CONFIG_MCC_MODE
+	/* config Null data retry number */
+	if (IsPsPoll == _FALSE && IsBTQosNull == _FALSE && bDataFrame == _FALSE) {
+		if (rtw_hal_check_mcc_status(adapter, MCC_STATUS_PROCESS_MCC_START_SETTING)) {
+			u8 rty_num = adapter->mcc_adapterpriv.null_rty_num;
+			if (rty_num != 0) {
+				SET_TX_DESC_RTY_LMT_EN_8733B(pDesc, 1);
+				SET_TX_DESC_RTS_DATA_RTY_LMT_8733B(pDesc, rty_num);
+			}
+		}
+	}
+#endif
+
+
+	/*
+	 * Encrypt the data frame if under security mode excepct null data.
+	 */
+	if (_TRUE == bDataFrame) {
+		u32 EncAlg;
+
+		EncAlg = adapter->securitypriv.dot11PrivacyAlgrthm;
+		switch (EncAlg) {
+		case _NO_PRIVACY_:
+			SET_TX_DESC_SEC_TYPE_8733B(pDesc, 0x0);
+			break;
+		case _WEP40_:
+		case _WEP104_:
+		case _TKIP_:
+			SET_TX_DESC_SEC_TYPE_8733B(pDesc, 0x1);
+			break;
+		case _SMS4_:
+			SET_TX_DESC_SEC_TYPE_8733B(pDesc, 0x2);
+			break;
+		case _AES_:
+			SET_TX_DESC_SEC_TYPE_8733B(pDesc, 0x3);
+			break;
+		case _CCMP_256_:
+		case _GCMP_:
+		case _GCMP_256_:
+			SET_TX_DESC_SEC_TYPE_8733B(pDesc, 0x2);
+			break;
+		default:
+			SET_TX_DESC_SEC_TYPE_8733B(pDesc, 0x0);
+			break;
+		}
+	}
+
+	SET_TX_DESC_MULTI_PORT_ID_8733B(pDesc, hw_port);
+
+	/*
+	 * USB interface drop packet if the checksum of descriptor isn't correct.
+	 * Using this checksum can let hardware recovery from packet bulk out error (e.g. Cancel URC, Bulk out error.).
+	 */
+	rtl8733b_cal_txdesc_chksum(adapter, pDesc);
+}
