+		return;
+
+	PDM_VAST_SNPF(out_len, used, output + used, out_len - used,
+		      "%-17s = %s\n", "DbgPort index", "Value");
+
+#if 0
+	/*0x000/0x001/0x002*/
+	for (i = 0; i < 3; i++) {
