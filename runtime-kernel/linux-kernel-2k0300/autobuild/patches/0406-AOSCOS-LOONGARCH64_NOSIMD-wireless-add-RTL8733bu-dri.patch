+void rtw_set_vht_ext_cap(_adapter *padapter, WLAN_BSSID_EX *pnetwork)
+{
+	struct mlme_priv *pmlmepriv = &(padapter->mlmepriv);
+	struct vht_priv *pvhtpriv = &(pmlmepriv->vhtpriv);
+	u32 frlen = 0;
