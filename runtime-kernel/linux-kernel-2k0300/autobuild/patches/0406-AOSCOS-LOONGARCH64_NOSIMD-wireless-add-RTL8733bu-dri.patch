+			HT_RATE_IDX * size);
+	odm_move_memory(dm, soml_tab->pre_vht_byte, soml_tab->vht_byte,
+			VHT_RATE_IDX * size);
+
+	if (dm->support_ic_type == ODM_RTL8822B) {
+		soml_tab->cfo_cnt++;
+		phydm_soml_cfo_process(dm,
+				       &soml_tab->cfo_diff_a,
+				       &soml_tab->cfo_diff_b);
