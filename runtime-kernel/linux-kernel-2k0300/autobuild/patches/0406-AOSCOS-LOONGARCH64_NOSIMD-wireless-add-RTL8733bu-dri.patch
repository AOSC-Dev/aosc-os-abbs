+/*--------------------Define MACRO---------------------------------*/
+
+/*--------------------Define Struct-----------------------------------*/
+
+#ifdef CONFIG_BEAMFORMING
+struct bf_cmn_info {
+	u8	ht_beamform_cap;		/*Sta capablity*/
+	u16	vht_beamform_cap;		/*Sta capablity*/
