+static u8
+packet_in_nlo_87xx(struct halmac_adapter *adapter,
+		   enum halmac_packet_id pkt_id)
+{
+	enum halmac_packet_id nlo_pkt = HALMAC_PACKET_PROBE_REQ_NLO;
+
+	if (pkt_id >= nlo_pkt)
+		return 1;
+	else
+		return 0;
+}
