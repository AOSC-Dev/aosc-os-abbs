+
+	RF_DBG(dm, DBG_RF_MP,
+		   "[kfree] %s:Set kfree to rf 0x33\n", __func__);
+
+	if (power_trim_info->flag & KFREE_FLAG_ON) { 
+		odm_set_rf_reg(dm, RF_PATH_A, RF_0xee, BIT(19), 1);
