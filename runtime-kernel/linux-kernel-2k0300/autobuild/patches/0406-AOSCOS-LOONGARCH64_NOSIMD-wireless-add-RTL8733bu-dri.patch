index 000000000000..cb159eb3f7a3
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtl8733bu/hal/rtl8733b/usb/rtl8733bu_xmit.c
@@ -0,0 +1,1132 @@
+/******************************************************************************
