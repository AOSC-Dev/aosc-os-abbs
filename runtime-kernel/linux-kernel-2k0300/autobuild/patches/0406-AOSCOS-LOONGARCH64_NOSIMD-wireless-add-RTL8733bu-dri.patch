+					     SCAN_CH_NOTIFY_GET_NOTIFY_ID(buf));
+		SCAN_CH_NOTIFY_SET_STATUS(scan_rpt_info->buf_wptr,
+					  (u8)SCAN_CH_NOTIFY_GET_STATUS(buf));
