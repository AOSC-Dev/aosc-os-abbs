+#define DYNAMIC_LA_MODE "4.2"
+
+/* @1 ============================================================
+ * 1  Definition
+ * 1 ============================================================
+ */
+
+#if (DM_ODM_SUPPORT_TYPE & ODM_AP)
+#if (RTL8197F_SUPPORT || RTL8198F_SUPPORT || RTL8197G_SUPPORT)
+	#define PHYDM_COMPILE_LA_STORE_IN_IMEM
