+u32 rtl8733bu_init(PADAPTER padapter)
+{
+	u8 status = _SUCCESS;
+	systime init_start_time = rtw_get_current_time();
+
+#ifdef CONFIG_FWLPS_IN_IPS
+	if (_SUCCESS == rtl8733bu_fw_ips_init(padapter))
+		goto exit;
+#endif
+
+	if (rtl8733b_init(padapter) == _FAIL)
+		status = _FAIL;
+	else
+		hal_init_misc(padapter);
+
+#ifdef CONFIG_FWLPS_IN_IPS
+exit:
+#endif
+	RTW_INFO("%s in %dms\n", __func__, rtw_get_passing_time_ms(init_start_time));
+	return status;
+}
