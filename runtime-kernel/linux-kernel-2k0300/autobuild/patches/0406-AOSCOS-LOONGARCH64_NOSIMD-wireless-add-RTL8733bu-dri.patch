+
+	rf->rfk_type = RF01_IQK;
+	halrf_rfk_handshake(dm, true);
+
+	if (!dm->rf_calibrate_info.is_iqk_in_progress) {
+		odm_acquire_spin_lock(dm, RT_IQK_SPINLOCK);
+		dm->rf_calibrate_info.is_iqk_in_progress = true;
