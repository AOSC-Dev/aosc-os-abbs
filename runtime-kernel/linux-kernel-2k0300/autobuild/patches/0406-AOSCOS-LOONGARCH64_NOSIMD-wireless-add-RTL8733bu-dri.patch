+void phydm_cmn_msg_setting(void *dm_void, u32 *val, u32 *_used,
+			   char *output, u32 *_out_len)
+{
+	struct dm_struct *dm = (struct dm_struct *)dm_void;
+	u32 used = *_used;
+	u32 out_len = *_out_len;
+
+	if (val[1] == 1) {
+		dm->cmn_dbg_msg_period = (u8)val[2];
