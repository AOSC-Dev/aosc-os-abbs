+void rtl8733b_rxdesc2attribute(struct rx_pkt_attrib *a, u8 *desc)
+{
+	/* initial value */
+	_rtw_memset(a, 0, sizeof(struct rx_pkt_attrib));
+	a->bw = CHANNEL_WIDTH_MAX;
+
+	/* Get from RX DESC */
+	a->pkt_len = (u16)GET_RX_DESC_PKT_LEN_8733B(desc);
+	a->pkt_rpt_type = GET_RX_DESC_C2H_8733B(desc) ? C2H_PACKET : NORMAL_RX;
+
+	if (a->pkt_rpt_type == NORMAL_RX) {
+		a->crc_err = (u8)GET_RX_DESC_CRC32_8733B(desc);
+		a->icv_err = (u8)GET_RX_DESC_ICV_ERR_8733B(desc);
+		a->drvinfo_sz = (u8)GET_RX_DESC_DRV_INFO_SIZE_8733B(desc) << 3;
+		a->encrypt = (u8)GET_RX_DESC_SECURITY_8733B(desc);
+		a->qos = (u8)GET_RX_DESC_QOS_8733B(desc);
+		a->shift_sz = (u8)GET_RX_DESC_SHIFT_8733B(desc);
+		a->physt = (u8)GET_RX_DESC_PHYST_8733B(desc);
+		a->bdecrypted = (u8)GET_RX_DESC_SWDEC_8733B(desc) ? 0 : 1;
+
+		a->priority = (u8)GET_RX_DESC_TID_8733B(desc);
+		a->amsdu = (u8)GET_RX_DESC_AMSDU_8733B(desc);
+		a->mdata = (u8)GET_RX_DESC_MD_8733B(desc);
+		a->mfrag = (u8)GET_RX_DESC_MF_8733B(desc);
+
+		a->seq_num = (u16)GET_RX_DESC_SEQ_8733B(desc);
+		a->frag_num = (u8)GET_RX_DESC_FRAG_8733B(desc);
+
+		a->data_rate = (u8)GET_RX_DESC_RX_RATE_8733B(desc);
+		a->ampdu = (u8)GET_RX_DESC_PAGGR_8733B(desc);
+		a->ampdu_eof = (u8)GET_RX_DESC_RX_EOF_8733B(desc);
+		a->ppdu_cnt = (u8)GET_RX_DESC_PPDU_CNT_8733B(desc);
+		a->free_cnt = (u32)GET_RX_DESC_TSFL_8733B(desc);
+
+#ifdef CONFIG_TCP_CSUM_OFFLOAD_RX
+		/* RX TCP checksum offload related variables */
+		a->csum_valid = (u8)GET_RX_DESC_CHK_VLD_8733B(desc);
+		a->csum_err = (u8)GET_RX_DESC_CHKERR_8733B(desc);
+#endif /* CONFIG_TCP_CSUM_OFFLOAD_RX */
+	}
+}
+
+void rtl8733b_query_rx_desc(union recv_frame *precvframe, u8 *pdesc)
+{
+	rtl8733b_rxdesc2attribute(&precvframe->u.hdr.attrib, pdesc);
+}
