+#if (DM_ODM_SUPPORT_TYPE == ODM_WIN)
+	HAL_DATA_TYPE *hal_data = GET_HAL_DATA(((PADAPTER)adapter));
+	struct dm_struct *dm = &hal_data->DM_OutSrc;
+#endif
+#endif
+	if (odm_get_bb_reg(dm, R_0x1884, BIT(20)) == 0x0)
+		return true;	/*S0*/
+	else
+		return false;
+}
