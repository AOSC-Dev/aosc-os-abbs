+	if (port_sel >= 1 && port_sel <= 4)
+		port_sel += 15;
+
+	rtw_enter_protsel(&padapter->dvobj->protsel_atimdtim, port_sel);
+
+	val8 = rtw_read8(padapter, REG_ATIM_DTIM_CTRL_SEL);
+	val8 &= ~BIT_MASK_ATIM_DTIM_SEL;
+	val8 |= BIT_ATIM_DTIM_SEL(port_sel);
