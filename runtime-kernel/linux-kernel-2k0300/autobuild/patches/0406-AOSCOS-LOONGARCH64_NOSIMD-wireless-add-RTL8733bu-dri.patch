+	/* RTW_INFO("%s:%d\n", __FUNCTION__, bForcePowerSave); */
+
+	struct dvobj_priv *dvobj = adapter_to_dvobj(padapter);
+	struct pwrctrl_priv *pwrpriv = dvobj_to_pwrctl(dvobj);
