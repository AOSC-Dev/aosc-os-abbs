+		else
+			cnt += snprintf(buf + cnt, TX_ACLT_CONF_MSG_LEN - cnt - 1, "        N/A");
+		if (cnt >= TX_ACLT_CONF_MSG_LEN - 1)
+			continue;
+		
+		if (conf->be_bk)
+			cnt += snprintf(buf + cnt, TX_ACLT_CONF_MSG_LEN - cnt - 1, "     0x%04x", conf->be_bk);
+		else
+			cnt += snprintf(buf + cnt, TX_ACLT_CONF_MSG_LEN - cnt - 1, "        N/A");
+		if (cnt >= TX_ACLT_CONF_MSG_LEN - 1)
