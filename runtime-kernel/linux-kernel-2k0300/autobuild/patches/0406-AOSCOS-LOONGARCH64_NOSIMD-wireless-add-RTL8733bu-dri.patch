+enum halmac_ret_status
+send_h2c_pkt_87xx(struct halmac_adapter *adapter, u8 *pkt)
+{
+	u32 cnt = 100;
+	enum halmac_ret_status status = HALMAC_RET_SUCCESS;
+
+	while (adapter->h2c_info.buf_fs <= H2C_PKT_SIZE_87XX) {
+		get_h2c_buf_free_space_87xx(adapter);
+		cnt--;
+		if (cnt == 0) {
+			PLTFM_MSG_ERR("[ERR]h2c free space!!\n");
+			return HALMAC_RET_H2C_SPACE_FULL;
+		}
+	}
+
+	cnt = 100;
+	do {
+		if (PLTFM_SEND_H2C_PKT(pkt, H2C_PKT_SIZE_87XX) == 1)
+			break;
+		cnt--;
+		if (cnt == 0) {
+			PLTFM_MSG_ERR("[ERR]pltfm - sned h2c pkt!!\n");
+			return HALMAC_RET_SEND_H2C_FAIL;
+		}
+		PLTFM_DELAY_US(5);
+
+	} while (1);
+
+	adapter->h2c_info.buf_fs -= H2C_PKT_SIZE_87XX;
+
+	return status;
+}
