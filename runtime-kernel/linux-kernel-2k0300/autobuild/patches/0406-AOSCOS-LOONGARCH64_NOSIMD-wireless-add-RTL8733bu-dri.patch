+	// ----- START : Set RF Setting -----
+	// 0xDE[14]=DEBUG_LUT_TX_TRACK=1
+	// 0xDE[13]=DEBUG_LUT_TX_POWER=1
+	odm_set_rf_reg(dm, RF_PATH_A, RF_0xde, 0xFE000, 0x3f);
+	odm_set_rf_reg(dm, RF_PATH_B, RF_0xde, 0xFE000, 0x3f);
