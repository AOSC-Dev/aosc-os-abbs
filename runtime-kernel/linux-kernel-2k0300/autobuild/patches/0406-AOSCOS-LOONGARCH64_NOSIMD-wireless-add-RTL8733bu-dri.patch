+void
+EFUSE_ShadowWrite(
+		PADAPTER	pAdapter,
+		u8		Type,
+		u16		Offset,
+		u32		Value);
+void
+EFUSE_ShadowWrite(
+		PADAPTER	pAdapter,
+		u8		Type,
+		u16		Offset,
+		u32		Value)
+{
+#if (MP_DRIVER == 0)
+	return;
