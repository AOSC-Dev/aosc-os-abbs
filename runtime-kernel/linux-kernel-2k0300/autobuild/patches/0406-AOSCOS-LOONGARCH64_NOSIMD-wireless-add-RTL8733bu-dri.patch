+void dbg_dump_pkt(char *s, u8 *buf, u8 len)
+{
+	u8 i, j = 1;
+
+	RTW_INFO("%s size = %u\n", s, len);
+
+	for (i = 0; (i + 4) < len; i += 4) {
+		if (j % 4 == 1)
+			RTW_PRINT("idx:%u:", i);
+		_RTW_PRINT(" 0x%02x 0x%02x 0x%02x 0x%02x", buf[i], buf[i+1], buf[i+2], buf[i+3]);
+		if ((j++) % 4 == 0)
+			_RTW_PRINT("\n");
+	}
+
+	for (; i < len ; i++) {
+		_RTW_PRINT(" 0x%02x", buf[i]);
+	}
+	_RTW_PRINT("\n ================================\n");
+}
