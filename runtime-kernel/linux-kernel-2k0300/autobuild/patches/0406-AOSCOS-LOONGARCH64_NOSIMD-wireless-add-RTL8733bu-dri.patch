+static void read_chip_version(PADAPTER adapter)
+{
+	PHAL_DATA_TYPE hal;
+	u32 value32;
+
+	hal = GET_HAL_DATA(adapter);
+
+	value32 = rtw_read32(adapter, REG_SYS_CFG1_8733B);
+	hal->version_id.ICType = CHIP_8733B;
+	hal->version_id.ChipType = ((value32 & BIT_RTL_ID_8733B) ? TEST_CHIP : NORMAL_CHIP);
+	hal->version_id.CUTVersion = BIT_GET_CHIP_VER_8733B(value32);
+	hal->version_id.VendorType = BIT_GET_VENDOR_ID_8733B(value32);
+	hal->version_id.VendorType >>= 2;
+	switch (hal->version_id.VendorType) {
+	case 0:
+		hal->version_id.VendorType = CHIP_VENDOR_TSMC;
+		break;
+	case 1:
+		hal->version_id.VendorType = CHIP_VENDOR_SMIC;
+		break;
+	case 2:
+		hal->version_id.VendorType = CHIP_VENDOR_UMC;
+		break;
+	}
+
+	hal->version_id.RFType = ((value32 & BIT_RF_TYPE_ID_8733B) ? RF_TYPE_2T2R : RF_TYPE_1T1R);
+
+	/* LDO mode : 1, SPS mode : 0 */
+	hal->RegulatorMode = ((value32 & BIT_SPSLDO_SEL_8733B) ? RT_LDO_REGULATOR : RT_SWITCHING_REGULATOR);
+
+	value32 = rtw_read32(adapter, REG_SYS_STATUS1_8733B);
+	hal->version_id.ROMVer = BIT_GET_RF_RL_ID_8733B(value32);
+
+	/* For multi-function consideration. */
+	hal->MultiFunc = RT_MULTI_FUNC_NONE;
+	value32 = rtw_read32(adapter, REG_WL_BT_PWR_CTRL_8733B);
+	hal->MultiFunc |= ((value32 & BIT_WL_FUNC_EN_8733B) ? RT_MULTI_FUNC_WIFI : 0);
+	hal->MultiFunc |= ((value32 & BIT_BT_FUNC_EN_8733B) ? RT_MULTI_FUNC_BT : 0);
+	hal->PolarityCtl = ((value32 & BIT_WL_HWPDN_SL_8733B) ? RT_POLARITY_HIGH_ACT : RT_POLARITY_LOW_ACT);
+
+	dump_chip_info(hal->version_id);
+}
