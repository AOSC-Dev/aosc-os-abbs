+#endif
+
+#if (RTL8192F_SUPPORT == 1)
+	case ODM_RTL8192F:
+		phy_dpk_track_8192f(dm);
+		break;
+#endif
+
+#if (RTL8198F_SUPPORT == 1)
+	case ODM_RTL8198F:
+		dpk_track_8198f(dm);
+		break;
+#endif
+
+#if (RTL8812F_SUPPORT == 1)
+	case ODM_RTL8812F:
+		dpk_track_8812f(dm);
+		break;
+#endif
+
+#if (RTL8197G_SUPPORT == 1)
+	case ODM_RTL8197G:
