+	odm_set_rf_reg(dm, RF_PATH_A, RF_0x33, RFREGOFFSETMASK, 0x6);
+	odm_set_rf_reg(dm, RF_PATH_A, RF_0x3f, 0x0000003f,
+		       power_trim_info->bb_gain[5][RF_PATH_A]);
+	odm_set_rf_reg(dm, RF_PATH_A, RF_0x33, RFREGOFFSETMASK, 0x7);
+	odm_set_rf_reg(dm, RF_PATH_A, RF_0x3f, 0x0000003f,
