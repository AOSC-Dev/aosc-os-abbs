+		odm_set_bb_reg(dm, R_0x1830, MASKDWORD, 0x70fb8041);
+	}  //0xFFA1005E
+	odm_set_bb_reg(dm, R_0x1c38, MASKDWORD, 0xffb5005e); //AD/DA fifo rst
+	odm_set_bb_reg(dm, R_0x1d40, BIT(3), 0x0);
