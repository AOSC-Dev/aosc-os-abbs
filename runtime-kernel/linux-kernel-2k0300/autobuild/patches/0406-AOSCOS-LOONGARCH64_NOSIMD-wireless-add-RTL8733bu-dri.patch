+		odm_set_bb_reg(dm, R_0x1830, MASKDWORD, 0x705f0041);
+		odm_set_bb_reg(dm, R_0x1830, MASKDWORD, 0x70644041);
+		odm_set_bb_reg(dm, R_0x1830, MASKDWORD, 0x707b8041);
+		odm_set_bb_reg(dm, R_0x1830, MASKDWORD, 0x708b8041);
