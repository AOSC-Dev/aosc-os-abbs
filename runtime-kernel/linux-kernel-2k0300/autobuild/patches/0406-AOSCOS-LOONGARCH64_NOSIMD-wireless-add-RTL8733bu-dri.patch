+
+	case MGN_MCS3:
+	case MGN_MCS11:
+	case MGN_MCS19:
+	case MGN_MCS27:
+	case MGN_VHT1SS_MCS3:
+	case MGN_VHT2SS_MCS3:
+	case MGN_VHT3SS_MCS3:
