+static void hw_var_set_acm_ctrl(PADAPTER adapter, u8 ctrl)
+{
+	u8 hwctrl = 0;
+
+	if (ctrl) {
+		hwctrl |= BIT_ACMHWEN_8733B;
+
+		if (ctrl & BIT(1)) /* BE */
+			hwctrl |= BIT_BEQ_ACM_EN_8733B;
+		else
+			hwctrl &= (~BIT_BEQ_ACM_EN_8733B);
+
+		if (ctrl & BIT(2)) /* VI */
+			hwctrl |= BIT_VIQ_ACM_EN_8733B;
+		else
+			hwctrl &= (~BIT_VIQ_ACM_EN_8733B);
+
+		if (ctrl & BIT(3)) /* VO */
+			hwctrl |= BIT_VOQ_ACM_EN_8733B;
+		else
+			hwctrl &= (~BIT_VOQ_ACM_EN_8733B);
+	}
+
+	RTW_INFO("[HW_VAR_ACM_CTRL] Write 0x%02X\n", hwctrl);
+	rtw_write8(adapter, REG_ACMHWCTRL_8733B, hwctrl);
+}
