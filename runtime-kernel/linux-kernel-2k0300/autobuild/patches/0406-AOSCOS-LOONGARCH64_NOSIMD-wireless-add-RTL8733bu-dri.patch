+void rtw_hal_update_ra_mask(struct sta_info *psta)
+{
+	_adapter *padapter;
+
+	if (!psta)
+		return;
+
+	padapter = psta->padapter;
+	rtw_sta_ra_registed(padapter, psta);
+}
