+		   coex_sta->cnt_wl[BTC_CNT_WL_2G_FDDSTAY],
+		   coex_sta->cnt_wl[BTC_CNT_WL_2G_TDDTRY],
+		   ((coex_sta->wl_blacklist_ap) ? "Yes": "No"));
+	CL_PRINTF(cli_buf);
