+		if (conf->vo_vi > 0xFFFF)
+			conf->vo_vi = 0xFFFF;
+	}
+	if (arg_num >= 3) {
+		conf->be_bk = input->be_bk / (hal_spec->tx_aclt_unit_factor * 32);
+		if (conf->be_bk > 0xFFFF)
+			conf->be_bk = 0xFFFF;
+	}
