+inline u8 rtl8733b_rcr_config(PADAPTER p, u32 rcr)
+{
+	u32 v32;
+	int err;
+
+
+	v32 = GET_HAL_DATA(p)->ReceiveConfig;
+	v32 ^= rcr;
+	v32 &= BIT_APP_PHYSTS_8733B;
+	if (v32) {
+		v32 = rcr & BIT_APP_PHYSTS_8733B;
+		RTW_INFO("%s: runtime %s rx phy status!\n",
+			 __FUNCTION__, v32 ? "ENABLE" : "DISABLE");
+		if (v32) {
+			err = rtw_halmac_config_rx_info(adapter_to_dvobj(p), HALMAC_DRV_INFO_PHY_STATUS);
+			if (err) {
+				RTW_INFO("%s: Enable rx phy status FAIL!!", __FUNCTION__);
+				rcr &= ~BIT_APP_PHYSTS_8733B;
+			}
+		} else {
+			err = rtw_halmac_config_rx_info(adapter_to_dvobj(p), HALMAC_DRV_INFO_NONE);
+			if (err) {
+				RTW_INFO("%s: Disable rx phy status FAIL!!", __FUNCTION__);
+				rcr |= BIT_APP_PHYSTS_8733B;
+			}
+		}
+	}
+
+	err = rtw_write32(p, REG_RCR_8733B, rcr);
+	if (_FAIL == err)
+		return _FALSE;
+
+	GET_HAL_DATA(p)->ReceiveConfig = rcr;
+	return _TRUE;
+}
+
+inline u8 rtl8733b_rx_ba_ssn_appended(PADAPTER p)
+{
+	return rtw_hal_rcr_check(p, BIT_APP_BASSN_8733B);
+}
+
+inline u8 rtl8733b_rx_fcs_append_switch(PADAPTER p, u8 enable)
+{
+	u32 rcr_bit;
+	u8 ret = _TRUE;
+
+	rcr_bit = BIT_APP_FCS_8733B;
+	if (_TRUE == enable)
+		ret = rtw_hal_rcr_add(p, rcr_bit);
+	else
+		ret = rtw_hal_rcr_clear(p, rcr_bit);
+
+	return ret;
+}
+
+inline u8 rtl8733b_rx_fcs_appended(PADAPTER p)
+{
+	return rtw_hal_rcr_check(p, BIT_APP_FCS_8733B);
+}
+
+inline u8 rtl8733b_rx_tsf_addr_filter_config(PADAPTER p, u8 config)
+{
+	u8 v8;
+	int err;
+
+	v8 = GET_HAL_DATA(p)->rx_tsf_addr_filter_config;
+
+	if (v8 != config) {
+
+		err = rtw_write8(p, REG_NAN_RX_FILTER_8733B, config);
+		if (_FAIL == err)
+			return _FALSE;
+	}
+
+	GET_HAL_DATA(p)->rx_tsf_addr_filter_config = config;
+	return _TRUE;
+}
+
+/*
+ * Return:
+ *	_SUCCESS	Download Firmware OK.
+ *	_FAIL		Download Firmware FAIL!
+ */
+s32 rtl8733b_fw_dl(PADAPTER adapter, u8 wowlan)
+{
+#ifdef CONFIG_NO_FW
+	return _FAIL;
+#else
+	struct dvobj_priv *d = adapter_to_dvobj(adapter);
+	HAL_DATA_TYPE *hal = GET_HAL_DATA(adapter);
+	struct pwrctrl_priv *pwrpriv = adapter_to_pwrctl(adapter);
+	int err;
+	u8 fw_bin = _TRUE;
+
+#ifdef CONFIG_FILE_FWIMG
+#ifdef CONFIG_WOWLAN
+	if (wowlan)
+		rtw_get_phy_file_path(adapter, MAC_FILE_FW_WW_IMG);
+	else
+#endif /* CONFIG_WOWLAN */
+		rtw_get_phy_file_path(adapter, MAC_FILE_FW_NIC);
+
+	if (rtw_is_file_readable(rtw_phy_para_file_path) == _TRUE) {
+		RTW_INFO("%s acquire FW from file:%s\n", __FUNCTION__, rtw_phy_para_file_path);
+		fw_bin = _TRUE;
+	} else
+#endif /* CONFIG_FILE_FWIMG */
+	{
+		RTW_INFO("%s fw source from array\n", __FUNCTION__);
+		fw_bin = _FALSE;
+	}
+
+#ifdef CONFIG_FILE_FWIMG
+	if (_TRUE == fw_bin) {
+		err = rtw_halmac_dlfw_from_file(d, rtw_phy_para_file_path);
+	} else
+#endif /* CONFIG_FILE_FWIMG */
+#ifdef CONFIG_CCV_FW
+	if (hal->version_id.CUTVersion == 2)
+	{
+		#ifdef CONFIG_WOWLAN
+		if (_TRUE == wowlan)
+			err = rtw_halmac_dlfw(d, ccv_array_mp_8733b_fw_wowlan, ccv_array_length_mp_8733b_fw_wowlan);
+		else
+		#endif /* CONFIG_WOWLAN */
+			err = rtw_halmac_dlfw(d, ccv_array_mp_8733b_fw_nic, ccv_array_length_mp_8733b_fw_nic);
+	}
+	else
+#endif
+	{
+		#ifdef CONFIG_WOWLAN
+		if (_TRUE == wowlan)
+			err = rtw_halmac_dlfw(d, array_mp_8733b_fw_wowlan, array_length_mp_8733b_fw_wowlan);
+		else
+		#endif /* CONFIG_WOWLAN */
+			err = rtw_halmac_dlfw(d, array_mp_8733b_fw_nic, array_length_mp_8733b_fw_nic);
+	}
+
+	if (!err) {
+		hal->bFWReady = _TRUE;
+		hal->fw_ractrl = _TRUE;
+		RTW_INFO("%s Download Firmware from %s success\n", __FUNCTION__, (fw_bin) ? "file" : "array");
+		RTW_INFO("%s FW Version:%d SubVersion:%d FW size:%d\n", (wowlan) ? "WOW" : "NIC",
+			hal->firmware_version, hal->firmware_sub_version, hal->firmware_size);
+		return _SUCCESS;
+	} else {
+		hal->bFWReady = _FALSE;
+		hal->fw_ractrl = _FALSE;
+		RTW_ERR("%s Download Firmware from %s failed\n", __FUNCTION__, (fw_bin) ? "file" : "array");
+		return _FAIL;
+	}
+#endif
+}
+
+u8 rtl8733b_get_rx_drv_info_size(struct _ADAPTER *a)
+{
+	struct dvobj_priv *d;
+	u8 size = 80;	/* HALMAC_RX_DESC_DUMMY_SIZE_MAX_88XX */
+	int err = 0;
+
+
+	d = adapter_to_dvobj(a);
+
+	err = rtw_halmac_get_rx_drv_info_sz(d, &size);
+	if (err) {
+		RTW_WARN(FUNC_ADPT_FMT ": Fail to get DRV INFO size!!(err=%d)\n",
+			 FUNC_ADPT_ARG(a), err);
+		size = 80;
+	}
+
+	return size;
+}
+
+u32 rtl8733b_get_tx_desc_size(struct _ADAPTER *a)
+{
+	struct dvobj_priv *d;
+	u32 size = 48;	/* HALMAC_TX_DESC_SIZE_8733B */
+	int err = 0;
+
+
+	d = adapter_to_dvobj(a);
+
+	err = rtw_halmac_get_tx_desc_size(d, &size);
+	if (err) {
+		RTW_WARN(FUNC_ADPT_FMT ": Fail to get TX Descriptor size!!(err=%d)\n",
+			 FUNC_ADPT_ARG(a), err);
+		size = 48;
+	}
+
+	return size;
+}
+
+u32 rtl8733b_get_rx_desc_size(struct _ADAPTER *a)
+{
+	struct dvobj_priv *d;
+	u32 size = 24;	/* HALMAC_RX_DESC_SIZE_8733B */
+	int err = 0;
+
+
+	d = adapter_to_dvobj(a);
+
+	err = rtw_halmac_get_rx_desc_size(d, &size);
+	if (err) {
+		RTW_WARN(FUNC_ADPT_FMT ": Fail to get RX Descriptor size!!(err=%d)\n",
+			 FUNC_ADPT_ARG(a), err);
+		size = 24;
+	}
+
+	return size;
+}
