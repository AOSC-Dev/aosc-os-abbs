+	HAL_DATA_TYPE	*pHalData = GET_HAL_DATA(padapter);
+	struct dvobj_priv *pobj_priv = adapter_to_dvobj(padapter);
+	u8 status = _TRUE;
+
+	RTW_INFO("==> %s\n", __func__);
+
+#ifdef CONFIG_FWLPS_IN_IPS
+	if (_SUCCESS == rtl8733bu_fw_ips_deinit(padapter))
+		goto exit;
+#endif
+
+	hal_deinit_misc(padapter);
+	status = rtl8733b_deinit(padapter);
+	if (status == _FALSE) {
+		RTW_INFO("%s: rtl8733b_hal_deinit fail\n", __func__);
+		return _FAIL;
+	}
+
+#ifdef CONFIG_FWLPS_IN_IPS
+exit:
+#endif
+	RTW_INFO("%s <==\n", __func__);
+	return _SUCCESS;
