# FIXME: /usr/bin/ld: build/librust.a: error adding symbols: file format not recognized
# Disable the Rust part of the linker-plugin-lto to avoid mixing GCC and LLVM IR.
abinfo "Disabling linker-plugin-lto for Rust ..."
export RUSTFLAGS="$RUSTFLAGS -Clinker-plugin-lto=n"

# Note: Build core/alloc from the system rust (-Z build-std) instead of
# rustup's prebuilt std, whose librust.a references an undefined `wcslen`.
abinfo "Building and installing ..."
make ARCH= RELEASE=1 BUILDSTD=1
install -Dvm644 "$SRCDIR"/build/m1n1.bin \
    "$PKGDIR"/usr/lib/asahi-boot/m1n1.bin

abinfo "Installing udev rules for m1n1 serial console ..."
install -Dvm644 "$SRCDIR"/udev/80-m1n1.rules \
     "$PKGDIR"/usr/lib/udev/rules.d/80-m1n1.rules
