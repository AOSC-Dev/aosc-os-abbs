PKGNAME=avd-fw
PKGSEC=libs
PKGDEP=""
BUILDDEP="llvm meson ninja"
PKGDES="Firmware for Apple Video Decoder"

ABTYPE=meson

# Note: These target files are binaries generated by `objcopy`
# from ELF with debug symbols stripped. Also, the debug symbols
# within the binaries would have been meaningless.
ABSPLITDBG=0

# Note: Cross files are needed to set default compiler and specify the host arch
MESON_AFTER=("--cross-file=./llvm.ini")
USECLANG=1

# Note: Only for Apple Silicon Macs.
FAIL_ARCH="!(arm64)"
