From e4e6086061c3554b921ec5ee0e3b2813dbb8968a Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Tue, 22 Sep 2026 02:44:42 +0800
Subject: [PATCH 364/468] RUYI: riscv: dts: thead: retain Lichee Pi 4A USB
 power at handoff

FROM: https://github.com/openRuyi-Project/linux/commit/f5c41d0e7e373d1368cc51a878f934ce020a1be0

Keep HUB_5V and connector VBUS enabled across firmware handoff.
Configure the GPIO1_22 pad without separately claiming its GPIO mux, and
give the AON GPIO4 hub route a line name.

Keep the USB2 PHY out of suspend so hub port-status requests can
complete during enumeration.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../boot/dts/thead/th1520-lichee-pi-4a.dts    | 25 ++++++++++++++-----
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts b/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
index 2a83be6f65e29..3d58ac0589fb4 100644
--- a/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
+++ b/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
@@ -108,6 +108,8 @@ hub_5v: regulator-hub-5v {
 		regulator-max-microvolt = <5000000>;
 		gpio = <&ioexp3 3 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
 	};
 
 	vcc5v_usb: regulator-vcc5v-usb {
@@ -117,10 +119,9 @@ vcc5v_usb: regulator-vcc5v-usb {
 		regulator-max-microvolt = <5000000>;
 		gpio = <&gpio1 22 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
-		/*
-		 * Workaround for Linux currently being not able to power on
-		 * Vbus for USB Type-A connectors.
-		 */
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_vbus_pins>;
+		regulator-boot-on;
 		regulator-always-on;
 	};
 
@@ -230,11 +231,11 @@ usb_a_4_ss_ep: endpoint {
 };
 
 &aogpio {
-	/* Route USB2 to the onboard hub for normal operation */
-	sel-usb-hub-hog {
+	usb-hub-select-hog {
 		gpio-hog;
 		gpios = <4 GPIO_ACTIVE_HIGH>;
 		output-high;
+		line-name = "usb-hub-select";
 	};
 };
 
@@ -405,8 +406,20 @@ &uart0 {
 	status = "okay";
 };
 
+&padctrl1_apsys {
+	usb_vbus_pins: usb-vbus-0 {
+		usb-pins {
+			pins = "GPIO1_22";
+			bias-disable;
+			drive-strength = <7>;
+			input-disable;
+		};
+	};
+};
+
 &usb {
 	dr_mode = "host";
+	snps,dis_u2_susphy_quirk;
 	#address-cells = <1>;
 	#size-cells = <0>;
 	status = "okay";
-- 
