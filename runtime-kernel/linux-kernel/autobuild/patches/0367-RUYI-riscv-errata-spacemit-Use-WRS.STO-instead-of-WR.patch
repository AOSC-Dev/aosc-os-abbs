index 0000000000000..6278c389b801e
--- /dev/null
+++ b/arch/riscv/errata/spacemit/Makefile
@@ -0,0 +1,5 @@
+ifdef CONFIG_RISCV_ALTERNATIVE_EARLY
+CFLAGS_errata.o := -mcmodel=medany
