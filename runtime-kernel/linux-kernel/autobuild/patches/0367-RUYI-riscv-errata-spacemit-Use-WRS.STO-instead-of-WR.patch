From 77be9900c92f2329210cfd206d5769e25b681a3a Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 11 Nov 2026 01:06:45 +0800
Subject: [PATCH 367/468] RUYI: riscv: errata: spacemit: Use WRS.STO instead of
 WRS.NTO on K3

FROM: https://github.com/openRuyi-Project/linux/commit/9299796710eaba7d0a71c58d8516582829cdb44c

The A100 cores of the SpacemiT K3 SoC sometimes fail to wake up from
WRS.NTO in __cmpwait(), which leaves the waiting CPU stuck.

Add SpacemiT errata support and replace WRS.NTO with WRS.STO, which
also returns after a short timeout. Errata are probed on the boot hart
only and the kernel text is shared by all harts, so match both the
X100 and the A100 cores of K3: Linux may boot on either type, and all
cores run the patched code.

This replaces the vendor fix, which switched to WRS.STO at build time
whenever CONFIG_SOC_SPACEMIT_K3 is enabled.

Link: https://github.com/spacemit-com/linux-6.18/commit/9ecd8c29b445b4c1883722551380ea5093562f96
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/Kconfig.errata                    | 22 ++++++
 arch/riscv/errata/Makefile                   |  1 +
 arch/riscv/errata/spacemit/Makefile          |  5 ++
 arch/riscv/errata/spacemit/errata.c          | 71 ++++++++++++++++++++
 arch/riscv/include/asm/alternative.h         |  3 +
 arch/riscv/include/asm/cmpxchg.h             |  8 +--
 arch/riscv/include/asm/errata_list.h         |  5 ++
 arch/riscv/include/asm/errata_list_vendors.h |  5 ++
 arch/riscv/include/asm/vendorid_list.h       |  1 +
 arch/riscv/kernel/alternative.c              |  5 ++
 10 files changed, 122 insertions(+), 4 deletions(-)
 create mode 100644 arch/riscv/errata/spacemit/Makefile
 create mode 100644 arch/riscv/errata/spacemit/errata.c

diff --git a/arch/riscv/Kconfig.errata b/arch/riscv/Kconfig.errata
index 524a32971cba6..8ce30d2821dd3 100644
--- a/arch/riscv/Kconfig.errata
+++ b/arch/riscv/Kconfig.errata
@@ -186,4 +186,26 @@ config ERRATA_THEAD_WRITE_ONCE
 	  This will apply the WRITE_ONCE errata to handle the non-standard beh-
 	  avior via appending a fence w.o instruction for WRITE_ONCE().
 
+config ERRATA_SPACEMIT
+	bool "SpacemiT errata"
+	depends on 64BIT
+	help
+	  All SpacemiT errata Kconfig depend on this Kconfig. Disabling
+	  this Kconfig will disable all SpacemiT errata. Please say "Y"
+	  here if your platform uses SpacemiT CPU cores.
+
+	  Otherwise, please say "N" here to avoid unnecessary overhead.
+
+config ERRATA_SPACEMIT_WRS_NTO
+	bool "Use WRS.STO instead of WRS.NTO on SpacemiT K3"
+	depends on ERRATA_SPACEMIT && RISCV_ISA_ZAWRS
+	default y
+	help
+	  The A100 cores of the SpacemiT K3 SoC sometimes fail to wake up
+	  from WRS.NTO. Use WRS.STO, which also returns after a short
+	  timeout, instead. As the kernel text is shared by all cores, this
+	  also applies to the X100 cores of K3.
+
+	  If you don't know what to do here, say "Y".
+
 endmenu # "CPU errata selection"
