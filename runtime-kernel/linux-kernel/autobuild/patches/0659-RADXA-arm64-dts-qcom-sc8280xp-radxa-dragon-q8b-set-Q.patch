From 859e4a972587336fc72fe5d82ef377f6cd3923d3 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Wed, 22 Apr 2026 23:36:09 +0800
Subject: [PATCH 659/823] RADXA: arm64: dts: qcom: sc8280xp-radxa-dragon-q8b:
 set QCA8081 LEDs to mode 2

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
index d3e68d5cf9d0b..2e1c7e49fc997 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
@@ -924,6 +924,7 @@ mdio {
 					qps615_phy0: ethernet-phy@1c {
 						compatible = "ethernet-phy-id004d.d101";
 						reg = <0x1c>;
+						qca,led-mode = <2>;
 
 						leds {
 							#address-cells = <1>;
@@ -962,6 +963,7 @@ mdio {
 					qps615_phy1: ethernet-phy@1c {
 						compatible = "ethernet-phy-id004d.d101";
 						reg = <0x1c>;
+						qca,led-mode = <2>;
 
 						leds {
 							#address-cells = <1>;
-- 
2.52.0

