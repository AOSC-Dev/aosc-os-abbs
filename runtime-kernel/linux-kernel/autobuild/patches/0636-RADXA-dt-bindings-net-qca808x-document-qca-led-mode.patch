From f9a5a0d0e70c81564dd690a10bfaf802055730dc Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Wed, 22 Apr 2026 23:35:58 +0800
Subject: [PATCH 636/820] RADXA: dt-bindings: net: qca808x: document
 qca,led-mode

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 .../devicetree/bindings/net/qca,qca808x.yaml         | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/qca,qca808x.yaml b/Documentation/devicetree/bindings/net/qca,qca808x.yaml
index e2552655902a3..8496722f318c9 100644
--- a/Documentation/devicetree/bindings/net/qca,qca808x.yaml
+++ b/Documentation/devicetree/bindings/net/qca,qca808x.yaml
@@ -25,6 +25,17 @@ properties:
     enum:
       - ethernet-phy-id004d.d101
 
+  qca,led-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: |
+      Select one of the vendor-defined LED preset modes described in the
+      datasheet. The selected mode programs the MMD7 LED control registers for
+      all three PHY LED outputs during PHY initialization.
+    enum:
+      - 1
+      - 2
+      - 3
+
 unevaluatedProperties: false
 
 examples:
@@ -38,6 +49,7 @@ examples:
         ethernet-phy@0 {
             compatible = "ethernet-phy-id004d.d101";
             reg = <0>;
+            qca,led-mode = <2>;
 
             leds {
                 #address-cells = <1>;
-- 
2.52.0

