From 1a7fcc2ed985d8083c70b738bea8d320729d1774 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Tue, 19 May 2026 23:25:59 +0800
Subject: [PATCH 813/823] RADXA: arm64: dts: qcom: sc8280xp-radxa-dragon-q8b:
 Add missing properties of the eeprom

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
index 8adef1fdd0d39..89c9afdabab08 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
@@ -733,10 +733,11 @@ &i2c12 {
 	status = "okay";
 
 	eeprom@50 {
-		status = "okay";
-		compatible = "atmel,24c16";
+		compatible = "belling,bl24c16f", "atmel,24c16";
 		reg = <0x50>;
 		pagesize = <16>;
+		vcc-supply = <&vreg_s10b>;
+		wp-gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
 	};
 
 	rtc@68 {
-- 
2.52.0

