From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kexy Biscuit <kexybiscuit@aosc.io>
Date: Sat, 25 Jul 2026 13:23:07 +0800
Subject: [PATCH] AOSCOS: certs: place certificate list size symbols before
 the list

On MIPS, the GNU assembler moves any label defined immediately before
an alignment directive down to the aligned address ("pulls down any
immediately preceding label to the aligned address", see s_align()
in gas/config/tc-mips.c).

In certs/system_certificates.S, __cert_list_end sits right before an
".align 8", so it is moved past the zero alignment padding (up to 255
bytes on MIPS, where ".align 8" requests a 256-byte alignment) and
system_certificate_list_size ends up covering the padding as well.
At boot, x509_load_certificate_list() walks off the last certificate
into the padding and complains:

    Loaded X.509 cert 'Build time autogenerated kernel key: ...'
    Problem parsing in-kernel X.509 certificate list

This was verified on linux-kernel-7.0.13-2 for loongson3, where
system_certificate_list_size is 1536 while the only embedded
certificate is 1324 bytes long.  The message is harmless but noisy.

Move the size symbols (and their alignment directives) ahead of the
certificate lists, so that the end-of-list labels are never followed
by an alignment directive, on any architecture.  The forward
references in the size expressions are resolved at assembly time.
certs/revocation_certificates.S shares the same pattern and is
reordered too.

This commit is authored with assistance from AI/LLM:

- Model: Kimi K3 (Moonshot AI)
- Platform: Moonshot AI (https://www.moonshot.ai/)
- Agent platform: Kimi Code CLI
  (https://github.com/MoonshotAI/kimi-cli)
- Prompt:
  Investigate the "Problem parsing in-kernel X.509 certificate
  list" error seen on the loongson3 kernel build (dmesg log and
  the linux-kernel-7.0.13-2 package provided, kernel source tree
  matching the running kernel), find the root cause, then prepare
  three independent patches for the proposed fix options following
  the AOSC AI-tool usage and disclosure guidelines.

Assisted-by: Kimi-Code-CLI:Kimi-K3
---
 certs/revocation_certificates.S |   20 ++++++++++++-------
 certs/system_certificates.S     |   42 ++++++++++++++++++++++-----------------
 2 files changed, 37 insertions(+), 25 deletions(-)

diff --git a/certs/revocation_certificates.S b/certs/revocation_certificates.S
index f21aae8a8f0e..fe517ede18a8 100644
--- a/certs/revocation_certificates.S
+++ b/certs/revocation_certificates.S
@@ -4,13 +4,12 @@
 
 	__INITRODATA
 
-	.align 8
-	.globl revocation_certificate_list
-revocation_certificate_list:
-__revocation_list_start:
-	.incbin "certs/x509_revocation_list"
-__revocation_list_end:
-
+	/*
+	 * Keep the size symbol ahead of the certificate list: on some
+	 * targets (e.g. MIPS) the assembler moves a label defined right
+	 * before an alignment directive past the alignment padding, which
+	 * would inflate __revocation_list_end by the padding size.
+	 */
 	.align 8
 	.globl revocation_certificate_list_size
 revocation_certificate_list_size:
@@ -19,3 +18,10 @@ revocation_certificate_list_size:
 #else
 	.long __revocation_list_end - __revocation_list_start
 #endif
+
+	.align 8
+	.globl revocation_certificate_list
+revocation_certificate_list:
+__revocation_list_start:
+	.incbin "certs/x509_revocation_list"
+__revocation_list_end:
diff --git a/certs/system_certificates.S b/certs/system_certificates.S
index 003e25d4a17e..52bd3195a24d 100644
--- a/certs/system_certificates.S
+++ b/certs/system_certificates.S
@@ -4,6 +4,30 @@
 
 	__INITRODATA
 
+	/*
+	 * Keep the size symbols ahead of the certificate list: on some
+	 * targets (e.g. MIPS) the assembler moves a label defined right
+	 * before an alignment directive past the alignment padding, which
+	 * would inflate __cert_list_end by the padding size.
+	 */
+	.align 8
+	.globl system_certificate_list_size
+system_certificate_list_size:
+#ifdef CONFIG_64BIT
+	.quad __cert_list_end - __cert_list_start
+#else
+	.long __cert_list_end - __cert_list_start
+#endif
+
+	.align 8
+	.globl module_cert_size
+module_cert_size:
+#ifdef CONFIG_64BIT
+	.quad __module_cert_end - __module_cert_start
+#else
+	.long __module_cert_end - __module_cert_start
+#endif
+
 	.align 8
 	.globl system_certificate_list
 system_certificate_list:
@@ -26,21 +50,3 @@ system_extra_cert_used:
 	.int 0
 
 #endif /* CONFIG_SYSTEM_EXTRA_CERTIFICATE */
-
-	.align 8
-	.globl system_certificate_list_size
-system_certificate_list_size:
-#ifdef CONFIG_64BIT
-	.quad __cert_list_end - __cert_list_start
-#else
-	.long __cert_list_end - __cert_list_start
-#endif
-
-	.align 8
-	.globl module_cert_size
-module_cert_size:
-#ifdef CONFIG_64BIT
-	.quad __module_cert_end - __module_cert_start
-#else
-	.long __module_cert_end - __module_cert_start
-#endif
