From f224e4f435698f86508122814f15cf0f0d1ed7b3 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Fri, 15 May 2026 16:29:45 +0800
Subject: [PATCH 806/823] RADXA: drm/msm/dp: Support DCI-P3 RGB colorspace

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/gpu/drm/msm/dp/dp_drm.c   | 4 +++-
 drivers/gpu/drm/msm/dp/dp_panel.c | 5 +++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_drm.c b/drivers/gpu/drm/msm/dp/dp_drm.c
index 0cb1ae061a76e..8032167abbe0a 100644
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -17,7 +17,9 @@
 #include "dp_audio.h"
 #include "dp_drm.h"
 
-#define MSM_DP_SUPPORTED_COLORSPACES BIT(DRM_MODE_COLORIMETRY_BT2020_RGB)
+#define MSM_DP_SUPPORTED_COLORSPACES \
+	(BIT(DRM_MODE_COLORIMETRY_BT2020_RGB) | \
+	 BIT(DRM_MODE_COLORIMETRY_DCI_P3_RGB_D65))
 
 /**
  * msm_dp_bridge_get_modes - callback to add drm modes via drm_mode_probed_add()
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index f23e7bf17324f..6cea1c3f07cb2 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -1054,6 +1054,7 @@ static bool msm_dp_panel_colorspace_needs_vsc_sdp(enum drm_colorspace colorspace
 {
 	switch (colorspace) {
 	case DRM_MODE_COLORIMETRY_BT2020_RGB:
+	case DRM_MODE_COLORIMETRY_DCI_P3_RGB_D65:
 		return true;
 	default:
 		return false;
@@ -1071,6 +1072,10 @@ static void msm_dp_panel_set_vsc_sdp_colorimetry(struct drm_dp_vsc_sdp *vsc_sdp_
 			vsc_sdp_data->colorimetry = DP_COLORIMETRY_BT2020_RGB;
 		vsc_sdp_data->dynamic_range = DP_DYNAMIC_RANGE_CTA;
 		break;
+	case DRM_MODE_COLORIMETRY_DCI_P3_RGB_D65:
+		vsc_sdp_data->colorimetry = DP_COLORIMETRY_DCI_P3_RGB;
+		vsc_sdp_data->dynamic_range = DP_DYNAMIC_RANGE_VESA;
+		break;
 	default:
 		vsc_sdp_data->colorimetry = DP_COLORIMETRY_DEFAULT;
 		vsc_sdp_data->dynamic_range =
-- 
