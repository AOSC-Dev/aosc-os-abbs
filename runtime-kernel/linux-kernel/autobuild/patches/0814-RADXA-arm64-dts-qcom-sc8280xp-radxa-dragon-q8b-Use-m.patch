From 257103e813889bd5d56987052aafd5988b289583 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Tue, 19 May 2026 23:33:35 +0800
Subject: [PATCH 814/820] RADXA: arm64: dts: qcom: sc8280xp-radxa-dragon-q8b:
 Use mac addresses from eeprom

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 .../dts/qcom/sc8280xp-radxa-dragon-q8b.dts    | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
index 89c9afdabab08..d6d9a3ac3e068 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
@@ -738,6 +738,20 @@ eeprom@50 {
 		pagesize = <16>;
 		vcc-supply = <&vreg_s10b>;
 		wp-gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
+
+		nvmem-layout {
+			compatible = "fixed-layout";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			mac_addr0: mac-address@9e {
+				reg = <0x9e 0x6>;
+			};
+
+			mac_addr1: mac-address@a4 {
+				reg = <0xa4 0x6>;
+			};
+		};
 	};
 
 	rtc@68 {
@@ -951,6 +965,9 @@ tc956x_emac0: pci@0,0 {
 				phy-mode = "sgmii";
 				phy-handle = <&tc956x_emac0_phy>;
 
+				nvmem-cells = <&mac_addr0>;
+				nvmem-cell-names = "mac-address";
+
 				mdio {
 					compatible = "snps,dwmac-mdio";
 					#address-cells = <1>;
@@ -999,6 +1016,9 @@ pci@0,1 {
 				phy-mode = "sgmii";
 				phy-handle = <&tc956x_emac1_phy>;
 
+				nvmem-cells = <&mac_addr1>;
+				nvmem-cell-names = "mac-address";
+
 				mdio {
 					compatible = "snps,dwmac-mdio";
 					#address-cells = <1>;
-- 
2.52.0

