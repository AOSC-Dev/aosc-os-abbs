From 86d76ed96b4da7ba9f1c0442dca82c96d62ad0f2 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Fri, 9 Oct 2026 17:24:43 +0800
Subject: [PATCH 356/468] RUYI: riscv: dts: spacemit: add K3 GPU node and
 display power domains

FROM: https://github.com/openRuyi-Project/linux/commit/1c1d5b23b670b799d8e3b688a4d05d66dc3b2a4a

Add the PowerVR BXM-4-64 GPU with its registers, interrupt, clock, reset
and APMU power domain. Leave it disabled for boards to enable.

Assign the existing GPU core clock a default rate of 1228.8 MHz, the
PLL1 / 2 output corresponding to the highest vendor GPU OPP. The
PowerVR driver enables the clock without selecting a rate, so request
it through assigned-clocks and assigned-clock-rates. Keep the shared
A100/M1 supply configuration unchanged.

Connect DPU0/eDP0 to LCD0 and DPU1/DP1 to LCD1 so genpd manages the
power domain shared by each display pair.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/spacemit/k3-display.dtsi |  5 +++++
 arch/riscv/boot/dts/spacemit/k3.dtsi         | 14 ++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/arch/riscv/boot/dts/spacemit/k3-display.dtsi b/arch/riscv/boot/dts/spacemit/k3-display.dtsi
index b77b68d68c84c..98cc4e47cfe3f 100644
--- a/arch/riscv/boot/dts/spacemit/k3-display.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k3-display.dtsi
@@ -9,6 +9,7 @@
 #include <dt-bindings/clock/spacemit,k3-clocks.h>
 #include <dt-bindings/reset/spacemit,k3-resets.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/power/spacemit,k3-power.h>
 
 &soc {
 	dpu0_crtc0: dpu@c0340000 {
@@ -30,6 +31,7 @@ dpu0_crtc0: dpu@c0340000 {
 			 <&syscon_apmu RESET_APMU_LCD_DSCCLK>;
 		reset-names = "mclk", "lcd", "esc",
 			      "aclk", "dsc";
+		power-domains = <&syscon_apmu K3_PMDOMAIN_LCD0>;
 		status = "disabled";
 
 		ports {
@@ -54,6 +56,7 @@ edp0: edp@cac84000 {
 		resets = <&syscon_apmu RESET_APMU_EDP0>;
 		phys = <&edp0_phy>;
 		phy-names = "dp";
+		power-domains = <&syscon_apmu K3_PMDOMAIN_LCD0>;
 		status = "disabled";
 
 		edp0_phy: phy {
@@ -101,6 +104,7 @@ dpu1_crtc0: dpu@c0440000 {
 			 <&syscon_apmu RESET_APMU_DSI4LN2_LCD_DSCCLK>;
 		reset-names = "mclk", "lcd", "esc",
 			      "aclk", "dsc";
+		power-domains = <&syscon_apmu K3_PMDOMAIN_LCD1>;
 		status = "disabled";
 
 		ports {
@@ -125,6 +129,7 @@ dp1: dp@cac88000 {
 		resets = <&syscon_apmu RESET_APMU_EDP1>;
 		phys = <&dp1_phy>;
 		phy-names = "dp";
+		power-domains = <&syscon_apmu K3_PMDOMAIN_LCD1>;
 		status = "disabled";
 
 		dp1_phy: phy {
diff --git a/arch/riscv/boot/dts/spacemit/k3.dtsi b/arch/riscv/boot/dts/spacemit/k3.dtsi
index d9867a074917d..aeb4d3c21483f 100644
--- a/arch/riscv/boot/dts/spacemit/k3.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k3.dtsi
@@ -8,6 +8,7 @@
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/reset/spacemit,k3-resets.h>
 #include <dt-bindings/phy/phy.h>
+#include <dt-bindings/power/spacemit,k3-power.h>
 
 #include "k3-pdma.h"
 
@@ -787,6 +788,19 @@ opp-1 {
 			};
 		};
 
+		gpu: gpu@cac00000 {
+			compatible = "spacemit,k3-gpu", "img,img-bxm-4-64", "img,img-rogue";
+			reg = <0x0 0xcac00000 0x0 0x80000>;
+			interrupts = <75 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&syscon_apmu CLK_APMU_GPU>;
+			clock-names = "core";
+			assigned-clocks = <&syscon_apmu CLK_APMU_GPU>;
+			assigned-clock-rates = <1228800000>;
+			resets = <&syscon_apmu RESET_APMU_GPU>;
+			power-domains = <&syscon_apmu K3_PMDOMAIN_GPU>;
+			status = "disabled";
+		};
+
 		eth0: ethernet@cac80000 {
 			compatible = "spacemit,k3-dwmac", "snps,dwmac-5.40a";
 			reg = <0x0 0xcac80000 0x0 0x2000>;
-- 
2.56.0

