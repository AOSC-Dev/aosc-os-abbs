From 3d81168361d2b0dca771a83a88de91f9e5d36dcf Mon Sep 17 00:00:00 2001
From: Rong Zhang <i@rong.moe>
Date: Fri, 13 Nov 2026 16:55:08 +0800
Subject: [PATCH 467/468] AOSCOS: MIPS: mm: Provide {pte,pmd}_protnone() when
 ARCH_HAS_PTE_PROTNONE

The Fixes: commit selected ARCH_HAS_PTE_PROTNONE for 64-bit MIPS kernel,
but only provided {pte,pmd}_protnone() when NUMA_BALANCING is enabled,
causing build failure with !NUMA_BALANCING.

Fix it by always providing {pte,pmd}_protnone() as long as
ARCH_HAS_PTE_PROTNONE is selected.

Fixes: "BACKPORT: FROMLIST: mips/mm: Add NUMA balancing support"
Signed-off-by: Rong Zhang <i@rong.moe>
---
 arch/mips/include/asm/pgtable.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/mips/include/asm/pgtable.h b/arch/mips/include/asm/pgtable.h
index 66497e063fce1..4de2f2bef3af5 100644
--- a/arch/mips/include/asm/pgtable.h
+++ b/arch/mips/include/asm/pgtable.h
@@ -746,7 +746,7 @@ static inline pmd_t pmdp_huge_get_and_clear(struct mm_struct *mm,
 
 #endif /* CONFIG_TRANSPARENT_HUGEPAGE */
 
-#ifdef CONFIG_NUMA_BALANCING
+#ifdef CONFIG_ARCH_HAS_PTE_PROTNONE
 static inline long pte_protnone(pte_t pte)
 {
 	return (pte_val(pte) & _PAGE_PROTNONE);
@@ -756,7 +756,7 @@ static inline long pmd_protnone(pmd_t pmd)
 {
 	return (pmd_val(pmd) & _PAGE_PROTNONE);
 }
-#endif /* CONFIG_NUMA_BALANCING */
+#endif /* CONFIG_ARCH_HAS_PTE_PROTNONE */
 
 #ifdef _PAGE_HUGE
 #define pmd_leaf(pmd)	((pmd_val(pmd) & _PAGE_HUGE) != 0)
-- 
2.56.0

