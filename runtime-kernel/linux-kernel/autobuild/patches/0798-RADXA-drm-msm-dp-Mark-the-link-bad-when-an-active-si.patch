From 0ac6a48c67795f0d400e09e08522f34c239d9b69 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Thu, 14 May 2026 17:13:21 +0800
Subject: [PATCH 798/823] RADXA: drm/msm/dp: Mark the link bad when an active
 sink is replugged

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 2e5f0cfc7a4db..cefd084b779f1 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -385,12 +385,14 @@ static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
 {
 	int ret;
 	struct platform_device *pdev = dp->msm_dp_display.pdev;
+	bool was_plugged;
 
 	drm_dbg_dp(dp->drm_dev, "Before, type=%d sink_count=%d\n",
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
 
 	mutex_lock(&dp->plugged_lock);
+	was_plugged = dp->plugged;
 
 	ret = pm_runtime_resume_and_get(&pdev->dev);
 	if (ret) {
@@ -405,6 +407,10 @@ static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
 
 	ret = msm_dp_display_process_hpd_high(dp);
 
+	if (!ret && dp->msm_dp_display.power_on && !was_plugged)
+		drm_connector_set_link_status_property(dp->msm_dp_display.connector,
+						       DRM_MODE_LINK_STATUS_BAD);
+
 	drm_dbg_dp(dp->drm_dev, "After, type=%d sink_count=%d\n",
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
-- 
