From 78d5e059a7f12a62040b60fd1be81366e8375bcd Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Sat, 9 May 2026 14:15:50 +0800
Subject: [PATCH 736/823] RADXA: dt-bindings: PCI: toshiba,tc9563: Add AXI
 half-frequency property

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 Documentation/devicetree/bindings/pci/toshiba,tc9563.yaml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/Documentation/devicetree/bindings/pci/toshiba,tc9563.yaml b/Documentation/devicetree/bindings/pci/toshiba,tc9563.yaml
index fae4660647809..2dc259052cbc6 100644
--- a/Documentation/devicetree/bindings/pci/toshiba,tc9563.yaml
+++ b/Documentation/devicetree/bindings/pci/toshiba,tc9563.yaml
@@ -52,6 +52,12 @@ properties:
       - description: Phandle to the I2C controller node
       - description: I2C slave address
 
+  toshiba,axi-bus-frequency-half:
+    type: boolean
+    description:
+      Change the internal AXI bus frequency from the default 250 MHz to
+      125 MHz for better power efficiency when no 10Gbps Ethernet is needed.
+
 patternProperties:
   "^pcie@[1-3],0$":
     description:
@@ -133,6 +139,8 @@ examples:
 
                 resx-gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
 
+                toshiba,axi-bus-frequency-half;
+
                 pcie@1,0 {
                     compatible = "pciclass,0604";
                     reg = <0x20800 0x0 0x0 0x0 0x0>;
-- 
2.52.0

