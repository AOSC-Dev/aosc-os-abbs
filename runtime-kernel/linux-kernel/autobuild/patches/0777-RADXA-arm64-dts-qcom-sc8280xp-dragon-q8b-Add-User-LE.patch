From c829c1ca7067a1e73dad5836cc95902e8ce26ead Mon Sep 17 00:00:00 2001
From: Stephen Chen <stephen@radxa.com>
Date: Wed, 22 Apr 2026 20:20:34 +0800
Subject: [PATCH 777/820] RADXA: arm64: dts: qcom: sc8280xp: dragon-q8b: Add
 User LED

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 .../dts/qcom/sc8280xp-radxa-dragon-q8b.dts    | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
index 514e44f98174b..4e5997f93f29c 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b.dts
@@ -6,6 +6,7 @@
 /dts-v1/;
 
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 
 #include "sc8280xp.dtsi"
@@ -427,6 +428,19 @@ vph_pwr: regulator-vph-pwr {
 		regulator-always-on;
 		regulator-boot-on;
 	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&user_led>;
+		pinctrl-names = "default";
+
+		user-led {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 4 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
 };
 
 &apps_rsc {
@@ -1877,4 +1891,10 @@ reset-pins {
 			bias-disable;
 		};
 	};
+
+	user_led: user-led-state {
+		pins = "gpio4";
+		function = "gpio";
+		bias-pull-up;
+	};
 };
-- 
2.52.0

