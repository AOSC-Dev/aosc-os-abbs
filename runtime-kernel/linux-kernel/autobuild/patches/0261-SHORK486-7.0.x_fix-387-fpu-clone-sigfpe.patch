From d35f2a18ceb06edbeecf129da44013d350f721cc Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Sat, 7 Nov 2026 18:37:01 +0800
Subject: [PATCH 261/344] SHORK486: 7.0.x_fix-387-fpu-clone-sigfpe

Link: https://github.com/SharktasticA/SHORK-486/blob/ec128badd66d5452de6091ee479efa6ea5277370/shork-486/patches/linux/7.0.x/7.0.x_fix-387-fpu-clone-sigfpe.patch
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/x86/kernel/fpu/core.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/x86/kernel/fpu/core.c b/arch/x86/kernel/fpu/core.c
index 84287003483c2..c1d73bea7a119 100644
--- a/arch/x86/kernel/fpu/core.c
+++ b/arch/x86/kernel/fpu/core.c
@@ -678,7 +678,16 @@ int fpu_clone(struct task_struct *dst, u64 clone_flags, bool minimal,
 	fpstate_reset(dst_fpu);
 
 	if (!cpu_feature_enabled(X86_FEATURE_FPU))
+	{
+		/*
+		 * Patch for SHORK 486:
+		 * Previously, cwd is left zeroed (all exceptions unmasked) instead
+		 * of the masked default. This caused spurious SIGFPE in new threads
+		 * under math emulation.
+		*/
+		fpstate_init_soft(&dst_fpu->fpstate->regs.soft);
 		return 0;
+	}
 
 	/*
 	 * Enforce reload for user space tasks and prevent kernel threads
-- 
2.56.0

