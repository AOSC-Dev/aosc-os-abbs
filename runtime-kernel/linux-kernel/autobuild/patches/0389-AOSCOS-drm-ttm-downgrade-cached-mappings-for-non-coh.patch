From 332998cfe2114e10fdb004bc41836e01aa353132 Mon Sep 17 00:00:00 2001
From: Icenowy Zheng <uwu@icenowy.me>
Date: Sat, 29 Jun 2024 13:22:47 +0800
Subject: [PATCH 389/468] AOSCOS: drm/ttm: downgrade cached mappings for
 non-coherent devices on the linear-IO and single-page paths

Extend the FROMLIST cached -> write_combined downgrade for devices
without full DMA coherency to two paths the posting does not cover:

- ttm_kmap_iter_linear_io_init() also maps cached I/O memory, so
  apply the same downgrade there.
- ttm_bo_kmap_ttm()'s single-page fast path is only valid when the
  device is DMA-coherent; skip it otherwise.

Signed-off-by: Icenowy Zheng <uwu@icenowy.me>
Signed-off-by: Kexy Biscuit <kexybiscuit@aosc.io>
---
 drivers/gpu/drm/ttm/ttm_bo_util.c  | 1 +
 drivers/gpu/drm/ttm/ttm_resource.c | 9 +++++++--
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/ttm/ttm_bo_util.c b/drivers/gpu/drm/ttm/ttm_bo_util.c
index 8352e18b5582c..6027be7580780 100644
--- a/drivers/gpu/drm/ttm/ttm_bo_util.c
+++ b/drivers/gpu/drm/ttm/ttm_bo_util.c
@@ -365,6 +365,7 @@ static int ttm_bo_kmap_ttm(struct ttm_buffer_object *bo,
 		return -EINVAL;
 
 	if (num_pages == 1 && ttm->caching == ttm_cached &&
+	    bo->bdev->dma_coherent &&
 	    !(man->use_tt && (ttm->page_flags & TTM_TT_FLAG_DECRYPTED))) {
 		/*
 		 * We're mapping a single page, and the desired
diff --git a/drivers/gpu/drm/ttm/ttm_resource.c b/drivers/gpu/drm/ttm/ttm_resource.c
index 4e6d3d658d858..1b94d3a183f18 100644
--- a/drivers/gpu/drm/ttm/ttm_resource.c
+++ b/drivers/gpu/drm/ttm/ttm_resource.c
@@ -867,8 +867,13 @@ ttm_kmap_iter_linear_io_init(struct ttm_kmap_iter_linear_io *iter_io,
 			     struct ttm_device *bdev,
 			     struct ttm_resource *mem)
 {
+	enum ttm_caching caching = mem->bus.caching;
 	int ret;
 
+	/* Downgrade cached mapping for non-snooping devices */
+	if (!bdev->dma_coherent && caching == ttm_cached)
+		caching = ttm_write_combined;
+
 	ret = ttm_mem_io_reserve(bdev, mem);
 	if (ret)
 		goto out_err;
@@ -883,11 +888,11 @@ ttm_kmap_iter_linear_io_init(struct ttm_kmap_iter_linear_io *iter_io,
 	} else {
 		iter_io->needs_unmap = true;
 		memset(&iter_io->dmap, 0, sizeof(iter_io->dmap));
-		if (mem->bus.caching == ttm_write_combined)
+		if (caching == ttm_write_combined)
 			iosys_map_set_vaddr_iomem(&iter_io->dmap,
 						  ioremap_wc(mem->bus.offset,
 							     mem->size));
-		else if (mem->bus.caching == ttm_cached)
+		else if (caching == ttm_cached)
 			iosys_map_set_vaddr(&iter_io->dmap,
 					    memremap(mem->bus.offset, mem->size,
 						     MEMREMAP_WB |
