From ee9f16a040f0e5ab494b10a692bcfd16f0652359 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Fri, 12 Jun 2026 16:28:14 +0800
Subject: [PATCH] FLIGHT SYSTEMIO

---
 arch/loongarch/kernel/setup.c | 63 ++++++++++++++++++++---------------
 drivers/acpi/pci_root.c       | 10 ++++--
 2 files changed, 44 insertions(+), 29 deletions(-)

diff --git a/arch/loongarch/kernel/setup.c b/arch/loongarch/kernel/setup.c
index 948263a7b2ccb..4db8e96d79ffb 100644
--- a/arch/loongarch/kernel/setup.c
+++ b/arch/loongarch/kernel/setup.c
@@ -504,35 +504,44 @@ static __init int arch_reserve_pio_range(void)
 {
 	struct device_node *np;
 
-	for_each_node_by_name(np, "isa") {
-		struct of_range range;
-		struct of_range_parser parser;
-
-		pr_info("ISA Bridge: %pOF\n", np);
-
-		if (of_range_parser_init(&parser, np)) {
-			pr_info("Failed to parse resources.\n");
-			of_node_put(np);
-			break;
-		}
-
-		for_each_of_range(&parser, &range) {
-			switch (range.flags & IORESOURCE_TYPE_BITS) {
-			case IORESOURCE_IO:
-				pr_info(" IO 0x%016llx..0x%016llx  ->  0x%016llx\n",
-					range.cpu_addr,
-					range.cpu_addr + range.size - 1,
-					range.bus_addr);
-				if (add_legacy_isa_io(&np->fwnode, range.cpu_addr, range.size))
-					pr_warn("Failed to reserve legacy IO in Logic PIO\n");
-				break;
-			case IORESOURCE_MEM:
-				pr_info(" MEM 0x%016llx..0x%016llx  ->  0x%016llx\n",
-					range.cpu_addr,
-					range.cpu_addr + range.size - 1,
-					range.bus_addr);
+	struct fwnode_handle *fwnode;
+
+	if (!acpi_disabled) {
+		u64 cpu_addr = 0x18000000;
+		fwnode = kzalloc(sizeof(*fwnode), GFP_ATOMIC);
+		if (fwnode)
+			add_legacy_isa_io(fwnode, cpu_addr, ISA_IOSIZE);
+	} else {
+		for_each_node_by_name(np, "isa") {
+			struct of_range range;
+			struct of_range_parser parser;
+
+			pr_info("ISA Bridge: %pOF\n", np);
+
+			if (of_range_parser_init(&parser, np)) {
+				pr_info("Failed to parse resources.\n");
+				of_node_put(np);
 				break;
 			}
+
+			for_each_of_range(&parser, &range) {
+				switch (range.flags & IORESOURCE_TYPE_BITS) {
+				case IORESOURCE_IO:
+					pr_info(" IO 0x%016llx..0x%016llx  ->  0x%016llx\n",
+						range.cpu_addr,
+						range.cpu_addr + range.size - 1,
+						range.bus_addr);
+					if (add_legacy_isa_io(&np->fwnode, range.cpu_addr, range.size))
+						pr_warn("Failed to reserve legacy IO in Logic PIO\n");
+					break;
+				case IORESOURCE_MEM:
+					pr_info(" MEM 0x%016llx..0x%016llx  ->  0x%016llx\n",
+						range.cpu_addr,
+						range.cpu_addr + range.size - 1,
+						range.bus_addr);
+					break;
+				}
+			}
 		}
 	}
 
diff --git a/drivers/acpi/pci_root.c b/drivers/acpi/pci_root.c
index f5baec5fa772d..f561c88e67e9f 100644
--- a/drivers/acpi/pci_root.c
+++ b/drivers/acpi/pci_root.c
@@ -876,8 +876,14 @@ static void acpi_pci_root_remap_iospace(struct acpi_device *device,
 		goto err;
 	}
 
-	if (pci_register_io_range(&device->fwnode, cpu_addr, length))
-		goto err;
+	if (pci_register_io_range(&device->fwnode, cpu_addr, length)) {
+		res->start += ISA_IOSIZE;
+		cpu_addr = res->start;
+		pci_addr = cpu_addr - entry->offset;
+		length = resource_size(res);
+		if (pci_register_io_range(&device->fwnode, cpu_addr, length))
+			goto err;
+	}
 
 	port = pci_address_to_pio(cpu_addr);
 	if (port == (unsigned long)-1)
-- 
2.52.0

