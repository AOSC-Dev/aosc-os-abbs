From 842cb02450ae87126736d7dd72dbec8154d7947b Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Thu, 3 Sep 2026 22:46:07 +0200
Subject: [PATCH 534/634] IA64: mm: re-export declaration of insert_vm_struct()

Commit 775659f8fc14 ("mm/vma: make vma_set_range() static, drop
insert_vm_struct() decl") removed the declaration of insert_vm_struct()
in include/linux/mm.h, making it a purely mm-internal function.

Partially revert the commit to restore the function's visibility, as it
is used by ia64's arch/ia64/mm/init.c.

Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 include/linux/mm.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/linux/mm.h b/include/linux/mm.h
index 45dd32cc41797..cb20c0afc3d9b 100644
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -4214,6 +4214,8 @@ void anon_rmap_tree_verify(struct anon_vma_chain *avc);
 
 /* mmap.c */
 extern int __vm_enough_memory(const struct mm_struct *mm, long pages, int cap_sys_admin);
+/* Also declared in mm/vma.h; ia64 is the only user outside of mm. */
+extern int insert_vm_struct(struct mm_struct *, struct vm_area_struct *);
 extern void exit_mmap(struct mm_struct *);
 bool mmap_read_lock_maybe_expand(struct mm_struct *mm, struct vm_area_struct *vma,
 				 unsigned long addr, bool write);
