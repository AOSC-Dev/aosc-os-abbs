From 29bc567670f8167cd8e7119acc09234df579e14f Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 7 Oct 2026 01:59:29 +0800
Subject: [PATCH 349/468] RUYI: dt-bindings: display: spacemit: describe the
 shared LCD power domain

FROM: https://github.com/openRuyi-Project/linux/commit/24436d91256aea9fa95a11704424f63c9e9819f2

Allow one power domain on each K3 DPU and DP controller. The display
pipeline shares the same LCD power island.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../bindings/display/spacemit/spacemit,k3-inno-dp.yaml        | 4 ++++
 .../bindings/display/spacemit/spacemit,k3-saturn-dpu.yaml     | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-inno-dp.yaml b/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-inno-dp.yaml
index 491d25730da9f..777785ecf7f2b 100644
--- a/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-inno-dp.yaml
+++ b/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-inno-dp.yaml
@@ -22,6 +22,10 @@ properties:
   reg:
     maxItems: 1
 
+  power-domains:
+    maxItems: 1
+    description: LCD power island shared with the upstream DPU.
+
   interrupts:
     maxItems: 1
     description: Link and hot-plug events.
diff --git a/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-saturn-dpu.yaml b/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-saturn-dpu.yaml
index 97ea9da4b68e4..a634e05dff538 100644
--- a/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-saturn-dpu.yaml
+++ b/Documentation/devicetree/bindings/display/spacemit/spacemit,k3-saturn-dpu.yaml
@@ -22,6 +22,10 @@ properties:
   reg:
     maxItems: 1
 
+  power-domains:
+    maxItems: 1
+    description: LCD power island shared with the downstream display controller.
+
   interrupts:
     items:
       - description: Online (live display) compose path.
-- 
2.56.0

