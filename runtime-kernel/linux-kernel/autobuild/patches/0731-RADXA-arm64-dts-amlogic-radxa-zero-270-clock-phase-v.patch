From 971288bedec771b811b3b37b1ba02b10d658f646 Mon Sep 17 00:00:00 2001
From: Zhaoming Luo <luozhaoming@radxa.com>
Date: Thu, 5 Feb 2026 16:28:47 +0800
Subject: [PATCH 731/820] RADXA: arm64: dts: amlogic: radxa-zero: 270 clock
 phase, via amlogic,mmc-phase

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts b/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts
index b504904a0c5b6..0db435c6ca77d 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts
@@ -10,6 +10,7 @@
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/sound/meson-g12a-tohdmitx.h>
 #include <dt-bindings/usb/pd.h>
+#include <dt-bindings/mmc/meson-gx-mmc.h>
 
 / {
 	compatible = "radxa,zero", "amlogic,g12a";
@@ -498,6 +499,8 @@ &sd_emmc_c {
 	mmc-pwrseq = <&emmc_pwrseq>;
 	vmmc-supply = <&vcc_3v3>;
 	vqmmc-supply = <&vcc_1v8>;
+
+	amlogic,mmc-phase = <CLK_PHASE_270 CLK_PHASE_0 CLK_PHASE_0>;
 };
 
 &tdmif_b {
