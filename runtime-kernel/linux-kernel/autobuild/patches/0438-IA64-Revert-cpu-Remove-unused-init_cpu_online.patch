From: Johnny Mnemonic <jm@machine-hall.org>
Date: Mon, 27 Jan 2025 15:44:13 +0100
Subject: [PATCH 438/634] IA64: Revert "cpu: Remove unused init_cpu_online"

This reverts commit 7f15d4abf925f33015fb62973ce2ddb45ce04bb9.
---
 include/linux/cpumask.h | 1 +
 kernel/cpu.c            | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/include/linux/cpumask.h b/include/linux/cpumask.h
index 4c8bb6953107d..9f41f54b83651 100644
--- a/include/linux/cpumask.h
+++ b/include/linux/cpumask.h
@@ -1151,6 +1151,7 @@ extern const DECLARE_BITMAP(cpu_all_bits, NR_CPUS);
 /* Wrappers for arch boot code to manipulate normally-constant masks */
 void init_cpu_present(const struct cpumask *src);
 void init_cpu_possible(const struct cpumask *src);
+void init_cpu_online(const struct cpumask *src);
 
 #define assign_cpu(cpu, mask, val)	\
 	assign_bit(cpumask_check(cpu), cpumask_bits(mask), (val))
diff --git a/kernel/cpu.c b/kernel/cpu.c
index d3d1cad78f3e7..937f9e363b914 100644
--- a/kernel/cpu.c
+++ b/kernel/cpu.c
@@ -3117,6 +3117,11 @@ void init_cpu_possible(const struct cpumask *src)
 	__num_possible_cpus = cpumask_weight(&__cpu_possible_mask);
 }
 
+void init_cpu_online(const struct cpumask *src)
+{
+	cpumask_copy(&__cpu_online_mask, src);
+}
+
 void set_cpu_online(unsigned int cpu, bool online)
 {
 	/*
