From a670d23f9a5e1bf186328178c5626892975d8f77 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Wed, 6 May 2026 21:12:50 +0800
Subject: [PATCH 675/820] RADXA: dt-bindings: net: qca808x: add wakeup GPIO

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 Documentation/devicetree/bindings/net/qca,qca808x.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/qca,qca808x.yaml b/Documentation/devicetree/bindings/net/qca,qca808x.yaml
index 8496722f318c9..df8ed631388d0 100644
--- a/Documentation/devicetree/bindings/net/qca,qca808x.yaml
+++ b/Documentation/devicetree/bindings/net/qca,qca808x.yaml
@@ -36,10 +36,16 @@ properties:
       - 2
       - 3
 
+  wakeup-gpios:
+    maxItems: 1
+    description:
+      GPIO connected to the active-low INTn_WOL output for Wake-on-LAN.
+
 unevaluatedProperties: false
 
 examples:
   - |
+    #include <dt-bindings/gpio/gpio.h>
     #include <dt-bindings/leds/common.h>
 
     mdio {
@@ -50,6 +56,7 @@ examples:
             compatible = "ethernet-phy-id004d.d101";
             reg = <0>;
             qca,led-mode = <2>;
+            wakeup-gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
 
             leds {
                 #address-cells = <1>;
-- 
2.52.0

