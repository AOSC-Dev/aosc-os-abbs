From 5070709d3bbdd9ee09e3fda5d856f74b7373bae7 Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Mon, 24 Aug 2026 19:37:35 +0200
Subject: [PATCH 521/634] IA64: topology: Fix PAL cache hierarchy off-by-one

PAL indexes cache levels from zero, not from one. This makes the kernel
misread the cache levels of L3 cache on Montecito CPUs, for example, on
a 2x Itanium 9040 system:

    $ lscpu
    ...
    Caches (sum of all):
      L1d:                  64 KiB (4 instances)
      L1i:                  64 KiB (4 instances)
      L2d:                  1 MiB (4 instances)
      L2i:                  8 MiB (8 instances)
      L3:                   72 MiB (8 instances)
    ...

while the Itanium 9040 has 18MB of cache, so it should be reporting 36MB
in total.

Subtract one from the this_leaf->level to pass the right value to the
PAL. As a fallback, mark a cache private if the PAL check fails for
whatever reason.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 arch/ia64/kernel/topology.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/arch/ia64/kernel/topology.c b/arch/ia64/kernel/topology.c
index 741863a187a66..f1e6dfc73f107 100644
--- a/arch/ia64/kernel/topology.c
+++ b/arch/ia64/kernel/topology.c
@@ -137,11 +137,17 @@ static void cache_shared_cpu_map_setup(unsigned int cpu,
 		return;
 	}
 
-	if (ia64_pal_cache_shared_info(this_leaf->level,
+	/*
+	 * PAL_CACHE_SHARED_INFO takes a zero-based cache level, just like
+	 * PAL_CACHE_INFO does, while this_leaf->level is one-based.
+	 */
+	if (ia64_pal_cache_shared_info(this_leaf->level - 1,
 					this_leaf->type,
 					0,
-					&csi) != PAL_STATUS_SUCCESS)
+					&csi) != PAL_STATUS_SUCCESS) {
+		cpumask_set_cpu(cpu, &this_leaf->shared_cpu_map);
 		return;
+	}
 
 	num_shared = (int) csi.num_shared;
 	do {
@@ -153,7 +159,7 @@ static void cache_shared_cpu_map_setup(unsigned int cpu,
 
 		i++;
 	} while (i < num_shared &&
-		ia64_pal_cache_shared_info(this_leaf->level,
+		ia64_pal_cache_shared_info(this_leaf->level - 1,
 				this_leaf->type,
 				i,
 				&csi) == PAL_STATUS_SUCCESS);
