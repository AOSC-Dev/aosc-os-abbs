From 71addd2080329dc6fb10748c36e2404bede6d644 Mon Sep 17 00:00:00 2001
From: Stephen Chen <stephen@radxa.com>
Date: Sat, 25 Apr 2026 18:32:40 +0800
Subject: [PATCH 774/820] RADXA: media: iris: always build iris_platform_gen1
 when IRIS is enabled

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/media/platform/qcom/iris/Makefile | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/Makefile b/drivers/media/platform/qcom/iris/Makefile
index 2abbd3aeb4af0..bbcb64aed5304 100644
--- a/drivers/media/platform/qcom/iris/Makefile
+++ b/drivers/media/platform/qcom/iris/Makefile
@@ -10,6 +10,7 @@ qcom-iris-objs += iris_buffer.o \
              iris_hfi_gen2_packet.o \
              iris_hfi_gen2_response.o \
              iris_hfi_queue.o \
+             iris_platform_gen1.o \
              iris_platform_gen2.o \
              iris_power.o \
              iris_probe.o \
@@ -24,10 +25,6 @@ qcom-iris-objs += iris_buffer.o \
              iris_vpu3x.o \
              iris_vpu4x.o \
              iris_vpu_buffer.o \
-             iris_vpu_common.o \
-
-ifeq ($(CONFIG_VIDEO_QCOM_VENUS),)
-qcom-iris-objs += iris_platform_gen1.o
-endif
+             iris_vpu_common.o
 
 obj-$(CONFIG_VIDEO_QCOM_IRIS) += qcom-iris.o
-- 
2.52.0

