 1 file changed, 1 deletion(-)

diff --git a/arch/mips/kernel/audit-n32.c b/arch/mips/kernel/audit-n32.c
index 1658f833c5a70..0b5a91e99d16c 100644
--- a/arch/mips/kernel/audit-n32.c
