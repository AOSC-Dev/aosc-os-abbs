From 3cfbb3637b5a1428a3ba0f37f9b828a7dc6af5cc Mon Sep 17 00:00:00 2001
From: Troy Mitchell <troy.mitchell@linux.spacemit.com>
Date: Thu, 5 Nov 2026 08:23:50 +0000
Subject: [PATCH 204/468] FROMLIST: riscv: dts: spacemit: k3-com260: Set
 Ethernet MAC from EEPROM

The EEPROM on the K3 CoM260 module stores the board MAC address in its
ONIE TLV data. Assign it to the module's Ethernet controller, so that
every carrier board using the module gets a stable MAC address instead
of a random one.

Signed-off-by: Troy Mitchell <troy.mitchell@linux.spacemit.com>
Link: https://lore.kernel.org/r/20261105-k3-com260-module-sd-nor-mac-v1-5-138b39d74602@linux.spacemit.com
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/spacemit/k3-com260.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/spacemit/k3-com260.dtsi b/arch/riscv/boot/dts/spacemit/k3-com260.dtsi
index c955dab20b39d..e31d2477ac414 100644
--- a/arch/riscv/boot/dts/spacemit/k3-com260.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k3-com260.dtsi
@@ -42,7 +42,7 @@ eeprom@50 {
 		nvmem-layout {
 			compatible = "onie,tlv-layout";
 
-			mac-address {
+			mac_address: mac-address {
 				#nvmem-cell-cells = <1>;
 			};
 
@@ -216,6 +216,8 @@ dldo7: dldo7 {
 };
 
 &eth1 {
+	nvmem-cells = <&mac_address 0>;
+	nvmem-cell-names = "mac-address";
 	pinctrl-names = "default";
 	pinctrl-0 = <&gmac1_rgmii_0_cfg>, <&gmac1_phy_0_cfg>;
 	phy-mode = "rgmii-id";
-- 
