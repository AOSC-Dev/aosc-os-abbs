From b40aa32cf59ce5f3ae5616beb67345642fc265f9 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Wed, 19 Nov 2025 18:45:14 +0800
Subject: [PATCH 606/823] RADXA: r8169: Remove the check of a register to
 enable ASPM on Radxa Dragon Q6A

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/net/ethernet/realtek/r8169_main.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index 58788d196c57d..fdd9fb6c37c33 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -5585,8 +5585,7 @@ static void rtl_init_mac_address(struct rtl8169_private *tp)
 /* register is set if system vendor successfully tested ASPM 1.2 */
 static bool rtl_aspm_is_safe(struct rtl8169_private *tp)
 {
-	if (tp->mac_version >= RTL_GIGA_MAC_VER_46 &&
-	    r8168_mac_ocp_read(tp, 0xc0b2) & 0xf)
+	if (tp->mac_version >= RTL_GIGA_MAC_VER_46)
 		return true;
 
 	return false;
-- 
2.52.0

