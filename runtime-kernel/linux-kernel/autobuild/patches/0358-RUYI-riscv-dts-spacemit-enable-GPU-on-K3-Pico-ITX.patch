From 502c07e9e490cf6c8734bbcbcbb3165d10b119d2 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Fri, 9 Oct 2026 17:24:43 +0800
Subject: [PATCH 358/468] RUYI: riscv: dts: spacemit: enable GPU on K3 Pico ITX

FROM: https://github.com/openRuyi-Project/linux/commit/157e35e685fec9b7780e165c67bd1ebe987adb64

Enable the PowerVR BXM-4-64 GPU on K3 Pico ITX.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/spacemit/k3-pico-itx.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
index df390895e0141..992abde0d179d 100644
--- a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
+++ b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
@@ -61,6 +61,10 @@ rfkill-usb-bt {
 	};
 };
 
+&gpu {
+	status = "okay";
+};
+
 &i2c1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pico_i2c1_cfg>;
-- 
2.56.0

