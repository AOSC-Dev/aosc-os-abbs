From 373d2d2e8334969c6865fb9959ae1daa9153f18b Mon Sep 17 00:00:00 2001
From: Jiali Chen <chenjiali@radxa.com>
Date: Wed, 11 Feb 2026 09:54:55 +0000
Subject: [PATCH 732/823] RADXA: arm64: dts: amlogic: meson-g12: add power
 coefficients

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi | 3 +++
 arch/arm64/boot/dts/amlogic/meson-g12a.dtsi       | 4 ++++
 arch/arm64/boot/dts/amlogic/meson-g12b.dtsi       | 6 ++++++
 3 files changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
index 29ce4bb2f20db..4d01632d09eb1 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
@@ -2521,6 +2521,7 @@ mali: gpu@ffe40000 {
 			resets = <&reset RESET_DVALIN_CAPB3>, <&reset RESET_DVALIN>;
 			operating-points-v2 = <&gpu_opp_table>;
 			#cooling-cells = <2>;
+			dynamic-power-coefficient = <400>;
 		};
 	};
 
@@ -2529,6 +2530,7 @@ cpu_thermal: cpu-thermal {
 			polling-delay = <1000>;
 			polling-delay-passive = <100>;
 			thermal-sensors = <&cpu_temp>;
+			sustainable-power = <3000>; /* 3000mW */
 
 			trips {
 				cpu_passive: cpu-passive {
@@ -2555,6 +2557,7 @@ ddr_thermal: ddr-thermal {
 			polling-delay = <1000>;
 			polling-delay-passive = <100>;
 			thermal-sensors = <&ddr_temp>;
+			sustainable-power = <2000>; /* 2000mW */
 
 			trips {
 				ddr_passive: ddr-passive {
diff --git a/arch/arm64/boot/dts/amlogic/meson-g12a.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12a.dtsi
index 37d493b5aca68..663fcbed1e14c 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12a.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12a.dtsi
@@ -27,6 +27,7 @@ cpu0: cpu@0 {
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpu_opp_table>;
 			clocks = <&clkc CLKID_CPU_CLK>;
+			dynamic-power-coefficient = <140>;
 		};
 
 		cpu1: cpu@1 {
@@ -44,6 +45,7 @@ cpu1: cpu@1 {
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpu_opp_table>;
 			clocks = <&clkc CLKID_CPU_CLK>;
+			dynamic-power-coefficient = <140>;
 		};
 
 		cpu2: cpu@2 {
@@ -61,6 +63,7 @@ cpu2: cpu@2 {
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpu_opp_table>;
 			clocks = <&clkc CLKID_CPU_CLK>;
+			dynamic-power-coefficient = <140>;
 		};
 
 		cpu3: cpu@3 {
@@ -78,6 +81,7 @@ cpu3: cpu@3 {
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpu_opp_table>;
 			clocks = <&clkc CLKID_CPU_CLK>;
+			dynamic-power-coefficient = <140>;
 		};
 
 		l2: l2-cache0 {
diff --git a/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi
index d141882956f60..a1c5ad1105205 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi
@@ -58,6 +58,7 @@ cpu0: cpu@0 {
 			next-level-cache = <&l2_cache_l>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPU_CLK>;
+			dynamic-power-coefficient = <140>;
 		};
 
 		cpu1: cpu@1 {
@@ -75,6 +76,7 @@ cpu1: cpu@1 {
 			next-level-cache = <&l2_cache_l>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPU_CLK>;
+			dynamic-power-coefficient = <140>;
 		};
 
 		cpu100: cpu@100 {
@@ -92,6 +94,7 @@ cpu100: cpu@100 {
 			next-level-cache = <&l2_cache_b>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPUB_CLK>;
+			dynamic-power-coefficient = <430>;
 		};
 
 		cpu101: cpu@101 {
@@ -109,6 +112,7 @@ cpu101: cpu@101 {
 			next-level-cache = <&l2_cache_b>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPUB_CLK>;
+			dynamic-power-coefficient = <430>;
 		};
 
 		cpu102: cpu@102 {
@@ -126,6 +130,7 @@ cpu102: cpu@102 {
 			next-level-cache = <&l2_cache_b>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPUB_CLK>;
+			dynamic-power-coefficient = <430>;
 		};
 
 		cpu103: cpu@103 {
@@ -144,6 +149,7 @@ cpu103: cpu@103 {
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpub_opp_table_1>;
 			clocks = <&clkc CLKID_CPUB_CLK>;
+			dynamic-power-coefficient = <430>;
 		};
 
 		l2_cache_l: l2-cache-cluster0 {
-- 
