 #define PHYTMAC_GFP_FLAGS \
-	(GFP_ATOMIC | __GFP_NOWARN | GFP_DMA | __GFP_DMA32)
+	(GFP_ATOMIC | __GFP_NOWARN | __GFP_DMA32)
 #define PHYTMAC_RX_DMA_ATTR \
 	(DMA_ATTR_SKIP_CPU_SYNC | DMA_ATTR_WEAK_ORDERING)
