From 2a551d931f88957293149be82b8a680c2f332f50 Mon Sep 17 00:00:00 2001
From: Johnny Mnemonic <jm@machine-hall.org>
Date: Sun, 11 Oct 2026 16:10:31 +0200
Subject: [PATCH 546/634] IA64: ia64/hp-sim: deselect HAVE_PERF_EVENTS and fix
 build with empty prototype

7fb18cd8e39ed020cfc7cad67000e5c96c1ae18f selects HAVE_PERF_EVENTS
unconditionally for IA64. hp-sim (i.e. Ski) does not have support for
these, so only select it for non-Ski kernels.

When deselected, there still remain two function calls (introduced with
9c4a79ecc8abd91b7bbdf81729f7df1b3927bddc) for ia64_pmu_switch_task() in
arch/ia64/kernel/process.c that are (1) not guarded and (2) don't have an
empty definition in this case, which breaks the kernel build for Ski:

```
[...]
arch/ia64/kernel/process.c: In function 'ia64_save_extra':
arch/ia64/kernel/process.c:265:17: error: implicit declaration of function 'ia64_pmu_switch_task'; did you mean 'ia64_switch_to'? [-Wimplicit-function-declaration]
  265 |                 ia64_pmu_switch_task(task, 0);
      |                 ^~~~~~~~~~~~~~~~~~~~
      |                 ia64_switch_to
[...]
```

Add an empty definition for ia64_pmu_switch_task() to fix the kernel build
for Ski.

Fixes: 9c4a79ecc8abd91b7bbdf81729f7df1b3927bddc ("ia64: Add a perf_events driver for the IA-64 PMU")
---
 arch/ia64/Kconfig                 | 2 +-
 arch/ia64/include/asm/switch_to.h | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/ia64/Kconfig b/arch/ia64/Kconfig
index 6f08ed9fb2d55..0af40a068f0ad 100644
--- a/arch/ia64/Kconfig
+++ b/arch/ia64/Kconfig
@@ -36,7 +36,7 @@ config IA64
 	select HAVE_FTRACE_MCOUNT_RECORD
 	select HAVE_DYNAMIC_FTRACE if (!ITANIUM)
 	select HAVE_FUNCTION_TRACER
-	select HAVE_PERF_EVENTS
+	select HAVE_PERF_EVENTS if (!IA64_HP_SIM)
 	select HAVE_SYSCALL_TRACEPOINTS
 	select TRACE_IRQFLAGS_SUPPORT
 	select HAVE_SETUP_PER_CPU_AREA
diff --git a/arch/ia64/include/asm/switch_to.h b/arch/ia64/include/asm/switch_to.h
index 1202b3160dac3..3f7e0bbef42d4 100644
--- a/arch/ia64/include/asm/switch_to.h
+++ b/arch/ia64/include/asm/switch_to.h
@@ -36,6 +36,7 @@ extern void ia64_load_extra (struct task_struct *task);
   extern void ia64_pmu_switch_task(struct task_struct *task, int sched_in);
 # define IA64_PMU_COUNTS_USER()	(__this_cpu_read(ia64_pmu_pp_users) != 0)
 #else
+  static inline void ia64_pmu_switch_task(struct task_struct *task, int sched_in) { }
 # define IA64_PMU_COUNTS_USER()	(0)
 #endif
 
