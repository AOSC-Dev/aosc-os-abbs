From 48d7bc92f5ce1e612acbc8794afce14c3108f8a1 Mon Sep 17 00:00:00 2001
From: Jiali Chen <chenjiali@radxa.com>
Date: Wed, 10 Dec 2025 08:03:44 +0000
Subject: [PATCH 705/823] RADXA: arm64: dts: amlogic: meson-g12b: fix L1 cache
 sizes for S922X CPUs

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/amlogic/meson-g12b.dtsi | 24 ++++++++++-----------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi
index 18506d54d2393..3d670cf10457e 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12b.dtsi
@@ -83,12 +83,12 @@ cpu100: cpu@100 {
 			reg = <0x0 0x100>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <1024>;
-			d-cache-line-size = <32>;
-			d-cache-size = <0x8000>;
-			d-cache-sets = <32>;
-			i-cache-line-size = <32>;
-			i-cache-size = <0x8000>;
-			i-cache-sets = <32>;
+			d-cache-line-size = <64>;
+			d-cache-size = <0x10000>;
+			d-cache-sets = <64>;
+			i-cache-line-size = <64>;
+			i-cache-size = <0x10000>;
+			i-cache-sets = <64>;
 			next-level-cache = <&l2_cache_b>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPUB_CLK>;
@@ -100,12 +100,12 @@ cpu101: cpu@101 {
 			reg = <0x0 0x101>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <1024>;
-			d-cache-line-size = <32>;
-			d-cache-size = <0x8000>;
-			d-cache-sets = <32>;
-			i-cache-line-size = <32>;
-			i-cache-size = <0x8000>;
-			i-cache-sets = <32>;
+			d-cache-line-size = <64>;
+			d-cache-size = <0x10000>;
+			d-cache-sets = <64>;
+			i-cache-line-size = <64>;
+			i-cache-size = <0x10000>;
+			i-cache-sets = <64>;
 			next-level-cache = <&l2_cache_b>;
 			#cooling-cells = <2>;
 			clocks = <&clkc CLKID_CPUB_CLK>;
-- 
2.52.0

