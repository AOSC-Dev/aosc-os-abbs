From 44b849912636f952ffdfaa900dd7f62279158718 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Mon, 16 Nov 2026 18:09:18 +0800
Subject: [PATCH 470/471] AOSCOS: rtla: wire-up __NR_sched_setattr definitions
 for all supported architectures

Previously, rtla/src/utils.c only defines `__NR_sched_setattr' for a small
range of architectures. Wire up all supported architectures to make sure
they at least build.

Am I doing this right?

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 tools/tracing/rtla/src/utils.c | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/tools/tracing/rtla/src/utils.c b/tools/tracing/rtla/src/utils.c
index cb187e7d48d1c..ff5c1b2126ded 100644
--- a/tools/tracing/rtla/src/utils.c
+++ b/tools/tracing/rtla/src/utils.c
@@ -267,14 +267,28 @@ long parse_ns_duration(char *val)
 #  define __NR_sched_setattr	351
 # elif __arm__
 #  define __NR_sched_setattr	380
-# elif __aarch64__ || __riscv
+# elif __aarch64__ || __arc__ || __csky__ || __loongarch__ || __or1k__ ||  __riscv
 #  define __NR_sched_setattr	274
 # elif __powerpc__
 #  define __NR_sched_setattr	355
 # elif __s390x__
 #  define __NR_sched_setattr	345
-# elif __loongarch__
-#  define __NR_sched_setattr	274
+# elif __alpha__
+#  define __NR_sched_setattr	508
+# elif __hppa__
+#  define __NR_sched_setattr	334
+# elif __m68k__
+#  define __NR_sched_setattr	349
+# elif __microblaze__
+#  define __NR_sched_setattr	381
+# elif __mips64
+#  define __NR_sched_setattr	5309
+# elif __mips__
+#  define __NR_sched_setattr	4349
+# elif __sh__
+#  define __NR_sched_setattr	370
+# elif __sparc__ || __sparc64__
+#  define __NR_sched_setattr	343
 # endif
 #endif
 
