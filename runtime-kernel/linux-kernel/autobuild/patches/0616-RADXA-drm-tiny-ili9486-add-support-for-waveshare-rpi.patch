From f8872e76736e139cb5db2940cd9b04baefac1bde Mon Sep 17 00:00:00 2001
From: Jiali Chen <chenjiali@radxa.com>
Date: Fri, 6 Feb 2026 09:05:23 +0000
Subject: [PATCH 616/820] RADXA: drm/tiny/ili9486: add support for
 waveshare,rpi-lcd-35-b

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/gpu/drm/tiny/ili9486.c | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/tiny/ili9486.c b/drivers/gpu/drm/tiny/ili9486.c
index 1e411a0f45672..60a9f7eb3833f 100644
--- a/drivers/gpu/drm/tiny/ili9486.c
+++ b/drivers/gpu/drm/tiny/ili9486.c
@@ -102,6 +102,8 @@ static void waveshare_enable(struct drm_simple_display_pipe *pipe,
 	struct mipi_dbi *dbi = &dbidev->dbi;
 	u8 addr_mode;
 	int ret, idx;
+	bool is_rpi_lcd_35_b = device_is_compatible(dbidev->drm.dev,
+						    "waveshare,rpi-lcd-35-b");
 
 	if (!drm_dev_enter(pipe->crtc.dev, &idx))
 		return;
@@ -124,12 +126,22 @@ static void waveshare_enable(struct drm_simple_display_pipe *pipe,
 
 	mipi_dbi_command(dbi, ILI9486_VMCTRL1, 0x00, 0x00, 0x00, 0x00);
 
-	mipi_dbi_command(dbi, ILI9486_PGAMCTRL,
-			 0x0F, 0x1F, 0x1C, 0x0C, 0x0F, 0x08, 0x48, 0x98,
-			 0x37, 0x0A, 0x13, 0x04, 0x11, 0x0D, 0x0);
-	mipi_dbi_command(dbi, ILI9486_NGAMCTRL,
-			 0x0F, 0x32, 0x2E, 0x0B, 0x0D, 0x05, 0x47, 0x75,
-			 0x37, 0x06, 0x10, 0x03, 0x24, 0x20, 0x00);
+	if (is_rpi_lcd_35_b) {
+		mipi_dbi_command(dbi, 0x21);
+		mipi_dbi_command(dbi, ILI9486_PGAMCTRL,
+				 0x00, 0x13, 0x18, 0x04, 0x0F, 0x06, 0x3A, 0x56,
+				 0x4D, 0x03, 0x0A, 0x06, 0x30, 0x3E, 0x0F);
+		mipi_dbi_command(dbi, ILI9486_NGAMCTRL,
+				 0x00, 0x13, 0x18, 0x01, 0x11, 0x06, 0x38, 0x34,
+				 0x4D, 0x06, 0x0D, 0x0B, 0x31, 0x37, 0x0F);
+	} else {
+		mipi_dbi_command(dbi, ILI9486_PGAMCTRL,
+				 0x0F, 0x1F, 0x1C, 0x0C, 0x0F, 0x08, 0x48, 0x98,
+				 0x37, 0x0A, 0x13, 0x04, 0x11, 0x0D, 0x0);
+		mipi_dbi_command(dbi, ILI9486_NGAMCTRL,
+				 0x0F, 0x32, 0x2E, 0x0B, 0x0D, 0x05, 0x47, 0x75,
+				 0x37, 0x06, 0x10, 0x03, 0x24, 0x20, 0x00);
+	}
 	mipi_dbi_command(dbi, ILI9486_DGAMCTRL,
 			 0x0F, 0x32, 0x2E, 0x0B, 0x0D, 0x05, 0x47, 0x75,
 			 0x37, 0x06, 0x10, 0x03, 0x24, 0x20, 0x00);
@@ -184,6 +196,7 @@ static const struct drm_driver ili9486_driver = {
 
 static const struct of_device_id ili9486_of_match[] = {
 	{ .compatible = "waveshare,rpi-lcd-35" },
+	{ .compatible = "waveshare,rpi-lcd-35-b" },
 	{ .compatible = "ozzmaker,piscreen" },
 	{},
 };
@@ -192,6 +205,7 @@ MODULE_DEVICE_TABLE(of, ili9486_of_match);
 static const struct spi_device_id ili9486_id[] = {
 	{ "ili9486", 0 },
 	{ "rpi-lcd-35", 0 },
+	{ "rpi-lcd-35-b", 0 },
 	{ "piscreen", 0 },
 	{ }
 };
-- 
