From c1d677d19a4c804fa2f400b46f29dfc2601c3a55 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Sat, 10 Oct 2026 21:19:01 +0800
Subject: [PATCH 346/468] RUYI: PCI: spacemit: Assert K3 PERST# after PHY
 initialization

FROM: https://github.com/openRuyi-Project/linux/commit/d52505f914b9b8e382c6ace71f2609612f1a18ab

K3 PHY initialization reprograms the PLL and reference-clock output before
waiting for PLL lock. k3_pcie_init() currently asserts PERST# before this
sequence, so the endpoint reset overlaps controller and PHY setup.

Move the assertion after phy_bulk_init() and phy_bulk_power_on() so the
100 ms endpoint reset pulse starts after reference-clock setup completes.
Keep LTSSM disabled during setup and preserve the reset hold time and
failure-path cleanup.

Validated on K3 Pico ITX with RTL8127 DHCP and 1400-byte ICMP traffic
and NVMe reads before and after a Linux warm reboot. The deployed
7.3-rc6 kernel and subsequent RAM display-validation kernels also carry
this change. The tests use EDK2 firmware with the matching reset
ordering.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 drivers/pci/controller/dwc/pcie-spacemit-k1.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/pci/controller/dwc/pcie-spacemit-k1.c b/drivers/pci/controller/dwc/pcie-spacemit-k1.c
index 4fa3680a54dfa..5c23a29374898 100644
--- a/drivers/pci/controller/dwc/pcie-spacemit-k1.c
+++ b/drivers/pci/controller/dwc/pcie-spacemit-k1.c
@@ -348,11 +348,6 @@ static int k3_pcie_init(struct dw_pcie_rp *pp)
 
 	k1_pcie_toggle_soft_reset(k1);
 
-	/* K3: Set IGNORE_PERSTN and drive PERSTN_OE high (assert reset) */
-	regmap_update_bits(k1->pmu, k1->pmu_off + PCIE_CONTROL_LOGIC,
-			   K3_PCIE_IGNORE_PERSTN | PCIE_PERSTN_OE | PCIE_PERSTN_OUT,
-			   K3_PCIE_IGNORE_PERSTN | PCIE_PERSTN_OE);
-
 	ret = k1_pcie_enable_resources(k1);
 	if (ret)
 		goto failed_resources;
@@ -368,6 +363,11 @@ static int k3_pcie_init(struct dw_pcie_rp *pp)
 	if (ret)
 		goto failed_phy_power_on;
 
+	/* K3: Set IGNORE_PERSTN and drive PERSTN_OE high (assert reset) */
+	regmap_update_bits(k1->pmu, k1->pmu_off + PCIE_CONTROL_LOGIC,
+			   K3_PCIE_IGNORE_PERSTN | PCIE_PERSTN_OE | PCIE_PERSTN_OUT,
+			   K3_PCIE_IGNORE_PERSTN | PCIE_PERSTN_OE);
+
 	msleep(PCIE_T_PVPERL_MS);
 
 	regmap_set_bits(k1->pmu, k1->pmu_off + PCIE_CONTROL_LOGIC,
