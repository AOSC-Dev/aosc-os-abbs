From 07f13f15e4e68ebe86cb0b5754c4dfe211268200 Mon Sep 17 00:00:00 2001
From: Jiali Chen <chenjiali@radxa.com>
Date: Mon, 18 May 2026 19:08:53 +0800
Subject: [PATCH 818/823] RADXA: drm/msm/dp: avoid redundant HPD bridge
 notifications

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index e760ba56bb5bc..ff7057024bb0d 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1011,17 +1011,21 @@ static irqreturn_t msm_dp_display_irq_thread(int irq, void *dev_id)
 	unsigned long flags;
 	u32 hpd_isr_status;
 	int rc;
+	bool was_plugged;
 
 	spin_lock_irqsave(&dp->irq_thread_lock, flags);
 	hpd_isr_status = dp->hpd_isr_status;
 	dp->hpd_isr_status = 0;
 	spin_unlock_irqrestore(&dp->irq_thread_lock, flags);
 
-	if (hpd_isr_status & DP_DP_HPD_UNPLUG_INT_MASK)
+	was_plugged = dp->plugged;
+
+	/* notify only on actual state transitions */
+	if (hpd_isr_status & DP_DP_HPD_UNPLUG_INT_MASK && was_plugged)
 		drm_bridge_hpd_notify(dp->msm_dp_display.bridge,
 				      connector_status_disconnected);
 
-	if (hpd_isr_status & DP_DP_HPD_PLUG_INT_MASK)
+	if (hpd_isr_status & DP_DP_HPD_PLUG_INT_MASK && !was_plugged)
 		drm_bridge_hpd_notify(dp->msm_dp_display.bridge,
 				      connector_status_connected);
 
-- 
