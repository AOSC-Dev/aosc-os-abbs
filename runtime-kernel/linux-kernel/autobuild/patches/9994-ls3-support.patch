From 6d2cc884ff8e81805bd32766a78457a34746f05e Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Thu, 18 Dec 2025 16:35:49 +0800
Subject: [PATCH 9994/9994] ls3 support

---
 drivers/media/platform/verisilicon/Kconfig    |  17 ++-
 drivers/media/platform/verisilicon/Makefile   |   3 +
 .../media/platform/verisilicon/hantro_hw.h    |   1 +
 .../media/platform/verisilicon/ls3_vpu_hw.c   | 103 ++++++++++++++++++
 4 files changed, 123 insertions(+), 1 deletion(-)
 create mode 100644 drivers/media/platform/verisilicon/ls3_vpu_hw.c

diff --git a/drivers/media/platform/verisilicon/Kconfig b/drivers/media/platform/verisilicon/Kconfig
index 3272a24db71d..afb75083c42a 100644
--- a/drivers/media/platform/verisilicon/Kconfig
+++ b/drivers/media/platform/verisilicon/Kconfig
@@ -4,7 +4,7 @@ comment "Verisilicon media platform drivers"
 
 config VIDEO_HANTRO
 	tristate "Hantro VPU driver"
-	depends on ARCH_MXC || ARCH_ROCKCHIP || ARCH_AT91 || ARCH_SUNXI || ARCH_STM32 || COMPILE_TEST
+	depends on ARCH_MXC || ARCH_ROCKCHIP || ARCH_AT91 || ARCH_SUNXI || ARCH_STM32 || PCI_LOONGSON || COMPILE_TEST
 	depends on V4L_MEM2MEM_DRIVERS
 	depends on VIDEO_DEV
 	select MEDIA_CONTROLLER
@@ -21,6 +21,12 @@ config VIDEO_HANTRO
 	  To compile this driver as a module, choose M here: the module
 	  will be called hantro-vpu.
 
+config VIDEO_HANTRO_SUPPORT_PCI_DEVICE
+        bool
+	depends on PCI
+	depends on VIDEO_HANTRO
+	default n
+
 config VIDEO_HANTRO_HEVC_RFC
 	bool "Use reference frame compression for HEVC"
 	depends on VIDEO_HANTRO
@@ -68,3 +74,12 @@ config VIDEO_HANTRO_STM32MP25
 	default y
 	help
 	  Enable support for STM32MP25 SoCs.
+
+config VIDEO_HANTRO_LOONGSON3
+	bool "Hantro VPU Loongson3 support"
+	depends on VIDEO_HANTRO
+	depends on PCI_LOONGSON || COMPILE_TEST
+	select VIDEO_HANTRO_SUPPORT_PCI_DEVICE
+	default y
+	help
+	  Enable support for Loongson 3 SoCs.
diff --git a/drivers/media/platform/verisilicon/Makefile b/drivers/media/platform/verisilicon/Makefile
index f6f019d04ff0..a814a3445c03 100644
--- a/drivers/media/platform/verisilicon/Makefile
+++ b/drivers/media/platform/verisilicon/Makefile
@@ -42,3 +42,6 @@ hantro-vpu-$(CONFIG_VIDEO_HANTRO_SUNXI) += \
 
 hantro-vpu-$(CONFIG_VIDEO_HANTRO_STM32MP25) += \
 		stm32mp25_vpu_hw.o
+
+hantro-vpu-$(CONFIG_VIDEO_HANTRO_LOONGSON3) += \
+		ls3_vpu_hw.o
diff --git a/drivers/media/platform/verisilicon/hantro_hw.h b/drivers/media/platform/verisilicon/hantro_hw.h
index 5f2011529f02..0bd17307bac5 100644
--- a/drivers/media/platform/verisilicon/hantro_hw.h
+++ b/drivers/media/platform/verisilicon/hantro_hw.h
@@ -419,6 +419,7 @@ extern const struct hantro_variant sama5d4_vdec_variant;
 extern const struct hantro_variant sunxi_vpu_variant;
 extern const struct hantro_variant stm32mp25_vdec_variant;
 extern const struct hantro_variant stm32mp25_venc_variant;
+extern const struct hantro_variant ls2k_vpu_g1_variant;
 
 extern const struct hantro_postproc_ops hantro_g1_postproc_ops;
 extern const struct hantro_postproc_ops hantro_g2_postproc_ops;
diff --git a/drivers/media/platform/verisilicon/ls3_vpu_hw.c b/drivers/media/platform/verisilicon/ls3_vpu_hw.c
new file mode 100644
index 000000000000..0f5349b87264
--- /dev/null
+++ b/drivers/media/platform/verisilicon/ls3_vpu_hw.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hantro VPU codec driver for Loongson 3 platforms
+ *
+ * Copyright (C) 2025
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+
+#include "hantro.h"
+#include "hantro_jpeg.h"
+#include "hantro_g1_regs.h"
+
+static const struct hantro_fmt ls2k_g1_vpu_postproc_fmts[] = {
+	{
+		.fourcc = V4L2_PIX_FMT_YUYV,
+		.codec_mode = HANTRO_MODE_NONE,
+		.postprocessed = true,
+		.frmsize = {
+			.min_width = FMT_MIN_WIDTH,
+			.max_width = FMT_FHD_WIDTH,
+			.step_width = MB_DIM,
+			.min_height = FMT_MIN_HEIGHT,
+			.max_height = FMT_FHD_HEIGHT,
+			.step_height = MB_DIM,
+		},
+	},
+};
+
+static const struct hantro_fmt ls2k_g1_vpu_dec_fmts[] = {
+	{
+		.fourcc = V4L2_PIX_FMT_NV12,
+		.codec_mode = HANTRO_MODE_NONE,
+		.frmsize = {
+			.min_width = FMT_MIN_WIDTH,
+			.max_width = FMT_FHD_WIDTH,
+			.step_width = MB_DIM,
+			.min_height = FMT_MIN_HEIGHT,
+			.max_height = FMT_FHD_HEIGHT,
+			.step_height = MB_DIM,
+		},
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_MPEG2_SLICE,
+		.codec_mode = HANTRO_MODE_MPEG2_DEC,
+		.max_depth = 2,
+		.frmsize = {
+			.min_width = FMT_MIN_WIDTH,
+			.max_width = FMT_FHD_WIDTH,
+			.step_width = MB_DIM,
+			.min_height = FMT_MIN_HEIGHT,
+			.max_height = FMT_FHD_HEIGHT,
+			.step_height = MB_DIM,
+		},
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_H264_SLICE,
+		.codec_mode = HANTRO_MODE_H264_DEC,
+		.max_depth = 2,
+		.frmsize = {
+			.min_width = FMT_MIN_WIDTH,
+			.max_width = FMT_FHD_WIDTH,
+			.step_width = MB_DIM,
+			.min_height = FMT_MIN_HEIGHT,
+			.max_height = FMT_FHD_HEIGHT,
+			.step_height = MB_DIM,
+		},
+	},
+};
+
+static const struct hantro_irq ls2k_g1_irqs[] = {
+	{ NULL, hantro_g1_irq },
+};
+
+static const struct hantro_codec_ops ls2k_vpu_g1_codec_ops[] = {
+	[HANTRO_MODE_MPEG2_DEC] = {
+		.run = hantro_g1_mpeg2_dec_run,
+		.init = hantro_mpeg2_dec_init,
+		.exit = hantro_mpeg2_dec_exit,
+	},
+	[HANTRO_MODE_H264_DEC] = {
+		.run = hantro_g1_h264_dec_run,
+		.init = hantro_h264_dec_init,
+		.exit = hantro_h264_dec_exit,
+	},
+};
+
+static const char * const ls2k_clk_names[] = { NULL };
+
+const struct hantro_variant ls2k_vpu_g1_variant = {
+	.codec = HANTRO_MPEG2_DECODER | HANTRO_H264_DECODER,
+	.dec_fmts = ls2k_g1_vpu_dec_fmts,
+	.num_dec_fmts = ARRAY_SIZE(ls2k_g1_vpu_dec_fmts),
+	.postproc_fmts = ls2k_g1_vpu_postproc_fmts,
+	.num_postproc_fmts = ARRAY_SIZE(ls2k_g1_vpu_postproc_fmts),
+	.codec_ops = ls2k_vpu_g1_codec_ops,
+	.irqs = ls2k_g1_irqs,
+	.postproc_ops = &hantro_g1_postproc_ops,
+	.num_irqs = ARRAY_SIZE(ls2k_g1_irqs),
+	.clk_names = ls2k_clk_names,
+	.num_clocks = ARRAY_SIZE(ls2k_clk_names),
+};
-- 
2.52.0

