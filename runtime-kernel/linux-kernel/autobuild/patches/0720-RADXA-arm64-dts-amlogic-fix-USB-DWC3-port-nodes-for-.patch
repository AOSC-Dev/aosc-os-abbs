From dadd0894d098ceab3f16c812cce38ed75890df9e Mon Sep 17 00:00:00 2001
From: Jiali Chen <chenjiali@radxa.com>
Date: Tue, 13 Jan 2026 06:38:04 +0000
Subject: [PATCH 720/823] RADXA: arm64: dts: amlogic: fix USB DWC3 port nodes
 for Radxa Zero series

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts  |  2 +-
 arch/arm64/boot/dts/amlogic/meson-g12b-radxa-zero2.dts | 10 +++-------
 2 files changed, 4 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts b/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts
index bcc29b92b651e..87cb7cfd3a78a 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-g12a-radxa-zero.dts
@@ -280,7 +280,7 @@ cvbs_vdac_out: endpoint {
 };
 
 &dwc3 {
-	ports {
+	port {
 		usb_dwc2_out: endpoint@0 {
 			remote-endpoint = <&ucsi0_hs_in>;
 		};
diff --git a/arch/arm64/boot/dts/amlogic/meson-g12b-radxa-zero2.dts b/arch/arm64/boot/dts/amlogic/meson-g12b-radxa-zero2.dts
index 37ed3b5aee5ea..ceb0424c9dcfe 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12b-radxa-zero2.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-g12b-radxa-zero2.dts
@@ -379,17 +379,13 @@ hdmi_tx_tmds_out: endpoint {
 	};
 };
 
-&dwc2 {
+&dwc3 {
 	port {
-		usb_dwc2_out: endpoint {
+		usb_dwc2_out: endpoint@0 {
 			remote-endpoint = <&ucsi0_hs_in>;
 		};
-	};
-};
 
-&dwc3 {
-	port {
-		usb_dwc3_out: endpoint {
+		usb_dwc3_out: endpoint@1 {
 			remote-endpoint = <&ucsi0_ss_in>;
 		};
 	};
-- 
2.52.0

