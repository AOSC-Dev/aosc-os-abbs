From c6275c7e216bee35c4875a787529049e0b72bd19 Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Tue, 23 Dec 2025 21:59:26 +0800
Subject: [PATCH 609/820] RADXA: arm64: dts: qcom: sc7280: Add more thermal
 trip points for GPU

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/arm64/boot/dts/qcom/kodiak.dtsi | 44 ++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kodiak.dtsi b/arch/arm64/boot/dts/qcom/kodiak.dtsi
index 5091cd789ce04..78cb3c891c113 100644
--- a/arch/arm64/boot/dts/qcom/kodiak.dtsi
+++ b/arch/arm64/boot/dts/qcom/kodiak.dtsi
@@ -7640,6 +7640,18 @@ gpuss0_alert0: trip-point0 {
 					type = "passive";
 				};
 
+				gpuss0_alert1: trip-point1 {
+					temperature = <100000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				gpuss0_alert2: trip-point2 {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				gpuss0_crit: gpuss0-crit {
 					temperature = <110000>;
 					hysteresis = <0>;
@@ -7652,6 +7664,16 @@ map0 {
 					trip = <&gpuss0_alert0>;
 					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+
+				map1 {
+					trip = <&gpuss0_alert1>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map2 {
+					trip = <&gpuss0_alert2>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
 			};
 		};
 
@@ -7667,6 +7689,18 @@ gpuss1_alert0: trip-point0 {
 					type = "passive";
 				};
 
+				gpuss1_alert1: trip-point1 {
+					temperature = <100000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				gpuss1_alert2: trip-point2 {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				gpuss1_crit: gpuss1-crit {
 					temperature = <110000>;
 					hysteresis = <0>;
@@ -7679,6 +7713,16 @@ map0 {
 					trip = <&gpuss1_alert0>;
 					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+
+				map1 {
+					trip = <&gpuss1_alert1>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map2 {
+					trip = <&gpuss1_alert2>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
 			};
 		};
 
-- 
