Use '-Wno-error' cflag for dkms module compiling post-install.
Otherwise it would fail in the current AOSC OS builds, which enforce '-Werror'.

--- a/Makefile
+++ b/Makefile
@@ -118,6 +118,6 @@
 GE_49 := 1

-ccflags-y :=
+ccflags-y += -Wno-error

 ifeq ($(APIFINAL),CFG80211)
   ccflags-y += -DUSE_CFG80211
