PKGNAME=git
PKGSEC=vcs
PKGDES="Fast distributed version control system"

PKGDEP="curl expat openssl pcre2"

ABTYPE=meson
MESON_AFTER=(
	'-Drust=disabled'
	'-Dgitk=disabled'
	'-Dgit_gui=disabled'
)

# FIXME: OOM on riscv64ima
NOLTO__RISCV64IMA=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
