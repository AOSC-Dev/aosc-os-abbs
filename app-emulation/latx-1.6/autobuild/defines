PKGNAME=latx-1.6
PKGSEC=utils
# Note: systemd-binfmt required for binfmt_misc configuration handling.
# Note: Zenity is required for /usr/bin/runapp, an LATX requirement.
PKGDEP="systemd zenity nettle pcre2 libffi gnutls glib zlib"
PKGRECOM="emukit wine"
# The following is needed for latx-i386
BUILDDEP="glib-static libgcrypt-static libgpg-error-static \
          libnfs-static pcre-static zlib-static zstd-static openssl-static"
PKGDES="Loongson Architecture Translator for x86 applications (version 1.6)"

# FIXME: Likely unsafe LTO.
#
# ../linux-user/qemu.h:286:27: warning: type of ‘thread_cpu’ does not match original declaration [-Wlto-type-mismatch]
#  286 | extern __thread CPUState *thread_cpu;
#      |                           ^
#../linux-user/main.c:242:20: note: ‘thread_cpu’ was previously declared here
#  242 | __thread CPUState *thread_cpu;
#      |                    ^
NOLTO=1

# Note: Extra Provides for Spiral (Debian compatibility).
ABSPIRAL=0
PKGPROV="lat_spiral"

# Note: Man pages have already been compresssed once.
ABMANCOMPRESS=0

# Note: Previously unversioned.
PKGBREAK="latx<=1.6.1"
PKGREP="latx<=1.6.1"

FAIL_ARCH="!(loongarch64)"
