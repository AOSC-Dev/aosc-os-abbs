PKGNAME=vice
PKGSEC=utils
PKGDEP="alsa-lib at-spi2-core cairo curl fontconfig gcc-runtime glew glib \
        glibc gtk-3 libevdev libpng pango pulseaudio x11-lib zlib ffmpeg \
        libpcap libvorbis flac giflib"
BUILDDEP="xa"
PKGDES="The Versatile Commodore 8-bit Emulator"

ABTYPE=autotools
# Note: Multi-level source tree.
AUTOTOOLS_STRICT=0
AUTOTOOLS_AFTER=(
    '--enable-external-ffmpeg'
    '--enable-x64'
    # FIXME:
    #
    # /usr/bin/ld: /tmp/ccPmcb1f.ltrans38.ltrans.o: undefined reference to symbol 'glXGetCurrentDrawable'
    # /usr/bin/ld: /usr/lib/libGLX.so.0: error adding symbols: DSO missing from command line
    # collect2: error: ld returned 1 exit status
    'LIBS=-lGLX'
)

PKGBREAK="vice<=3.9"
