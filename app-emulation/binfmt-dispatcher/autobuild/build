abinfo "Building binfmt-dispatcher ..."
make

abinfo "Installing binfmt-dispatcher ..."
make install \
    DESTDIR="$PKGDIR"

abinfo "Moving binfmt configuration to /usr/lib/binfmt.alternatives ..."
mkdir -v "$PKGDIR/usr/lib/binfmt.alternatives/"
mv -v "$PKGDIR/usr/lib/binfmt.d/binfmt-dispatcher-x86.conf" "$PKGDIR/usr/lib/binfmt.alternatives/"
mv -v "$PKGDIR/usr/lib/binfmt.d/binfmt-dispatcher-x86_64.conf" "$PKGDIR/usr/lib/binfmt.alternatives/"
rm -rv "$PKGDIR/usr/lib/binfmt.d/"
