-    }
+    la_bstrpick_d(dest, dest, opnd0_size - 1, 0);
     la_sll_d(dest, dest, tmp);
     la_or(src0_cpy, src0_cpy, dest);
 
@@ -548,9 +542,7 @@ bool translate_lock_and(IR1_INST *pir1)
     la_and(dest, src0, src1);
 
     /* rebuild dest */
-    if (!GHBR_ON(pir1)) {
-        la_bstrpick_d(dest, dest, opnd0_size - 1, 0);
-    }
+    la_bstrpick_d(dest, dest, opnd0_size - 1, 0);
     la_sll_d(dest, dest, tmp);
     la_or(src0_cpy, src0_cpy, dest);
 
