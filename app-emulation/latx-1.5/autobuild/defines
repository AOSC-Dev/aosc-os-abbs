PKGNAME=latx-1.5
PKGSEC=utils
# Note: systemd-binfmt required for binfmt_misc configuration handling.
# Note: Zenity is required for /usr/bin/runapp, an LATX requirement.
PKGDEP="systemd zenity nettle pcre2 libffi gnutls glib zlib"
PKGRECOM="emukit wine"
PKGDES="Loongson Architecture Translator for x86 applications (version 1.5)"

# Note: Binary package.
ABSTRIP=0

# Note: Extra Provides for Spiral (Debian compatibility).
ABSPIRAL=0
PKGPROV="lat_spiral"

# Note: Previously unversioned.
PKGBREAK="latx<=1.6.1"
PKGREP="latx<=1.6.1"

FAIL_ARCH="!(loongarch64)"
