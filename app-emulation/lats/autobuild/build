# Note: Generate option list with ./latxbuild/build.sh -c rel -p
#
# We use the standard configure-make-make-install routine for better clarity.
AUTOBUILD_CONFIGURE_OPTIONS=(
    '--target-list=x86_64-softmmu'
    '--enable-spice'
    '--enable-sdl'
    '--enable-slirp'
    '--enable-libusb'
    '--enable-latx-ndebug'
    '--disable-werror'
    '--disable-docs'
    '--disable-plugins'
    '--disable-tools'
    '--disable-werror'
    '--enable-latx-opt'
    '--enable-latx-opt-nofp'
    '--enable-latx-opt-eflags'
    '--enable-latx-opt-tu'
    '--enable-latx-opt-bql'
    '--enable-latx-opt-mmio-lockless'
    '--enable-latx-hack-mem'
    '--enable-atomic'
)

AUTOBUILD_CONFIGURE_OPTIONS+=(
    '--prefix=/usr'
# Note: Install x86 PC ROM blobs to another directory to avoid dependency
# on QEMU.
    '--with-suffix=lats'
)

abinfo "Configuring LATS ..."
"$SRCDIR"/configure \
    "${AUTOBUILD_CONFIGURE_OPTIONS[@]}"

# Note: configure defaults to "$SRCDIR"/build as the build directory.
abinfo "Building LATS ..."
ninja \
    -C "$SRCDIR"/build \
    --verbose

abinfo "Installing LATS ..."
DESTDIR="$PKGDIR" \
ninja install \
    -C "$SRCDIR"/build \
    --verbose

abinfo "Removing unused files ..."
# Note: To make life easier.
shopt -s extglob
rm -v "$PKGDIR"/usr/bin/!(lats-x86_64)
# FIXME: .desktop entry?
rm -rv "$PKGDIR"/{usr/{include,share/{applications,icons}},var}
