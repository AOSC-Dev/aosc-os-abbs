PKGNAME=libpsl
PKGSEC=libs
PKGDEP="icu"
BUILDDEP="gtk-doc libxslt"
PKGDES="C library for the Public Suffix List"

AUTOTOOLS_AFTER="--enable-man \
                 --enable-gtk-doc \
                 --enable-builtin \
                 --disable-runtime"
ABSHADOW=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
