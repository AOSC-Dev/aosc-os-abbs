# FIXME: Using of build templates will cause corrupted configuration files
# FIXME: Enable go bindings will cause Go pointer stored into non-Go memory
abinfo "Configurating libnbd..."
./configure --prefix=/usr --sbindir=/usr/bin --disable-static --disable-golang 

abinfo "Building libnbd..."
make

abinfo "Installing libnbd..."
make DESTDIR=$PKGDIR install
