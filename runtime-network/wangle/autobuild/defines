PKGNAME=wangle
PKGSEC=libs
PKGDEP="double-conversion fizz fmt folly gflags glog libevent openssl"
PKGDES="A networking library providing common abstractions for clients and servers"
BUILDDEP="llvm"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_SHARED_LIBS=ON'
    '-DBUILD_TESTS=OFF'
)

# FIXME: gcc15 compatibility issue on non-x86 and non-arm targets
# /usr/include/folly/container/EvictingCacheMap.h:740:26: error: call of overloaded ‘find(const std::__cxx11::basic_string<char>&)’ is ambiguous
USECLANG=1
