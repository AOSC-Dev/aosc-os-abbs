PKGNAME=libssh
PKGSEC=libs
PKGDEP="krb5 openssl zlib libfido2"
PKGDEP="openssl zlib"
PKGDES="C library implementing the SSHv2 protocol"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DWITH_GSSAPI=ON'
    '-DWITH_FIDO2=ON'
)

CMAKE_AFTER__RETRO=(
    '-DWITH_GSSAPI=OFF'
    '-DWITH_FIDO2=OFF'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
