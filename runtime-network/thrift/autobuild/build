abinfo "Building thrift..."
cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_JAVA=OFF \
    -DBUILD_JAVASCRIPT=OFF \
    -DBUILD_KOTLIN=OFF \
    -DBUILD_NODEJS=OFF \
    -DBUILD_PYTHON=ON
cmake --build build
python3 -m build --wheel --no-isolation lib/py
emacs -Q --batch -f batch-byte-compile contrib/thrift.el

abinfo "Installing thrift..."
DESTDIR=$PKGDIR cmake --install build

install -Dvm644 contrib/thrift.vim $PKGDIR/usr/share/vim/vimfiles/syntax/thrift.vim
install -Dvm644 contrib/thrift.el $PKGDIR/usr/share/emacs/site-lisp/thrift.el
install -Dvm644 contrib/thrift.elc $PKGDIR/usr/share/emacs/site-lisp/thrift.elc
python3 -m installer --destdir=$PKGDIR lib/py/dist/*.whl
