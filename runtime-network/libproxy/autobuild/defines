PKGNAME=libproxy
PKGSEC=libs
PKGDES="Library that provides automatic proxy configuration management"
PKGDEP="curl duktape gcc-runtime glib glibc"
PKGDEP__RETRO="curl gcc-runtime glib glibc"
BUILDDEP="gsettings-desktop-schemas gobject-introspection vala"
BUILDDEP__RETRO="gsettings-desktop-schemas"

ABTYPE=meson
MESON_AFTER=(
    '-Ddocs=false'
    '-Dtests=false'
    '-Dconfig-env=true'
    '-Dconfig-gnome=true'
    '-Dconfig-windows=true'
    '-Dconfig-sysconfig=true'
    '-Dconfig-osx=true'
    '-Dconfig-kde=true'
    '-Dconfig-xdp=true'
    '-Dpacrunner-duktape=true'
    '-Dvapi=true'
    '-Dcurl=true'
    '-Dintrospection=true'
    '-Drelease=true'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=false'
    '-Dpacrunner-duktape=false'
    '-Dvapi=false'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
