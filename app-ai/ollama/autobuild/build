abinfo "Configuring ollama ..."
build_cmakeninja_configure

abinfo "Building the main runtime ..."
build_cmakeninja_build

abinfo "Building the frontend program ..."
go build -v \
    -ldflags "${GO_LDFLAGS[*]} \
    -X=github.com/ollama/ollama/version.Version=$PKGVER -X=github.com/ollama/ollama/server.mode=release \
    -extldflags '-Wl,-z,relro -Wl,-z,now -specs=/usr/lib/autobuild3/specs/hardened-ld'" \
    -o "$SRCDIR"/dist/bin/ollama "$SRCDIR"

abinfo "Installing the main runtime ..."
build_cmakeninja_install

abinfo "Installing the frontend program ..."
install -Dvm755 "$SRCDIR"/dist/bin/ollama \
    "$PKGDIR"/usr/bin/ollama
