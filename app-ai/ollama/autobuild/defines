PKGNAME=ollama
PKGSEC=misc
PKGDEP="debconf gcc-runtime glibc"
BUILDDEP="clblast go ninja shaderc vulkan"
BUILDDEP__CUDA="cuda"
BUILDDEP__AMD64="${BUILDDEP} ${BUILDDEP__CUDA}"
BUILDDEP__ARM64="${BUILDDEP} ${BUILDDEP__CUDA}"
# TODO: ROCm support
#BUILDDEP__ROCM="${BUILDDEP} hipblas"
PKGDES="Large Language Model runtime and frontend"

# Note: To fill in later. Keeping it defined to make Autobuild happy.
CMAKE_AFTER=()
# Note: Taken from the "CUDA 12" preset in CMakePresets.json.
CMAKE_AFTER__CUDA=(
    '-DCMAKE_CUDA_ARCHITECTURES="50;60;61;70;75;80;86;87;89;90;90a;120"'
)
CMAKE_AFTER__AMD64=(
    "${CMAKE_AFTER[@]}"
    "${CMAKE_AFTER__CUDA[@]}"
)
CMAKE_AFTER__ARM64=(
    "${CMAKE_AFTER[@]}"
    "${CMAKE_AFTER__CUDA[@]}"
)
