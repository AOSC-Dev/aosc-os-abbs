PKGNAME=rocm-aotriton
PKGDES="Ahead of Time Triton Math Library"
PKGSEC=devel
PKGDEP="rocr-runtime rocm-clr rocm-triton"
BUILDDEP="cmake rocm-llvm ninja rocm-cmake pybind11 nanobind \
          pandas numpy cython nlohmann-json"

# Note: Control Flow Protection is not supported by GPU targets.
#
# https://github.com/llvm/llvm-project/issues/86450
AB_FLAGS_CFP=0
# FIXME: llvm LTO OOM
NOLTO=1
# Note: Use ROCm LLVM Toolchain
USECLANG=1

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_BUILD_TYPE=Release'
    '-DCMAKE_C_COMPILER=clang'
    '-DCMAKE_CXX_COMPILER=clang++'
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm/aotriton'
    '-DCMAKE_SKIP_INSTALL_RPATH=OFF'
    '-DAOTRITON_USE_TORCH=OFF'
    '-DCMAKE_LINKER_TYPE=LLD'
    "-DAOTRITON_INHERIT_SYSTEM_SITE_TRITON=ON"
)

FAIL_ARCH="!(amd64|loongarch64)"
