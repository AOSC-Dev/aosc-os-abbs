PKGNAME=rocm-bandwidth-test
PKGDES="Utility to measure the GPU application memory bandwidth related performance"
PKGSEC=devel
PKGDEP="rocr-runtime rocm-llvm rocm-clr"
BUILDDEP="cmake"

USECLANG=1
NOLTO=1
NOSTATIC=0


ABTYPE=cmakeninja
CMAKE_AFTER="-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm \
 -DCMAKE_C_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang \
 -DCMAKE_CXX_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang++ \
 -DCMAKE_PREFIX_PATH=/usr/lib/rocm \
 -DCMAKE_SKIP_INSTALL_RPATH=OFF \
 -DCMAKE_INSTALL_RPATH=/usr/lib/rocm/lib/llvm/lib;/usr/lib/rocm/lib "

# FIXME: rocm-llvm does not build on MIPS.
FAIL_ARCH="!(loongarch64)"
