PKGNAME=rocm-rocmlir
PKGDES="MLIR-based convolution and GEMM kernel generator for ROCm"
PKGSEC=devel
PKGDEP="rocm-core"
BUILDDEP="cmake rocm-llvm"

USECLANG=1

# Note: Keep libclang_rt.builtins.a, Compiling for GPU environment
NOSTATIC=0

LLVM_BASE_SET="mlir"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm/lib/mlir'
    '-DCMAKE_INSTALL_RPATH=/usr/lib/rocm/lib/mlir/lib;/usr/lib/rocm/lib/llvm/lib;/usr/lib/rocm/lib'
    '-DCMAKE_C_COMPILER=/usr/lib/rocm/llvm/bin/clang'
    '-DCMAKE_CXX_COMPILER=/usr/lib/rocm/llvm/bin/clang++'
    '-DLLVM_ENABLE_PIC=ON'
# Note: https://github.com/ROCm/rocm-libraries/issues/7700
    '-DMLIR_ENABLE_BINDINGS_PYTHON=ON'
    '-DMLIR_BINDINGS_PYTHON_NB_DOMAIN=mlir'
    '-DMLIR_INCLUDE_TESTS=OFF'
    '-DLLVM_ENABLE_ASSERTIONS=OFF'
    '-DLLVM_TARGETS_TO_BUILD=Native;AMDGPU'
    '-DCMAKE_SKIP_INSTALL_RPATH=OFF'
    '-DCMAKE_SKIP_RPATH=OFF'
    '-DLLVM_INCLUDE_TESTS=ON'
    '-DLLVM_BUILD_UTILS=ON'
    '-DCMAKE_LINKER_TYPE=LLD'
    '-DLLVM_INSTALL_UTILS=ON'
    '-DLLVM_LINK_LLVM_DYLIB=ON'
    "-DLLVM_ENABLE_PROJECTS=${LLVM_BASE_SET}"
)
CMAKE_AFTER__LOONGARCH64=(
    ${CMAKE_AFTER[@]}
    '-DCMAKE_C_FLAGS=-mcmodel=medium'
    '-DCMAKE_CXX_FLAGS=-mcmodel=medium'
)

FAIL_ARCH="!(amd64|arm64|loongarch64)"
