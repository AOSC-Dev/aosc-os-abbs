PKGNAME=rocm-amdsmi
PKGDES="AMD System Management Interface (AMD SMI) library"
PKGSEC=devel
PKGDEP="gcc-runtime libnl libmnl libdrm"
BUILDDEP="cmake rocm-llvm"

# FIXME:  '_FORTIFY_SOURCE' macro redefined
#
# cmake_modules/help_package.cmake:57
#        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -D_FORTIFY_SOURCE=2 -fstack-protector-all -Wcast-align" PARENT_SCOPE)
AB_FLAGS_FTF=0
# Note: Keep libamdsminic.a, rocm-rdc dependency ...
NOSTATIC=0

USECLANG=1

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_INSTALL_RPATH=/usr/lib/rocm/lib/llvm/lib;/usr/lib/rocm/lib'
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm'
    '-DCMAKE_SKIP_INSTALL_RPATH=OFF'
    '-DCMAKE_LINKER_TYPE=LLD'
    '-DBUILD_SHARED_LIBS=ON'
    '-DBUILD_CLI=ON'
    '-DCMAKE_C_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang'
    '-DCMAKE_CXX_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang++'
)

FAIL_ARCH="!(amd64|arm64|loongarch64)"
