PKGNAME=hiprt
PKGDES="ray tracing library for HIP"
PKGSEC=devel
PKGDEP="rocr-runtime rocm-llvm rocm-clr"
BUILDDEP="cmake python-3 rocminfo"

USECLANG=1

# FIXME: Segmentation Fault
#  failed: null sections(STRTAB)
#  rocm-clr rocclr/elf/elf.cpp:282
ABSTRIP=0

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm'
    '-DCMAKE_C_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang'
    '-DCMAKE_CXX_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang++'
    '-DCMAKE_PREFIX_PATH=/usr/lib/rocm'
    '-DCMAKE_SKIP_INSTALL_RPATH=OFF'
    '-DCMAKE_LINKER_TYPE=LLD'
    '-DPRECOMPILE=ON'
    '-DBITCODE=ON'
    '-DFORCE_DISABLE_CUDA=ON'
    '-DPYTHON_EXECUTABLE=/usr/bin/python3'
    '-DHIP_PATH=/usr/lib/rocm'
    '-DNO_UNITTEST=ON'
    '-DNO_ENCRYPT=ON'
    '-DCMAKE_BUILD_TYPE=Release'
)

FAIL_ARCH="!(amd64|arm64|loongarch64|riscv64)"
