abinfo "Setting ROCM_PATH ..."
export ROCM_PATH=/usr/lib/rocm

abinfo "Adding ROCm LLVM to PATH ..."
export PATH="/usr/lib/rocm/lib/llvm/bin:$PATH"

abinfo "Adding ROCm to PATH ..."
export PATH="/usr/lib/rocm/bin:$PATH"

abinfo "Setting Triton Offline Build Mode ..."
export TRITON_OFFLINE_BUILD=1
export TRITON_BUILD_WITH_CLANG_LLD=1

abinfo "Setting Trition use system JSON ..."
export JSON_SYSPATH=/usr

abinfo "Disable Triton UnitTest ..."
export TRITON_BUILD_UT=0

abinfo "Use LLD for Link ..."
export LDFLAGS="${LDFLAGS} -fuse-ld=lld"

abinfo "Setting Triton llvm path ..."
export LLVM_SYSPATH=$SRCDIR/../llvm-usr

abinfo "Use clang/clang++ compile ..."
export CC=clang
export CXX=clang++

abinfo "Build triton-llvm ..."
mkdir -pv "$SRCDIR"/../llvm-build
cd "$SRCDIR"/../llvm-build
cmake -GNinja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$LLVM_SYSPATH" \
  -DLLVM_BUILD_UTILS=ON \
  -DLLVM_BUILD_TOOLS=ON \
  -DLLVM_INCLUDE_TESTS=OFF \
  -DLLVM_ENABLE_ASSERTIONS=OFF \
  -DMLIR_ENABLE_BINDINGS_PYTHON=ON \
  -DLLVM_ENABLE_PROJECTS="clang;mlir;llvm;lld" \
  -DLLVM_INSTALL_UTILS=ON \
  -DLLVM_TARGETS_TO_BUILD="host;AMDGPU" \
  -DLLVM_ABI_BREAKING_CHECKS=FORCE_OFF \
  -DLLVM_ENABLE_PIC=ON \
  -DLLVM_INCLUDE_BENCHMARKS=OFF \
  "$SRCDIR/../llvm-project/llvm"

ninja -v all install
