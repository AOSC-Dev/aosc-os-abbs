diff --git a/src/include/gdrwrap.h b/src/include/gdrwrap.h
index 162373be19..b713574520 100644
--- a/src/include/gdrwrap.h
+++ b/src/include/gdrwrap.h
@@ -40,7 +40,7 @@ static inline void wc_store_fence(void) { asm volatile("sync" : : : "memory"); }
 #elif defined(__x86_64__) || (defined(_MSC_VER) && (defined(_M_X64) || defined(_M_AMD64)))
 #include <immintrin.h>
 static inline void wc_store_fence(void) { _mm_sfence(); }
-#elif defined(__aarch64__) || defined(__riscv)
+#elif defined(__aarch64__) || defined(__riscv) || defined(__loongarch_lp64)
 #ifdef __cplusplus
 #include <atomic>
 static inline void wc_store_fence(void) { std::atomic_thread_fence(std::memory_order_release); }
diff --git a/src/graph/xml.cc b/src/graph/xml.cc
index 561ab85ab74..97a89da5777 100644
--- a/src/graph/xml.cc
+++ b/src/graph/xml.cc
@@ -538,6 +538,8 @@ ncclResult_t ncclTopoGetXmlFromCpu(struct ncclXmlNode* cpuNode, struct ncclXml*
     NCCLCHECK(xmlSetAttr(cpuNode, "arch", "arm64"));
 #elif defined(__x86_64__) || defined(_M_X64) || defined(_M_AMD64)
     NCCLCHECK(xmlSetAttr(cpuNode, "arch", "x86_64"));
+#elif defined(__loongarch_lp64)
+    NCCLCHECK(xmlSetAttr(cpuNode, "arch", "loongarch64"));
 #else
     WARN("getXmlFromCpu: Unknown CPU architecture");
     return ncclInternalError;
