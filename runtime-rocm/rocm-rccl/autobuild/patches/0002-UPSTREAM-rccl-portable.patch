From 708a0dcadd59bf250e9a2b8c0157e0037d6bf500 Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Thu, 20 Aug 2026 17:55:08 +0000
Subject: [PATCH 1/3] rccl: use volatile read for portable GDC flush

The NCCL v2.30.7 sync introduced a portable (non-x86) GDC flush path
that calls ncclGdrCudaRead, but this function was never implemented in
the __HIP_PLATFORM_AMD__ branch of gdrwrap.h.  This causes a build
failure on any non-x86 AMD/HIP platform.

Replace the ncclGdrCudaRead calls with a direct volatile read.  The
volatile qualifier prevents the compiler from eliding the load, which
is the whole point of the flush -- forcing a PCI-e read from GPU BAR
memory to drain prior posted writes.  The x86 path uses asm volatile
for the same reason.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 projects/rccl/src/transport/coll_net.cc | 5 ++---
 projects/rccl/src/transport/net.cc      | 5 ++---
 2 files changed, 4 insertions(+), 6 deletions(-)

diff --git a/src/transport/coll_net.cc b/src/transport/coll_net.cc
index 273b86c8bcac..970206e5a4cf 100644
--- a/src/transport/coll_net.cc
+++ b/src/transport/coll_net.cc
@@ -1278,10 +1278,9 @@ static ncclResult_t recvProxyProgress(struct ncclProxyState* proxyState, struct
               asm volatile("mov (%0), %%eax" ::"l"(resources->gdcFlush) : "%eax", "memory");
 #else
               // Portable equivalent. seq_cst fence keeps the load inside
-              // ncclGdrCudaRead from being reordered ahead of the CQE poll.
+              // the volatile read from being reordered ahead of the CQE poll.
               std::atomic_thread_fence(std::memory_order_seq_cst);
-              uint64_t dummy;
-              NCCLCHECK(ncclGdrCudaRead(resources->gdrDesc, &dummy, resources->gdcFlush, sizeof(dummy)));
+              (void)*(volatile int*)resources->gdcFlush;
 #endif
             } else {
               NCCLCHECK(collNetRecvFlush(proxyState, resources, args, sub, groupStart, totalSize, recvBeg,
diff --git a/src/transport/net.cc b/src/transport/net.cc
index c6e1e56e089e..27a238634a28 100644
--- a/src/transport/net.cc
+++ b/src/transport/net.cc
@@ -2120,10 +2120,9 @@ static ncclResult_t recvProxyProgress(struct ncclProxyState* proxyState, struct
               }
 #else
               // Portable equivalent. seq_cst fence keeps the load inside
-              // ncclGdrCudaRead from being reordered ahead of the CQE poll.
+              // the volatile read from being reordered ahead of the CQE poll.
               std::atomic_thread_fence(std::memory_order_seq_cst);
-              uint64_t dummy;
-              NCCLCHECK(ncclGdrCudaRead(resources->gdrDesc, &dummy, resources->gdcFlush, sizeof(dummy)));
+              (void)*(volatile int*)resources->gdcFlush;
 #endif
             } else {
               int subCount = 0;

