abinfo "Start Project Configure ..."
# FIXME: scikit-build-core abbs too old.
# FIXME: setuptools abbs too high.
python3 -m pip install scikit-build-core cmake ninja 'setuptools<82,>=77.0.0'

python3 -m build --wheel --no-isolation

abinfo "Install PyTorch ..."
python3 -m pip install --no-build-isolation -v . \
    --root="$PKGDIR" \
    --prefix="/usr" \
    --no-deps \
    --ignore-installed

abinfo "clean AoTriton copy, use Symbolic Link ..."
for filename in $(find "$PKGDIR/usr/lib/python$ABPY3VER/site-packages/torch/lib" -maxdepth 1 -mindepth 1 -printf "%f\n")
do
 if [ -e "$AOTRITON_INSTALLED_PREFIX/lib/$filename" ];
 then
   rm -rv "$PKGDIR/usr/lib/python$ABPY3VER/site-packages/torch/lib/$filename"
   ln -vs "$AOTRITON_INSTALLED_PREFIX/lib/$filename" "$PKGDIR/usr/lib/python$ABPY3VER/site-packages/torch/lib/$filename"
 fi
done
