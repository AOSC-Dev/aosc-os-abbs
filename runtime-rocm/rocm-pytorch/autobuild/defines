PKGNAME=rocm-pytorch
PKGDES="Tensors and Dynamic neural networks in Python with strong GPU acceleration"
PKGSEC=devel
PKGDEP="rocr-runtime rocm-comgr rocm-rocrand rocm-hiprand rocm-rocblas \
        rocm-hipblas rocm-miopen rocm-hipfft rocm-hipsparse rocm-rocprim \
        rocm-hipcub rocm-rocthrust rocm-hipsolver rocm-rocsolver \
        rocm-clr rocm-roctracer rocm-aotriton rocm-hipsparselt rocm-rocshmem \
        rocm-rocprofiler-register rocm-rocprofiler-sdk"
BUILDDEP="pyyaml rocm-half rocm-cmake patchelf numpy pandas libhipcxx"

# Note: Control Flow Protection is not supported by GPU targets.
#
# https://github.com/llvm/llvm-project/issues/86450
AB_FLAGS_CFP=0

USECLANG=1

ABTYPE=self

FAIL_ARCH="!(amd64|loongarch64)"
