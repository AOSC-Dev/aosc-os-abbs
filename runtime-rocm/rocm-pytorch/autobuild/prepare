abinfo "Setup ENV ..."
export DEBUG=0
export USE_CUDA=0
export USE_ROCM=1
export BUILD_TEST=0
export USE_OPENMP=0
export USE_MKLDNN=0
export ROCM_HOME=/usr/lib/rocm/
export ROCM_PATH=/usr/lib/rocm/
export CC=/usr/lib/rocm/lib/llvm/bin/clang
export CXX=/usr/lib/rocm/lib/llvm/bin/clang++
export ROCM_DEFAULT_DIR=/usr/lib/rocm/
# FIXME: amd64 need link libomp. force use rocm-llvm.
export LDFLAGS="-L/usr/lib/rocm/llvm/lib $LDFLAGS"
# FIXME: No such file or directory.
export CFLAGS="$CFLAGS -I/usr/lib/rocm/include/roctracer/"
export CXXFLAGS="$CXXFLAGS -I/usr/lib/rocm/include/roctracer/"
export LDFLAGS="-L/usr/lib/rocm/llvm/lib $LDFLAGS -fuse-ld=lld"
export LD_LIBRARY_PATH="/usr/lib/rocm/llvm/lib:$LD_LIBRARY_PATH"
# FIXME: gfx942(CDNA3) error
#  composable_kernel/include/ck/tensor_description/multi_index_transform.hpp:1589:5:
#  error: defaulted definition of default constructor cannot be marked constexpr before C++23
#  composable_kernel/include/ck_tile/ops/elementwise/unary_element_wise_operation.hpp:1252:49:
#  error: reference to local variable 'c1' declared in enclosing function 'ck_tile::element_wise::FastGeluAsm::operator()<float, float>'
export PYTORCH_ROCM_ARCH="gfx908:xnack-;gfx90a;gfx1010;gfx1011;gfx1012;gfx1030;gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1200;gfx1201"
export AOTRITON_INSTALLED_PREFIX=/usr/lib/rocm/aotriton
export VERBOSE=1

if ab_match_arch loongarch64; then
    abinfo "Replace LoongArch CpuInfo ..."
    rm -rv $SRCDIR/third_party/cpuinfo
    ln -vs $SRCDIR/../cpuinfo $SRCDIR/third_party/cpuinfo
    rm -rv $SRCDIR/third_party/fbgemm/external/cpuinfo
    ln -vs $SRCDIR/../cpuinfo $SRCDIR/third_party/fbgemm/external/cpuinfo
fi

abinfo "Cast Source To Build ROCM Mode ..."
python3 $SRCDIR/tools/amd_build/build_amd.py
