PKGNAME=rocm-hipblaslt
PKGDES="hipBLASLt is a library that provides general matrix-matrix operations with a flexible API and extends functionalities beyond a traditional BLAS library"
PKGSEC=devel
PKGDEP="rocm-llvm rocm-clr rocm-cmake rocm-hipblas-common rocm-roctracer"
BUILDDEP="cmake cargo rustc llvm maturin msgpack-c++"

ABTYPE=cmakeninja
CMAKE_AFTER="-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm
-DCMAKE_C_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang
-DCMAKE_CXX_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang++
-DCMAKE_SKIP_INSTALL_RPATH=OFF
-DCMAKE_PREFIX_PATH=/usr/lib/rocm
-DROCM_PATH=/usr/lib/rocm
-DBUILD_CLIENTS_SAMPLES=ON
-DTensile_LOGIC=
-DTensile_ENABLE_MARKER=ON
-DTensile_EXPERIMENTAL=ON
-DBUILD_CLIENTS_TESTS=OFF
-DBUILD_CLIENTS_BENCHMARKS=OFF
-DAMDGPU_TARGETS=gfx1100;gfx1101
-DCMAKE_FIND_ROOT_PATH=/usr/lib/rocm/;/usr/lib/rocm/lib/llvm/
-DCMAKE_INSTALL_RPATH=/usr/lib/rocm/lib/llvm/lib;/usr/lib/rocm/lib
"

USECLANG=1
NOLTO=1

# FIXME: rocm-llvm does not build on MIPS.
FAIL_ARCH="!(loongarch64)"
BUILD_FINAL(){
  ninja hipblaslt-common
}
