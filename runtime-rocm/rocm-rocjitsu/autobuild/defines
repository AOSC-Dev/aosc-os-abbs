PKGNAME=rocm-rocjitsu
PKGDES="JIT-based AMD GPU emulator to run unmodified ROCm applications without a physical GPU"
PKGSEC=devel
PKGDEP="rocm-core gcc-runtime"
BUILDDEP="cmake rocm-cmake gcc"

# Note: Control Flow Protection is not supported by GPU targets.
#
# https://github.com/llvm/llvm-project/issues/86450
AB_FLAGS_CFP=0

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm'
    '-DCMAKE_PREFIX_PATH=/usr/lib/rocm/lib/llvm;/usr/lib/rocm'
    '-DCMAKE_SKIP_RPATH=OFF'
    '-DCMAKE_INSTALL_RPATH=/usr/lib/rocm/lib/llvm/lib;/usr/lib/rocm/lib'
)

FAIL_ARCH="!(amd64|arm64|loongarch64)"
