abinfo "Installing JetBrainsMono Nerd Font file..."
install -dvm755 "$PKGDIR"/usr/share/fonts/TTF
install -vm644 "$SRCDIR"/*.ttf "$PKGDIR"/usr/share/fonts/TTF/

abinfo "Installing LICENSE..."
install -dvm755 "$PKGDIR"/usr/share/doc/jetbrains-mono-nerd-fonts/
install -vm644 "$SRCDIR"/OFL.txt "$PKGDIR"/usr/share/doc/jetbrains-mono-nerd-fonts/
