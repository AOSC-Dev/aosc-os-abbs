PKGNAME=libc+wasi
PKGSEC=lib
PKGDES="WebAssembly WASI C library"
BUILDDEP="llvm"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_C_COMPILER=/usr/bin/clang'
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/wasm32-wasi'
    '-DCMAKE_SYSROOT=/usr/lib/wasm32-wasi'
    '-DCMAKE_SYSTEM_NAME=WASI'
    '-DCMAKE_SYSTEM_PROCESSOR=wasm32'
    '-DCMAKE_SYSTEM_VERSION=1'
)

USECLANG=1

# Note: Unrecognised flags.
#
# wasm-ld: error: unknown argument: --sort-common
# wasm-ld: error: unknown argument: --as-needed
# wasm-ld: warning: unknown -z value: relro
# wasm-ld: warning: unknown -z value: now
AB_FLAGS_RRO=1

# Note: Static, architecture-agnostic library only.
NOSTATIC=0
ABSPLITDBG=0

ABHOST=noarch
