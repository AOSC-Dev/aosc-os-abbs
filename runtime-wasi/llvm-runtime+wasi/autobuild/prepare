abinfo "Stripping unrecognised LDFLAGS ..."
# Note: Unrecognised flags.
#
# wasm-ld: error: unknown argument: --sort-common
# wasm-ld: error: unknown argument: --as-needed
export LDFLAGS="${LDFLAGS/,--sort-common,--as-needed/}"

abinfo "Setting platform parameters ..."
mkdir -pv "$SRCDIR"/cmake/Platform
echo "set(WASI 1)" > "$SRCDIR"/cmake/Platform/WASI.cmake

LLVM_VER="$(llvm-config --version)"
if [[ "${LLVM_VER}" != "${PKGVER}" ]]; then
    abdie "Please keep llvm-runtime+wasi ($PKGVER) in sync with system LLVM version ($LLVM_VER)!"
fi
