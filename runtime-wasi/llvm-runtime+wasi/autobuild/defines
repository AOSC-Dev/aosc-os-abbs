PKGNAME=llvm-runtime+wasi
PKGSEC=libs
PKGDEP="libc+wasi"
BUILDDEP="cmake ninja python-3 llvm-22"
PKGDES="Low Level Virtual Machine Infrastructure (runtime libraries, WASI)"

ABTYPE=self
# Note: Used in autobuild/build.
CMAKE_AFTER__COMMON=(
    # Note: Clang/LLVM toolchain expected.
    '-DCMAKE_AR=/usr/bin/llvm-ar'
    '-DCMAKE_ASM_COMPILER=/usr/bin/clang'
    '-DCMAKE_C_COMPILER=/usr/bin/clang'
    '-DCMAKE_CXX_COMPILER=/usr/bin/clang++'

    # Note: from WebAssembly/wasi-sdk:
    #
    # CMake detects this based on `CMAKE_C_COMPILER` alone and when that
    # compiler is just a bare "clang" installation then it can mistakenly
    # deduce that this feature is supported when it's not actually
    # supported for WASI targets. Currently `wasm-ld` does not support the
    # linker flag for this.
    #
    # https://github.com/WebAssembly/wasi-sdk/blob/wasi-sdk-34/cmake/wasi-sdk-sysroot.cmake#L71C3-L76C43
    '-DCMAKE_C_LINKER_DEPFILE_SUPPORTED=OFF'
    '-DCMAKE_CXX_LINKER_DEPFILE_SUPPORTED=OFF'

    # Note: Installation paths and sysroot.
    '-DCMAKE_INSTALL_PREFIX=/usr/lib/wasm32-wasi'
    '-DCMAKE_SYSROOT=/usr/lib/wasm32-wasi'
    '-DCMAKE_STAGING_PREFIX=/usr/lib/wasm32-wasi'

    # Note: Mozilla applications now expect it.
    '-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON'

    # Note: Specify build target. There is also a -thread variant, which
    # we have never shipped before. Not sure what for.
    #
    # See also: https://gitlab.archlinux.org/archlinux/packaging/packages/wasi-compiler-rt/-/blob/68dd2dfc6b1ec94b3c81d517d3fc59f7e43d7d00/PKGBUILD#L86
    '-DLLVM_RUNTIME_TARGETS=wasm32-unknown-wasip1'
    '-DLLVM_DEFAULT_TARGET_TRIPLE=wasm32-unknown-wasip1'
    '-DCMAKE_ASM_COMPILER_TARGET=wasm32-wasip1'
    '-DCMAKE_C_COMPILER_TARGET=wasm32-wasip1'
    '-DCMAKE_CXX_COMPILER_TARGET=wasm32-wasip1'

    # Note: Specify only flags recognised by WASM.
    '-DCMAKE_ASM_FLAGS=-mcpu=lime1 --sysroot=/usr/lib/wasm32-wasi --target=wasm32-wasip1'
    '-DCMAKE_C_FLAGS=-mcpu=lime1 --sysroot=/usr/lib/wasm32-wasi --target=wasm32-wasip1'
    '-DCMAKE_CXX_FLAGS=-mcpu=lime1 --sysroot=/usr/lib/wasm32-wasi --target=wasm32-wasip1'

    # Note: All below from this point on, taken from...
    #
    # https://github.com/WebAssembly/wasi-sdk/blob/wasi-sdk-34/cmake/wasi-sdk-sysroot.cmake
    '-DCMAKE_SYSTEM_NAME=WASI'
    '-DCMAKE_SYSTEM_VERSION=1'
    '-DCMAKE_SYSTEM_PROCESSOR=wasm32'
    '-DCMAKE_C_COMPILER_WORKS=ON'
    '-DCMAKE_CXX_COMPILER_WORKS=ON'
    '-DLLVM_ENABLE_RTTI=OFF'
    '-DLLVM_ENABLE_FFI=OFF'
    '-DLLVM_COMPILER_CHECKED=ON'
    '-DUNIX=ON'
)
CMAKE_AFTER__COMPILIER_RT=(
    # Note: compiler-rt options.
    '-DCOMPILER_RT_BAREMETAL_BUILD=ON'
    '-DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON'
    '-DCOMPILER_RT_OS_DIR=wasi'
    '-DCOMPILER_RT_BAREMETAL_BUILD=ON'
    '-DCOMPILER_RT_BUILD_XRAY=OFF'
    '-DCOMPILER_RT_INCLUDE_TESTS=OFF'
    '-DCOMPILER_RT_HAS_FPIC_FLAG=OFF'
    '-DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON'
    '-DCOMPILER_RT_BUILD_SANITIZERS=OFF'
    '-DCOMPILER_RT_BUILD_XRAY=OFF'
    '-DCOMPILER_RT_BUILD_LIBFUZZER=OFF'
    '-DCOMPILER_RT_BUILD_PROFILE=OFF'
    '-DCOMPILER_RT_BUILD_CTX_PROFILE=OFF'
    '-DCOMPILER_RT_BUILD_MEMPROF=OFF'
    '-DCOMPILER_RT_BUILD_ORC=OFF'
    '-DCOMPILER_RT_BUILD_GWP_ASAN=OFF'
)
CMAKE_AFTER__RUNTIMES=(
    '-DLLVM_ENABLE_RUNTIMES=libcxx;libcxxabi'

    # Note: libcxx/libcxxabi options.
    #'-DCMAKE_POSITION_INDEPENDENT_CODE=ON'
    '-DLIBCXX_ENABLE_THREADS=ON'
    '-DLIBCXX_HAS_PTHREAD_API=ON'
    '-DLIBCXX_HAS_EXTERNAL_THREAD_API=OFF'
    '-DLIBCXX_HAS_WIN32_THREAD_API=OFF'
    '-DLIBCXX_ENABLE_SHARED=OFF'

    # Note: https://github.com/WebAssembly/wasi-sdk/blob/wasi-sdk-34/cmake/wasi-sdk-sysroot.cmake#L23
    '-DLIBCXX_ENABLE_EXCEPTIONS=OFF'

    '-DLIBCXX_ENABLE_FILESYSTEM=ON'
    '-DLIBCXX_ENABLE_ABI_LINKER_SCRIPT=OFF'
    '-DLIBCXX_CXX_ABI=libcxxabi'
    '-DLIBCXX_HAS_MUSL_LIBC=OFF'
    '-DLIBCXX_ABI_VERSION=2'
    '-DLIBCXX_LIBDIR_SUFFIX=/wasm32-wasi'

    # Note: https://github.com/WebAssembly/wasi-sdk/blob/wasi-sdk-34/cmake/wasi-sdk-sysroot.cmake#L23
    '-DLIBCXXABI_ENABLE_EXCEPTIONS=OFF'

    '-DLIBCXXABI_ENABLE_SHARED=OFF'
    '-DLIBCXXABI_SILENT_TERMINATE=ON'
    '-DLIBCXXABI_ENABLE_THREADS=ON'
    '-DLIBCXXABI_HAS_PTHREAD_API=ON'
    '-DLIBCXXABI_HAS_EXTERNAL_THREAD_API=OFF'
    '-DLIBCXXABI_HAS_WIN32_THREAD_API=OFF'

    # Note: https://github.com/WebAssembly/wasi-sdk/blob/wasi-sdk-34/cmake/wasi-sdk-sysroot.cmake#L23
    '-DLIBCXXABI_USE_LLVM_UNWINDER=OFF'

    '-DLIBCXXABI_LIBDIR_SUFFIX=/wasm32-wasi'
    '-DLIBUNWIND_ENABLE_SHARED=OFF'
    '-DLIBUNWIND_ENABLE_THREADS=ON'
    '-DLIBUNWIND_USE_COMPILER_RT=ON'
    '-DLIBUNWIND_INCLUDE_TESTS=OFF'
    '-DLIBCXX_INCLUDE_TESTS=OFF'
    '-DLIBCXX_INCLUDE_BENCHMARKS=OFF'
)

# Note: Static, architecture-agnostic libraries.
NOSTATIC=0
ABSTRIP=0
ABSPLITDBG=0
ABHOST=noarch
