abinfo "Creating build directories for compiler-rt, libcxx/libcxxabi ..."
mkdir -pv "$SRCDIR"/{compiler-rt,runtimes}-build

cd "$SRCDIR"/compiler-rt-build

abinfo "Configuring compiler-rt (WASI) ..."
cmake \
    "$SRCDIR"/compiler-rt \
    -GNinja \
    "${CMAKE_DEF[@]}" \
    "${CMAKE_AFTER__COMMON[@]}" \
    "${CMAKE_AFTER__COMPILIER_RT[@]}"

abinfo "Building compiler-rt (WASI) ..."
ninja

abinfo "Installing compiler-rt (WASI) ..."
DESTDIR="$PKGDIR" \
    ninja install

cd "$SRCDIR"/runtimes-build

abinfo "Configuring libcxx/libcxxabi (WASI) ..."
cmake \
    "$SRCDIR"/runtimes \
    -GNinja \
    "${CMAKE_DEF[@]}" \
    "${CMAKE_AFTER__COMMON[@]}" \
    "${CMAKE_AFTER__RUNTIMES[@]}"

abinfo "Building libcxx/libcxxabi (WASI) ..."
ninja

abinfo "Installing libcxx/libcxxabi (WASI) ..."
DESTDIR="$PKGDIR" \
    ninja install

abinfo "Moving compiler-rt files to the linker builtin path ..."
mkdir -pv "$PKGDIR"/usr/lib/llvm-${LLVM_VER%%.*}/lib/clang/"${LLVM_VER}"/lib/wasm32-unknown-wasip1/
mv -v "$PKGDIR"/usr/lib/wasm32-wasi/lib/wasm32-unknown-wasip1/* \
    "$PKGDIR"/usr/lib/llvm-${LLVM_VER%%.*}/lib/clang/"${LLVM_VER}"/lib/wasm32-unknown-wasip1/
# Note: Use rmdir(1) as a way to ensure we did not remove non-empty
# directories (or that we have unwanted stuff installed in the libdir).
rmdir -v \
    "$PKGDIR"/usr/lib/wasm32-wasi/lib/wasm32-unknown-wasip1/
rmdir -v \
    "$PKGDIR"/usr/lib/wasm32-wasi/lib/

abinfo "Correcting target-specific header installation path ..."
cp -rv "$PKGDIR"/usr/lib/wasm32-wasi/include/wasm32-unknown-wasip1/c++ \
     "$PKGDIR"/usr/lib/wasm32-wasi/include/
rm -rv \
    "$PKGDIR"/usr/lib/wasm32-wasi/include/wasm32-unknown-wasip1/
