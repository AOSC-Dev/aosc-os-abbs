PKGNAME=virt-viewer
PKGSEC=utils
PKGDEP="gtk-vnc libspice-gtk libvirt-glib libgovirt vte rest"
BUILDDEP="intltool spice-protocol"
PKGDES="A graphical viewer for the guest OS display"

MESON_AFTER=(
    -Dlibvirt=enabled
    -Dvnc=enabled
    -Dspice=enabled
    -Dovirt=enabled
    -Dvte=enabled
    -Dbash_completion=enabled
    -Dos-id="AOSC OS"
)
