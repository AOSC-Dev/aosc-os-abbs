From 12f0c3b453d865804b2caeb23d6f2ff25a7ac544 Mon Sep 17 00:00:00 2001
From: CAB233 <yidaduizuoye@outlook.com>
Date: Sun, 30 Aug 2026 00:23:21 +0800
Subject: [PATCH] fix cannot detect package manager on aosc

Fix supermin package manager detection when building libguestfs.

---
 src/ph_dpkg.ml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/ph_dpkg.ml b/src/ph_dpkg.ml
index 6d4fce1..73935ae 100644
--- a/src/ph_dpkg.ml
+++ b/src/ph_dpkg.ml
@@ -29,7 +29,7 @@ let dpkg_detect () =
     Config.dpkg_query <> "no" &&
     Config.dpkg_divert <> "no" &&
     Config.apt_get <> "no" &&
-    (List.mem (Os_release.get_id ()) [ "debian"; "ubuntu" ] ||
+    (List.mem (Os_release.get_id ()) [ "debian"; "ubuntu"; "aosc" ] ||
      try (stat "/etc/debian_version").st_kind = S_REG with Unix_error _ -> false)
 
 let dpkg_primary_arch = ref ""
-- 
2.55.0

