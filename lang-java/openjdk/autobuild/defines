PKGNAME=openjdk
PKGSEC=java
PKGDEP="openjdk-25"
PKGDES="OpenJDK Java Runtime Environment (JRE) and Java Development Environment (JDK) (LTS version)"

ABHOST=noarch

# Note: Extra Provides for Spiral (Debian compatibility).
#
# We do not distinguish between headless and full JDK/JRE installations,
# and note additionally that java-common is not marked here as we do not
# ship update-java-alternatives(8) or /usr/share/java/java_defaults.mk.
PKGPROV="""
default-jdk_spiral
default-jdk-headless_spiral
default-jre_spiral
default-jre-headless_spiral
"""
