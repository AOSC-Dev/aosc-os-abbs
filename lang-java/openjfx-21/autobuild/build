OPENJFX_SUFFIX="-21"

export CXXFLAGS="${CXXFLAGS} -Wno-expansion-to-defined -fPIC "
export CFLAGS="${CFLAGS} -Wno-expansion-to-defined -fPIC "
unset _JAVA_OPTIONS
unset VERSION

abinfo "Making gradlew excutable ..."
chmod -v a+x gradlew

abinfo "Disabling webkit for unsupported architectures ..."
BUILD_WEBKIT="true"
# FIXME: On these architectures, webkit cannot be built
# RISC-V: /var/cache/acbs/build/acbs.f7qyi77d/openjfx-25/modules/javafx.web/src/main/native/Source/JavaScriptCore/offlineasm/ast.rb:1004:in 'Instruction#lowerDefault': Unhandled opcode transferp at WebAssembly.asm:720 (due to WebAssembly.asm:720) (LoweringError)
# PPC64EL, LOONGSON3: /var/cache/acbs/build/acbs.flzq67wt/openjfx-25/modules/javafx.web/src/main/native/Source/WTF/wtf/StackPointer.cpp:175:2: error: #error "Unsupported platform: need implementation of currentStackPointer."
#  175 | #error "Unsupported platform: need implementation of currentStackPointer."
#      |  ^~~~~
if ab_match_arch "@(ppc64el|riscv64|loongson3)"; then
    BUILD_WEBKIT="false"
fi

abinfo "Configuring OpenJFX..."
cat << EOF > gradle.properties
COMPILE_WEBKIT=${BUILD_WEBKIT}
COMPILE_MEDIA=true
CONF=Release
COMPANY_NAME="AOSC"
RELEASE_SUFFIX=-aosc
EOF

abinfo "Building OpenJFX ..."
"$SRCDIR"/gradlew --no-daemon jmods

abinfo "Installing OpenJFX ..."
install -Dvm644 "$SRCDIR"/build/jmods/* -t "$PKGDIR"/usr/lib/openjfx"${OPENJFX_SUFFIX}"/jmods/
install -Dvm644 "$SRCDIR"/build/sdk/lib/* -t "$PKGDIR"/usr/lib/openjfx"${OPENJFX_SUFFIX}"/lib/
chmod -v +x "$PKGDIR"/usr/lib/openjfx"${OPENJFX_SUFFIX}"/lib/*.so
