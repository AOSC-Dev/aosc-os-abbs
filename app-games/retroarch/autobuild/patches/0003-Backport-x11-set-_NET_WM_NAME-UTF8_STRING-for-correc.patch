From 517e34e4215a365aa282a35927cd77902228612e Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Tue, 18 Aug 2026 14:42:18 +0800
Subject: [PATCH 3/4] Backport: x11: set _NET_WM_NAME (UTF8_STRING) for correct
 non-ASCII

Source: https://github.com/libretro/RetroArch/commit/568dd77fc041fe64ca47ae6e4b4a8df9de00d85a
Original commit message:
x11: set _NET_WM_NAME (UTF8_STRING) for correct non-ASCII titles
The window title was published only via the ICCCM WM_NAME property
with type STRING (Latin-1). RetroArch's title may contain UTF-8
(e.g. Japanese ROM names), so EWMH-aware window managers displayed
it incorrectly (#18444).

Additionally publish the title through the EWMH _NET_WM_NAME and
_NET_WM_ICON_NAME properties with type UTF8_STRING. Window managers
that implement EWMH prefer these over WM_NAME and will render the
UTF-8 title correctly.

The change is deliberately additive and non-regressive:

  - The legacy WM_NAME/STRING write is left exactly as-is, so window
    managers that only understand ICCCM keep receiving precisely the
    bytes they get today.
  - The EWMH atoms are interned at runtime (UTF8_STRING is not a
    predefined atom); if interning fails, only WM_NAME is set and the
    behaviour is identical to before.
  - The EWMH block is guarded by X_HAVE_UTF8_STRING, matching the
    existing convention in this file, so builds without UTF-8 X
    support are unaffected.

x11_update_title() is the single title entry point for all X11
context drivers (GL via x_ctx, EGL via xegl_ctx, and XVideo), and is
invoked both at window creation and on live title updates, so this
covers initial and subsequent titles everywhere with one change.

The screensaver-suspend path that writes a placeholder WM_NAME is
intentionally left untouched to preserve its xdg-screensaver
workaround.
---
 gfx/common/x11_common.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/gfx/common/x11_common.c b/gfx/common/x11_common.c
index 901cea170d..def004a4d6 100644
--- a/gfx/common/x11_common.c
+++ b/gfx/common/x11_common.c
@@ -813,8 +813,41 @@ void x11_update_title(void *data)
    title[0]  = '\0';
    _len      = video_driver_get_window_title(title, sizeof(title));
    if (title[0])
+   {
+      /* Legacy ICCCM property. Kept for window managers that do not
+       * understand EWMH. The encoding of WM_NAME is nominally STRING
+       * (Latin-1), but RetroArch's title may contain UTF-8; this is
+       * preserved as-is to avoid changing long-standing behaviour for
+       * old clients, which is exactly what they receive today. */
       XChangeProperty(g_x11_dpy, g_x11_win, XA_WM_NAME, XA_STRING,
             8, PropModeReplace, (const unsigned char*)title, _len);
+
+#ifdef X_HAVE_UTF8_STRING
+      /* EWMH properties. Window managers that implement EWMH prefer
+       * _NET_WM_NAME (UTF8_STRING) over WM_NAME, so non-Latin-1 titles
+       * (e.g. Japanese ROM names) render correctly. This is purely
+       * additive: the atoms are interned at runtime and, if either is
+       * unavailable, the legacy WM_NAME above is the sole fallback, so
+       * older clients are never broken. */
+      {
+         Atom XA_NET_WM_NAME      = XInternAtom(g_x11_dpy, "_NET_WM_NAME",      False);
+         Atom XA_NET_WM_ICON_NAME = XInternAtom(g_x11_dpy, "_NET_WM_ICON_NAME", False);
+         Atom XA_UTF8_STRING      = XInternAtom(g_x11_dpy, "UTF8_STRING",       False);
+
+         if (XA_UTF8_STRING)
+         {
+            if (XA_NET_WM_NAME)
+               XChangeProperty(g_x11_dpy, g_x11_win, XA_NET_WM_NAME,
+                     XA_UTF8_STRING, 8, PropModeReplace,
+                     (const unsigned char*)title, _len);
+            if (XA_NET_WM_ICON_NAME)
+               XChangeProperty(g_x11_dpy, g_x11_win, XA_NET_WM_ICON_NAME,
+                     XA_UTF8_STRING, 8, PropModeReplace,
+                     (const unsigned char*)title, _len);
+         }
+      }
+#endif
+   }
 }
 
 bool x11_input_ctx_new(bool true_full)
