abinfo "Installing BakaXL Bunny ..."
install -v -Dm755 \
    "${SRCDIR}/data/usr/bin/bakaxl-bunny" \
    "${PKGDIR}/usr/bin/bakaxl-bunny"

install -v -Dm644 \
    "${SRCDIR}/data/usr/share/applications/BakaXL.desktop" \
    "${PKGDIR}/usr/share/applications/BakaXL.desktop"

cp -v -a \
    "${SRCDIR}/data/usr/share/icons" \
    "${PKGDIR}/usr/share/"