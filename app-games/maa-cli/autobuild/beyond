abinfo "Installing Bash completion ..."
install -Dm644 <("$PKGDIR"/usr/bin/maa complete bash) \
    "$PKGDIR/usr/share/bash-completion/completions/maa"

abinfo "Installing Zsh completion ..."
install -Dm644 <("$PKGDIR"/usr/bin/maa complete zsh) \
    "$PKGDIR/usr/share/zsh/site-functions/_maa"

abinfo "Installing Fish completion ..."
install -Dm644 "$SRCDIR"/crates/maa-cli/completions/maa.fish \
    "$PKGDIR/usr/share/fish/vendor_completions.d/maa.fish"

abinfo "Generating man pages ..."
mkdir -p "$PKGDIR/usr/share/man/man1"
"$PKGDIR/usr/bin/maa" mangen --path "$PKGDIR/usr/share/man/man1"