PKGNAME=dolphin-emu
PKGSEC=games
PKGDEP="bluez enet ffmpeg libao libevdev lzo miniupnpc openal-soft portaudio \
        pugixml pulseaudio sdl2 sfml soundtouch qt-6 xdg-utils hidapi"
PKGDES="Gamecube/Wii emulator"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DENABLE_LTO=ON'
    '-DENABLE_WX=OFF'
    '-DUSE_SHARED_ENET=ON'
    '-DUSE_SHARED_GTEST=ON'
    '-DENABLE_ANALYTICS=OFF'
    '-DENABLE_AUTOUPDATE=OFF'
    '-DDISTRIBUTOR=Anthon Open Source Community'
    # Note: Default to JIT-less (generic) build.
    '-DENABLE_GENERIC=ON'
)
CMAKE_AFTER__JIT=(
    # Note: Disable generic build for JIT-enabled architectures.
    "${CMAKE_AFTER[@]}"
    '-DENABLE_GENERIC=OFF'
)
CMAKE_AFTER__AMD64=(
    "${CMAKE_AFTER__JIT[@]}"
)
CMAKE_AFTER__ARM64=(
    "${CMAKE_AFTER__JIT[@]}"
)
