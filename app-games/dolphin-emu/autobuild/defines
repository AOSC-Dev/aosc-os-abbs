PKGNAME=dolphin-emu
PKGSEC=games
PKGDEP="bluez enet ffmpeg libao libevdev lzo miniupnpc openal-soft portaudio \
        pugixml pulseaudio sdl2 sfml soundtouch qt-6 xdg-utils hidapi"
PKGDES="Gamecube/Wii emulator"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DENABLE_LTO=ON'
    '-DENABLE_WX=OFF'
    '-DUSE_SHARED_ENET=ON'
    '-DUSE_SHARED_GTEST=ON'
    '-DENABLE_ANALYTICS=OFF'
    '-DENABLE_AUTOUPDATE=OFF'
    '-DDISTRIBUTOR=Anthon Open Source Community'
)
