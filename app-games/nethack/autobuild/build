abinfo "Building NetHack ..."
cd sys/unix
sh setup.sh hints/linux.500
cd $SRCDIR
make CPPFLAGS="${CPPFLAGS} ${CFLAGS} ${LDFLAGS}"

abinfo "Building manpages ..."
make PREFIX="$PKGDIR" \
    MANDIR="$PKGDIR"/usr/share/man/man6 \
    VARDIR="$PKGDIR"/var/games/nethack \
    HACKDIR="$PKGDIR"/usr/lib/nethack \
    install manpages

abinfo "Installing NetHack ..."
install -dvm755 "$PKGDIR"/usr/share/{man/man6,doc/nethack}
install -dvm775 "$PKGDIR"/var/games/nethack
install -dvm775 "$PKGDIR"/etc/nethack

abinfo "Editting path ..."
sed -e "s|HACKDIR=$PKGDIR/|HACKDIR=/|" \
    -e 's|HACK=$HACKDIR|HACK=/usr/lib/nethack|' \
    -i "$PKGDIR"/usr/bin/nethack

mv -v "$PKGDIR"/usr/lib/nethack/{nhdat,symbols} "$PKGDIR"/var/games/nethack
mv -v "$PKGDIR"/usr/lib/nethack/sysconf "$PKGDIR"/etc/nethack
