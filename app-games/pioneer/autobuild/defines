PKGNAME=pioneer
PKGSEC=games
# FIXME: Lua 5.2 required, newer versions not compatible. Bundling as this
# is the only user.
PKGDEP="assimp fmt glew libsigc++ lz4 sdl2-image openal-soft"
PKGDES="Space adventure game set in the Milky Way galaxy at the turn of the 31st century"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_WITH_OPENAL=ON'
    '-DPIONEER_INSTALL_INPLACE=OFF'
    '-DPROFILER_ENABLED=OFF'

# Note: Enable remote LUA console.
#
# Upstream defaults to OFF - maybe not?
    '-DREMOTE_LUA_REPL=OFF'

    '-DUSE_ASAN=OFF'
    '-DUSE_AVX2=OFF'
    '-DUSE_LLD_LINKER=OFF'
    '-DUSE_PIONEER_THIRDPARTY=OFF'
    '-DUSE_SSE42=OFF'
    '-DUSE_SYSTEM_LIBGLEW=ON'

# FIXME: Lua 5.2 required, newer versions not compatible. Bundling as this
# is the only user.
    '-DUSE_SYSTEM_LIBLUA=OFF'

    '-DUSE_TIME_TRACE=OFF'

# Note: Include various extra keybindings for dev functions.
#
# Upstream defaults to ON - following.
    '-DWITH_DEVKEYS=ON'
    '-DWITH_OBJECTVIEWER=ON'
)

PKGPROV="pioneerspacesim"
