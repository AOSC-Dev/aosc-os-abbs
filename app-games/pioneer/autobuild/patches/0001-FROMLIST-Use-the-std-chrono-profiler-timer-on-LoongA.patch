From 1011672f6090a901308698c142e1e07e3342ec6a Mon Sep 17 00:00:00 2001
From: Zhou Qiankang <wszqkzqk@qq.com>
Date: Tue, 3 Nov 2026 02:32:17 +0000
Subject: [PATCH] FROMLIST: Use the std::chrono profiler timer on LoongArch

LoongArch needs the chrono path like the other non-x86 targets.

Link: https://github.com/pioneerspacesim/pioneer/pull/6462
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 contrib/profiler/Profiler.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/contrib/profiler/Profiler.h b/contrib/profiler/Profiler.h
index e7c69ce60..f54342724 100644
--- a/contrib/profiler/Profiler.h
+++ b/contrib/profiler/Profiler.h
@@ -8,7 +8,7 @@
 #define __PROFILER_FULL_TYPE_EXPANSION__
 
 //#define USE_CHRONO
-#if !defined(USE_CHRONO) && (defined(__arm__) || defined(__aarch64__) || defined(__PPC64__) || defined(_M_AMD64) || defined(_WIN64) || defined(_M_X64) || defined(__riscv))
+#if !defined(USE_CHRONO) && (defined(__arm__) || defined(__aarch64__) || defined(__PPC64__) || defined(_M_AMD64) || defined(_WIN64) || defined(_M_X64) || defined(__riscv) || defined(__loongarch__))
 // this isn't optional for __arm__ or x64 builds
 #define USE_CHRONO
 #endif
-- 
2.56.0

