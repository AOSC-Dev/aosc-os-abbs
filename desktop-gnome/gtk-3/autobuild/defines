PKGNAME=gtk-3
PKGSEC=x11
PKGDEP="adwaita-icon-theme at-spi2-core cairo colord x11-lib pango libepoxy \
        shared-mime-info wayland libxkbcommon gdk-pixbuf cups glib harfbuzz \
        fribidi fontconfig"
PKGDEP__RETRO=" \
        adwaita-icon-theme at-spi2-core cairo x11-lib pango libepoxy \
        shared-mime-info libxkbcommon gdk-pixbuf"
BUILDDEP="gobject-introspection wayland-protocols"
BUILDDEP__RETRO=""
PKGDES="GIMP toolkit version 3"

MESON_AFTER=(
    '-Dx11_backend=true'
    '-Dwayland_backend=true'
    '-Dbroadway_backend=true'
    '-Dintrospection=true'
    '-Dgtk_doc=false'
    '-Dman=true'
    '-Dcolord=yes'
    '-Dprint_backends=auto'
    '-Dprofiler=false'
    '-Dbuiltin_immodules=all'
)
MESON_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-Dwayland_backend=false'
    '-Dbroadway_backend=false'
    '-Dintrospection=false'
    '-Dcolord=no'
    '-Dbuiltin_immodules=backend'
)
