PKGNAME=gnome-shell
PKGSEC=gnome
PKGDEP="accountsservice gcr gjs gnome-bluetooth gnome-menus upower \
        gnome-session gnome-settings-daemon gsettings-desktop-schemas \
        libcanberra libcroco libsecret mutter network-manager-applet \
        telepathy-logger telepathy-mission-control unzip gstreamer \
        evolution-data-server python-3 gnome-autoar gnome-control-center \
        gtk-4 xdg-desktop-portal-gnome gtk-update-icon-cache"
BUILDDEP="appstream-glib gobject-introspection intltool sassc asciidoc"
PKGDES="The default GNOME desktop interface"

MESON_AFTER=(
    '-Dextensions_tool=true'
    '-Dextensions_app=true'
    '-Dgtk_doc=false'
    '-Dman=true'
    '-Dnetworkmanager=true'
    '-Dsystemd=true'
    '-Dsoup2=true'
)
