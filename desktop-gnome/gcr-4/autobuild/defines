PKGNAME=gcr-4
PKGSEC=libs
PKGDEP="glib glibc gtk-4 libgcrypt libsecret openssh pango p11-kit systemd"
BUILDDEP="gobject-introspection vala"
PKGDES="Libraries used for displaying certificates and accessing key stores(GTK-4)"

ABTYPE=meson
MESON_AFTER=(
    '-Dintrospection=true'
    '-Dvapi=true'
    '-Dgtk4=true'
    '-Dgtk_doc=false'
    '-Dcrypto=libgcrypt'
    '-Dssh_agent=true'
    '-Dsystemd=enabled'
)
