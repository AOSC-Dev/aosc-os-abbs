PKGNAME=glade
PKGSEC=devel
PKGDEP="gtk-3 libxml2 desktop-file-utils hicolor-icon-theme python-3 \
        devhelp gjs pygobject-3 webkit2gtk-4.0"
BUILDDEP="gobject-introspection gtk-doc intltool itstool"
PKGDES="User interface builder for GTK+ and GNOME"

ABTYPE=meson
MESON_AFTER=(
    '-Dgladeui=true'
    '-Dgjs=enabled'
    '-Dpython=enabled'
    '-Dwebkit2gtk=enabled'
    '-Dgtk_doc=false'
    '-Dintrospection=true'
    '-Dman=true'
)
