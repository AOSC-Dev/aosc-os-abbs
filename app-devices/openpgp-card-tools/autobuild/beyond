abinfo "Generate completions and manpages ..."
mkdir -pv "$SRCDIR"/completions
OCT_COMPLETION_OUTPUT_DIR="$SRCDIR"/completions "$PKGDIR"/usr/bin/oct
mkdir -pv "$SRCDIR"/man
OCT_MANPAGE_OUTPUT_DIR="$SRCDIR"/man "$PKGDIR"/usr/bin/oct

abinfo "Installing manpages to /usr/share/man/man1 ..."
mkdir -pv "$PKGDIR"/usr/share/man/man1
cp -av "$SRCDIR"/man/*.1 "$PKGDIR"/usr/share/man/man1/

abinfo "Installing bash completions ..."
mkdir -pv "$PKGDIR"/usr/share/bash-completion/completions
cp -v "$SRCDIR"/completions/oct.bash \
	"$PKGDIR"/usr/share/bash-completion/completions/oct.bash

abinfo "Installing zsh completions ..."
mkdir -pv "$PKGDIR"/usr/share/zsh/functions/Completion/Linux
cp -v "$SRCDIR"/completions/_oct \
	"$PKGDIR"/usr/share/zsh/functions/Completion/Linux/_oct

abinfo "Installing fish completions ..."
mkdir -pv "$PKGDIR"/usr/share/fish/vendor_completions.d/
cp -v "$SRCDIR"/completions/oct.fish \
	"$PKGDIR"/usr/share/fish/vendor_completions.d/oct.fish

abinfo "Installing pwsh completions ..."
mkdir -pv "$PKGDIR"/usr/share/powershell/completions
cp -v "$SRCDIR"/completions/_oct.ps1 \
	"$PKGDIR"/usr/share/powershell/completions/_oct.ps1

