PKGNAME=android-platform-tools
PKGSEC=utils
PKGDES="Android platform tools, adb, mkbootimg, fastboot, and simg2img"
PKGDEP="brotli fmt libusb lz4 pcre2 protobuf zstd"
PKGPROV="android-tools-adb_spiral"
BUILDDEP="gtest rustc corrosion"
PKGRECOM="android-udev"

PKGBREAK="android-simg2img<=1.1.4-1"
PKGREP="$PKGBREAK"
ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DANDROID_TOOLS_LIBUSB_ENABLE_UDEV=ON'
)

FAIL_ARCH="!(amd64|arm64|ppc64el|loongarch64)"
