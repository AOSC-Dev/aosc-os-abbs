PKGNAME=tpm2-tools
PKGSEC=admin
PKGDEP="glibc tpm2-tss curl openssl"
PKGDES="Trusted Platform Module 2.0 tools"

ABTYPE=autotools
AUTOTOOLS_AFTER=()
# FIXME: configure: error: Cannot enable -fstack-protector-all, consider configuring with --disable-hardening
AUTOTOOLS_AFTER__NOSSP=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-hardening'
)

AUTOTOOLS_AFTER__ALPHA=("${AUTOTOOLS_AFTER_NOSSP[@]}")
AUTOTOOLS_AFTER__IA64=("${AUTOTOOLS_AFTER_NOSSP[@]}")

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
