abinfo "Installing vds udev rules ..."
install -Dvm644 "$SRCDIR"/99-vds-dualsense-udev.rules \
    -t "$PKGDIR"/usr/lib/udev/rules.d/

abinfo "Installing vds wireplumber configuration ..."
install -Dvm644 "$SRCDIR"/99-vds-dualsense-wireplumber.conf \
    -t "$PKGDIR"/usr/share/wireplumber/wireplumber.conf.d/

abinfo "Installing bluetoothd workaround script ..."
install -Dvm755 "$SRCDIR"/override-bluetoothd.sh \
    -t "$PKGDIR"/usr/share/vds/

abinfo "Filling in PACKAGE_VERSION in dkms.conf ..."
sed -e "s|PACKAGE_VERSION=\"unknown\"|PACKAGE_VERSION=${PKGVER/\~/_}|" \
    -i "$SRCDIR"/module/dkms.conf

abinfo "Installing kernel module sources ..."
install -dvm644 "$PKGDIR"/usr/src/
cp -av "$SRCDIR"/module "$PKGDIR"/usr/src/vds_hcd-"${PKGVER/\~/_}"
cp -av "$SRCDIR"/include "$PKGDIR"/usr/src/vds_hcd-"${PKGVER/\~/_}"/
