PKGNAME=opensc
PKGSEC=admin
PKGDEP="libtool openssl pcsclite"
BUILDDEP="docbook-xsl"
PKGDES="Tools and libraries to work with smart cards"

AUTOTOOLS_AFTER=(
    '--enable-man'
    '--disable-doc'
    '--enable-readline'
    '--enable-openssl'
    '--enable-pcsc'
    '--enable-zlib'
    '--enable-sm'
    '--with-xsl-stylesheetsdir=/usr/share/xml/docbook/xsl-stylesheets-1.79.2'
)

PKGBREAK="tdelibs<=14.1.2 rng-tools<=6.17"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
