# Adapted from AUR
# Ref: https://aur.archlinux.org/cgit/aur.git/tree/PKGBUILD?h=yubico-authenticator
abinfo "Setting up flutter ..."
export $(grep '^FLUTTER=' ${SRCDIR}/.github/workflows/env)
fvm install "${FLUTTER}"
fvm global "${FLUTTER}"

abinfo "Disabling flutter analytics ..."
fvm flutter --disable-analytics

abinfo "Modifying .desktop entry ..."
export app_id=com.yubico.yubioath
desktop-file-edit --set-key=Exec --set-value="yubioath-flutter" --set-icon="${app_id}" \
  "${SRCDIR}/resources/linux/linux_support/${app_id}.desktop"

abinfo "Building Helper ..."
sh ${SRCDIR}/build-helper.sh
