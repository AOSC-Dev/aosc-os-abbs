# Adapted from AUR
# Ref: https://aur.archlinux.org/cgit/aur.git/tree/PKGBUILD?h=yubico-authenticator
abinfo "Building yubioath-flutter"
fvm flutter build linux

abinfo "Installing files ..."

if ab_match_arch amd64; then
    export FLUTTER_ARCH="x64" 
elif ab_match_arch arm64; then
    export FLUTTER_ARCH="arm64"
fi

install -Dvm755 build/linux/${FLUTTER_ARCH}/release/bundle/authenticator -t \
  "${PKGDIR}/usr/lib/${PKGNAME}/"
install -Dvm755 build/linux/${FLUTTER_ARCH}/release/bundle/helper/authenticator-helper \
  "${PKGDIR}/usr/lib/${PKGNAME}/helper/authenticator-helper"
cp -rv build/linux/${FLUTTER_ARCH}/release/bundle/{data,lib,helper} "${PKGDIR}/usr/lib/${PKGNAME}"
find "${PKGDIR}"/usr/lib/yubioath-flutter/helper -name '*.so*' -exec chmod -v +x {} \;

abinfo "Creating symlink to /usr/bin ..."
install -dv "${PKGDIR}/usr/bin"
ln -sv "../lib/${PKGNAME}/authenticator" "${PKGDIR}/usr/bin/yubioath-flutter"

abinfo "Installing icons and .desktop entry ..."
install -Dvm644 "${SRCDIR}/resources/icons/${app_id}.png" \
  "${PKGDIR}/usr/share/icons/hicolor/128x128/apps/${app_id}.png"
install -Dvm644 "${SRCDIR}/resources/icons/${app_id}-32x32.png" \
  "${PKGDIR}/usr/share/icons/hicolor/32x32/apps/${app_id}.png"
install -Dvm644 "${SRCDIR}/resources/icons/${app_id}-1000x1000.png" \
  "${PKGDIR}/usr/share/icons/hicolor/1000x1000/apps/${app_id}.png"
install -Dvm644 "${SRCDIR}/resources/linux/linux_support/${app_id}.desktop" \
  "${PKGDIR}/usr/share/applications/${app_id}.desktop"
