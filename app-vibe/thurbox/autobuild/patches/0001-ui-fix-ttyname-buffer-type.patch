From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: linmont <admin@furry.blue>
Date: Sat, 3 Oct 2026 13:18:27 +0800
Subject: [PATCH] ui: fix ttyname buffer type

---
 src/ui_control.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/ui_control.rs b/src/ui_control.rs
index ffb3da59141d7b35756bd567284ccebcb5b9c56e..380a86a6a3d4861c0bf2ca9c263868d596eb61cf 100644
--- a/src/ui_control.rs
+++ b/src/ui_control.rs
@@ -32,10 +32,10 @@ fn terminal_hint() -> Option<String> {
     if let Some(tty) = std::env::var_os("SSH_TTY") {
         return Some(tty.to_string_lossy().into_owned());
     }
-    let mut buffer = [0i8; 256];
-    let status = unsafe { libc::ttyname_r(libc::STDIN_FILENO, buffer.as_mut_ptr(), buffer.len()) };
+    let mut buffer = [0u8; 256];
+    let status = unsafe { libc::ttyname_r(libc::STDIN_FILENO, buffer.as_mut_ptr().cast(), buffer.len()) };
     (status == 0).then(|| {
-        unsafe { std::ffi::CStr::from_ptr(buffer.as_ptr()) }
+        unsafe { std::ffi::CStr::from_ptr(buffer.as_ptr().cast()) }
             .to_string_lossy()
             .into_owned()
     })

base-commit: 8dd09795ee79d071dbb29af8914c9269bec8ed0f
