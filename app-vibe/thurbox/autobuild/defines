PKGNAME=thurbox
PKGSEC=utils
PKGDEP="tmux git sqlite glibc"
BUILDDEP="rustc cargo llvm-22 pkg-config"
PKGRECOM="claude-code aider-chat opencode-bin"
PKGDES="TUI for orchestrating multiple coding-agent CLI sessions in persistent tmux panels"
PKGPROV="clang"
ABTYPE=rust
NOLTO=1
NOCARGOAUDIT=1
CARGO_AFTER="--offline --bin thurbox --bin thurbox-cli"
export RUSTUP_TOOLCHAIN=stable
export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
export THURBOX_RELEASE_VERSION="v$VER"
