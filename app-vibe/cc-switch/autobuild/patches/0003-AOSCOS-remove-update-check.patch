From 71c930f69787e582b6149bdd54203f20040e345e Mon Sep 17 00:00:00 2001
From: Suyun <suyun@aosc.io>
Date: Thu, 17 Sep 2026 10:56:24 +0800
Subject: [PATCH 3/3] AOSCOS: remove update check

- Remove "Check for Updates" button and relevant messages.
- Always return "up to date" while checking for updates.
---
 src/components/settings/AboutSection.tsx | 31 ------------------------
 src/i18n/locales/en.json                 |  2 +-
 src/i18n/locales/ja.json                 |  2 +-
 src/i18n/locales/zh-TW.json              |  2 +-
 src/i18n/locales/zh.json                 |  2 +-
 src/lib/updater.ts                       | 19 +--------------
 6 files changed, 5 insertions(+), 53 deletions(-)

diff --git a/src/components/settings/AboutSection.tsx b/src/components/settings/AboutSection.tsx
index cde841ae..67970b27 100644
--- a/src/components/settings/AboutSection.tsx
+++ b/src/components/settings/AboutSection.tsx
@@ -936,37 +936,6 @@ export function AboutSection({ isPortable }: AboutSectionProps) {
               <ExternalLink className="h-3.5 w-3.5" />
               {t("settings.releaseNotes")}
             </Button>
-            <Button
-              type="button"
-              size="sm"
-              onClick={handleCheckUpdate}
-              disabled={isChecking || isDownloading}
-              className="h-8 gap-1.5 text-xs"
-            >
-              {isDownloading ? (
-                <>
-                  <Loader2 className="h-3.5 w-3.5 animate-spin" />
-                  {t("settings.updating")}
-                </>
-              ) : hasUpdate ? (
-                <>
-                  <Download className="h-3.5 w-3.5" />
-                  {t("settings.updateTo", {
-                    version: updateInfo?.availableVersion ?? "",
-                  })}
-                </>
-              ) : isChecking ? (
-                <>
-                  <RefreshCw className="h-3.5 w-3.5 animate-spin" />
-                  {t("settings.checking")}
-                </>
-              ) : (
-                <>
-                  <RefreshCw className="h-3.5 w-3.5" />
-                  {t("settings.checkForUpdates")}
-                </>
-              )}
-            </Button>
           </div>
         </div>
 
