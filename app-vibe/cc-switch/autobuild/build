# Ref: https://aur.archlinux.org/cgit/aur.git/tree/PKGBUILD?h=cc-switch

abinfo "Installing dependencies ..."
pnpm install --frozen-lockfile

abinfo "Building CC Switch ..."
cargo tauri build --no-bundle

abinfo "Installing CC Switch ..."
install -Dvm755 "$SRCDIR"/src-tauri/target/release/cc-switch "$PKGDIR"/usr/bin/cc-switch
install -Dvm644 "$SRCDIR"/src-tauri/icons/128x128.png "$PKGDIR"/usr/share/icons/hicolor/128x128/apps/com.ccswitch.desktop.png
install -Dvm644 "$SRCDIR"/src-tauri/icons/128x128@2x.png "$PKGDIR"/usr/share/icons/hicolor/256x256@2/apps/com.ccswitch.desktop.png
install -Dvm644 "$SRCDIR"/src-tauri/icons/32x32.png "$PKGDIR"/usr/share/icons/hicolor/32x32/apps/com.ccswitch.desktop.png
install -Dvm644 "$SRCDIR"/flatpak/com.ccswitch.desktop.desktop "$PKGDIR"/usr/share/applications/com.ccswitch.desktop.desktop
