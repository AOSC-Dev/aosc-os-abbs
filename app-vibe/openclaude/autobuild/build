abinfo "Installing nodejs devDependencies..."
bun install --verbose --frozen-lockfile

abinfo "Building OpenClaude..."
bun run "${SRCDIR}"/scripts/build.ts

abinfo "Minifying nodejs dependencies..."
rm -rv "${SRCDIR}"/node_modules
bun install --verbose --frozen-lockfile --omit=dev --omit=peer
rm -rv "${SRCDIR}"/node_modules/@vscode/ripgrep-linux-*

abinfo "Installing OpenClaude..."
install -Dvm644 -t "${PKGDIR}"/usr/lib/openclaude/dist "${SRCDIR}"/dist/*.mjs
install -Dvm755 -t "${PKGDIR}"/usr/lib/openclaude/bin "${SRCDIR}"/bin/*
cp -av "${SRCDIR}"/node_modules "${PKGDIR}"/usr/lib/openclaude/
ln -sv ../lib/openclaude/bin/openclaude "${PKGDIR}"/usr/bin/openclaude
