abinfo "Installing NPM dependencies ..."
npm ci

abinfo "Building paseo ..."
EXPO_NO_TELEMETRY=1 \
    npm run build:desktop -- --linux --dir --publish never

abinfo "Installing paseo ..."
install -dvm755 "$PKGDIR"/usr/lib/paseo
cp -rv "$SRCDIR"/packages/desktop/release/linux*-unpacked/* "$PKGDIR"/usr/lib/paseo/

abinfo "Creating symbolic links ..."
mkdir -pv "$PKGDIR"/usr/bin
ln -sv ../lib/paseo/Paseo "$PKGDIR"/usr/bin/paseo-desktop
ln -sv ../lib/paseo/resources/bin/paseo "$PKGDIR"/usr/bin/paseo

abinfo "Installing application icon ..."
install -Dvm644 "$SRCDIR"/packages/desktop/assets/icon.png \
    "$PKGDIR"/usr/share/pixmaps/paseo.png

abinfo "Setting previously missing executable bit on libonnxruntime.so ..."
find "$PKGDIR"/usr/lib/paseo/resources/app.asar.unpacked/node_modules -name "*.so*" | xargs chmod -v +x || :
