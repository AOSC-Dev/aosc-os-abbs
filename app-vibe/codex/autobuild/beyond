abinfo "Installing the complete Codex package layout ..."
install -dvm755 "$PKGDIR"/usr/lib/codex/bin
for __binary in codex codex-code-mode-host codex-responses-api-proxy; do
    mv -v "$PKGDIR"/usr/bin/"$__binary" "$PKGDIR"/usr/lib/codex/bin/
    ln -sv "/usr/lib/codex/bin/$__binary" "$PKGDIR"/usr/bin/"$__binary"
done

abinfo "Installing shell completions ..."
"$PKGDIR"/usr/lib/codex/bin/codex completion bash | install -Dvm644 /dev/stdin \
    "$PKGDIR"/usr/share/bash-completion/completions/codex
"$PKGDIR"/usr/lib/codex/bin/codex completion zsh | install -Dvm644 /dev/stdin \
    "$PKGDIR"/usr/share/zsh/site-functions/_codex
"$PKGDIR"/usr/lib/codex/bin/codex completion fish | install -Dvm644 /dev/stdin \
    "$PKGDIR"/usr/share/fish/vendor_completions.d/codex.fish
