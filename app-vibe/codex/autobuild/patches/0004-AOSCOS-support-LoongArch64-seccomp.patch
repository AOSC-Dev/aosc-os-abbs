From 3e8a514676fd443e8ecc3659ec9884f45a68bf35 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Wed, 21 Oct 2026 11:16:44 +0800
Subject: [PATCH 4/6] AOSCOS: support LoongArch64 seccomp

---
 codex-rs/linux-sandbox/src/seccomp.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/linux-sandbox/src/seccomp.rs b/codex-rs/linux-sandbox/src/seccomp.rs
index 7aecf5a7a1..e042fc567f 100644
--- a/codex-rs/linux-sandbox/src/seccomp.rs
+++ b/codex-rs/linux-sandbox/src/seccomp.rs
@@ -289,6 +289,8 @@ fn install_network_seccomp_filter_on_current_thread(
             TargetArch::x86_64
         } else if cfg!(target_arch = "aarch64") {
             TargetArch::aarch64
+        } else if cfg!(target_arch = "loongarch64") {
+            TargetArch::loongarch64
         } else {
             unimplemented!("unsupported architecture for seccomp filter");
         },
