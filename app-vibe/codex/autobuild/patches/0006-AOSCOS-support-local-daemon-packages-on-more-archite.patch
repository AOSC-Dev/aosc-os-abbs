From f73a8c726114f0eb2963c2586f6680437dac0b38 Mon Sep 17 00:00:00 2001
From: SignKirigami <prcups@krgm.moe>
Date: Thu, 22 Oct 2026 11:25:36 +0800
Subject: [PATCH 6/6] AOSCOS: support local daemon packages on more
 architectures

Recognize native GNU/Linux packages on LoongArch64 and RISC-V so that
packaged distribution builds can seed the app-server daemon. This does
not add support for downloading upstream releases on these architectures.

Assisted-by: gpt-6.1-sol
---
 codex-rs/app-server-daemon/src/prepare_install.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/app-server-daemon/src/prepare_install.rs b/codex-rs/app-server-daemon/src/prepare_install.rs
index 3b09a604db..b8a9aff6b2 100644
--- a/codex-rs/app-server-daemon/src/prepare_install.rs
+++ b/codex-rs/app-server-daemon/src/prepare_install.rs
@@ -483,6 +483,8 @@ fn platform_target() -> Result<&'static str> {
         ("linux", "aarch64") => Ok("aarch64-unknown-linux-musl"),
         ("linux", "x86_64") if cfg!(target_env = "gnu") => Ok("x86_64-unknown-linux-gnu"),
         ("linux", "x86_64") => Ok("x86_64-unknown-linux-musl"),
+        ("linux", "loongarch64") if cfg!(target_env = "gnu") => Ok("loongarch64-unknown-linux-gnu"),
+        ("linux", "riscv64") if cfg!(target_env = "gnu") => Ok("riscv64gc-unknown-linux-gnu"),
         ("windows", "aarch64") => Ok("aarch64-pc-windows-msvc"),
         ("windows", "x86_64") => Ok("x86_64-pc-windows-msvc"),
         (os, arch) => Err(anyhow!("unsupported packaged daemon platform {os}/{arch}")),
