GCC_MAJOR="${__MAJOR}"
GCC_DIR="$(gcc-${GCC_MAJOR} --print-file-name=.)"
GCC_DIR="$(realpath "$GCC_DIR")"
abinfo "GCC directory: $GCC_DIR"

abinfo "Collecting shared library names (SONAME) ..."
IFS=$'\n'
LIBS=($((readelf ${GCC_DIR}/lib*.so.* -d 2>/dev/null || true) | grep '(SONAME)' | grep -o '\[.*]' | tr -d '[]'))
unset IFS

abinfo "Installing symlinks ..."
install -dv "$PKGDIR"/usr/lib
for lib in "${LIBS[@]}" ; do
	if [[ "$(dpkg -S $(realpath ${GCC_DIR}/${lib}))" =~ ^gcc-runtime-${GCC_MAJOR} ]]; then
		ln -svf "${GCC_DIR##/usr/lib/}"/"$lib" "$PKGDIR"/usr/lib
	fi
done
