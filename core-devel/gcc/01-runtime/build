GCC_MAJOR="${__MAJOR}"
GCC_DIR="$(gcc-${GCC_MAJOR} --print-file-name=.)"
GCC_DIR="$(realpath "$GCC_DIR")"
abinfo "GCC directory: $GCC_DIR"

abinfo "Collecting shared library names (SONAME) ..."
IFS=$'\n'
LIBS=($((readelf ${GCC_DIR}/lib*.so.* -d 2>/dev/null || true) | grep '(SONAME)' | grep -o '\[.*]' | tr -d '[]'))
unset IFS

abinfo "Installing symlinks ..."
install -dv "$PKGDIR"/usr/lib
for lib in "${LIBS[@]}" ; do
	if [[ "$(dpkg -S $(realpath ${GCC_DIR}/${lib}))" =~ ^gcc-runtime-${GCC_MAJOR} ]]; then
		ln -svf "${GCC_DIR##/usr/lib/}"/"$lib" "$PKGDIR"/usr/lib
	fi
done

abinfo "Removing unneeded symlinks ..."
for omit_libname in libcc1 ; do
	find "$PKGDIR"/usr/lib -type l -name "$omit_libname"'*' -exec rm -v {} \;
done

# NOTE: libunwind.so symlink is for libunwind from libunwind project,
# which holds libunwind.so.8, not the one from libgcc (which holds
# libunwind.so.7).
if ab_match_arch ia64 ; then
	abinfo "Removing libunwind.so symlink ..."
	rm -v "$PKGDIR"/usr/lib/libunwind.so
fi

# WARNING: libgcc_s.so is a linker script which automatically appends
# -lgcc (libgcc.a) and the correct shared library name.
abinfo "Removing invalid libgcc_s.so symlink ..."
unlink "$PKGDIR"/usr/lib/libgcc_s.so
