From 508a67eebf7da4ab35a2295f08c1c3d1200721e5 Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Fri, 19 Jan 2024 20:18:07 +0100
Subject: [PATCH 480/559] IA64: Revert "tty: deprecate tty_write_message()"

This reverts commit 4c74253b831e5a8eb87d4d8d4a0eae40c331e682.

tty_write_message() is used for unaligned access messages on ia64.
Revert its conditional removal until a proper replacement is found.
---
 drivers/tty/tty_io.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/drivers/tty/tty_io.c b/drivers/tty/tty_io.c
index 07e6bf5f8c6f..81736fbda71f 100644
--- a/drivers/tty/tty_io.c
+++ b/drivers/tty/tty_io.c
@@ -1034,7 +1034,6 @@ static ssize_t iterate_tty_write(struct tty_ldisc *ld, struct tty_struct *tty,
 	return ret;
 }
 
-#ifdef CONFIG_PRINT_QUOTA_WARNING
 /**
  * tty_write_message - write a message to a certain tty, not just the console.
  * @tty: the destination tty_struct
@@ -1045,8 +1044,6 @@ static ssize_t iterate_tty_write(struct tty_ldisc *ld, struct tty_struct *tty,
  * needed.
  *
  * We must still hold the BTM and test the CLOSING flag for the moment.
- *
- * This function is DEPRECATED, do not use in new code.
  */
 void tty_write_message(struct tty_struct *tty, char *msg)
 {
@@ -1059,7 +1056,6 @@ void tty_write_message(struct tty_struct *tty, char *msg)
 		tty_write_unlock(tty);
 	}
 }
-#endif
 
 static ssize_t file_tty_write(struct file *file, struct kiocb *iocb, struct iov_iter *from)
 {
