abinfo "Build OpenTrace"
dotnet publish "$SRCDIR"/OpenTrace.csproj -c Release \
    -o "$PKGDIR"/usr/lib/opentrace \
    --no-self-contained

abinfo "Setting executable bit on the main executable ..."
chmod -v +x "$PKGDIR"/usr/lib/opentrace/'OpenTrace'

abinfo "Installing application icon ..."
install -Dvm644 "$SRCDIR"/Assets/Icons/icon.png "$PKGDIR"/usr/share/pixmaps/opentrace.png
