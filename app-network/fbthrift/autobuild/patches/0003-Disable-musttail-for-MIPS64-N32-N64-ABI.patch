From 9ebd217060f29521702b4988765874a99bffe602 Mon Sep 17 00:00:00 2001
From: Henry Chen <henry.chen@oss.cipunited.com>
Date: Thu, 12 Nov 2026 17:58:53 +0800
Subject: [PATCH 3/3] Disable musttail for MIPS64 N32/N64 ABI

MIPS64 ABIs don't allow -fPIC and musttail for default-visibility functions.
---
 thrift/lib/cpp2/protocol/detail/Json5ProtocolReader.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/thrift/lib/cpp2/protocol/detail/Json5ProtocolReader.cpp b/thrift/lib/cpp2/protocol/detail/Json5ProtocolReader.cpp
index e067e5b951..a99e81441a 100644
--- a/thrift/lib/cpp2/protocol/detail/Json5ProtocolReader.cpp
+++ b/thrift/lib/cpp2/protocol/detail/Json5ProtocolReader.cpp
@@ -227,7 +227,10 @@ void Json5ProtocolReader::readFieldBegin(
     [[maybe_unused]] bool isNull =
         std::holds_alternative<std::monostate>(reader_.readPrimitive());
     DCHECK(isNull);
-    FOLLY_ATTR_MUSTTAIL return readFieldBegin(name, fieldType, fieldId);
+#ifndef __mips64
+    FOLLY_ATTR_MUSTTAIL
+#endif
+    return readFieldBegin(name, fieldType, fieldId);
   }
 }
 
