From f6187406fca1851e49fdd31eec0ea9362b4d22a0 Mon Sep 17 00:00:00 2001
From: Henry Chen <henry.chen@oss.cipunited.com>
Date: Mon, 17 Mar 2025 15:35:14 +0800
Subject: [PATCH 1/2] Build whisker and compiler_base as shared libs

---
 thrift/compiler/CMakeLists.txt | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/thrift/compiler/CMakeLists.txt b/thrift/compiler/CMakeLists.txt
index 5985828bdf..6fddc14ef0 100644
--- a/thrift/compiler/CMakeLists.txt
+++ b/thrift/compiler/CMakeLists.txt
@@ -86,7 +86,7 @@ thrift_configure_target(compiler_ast PUBLIC)
 target_link_libraries(compiler_ast fmt::fmt Folly::folly)
 
 # The base compiler infrastructure library
-add_library(compiler_base STATIC detail/system.cc detail/pluggable_functions.cc
+add_library(compiler_base detail/system.cc detail/pluggable_functions.cc
                                  diagnostic.cc source_location.cc)
 set_target_properties(compiler_base PROPERTIES POSITION_INDEPENDENT_CODE
                                                "${BUILD_SHARED_LIBS}")
@@ -143,7 +143,7 @@ target_link_libraries(
   ${FBTHRIFT_COMPILER_LINK_CXXFS})
 
 add_library(
-  whisker STATIC
+  whisker
   whisker/ast.cc
   whisker/dsl.cc
   whisker/detail/string.cc
@@ -192,7 +192,6 @@ install(
   TARGETS thrift
           compiler_ast
           compiler_base
-          compiler_lib
           compiler
           whisker
           common
