Subject: [PATCH 1/2] Build whisker and compiler_base as shared libs

---
 thrift/compiler/CMakeLists.txt | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/thrift/compiler/CMakeLists.txt b/thrift/compiler/CMakeLists.txt
index 56d9c80f82..9fbedb352c 100644
--- a/thrift/compiler/CMakeLists.txt
+++ b/thrift/compiler/CMakeLists.txt
@@ -93,7 +93,6 @@ target_link_libraries(
 # The base compiler infrastructure library
 add_library(
   compiler_base
-  STATIC
 
   detail/system.cc
   detail/pluggable_functions.cc
@@ -168,7 +167,6 @@ target_link_libraries(
 
 add_library(
   whisker
-  STATIC
 
   whisker/ast.cc
   whisker/dsl.cc
@@ -184,7 +182,7 @@ add_library(
 )
 target_link_libraries(
   whisker
-  fmt::fmt
