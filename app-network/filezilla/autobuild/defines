PKGNAME=filezilla
PKGSEC=net
PKGDEP="dbus gnutls libfilezilla libidn pugixml sqlite uplink-c \
        wxgtk3 xdg-utils hicolor-icon-theme fzssh"
BUILDDEP="appstream-glib llvm"

PKGDEP__LOONGSON3=${PKGDEP/uplink-c/}
PKGDES="Graphical FTP, SFTP, and other web file-system client"

ABTYPE=autotools
__AUTOTOOLS_AFTER_COMMON=(
    '--enable-locales'
    '--disable-localesonly'
    # Note: DO NOT USE. Reserved for use by official maintainer.
    #       TYPE can either be 'official' or 'nightly'.
    #'--enable-buildtype=TYPE'
    '--enable-gui'
    '--disable-mac-sandbox'
    '--disable-precomp'
    '--disable-manualupdatecheck'
    '--disable-autoupdatecheck'
    '--enable-ftp'
    '--enable-sftp'
    '--with-pugixml=system'
    '--with-dbus'
)

AUTOTOOLS_AFTER=("${__AUTOTOOLS_AFTER_COMMON[@]}" "--enable-storj")
AUTOTOOLS_AFTER__LOONGSON3=("${__AUTOTOOLS_AFTER_COMMON[@]}")
