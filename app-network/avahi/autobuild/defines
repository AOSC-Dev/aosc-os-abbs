PKGNAME=avahi
PKGSEC=net
PKGDEP="dbus-python expat libcap libdaemon nss-mdns twisted"
PKGDEP__RETRO="expat libcap libdaemon nss-mdns"
PKGSUG="gtk-3 pygobject-3"
PKGSUG__RETRO=""
BUILDDEP="gobject-introspection intltool xmltoman pygobject-3 gtk-3"
BUILDDEP__RETRO="intltool xmltoman"
PKGDES="Service discovery daemon using mDNS/DNS-SD"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--disable-mono'
    '--disable-monodoc'
    '--disable-qt3'
    '--disable-qt4'
    '--disable-qt5'
    '--disable-gtk'
    '--enable-gtk3'
    '--enable-compat-libdns_sd'
    '--enable-compat-howl'
    '--with-distro=archlinux'
    '--with-avahi-priv-access-group=network'
    '--with-autoipd-user=avahi'
    '--with-autoipd-group=avahi'
    '--with-dbus-sys=/usr/share/dbus-1/system.d'
    '--with-systemdsystemunitdir=/usr/lib/systemd/system'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-mono'
    '--disable-monodoc'
    '--disable-python'
    '--disable-pygobject'
    '--disable-python-dbus'
    '--disable-qt3'
    '--disable-qt4'
    '--disable-qt5'
    '--disable-gtk'
    '--disable-gtk3'
)
