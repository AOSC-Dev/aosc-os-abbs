Subject: [PATCH 6/9] UPSTREAM: Add needed macro definitions in subdir
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Björn Esser <besser82@fedoraproject.org>
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 Makefile.am  |  2 ++
 configure.ac |  1 +
 m4/shell.m4  | 62 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 65 insertions(+)
 create mode 100644 m4/shell.m4

diff --git a/Makefile.am b/Makefile.am
index 8ed92d3..3711720 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -20,6 +20,8 @@
 ## 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
 ##
 
+ACLOCAL_AMFLAGS   =    -I m4
+
 AUTOMAKE_OPTIONS  =    foreign no-dependencies
 
 WARN_CFLAGS       =    @WARN_CFLAGS@
diff --git a/configure.ac b/configure.ac
index 77b6900..6d3089e 100644
--- a/configure.ac
+++ b/configure.ac
@@ -9,6 +9,7 @@ AC_INIT(
   m4_esyscmd_s([sed -ne 's/.*version_string.*"\(.*\)"\;/\1/p' src/version.c]),
 ) 
 AC_CONFIG_AUX_DIR(utils)  
+AC_CONFIG_MACRO_DIR(m4)
 AM_INIT_AUTOMAKE
 AC_CONFIG_SRCDIR([src/setup.h])
 AC_CONFIG_HEADERS(include/config.h)
diff --git a/m4/shell.m4 b/m4/shell.m4
new file mode 100644
index 0000000..56463af
--- /dev/null
+++ b/m4/shell.m4
@@ -0,0 +1,62 @@
+# Check for a working shell.
+
+# Copyright (C) 2000, 2001, 2007 Free Software Foundation, Inc.
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 2, or (at your option)
+# any later version.
+
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write to the Free Software
+# Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA
+# 02111-1307, USA.
+
+# AC_PROG_SHELL
+# -------------
+# Check for a working (i.e. POSIX-compatible) shell.
+# Written by Paul Eggert <eggert@twinsun.com>,
+# from an idea suggested by Albert Chin-A-Young <china@thewrittenword.com>.
+AC_DEFUN([AC_PROG_SHELL],
+  [AC_MSG_CHECKING(for a POSIX-compliant shell)
+   AC_CACHE_VAL(ac_cv_path_shell,
+     [ac_cv_path_shell=no
+      IFS="${IFS=      }"; ac_save_ifs="$IFS"; IFS=":"
+      ac_dummy=/bin:/usr/bin:/usr/bin/posix:/usr/xpg4/bin:$PATH
+      for ac_dir in $ac_dummy; do
+       for ac_base in sh bash ksh sh5; do
+         case "$ac_dir" in
+         /*)
+           if ("$ac_dir/$ac_base" -c '
+
+                 # Test the noclobber option,
+                 # using the portable POSIX.2 syntax.
+                 set -C
+                 rm -f conftest.c || exit
+                 >conftest.c || exit
+                 >|conftest.c || exit
+                 !>conftest.c || exit
+
+               ') 2>/dev/null; then
+             ac_cv_path_shell="$ac_dir/$ac_base"
+             break
+           fi
+           ;;
+         esac
+       done
+       if test "$ac_cv_path_shell" != no; then
+         break
+       fi
+      done
+      IFS="$ac_save_ifs"])
+   AC_MSG_RESULT($ac_cv_path_shell)
+   SHELL=$ac_cv_path_shell
+   if test "$SHELL" = no; then
+     SHELL=/bin/sh
+     AC_MSG_WARN(Using $SHELL, even though it is not POSIX-compliant)
+   fi
+   AC_SUBST(SHELL)])
