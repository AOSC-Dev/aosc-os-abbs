From 9320a684da74c7215ccaa90c6097e4a02e7b6474 Mon Sep 17 00:00:00 2001
From: Alexandr Nedvedicky <sashan@openssl.org>
Date: Wed, 11 Feb 2026 12:50:22 +0100
Subject: [PATCH 3/9] UPSTREAM: - make gcc-15 happy

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/crew.c    | 2 +-
 src/crew.h    | 4 ++--
 src/date.c    | 2 +-
 src/date.h    | 2 +-
 src/handler.h | 2 +-
 src/page.c    | 2 +-
 src/page.h    | 2 +-
 7 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/crew.c b/src/crew.c
index cd08c2c..50a193d 100644
--- a/src/crew.c
+++ b/src/crew.c
@@ -147,7 +147,7 @@ private void
 }
 
 BOOLEAN
-crew_add(CREW crew, void (*routine)(), void *arg)
+crew_add(CREW crew, void (*routine)(void *), void *arg)
 {
   int c;
   WORK *workptr;
diff --git a/src/crew.h b/src/crew.h
index 7ec9d12..bf3b24c 100644
--- a/src/crew.h
+++ b/src/crew.h
@@ -28,7 +28,7 @@
 
 typedef struct work
 {
-  void          (*routine)();
+  void          (*routine)(void *);
   void          *arg;
   struct work   *next;
 } WORK;
@@ -36,7 +36,7 @@ typedef struct work
 typedef struct CREW_T *CREW;
 
 CREW    new_crew(int size, int maxsize, BOOLEAN block);
-BOOLEAN crew_add(CREW this, void (*routine)(), void *arg); 
+BOOLEAN crew_add(CREW this, void (*routine)(void *), void *arg); 
 BOOLEAN crew_cancel(CREW this);
 BOOLEAN crew_join(CREW this, BOOLEAN finish, void **payload);
 void    crew_destroy(CREW this);
diff --git a/src/date.c b/src/date.c
index 8357fd9..c0ab89e 100644
--- a/src/date.c
+++ b/src/date.c
@@ -144,7 +144,7 @@ struct DATE_T
 size_t DATESIZE = sizeof(struct DATE_T);
 
 DATE
-new_date(char *date)
+new_date(const char *date)
 {
   time_t now;
   DATE this  = calloc(DATESIZE, 1);
diff --git a/src/date.h b/src/date.h
index 5956883..2b24cec 100644
--- a/src/date.h
+++ b/src/date.h
@@ -34,7 +34,7 @@ extern  size_t DATESIZE;
  * because then we have one destroyer
  * that we can pass to the HASH
  */
-DATE   new_date();
+DATE   new_date(const char *);
 DATE   new_etag(char *etag);
 
 DATE    date_destroy(DATE this);
diff --git a/src/handler.h b/src/handler.h
index 42df64b..3a542e1 100644
--- a/src/handler.h
+++ b/src/handler.h
@@ -26,7 +26,7 @@
 #include <signal.h>
 #include <crew.h>
 
-void spin_doctor();
+void spin_doctor(CREW crew);
 void sig_handler(CREW crew); 
 
 #endif/*HANDLER_H*/
diff --git a/src/page.c b/src/page.c
index 06b5c0b..ee857f5 100644
--- a/src/page.c
+++ b/src/page.c
@@ -15,7 +15,7 @@ size_t PAGESIZE = sizeof(struct PAGE_T);
 void __expand(PAGE this, const int len);
 
 PAGE
-new_page(char *str)
+new_page(const char *str)
 { 
   PAGE this;
   
diff --git a/src/page.h b/src/page.h
index 2ffe6b0..be23f95 100644
--- a/src/page.h
+++ b/src/page.h
@@ -7,7 +7,7 @@
  */
 typedef struct PAGE_T *PAGE;
 
-PAGE   new_page();
+PAGE   new_page(const char *);
 PAGE   page_destroy(PAGE this);
 void   page_concat(PAGE this, const char *str, const int len);
 void   page_clear(PAGE this);
-- 
