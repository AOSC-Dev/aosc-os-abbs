Subject: [PATCH] misc: avoid incompatible structure aliasing in swaps
Upstream-Status: Pending

Accessing a protocol header through a different packed structure violates
strict aliasing. With LTO this can leave the header flags cached before
byte-order conversion, so extract() reads the length as the tunnel ID.
Use memcpy for unaligned, alias-safe reads and writes.

diff --git a/misc.c b/misc.c
index 322af26..439c3eb 100644
--- a/misc.c
+++ b/misc.c
@@ -196,9 +196,17 @@ void swaps (void *buf_v, int len)
     /* Reverse byte order (if proper to do so) 
        to make things work out easier */
     int x;
-	struct hw { _u16 s; } __attribute__ ((packed)) *p = (struct hw *) buf_v;
-	for (x = 0; x < len / 2; x++, p++)
-		p->s = ntohs(p->s); 
+    unsigned char *p = buf_v;
+    for (x = 0; x < len / 2; x++, p += sizeof (_u16))
+    {
+        _u16 value;
+
+        /* The buffer may be accessed through a protocol header structure.
+         * Use memcpy to avoid incompatible structure aliasing under LTO. */
+        memcpy (&value, p, sizeof (value));
+        value = ntohs (value);
+        memcpy (p, &value, sizeof (value));
+    }
 #endif
 }
 
