abinfo "Building v2rayN"
dotnet publish "${SRCDIR}"/v2rayN/v2rayN.Desktop/v2rayN.Desktop.csproj \
    -c Release \
    -o "${PKGDIR}"/usr/lib/v2rayN \
    --self-contained=false

dotnet publish "${SRCDIR}"/v2rayN/AmazTool/AmazTool.csproj \
    -c Release \
    -o "${PKGDIR}"/usr/lib/v2rayN \
    --self-contained=false

abinfo "Deploying files"
chmod 0755 "${PKGDIR}"/usr/lib/v2rayN/v2rayN
chmod 0755 "${PKGDIR}"/usr/lib/v2rayN/AmazTool
install -Dvm644 "${SRCDIR}"/v2rayN/v2rayN.Desktop/v2rayN.png \
                "${PKGDIR}"/usr/share/icons/hicolor/256x256/apps/v2rayN.png
install -dv "${PKGDIR}"/usr/lib/v2rayN/bin/sing_box
install -dv "${PKGDIR}"/usr/lib/v2rayN/bin/mihomo
install -dv "${PKGDIR}"/usr/lib/v2rayN/bin/xray
ln -svf /usr/bin/sing-box "${PKGDIR}"/usr/lib/v2rayN/bin/sing_box/
ln -svf /usr/bin/mihomo "${PKGDIR}"/usr/lib/v2rayN/bin/mihomo/
ln -svf /usr/bin/xray "${PKGDIR}"/usr/lib/v2rayN/bin/xray/
ln -svf /usr/share/v2ray-rules-dat/geoip.dat "${PKGDIR}"/usr/lib/v2rayN/bin/
ln -svf /usr/share/v2ray-rules-dat/geosite.dat "${PKGDIR}"/usr/lib/v2rayN/bin/
