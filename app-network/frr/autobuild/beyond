abinfo "Installing FRR configuration files from source ..."
install -Dvm644 "$SRCDIR"/tools/etc/frr/daemons \
    "$PKGDIR"/etc/frr/daemons
install -Dvm644 "$SRCDIR"/tools/etc/frr/daemons.conf \
    "$PKGDIR"/etc/frr/daemons.
# These files contain sensitive information including BGP neighbor passwords
# and other network credentials that should not be readable by other users
install -Dvm600 "$SRCDIR"/tools/etc/frr/frr.conf \
    "$PKGDIR"/etc/frr/frr.conf
install -Dvm640 "$SRCDIR"/tools/etc/frr/vtysh.conf \
    "$PKGDIR"/etc/frr/vtysh.conf
install -Dvm644 "$SRCDIR"/tools/etc/frr/support_bundle_commands.conf \
    "$PKGDIR"/etc/frr/support_bundle_commands.conf
install -Dvm644 "$BLDDIR"/tools/frr.service \
    "$PKGDIR"/usr/lib/systemd/system/frr.service
install -Dvm644 "$BLDDIR"/tools/frr@.service \
    "$PKGDIR"/usr/lib/systemd/system/frr@.service
