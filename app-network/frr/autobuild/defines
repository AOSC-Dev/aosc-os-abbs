PKGNAME=frr
PKGSEC=net
PKGDEP="c-ares libcap json-c libyang ncurses net-snmp openssl readline iproute2 logrotate lsof shadow"
BUILDDEP="flex bison python-3"
PKGDES="Internet routing daemon and utilities"

PKGPROV="frrouting"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--with-moduledir=/usr/lib/frr/modules'
    '--enable-vtysh'
    '--enable-watchfrr'
    '--enable-snmp=agentx'
    '--enable-cumulus'
    '--enable-eigrpd'
    '--enable-babeld'
    '--enable-isisd'
    '--enable-pimd'
    '--enable-pbrd'
    '--enable-sharpd'
    '--enable-staticd'
    '--enable-bfdd'
    '--enable-fabricd'
    '--enable-vrrpd'
    '--enable-pathd'
    '--enable-multipath=64'
    '--enable-user=frr'
    '--enable-group=frr'
    '--enable-vty-group=frrvty'
    '--enable-configfile-mask=0640'
    '--enable-logfile-mask=0640'
)
