abinfo "Build NatTypeTester GUI (NativeAOT) ..."
# publish yields a single-file native executable in NativeAOT mode.
dotnet publish \
    "$SRCDIR"/src/NatTypeTester.Desktop/NatTypeTester.Desktop.csproj \
    -c Release \
    -o "$PKGDIR"/usr/lib/nattypetester

abinfo "Build the CLI frontend (NativeAOT) ..."
dotnet publish \
    "$SRCDIR"/src/NatTypeTester.Console/NatTypeTester.Console.csproj \
    -c Release \
    -o "$PKGDIR"/usr/lib/nattypetester/cli

abinfo "Linking the main executables ..."
install -dv "$PKGDIR"/usr/bin
ln -sv ../lib/nattypetester/NatTypeTester "$PKGDIR"/usr/bin/nattypetester
ln -sv ../lib/nattypetester/cli/NatTypeTester.Console \
    "$PKGDIR"/usr/bin/nattypetester-cli

abinfo "Generating the application icon ..."
_ico="$SRCDIR"/src/NatTypeTester.Views/Assets/icon.ico
# The .ico stores several artwork variants at each size; the full-detail one is
# the last frame of the largest size. 
_icon_idx="$(identify -format "%s %w %h\n" "$_ico" \
    | sort -s -k2,2n -k3,3n | tail -1 | cut -d' ' -f1)"
install -dv "$PKGDIR"/usr/share/pixmaps
magick "$_ico[$_icon_idx]" "$PKGDIR"/usr/share/pixmaps/nattypetester.png
