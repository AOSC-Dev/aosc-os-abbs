PKGNAME=nattypetester
PKGSEC=net
PKGDES="Graphical and command-line utilities to test NAT type via STUN"
PKGDEP="dbus fontconfig x11-lib xdg-utils dotnet-runtime-deps-10.0"
BUILDDEP="dotnet-sdk-10.0 dotnet-sdk-aot-10.0 imagemagick"

# FIXME: upstream (Avalonia) officially supports only amd64, arm64 and
#        loongarch64; other secondary architectures are untested.
#        loongson3/i486/armv4 have no dotnet support; dotnet-sdk-aot-10.0 is
#        unavailable on ppc64el. (from app-vcs/sourcegit)
FAIL_ARCH="!(amd64|arm64|loongarch64|riscv64)"
