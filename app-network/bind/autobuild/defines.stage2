# /tmp/ccfVd7My.s:395: Warning: (Requires v9e|v9v|v9m|m8; requested architecture is v9a.)
# /tmp/ccfVd7My.s:437: Error: Architecture mismatch on "pause ".
# /tmp/ccfVd7My.s:437: Warning: (Requires v9e|v9v|v9m|m8; requested architecture is v9a.)
# /tmp/ccfVd7My.s:445: Error: Architecture mismatch on "pause ".
# /tmp/ccfVd7My.s:445: Warning: (Requires v9e|v9v|v9m|m8; requested architecture is v9a.)
NOLTO__SPARC64=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
