PKGNAME=openvpn
PKGSEC=net
PKGDEP="openssl lz4 lzo iproute2 systemd"
PKGDES="VPN administration toolkit"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--enable-iproute2'
    '--enable-systemd'
    '--enable-lz4'
    '--enable-lzo'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
