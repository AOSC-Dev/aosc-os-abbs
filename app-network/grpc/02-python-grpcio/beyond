abinfo "Building Python protobuf generator ..."
cd "$SRCDIR"/tools/distrib/python/grpcio_tools
# NOTE: line 6: $(pkg-config --cflags protobuf)
export GRPC_PYTHON_CFLAGS="-fno-wrapv \
                           -frtti \
                           -DPROTOBUF_USE_DLLS -Wnon-virtual-dtor -DNOMINMAX"
export GRPC_PYTHON_LDFLAGS="$(pkg-config --libs protobuf) -lprotoc"
python3 -m build --wheel --no-isolation

abinfo "Installing Python protobuf generator ..."
python3 -m installer -d "$PKGDIR" \
    "$SRCDIR"/tools/distrib/python/grpcio_tools/dist/*.whl
