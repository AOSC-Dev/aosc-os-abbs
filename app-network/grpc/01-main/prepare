# Ref: https://gitlab.archlinux.org/archlinux/packaging/packages/grpc/-/blob/main/PKGBUILD?ref_type=heads#L50-L57
# NOTE: use system protobuf for grpcio_tools
sed -r -i \
    -e '/^CC_FILES=\[/,/\]/{/^CC_FILES=\[/n;/\]/!d;}' \
    -e '/^CC_INCLUDES=\[/,/\]/{/^CC_INCLUDES=\[/n;/\]/!d;}' \
    -e "s@^(PROTO_INCLUDE=')[^']+'@\1/usr/include'@" \
    -e '/^PROTOBUF_SUBMODULE_VERSION=/d' \
    "$SRCDIR"/tools/distrib/python/grpcio_tools/protoc_lib_deps.py
ln -sv ../../../.. "$SRCDIR"/tools/distrib/python/grpcio_tools/grpc_root
