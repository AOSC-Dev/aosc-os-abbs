PKGNAME=iptables
PKGSEC=net
PKGDEP="glibc libmnl libnftnl libpcap"
PKGDES="Packet control utility for the Linux Kernel"

AUTOTOOLS_AFTER=(
    '--exec-prefix='
    '--with-xtlibdir=/usr/lib/iptables'
    '--with-pkgconfigdir=/usr/lib/pkgconfig'
    '--enable-ipv4'
    '--enable-ipv6'
    '--enable-largefile'
    '--enable-devel'
    '--enable-libipq'
    '--enable-bpf-compiler'
    '--enable-nfsynproxy'
    '--enable-nftables'
    '--enable-connlabel'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-bpf-compiler'
)

PKGBREAK="connman<=1.36-1 iproute2<=5.2.0 miniupnpd<=2.1 \
          strongwan<=1:5.8.1 systemd<=1:243"
PKGREP="ebtables"
PKGPROV="ebtables==1:0"
