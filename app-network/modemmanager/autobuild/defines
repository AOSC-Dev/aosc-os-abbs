PKGNAME=modemmanager
PKGSEC=admin
PKGDEP="bash-completion systemd polkit ppp libqmi libmbim libgudev \
        mobile-broadband-provider-info"
BUILDDEP="libxslt gobject-introspection vala"
BUILDDEP__RETRO="libxslt"
BUILDDEP__ARMV4="${BUILDDEP__RETRO}"
