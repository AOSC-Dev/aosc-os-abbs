PKGNAME=nmap
PKGSEC=net
PKGDEP="pcre openssl lua pygobject-3 libpcap"
PKGDEP__RETRO="pcre openssl libpcap"
PKGSUG="sudo xterm"
PKGDES="Utility for network discovery and security auditing"

ABTYPE=autotools
AUTOTOOLS_STRICT=0 # FIXME: configure: error: unrecognized options: --with-liblua

AUTOTOOLS_AFTER=(
    '--without-nmap-update'
    '--enable-static'
    'PYTHON=/usr/bin/python3'
# /usr/bin/ld: /tmp/ccfy8ic3.ltrans1.ltrans.o: in function `traceback':
# <artificial>:(.text+0xb70): undefined reference to `lua_tolstring'
    '--with-liblua=included'
)
ABSHADOW=0
NOSTATIC=0
RECONF=0
