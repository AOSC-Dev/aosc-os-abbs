PKGNAME=pulseaudio
PKGSEC=sound
PKGDEP="dbus systemd glib libsndfile alsa-lib"
BUILDDEP="check intltool"
PKGDES="General-purpose sound server"

MESON_AFTER=(
    '-Ddoxygen=false'
    '-Dudevrulesdir=/usr/lib/udev/rules.d'
    '-Dtcpwrap=disabled'
    '-Ddatabase=simple'
)

PKGREP="pulseaudio-modules-bt"
PKGBREAK="pulseaudio-modules-bt"

# FIXME:
# {standard input}:152: Error: selected processor does not support `ldr r2,[r6],#8' in ARM mode
# {standard input}:152: Error: selected processor does not support `ldr r0,[ip]' in ARM mode
# ...
# lto-wrapper: fatal error: make returned 2 exit status
NOLTO__RETRO=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
