PKGNAME=pulseaudio
PKGSEC=sound
PKGDES="General-purpose sound server"
PKGDEP="attr avahi bluez dbus fftw json-c libtool soxr orc rtkit sbc \
        speex tdb webrtc-audio-processing jack libasyncns libsndfile \
        openssl systemd libsamplerate lirc libfdk-aac ffmpeg libldac"
PKGSUG="alsa-plugins"
BUILDDEP="check intltool pulseaudio"
PKGDEP__RETRO="dbus systemd glib libsndfile alsa-lib bluez libsamplerate \
               sbc libldac libfdk-aac"

MESON_AFTER=(
    '-Ddoxygen=false'
    '-Dudevrulesdir=/usr/lib/udev/rules.d'
    '-Dtcpwrap=disabled'
)

MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Ddatabase=simple'
)

PKGREP="pulseaudio-modules-bt"
PKGBREAK="pulseaudio-modules-bt"
# Note: Extra Provides for Spiral (Debian compatibility).
PKGPROV="pulseaudio-utils_spiral"

# FIXME:
# {standard input}:152: Error: selected processor does not support `ldr r2,[r6],#8' in ARM mode
# {standard input}:152: Error: selected processor does not support `ldr r0,[ip]' in ARM mode
# ...
# lto-wrapper: fatal error: make returned 2 exit status
NOLTO__RETRO=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
