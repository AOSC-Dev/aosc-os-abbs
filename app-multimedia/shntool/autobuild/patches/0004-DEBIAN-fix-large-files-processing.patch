From f3613fd51f5f324ae39d310ebc9ef50514cf76d0 Mon Sep 17 00:00:00 2001
From: Adam Sampson <ats@offog.org>
Date: Sat, 15 Nov 2014 00:00:00 +0800
Subject: [PATCH 4/6] DEBIAN: fix large files processing.

Link: http://bugs.debian.org/684600
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/core_fileio.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/core_fileio.c b/src/core_fileio.c
index 5c7581c..10e6d86 100644
--- a/src/core_fileio.c
+++ b/src/core_fileio.c
@@ -110,10 +110,16 @@ bool read_value_long(FILE *file,unsigned long *be_val,unsigned long *le_val,unsi
   buf[4] = 0;
 
   if (be_val)
-    *be_val = (buf[0] << 24) | (buf[1] << 16) | (buf[2] << 8) | buf[3];
+    *be_val = (((unsigned long)buf[0]) << 24)
+              | (((unsigned long)buf[1]) << 16)
+              | (((unsigned long)buf[2]) << 8)
+              | ((unsigned long)buf[3]);
 
   if (le_val)
-    *le_val = (buf[3] << 24) | (buf[2] << 16) | (buf[1] << 8) | buf[0];
+    *le_val = (((unsigned long)buf[3]) << 24)
+              | (((unsigned long)buf[2]) << 16)
+              | (((unsigned long)buf[1]) << 8)
+              | ((unsigned long)buf[0]);
 
   if (tag_val)
     tagcpy(tag_val,buf);
-- 
