From c05f617480a81c7aec268f10c271193b6d0c511b Mon Sep 17 00:00:00 2001
From: Dmitry Smirnov <onlyjob@member.fsf.org>
Date: Sat, 15 Nov 2014 00:00:00 +0800
Subject: [PATCH 1/6] DEBIAN: disable CD-quality check, needed to process 24bit
 96kHz files.

Link: http://bugs.debian.org/769585
Signed-off-by: Dmitry Smirnov <onlyjob@member.fsf.org>
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/core_mode.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/core_mode.c b/src/core_mode.c
index 4585b83..ca050c4 100644
--- a/src/core_mode.c
+++ b/src/core_mode.c
@@ -345,8 +345,8 @@ static wlong is_m_ss_ff(unsigned char *buf,wave_info *info)
   *colon = 0;
   *dot = 0;
 
-  if (PROB_NOT_CD(info))
-    st_error("m:ss.ff format can only be used with CD-quality files");
+//  if (PROB_NOT_CD(info))
+//    st_error("m:ss.ff format can only be used with CD-quality files");
 
   min = atoi((const char *)buf);
   sec = atoi((const char *)(colon+1));
-- 
