PKGNAME=timidity++
PKGSEC=sound
PKGDEP="libao jack flac libxaw3d gtk-2 tk slang ncurses"
# TODO: Recommend a smaller soundfont on Retro
PKGRECOM="soundfont-fluid-gm"
PKGPROV="timidity"
PKGDEP__RETRO="alsa-lib flac libvorbis libxaw3d ncurses"
PKGDES="MIDI to Wave converter and player"

AUTOTOOLS_AFTER=(
    '--enable-xft'
    '--enable-audio=alsa,oss,ao,vorbis,flac,jack,speex'
    '--enable-dynamic=ncurses,tcltk,vt100,xaw,gtk,slang'
    '--enable-xdnd'
    '--enable-ncurses'
    '--enable-slang'
    '--enable-tcltk'
    '--enable-xaw'
    '--enable-gtk'
    '--enable-server'
    '--enable-alsaseq'
    '--enable-network'
    '--enable-spectrogram'
    '--enable-wrd'
    '--with-elf'
    '--with-x'
    '--with-xawlib=xaw3d'
    '--with-default-path=/etc/timidity++/'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-audio=alsa'
    '--disable-xdnd'
    '--disable-ncurses'
    '--disable-slang'
    '--disable-tcltk'
    '--disable-gtk'
    '--disable-server'
    '--disable-network'
    '--disable-spectrogram'
    '--disable-wrd'
    '--without-elf'
    '--without-xawlib'
)
