From a27ec08430984f81294a1d8f23d60f142c36aad9 Mon Sep 17 00:00:00 2001
From: Nils Schimmelmann <nschimme@users.noreply.github.com>
Date: Thu, 1 Oct 2026 07:28:34 -0700
Subject: [PATCH 07/13] meson: define WORDS_BIGENDIAN as 0 or 1 (#12)

The #if WORDS_BIGENDIAN checks need a value; set() leaves the macro
empty on big-endian hosts, which fails to compile on powerpc.
---
 meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/meson.build
+++ b/meson.build
@@ -22,7 +22,7 @@ foreach h: ['getopt.h', 'immintrin.h']
     config_h.set('HAVE_' + h.underscorify().to_upper(), cc.has_header(h))
 endforeach
 
-config_h.set('WORDS_BIGENDIAN', host_machine.endian() == 'big')
+config_h.set10('WORDS_BIGENDIAN', host_machine.endian() == 'big')
 
 
 libm = cc.find_library('m', required: false)
