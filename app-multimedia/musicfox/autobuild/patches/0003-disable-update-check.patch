From c862f753256c3bfbeedd2a84e9395dffd094d678 Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Thu, 26 Nov 2026 16:57:08 +0800
Subject: [PATCH] Disable the built-in update check
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The AOSC package is updated through the distribution package manager, so
the GitHub release check and the "检查更新" main-menu entry only produce
stale or misleading notifications and an unnecessary network request at
startup.

Remove the startup update check and the main-menu entry/action, and
update the integration test to assert the entry is gone.

Co-authored-by: DeepSeek <noreply@deepseek.com>
---
 internal/ui/foxful_integration_test.go | 21 ++++-----------------
 internal/ui/menu_main.go               |  7 +------
 internal/ui/netease.go                 |  7 -------
 3 files changed, 5 insertions(+), 30 deletions(-)

diff --git a/internal/ui/foxful_integration_test.go b/internal/ui/foxful_integration_test.go
index 730f95b..9515be7 100644
--- a/internal/ui/foxful_integration_test.go
+++ b/internal/ui/foxful_integration_test.go
@@ -106,27 +106,14 @@ func TestMainMenuHelpActionShowsMarkdownPopup(t *testing.T) {
 	}
 }
 
-func TestMainMenuCheckUpdateActionReturnsNotificationCommand(t *testing.T) {
-	app, netease := newFormPageTestApp(t)
+func TestMainMenuCheckUpdateActionRemoved(t *testing.T) {
+	_, netease := newFormPageTestApp(t)
 	menu := NewMainMenu(netease)
-	updateIndex := -1
-	for i, item := range menu.menus {
+	for _, item := range menu.menus {
 		if item.Title == "检查更新" {
-			updateIndex = i
-			break
+			t.Fatal("main menu still contains the disabled check-update entry")
 		}
 	}
-	if updateIndex < 0 {
-		t.Fatal("main menu does not contain check-update entry")
-	}
-
-	page, cmd := menu.Action(app, updateIndex)
-	if page != app.MustMain() || cmd == nil {
-		t.Fatalf("check-update action returned page=%T cmd=%v, want current main page and notification command", page, cmd)
-	}
-	if submenu := menu.SubMenu(app, updateIndex); submenu != nil {
-		t.Fatalf("check-update entry still opens submenu %T", submenu)
-	}
 }
 
 func TestCheckUpdateNotificationMsgCoversAllResults(t *testing.T) {
diff --git a/internal/ui/menu_main.go b/internal/ui/menu_main.go
index 65d4a8c..427eafa 100644
--- a/internal/ui/menu_main.go
+++ b/internal/ui/menu_main.go
@@ -6,8 +6,7 @@ import (
 )
 
 const (
-	mainMenuHelpIndex        = 14
-	mainMenuCheckUpdateIndex = 15
+	mainMenuHelpIndex = 14
 )
 
 type MainMenu struct {
@@ -36,7 +35,6 @@ func NewMainMenu(netease *Netease) *MainMenu {
 			{Title: "主播电台"},
 			{Title: "LastFM"},
 			{Title: "帮助"},
-			{Title: "检查更新"},
 		},
 		menuList: []Menu{
 			NewDailyRecommendSongsMenu(base),
@@ -54,7 +52,6 @@ func NewMainMenu(netease *Netease) *MainMenu {
 			NewRadioDjTypeMenu(base),
 			NewLastfm(base),
 			nil, // 帮助由 Action 直接打开 Markdown 弹窗，不再进入子菜单。
-			nil, // 检查更新由 Action 异步执行，并直接显示 TUI 通知。
 		},
 	}
 	return mainMenu
@@ -93,8 +90,6 @@ func (m *MainMenu) Action(app *model.App, index int) (model.Page, tea.Cmd) {
 	case mainMenuHelpIndex:
 		showHelpPopup(app)
 		return app.MustMain(), nil
-	case mainMenuCheckUpdateIndex:
-		return app.MustMain(), checkUpdateCmd()
 	default:
 		return m.baseMenu.Action(app, index)
 	}
diff --git a/internal/ui/netease.go b/internal/ui/netease.go
index 1dd0a31..9ffaa93 100644
--- a/internal/ui/netease.go
+++ b/internal/ui/netease.go
@@ -397,13 +397,6 @@ func (n *Netease) InitHook(_ *model.App) {
 			}
 		}
 
-		// 检查更新
-		if config.Startup.CheckUpdate {
-			if ok, newVersion := version.CheckUpdate(); ok {
-				notify.Notify(newVersionNotifyContent(newVersion))
-			}
-		}
-
 		// 自动播放
 		if config.Autoplay.Enable {
 			autoPlayer := automator.NewAutoPlayer(n.user, n.player, config.Autoplay)
-- 
2.56.0

