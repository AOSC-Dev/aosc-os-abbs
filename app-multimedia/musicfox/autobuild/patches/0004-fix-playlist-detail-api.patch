From d2d77f51fad349f53ac7a2c561ee6d6b6792bf78 Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Thu, 26 Nov 2026 17:10:43 +0800
Subject: [PATCH] Fix empty playlist track lists

NetEase's linuxapi v3 playlist detail endpoint now answers with an nginx
502 HTML page while the HTTP status remains 200, so every playlist page
parsed zero tracks and rendered an empty list.

Use the weapi v6 playlist detail endpoint with the regular weapi crypto
instead; it returns the playlist metadata and tracks.  Verified with a
real account: the liked-songs playlist (201 tracks) and a custom
playlist (78 tracks) render again.

Co-authored-by: DeepSeek <noreply@deepseek.com>
---
 .../netease-music/service/playlist_detail_service.go          | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/vendor/github.com/go-musicfox/netease-music/service/playlist_detail_service.go b/vendor/github.com/go-musicfox/netease-music/service/playlist_detail_service.go
index 29a5d02..3f1d6c5 100644
--- a/vendor/github.com/go-musicfox/netease-music/service/playlist_detail_service.go
+++ b/vendor/github.com/go-musicfox/netease-music/service/playlist_detail_service.go
@@ -12,7 +12,7 @@ type PlaylistDetailService struct {
 func (service *PlaylistDetailService) PlaylistDetail() (float64, []byte) {
 
 	options := &util.Options{
-		Crypto: "linuxapi",
+		Crypto: "weapi",
 	}
 	data := make(map[string]string)
 	if service.S == "" {
@@ -22,7 +22,7 @@ func (service *PlaylistDetailService) PlaylistDetail() (float64, []byte) {
 	data["n"] = "100000"
 	data["s"] = service.S
 
-	code, reBody, _ := util.CreateRequest("POST", `https://music.163.com/weapi/v3/playlist/detail`, data, options)
+	code, reBody, _ := util.CreateRequest("POST", `https://music.163.com/weapi/v6/playlist/detail`, data, options)
 
 	return code, reBody
 }
