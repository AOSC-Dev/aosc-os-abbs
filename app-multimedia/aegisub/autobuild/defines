PKGNAME=aegisub
PKGSEC=video
PKGDEP="boost ffms2 fftw hunspell wxgtk3 libass luajit fontconfig zlib icu pulseaudio \
        uchardet"
BUILDDEP="intltool desktop-file-utils gtest"
PKGDES="A free, cross-platform open source tool for creating and modifying subtitles"

ABTYPE=meson
MESON_AFTER="-Dalsa=enabled \
             -Dopenal=disabled \
             -Dlibpulse=enabled \
             -Dffms2=enabled \
             -Dhunspell=enabled \
             -Dfftw3=enabled \
             -Dsystem_luajit=true \
             -Denable_update_checker=false \
             --buildtype=release"

# FIXME: other architectures has no luajit support.
FAIL_ARCH="!(amd64|arm64|loongarch64|loongson3)"
# FIXME: https://github.com/TypesettingTools/Aegisub/issues/290
NOLTO=1
