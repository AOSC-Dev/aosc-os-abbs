abinfo "Correcting permissions for the browser plugin (if any) ..."
if [ -f "$PKGDIR"/usr/lib/obs-modules/core/libcef.so ]; then
    chmod -v a+x "$PKGDIR"/usr/lib/obs-modules/core/libcef.so
fi

abinfo "Adding plugin folder to linker search path ..."
if [ -f "$PKGDIR"/usr/lib/obs-modules/core/obs-browser-page ]; then
    patchelf \
        --debug \
        --set-rpath /usr/lib/obs-modules/core/ \
        "$PKGDIR"/usr/lib/obs-modules/core/obs-browser-page
fi
if [ -f "$PKGDIR"/usr/lib/obs-modules/core/obs-browser.so ]; then
    patchelf \
        --debug \
        --set-rpath /usr/lib/obs-modules/core/ \
        "$PKGDIR"/usr/lib/obs-modules/core/obs-browser.so
fi
