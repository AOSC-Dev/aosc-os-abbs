From 71b980ba197dbb05d3e47afdd8c65534785fe8d3 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Fri, 23 Jan 2026 15:30:03 +0800
Subject: [PATCH 3/4] loongarch64: patch electron version

Signed-off-by: Kaiyang Wu <origincode@aosc.io>
---
 electron-builder.yml | 2 +-
 pnpm-workspace.yaml  | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/electron-builder.yml b/electron-builder.yml
index 83d78bc6..4648e397 100644
--- a/electron-builder.yml
+++ b/electron-builder.yml
@@ -1,7 +1,7 @@
 appId: org.jeffvli.feishin
 productName: Feishin
 artifactName: ${productName}-${version}-${os}-${arch}.${ext}
-electronVersion: 41.7.0
+electronVersion: 39.2.7
 directories:
     buildResources: assets
 files:
diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 49a9fb08..e9129f0b 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -7,3 +7,7 @@ minimumReleaseAge: 1440
 overrides:
     'xml2js': '0.5.0'
     'react-router': '7.14.0'
+    'electron': '39.2.7'
+    'electron-builder': 'npm:@loongdotjs/electron-builder'
+    'app-builder-lib': 'npm:@loongdotjs/app-builder-lib'
+    'builder-util': 'npm:@loongdotjs/builder-util'
-- 
2.52.0

