From bff7f699ec818e51d0bf401a0b3b3591c9028390 Mon Sep 17 00:00:00 2001
From: Kaiyang Wu <origincode@aosc.io>
Date: Wed, 16 Sep 2026 10:11:34 +0800
Subject: [PATCH 3/4] loongarch64: patch electron version

Signed-off-by: Kaiyang Wu <origincode@aosc.io>
---
 electron-builder.yml |   4 +-
 package.json         |   4 +-
 pnpm-lock.yaml       | 385 ++++++++++++++++++++-----------------------
 pnpm-workspace.yaml  |  17 +-
 4 files changed, 198 insertions(+), 212 deletions(-)

diff --git a/electron-builder.yml b/electron-builder.yml
index d3fa28e8..1a9ae047 100644
--- a/electron-builder.yml
+++ b/electron-builder.yml
@@ -1,7 +1,7 @@
 appId: org.jeffvli.feishin
 productName: Feishin
 artifactName: ${productName}-${version}-${os}-${arch}.${ext}
-electronVersion: 43.7.0
+electronVersion: 43.4.1
 directories:
     buildResources: assets
 files:
@@ -74,4 +74,4 @@ publish:
     owner: jeffvli
     repo: feishin
     channel: latest
-    releaseType: draft
\ No newline at end of file
+    releaseType: draft
diff --git a/package.json b/package.json
index 07cd0f99..a8e30ea9 100644
--- a/package.json
+++ b/package.json
@@ -30,7 +30,7 @@
         "dev:validate-api": "cross-env VITE_VALIDATE_API_RESPONSES=true electron-vite dev",
         "dev:watch": "electron-vite dev --watch",
         "i18next": "i18next -c src/i18n/i18next-parser.config.js",
-        "postinstall": "install-electron && electron-builder install-app-deps",
+        "postinstall": "electron-builder install-app-deps",
         "lint": "pnpm run typecheck && pnpm run lint-code && pnpm run lint-styles",
         "lint:commits": "commitlint",
         "lint:fix": "pnpm run lint-code:fix && pnpm run lint-styles:fix",
@@ -175,7 +175,7 @@
         "babel-plugin-react-compiler": "^1.0.0",
         "concurrently": "^9.2.1",
         "cross-env": "^10.1.0",
-        "electron": "^43.7.0",
+        "electron": "43.4.1",
         "electron-builder": "^26.15.7",
         "electron-devtools-installer": "^4.0.0",
         "electron-vite": "^5.0.0",
