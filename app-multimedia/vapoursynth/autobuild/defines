PKGNAME=vapoursynth
PKGSEC=video
PKGDEP="ffmpeg python-3 shared-mime-info tesseract zimg imagemagick libass"
BUILDDEP="cython"
PKGDES="Application suite for video manipulation"


ABTYPE=meson
MESON_AFTER=(
    '-Dwrap_mode=forcefallback' # FIXME: ERROR: Subproject glslang is buildable: NO
    '-Denable_x86_asm=false'
    '-Denable_arm_asm=false'
)
MESON_AFTER__AMD64=(
    "${MESON_AFTER[@]}"
    '-Denable_x86_asm=true'
)
MESON_AFTER__ARM64=(
    "${MESON_AFTER[@]}"
    '-Denable_arm_asm=true'
)
