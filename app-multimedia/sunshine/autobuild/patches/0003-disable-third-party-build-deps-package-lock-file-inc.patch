From 487a5b698110056c6289c1a58e88cde092f18515 Mon Sep 17 00:00:00 2001
From: "Lain \"Fearyncess\" Yang" <i@lain.vg>
Date: Tue, 15 Sep 2026 21:11:04 +0800
Subject: [PATCH 3/4] disable third-party/build-deps package lock file
 including

---
 CMakeLists.txt | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4e3d52b1..9871ab3f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -68,11 +68,6 @@ if(${END_BUILD})
     return()
 endif()
 
-# Build-deps owns the dependency versions shared with its FFmpeg builds.
-# Include its lock only for full builds so manifest-only configurations do not
-# require the build-deps submodule.
-include(${CMAKE_CURRENT_SOURCE_DIR}/third-party/build-deps/package-lock.cmake)
-
 # project constants
 include(${CMAKE_MODULE_PATH}/prep/constants.cmake)
 
-- 
