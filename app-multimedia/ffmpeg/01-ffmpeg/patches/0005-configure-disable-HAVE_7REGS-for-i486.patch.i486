From 236c32ea13163ad997eaa4db30d1a561dd8e948e Mon Sep 17 00:00:00 2001
From: Xinhui Yang <cyan@cyano.uk>
Date: Sun, 28 Jun 2026 14:35:52 +0000
Subject: [PATCH] configure: disable HAVE_7REGS for i486

Apparently GCC is not happy when an inline assembly block uses 7
"r"/"+r" register operands on x86, which only has 8 registers.
---
 configure | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/configure b/configure
index b9b8e51dc0..28ff1830ba 100755
--- a/configure
+++ b/configure
@@ -6809,8 +6809,7 @@ elif enabled x86; then
     check_builtin mm_empty mmintrin.h "_mm_empty()"
 
     # check whether EBX is available on x86
-    check_inline_asm ebx_available '""::"b"(0)' &&
-        check_inline_asm ebx_available '"":::"%ebx"'
+    ebx_available=0
 
     # check whether 6 and 7 registers are available on x86
     check_inline_asm x86_6regs '"" :: "r"(0), "r"(1), "r"(2), "r"(3), "g"(4) : "%eax", "%edx"'
-- 
2.55.0

