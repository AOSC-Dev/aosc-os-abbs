PKGNAME=simplescreenrecorder
PKGSEC=video
PKGDEP="alsa-lib ffmpeg glu jack pipewire pulseaudio qt-6"
BUILDDEP=""
BUILDDEP__AMD64="${BUILDDEP} devel-base+32 glu+32 mesa+32"
PKGDES="Desktop screen recorder"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DENABLE_X86_ASM=OFF'
    # Note: Use FFmpeg version numbers for feature support tests. Enable
    # when using FFmpeg, disable when using Libav.
    '-DENABLE_FFMPEG_VERSIONS=ON'
    '-DENABLE_JACK_METADATA=ON'
    '-DWITH_OPENGL_RECORDING=ON'
    '-DWITH_V4L2=ON'
    '-DWITH_PIPEWIRE=ON'
    '-DWITH_ALSA=ON'
    '-DWITH_PULSEAUDIO=ON'
    '-DWITH_JACK=ON'
    '-DWITH_QT5=OFF'
    '-DWITH_QT6=ON'
    '-DWITH_SIMPLESCREENRECORDER=ON'
    '-DWITH_GLINJECT=ON'
)
CMAKE_AFTER__AMD64=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_32BIT_GLINJECT=ON'
    '-DCMAKE_INSTALL_LIB32DIR=/opt/32/lib'
    '-DENABLE_X86_ASM=ON'
)
