PKGNAME=pipewire
PKGSEC=sound
PKGDES="Server and user space API to deal with multimedia pipelines"
PKGDEP="systemd dbus pulseaudio alsa-lib bluez"
BUILDDEP="meson ninja gettext"

# FIXME: Autobuild is not yet capable of generating Spiral markers for gstreamer1.0-* modules.
PKGPROV="gstreamer1.0-pipewire_spiral"

# Must specify ABTYPE here because PipeWire owns Makefiles in the source root
# to make building fairly straightforward as they say
ABTYPE=meson
MESON_AFTER=(
    '-Ddocs=disabled'
    '-Dman=disabled'
    '-Dexamples=disabled'
    '-Dtests=disabled'
    '-Dinstalled_tests=disabled'
    '-Dgstreamer=disabled'
    '-Dlibsystemd=enabled'
    '-Dlogind=enabled'
    '-Dlogind-provider=libsystemd'
    '-Dsystemd-system-service=disabled'
    '-Dsystemd-user-service=enabled'
    '-Dselinux=disabled'
    '-Dpipewire-alsa=enabled'
    '-Dpipewire-jack=disabled'
    '-Dpipewire-v4l2=disabled'
    '-Djack-devel=false'
    '-Dspa-plugins=enabled'
    '-Dalsa=enabled'
    '-Dlibcamera=disabled'
    '-Daudiotestsrc=disabled'
    '-Dvideotestsrc=disabled'
    '-Dvolume=disabled'
    '-Dvulkan=disabled'
    '-Dpw-cat=disabled'
    '-Dpw-cat-ffmpeg=disabled'
    '-Dudev=enabled'
    '-Dsdl2=disabled'
    '-Dsndfile=disabled'
    '-Dlibmysofa=disabled'
    '-Dlibpulse=disabled'
    '-Droc=disabled'
    '-Davahi=disabled'
    '-Dsession-managers=[]'
    '-Draop=disabled'
    '-Dlv2=disabled'
    '-Dx11=enabled'
    '-Dx11-xfixes=enabled'
    '-Dlibcanberra=disabled'
    '-Dlegacy-rtkit=true'
    '-Davb=disabled'
    '-Dflatpak=disabled'
    '-Dreadline=enabled'
    '-Dgsettings=enabled'
    '-Dcompress-offload=enabled'
    '-Dpam-defaults-install=false'
    '-Drlimits-install=false'
    '-Dopus=disabled'
    '-Dlibffado=disabled'
    '-Dgsettings-pulse-schema=enabled'
    '-Dsnap=disabled'
    '-Debur128=disabled'
    '-Dfftw=disabled'
    '-Donnxruntime=disabled'
    "-Dudevrulesdir=${LIBDIR}/udev/rules.d"
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
