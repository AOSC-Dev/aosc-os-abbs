PKGNAME=shader-slang
PKGSEC=graphics
PKGDES="slang"
PKGDEP="llvm lua-5.4 x11-lib glslang lz4 vulkan spirv-tools"
BUILDDEP="python-3 glm spirv-headers cmark stb fast-float"

ABTYPE=cmakeninja

CMAKE_AFTER=(
  "-DCMAKE_INSTALL_INCLUDEDIR=include/shader-slang"
  "-DCMAKE_INSTALL_DOCDIR=share/doc/shader-slang"
  "-DSLANG_ENABLE_RELEASE_LTO=TRUE"
  "-DSLANG_ENABLE_TESTS=FALSE"
  "-DSLANG_ENABLE_SLANG_RHI=FALSE"
  "-DSLANG_USE_SYSTEM_LUA=TRUE"
  "-DSLANG_USE_SYSTEM_LZ4=TRUE"
  "-DSLANG_USE_SYSTEM_VULKAN_HEADERS=TRUE"
  "-DSLANG_USE_SYSTEM_SPIRV_HEADERS=TRUE"
  "-DSLANG_USE_SYSTEM_SPIRV_TOOLS=TRUE"
  "-DSLANG_USE_SYSTEM_GLSLANG=TRUE"
  "-DSLANG_SLANG_LLVM_FLAVOR=DISABLE"
  "-DSLANG_ENABLE_SLANG_PROXY=FALSE"
  "-DSLANG_ENABLE_GFX=FALSE"
)
