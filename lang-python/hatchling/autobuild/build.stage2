# NOTE: flit_core.wheel expects 'version' to be in the module itself.
abinfo "Copying __about__.py to __init__.py ..."
cp -v "$SRCDIR"/src/hatchling/__about__.py \
	"$SRCDIR"/src/hatchling/__init__.py

abinfo "Building wheel with flit_core.wheel ..."
python3 -m flit_core.wheel

abinfo "Installing wheel ..."
python3 -m installer \
	--destdir "$PKGDIR" \
	"$SRCDIR"/dist/*.whl
