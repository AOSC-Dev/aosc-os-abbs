PKGNAME=orjson
PKGSEC=python
PKGDEP="python-3"
BUILDDEP="maturin llvm python-build python-installer rustc"
PKGDES="Python JSON library supporting dataclasses, datetimes, numpy, and UUID instances"

ABTYPE=pep517
NOPYTHON2=1

