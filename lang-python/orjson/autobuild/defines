#
#   ImportError: /usr/lib/python3.10/site-packages/orjson/orjson.cpython-310-x86_64-linux-gnu.so: undefined symbol: yyjson_alc_pool_init
#
# https://github.com/ijl/orjson/issues/613
USECLANG=1
