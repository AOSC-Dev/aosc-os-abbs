From a7610ff342e56bbb02b4407b203da92d5b971cfe Mon Sep 17 00:00:00 2001
From: Xinhui Yang <cyan@cyano.uk>
Date: Tue, 31 Mar 2026 12:04:26 +0800
Subject: [PATCH] Objects/floatobject: mark local variable as volatile in
 float_pow

---
 Objects/floatobject.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Objects/floatobject.c b/Objects/floatobject.c
index 4cf6d509fe2..8c8c3bc8600 100644
--- a/Objects/floatobject.c
+++ b/Objects/floatobject.c
@@ -692,7 +692,12 @@ float_floor_div(PyObject *v, PyObject *w)
 static PyObject *
 float_pow(PyObject *v, PyObject *w, PyObject *z)
 {
-    double iv, iw, ix;
+    /* FIXME: float parameters are spilled to the wrong set of
+     * registers on ia64, if optimization is enabled.
+     * Marking them as volatile to prevent them from being
+     * optimized out.
+     */
+    volatile double iv, iw, ix;
     int negate_result = 0;
 
     if ((PyObject *)z != Py_None) {
-- 
2.52.0

