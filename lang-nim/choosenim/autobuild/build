abinfo "Building choosenim ..."
nimble --verbose build --useSystemNim -d:release -y

abinfo "Installing choosenim ..."
install -Dvm755 "$SRCDIR"/bin/choosenim "$PKGDIR"/usr/bin/choosenim
install -Dvm644 "$SRCDIR"/LICENSE "$PKGDIR"/usr/share/doc/choosenim/LICENSE
install -Dvm644 "$SRCDIR"/readme.md "$PKGDIR"/usr/share/doc/choosenim/README.md
