abinfo "Building choosenim ..."
nimble --verbose build --useSystemNim -d:release -y

abinfo "Installing choosenim ..."
install -Dvm755 bin/choosenim "$PKGDIR"/usr/bin/choosenim
install -Dvm644 LICENSE "$PKGDIR"/usr/share/doc/choosenim/LICENSE
install -Dvm644 readme.md "$PKGDIR"/usr/share/doc/choosenim/README.md
