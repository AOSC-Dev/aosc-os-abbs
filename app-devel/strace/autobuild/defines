PKGNAME=strace
PKGSEC=devel
PKGDEP="libunwind perl"
PKGDEP__IA64="${PKGDEP/libunwind/}"
PKGDEP__M68K="${PKGDEP/libunwind/}"
PKGDES="A useful diagnostic, instructional, and debugging tool"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    "--with-libunwind"
    "--enable-mpers=check"
)
AUTOTOOLS_AFTER__NOUNWIND=(
    "${AUTOTOOLS_AFTER[@]}"
    "--without-libunwind"
)

RECONF=0

AUTOTOOLS_AFTER__IA64=(
    "${AUTOTOOLS_AFTER__NOUNWIND[@]}"
)
AUTOTOOLS_AFTER__M68K=(
    "${AUTOTOOLS_AFTER__NOUNWIND[@]}"
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
