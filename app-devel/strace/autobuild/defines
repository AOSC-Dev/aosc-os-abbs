PKGNAME=strace
PKGSEC=devel
PKGDEP="libunwind perl"
# FIXME: No libunwind support.
PKGDEP__NOUNWIND="${PKGDEP/libunwind/}"
PKGDEP__ALPHA="${PKGDEP__NOUNWIND}"
PKGDEP__M68K="${PKGDEP__NOUNWIND}"
PKGDES="Utility to trace system instances"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    "--with-libunwind"
    "--enable-mpers=check"
)
# FIXME: No libunwind support.
AUTOTOOLS_AFTER__NOUNWIND=(
    "${AUTOTOOLS_AFTER[@]}"
    "--without-libunwind"
)
AUTOTOOLS_AFTER__ALPHA=("${AUTOTOOLS_AFTER__NOUNWIND[@]}")
AUTOTOOLS_AFTER__M68K=("${AUTOTOOLS_AFTER__NOUNWIND[@]}")

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
