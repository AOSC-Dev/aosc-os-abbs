abinfo "Installing LLVM BFD plugins ..."
mkdir -pv "$PKGDIR"/usr/lib/bfd-plugins
ln -sv ../LLVMgold.so \
    "$PKGDIR"/usr/lib/bfd-plugins/LLVMgold.so
ln -sv ../libLTO.so \
    "$PKGDIR"/usr/lib/bfd-plugins/libLTO.so

abinfo "Installing Python bindings ..."
mkdir -pv "$PKGDIR"/usr/lib/python${ABPY3VER}/site-packages/
for i in clang libear libscanbuild lldb; do
    ln -sv ../../llvm-${PKGVER%%}/lib/python${ABPY3VER}/site-packages/$i \
        "$PKGDIR"/usr/lib/python${ABPY3VER}/site-packages/
done
