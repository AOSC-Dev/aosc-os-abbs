PKGNAME=llvm-runtime
PKGSEC=libs
PKGDEP="llvm-runtime-22"
PKGDES="Low Level Virtual Machine Infrastructure (runtime libraries)"

PKGEPOCH=1

ABTYPE=self
ABSPLITDBG=0

# Dependency migration.
PKGBREAK="llvm-runtime-18<=18.1.8-10 llvm-runtime-20<=20.1.8-1"
PKGREP="llvm-runtime-18<=18.1.8-10 llvm-runtime-20<=20.1.8-1"

# Note: Extra provides for Spiral.
#
# This is not done automatically with Autobuild because we only ship
# symlinks in this package, and Spiral maps provides by ELF parsing.
PKGPROV="libc++1_spiral"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"

