PKGNAME=gobject-introspection
PKGSEC=gnome
PKGDEP="glib mako"
PKGDEP__RETRO="glib"
BUILDDEP="cairo vim markdown"
BUILDDEP__RETRO="cairo"
PKGDES="Introspection system for GObject-based libraries"
PKGEPOCH=1

ABTYPE=meson
MESON_AFTER=(
    '-Dcairo=enabled'
    '-Ddoctool=enabled'
    '-Dgtk_doc=false'
    '-Dbuild_introspection_data=true'
)
MESON_AFTER__RETRO=(  
    "${MESON_AFTER[@]}"
    '-Ddoctool=disabled'
)

# FIXME: glib breaks gobject-introspection <= 1:1.72.0-1 but Spiral
# provides gobject-introspection:$ARCH = 0:$PKGVER.
#
# Spiral should exclude self.
PKGEPOCH_SPIRAL=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
