PKGNAME=cmocka
PKGSEC=devel
PKGDEP="glibc"
PKGDES="Unit testing framework for C with support for mock objects"

CMAKE_AFTER="-DUNIT_TESTING=ON \
             -DLIB_INSTALL_DIR=/usr/lib"
NOLTO=1
NOSTATIC=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
