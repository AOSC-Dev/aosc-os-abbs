abinfo "Configuring avr-binutils ..."
$SRCDIR/configure \
    --prefix=${_PREFIX} \
    --with-lib-path=${_PREFIX}/lib \
    --mandir="$PKGDIR"/usr/share/man \
    --infodir="$PKGDIR"/usr/share/info \
    --with-bugurl=https://github.com/AOSC-Dev/aosc-os-abbs \
    --enable-threads \
    --with-pic \
    --enable-ld \
    --enable-gold \
    --enable-plugins \
    --disable-werror \
    --enable-lto \
    --enable-deterministic-archives \
    --target=avr \
    --program-prefix=avr-

abinfo "Building avr-binutils ..."
make

abinfo "Installing avr-binutils ..."
make install \
    tooldir="$PKGDIR/$_PREFIX" \
    prefix="$PKGDIR/$_PREFIX" \
    BUILDROOT= \
    DESTDIR=

abinfo "Removing non-prefixed executables ..."
rm -v "$PKGDIR"/$_PREFIX/bin/!(avr-*)

abinfo "Removing unused locale ..."
rm -rv "$PKGDIR"/$_PREFIX/share/locale

abinfo "Renaming info pages ..."
cd "$PKGDIR"/usr/share/info/
for i in *; do
    mv -v ${i} avr-${i}
done

abinfo "Creating symlinks in /usr/bin ..."
mkdir -vp "${PKGDIR}/usr/bin"
cd "${PKGDIR}${_PREFIX}/bin"
for i in avr-*; do
    ln -sv "${_PREFIX}/bin/${i}" \
        "${PKGDIR}/usr/bin/$i"
done
