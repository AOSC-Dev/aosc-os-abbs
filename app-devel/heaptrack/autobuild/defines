PKGNAME=heaptrack
PKGSEC=devel
PKGDEP="boost gdb kconfigwidgets kcoreaddons ki18n kiconthemes kio
        libunwind threadweaver zstd"
BUILDDEP="extra-cmake-modules"
PKGDES="Heap memory profiler"

CMAKE_AFTER=(
    '-DAPPIMAGE_BUILD=OFF'
    '-DBUILD_COVERAGE=OFF'
    '-DBUILD_TESTING=OFF'
    '-DENABLE_BSYMBOLICFUNCTIONS=OFF'
    '-DHEAPTRACK_BUILD_GUI=ON'
    '-DHEAPTRACK_BUILD_INTERPRET=ON'
    '-DHEAPTRACK_BUILD_PRINT=ON'
    '-DHEAPTRACK_BUILD_TRACK=ON'
    '-DHEAPTRACK_USE_LIBUNWIND=ON'
    '-DKDE_INSTALL_PREFIX_SCRIPT=OFF'
    '-DKDE_INSTALL_USE_QT_SYS_PATHS=ON'
)
