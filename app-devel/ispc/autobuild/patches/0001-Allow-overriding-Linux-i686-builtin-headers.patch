Subject: Allow overriding the Linux i686 builtin include directory

On AOSC, glibc+32 installs its headers under /opt/32/include rather
than the Debian multiarch location. Use that path only for Linux i686
builtins, without affecting the native compiler or other targets.

--- a/cmake/GenerateBuiltins.cmake
+++ b/cmake/GenerateBuiltins.cmake
@@ -7,6 +7,9 @@
 # ispc GenerateBuiltins.cmake
 #

+set(ISPC_LINUX_I686_INCLUDE_DIR "" CACHE PATH
+    "Override the system include directory for Linux i686 builtins")
+
 function(write_target_bitcode_lib name target os bit)
     determine_arch_and_os(${target} ${bit} ${os} fixed_arch fixed_os)
     string(REPLACE "-" "_" target ${target})
@@ -274,7 +277,9 @@ function (get_target_flags os arch out)
             set(include -isystem${ISPC_MACOS_SDK_PATH}/usr/include)
         endif()
     else()
-        if (${os} STREQUAL "macos")
+        if (${os} STREQUAL "linux" AND ${arch} STREQUAL "i686" AND ISPC_LINUX_I686_INCLUDE_DIR)
+            set(include "-isystem${ISPC_LINUX_I686_INCLUDE_DIR}")
+        elseif (${os} STREQUAL "macos")
             # -isystem/iusers/MacOSX10.14.sdk.tar/MacOSX10.14.sdk/usr/include
             set(include -isystem${ISPC_MACOS_SDK_PATH}/usr/include)
         elseif(NOT ${debian_triple} STREQUAL "")
