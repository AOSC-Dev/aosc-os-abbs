PKGNAME=ispc
PKGSEC=devel
PKGDEP="ncurses zlib llvm-runtime"
BUILDDEP="llvm"
BUILDDEP__AMD64="${BUILDDEP} glibc+32"
PKGDES="Intel Implicit SPMD Program Compiler"

USECLANG=1

CMAKE_AFTER="
    -DISPCRT_BUILD_TASK_MODEL=Threads
"
# FIXME: Linux i686 builtins need AOSC's /opt/32/include in ISPC 1.32.0.
# Drop this override and glibc+32 once a release includes ispc/ispc#3977,
# which removes the need for target libc headers.
CMAKE_AFTER__AMD64="
    ${CMAKE_AFTER}
    -DARM_ENABLED=OFF
    -DISPC_LINUX_I686_INCLUDE_DIR=/opt/32/include
"
CMAKE_AFTER__ARM64="
    ${CMAKE_AFTER}
    -DARM_ENABLED=ON
    -DX86_ENABLED=OFF
"

FAIL_ARCH="!(amd64|arm64)"
