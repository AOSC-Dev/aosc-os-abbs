PKGNAME=binutils
PKGSEC=devel
PKGDEP="glibc zlib zstd"
PKGDES="Programs to assemble and manipulate binaries and object files"
# diagnostics.h moved from gdb to binutils
PKGBREAK="gdb<=12.1-2"
PKGREP="gdb<=12.1-2"

NOSTATIC=0
NOLTO=1
AB_FLAGS_O3=1

AUTOTOOLS_AFTER=(
    '--prefix=/usr'
    '--sysconfdir=/etc'
    '--with-bugurl=https://github.com/AOSC-Dev/aosc-os-abbs/issues'
    '--with-sysroot=/'
    # Combined with --with-sysroot, the leading '=' in the path is replaced
    # with the --sysroot= value at runtime, allowing to use the linker for
    # a different target easier.
    '--with-lib-path==/usr/lib'
    '--enable-threads'
    '--enable-shared'
    '--with-pic'
    '--with-zstd'
    '--enable-ld'
    '--enable-plugins'
    '--disable-werror'
    '--enable-lto'
    '--disable-gdb'
    '--disable-gdbserver'
    '--enable-deterministic-archives'
    '--enable-64-bit-bfd'
    '--enable-default-hash-style=gnu'
    # FIXME: do not trust this too much for now.  This does not affect GAS,
    # and even the other tools still have subtle input format deduction
    # priority difference than binutils+cross (at least for MIPS the
    # priority of "traditional" and SGI formats are critical).  This only
    # means to allo simple operations like "objdump -d" on foreign object
    # files, instead of composing a real cross toolchain.
    '--enable-targets=all'
    '--enable-mips-fix-loongson3-llsc'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
