From f3d7794ffa3c9aa0db6718c0e9fe921b4e198541 Mon Sep 17 00:00:00 2001
From: Matt Turner <mattst88@gmail.com>
Date: Mon, 12 Oct 2026 21:57:44 -0400
Subject: [PATCH 4/6] ia64: Don't allocate a TPREL reloc for a hidden undefined
 weak symbol

set_got_entry doesn't emit a dynamic reloc for the .got entry of an
undefined weak symbol with non-default visibility, and
allocate_dynrel_entries doesn't allocate one for want_got.  It did for
want_tprel, so in a PIC link a reference to such a symbol with
@ltoff(@tprel()) left an R_IA64_NONE reloc in .rela.dyn.

bfd/
	* elfnn-ia64.c (allocate_dynrel_entries): Don't allocate a
	TPREL reloc for a symbol that resolves to zero.
ld/
	* testsuite/ld-ia64/tls-weak-undef-tprel.s: New.
	* testsuite/ld-ia64/tls-weak-undef-tprel.d: New.
---
 bfd/elfnn-ia64.c                            |  2 +-
 ld/testsuite/ld-ia64/tls-weak-undef-tprel.d |  4 ++++
 ld/testsuite/ld-ia64/tls-weak-undef-tprel.s | 13 +++++++++++++
 3 files changed, 18 insertions(+), 1 deletion(-)
 create mode 100644 ld/testsuite/ld-ia64/tls-weak-undef-tprel.d
 create mode 100644 ld/testsuite/ld-ia64/tls-weak-undef-tprel.s

diff --git a/bfd/elfnn-ia64.c b/bfd/elfnn-ia64.c
index 103eeea86c5..b968c57ba72 100644
--- a/bfd/elfnn-ia64.c
+++ b/bfd/elfnn-ia64.c
@@ -2872,7 +2872,7 @@ allocate_dynrel_entries (struct elfNN_ia64_dyn_sym_info *dyn_i,
 	  || dyn_i->h->root.type != bfd_link_hash_undefweak)
 	ia64_info->root.srelgot->size += sizeof (ElfNN_External_Rela);
     }
-  if ((dynamic_symbol || shared) && dyn_i->want_tprel)
+  if (!resolved_zero && (dynamic_symbol || shared) && dyn_i->want_tprel)
     ia64_info->root.srelgot->size += sizeof (ElfNN_External_Rela);
   if (dynamic_symbol && dyn_i->want_dtpmod)
     ia64_info->root.srelgot->size += sizeof (ElfNN_External_Rela);
diff --git a/ld/testsuite/ld-ia64/tls-weak-undef-tprel.d b/ld/testsuite/ld-ia64/tls-weak-undef-tprel.d
new file mode 100644
index 00000000000..de38b240b68
--- /dev/null
+++ b/ld/testsuite/ld-ia64/tls-weak-undef-tprel.d
@@ -0,0 +1,4 @@
+#ld: -shared
+#readelf: -rW
+
+There are no relocations in this file.
diff --git a/ld/testsuite/ld-ia64/tls-weak-undef-tprel.s b/ld/testsuite/ld-ia64/tls-weak-undef-tprel.s
new file mode 100644
index 00000000000..fcea08b5506
--- /dev/null
+++ b/ld/testsuite/ld-ia64/tls-weak-undef-tprel.s
@@ -0,0 +1,13 @@
+	.section ".tbss", "awT", @nobits
+loc:	.space 4
+	.weak x#
+	.hidden x#
+	.explicit
+	.text
+	.globl	_start#
+	.proc	_start#
+_start:
+	addl	r14 = @ltoff(@tprel(x#)), gp
+	;;
+	br.ret.sptk.many b0
+	.endp	_start#
-- 
2.56.0

