diff --git a/ld/testsuite/ld-ia64/tls-weak-undef.s b/ld/testsuite/ld-ia64/tls-weak-undef.s
new file mode 100644
index 00000000000..30d01534cb9
--- /dev/null
+++ b/ld/testsuite/ld-ia64/tls-weak-undef.s
@@ -0,0 +1,40 @@
+	.ifdef HAVE_TLS
+	.section ".tbss", "awT", @nobits
+	.skip 0x1000
+y:	.space 4
+	.endif
+	.weak x#
+	.ifndef DEFAULT_VIS
+	.hidden x#
+	.endif
+	.explicit
+	.text
+	.globl	_start#
+	.proc	_start#
+_start:
+	/* IE */
+	addl	r14 = @ltoff(@tprel(x#)), gp
+	;;
+	/* LE */
+	addl	r14 = @tprel(x#), r2
+	;;
+	adds	r14 = @tprel(x#), r13
+	;;
+	movl	r14 = @tprel(x#)
+	;;
+	/* GD */
+	addl	r14 = @ltoff(@dtpmod(x#)), gp
+	addl	r15 = @ltoff(@dtprel(x#)), gp
+	;;
+	/* LD */
+	addl	r14 = @dtprel(x#), r2
+	;;
+	adds	r14 = @dtprel(x#), r8
+	;;
+	movl	r14 = @dtprel(x#)
+	;;
+	br.ret.sptk.many b0
+	.endp	_start#
+	.section .debug_foobar, "", @progbits
+	data8	@dtprel(x#)
+	data4	@dtprel(x#)
