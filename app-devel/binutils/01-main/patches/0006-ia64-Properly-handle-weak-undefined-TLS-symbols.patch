+ *[0-9a-f]+:	00 00 00 02 00 00 	 +nop\.m 0x0
+ *[0-9a-f]+:	00 00 04 00 +	 +nop\.i 0x0
+ *[0-9a-f]+:	05 00 00 00 01 00 	\[MLX\] +nop\.m 0x0
+ *[0-9a-f]+:	00 00 00 00 00 c0 01 00 00 60 	 +movl r14=0x0;;
+ *[0-9a-f]+:	11 00 00 00 01 00 	\[MIB\] +nop\.m 0x0
+ *[0-9a-f]+:	00 00 00 02 00 80 	 +nop\.i 0x0
+ *[0-9a-f]+:	08 00 84 00 +	 +br\.ret\.sptk\.many b0;;
+#pass
