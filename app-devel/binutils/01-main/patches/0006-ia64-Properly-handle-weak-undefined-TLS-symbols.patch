diff --git a/bfd/elfnn-ia64.c b/bfd/elfnn-ia64.c
index 1963b794d06..f5765c95808 100644
--- a/bfd/elfnn-ia64.c
+++ b/bfd/elfnn-ia64.c
@@ -4333,9 +4333,14 @@ elfNN_ia64_relocate_section (struct bfd_link_info *info,
 	case R_IA64_TPREL14:
 	case R_IA64_TPREL22:
 	case R_IA64_TPREL64I:
-	  if (elf_hash_table (info)->tls_sec == NULL)
-	    goto missing_tls_sec;
-	  value -= elfNN_ia64_tprel_base (info);
+	  /* An undefined weak TLS symbol has no TLS storage.  Leave it
+	     as 0.  */
+	  if (!undef_weak_ref)
+	    {
+	      if (elf_hash_table (info)->tls_sec == NULL)
+		goto missing_tls_sec;
+	      value -= elfNN_ia64_tprel_base (info);
+	    }
 	  r = ia64_elf_install_value (hit_addr, value, r_type);
 	  break;
 
@@ -4346,9 +4351,12 @@ elfNN_ia64_relocate_section (struct bfd_link_info *info,
 	case R_IA64_DTPREL32MSB:
 	case R_IA64_DTPREL64LSB:
 	case R_IA64_DTPREL64MSB:
-	  if (elf_hash_table (info)->tls_sec == NULL)
-	    goto missing_tls_sec;
-	  value -= elfNN_ia64_dtprel_base (info);
+	  if (!undef_weak_ref)
+	    {
+	      if (elf_hash_table (info)->tls_sec == NULL)
+		goto missing_tls_sec;
+	      value -= elfNN_ia64_dtprel_base (info);
+	    }
 	  r = ia64_elf_install_value (hit_addr, value, r_type);
 	  break;
 
@@ -4364,7 +4372,7 @@ elfNN_ia64_relocate_section (struct bfd_link_info *info,
 	      {
 	      default:
 	      case R_IA64_LTOFF_TPREL22:
-		if (!dynamic_symbol_p)
+		if (!dynamic_symbol_p && !undef_weak_ref)
 		  {
 		    if (elf_hash_table (info)->tls_sec == NULL)
 		      goto missing_tls_sec;
@@ -4384,7 +4392,7 @@ elfNN_ia64_relocate_section (struct bfd_link_info *info,
 		got_r_type = R_IA64_DTPMOD64LSB;
 		break;
 	      case R_IA64_LTOFF_DTPREL22:
-		if (!dynamic_symbol_p)
+		if (!dynamic_symbol_p && !undef_weak_ref)
 		  {
 		    if (elf_hash_table (info)->tls_sec == NULL)
 		      goto missing_tls_sec;
diff --git a/ld/testsuite/ld-ia64/tls-undef.s b/ld/testsuite/ld-ia64/tls-undef.s
new file mode 100644
index 00000000000..756846a3ba8
--- /dev/null
+++ b/ld/testsuite/ld-ia64/tls-undef.s
@@ -0,0 +1,32 @@
+	.hidden x#
+	.explicit
+	.text
+	.globl	_start#
+	.proc	_start#
+_start:
+	/* IE */
+	addl	r14 = @ltoff(@tprel(x#)), gp
+	;;
+	/* LE */
+	addl	r14 = @tprel(x#), r2
+	;;
+	adds	r14 = @tprel(x#), r13
+	;;
+	movl	r14 = @tprel(x#)
+	;;
+	/* GD */
+	addl	r14 = @ltoff(@dtpmod(x#)), gp
+	addl	r15 = @ltoff(@dtprel(x#)), gp
+	;;
+	/* LD */
+	addl	r14 = @dtprel(x#), r2
+	;;
+	adds	r14 = @dtprel(x#), r8
+	;;
+	movl	r14 = @dtprel(x#)
+	;;
+	br.ret.sptk.many b0
+	.endp	_start#
+	.section .debug_foobar, "", @progbits
+	data8	@dtprel(x#)
+	data4	@dtprel(x#)
