From 5a4eb342953b4cb72020f62eafbdb4a1f10dd356 Mon Sep 17 00:00:00 2001
From: Matt Turner <mattst88@gmail.com>
Date: Mon, 12 Oct 2026 21:57:43 -0400
Subject: [PATCH 3/6] ia64: Emit the self DTPMOD reloc when an undefweak uses
 it first

In a PIC link every non-dynamic symbol referenced with
@ltoff(@dtpmod()) shares one "self" DTPMOD .got entry, which needs an
R_IA64_DTPMOD64LSB dynamic reloc against symbol 0.

set_got_entry doesn't emit dynamic relocs for .got entries belonging to
undefined weak symbols with non-default visibility.  When such a symbol
is the first to reach the self DTPMOD entry, the reloc is skipped, and
self_dtpmod_done then stops any later symbol emitting it.  The space
reserved for it is left as R_IA64_NONE and the entry stays 0.

The entry isn't owned by the symbol that happens to use it first, so
always emit a DTPMOD reloc in a PIC link.  An undefined weak symbol
with a DTPMOD entry of its own is dynamic and gets a reloc anyway.

bfd/
	* elfnn-ia64.c (set_got_entry): Always emit the dynamic reloc
	for a DTPMOD entry in a PIC link.
ld/
	* testsuite/ld-ia64/tls-weak-undef-dtpmod.s: New.
	* testsuite/ld-ia64/tls-weak-undef-dtpmod.d: New.
---
 bfd/elfnn-ia64.c                             |  7 +++++--
 ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.d |  6 ++++++
 ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.s | 15 +++++++++++++++
 3 files changed, 26 insertions(+), 2 deletions(-)
 create mode 100644 ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.d
 create mode 100644 ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.s

diff --git a/bfd/elfnn-ia64.c b/bfd/elfnn-ia64.c
index 401327a7c68..103eeea86c5 100644
--- a/bfd/elfnn-ia64.c
+++ b/bfd/elfnn-ia64.c
@@ -3298,11 +3298,14 @@ set_got_entry (bfd *abfd, struct bfd_link_info *info,
       /* Store the target address in the linkage table entry.  */
       bfd_put_64 (abfd, value, got_sec->contents + got_offset);
 
-      /* Install a dynamic relocation if needed.  */
+      /* Install a dynamic relocation if needed.  An undefined weak
+	 symbol that isn't dynamic uses the self DTPMOD entry, which
+	 needs its relocation whichever symbol reaches it first.  */
       if (((bfd_link_pic (info)
 	    && (!dyn_i->h
 		|| ELF_ST_VISIBILITY (dyn_i->h->other) == STV_DEFAULT
-		|| dyn_i->h->root.type != bfd_link_hash_undefweak)
+		|| dyn_i->h->root.type != bfd_link_hash_undefweak
+		|| dyn_r_type == R_IA64_DTPMOD64LSB)
 	    && dyn_r_type != R_IA64_DTPREL32LSB
 	    && dyn_r_type != R_IA64_DTPREL64LSB)
 	   || elfNN_ia64_dynamic_symbol_p (dyn_i->h, info, dyn_r_type)
diff --git a/ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.d b/ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.d
new file mode 100644
index 00000000000..17b4e49e2e6
--- /dev/null
+++ b/ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.d
@@ -0,0 +1,6 @@
+#ld: -shared
+#readelf: -rW
+
+Relocation section '\.rela\.dyn' at offset 0x[0-9a-f]+ contains 1 entry:
+ +Offset +Info +Type +Symbol's Value +Symbol's Name \+ Addend
+[0-9a-f]+ +0+a7 R_IA64_DTPMOD64LSB +0
diff --git a/ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.s b/ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.s
new file mode 100644
index 00000000000..70f6b9141ec
--- /dev/null
+++ b/ld/testsuite/ld-ia64/tls-weak-undef-dtpmod.s
@@ -0,0 +1,15 @@
+	.section ".tbss", "awT", @nobits
+loc:	.space 4
+	.weak x#
+	.hidden x#
+	.explicit
+	.text
+	.globl	_start#
+	.proc	_start#
+_start:
+	addl	r14 = @ltoff(@dtpmod(x#)), gp
+	;;
+	addl	r14 = @ltoff(@dtpmod(loc#)), gp
+	;;
+	br.ret.sptk.many b0
+	.endp	_start#
-- 
