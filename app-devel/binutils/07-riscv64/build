abinfo "Clearing compiler flags in environment..."
unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS

if [[ ${__CROSS} = arm-none-eabi ]]; then
  targ=${__CROSS}
else
  targ=${ARCH_TARGET[${__CROSS}]}
fi

abinfo "Configuring Binutils (target: $targ) ..."
mkdir -pv "$SRCDIR"/build-${__CROSS}
cd "$SRCDIR"/build-${__CROSS}

BUILD_OPTIONS=(
    "--prefix=/opt/abcross/${__CROSS}"
    "--build=${ARCH_TARGET[$ARCH]}"
    "--target=$targ"
    "--with-sysroot=/var/ab/cross-root/${__CROSS}"
    '--with-bugurl=https://github.com/AOSC-Dev/aosc-os-abbs'
    '--enable-threads'
    '--enable-shared'
    '--with-pic'
    '--with-zstd'
    '--enable-ld'
    '--enable-plugins'
    '--disable-werror'
    '--enable-lto'
    '--disable-gdb'
    '--disable-gdbserver'
    # FIXME: gprofng checks the target architecture via things like
    # `#ifdef __i386__`, obviously broken as a cross tool.
    '--disable-gprofng'
    '--enable-deterministic-archives'
    '--enable-64-bit-bfd'
    '--enable-default-hash-style=gnu'
)

# FIXME: this script is copied for all targets, ideally there should be
# only one copy but autobuild4 does not allow sharing scripts between
# subpackages for now.

# Note: target-specific options.
if [[ "${__CROSS}" = "loongson3" ]]; then
    BUILD_OPTIONS=(
        "${BUILD_OPTIONS[@]}"
        '--enable-mips-fix-loongson3-llsc'
    )
fi

if [[ "${__CROSS}" = "arm-none-eabi" ]]; then
    BUILD_OPTIONS=(
        "${BUILD_OPTIONS[@]}"
        '--enable-interwork'
    )
fi

"$SRCDIR"/configure \
    ${BUILD_OPTIONS[@]}

abinfo "Building Cross Binutils (target: $targ) ..."
make

abinfo "Installing Cross Binutils (target: $targ) ..."
make DESTDIR="$PKGDIR" install

case $targ in
  *aosc* )
    abinfo "Creating host-prefixed symlinks (target: $targ) ..."
    mkdir -pv "$PKGDIR"/usr/bin
    cd "$PKGDIR"/opt/abcross/${__CROSS}/bin/
    for i in *; do
        ln -sv ../../opt/abcross/${__CROSS}/bin/$i \
            "$PKGDIR"/usr/bin/$i
        # vendor: unknown
        ln -sv ../../opt/abcross/${__CROSS}/bin/$i \
            "$PKGDIR"/usr/bin/${i/aosc-linux-gnu/unknown-linux-gnu}
        # empty vendor
        ln -sv ../../opt/abcross/${__CROSS}/bin/$i \
            "$PKGDIR"/usr/bin/${i/aosc-linux-gnu/linux-gnu}
    done
    ;;
esac
