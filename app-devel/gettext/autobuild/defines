PKGNAME=gettext
PKGDES="GNU internationalization (i18n) library and utilities"
PKGDEP="glibc libunistring acl glib libcroco ncurses libxml2"
PKGSEC=devel

# FIXME: *** Subdirectory 'gnulib' does not yet exist. Use './gitsub.sh pull' to create it, or set the environment variable GNULIB_SRCDIR.
RECONF=0

# Note: Multi-level source.
AUTOTOOLS_STRICT=0
AUTOTOOLS_AFTER=(
    '--disable-csharp'
    '--disable-java'
    # FIXME: https://sourceware.org/pipermail/libc-alpha/2026-July/179161.html
    'ac_cv_func_posix_spawn_file_actions_addchdir=yes'
)
AUTOTOOLS_AFTER__PPCBE=(
    "${AUTOTOOLS_AFTER[@]}"
    # FIXME: D bindings broken.
    #
    # /var/cache/acbs/build/acbs.hw6loqye/gettext-1.0/gettext-runtime/intl-d/gnu/libintl/libintl.d:35:8: error: unable to read module ‘conv’
    #    35 | import std.conv;
    #       |        ^
    # /var/cache/acbs/build/acbs.hw6loqye/gettext-1.0/gettext-runtime/intl-d/gnu/libintl/libintl.d:35:8: note: Expected 'std/conv.d' or 'std/conv/package.d' in one of the following import paths:
    #    35 | import std.conv;
    #       |        ^
    '--disable-d'
)
AUTOTOOLS_AFTER__POWERPC=("${AUTOTOOLS_AFTER__PPCBE[@]}")
AUTOTOOLS_AFTER__PPC64=("${AUTOTOOLS_AFTER__PPCBE[@]}")

# FIXME: Race condition during installation.
#
# libtool: install: /usr/bin/install -c .libs/libintl_m2.so.0.0.0 [...]/gettext-0.25/abdist/usr/lib/libintl_m2.so.0.0.0
# libtool: install: /usr/bin/install -c -m 644 .libs/libintl_m2.so.0.0.0 [...]/gettext-0.25/abdist/usr/lib/libintl_m2.so.0.0.0
# install: cannot create regular file '[...]/gettext-0.25/abdist/usr/lib/libintl_m2.so.0.0.0': File exists
# make[5]: *** [Makefile:2356: install-libLTLIBRARIES] Error 1
# make[5]: *** Waiting for unfinished jobs....
NOPARALLEL=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
