From a7dfc1a2d76cff31918261dee3c67aab71edb83d Mon Sep 17 00:00:00 2001
From: Suyun <suyun@aosc.io>
Date: Mon, 7 Sep 2026 15:45:00 +0800
Subject: [PATCH] AOSC: Use architecture width in zydis string-append helpers
 ##build

The bundled zydis amalgamated distribution picks between the 32- and 64-bit
string-append helpers by listing architecture macros. That list is neither
width-correct nor exhaustive, and the loongson3 (mips64) build makes it plain:
ZYAN_MIPS was added to Zydis.h but not to the 64-bit dispatch, so mips64 takes
the 32-bit path and calls ZydisStringAppendDecU32 and ZydisStringAppendHexU32,
neither of which is compiled for MIPS. On GCC 15 the implicit declaration is a
hard error.

ZYAN_S390 and ZYAN_LOONGARCH are likewise used as stand-ins for both 32- and
64-bit targets, yet are missing from one or both of the 32-bit helper guards.

Gate the helpers on ZYAN_ARCHITECTURE_WIDTH, derived from __LP64__, instead of
an architecture list. Also add the missing else so the 32-bit decimal helper
does not append a value twice when its upper 32 bits are set.
---
 .../packagefiles/zydis/amalgamated-dist/Zydis.c     | 13 ++++++++-----
 .../packagefiles/zydis/amalgamated-dist/Zydis.h     |  8 ++++++++
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.c b/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.c
index 66dcb1ed3d..0b30fe3c3f 100644
--- a/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.c
+++ b/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.c
@@ -54437,7 +54437,7 @@ static const char* const DECIMAL_LOOKUP =
 /* Decimal                                                                                        */
 /* ---------------------------------------------------------------------------------------------- */
 
-#if defined(ZYAN_X86) || defined(ZYAN_ARM) || defined(ZYAN_EMSCRIPTEN) || defined(ZYAN_WASM) || defined(ZYAN_PPC) || defined(ZYAN_S390)
+#if ZYAN_ARCHITECTURE_WIDTH != 64
 static ZyanStatus ZydisStringAppendDecU32(ZyanString* string, ZyanU32 value, ZyanU8 padding_length)
 {
     ZYAN_ASSERT(string);
@@ -54529,7 +54529,7 @@ static ZyanStatus ZydisStringAppendDecU64(ZyanString* string, ZyanU64 value, Zya
 /* Hexadecimal                                                                                    */
 /* ---------------------------------------------------------------------------------------------- */
 
-#if defined(ZYAN_X86) || defined(ZYAN_ARM) || defined(ZYAN_EMSCRIPTEN) || defined(ZYAN_WASM) || defined(ZYAN_PPC)
+#if ZYAN_ARCHITECTURE_WIDTH != 64
 static ZyanStatus ZydisStringAppendHexU32(ZyanString* string, ZyanU32 value, ZyanU8 padding_length,
     ZyanBool force_leading_number, ZyanBool uppercase)
 {
@@ -54694,14 +54694,17 @@ ZyanStatus ZydisStringAppendDecU(ZyanString* string, ZyanU64 value, ZyanU8 paddi
         ZYAN_CHECK(ZydisStringAppend(string, prefix));
     }
 
-#if defined(ZYAN_X64) || defined(ZYAN_AARCH64) || defined(ZYAN_PPC64) || defined(ZYAN_RISCV64) || defined(ZYAN_LOONGARCH) || defined(ZYAN_S390)
+#if ZYAN_ARCHITECTURE_WIDTH == 64
     ZYAN_CHECK(ZydisStringAppendDecU64(string, value, padding_length));
 #else
     if (value & 0xFFFFFFFF00000000)
     {
         ZYAN_CHECK(ZydisStringAppendDecU64(string, value, padding_length));
     }
-    ZYAN_CHECK(ZydisStringAppendDecU32(string, (ZyanU32)value, padding_length));
+    else
+    {
+        ZYAN_CHECK(ZydisStringAppendDecU32(string, (ZyanU32)value, padding_length));
+    }
 #endif
 
     if (suffix)
@@ -54720,7 +54723,7 @@ ZyanStatus ZydisStringAppendHexU(ZyanString* string, ZyanU64 value, ZyanU8 paddi
         ZYAN_CHECK(ZydisStringAppend(string, prefix));
     }
 
-#if defined(ZYAN_X64) || defined(ZYAN_AARCH64) || defined(ZYAN_PPC64) || defined(ZYAN_RISCV64) || defined(ZYAN_LOONGARCH) || defined(ZYAN_S390)
+#if ZYAN_ARCHITECTURE_WIDTH == 64
     ZYAN_CHECK(ZydisStringAppendHexU64(string, value, padding_length, force_leading_number,
         uppercase));
 #else
diff --git a/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.h b/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.h
index 83972e7320..fbdc9e8616 100644
--- a/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.h
+++ b/subprojects/packagefiles/zydis/amalgamated-dist/Zydis.h
@@ -241,6 +241,14 @@
 #   error "Unsupported architecture detected"
 #endif
 
+#if !defined(ZYAN_ARCHITECTURE_WIDTH)
+#   if defined(__LP64__)
+#       define ZYAN_ARCHITECTURE_WIDTH 64
+#   else
+#       define ZYAN_ARCHITECTURE_WIDTH 32
+#   endif
+#endif
+
 /* ============================================================================================== */
 /* Endianness detection                                                                           */
 /* ============================================================================================== */
-- 
