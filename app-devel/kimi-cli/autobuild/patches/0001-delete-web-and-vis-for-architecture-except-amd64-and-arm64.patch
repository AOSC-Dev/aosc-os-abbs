-# Cache configuration
-CACHE_TTL = 5.0  # seconds - balance between freshness and performance
-SESSION_METADATA_FILENAME = "metadata.json"
-
-# Auto-archive configuration
-AUTO_ARCHIVE_DAYS = 15  # Sessions older than this will be auto-archived
