-    raw.push({
-      turnNumber,
-      eventIndex: turnStartIndex,
-      stepCount,
-      toolCallCount,
-      inputTokensDelta: turnInputTokens,
-      outputTokensDelta: turnOutputTokens,
-      durationSec: durationSec > 0 ? durationSec : 0,
-    });
-  }
