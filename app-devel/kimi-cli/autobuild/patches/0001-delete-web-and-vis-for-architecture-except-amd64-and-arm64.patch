-        exit 1
-    fi
-fi
-
-$DOCKER_CMD run --rm \
-    -v "$PROJECT_DIR:/local" \
-    --network host \
-    openapitools/openapi-generator-cli:v7.17.0 generate \
-    -i /local/openapi.json \
-    -g typescript-fetch \
-    -o /local/src/lib/api \
-    --additional-properties=supportsES6=true,npmVersion=10.9.0,typescriptThreePlus=true
