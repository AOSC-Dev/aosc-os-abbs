-    try:
-        home = Path.home()
-        if path.is_relative_to(home):
-            rel_to_home = path.relative_to(home)
-            first_part = rel_to_home.parts[0] if rel_to_home.parts else ""
-            if first_part in SENSITIVE_HOME_PATHS:
-                return True
-    except (ValueError, RuntimeError):
