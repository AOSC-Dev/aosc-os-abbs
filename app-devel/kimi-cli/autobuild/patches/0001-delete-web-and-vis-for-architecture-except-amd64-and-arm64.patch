-                was_busy = self.is_busy
-                if message.id in self._in_flight_prompt_ids:
-                    self._in_flight_prompt_ids.remove(message.id)
-                if was_busy and not self.is_busy:
-                    await self._emit_status("idle", reason="prompt_error")
