-      stepCount = 0;
-      toolCallCount = 0;
-      turnInputTokens = 0;
-      turnOutputTokens = 0;
-      inTurn = true;
-    } else if (event.type === "StepBegin" && inTurn) {
-      stepCount++;
-    } else if (event.type === "ToolCall" && inTurn) {
-      toolCallCount++;
