-                            JSONRPCErrorResponse(
-                                id=str(uuid4()),
-                                error=JSONRPCErrorObject(
-                                    code=self._process.returncode or -1,
-                                    message=stderr.decode("utf-8"),
-                                ),
-                            ).model_dump_json()
-                        )
-                        logger.warning(
-                            f"Process exited with {self._process.returncode}: "
-                            f"{stderr.decode('utf-8')}"
