-    [range, options, selectOption, closeMenu],
-  );
-
-  return {
-    isOpen: Boolean(range),
-    query: range?.query ?? "",
-    options,
-    activeIndex,
-    setActiveIndex,
-    handleTextChange,
-    handleCaretChange,
-    handleKeyDown,
-    selectOption,
-    closeMenu,
-  };
-};
