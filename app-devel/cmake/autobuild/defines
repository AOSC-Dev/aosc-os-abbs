PKGNAME=cmake
PKGSEC=devel
PKGDEP="libarchive curl expat zlib bzip2 zstd xz nghttp2 ncurses jsoncpp \
        shared-mime-info libuv rhash"
BUILDDEP="cppdap emacs cmake ninja"
BUILDDEP__RETRO="cppdap cmake ninja"
PKGDES="Toolset used for generating build manifests"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DCMAKE_MAN_DIR=/share/man'
    '-DCMAKE_DOC_DIR=/share/doc/cmake'
    '-DCMAKE_USE_SYSTEM_LIBRARIES=ON'
    '-DCMAKE_USE_SYSTEM_LIBARCHIVE=ON'
    '-DCMAKE_USE_SYSTEM_CPPDAP=ON'
    '-DCMAKE_USE_SYSTEM_CURL=ON'
    '-DCMAKE_USE_SYSTEM_EXPAT=ON'
    '-DCMAKE_USE_SYSTEM_ZLIB=ON'
    '-DCMAKE_USE_SYSTEM_BZIP2=ON'
    '-DCMAKE_USE_SYSTEM_ZSTD=ON'
    '-DCMAKE_USE_SYSTEM_LIBLZMA=ON'
    '-DCMAKE_USE_SYSTEM_NGHTTP2=ON'
    '-DCMAKE_USE_SYSTEM_FORM=ON'
    '-DCMAKE_USE_SYSTEM_JSONCPP=ON'
    '-DCMAKE_USE_SYSTEM_LIBRHASH=ON'
    '-DCMAKE_USE_SYSTEM_LIBUV=ON'
)

# FIXME: No native atomic support.
#
# /usr/bin/ld: /usr/lib/libcppdap.a(typeof.cpp.o): undefined reference to symbol '__atomic_fetch_sub_8@@LIBATOMIC_1.0'
# /usr/bin/ld: /usr/lib/libatomic.so.1: error adding symbols: DSO missing from command line
# collect2: error: ld returned 1 exit status
AB_FLAGS_ATOMIC__ARMV4=1
AB_FLAGS_ATOMIC__I486=1

PKGCONFL="cmake-3.0<=3.0.2-1"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
