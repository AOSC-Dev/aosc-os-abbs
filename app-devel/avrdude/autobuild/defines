PKGNAME=avrdude
PKGSEC=devel
PKGDEP="ncurses readline elfutils libusb libftdi libgpiod libserialport"
BUILDDEP="swig"
PKGDES="Tool for programming Microchip AVR microcontrollers"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_DOC=OFF'
    '-DHAVE_LINUXGPIO=ON'
    '-DHAVE_LINUXSPI=ON'
    '-DHAVE_PARPORT=ON'
    '-DUSE_EXTERNAL_LIBS=OFF'
    '-DDEBUG_CMAKE=ON'
    '-DBUILD_SHARED_LIBS=ON'
)
