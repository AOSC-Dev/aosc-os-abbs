PKGNAME=gdb
PKGSEC=devel
PKGDEP="babeltrace elfutils expat glibc-dbg guile isl python-3 readline \
        xz xxhash source-highlight ncurses libipt"
PKGDEP__RETRO="expat glibc-dbg isl readline"
PKGDES="Source-level debugger for multiple programming languages"

# Note: Multi-level source.
AUTOTOOLS_STRICT=0

AUTOTOOLS_AFTER=(
    '--with-system-readline'
    '--with-xxhash'
    '--with-python=/usr/bin/python3'
    '--with-system-gdbinit=/etc/gdb/gdbinit'
    '--with-intel-pt'
    '--enable-guile'
    '--enable-tui'
    '--enable-source-highlight'
    '--enable-threading'
    '--enable-64-bit-bfd'
    '--disable-install-libbfd'
    '--enable-targets=all'
    '--enable-languages=all'
    '--disable-sim'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-python'
    '--disable-guile'
    '--without-babeltrace'
    '--disable-source-highlight'
)
