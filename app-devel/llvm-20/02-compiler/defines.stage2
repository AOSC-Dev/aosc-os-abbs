PKGNAME=llvm-20
PKGSEC=devel
PKGDEP="gcc llvm-runtime-20"
PKGDES="Low Level Virtual Machine Infrastructure (version 20)"

NOSTATIC=0
NOLTO=1

USECLANG=1
USECLANG__LOONGSON3=0
USECLANG__RETRO=0

PKGPROV="clang"

PKGBREAK="llvm-runtime<=3.7.0-2 llvm<=18.1.8-1"
PKGREP="llvm-runtime<=3.7.0-2 llvm<=18.1.8-1"
