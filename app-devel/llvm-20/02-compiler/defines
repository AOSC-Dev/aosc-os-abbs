PKGNAME=llvm-20
PKGSEC=devel
PKGDEP="gcc llvm-runtime-20 perl python-3"
BUILDDEP="pypsutil setuptools"
PKGDES="Low Level Virtual Machine Infrastructure (version 20)"

NOSTATIC=0
NOLTO=1

USECLANG=1
USECLANG__LOONGSON3=0
USECLANG__RETRO=0

ABSPLITDBG__RETRO=0

PKGPROV="clang"

PKGBREAK="llvm-runtime<=3.7.0-2 llvm<=18.1.8-1 llvm-runtime-20<=20.1.8-13"
PKGREP="llvm-runtime<=3.7.0-2 llvm<=18.1.8-1 llvm-runtime-20<=20.1.8-13"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
