# Note: This can only be done with avr-strip ..."
abinfo "Strip debug symbols from libraries"
find "${PKGDIR}${_PREFIX}"/lib -type f -name "*.a" -exec /usr/bin/avr-strip --strip-debug {} \;

abinfo "Installing runtime library license exception ..."
install -Dvm644 "${SRCDIR}/COPYING.RUNTIME" "${PKGDIR}/usr/share/licenses/avr-gcc/RUNTIME.LIBRARY.EXCEPTION"

abinfo "Removing stray manuals ..."
rm -rv \
    "${PKGDIR}${_PREFIX}/share/man/man7" \
    "${PKGDIR}${_PREFIX}/share/info"

abinfo "Removing unused locale data ..."
rm -rv \
    "${PKGDIR}${_PREFIX}/share/locale"

abinfo "Removing unused runtime libraries ..."
rm -rv \
    "${PKGDIR}${_PREFIX}"/lib*/libcc1.*

abinfo "Creating symlinks in /usr/bin"
mkdir -pv "${PKGDIR}/usr/bin"
cd "${PKGDIR}${_PREFIX}/bin"
for i in avr-*; do
    ln -sv ../../"${_PREFIX}"/bin/${i} \
        "${PKGDIR}"/usr/bin/$i
done
