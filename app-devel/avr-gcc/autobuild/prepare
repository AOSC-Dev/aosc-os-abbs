# Note: Prevents undefined references whilst configuring libiberty and gcc.
abinfo "Ensure that CPPFLAGS contains optimisation ..."
export CPPFLAGS="${CPPFLAGS} -O2"

abinfo "Removing +git{} from version number to appease arduino-mk ..."
echo ${PKGVER/+git*/} > \
    "${SRCDIR}"/gcc/BASE-VER

abinfo "Setting default CFLAGS when building target static libraries"
export CFLAGS_FOR_TARGET='-O2 -pipe'
export CXXFLAGS_FOR_TARGET='-O2 -pipe -fno-threadsafe-statics'
