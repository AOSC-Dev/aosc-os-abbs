export CFLAGS="${CFLAGS} -fno-semantic-interposition"
export CXXFLAGS="${CXXFLAGS} -fno-semantic-interposition"
export LDFLAGS="${LDFLAGS} -Wl,-Bsymbolic"

git config --local user.name "AOSC Maintainers"
git config --local user.email "maintainers@aosc.io"

mv -v "${SRCDIR}"/../llvm-project-"${__LLVM_VER}".src "${SRCDIR}"/../llvm-project
cd "${SRCDIR}"/../llvm-project

abinfo "Applying the pinned OpenCL Clang and IGC LLVM patch queues ..."
# IGC's LLVM queue already includes this OpenCL Clang fix.
rm -fv "${SRCDIR}"/../opencl-clang/patches/llvm/0001-LLVM-Verifier-Fix-buffer-overflow-when-verifying-gc.patch
for file in "${SRCDIR}"/../opencl-clang/patches/{llvm,clang}/*.patch
do
    [[ -f "$file" ]] || continue
    # Match opencl-clang's relaxed context when applying its patch queue.
    git apply -C0 --ignore-whitespace "$file" || exit
    rm -v "$file"
done

igc_llvm_patches="${SRCDIR}/external/llvm/releases/${__LLVM_VER%%.*}.0.0/patches_external"
for file in "$igc_llvm_patches"/*.patch
do
    patch -p1 -t -s -N -i "$file"
done
rm -v "$igc_llvm_patches"/*.patch

cp -v /usr/bin/config.* llvm/cmake/

mkdir "${SRCDIR}"/../llvm-project/.git
ln -sv "${SRCDIR}"/../SPIRV-LLVM-Translator-IGC "${SRCDIR}"/../llvm-project/llvm/projects/llvm-spirv
ln -sv "${SRCDIR}"/../opencl-clang "${SRCDIR}"/../llvm-project/llvm/projects/opencl-clang
