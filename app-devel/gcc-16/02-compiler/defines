PKGNAME=gcc-16
PKGSEC=devel
PKGDEP="binutils gcc-runtime-16 gmp isl mpc mpfr zlib zstd"
PKGDES="GNU Compiler Collection (compilers and development data, version 16)"

# Note: Needed by the toolchain.
NOSTATIC=0

# Note: Debian's GCC is currently at 1:.
PKGEPOCH_SPIRAL=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
