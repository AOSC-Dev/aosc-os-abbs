PKGNAME=blackbox-exporter
PKGSEC=metrics
PKGDEP="glibc"
PKGDES="Prometheus' exporter for blackbox service probing metrics"

BUILDDEP="go llvm"

GO_LDFLAGS+=(
    "-X github.com/prometheus/common/version.Version=$PKGVER"
    "-X github.com/prometheus/common/version.Revision=$PKGVER"
    "-X github.com/prometheus/common/version.Branch=tags/v$PKGVER+aosc-os-abbs/stable"
    "-X github.com/prometheus/common/version.BuildUser=maintainers@aosc.io"
    "-X github.com/prometheus/common/version.BuildDate=$(date -u +%Y%m%d-%H:%M:%S)"
)
