abinfo "Installing default example configuration files ..."

install -dvm755 "${PKGDIR}"/etc/prometheus/
install -Dvm644 "${SRCDIR}"/documentation/examples/prometheus.yml "${PKGDIR}"/etc/prometheus/prometheus.yml

abinfo "Installing example configurations to docs ..."
install -dvm755 "${PKGDIR}"/usr/share/doc/prometheus/examples/
install -Dvm644 "${SRCDIR}"/documentation/examples/*.yml "${PKGDIR}"/usr/share/doc/prometheus/examples/
