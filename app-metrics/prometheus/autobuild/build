
abinfo "Building assets ..."
make ui-install V=1
make assets V=1
make npm_licenses V=1
make assets-compress V=1

abinfo "Preparing codes ..."
go generate -x -v ./web/ui/
go generate -x -v ./plugins/


abinfo "Preparing variables ..."
if ! bool ABSPLITDBG || bool ABSTRIP; then
    GO_LDFLAGS+=(-s -w)
fi
_GOLDFLAGS="${GO_LDFLAGS[*]} \
    -extldflags '-Wl,-z,relro -Wl,-z,now -specs=/usr/lib/autobuild3/specs/hardened-ld' \
    -X github.com/prometheus/common/version.Version=$PKGVER \
    -X github.com/prometheus/common/version.Revision=$PKGVER \
    -X github.com/prometheus/common/version.Branch=tags/v$PKGVER+aosc-os-abbs/stable \
    -X github.com/prometheus/common/version.BuildUser=maintainers@aosc.io \
    -X github.com/prometheus/common/version.BuildDate=$(date -u '+%Y%m%d-%H:%M:%S' )"


abinfo "Building Prometheus database ..."
GOPATH="$SRCDIR/abgopath" \
GOBIN="$PKGDIR/usr/bin/" \
go install -v -tags builtinassets \
    -ldflags "-compressdwarf=false -linkmode external $_GOLDFLAGS" \
    ./cmd/prometheus

abinfo "Building promtool ..."
GOPATH="$SRCDIR/abgopath" \
GOBIN="$PKGDIR/usr/bin/" \
go install -tags builtinassets \
    -ldflags "-compressdwarf=false -linkmode external $_GOLDFLAGS" \
    ./cmd/promtool
