# For ppc64el: npm package `rollup` is built for POWER 9, which is incompatible
# to some POWER 8 systems.
# So we are replacing it with wasm-version rollup.

abinfo "ppc64el: Replacing rollup with alias to rollup/wasm-code ..."
npm i -D rollup@npm:@rollup/wasm-node
pushd "$SRCDIR"/web/ui
npm i -D rollup@npm:@rollup/wasm-node
popd
