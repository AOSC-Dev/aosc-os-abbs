PKGNAME=upower
PKGSEC=admin
PKGDEP="systemd libusb polkit dbus-glib libimobiledevice libgudev libplist"
BUILDDEP="gobject-introspection intltool docbook-utils"
BUILDDEP__RETRO="intltool docbook-utils"
PKGDES="Abstraction and enumeration support for power devices"

MESON_AFTER=(
    '-Dman=true'
    '-Dgtk-doc=false'
    '-Dintrospection=enabled'
    '-Dos_backend=linux'
    '-Didevice=enabled'
    '-Dpolkit=enabled'
    '-Dinstalled_tests=false'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=disabled'
)
