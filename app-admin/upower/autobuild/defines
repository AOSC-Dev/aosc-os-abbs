PKGNAME=upower
PKGSEC=admin
PKGDEP="systemd libusb polkit dbus-glib libimobiledevice libgudev libplist"
PKGDEP__RETRO="systemd libusb polkit dbus-glib libgudev"
BUILDDEP="docbook-xsl gobject-introspection intltool libxslt"
BUILDDEP__RETRO="docbook-xsl intltool libxslt"
PKGDES="Daemon to manage power devices"

ABTYPE=meson
MESON_AFTER=(
    '-Dman=true'
    '-Dgtk-doc=false'
    '-Dintrospection=enabled'
    '-Dos_backend=linux'
    '-Didevice=enabled'
    '-Dpolkit=enabled'
    '-Dinstalled_tests=false'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=disabled'
    '-Didevice=disabled'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
