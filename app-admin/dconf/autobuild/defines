PKGNAME=dconf
PKGSEC=admin
PKGDEP="glib"
BUILDDEP="vala bash-completion libxslt docbook-xsl"
BUILDDEP__RETRO="bash-completion libxslt docbook-xsl"
PKGDES="Key/value storage system for user configurations"

ABTYPE=meson
MESON_AFTER=(
    '-Dbash_completion=true'
    '-Dman=true'
    '-Dgtk_doc=false'
    '-Dvapi=true'
)

MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dvapi=false'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
