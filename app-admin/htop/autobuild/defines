PKGNAME=htop
PKGSEC=utils
PKGDEP="libcap libnl libunwind lsof lm-sensors ncurses strace"
# FIXME: No libunwind support.
PKGDEP__NOUNWIND="${PKGDEP/libunwind/}"
PKGDEP__ALPHA="${PKGDEP__NOUNWIND}"
PKGDEP__M68K="${PKGDEP__NOUNWIND}"
PKGDES="Top-like interactive process viewer"

ABTYPE=autotools
# NOTE: Disable PCP version htop, we are building the plain htop binary
AUTOTOOLS_AFTER=(
    '--disable-pcp'
    '--enable-unicode'
    '--enable-affinity'
    '--enable-backtrace=unwind-ptrace'
    '--enable-capabilities'
    '--enable-delayacct'
    '--enable-sensors'
    '--disable-werror'
    '--disable-debug'
)
# FIXME: No libunwind support.
AUTOTOOLS_AFTER__NOUNWIND=(
    "${AUTOTOOLS_AFTER[@]}"
    # Note: From configure.ac ...
    #
    # [enable showing backtraces of a processes; available backends: unwind-ptrace @<:@default=no@:>@]
    '--enable-backtrace=no'
)
AUTOTOOLS_AFTER__ALPHA=("${AUTOTOOLS_AFTER__NOUNWIND[@]}")
AUTOTOOLS_AFTER__M68K=("${AUTOTOOLS_AFTER__NOUNWIND[@]}")

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
