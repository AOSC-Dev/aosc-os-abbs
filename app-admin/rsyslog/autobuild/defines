PKGNAME=rsyslog
PKGSEC=admin
# Note: Dependencies from the executables in /usr/bin - we make sure that
# those could launch.
PKGDEP="gcc-runtime glibc jemalloc libcap-ng libestr libfastjson \
        mongo-c-driver systemd util-linux yaml zlib zstd"
# Note: Dependencies for the plugins, located in /usr/lib/rsyslog.
PKGSUG="civetweb curl czmq faup gnutls hiredis libdbi libksi liblogging \
        liblognorm libnet librdkafka librelp mariadb mbedtls net-snmp \
        postgresql-runtime protobuf-c qpid-proton rabbitmq-c snappy"
# Note: For pg_config. All Suggests must be listed here as well so that
# the plugins build.
BUILDDEP="${PKGSUG} postgresql"
PKGDES="System log processing daemon"

ABTYPE=autotools
# Note: General rules of thumb - do not enable testsuites or Valgrind debugger.
AUTOTOOLS_AFTER=(
    '--enable-largefile'
    '--enable-regexp'
    '--enable-fmhash'
    '--enable-libcap-ng'
    '--enable-fmhash-xxhash'
    '--enable-ffaup'
    '--enable-fmunflatten'

    # FIXME: Broken?
    #
    # fmpcre.c:27:1: error: expected ';' before 'struct'
    #    27 | struct pcre_state {
    #       | ^~~~~~
    # fmpcre.c: In function 'modInit':
    # fmpcre.c:110:22: error: expected ';' before '*' token
    #   110 |     CODESTARTmodInit *ipIFVersProvided = CURR_MOD_IF_VERSION;
    #       |                      ^
    '--disable-fmpcre'

    '--enable-gssapi-krb5'
    '--disable-root-tests'
    '--disable-flaky-tests'
    '--enable-klog'
    '--enable-kmsg'
    '--enable-imjournal'
    '--enable-libsystemd'
    '--enable-inet'
    '--enable-jemalloc'
    '--enable-unlimited-select'
    '--disable-debug'

    # Note: Debug symbols, not debug mode.
    '--disable-debug-symbols'

    '--disable-coverage'
    '--disable-fuzzing'
    '--disable-debugless'
    '--disable-valgrind'
    '--enable-diagtools'
    '--enable-usertools'
    '--enable-mysql'
    '--enable-pgsql'
    '--enable-libdbi'
    '--enable-snmp'
    '--disable-snmp-tests'
    '--enable-uuid'
    '--enable-elasticsearch'
    '--enable-clickhouse'
    '--enable-omhttp'
    '--disable-elasticsearch-tests'
    '--disable-clickhouse-tests'

    # Note: configure: error: wolfSSL and OpenSSL cannot be enabled together; select only one
    #
    # We go with OpenSSL.
    '--disable-wolfssl'
    '--enable-openssl'

    # FIXME: Listed in `./configure --help' but not recognised.
    #'--enable-opensslcrypto'

    '--enable-gnutls'
    '--disable-gnutls-tests'
    '--enable-mbedtls'
    '--enable-libgcrypt'
    '--enable-libzstd'
    '--enable-rsyslogrt'
    '--enable-rsyslogd'
    '--disable-extended-tests'
    '--disable-mysql-tests'
    '--disable-pgsql-tests'
    '--enable-mail'
    '--enable-fmhttp'
    '--enable-imdiag'
    '--enable-imbeats'
    '--enable-mmnormalize'
    '--enable-turbo'
    '--enable-mmleefparse'
    '--enable-mmjsonparse'
    '--enable-mmjsontransform'

    # FIXME: Outdated library.
    '--disable-mmgrok'

    '--enable-mmaudit'
    '--enable-mmanon'
    '--enable-mmrm1stspace'
    '--enable-mmutf8fix'
    '--enable-mmcount'
    '--enable-mmsequence'
    '--enable-mmdblookup'
    '--enable-mmdarwin'
    '--enable-mmfields'
    '--enable-mmpstrucdata'
    '--enable-mmaitag'
    '--enable-mmrfc5424addhmac'
    '--enable-mmsnareparse'
    '--enable-relp'
    '--enable-omrelp-default-port'
    '--enable-ksi-ls12'
    '--enable-liblogging-stdlog'
    '--enable-rfc3195'
    '--disable-testbench'
    '--enable-libfaketime'
    '--disable-default-tests'
    '--disable-imtcp-tests'

    # Note: Valgrind.
    '--disable-helgrind'

    '--enable-imbatchreport'
    '--enable-pmdb2diag'
    '--enable-imfile'
    '--disable-imfile-tests'

    # FIXME: Broken?
    #
    # imfifo.c: In function 'checkCnf':
