    # omhdfs.c:135:34: error: unknown type name 'hdfsFS'
    #   135 | static inline rsRetVal HDFSmkdir(hdfsFS fs, uchar *name) {
    #       |                                  ^~~~~~
    '--disable-omhdfs'

    '--enable-omotel'
    '--enable-omkafka'
    '--enable-imkafka'
    '--disable-omazureeventhubs-tests'
    '--disable-omazuredce-tests'
    '--disable-omawslogshlc-tests'
    '--disable-kafka-tests'
    '--disable-kafka-static'
    '--enable-omazuredce'
    '--enable-omawslogshlc'
    '--enable-omazureeventhubs'
