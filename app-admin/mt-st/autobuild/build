abinfo "Building mt and stinit..."
make

abinfo "Installing binaries ..."
install -Dvm755 "$SRCDIR"/mt "$PKGDIR"/usr/bin/mt
install -Dvm755 "$SRCDIR"/stinit "$PKGDIR"/usr/bin/stinit

abinfo "Installing manpages..."
install -Dvm644 "$SRCDIR"/mt.1 "$PKGDIR"/usr/share/man/man1/mt.1
install -Dvm644 "$SRCDIR"/stinit.8 "$PKGDIR"/usr/share/man/man8/stinit.8

abinfo "Installing bash_completion"
install -Dvm644 "$SRCDIR"/mt-st.bash_completion "$PKGDIR"/usr/share/bash-completion/completions/mt-st
