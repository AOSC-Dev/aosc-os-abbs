From c4f619b3ac6d577c47f85773acdab672032f0266 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Fri, 27 Sep 2024 11:15:42 +0800
Subject: [PATCH 3/3] RETRO: AOSCOS: hack(CMakeLists.txt): disable libseccomp
 even when the library was found

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 CMakeLists.txt | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f97996270..9fe7ddcda 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -134,11 +134,7 @@ if (SYSTEMD_FOUND)
   set(HAVE_SYSTEMD 1)
 endif()
 
-find_package(SECCOMP)
-if (SECCOMP_FOUND)
-  set(HAVE_SECCOMP 1)
-endif()
-
+find_package(GCRYPT REQUIRED)
 find_package(XXHASH REQUIRED)
 
 # Mount()ing and stat()ing and friends
-- 
2.52.0

