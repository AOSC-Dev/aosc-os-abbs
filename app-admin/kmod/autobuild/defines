PKGNAME=kmod
PKGSEC=admin
PKGDEP="glibc openssl xz zlib zstd"
PKGDES="Tools to manage kernel modules"

ABTYPE=meson
MESON_AFTER=(
    '-Dtools=true'
    '-Dmanpages=true'
    '-Dlogging=true'
    '-Ddebug=false'
    '-Dzstd=enabled'
    '-Dxz=enabled'
    '-Dzlib=enabled'
    '-Dopenssl=enabled'
    '-Ddocs=false'
)

PKGESS=1

PKGBREAK="bash-completion<=1:2.14.0"
