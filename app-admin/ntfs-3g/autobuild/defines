PKGNAME=ntfs-3g
PKGSEC=admin
PKGDEP="util-linux fuse gnutls attr libgcrypt libconfig"
PKGDES="NTFS filesystem driver and utilities (userspace)"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    "--disable-static"
    "--disable-ldconfig"
    "--with-fuse=external"
    "--exec-prefix=/usr"
    "--enable-posix-acls"
    "--enable-crypto"
    "--enable-extras"
    "--enable-quarantined"
)

PKGBREAK="""
partclone<=0.3.38
testdisk<=7.2
wimlib<=1.14.4
"""
