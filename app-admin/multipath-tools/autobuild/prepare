# FIXME: Fails to build with Valgrind macros on MIPS-III (loongson2f).
#
# ../third-party/valgrind/valgrind.h:933:20: error: cast from pointer to integer of different size [-Werror=pointer-to-int-cast]
#   933 |     _zzq_args[1] = (unsigned int)(_zzq_arg1);                     \
#       |                    ^
if ab_match_arch loongson2f; then
    export CPPFLAGS="${CPPFLAGS} -DNO_VALGRIND"
fi
