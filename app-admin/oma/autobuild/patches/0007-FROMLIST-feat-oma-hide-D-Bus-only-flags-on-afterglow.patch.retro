From 8475e8a8ffe2786207f1452738bb7372ff40f794 Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Thu, 19 Nov 2026 11:16:52 +0800
Subject: [PATCH 7/8] FROMLIST: feat(oma): hide D-Bus-only flags on afterglow

Gate `--no-check-dbus`, `--no-check-battery`, `--no-take-wake-lock`, and
`--no-amo` behind the `dbus` feature, along with the battery/wake-lock
config fields. Afterglow builds no longer expose switches that do nothing.

Co-authored-by: DeepSeek <noreply@deepseek.com>

Link: https://github.com/AOSC-Dev/oma/pull/880
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/config.rs | 24 ++++++++++++++++++------
 src/main.rs   |  4 ++++
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/src/config.rs b/src/config.rs
index f146366b..2f8434cb 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -11,13 +11,12 @@ use once_cell::sync::OnceCell;
 use reqwest::Client;
 use reqwest_middleware::{ClientBuilder, ClientWithMiddleware};
 
+#[cfg(feature = "dbus")]
+use crate::config_file::{BatteryTristate, TakeWakeLockTristate};
 use crate::{
     GlobalOptions,
     args::{OhManagerAilurus, SubCmd},
-    config_file::{
-        BatteryTristate, ConfigFile, GeneralConfig, NetworkConfig, SearchEngine,
-        TakeWakeLockTristate,
-    },
+    config_file::{ConfigFile, GeneralConfig, NetworkConfig, SearchEngine},
     subcommand::utils::is_terminal,
 };
 
@@ -29,7 +28,9 @@ pub struct OmaConfig {
     pub follow_terminal_color: bool,
     cli_no_progress: bool,
     cli_no_check_dbus: bool,
+    #[cfg(feature = "dbus")]
     pub check_battery: BatteryTristate,
+    #[cfg(feature = "dbus")]
     pub take_wake_lock: TakeWakeLockTristate,
     pub sysroot: PathBuf,
     pub apt_options: Vec<String>,
@@ -62,7 +63,9 @@ impl Default for OmaConfig {
             follow_terminal_color: GeneralConfig::default_follow_terminal_color(),
             cli_no_progress: false,
             cli_no_check_dbus: GeneralConfig::default_no_check_dbus(),
+            #[cfg(feature = "dbus")]
             check_battery: GeneralConfig::default_check_battery(),
+            #[cfg(feature = "dbus")]
             take_wake_lock: GeneralConfig::default_take_wake_lock(),
             sysroot: PathBuf::from("/"),
             apt_options: Vec::new(),
@@ -140,14 +143,18 @@ impl OmaConfig {
             color,
             follow_terminal_color,
             no_progress,
+            #[cfg(feature = "dbus")]
             no_check_dbus,
+            #[cfg(feature = "dbus")]
             no_check_battery,
+            #[cfg(feature = "dbus")]
             no_take_wake_lock,
             sysroot,
             apt_options,
             no_bell,
             download_threads,
             user_agent,
+            #[cfg(feature = "dbus")]
             no_amo,
             ..
         } = global;
@@ -160,8 +167,11 @@ impl OmaConfig {
 
         self.no_bell |= no_bell;
         self.follow_terminal_color |= follow_terminal_color;
-        self.cli_no_check_dbus |= no_check_dbus;
-        self.amo &= !no_amo;
+        #[cfg(feature = "dbus")]
+        {
+            self.cli_no_check_dbus |= no_check_dbus;
+            self.amo &= !no_amo;
+        }
 
         if let Some(download_threads) = download_threads {
             self.download_threads = download_threads;
@@ -169,10 +179,12 @@ impl OmaConfig {
 
         self.cli_no_progress = no_progress;
 
+        #[cfg(feature = "dbus")]
         if no_check_battery {
             self.check_battery = BatteryTristate::Ignore
         }
 
+        #[cfg(feature = "dbus")]
         if no_take_wake_lock {
             self.take_wake_lock = TakeWakeLockTristate::Warn
         }
diff --git a/src/main.rs b/src/main.rs
index f252f6ce..f084c8f8 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -118,6 +118,7 @@ pub struct GlobalOptions {
         help = fl!("clap-no-progress-help")
     )]
     no_progress: bool,
+    #[cfg(feature = "dbus")]
     /// Run oma do not check dbus
     #[arg(
         long,
@@ -127,10 +128,12 @@ pub struct GlobalOptions {
         value_parser = FalseyValueParser::new()
     )]
     no_check_dbus: bool,
+    #[cfg(feature = "dbus")]
     /// Run oma do not check battery status
     #[arg(long, global = true, env = "OMA_NO_CHECK_BATTERY", help = fl!("clap-no-check-battery-help"), value_parser = FalseyValueParser::new()
 )]
     no_check_battery: bool,
+    #[cfg(feature = "dbus")]
     /// Run oma do not take wake lock
     #[arg(long, global = true, env = "OMA_NO_TAKE_WAKE_LOCK", help = fl!("clap-no-take-wake-lock-help"), value_parser = FalseyValueParser::new()
 )]
@@ -160,6 +163,7 @@ pub struct GlobalOptions {
     /// User agent string to use for HTTP requests.
     #[arg(long, global = true, env = "OMA_USER_AGENT", help = fl!("clap-user-agent-help"))]
     user_agent: Option<String>,
+    #[cfg(feature = "dbus")]
     /// Use amo to speed up oma
     #[arg(long, global = true, env = "OMA_USE_AMO")]
     no_amo: bool,
-- 
2.56.0

