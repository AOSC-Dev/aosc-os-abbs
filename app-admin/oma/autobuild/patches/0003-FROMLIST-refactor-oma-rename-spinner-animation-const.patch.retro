From fbc8821ad948b1a462eefb9830cc5c1ba7490d11 Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Wed, 18 Nov 2026 18:32:59 +0800
Subject: [PATCH 3/8] FROMLIST: refactor(oma): rename spinner animation
 constant

`SPINNER_ANIME` reads as Japanese animation; the tick strings are an animation. Rename it to `SPINNER_ANIMATION`.

Co-authored-by: DeepSeek <noreply@deepseek.com>

Link: https://github.com/AOSC-Dev/oma/pull/880
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/pb.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/pb.rs b/src/pb.rs
index b73ff850..9e2aa14b 100644
--- a/src/pb.rs
+++ b/src/pb.rs
@@ -24,7 +24,7 @@ use oma_refresh::db::Event as RefreshEvent;
 use oma_logger::{debug, error, info, warn};
 use oma_utils::human_bytes::HumanBytes;
 
-const SPINNER_ANIME: &[&str] = &[
+const SPINNER_ANIMATION: &[&str] = &[
     "( ●    )",
     "(  ●   )",
     "(   ●  )",
@@ -137,7 +137,7 @@ pub fn spinner_style() -> (ProgressStyle, Duration) {
 
     let style = ProgressStyle::with_template(SPINNER_TEMPLATE)
         .unwrap()
-        .tick_strings(SPINNER_ANIME);
+        .tick_strings(SPINNER_ANIMATION);
 
     (style, inv)
 }
-- 
2.56.0

