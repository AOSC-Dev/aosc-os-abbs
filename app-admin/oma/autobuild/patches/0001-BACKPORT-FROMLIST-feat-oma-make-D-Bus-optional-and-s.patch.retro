+#[cfg(not(feature = "dbus"))]
+fn get_desc(
+    pkg: &str,
+    _amo: Option<&()>,
+    apt: Option<&OmaApt>,
+) -> Result<Option<String>, OutputError> {
+    Ok(apt
+        .and_then(|apt| {
+            apt.cache
+                .get(pkg)
+                .and_then(|pkg| pkg.candidate())
+                .and_then(|candidate| candidate.summary())
+        })
+        .filter(|desc| !desc.is_empty()))
+}
