From bce7b535feacd2fa5a5115bcf98d7752a8338135 Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Wed, 18 Nov 2026 18:35:11 +0800
Subject: [PATCH 4/8] FROMLIST: feat(config): add Afterglow default config

Add `data/config/oma-afterglow.toml` for the Afterglow package. It
omits the D-Bus-only switches (`no_check_dbus`, `check_battery`,
`take_wake_lock`, and `amo`) and defaults to the cheaper `strsim` search
engine and direct contents output.

Co-authored-by: DeepSeek <noreply@deepseek.com>

Link: https://github.com/AOSC-Dev/oma/pull/880
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 data/config/oma-afterglow.toml | 41 ++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 data/config/oma-afterglow.toml

diff --git a/data/config/oma-afterglow.toml b/data/config/oma-afterglow.toml
new file mode 100644
index 00000000..b06dff6c
--- /dev/null
+++ b/data/config/oma-afterglow.toml
@@ -0,0 +1,41 @@
+# Default configuration for AOSC OS/Afterglow.
+# The Afterglow package installs this file as /etc/oma.toml.
+
+[general]
+# Set to false to allow removal of "Essential" packages.
+protect_essentials = true
+# Set to true to skip refreshing topic manifest.
+no_refresh_topics = false
+# Follow system terminal color scheme for oma output.
+follow_terminal_color = false
+# Print search contents results directly without sorting and paging
+# recommended for devices with small RAM capacities.
+search_contents_println = true
+# Default search engine for `oma search':
+#
+# - indicium: A complete search engine, but with higher performance
+#             requirements (default).
+# - strsim:   Simple string-based relevance search on package names and
+#             descriptions, with relatively low performance requirements but
+#             not as effective as indicium.
+# - text:     Simple character-based search with support for globs and no
+#             relevance sorting, most rudimentary but the fastest.
+search_engine = "strsim"
+# Ring the terminal bell when oma completes a transaction.
+bell = true
+# Number of log entries to save.
+save_log_count = 10
+# Whether oma should allow [y]/[n] for confirmation prompts (instead of
+# [q]/[Ctrl-c]) during install/remove and upgrade/downgrade operations.
+#
+# [q] will be used as equivalent to [n]/[Ctrl-c] if set to true.
+yn_mode = false
+
+[network]
+# Number of network threads to use when downloading metadata and packages.
+#
+# Note: It is not advised to set this value to more than 4 to avoid flooding
+# remote servers.
+network_threads = 4
+# User-Agent string to use for HTTP requests.
+# user_agent = "MY_USER_AGENT"
-- 
2.56.0

