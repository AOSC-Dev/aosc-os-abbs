From 47102a822da1f7f7c3c7627ec9afc562e5c2648a Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Thu, 19 Nov 2026 10:51:39 +0800
Subject: [PATCH 8/8] fix: remove not exist feature on zbus 5

---
 oma-pm/Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/oma-pm/Cargo.toml b/oma-pm/Cargo.toml
index 09df0045..bf73faad 100644
--- a/oma-pm/Cargo.toml
+++ b/oma-pm/Cargo.toml
@@ -25,7 +25,7 @@ tokio = { workspace = true, default-features = false, features = [
 fs4 = { workspace = true }
 oma-logger = { workspace = true }
 oma-pm-operation-type = { workspace = true }
-zbus = { workspace = true, optional = true, default-features = false, features = ["tokio", "proxy", "service"] }
+zbus = { workspace = true, optional = true, default-features = false, features = ["tokio"] }
 cxx = { workspace = true }
 ahash = { workspace = true }
 bon = { workspace = true }
