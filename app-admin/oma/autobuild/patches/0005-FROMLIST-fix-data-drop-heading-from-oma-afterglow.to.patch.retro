From 18be1ca21c1d265d5f7147d8d8fb06335122ca8d Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Thu, 19 Nov 2026 02:03:17 +0800
Subject: [PATCH 5/8] FROMLIST: fix(data): drop heading from oma-afterglow.toml

It is not included with other variants so keep it consistent.

Link: https://github.com/AOSC-Dev/oma/pull/880
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 data/config/oma-afterglow.toml | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/data/config/oma-afterglow.toml b/data/config/oma-afterglow.toml
index b06dff6c..9100f3e0 100644
--- a/data/config/oma-afterglow.toml
+++ b/data/config/oma-afterglow.toml
@@ -1,6 +1,3 @@
-# Default configuration for AOSC OS/Afterglow.
-# The Afterglow package installs this file as /etc/oma.toml.
-
 [general]
 # Set to false to allow removal of "Essential" packages.
 protect_essentials = true
