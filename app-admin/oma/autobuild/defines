PKGNAME="oma"
PKGSEC=admin
PKGDEP="aosc-os-feature-data apt bzip2 gcc-runtime gmp nettle openssl \
        systemd xz glibc ripgrep zstd aosc-os-repository-data \
        aosc-os-repository-template aosc-os-keyring"
PKGRECOM="amo"
# Note: amo is too heavy for Afterglow.
PKGRECOM__RETRO=""
BUILDDEP="rustc llvm"
PKGDES="Default package management interface"

PKGBREAK="mirrormgr<=0.11.1"
PKGREP="mirrormgr<=0.11.1"

USECLANG=1
PKGESS=1

ABTYPE=rust
# Note: The afterglow feature is introduced by patches backported
# from oma PR #880.
CARGO_AFTER__RETRO=(
     '--no-default-features'
     '--features=afterglow'
)
# FIXME: rustls' dependencies aws-lc-rs/ring requires SSE2, which is
# higher than our i486 baseline.
CARGO_AFTER__I486=(
    "${CARGO_AFTER__RETRO[@]}"
    '--features=openssl-setup'
)

FAIL_ARCH="!(mainline|i486)"
