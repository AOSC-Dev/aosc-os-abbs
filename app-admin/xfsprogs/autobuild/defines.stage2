PKGNAME=xfsprogs
PKGSEC=utils
PKGDEP="inih liburcu util-linux"
PKGDES="XFS filesystem utilities"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    "--enable-shared"
    "--enable-gettext"
    "--enable-editline"
    "--disable-termcap"
    "--enable-lib64"
    "--enable-librt"
    "--disable-ubsan"
    "--disable-addrsan"
    "--disable-threadsan"
    "--enable-lto"
    "--enable-scrub"
    "--disable-libicu"
)

# FIXME: [...]/xfsprogs-6.18.0/configure: line 19462: ./VERSION: No such file or directory
ABSHADOW=0

# FIXME: Build fails with parallelism.
#
# ../../install-sh: so_dot_current does not exist.
# make[1]: *** [Makefile:23：install] error 1
RECONF=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
