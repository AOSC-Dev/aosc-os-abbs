PKGNAME=dbus
PKGDES="D-Bus, a system message bus"
PKGSEC=admin

PKGDEP="x11-lib expat systemd"
BUILDDEP="docbook-xml docbook-xsl x11-proto libxslt"

ABTYPE=meson

MESON_AFTER=(
        '-Dapparmor=disabled'
        '-Dasserts=false'
        '-Dchecks=false'
        '-Ddbus_user=dbus'
        '-Ddoxygen_docs=disabled'
        '-Dducktype_docs=disabled'
        '-Dintrusive_tests=false'
        '-Depoll=enabled'
        '-Dinotify=enabled'
        '-Dinstalled_tests=false'
        '-Dkqueue=disabled'
        '-Dlaunchd=disabled'
        '-Dlibaudit=disabled'
        '-Dmessage_bus=true'
        '-Dmodular_tests=disabled'
        '-Dqt_help=disabled'
        '-Drelocation=enabled'
        '-Dselinux=disabled'
        '-Dstats=true'
        '-Dsystemd=enabled'
        '-Dtools=true'
        '-Dtraditional_activation=true'
        '-Duser_session=true'
        '-Dvalgrind=disabled'
        '-Dverbose_mode=false'
        '-Dx11_autolaunch=enabled'
        '-Dxml_docs=enabled' # man page
)

PKGEPOCH=2

# Note: Extra Provides for Spiral (Debian compatibility).
PKGPROV="libdbus-1-3_spiral libdbus-1-dev_spiral"

PKGESS=1
