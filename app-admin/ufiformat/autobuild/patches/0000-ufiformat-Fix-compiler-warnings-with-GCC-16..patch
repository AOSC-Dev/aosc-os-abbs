From e2fbe5d789b46fb805f5cff085d3cad5f8f6f4de Mon Sep 17 00:00:00 2001
From: LiarOnce <liaronce@hotmail.com>
Date: Sun, 25 Oct 2026 10:32:33 +0800
Subject: [PATCH] ufiformat: Fix compiler warnings with GCC 16.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This commit is authored with assistance from AI/LLM:

- Model: DeepSeek V4.1 Flash
- Platform: DeepSeek Platform
- Agent platform: DeepSeek Harness
- Prompt: 这是ufiformat的源码，在当前系统的工具链可以顺利编译成功，但是会有部分警告，请尝试解决编译过程中出现的警告后将修改过的代码整理为单一补丁

Assisted-by: DeepSeek
Signed-off-by: LiarOnce <liaronce@hotmail.com>
---
 ufi_command.c | 8 ++++----
 ufi_format.c  | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/ufi_command.c b/ufi_command.c
index 8064c9f..30e0f58 100644
--- a/ufi_command.c
+++ b/ufi_command.c
@@ -73,14 +73,14 @@ void ufi_set_verbose(int v)
     verbose = v;
 }
 
-static int ufi_invoke(int fd, const char *cmd, size_t cmd_size, char *data, size_t data_size, int direction)
+static int ufi_invoke(int fd, const unsigned char *cmd, size_t cmd_size, unsigned char *data, size_t data_size, int direction)
 {
     sg_io_hdr_t sg_io_hdr;
     unsigned char sense_buffer[32];
 
     memset(&sg_io_hdr, 0, sizeof(sg_io_hdr));
     sg_io_hdr.interface_id = 'S';
-    sg_io_hdr.cmdp = (char *)cmd;
+    sg_io_hdr.cmdp = (unsigned char *)cmd;
     sg_io_hdr.cmd_len = cmd_size;
     sg_io_hdr.dxfer_direction = direction;
     sg_io_hdr.dxferp = data;
@@ -113,7 +113,7 @@ static int ufi_invoke(int fd, const char *cmd, size_t cmd_size, char *data, size
     }
     if (sg_io_hdr.masked_status != GOOD) {
 	if (verbose) {
-	    int i;
+	    size_t i;
 	    fprintf(stderr, "SCSI error(command=%02x, status=%02x)\n", *cmd, sg_io_hdr.masked_status);
 	    for (i = 0; i < sizeof(sense_buffer); i++) {
 		printf("%02x ", sense_buffer[i]);
@@ -133,7 +133,7 @@ static int ufi_invoke(int fd, const char *cmd, size_t cmd_size, char *data, size
 #define ufi_invoke_no(fd, cmd) \
   ufi_invoke(fd, cmd, sizeof(cmd), NULL, 0, SG_DXFER_TO_DEV)
 
-static char *dup_name(const char *src, int offset, int count)
+static char *dup_name(const unsigned char *src, int offset, int count)
 {
     int i;
     char *name;
diff --git a/ufi_format.c b/ufi_format.c
index 4702d32..f956a16 100644
--- a/ufi_format.c
+++ b/ufi_format.c
@@ -209,7 +209,7 @@ static void format(const char *path, int size, int verify, int verbose, int forc
     int is_fdd;
     int need_reset = force;
     char *buf = NULL;
-    char c;
+    char c = 0;
     int i, n;
     time_t tt;
 
-- 
2.56.0

