From: Mingcong Bai <jeffbai@aosc.io>
Date: Sat, 1 Aug 2026 22:44:34 +0800
Subject: [PATCH 4/5] AOSCOS: presets: disable systemd-timesyncd

Handle in aosc-os-presets-base instead.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 presets/90-systemd.preset | 1 -
 1 file changed, 1 deletion(-)

diff --git a/presets/90-systemd.preset b/presets/90-systemd.preset
index 56f9e93706..cc207dea93 100644
--- a/presets/90-systemd.preset
+++ b/presets/90-systemd.preset
@@ -33,7 +33,6 @@ enable systemd-nsresourced.socket
 enable systemd-pstore.service
 enable systemd-resolved.service
 enable systemd-sysext.service
-enable systemd-timesyncd.service
 enable systemd-tpm2-clear.service
 enable systemd-userdbd.socket
 
