From bae2bb342ffc11b444d08b8ebd5b90feeb488f11 Mon Sep 17 00:00:00 2001
From: Xinhui Yang <cyan@cyano.uk>
Date: Tue, 7 Apr 2026 19:21:37 +0800
Subject: [PATCH] syscalls/ia64: add missing 3 syscall numbers

__NR_open_tree_attr = 1491
__NR_setxattrat = 1487
__NR_removexattrat = 1490
---
 src/include/override/sys/syscall.h         | 6 +++---
 src/include/override/sys/syscalls-ia64.txt | 3 +++
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/include/override/sys/syscall.h b/src/include/override/sys/syscall.h
index b6922a052d..2f561c82dc 100644
--- a/src/include/override/sys/syscall.h
+++ b/src/include/override/sys/syscall.h
@@ -276,7 +276,7 @@ static_assert(__NR_mount_setattr == systemd_NR_mount_setattr, "");
 #  elif defined(__i386__)
 #    define systemd_NR_open_tree_attr 467
 #  elif defined(__ia64__)
-#    define systemd_NR_open_tree_attr -1
+#    define systemd_NR_open_tree_attr 1491
 #  elif defined(__loongarch_lp64)
 #    define systemd_NR_open_tree_attr 467
 #  elif defined(__m68k__)
@@ -486,7 +486,7 @@ static_assert(__NR_quotactl_fd == systemd_NR_quotactl_fd, "");
 #  elif defined(__i386__)
 #    define systemd_NR_removexattrat 466
 #  elif defined(__ia64__)
-#    define systemd_NR_removexattrat -1
+#    define systemd_NR_removexattrat 1490
 #  elif defined(__loongarch_lp64)
 #    define systemd_NR_removexattrat 466
 #  elif defined(__m68k__)
@@ -556,7 +556,7 @@ static_assert(__NR_removexattrat == systemd_NR_removexattrat, "");
 #  elif defined(__i386__)
 #    define systemd_NR_setxattrat 463
 #  elif defined(__ia64__)
-#    define systemd_NR_setxattrat -1
+#    define systemd_NR_setxattrat 1487
 #  elif defined(__loongarch_lp64)
 #    define systemd_NR_setxattrat 463
 #  elif defined(__m68k__)
diff --git a/src/include/override/sys/syscalls-ia64.txt b/src/include/override/sys/syscalls-ia64.txt
index e6adcce8c7..762cb0853b 100644
--- a/src/include/override/sys/syscalls-ia64.txt
+++ b/src/include/override/sys/syscalls-ia64.txt
@@ -259,6 +259,7 @@ olduname
 open	1028
 open_by_handle_at	1327
 open_tree	1452
+open_tree_attr	1491
 openat	1281
 openat2	1461
 or1k_atomic
@@ -423,6 +424,7 @@ recvmmsg_time64
 recvmsg	1206
 remap_file_pages	1125
 removexattr	1226
+removexattrat	1490
 rename	1054
 renameat	1288
 renameat2	1338
@@ -511,6 +513,7 @@ settimeofday	1088
 setuid	1045
 setuid32
 setxattr	1217
+setxattrat	1487
 sgetmask
 shmat	1114
 shmctl	1116
-- 
2.52.0

