PKGNAME=mdadm
PKGSEC=admin
PKGDEP="glibc"
PKGDES="Tools to manage and monitor Linux md (software RAID) device arrays"
# NOTE: uses man(1) itself to build manual pages:
# man -l md.4 > md.man
BUILDDEP="man-db"

MAKE_AFTER=(
    'SYSTEMD_DIR=/usr/lib/systemd/system'
    'UDEVDIR=/usr/lib/udev'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
