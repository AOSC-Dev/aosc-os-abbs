abinfo "Renaming binaries ..."
mv -v "$PKGDIR"/usr/bin/internal "$PKGDIR"/usr/bin/ignition
mv -v "$PKGDIR"/usr/bin/validate "$PKGDIR"/usr/bin/ignition-validate

# Translated from Makefile.
abinfo "Installing dracut modules ..."
for x in dracut/*; do
    bn=$(basename $x);
    install -Dvm644 -t "$PKGDIR"/usr/lib/dracut/modules.d/${bn} $x/*;
done

chmod -v a+x "$PKGDIR"/usr/lib/dracut/modules.d/*/*.sh "$PKGDIR"/usr/lib/dracut/modules.d/*/*-generator
install -Dvm644 -t "$PKGDIR"/usr/lib/systemd/system systemd/ignition-delete-config.service
install -Dvm755 -t "$PKGDIR"/usr/lib/dracut/modules.d/30ignition "$PKGDIR"/usr/bin/ignition
rm -v "$PKGDIR"/usr/bin/ignition
mkdir -pv "$PKGDIR"/usr/libexec
ln -sf ../lib/dracut/modules.d/30ignition/ignition "$PKGDIR"/usr/libexec/ignition-apply
ln -sf ../lib/dracut/modules.d/30ignition/ignition "$PKGDIR"/usr/libexec/ignition-rmcfg
