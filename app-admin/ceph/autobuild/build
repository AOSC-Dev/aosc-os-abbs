abinfo "Configurating ceph ..."
build_cmakeninja_configure

abinfo "Building legacy-option-headers ..."
# FIXME: The legacy-option-headers target is not built before other targets including
# the headers are built. Build legacy-option-headers first.
cmake --build $BLDDIR --target legacy-option-headers -j1

abinfo "Building ceph ..."
build_cmakeninja_build

abinfo "Installing Ceph ..."
build_cmakeninja_install

# librados2-perl expects libceph-common.so.2 to be placed under /usr/lib
abinfo "Creating extra symlink required by librados2-pve ..."

ln -s ceph/libceph-common.so.2 $PKGDIR/usr/lib/libceph-common.so.2
