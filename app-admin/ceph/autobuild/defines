PKGNAME=ceph
PKGSEC=admin
PKGDEP="babeltrace boost crypto++ curl cython expat fuse gperftools gptfdisk grpc\
        inetutils jinja2 keyutils leveldb libaio libnbd lttng-ust lz4 nasm ncurses \
        nss parted pcre prettytable pyopenssl python-is-python3 procps setuptools \
        snappy socat thrift util-linux werkzeug xfsprogs zstd liburing"
BUILDDEP="bc cpio gperf jq virtualenv sphinx cunit oath-toolkit lua-5.3 cython \
          doxygen"
PKGDES="A distributed object store and file system"

PKGBREAK="libvirt<=3.9.0 qemu<=2.10.1"

CMAKE_AFTER="-DCMAKE_INSTALL_SBINDIR=/usr/bin \
             -DCMAKE_INSTALL_SYSCONFDIR=/etc \
             -DCMAKE_INSTALL_SBINDIR=/usr/bin \
             -DBoost_NO_BOOST_CMAKE=ON \
             -DCEPH_SYSTEMD_ENV_DIR=/etc/default
             -DWITH_BABELTRACE=ON \
             -DWITH_CEPHFS=ON \
             -DWITH_FUSE=ON \
             -DWITH_LTTNG=ON \
             -DWITH_LZ4=ON \
             -DWITH_MGR=ON \
             -DWITH_NSS=ON \
             -DWITH_RADOSGW=ON \
             -DWITH_RADOSGW_BEAST_FRONTEND=ON \
             -DWITH_RDMA=OFF \
             -DWITH_SYSTEM_BOOST=ON \
             -DWITH_SYSTEMD=ON \
             -DWITH_TESTS=ON \
             -DWITH_XFS=ON \
             -DENABLE_SHARED=ON \
             -DCMAKE_SKIP_RPATH=OFF \
             -DWITH_RADOSGW_AMQP_ENDPOINT=OFF \
             -DWITH_RADOSGW_KAFKA_ENDPOINT=OFF \
             -DWITH_REENTRANT_STRSIGNAL=ON \
             -DWITH_TESTS=OFF \
             -DWITH_LEVELDB=ON \
             -DWITH_SYSTEM_LIBURING=ON \
             -DWITH_SYSTEM_NPM=OFF"
ABMK="all"

NOLTO=1

PKGEPOCH=1

FAIL_ARCH="!(amd64|arm64|loongarch64)"
