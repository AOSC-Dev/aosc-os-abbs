+static void
+fb_scale_scroll (void)
+{
+  static const char *rotations[] = { 0, "90", "180", "270" };
+  struct grub_video_mode_info mode = {
+    .width = 8,
+    .height = 6,
+    .pitch = 8,
+    .mode_type = GRUB_VIDEO_MODE_TYPE_INDEX_COLOR,
+    .bpp = 8,
+    .bytes_per_pixel = 1,
+    .number_of_colors = GRUB_VIDEO_FBSTD_NUMCOLORS
+  };
+  unsigned int rotation;
+
+  grub_env_context_open ();
+  grub_env_set ("fb_scale", "2");
+  for (rotation = 0; rotation < ARRAY_SIZE (rotations); rotation++)
+    {
+      struct grub_video_mode_info info;
+      grub_uint8_t *framebuffer;
+      unsigned int viewport_x;
+      unsigned int viewport_y;
+      unsigned int x;
+      unsigned int y;
+      grub_err_t err;
+
+      if (rotations[rotation])
+	grub_env_set ("rotation", rotations[rotation]);
+      else
+	grub_env_unset ("rotation");
+
+      err = grub_video_capture_start (&mode, grub_video_fbstd_colors,
+				      mode.number_of_colors);
+      grub_test_assert (err == GRUB_ERR_NONE, "can't start capture: %s",
+			grub_errmsg);
+      if (err)
+	{
+	  grub_errno = GRUB_ERR_NONE;
+	  continue;
+	}
+
+      grub_video_get_info (&info);
+      for (x = 0; x < info.width; x++)
+	grub_video_fill_rect (x + 1, x, 0, 1, info.height);
+
+      viewport_x = (info.width - 2) / 2;
+      viewport_y = (info.height - 2) / 2;
+      grub_video_set_viewport (viewport_x, viewport_y, 2, 2);
+      err = grub_video_scroll (0xf, 1, 0);
+      grub_test_assert (err == GRUB_ERR_NONE, "scroll failed: %s",
+			grub_errmsg);
+
+      framebuffer = grub_video_capture_get_framebuffer ();
+      for (y = 0; y < info.height; y++)
+	for (x = 0; x < info.width; x++)
+	  {
+	    grub_uint8_t expected = x + 1;
+	    unsigned int block_x;
+	    unsigned int block_y;
+	    unsigned int i;
+	    unsigned int j;
+
+	    if (x >= viewport_x && x < viewport_x + 2
+		&& y >= viewport_y && y < viewport_y + 2)
+	      expected = (x == viewport_x) ? 0xf : x;
+
+	    switch (rotation)
+	      {
+	      case 1:
+		block_x = y * 2;
+		block_y = (info.width - x - 1) * 2;
+		break;
+	      case 2:
+		block_x = (info.width - x - 1) * 2;
+		block_y = (info.height - y - 1) * 2;
+		break;
+	      case 3:
+		block_x = (info.height - y - 1) * 2;
+		block_y = x * 2;
+		break;
+	      default:
+		block_x = x * 2;
+		block_y = y * 2;
+		break;
+	      }
+
+	    for (j = 0; j < 2; j++)
+	      for (i = 0; i < 2; i++)
+		grub_test_assert (framebuffer[(block_y + j) * mode.pitch
+					     + block_x + i] == expected,
+				  "rotation %s: pixel %u,%u is incorrect",
+				  rotations[rotation] ? rotations[rotation] : "0",
+				  block_x + i, block_y + j);
+	  }
+
+      grub_video_capture_end ();
+    }
+
+  grub_env_context_close ();
+}
