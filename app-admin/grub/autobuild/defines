PKGNAME=grub
PKGSEC=admin
PKGDES="GNU GRand Unified Bootloader"

PKGDEP="bash debconf dmidecode dosfstools freetype fuse-3 gettext \
        libisoburn lvm2 mtools os-prober util-linux xz"
PKGDEP__RETRO="bash debconf dmidecode dosfstools mtools os-prober"

PKGDEP__AMD64="${PKGDEP} efibootmgr"
PKGDEP__ARM64="${PKGDEP} efibootmgr"
PKGDEP__RISCV64="${PKGDEP} efibootmgr"
PKGDEP__LOONGSON2F="${PKGDEP__RETRO} freetype unifont"
PKGDEP__POWERPC="${PKGDEP__RETRO} powerpc-utils pmac-utils"
PKGDEP__PPC64="${PKGDEP__RETRO} powerpc-utils pmac-utils"
PKGDEP__PPC64EL="${PKGDEP__RETRO} powerpc-utils pmac-utils"

BUILDDEP="autoconf-archive grub help2man"
BUILDDEP__RETRO="autoconf-archive"

UNIFONTVER=15.0.06

# Note: Performance is less critical than size during the bootloader phase.
AB_FLAGS_OS=1

FAIL_ARCH="!(amd64|arm64|armv4|armv6hf|armv7hf|i486|loongarch64|loongson2f|loongson3|powerpc|ppc64|ppc64el|riscv64)"
