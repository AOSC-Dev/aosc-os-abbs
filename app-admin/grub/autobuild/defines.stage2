PKGNAME=grub
PKGSEC=admin
PKGDES="GNU GRand Unified Bootloader"

PKGDEP="bash dosfstools freetype fuse gettext libisoburn lvm2 mtools os-prober xz"
PKGDEP__RETRO="bash dosfstools mtools os-prober"

PKGDEP__AMD64="${PKGDEP} efibootmgr"
PKGDEP__ARM64="${PKGDEP} efibootmgr"
PKGDEP__RISCV64="${PKGDEP} efibootmgr"
PKGDEP__LOONGSON2F="${PKGDEP__RETRO} freetype unifont"
PKGDEP__POWERPC="${PKGDEP__RETRO} powerpc-utils pmac-utils"
PKGDEP__PPC64="${PKGDEP__RETRO} powerpc-utils pmac-utils"
PKGDEP__PPC64EL="${PKGDEP__RETRO} powerpc-utils pmac-utils"

BUILDDEP="help2man"
BUILDDEP__RETRO=""

UNIFONTVER=15.0.06

# Note: Performance is way less critical than size during the bootloader phase.
AB_FLAGS_OS=1
