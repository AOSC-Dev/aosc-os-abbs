abinfo "Building rEFInd"
make -C "$SRCDIR" "${MAKE_AFTER[@]}"
make -C "$SRCDIR" "${MAKE_AFTER[@]}" fs

# Adapted from:
# https://gitlab.archlinux.org/archlinux/packaging/packages/refind
# NOTE: `make install` installs into ESP
# therefore we install things manually
abinfo "Installing EFI binaries"
case "$ARCH" in
    amd64) EFI_ARCH="x64"  ;;
    arm64) EFI_ARCH="aa64" ;;
    *)     abdie "Unsupported architecture: $ARCH" ;;
esac
install -vDm 644 "$SRCDIR"/refind/*.efi -t "$PKGDIR/usr/lib/refind/"
install -vDm 644 "$SRCDIR"/drivers_*/*.efi -t "$PKGDIR/usr/lib/refind/drivers_$EFI_ARCH/"
install -vDm 644 "$SRCDIR"/gptsync/*.efi -t "$PKGDIR/usr/lib/refind/tools_$EFI_ARCH/"
abinfo "Installing sample config"
install -vDm 644 "$SRCDIR"/refind.conf-sample -t "$PKGDIR/usr/lib/refind/"
abinfo "Installing keys"
install -vDm 644 "$SRCDIR"/keys/*{cer,crt} -t "$PKGDIR/usr/lib/refind/keys/"
abinfo "Installing fonts"
install -vDm 644 "$SRCDIR"/fonts/*.png -t "$PKGDIR/usr/lib/refind/fonts/"
abinfo "Installing icons"
install -vDm 644 "$SRCDIR"/icons/*.png -t "$PKGDIR/usr/lib/refind/icons"
install -vDm 644 "$SRCDIR"/icons/svg/*.svg -t "$PKGDIR/usr/lib/refind/icons/svg/"
abinfo "Installing scripts"
install -vDm 755 "$SRCDIR"/{refind-{install,mkdefault,sb-healthcheck},mkrlconf,mvrefind} -t "$PKGDIR/usr/bin/"
install -vDm 755 "$SRCDIR"/fonts/mkfont.sh "$PKGDIR/usr/bin/refind-mkfont"
abinfo "Installing man pages"
install -vDm 644 "$SRCDIR"/docs/man/*.8 -t "$PKGDIR/usr/share/man/man8/"
abinfo "Installing license"
install -vDm 644 "$SRCDIR"/LICENSE.txt -t "$PKGDIR/usr/share/licenses/refind/"
