PKGNAME=refind
PKGSEC=admin
PKGDES="Graphical EFI boot manager"

PKGDEP="bash coreutils util-linux"
PKGRECOM="efibootmgr python-3"
PKGSUG="mokutil sbsigntool"
BUILDDEP="gnu-efi"

ABTYPE=self
# FIXME: make[2]: /usr/bin/aarch64-linux-gnu-ar: No such file or directory
MAKE_AFTER=(
    'AS=as'
    'LD=ld'
    'AR=ar'
    'RANLIB=ranlib'
    'OBJCOPY=objcopy'
    'GNUEFI_ARM64_TARGET_SUPPORT=y'
)

# debug symbol splitting mechanism in autobuild4
# does not work for EFI programs
ABSPLITDBG=0
FAIL_ARCH="!(amd64|arm64)"
