From: Liu Zichen <tehtiam@aosc.io>
Date: Thu, 19 Nov 2026 18:03:12 +0800
Subject: [PATCH 2/4] ARCHLINUX: fix target options

Signed-off-by: Campbell Jones <serebit@archlinux.org>
Link: https://gitlab.archlinux.org/archlinux/packaging/packages/refind/-/commit/bf8694aacf8191be40f9255d815cc1d8eb18bf4a
---
 Make.common | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Make.common b/Make.common
index 4088c70..d3f77b7 100644
--- a/Make.common
+++ b/Make.common
@@ -121,8 +121,8 @@ TIANO_LDFLAGS   = -nostdlib -n -q --gc-sections --script=$(TIANO_LDSCRIPT) \
 # objcopy flags for GNU-EFI
 #
 
-FORMAT          = --target=efi-app-$(ARCH)
-FORMAT_DRIVER   = --target=efi-bsdrv-$(ARCH)
+FORMAT          = --output-target=efi-app-$(ARCH)
+FORMAT_DRIVER   = --output-target=efi-bsdrv-$(ARCH)
 
 #
 # Modifications on a per-architecture basis....
