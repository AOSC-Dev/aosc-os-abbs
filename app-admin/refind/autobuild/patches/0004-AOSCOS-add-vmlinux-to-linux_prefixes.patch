From 17a72d0eb488422c27565c3d6a7be6b979a47cad Mon Sep 17 00:00:00 2001
From: Liu Zichen <tehtiam@aosc.io>
Date: Thu, 19 Nov 2026 23:02:05 +0800
Subject: [PATCH 4/4] AOSCOS: add `vmlinux` to `linux_prefixes`

---
 refind.conf-sample | 2 +-
 refind/global.h    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/refind.conf-sample b/refind.conf-sample
index 2ef1fea..2400528 100644
--- a/refind.conf-sample
+++ b/refind.conf-sample
@@ -475,7 +475,7 @@ use_nvram false
 # Default is "vmlinuz,bzImage,kernel", except on ARM64, where it is
 # "vmlinuz,Image,kernel".
 #
-#linux_prefixes vmlinuz,bzImage,kernel
+#linux_prefixes vmlinux,vmlinuz,bzImage,kernel
 #linux_prefixes +,zImage
 
 # Comma-delimited list of strings to treat as if they were numbers for the
diff --git a/refind/global.h b/refind/global.h
index a2162aa..ab9f568 100644
--- a/refind/global.h
+++ b/refind/global.h
@@ -204,9 +204,9 @@
 // scan_all_linux_kernels option is set in the configuration file. Causes kernels WITHOUT
 // a ".efi" extension to be found when scanning for boot loaders.
 #if defined(EFIAARCH64)
-#define LINUX_PREFIXES          L"vmlinuz,Image,kernel"
+#define LINUX_PREFIXES          L"vmlinux,vmlinuz,Image,kernel"
 #else
-#define LINUX_PREFIXES          L"vmlinuz,bzImage,kernel"
+#define LINUX_PREFIXES          L"vmlinux,vmlinuz,bzImage,kernel"
 #endif
 
 // Definitions for the "hideui" option in refind.conf
-- 
