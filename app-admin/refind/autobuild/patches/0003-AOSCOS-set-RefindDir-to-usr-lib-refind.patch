From 63c0cfcae3520f8ae476990a135cb05fa34567df Mon Sep 17 00:00:00 2001
From: Liu Zichen <tehtiam@aosc.io>
Date: Thu, 19 Nov 2026 19:48:40 +0800
Subject: [PATCH 3/4] AOSCOS: set `RefindDir` to `/usr/lib/refind`

---
 refind-install | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/refind-install b/refind-install
index 286ba17..9bd16f8 100755
--- a/refind-install
+++ b/refind-install
@@ -357,7 +357,7 @@ CheckForFiles() {
            ThisDir="$(dirname "$(readlink -f "$0")")"
            ;;
    esac
-   RefindDir="$ThisDir/refind"
+   RefindDir="/usr/lib/refind"
 
    if [[ ! -f "$RefindDir/refind_$Platform.efi" ]] ; then
       echo "The rEFInd binary file is missing! Aborting installation!"
