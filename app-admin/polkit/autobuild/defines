PKGNAME=polkit
PKGSEC=admin
PKGDEP="expat systemd glib linux-pam duktape"
BUILDDEP="autoconf-archive docbook-xsl gobject-introspection intltool libxslt"
BUILDDEP__RETRO="autoconf-archive docbook-xsl intltool libxslt"
PKGDES="Daemon and utilities for controlling system-wide privileges"

ABTYPE=meson
MESON_AFTER=(
    '-Dsession_tracking=logind'
    '-Dlibs-only=false'
    '-Dpolkitd_user=polkitd'
    '-Dauthfw=pam'
    '-Dos_type=redhat'
    '-Dexamples=true'
    '-Dtests=false'
    '-Dintrospection=true'
    '-Dgtk_doc=false'
    '-Dman=true'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=false'
)
