PKGNAME=corosync
PKGSEC=admin
PKGDEP="libstatgrab libqb nss net-snmp kronosnet"
PKGDES="Cluster engine for nodal communications systems with high availability features"

AUTOTOOLS_AFTER=(
    '--enable-dbus'
    '--enable-monitoring'
    '--enable-watchdog'
    '--enable-systemd'
    '--enable-snmp'
    '--enable-xmlconf'
    '--with-systemddir=/usr/lib/systemd/system'
)

