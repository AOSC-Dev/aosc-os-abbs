PKGNAME=linux-pam
PKGSEC=admin
PKGDEP="glibc libtirpc libnsl2 db libeconf libxcrypt"
PKGPRDEP="libeconf"
PKGDES="Pluggable Authentication Modules"

ABTYPE=meson
MESON_AFTER=(
	"-Ddocs=disabled"
	"-Dexamples=false"
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
