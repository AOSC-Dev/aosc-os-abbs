From 627679edab117e28a1d106e57107852674434ba1 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Fri, 9 Oct 2026 17:24:08 +0800
Subject: [PATCH 355/468] RUYI: riscv: dts: spacemit: describe K3 USB3 Port A
 resources

FROM: https://github.com/openRuyi-Project/linux/commit/9433dfe2e2a71100ec5aee482cc893f7daac4414

Describe the Port A controller and its USB2 and USB3 PHY resources.
Keep the devices disabled until a board supplies connector wiring.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/spacemit/k3.dtsi | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/arch/riscv/boot/dts/spacemit/k3.dtsi b/arch/riscv/boot/dts/spacemit/k3.dtsi
index 07bfbb055aa92..d9867a074917d 100644
--- a/arch/riscv/boot/dts/spacemit/k3.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k3.dtsi
@@ -915,14 +915,15 @@ usb3a: usb@cad00000 {
 				 <&syscon_apmu RESET_APMU_USB3_A_VCC>,
 				 <&syscon_apmu RESET_APMU_USB3_A_PHY>;
 			reset-names = "ahb", "vcc", "phy";
-			phys = <&usb3a_u2phy>;
-			phy-names = "usb2-phy";
 			phy_type = "utmi";
+			phys = <&usb3a_u2phy>, <&usb3a_u3phy>;
+			phy-names = "usb2-phy", "usb3-phy";
 			snps,dis_enblslpm_quirk;
 			snps,dis_u2_susphy_quirk;
+			snps,dis_u3_susphy_quirk;
 			snps,dis-del-phy-power-chg-quirk;
 			snps,dis-tx-ipgap-linecheck-quirk;
-			maximum-speed = "high-speed";
+			snps,parkmode-disable-ss-quirk;
 			status = "disabled";
 		};
 
@@ -934,6 +935,16 @@ usb3a_u2phy: phy@cad20000 {
 			status = "disabled";
 		};
 
+		usb3a_u3phy: phy@cad30000 {
+			compatible = "spacemit,k3-usb3-phy";
+			reg = <0x0 0xcad30000 0x0 0x200>,
+			      <0x0 0xcad40000 0x0 0x200>;
+			clocks = <&syscon_apmu CLK_APMU_USB3_PORTA_BUS>;
+			spacemit,syscon-apb-spare = <&pll>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		pdma: dma-controller@d4000000 {
 			compatible = "spacemit,k3-pdma";
 			reg = <0x0 0xd4000000 0x0 0x4000>;
-- 
