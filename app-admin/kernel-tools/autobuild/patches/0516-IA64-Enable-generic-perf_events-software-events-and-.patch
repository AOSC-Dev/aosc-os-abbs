From cbe13d85c568812a41a7b721a15f418379630d7a Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Fri, 10 Jul 2026 22:33:04 +0200
Subject: [PATCH 516/634] IA64: Enable generic perf_events (software events and
 tracepoints)

ia64 has never had generic perf_events support: it only ever provided
the ia64-specific perfmon driver (perfmonctl(2), since removed), so the
perf(1) tool does not work at all. The perf_event_open syscall is wired
in the syscall table but resolves to the -ENOSYS stub because
CONFIG_PERF_EVENTS cannot be selected.

Wire up the minimal arch support needed for software events and
tracepoints, mirroring architectures without a hardware PMU driver (e.g.
hexagon): select HAVE_PERF_EVENTS and add an empty asm/perf_event.h. The
former mandatory arch hooks now have generic defaults
(perf_arch_instruction_pointer() falls back to instruction_pointer(),
which ia64 already provides; perf_callchain_*() are weak no-ops), so no
arch C code is required.

This makes CONFIG_PERF_EVENTS selectable and turns sys_perf_event_open
into the real implementation. perf stat/record of software events
(task-clock, context-switches, page-faults, ...) and, with tracing
enabled, kernel tracepoints now work. No hardware PMU driver is added,
so hardware events (cycles, cache-misses) remain unsupported and fail
gracefully.

Assisted-by: Claude:claude-opus-4-8
Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 arch/ia64/Kconfig                  |  1 +
 arch/ia64/include/asm/perf_event.h | 11 +++++++++++
 2 files changed, 12 insertions(+)
 create mode 100644 arch/ia64/include/asm/perf_event.h

diff --git a/arch/ia64/Kconfig b/arch/ia64/Kconfig
index bed1b5271d09e..e3b9f477cbb8b 100644
--- a/arch/ia64/Kconfig
+++ b/arch/ia64/Kconfig
@@ -36,6 +36,7 @@ config IA64
 	select HAVE_FTRACE_MCOUNT_RECORD
 	select HAVE_DYNAMIC_FTRACE if (!ITANIUM)
 	select HAVE_FUNCTION_TRACER
+	select HAVE_PERF_EVENTS
 	select HAVE_SETUP_PER_CPU_AREA
 	select TTY
 	select HAVE_ARCH_TRACEHOOK
diff --git a/arch/ia64/include/asm/perf_event.h b/arch/ia64/include/asm/perf_event.h
new file mode 100644
index 0000000000000..0197005a33959
--- /dev/null
+++ b/arch/ia64/include/asm/perf_event.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_IA64_PERF_EVENT_H
+#define _ASM_IA64_PERF_EVENT_H
+
+/*
+ * ia64 provides no hardware PMU driver, so perf_events is limited to software
+ * events and tracepoints. The generic definitions in <linux/perf_event.h> are
+ * sufficient; no arch-specific hooks are required.
+ */
+
+#endif /* _ASM_IA64_PERF_EVENT_H */
-- 
