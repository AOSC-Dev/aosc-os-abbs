+	/* RX ring 64-bit monotonic positions, in 32-bit words */
+	struct dma_chan		*rx_ch;
+	dma_cookie_t		rx_cookie;
+	dma_addr_t		rx_dma_addr;
+	unsigned int		*rx_cpu_buf;
