From 56540b35591c0fa9818fe9af4b32465c1721baca Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Sat, 14 Nov 2026 18:08:08 +0800
Subject: [PATCH 468/468] AOSCOS: MIPS: audit: add missing includes for
 audit_classify_syscall_{n,o}32
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Functions `audit_classify_syscall_{n,o}32()' are not declared as static
and its prototype was never included from the corresponding headers,
resulting in build failure:

  arch/mips/kernel/audit-o32.c:33:5: error: no previous prototype for ‘audit_classify_syscall_o32’ [-Werror=missing-prototypes]
     33 | int audit_classify_syscall_o32(int abi, unsigned syscall)
        |     ^~~~~~~~~~~~~~~~~~~~~~~~~~

Add the corresponding headers ("audit-{n,o}32.h") to fix build.

Fixes: "BACKPORT: FROMLIST: MIPS: Add syscall auditing support"
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 arch/mips/kernel/audit-n32.c | 2 ++
 arch/mips/kernel/audit-o32.c | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/arch/mips/kernel/audit-n32.c b/arch/mips/kernel/audit-n32.c
index 0b5a91e99d16c..f380ce187cb19 100644
--- a/arch/mips/kernel/audit-n32.c
+++ b/arch/mips/kernel/audit-n32.c
@@ -5,6 +5,8 @@
 #include <linux/audit.h>
 #include <asm/unistd.h>
 
+#include "audit-n32.h"
+
 static unsigned dir_class_n32[] = {
 #include <asm-generic/audit_dir_write.h>
 ~0U
diff --git a/arch/mips/kernel/audit-o32.c b/arch/mips/kernel/audit-o32.c
index 2133a3cbbf2dd..91699c343a2d9 100644
--- a/arch/mips/kernel/audit-o32.c
+++ b/arch/mips/kernel/audit-o32.c
@@ -5,6 +5,8 @@
 #include <linux/audit.h>
 #include <linux/unistd.h>
 
+#include "audit-o32.h"
+
 static unsigned dir_class_o32[] = {
 #include <asm-generic/audit_dir_write.h>
 ~0U
-- 
2.56.0

