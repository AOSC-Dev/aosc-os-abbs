From 0244737cb1438a202012e6438a64a319ad8bf4d3 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 7 Oct 2026 01:59:30 +0800
Subject: [PATCH 359/468] RUYI: riscv: dts: spacemit: bind Ethernet MACs to
 Pico ITX EEPROM

FROM: https://github.com/openRuyi-Project/linux/commit/9a0d4590913a98a7143b46c63f362fd2d51790a4

Use the existing ONIE base-address cell for EQoS and the onboard
RTL8127, with offsets zero and one. Preserve the EEPROM geometry and
read-only OS policy.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/spacemit/k3-pico-itx.dts | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
index 992abde0d179d..250fad5991cfc 100644
--- a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
+++ b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
@@ -15,6 +15,7 @@ / {
 
 	aliases {
 		ethernet0 = &eth0;
+		ethernet1 = &rtl8127;
 		i2c1 = &i2c1;
 		i2c2 = &i2c2;
 		i2c8 = &i2c8;
@@ -110,7 +111,7 @@ eeprom@50 {
 		nvmem-layout {
 			compatible = "onie,tlv-layout";
 
-			mac-address {
+			board_mac_addresses: mac-address {
 				#nvmem-cell-cells = <1>;
 			};
 
@@ -279,6 +280,8 @@ &eth0 {
 	pinctrl-0 = <&gmac0_rgmii_0_cfg>, <&gmac0_phy_0_cfg>;
 	phy-mode = "rgmii-id";
 	phy-handle = <&phy0>;
+	nvmem-cells = <&board_mac_addresses 0>;
+	nvmem-cell-names = "mac-address";
 	status = "okay";
 
 	mdio {
@@ -393,6 +396,13 @@ pcie@0 {
 		vpcie3v3-supply = <&reg_aux_vcc3v3>;
 		phys = <&combophy 2 PHY_TYPE_PCIE>,
 		       <&combophy 3 PHY_TYPE_PCIE>;
+
+		rtl8127: ethernet@0 {
+			compatible = "pci10ec,8127";
+			reg = <0x00010000 0 0 0 0>;
+			nvmem-cells = <&board_mac_addresses 1>;
+			nvmem-cell-names = "mac-address";
+		};
 	};
 };
 
