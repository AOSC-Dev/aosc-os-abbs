From 11795c202d58d572c4577e097062005e42dc9900 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Fri, 9 Oct 2026 17:24:09 +0800
Subject: [PATCH 357/468] RUYI: riscv: dts: spacemit: enable Pico ITX Type-C
 Port A

FROM: https://github.com/openRuyi-Project/linux/commit/621a5b553e5b138fee390a3ee397a654df7d95e8

Connect the FUSB301 autonomous Type-C controller to the USB role
switch and describe the board pin configuration. Keep high-speed
mode until SuperSpeed operation is qualified.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 arch/riscv/boot/dts/spacemit/k3-pico-itx.dts | 82 +++++++++++++++++---
 1 file changed, 73 insertions(+), 9 deletions(-)

diff --git a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
index 3bab31fcc4d90..df390895e0141 100644
--- a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
+++ b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
@@ -15,6 +15,7 @@ / {
 
 	aliases {
 		ethernet0 = &eth0;
+		i2c1 = &i2c1;
 		i2c2 = &i2c2;
 		i2c8 = &i2c8;
 		serial0 = &uart0;
@@ -60,6 +61,35 @@ rfkill-usb-bt {
 	};
 };
 
+&i2c1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pico_i2c1_cfg>;
+	status = "okay";
+
+	typec@25 {
+		compatible = "onsemi,fusb301";
+		reg = <0x25>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pico_fusb301_cfg>;
+		interrupts-extended = <&gpio 2 21 IRQ_TYPE_EDGE_FALLING>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C OTG";
+			data-role = "dual";
+			power-role = "dual";
+			typec-power-opmode = "default";
+			pd-disable;
+
+			port {
+				pico_typec_hs: endpoint {
+					remote-endpoint = <&pico_usb3a_hs>;
+				};
+			};
+		};
+	};
+};
+
 &i2c2 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c2_1_cfg>;
@@ -260,6 +290,26 @@ phy0: ethernet-phy@1 {
 	};
 };
 
+&pinctrl {
+	pico_i2c1_cfg: pico-i2c1-cfg {
+		pins {
+			pinmux = <K3_PADCONF(102, 6)>, <K3_PADCONF(103, 6)>;
+			bias-pull-up;
+			drive-strength = <25>;
+			power-source = <3300>;
+		};
+	};
+
+	pico_fusb301_cfg: pico-fusb301-cfg {
+		pins {
+			pinmux = <K3_PADCONF(85, 0)>;
+			bias-pull-up;
+			drive-strength = <25>;
+			power-source = <1800>;
+		};
+	};
+};
+
 &qspi_cfg {
 	qspi-pins {
 		power-source = <1800>;
@@ -380,6 +430,29 @@ &usb2_phy {
 	status = "okay";
 };
 
+&usb3a {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+	/* Use UTMI while both orientation-specific PIPE PHYs are parked. */
+	maximum-speed = "high-speed";
+	status = "okay";
+
+	port {
+		pico_usb3a_hs: endpoint {
+			remote-endpoint = <&pico_typec_hs>;
+		};
+	};
+};
+
+&usb3a_u2phy {
+	status = "okay";
+};
+
+&usb3a_u3phy {
+	status = "okay";
+};
+
 &usb3b {
 	phys = <&usb3b_u2phy>;
 	phy-names = "usb2-phy";
@@ -402,15 +475,6 @@ &usb3c_u2phy {
 	status = "okay";
 };
 
-&usb3a_u2phy {
-	status = "okay";
-};
-
-&usb3a {
-	dr_mode = "peripheral";
-	status = "okay";
-};
-
 &usb3d_u2phy {
 	status = "okay";
 };
-- 
2.56.0

