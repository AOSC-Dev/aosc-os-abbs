From 6b5655d567b9d61a242e7de498a9667f1a79122f Mon Sep 17 00:00:00 2001
From: Hangfan Li <lihangfan@iscas.ac.cn>
Date: Thu, 15 Oct 2026 11:16:31 +0800
Subject: [PATCH 366/468] RUYI: scsi: ufs: spacemit: Enter FASTAUTO before
 switching to FAST mode

FROM: https://github.com/openRuyi-Project/linux/commit/9256f641b221bafd335464247e9afdec0b0adac3

Some UFS devices stop responding to UTP transfers after a direct
transition from the initial power mode to HS FAST mode. Match the
vendor sequence by first switching to FASTAUTO mode, waiting 1 ms
for the link to settle, and then allowing the UFS core to perform
the requested FAST-mode transition.

This fixes UFS initialization on K3 PICO-ITX boards with YMTC
YMUS8B5TH1A1C1 devices.

Signed-off-by: Hangfan Li <lihangfan@iscas.ac.cn>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 drivers/ufs/host/ufs-spacemit.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/ufs/host/ufs-spacemit.c b/drivers/ufs/host/ufs-spacemit.c
index 1b7f48695d356..504de2a6ef7f8 100644
--- a/drivers/ufs/host/ufs-spacemit.c
+++ b/drivers/ufs/host/ufs-spacemit.c
@@ -356,6 +356,33 @@ static int ufs_spacemit_pwr_change_notify(struct ufs_hba *hba,
 
 	switch (status) {
 	case PRE_CHANGE:
+		/*
+		 * Some UFS devices complete a direct transition to HS FAST
+		 * mode but then stop responding to UTP transfers, which makes
+		 * the link unusable right after the gear-up.
+		 *
+		 * The vendor code gears such links up in two steps: settle in
+		 * FASTAUTO mode first, then request FAST mode.  Do the same
+		 * here before the core performs the requested FAST transition.
+		 */
+		if (dev_req_params->pwr_rx == FAST_MODE &&
+		    dev_req_params->pwr_tx == FAST_MODE &&
+		    (hba->pwr_info.pwr_rx != FAST_MODE ||
+		     hba->pwr_info.pwr_tx != FAST_MODE)) {
+			struct ufs_pa_layer_attr auto_params = *dev_req_params;
+
+			auto_params.pwr_rx = FASTAUTO_MODE;
+			auto_params.pwr_tx = FASTAUTO_MODE;
+
+			ret = ufshcd_change_power_mode(hba, &auto_params,
+						       UFSHCD_PMC_POLICY_DONT_FORCE);
+			if (ret)
+				dev_warn(hba->dev,
+					 "failed to settle the link in FASTAUTO mode: %d\n",
+					 ret);
+			else
+				fsleep(1000);
+		}
 		break;
 	case POST_CHANGE:
 		ret = ufs_spacemit_wait_mphy_pll_lock(hba);
-- 
