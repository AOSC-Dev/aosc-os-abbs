From b89791dc893f765a9cd557b278b6d36fcb842994 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 7 Oct 2026 01:59:30 +0800
Subject: [PATCH 350/468] RUYI: dt-bindings: phy: describe the K3 Port A PIPE
 PHYs

FROM: https://github.com/openRuyi-Project/linux/commit/a94f46c42cec3e480e7aad7ebbcc8f44e43c8b84

Describe the two dedicated register windows, shared PHY clock and
calibration syscon used by K3 USB Port A.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../bindings/phy/spacemit,k3-usb3-phy.yaml    | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/spacemit,k3-usb3-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/spacemit,k3-usb3-phy.yaml b/Documentation/devicetree/bindings/phy/spacemit,k3-usb3-phy.yaml
new file mode 100644
index 0000000000000..655ef00e4abf6
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/spacemit,k3-usb3-phy.yaml
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/spacemit,k3-usb3-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: SpacemiT K3 USB Port A PIPE PHYs
+maintainers:
+  - Han Gao <gaohan@iscas.ac.cn>
+description:
+  Port A has two dedicated PIPE PHYs selected according to Type-C cable
+  orientation. Both must be parked when operating with only the UTMI PHY.
+properties:
+  compatible:
+    const: spacemit,k3-usb3-phy
+  reg:
+    items:
+      - description: First orientation PIPE PHY registers
+      - description: Second orientation PIPE PHY registers
+  clocks:
+    maxItems: 1
+  spacemit,syscon-apb-spare:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Shared PHY resistance calibration register block.
+  '#phy-cells':
+    const: 0
+required:
+  - compatible
+  - reg
+  - clocks
+  - spacemit,syscon-apb-spare
+  - '#phy-cells'
+additionalProperties: false
-- 
2.56.0

