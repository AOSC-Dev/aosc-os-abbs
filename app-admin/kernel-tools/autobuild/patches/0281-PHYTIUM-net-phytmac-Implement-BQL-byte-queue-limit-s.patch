From e235b28f9348bf3f04dee0385048adb6f85eb1f3 Mon Sep 17 00:00:00 2001
From: zuoqian <zuoqian2032@phytium.com.cn>
Date: Tue, 12 May 2026 11:48:17 +0800
Subject: [PATCH 281/468] PHYTIUM: net: phytmac: Implement BQL (byte queue
 limit) support

Testing with iperf3 and ping shows:
When combined with fq_codel, the average latency is significantly
reduced from ~5ms to ~2ms while maintaining full
line-rate throughput.

Signed-off-by: zuoqian <zuoqian2032@phytium.com.cn>

Link: https://gitee.com/phytium_embedded/phytium-linux-kernel/commit/3a3f8a0a07d2e7cf3c94b42a539c361da43ad444
Signed-off-by: Kexy Biscuit <kexybiscuit@aosc.io>
---
 drivers/net/ethernet/phytium/phytmac_main.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/net/ethernet/phytium/phytmac_main.c b/drivers/net/ethernet/phytium/phytmac_main.c
index 70611ef867f47..72f86255e34a8 100644
--- a/drivers/net/ethernet/phytium/phytmac_main.c
+++ b/drivers/net/ethernet/phytium/phytmac_main.c
@@ -1333,6 +1333,7 @@ static int phytmac_tx_clean(struct phytmac_queue *queue, int budget)
 	int packet_count = 0;
 	unsigned int tail = queue->tx_tail;
 	unsigned int head;
+	u32 bytes = 0;
 
 	spin_lock(&queue->tx_lock);
 
@@ -1364,6 +1365,7 @@ static int phytmac_tx_clean(struct phytmac_queue *queue, int budget)
 					pdata->ndev->stats.tx_bytes += tx_skb->skb->len;
 					queue->stats.tx_bytes += tx_skb->skb->len;
 					packet_count++;
+					bytes += tx_skb->skb->len;
 				}
 			} else if (tx_skb->type == PHYTMAC_TYPE_XDP) {
 				if (tx_skb->xdpf) {
@@ -1390,6 +1392,9 @@ static int phytmac_tx_clean(struct phytmac_queue *queue, int budget)
 			head &= (pdata->tx_ring_size - 1);
 	}
 
+	netdev_tx_completed_queue(netdev_get_tx_queue(pdata->ndev, queue_index),
+					packet_count, bytes);
+
 	queue->tx_head = head;
 	if (__netif_subqueue_stopped(pdata->ndev, queue_index) &&
 	    (phytmac_maybe_wake_tx_queue(queue)))
@@ -1809,6 +1814,9 @@ static netdev_tx_t phytmac_start_xmit(struct sk_buff *skb, struct net_device *nd
 	}
 
 	skb_tx_timestamp(skb);
+	netdev_tx_sent_queue(netdev_get_tx_queue(pdata->ndev, queue_index),
+				skb->len);
+
 	/* Make newly descriptor to hardware */
 	wmb();
 
@@ -2312,6 +2320,7 @@ static int phytmac_close(struct net_device *ndev)
 	for (q = 0, queue = pdata->queues; q < pdata->queues_num; ++q, ++queue) {
 		napi_disable(&queue->tx_napi);
 		napi_disable(&queue->rx_napi);
+		netdev_tx_reset_queue(netdev_get_tx_queue(pdata->ndev, q));
 	}
 
 	phylink_stop(pdata->phylink);
-- 
