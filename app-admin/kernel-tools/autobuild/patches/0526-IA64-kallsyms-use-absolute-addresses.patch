From 027c275aa0621c51b1d6b7ab56ca9afddb366853 Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Mon, 24 Aug 2026 22:22:47 +0200
Subject: [PATCH 526/634] IA64: kallsyms: use absolute addresses

Make CONFIG_KALLSYMS_BASE_RELATIVE depend on !IA64 in order for ia64 to
use the restored absolute adressing.

This allows building ia64 with CONFIG_KALLSYMS_ALL=y.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 init/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/init/Kconfig b/init/Kconfig
index 7d85c653a6de7..a4f5241cb8a7c 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -2140,7 +2140,7 @@ config KALLSYMS_ALL
 config KALLSYMS_BASE_RELATIVE
 	bool
 	depends on KALLSYMS
-	default y
+	default !IA64
 	help
 	  Instead of emitting them as absolute values in the native word size,
 	  emit the symbol references in the kallsyms table as 32-bit entries,
-- 
2.56.0

