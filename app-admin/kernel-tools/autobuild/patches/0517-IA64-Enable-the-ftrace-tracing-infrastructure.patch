From 60f30abab437380c67c1c1c5683dfd698cdbacbf Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Fri, 10 Jul 2026 23:02:43 +0200
Subject: [PATCH 517/634] IA64: Enable the ftrace/tracing infrastructure

The generic tracing core (CONFIG_TRACING and thus FTRACE, the trace event
subsystem and tracepoint-based perf events) is gated behind
CONFIG_TRACING_SUPPORT, which requires both STACKTRACE_SUPPORT and
TRACE_IRQFLAGS_SUPPORT. ia64 already provides the former and already uses
the modern arch_local_irq_*() primitives that the generic irqflags
tracing layer wraps, but never selected TRACE_IRQFLAGS_SUPPORT, so the
whole tracing menu was unavailable.

Select TRACE_IRQFLAGS_SUPPORT to unlock it. This makes tracepoint events
usable, which in particular lets the perf_events support enabled in the
previous commit open tracepoint (sched:*, irq:*, ...) events, not just
software events.

Enabling tracing also builds kernel/trace/ring_buffer.c for the first
time on ia64, which includes <asm/ring_buffer.h>; wire up the
asm-generic stub via generic-y so it resolves.

Assisted-by: Claude:claude-opus-4-8
Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 arch/ia64/Kconfig            | 1 +
 arch/ia64/include/asm/Kbuild | 1 +
 2 files changed, 2 insertions(+)

diff --git a/arch/ia64/Kconfig b/arch/ia64/Kconfig
index e3b9f477cbb8b..81ae1a2f21515 100644
--- a/arch/ia64/Kconfig
+++ b/arch/ia64/Kconfig
@@ -37,6 +37,7 @@ config IA64
 	select HAVE_DYNAMIC_FTRACE if (!ITANIUM)
 	select HAVE_FUNCTION_TRACER
 	select HAVE_PERF_EVENTS
+	select TRACE_IRQFLAGS_SUPPORT
 	select HAVE_SETUP_PER_CPU_AREA
 	select TTY
 	select HAVE_ARCH_TRACEHOOK
diff --git a/arch/ia64/include/asm/Kbuild b/arch/ia64/include/asm/Kbuild
index f6c6892cd1cfc..0d37970eb8f29 100644
--- a/arch/ia64/include/asm/Kbuild
+++ b/arch/ia64/include/asm/Kbuild
@@ -3,3 +3,4 @@ generated-y += syscall_table.h
 generic-y += agp.h
 generic-y += kvm_para.h
 generic-y += mcs_spinlock.h
+generic-y += ring_buffer.h
