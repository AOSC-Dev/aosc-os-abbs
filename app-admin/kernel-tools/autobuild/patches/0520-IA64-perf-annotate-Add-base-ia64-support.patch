@@ -154,6 +156,10 @@ int ins__raw_scnprintf(const struct ins *ins, char *bf, size_t size,
 			   struct ins_operands *ops, int max_ins_name);
 int ins__scnprintf(const struct ins *ins, char *bf, size_t size,
