From 36feb9b071c68225a99d083f6da1bd95ba1f66c7 Mon Sep 17 00:00:00 2001
From: Xi Ruoyao <xry111@xry111.site>
Date: Fri, 12 Jun 2026 23:32:42 +0800
Subject: [PATCH 453/468] AOSCOS: drm/ttm: fix incorrect caching type caused by
 a previous AOSCOS patch

The ttm_mem_io_reserve() function calls a driver-defined callback to set
mem->bus.caching.  Thus we cannot use the value read before calling
ttm_mem_io_reserve(), or we'd effectively erase the set from driver.
Instead we should only downgrade cached to write_combined if the driver
says to use cached.

Fixes: "AOSCOS: drm/ttm: downgrade cached mappings for non-coherent devices on the linear-IO and single-page paths"
Signed-off-by: Xi Ruoyao <xry111@xry111.site>
---
 drivers/gpu/drm/ttm/ttm_resource.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/ttm/ttm_resource.c b/drivers/gpu/drm/ttm/ttm_resource.c
index 1b94d3a183f18..4c6f6730ce65b 100644
--- a/drivers/gpu/drm/ttm/ttm_resource.c
+++ b/drivers/gpu/drm/ttm/ttm_resource.c
@@ -867,14 +867,16 @@ ttm_kmap_iter_linear_io_init(struct ttm_kmap_iter_linear_io *iter_io,
 			     struct ttm_device *bdev,
 			     struct ttm_resource *mem)
 {
-	enum ttm_caching caching = mem->bus.caching;
+	enum ttm_caching caching;
 	int ret;
 
+	ret = ttm_mem_io_reserve(bdev, mem);
+	caching = mem->bus.caching;
+
 	/* Downgrade cached mapping for non-snooping devices */
 	if (!bdev->dma_coherent && caching == ttm_cached)
 		caching = ttm_write_combined;
 
-	ret = ttm_mem_io_reserve(bdev, mem);
 	if (ret)
 		goto out_err;
 	if (!mem->bus.is_iomem) {
-- 
