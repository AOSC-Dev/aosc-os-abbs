From 67a02efd28dff96ecdf4f171689132ba5f19c84a Mon Sep 17 00:00:00 2001
From: Baihui Liang <liangbaihui@linux.spacemit.com>
Date: Thu, 15 Oct 2026 15:00:48 +0800
Subject: [PATCH 037/468] UPSTREAM: dt-bindings: gpu: img,powervr-rogue: add
 spacemit,k1-gpu and spacemit,k3-gpu

Add compatible strings for the IMG GPUs in SpacemiT K1 and K3 SoCs:
- K1: IMG BXE-2-32 (adds a dedicated entry for a single core
  clock and power domain).
- K3: IMG BXM-4-64 (shares the same configuration and entry as
  the T-Head TH1520).

Signed-off-by: Baihui Liang <liangbaihui@linux.spacemit.com>
Reviewed-by: Krzysztof Kozlowski <krzysztof.kozlowski@oss.qualcomm.com>
Link: https://patch.msgid.link/20261015-spacemit-gpu-binding-v1-1-a7a23c7e7788@linux.spacemit.com
Signed-off-by: Rob Herring (Arm) <robh@kernel.org>
(cherry picked from commit 16f30811a93561a53307955b96573a0f24404d9f)
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../bindings/gpu/img,powervr-rogue.yaml         | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/gpu/img,powervr-rogue.yaml b/Documentation/devicetree/bindings/gpu/img,powervr-rogue.yaml
index e9218e0f363d1..600445cd506d3 100644
--- a/Documentation/devicetree/bindings/gpu/img,powervr-rogue.yaml
+++ b/Documentation/devicetree/bindings/gpu/img,powervr-rogue.yaml
@@ -37,6 +37,12 @@ properties:
           - const: img,img-rogue
       - items:
           - enum:
+              - spacemit,k1-gpu
+          - const: img,img-bxe-2-32
+          - const: img,img-rogue
+      - items:
+          - enum:
+              - spacemit,k3-gpu
               - thead,th1520-gpu
           - const: img,img-bxm-4-64
           - const: img,img-rogue
@@ -102,6 +108,8 @@ allOf:
         compatible:
           contains:
             enum:
+              - spacemit,k1-gpu
+              - spacemit,k3-gpu
               - ti,am62-gpu
               - ti,am62p-gpu
               - ti,j721s2-gpu
@@ -162,13 +170,16 @@ allOf:
       properties:
         compatible:
           contains:
-            const: thead,th1520-gpu
+            enum:
+              - spacemit,k1-gpu
+              - spacemit,k3-gpu
+              - thead,th1520-gpu
     then:
       properties:
         power-domains:
           items:
-            - description: The single, unified power domain for the GPU on the
-                TH1520 SoC, integrating all internal IP power domains.
+            - description: The single, unified power domain for the GPU,
+                integrating all internal IP power domains.
         power-domain-names: false
       required:
         - power-domains
