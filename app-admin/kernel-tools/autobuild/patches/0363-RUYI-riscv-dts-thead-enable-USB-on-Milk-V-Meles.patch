From 8fbbf0c0ae24471cdb4eb95ffa65ed6e02d707a0 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Mon, 21 Sep 2026 01:19:07 +0800
Subject: [PATCH 363/468] RUYI: riscv: dts: thead: enable USB on Milk-V Meles

FROM: https://github.com/openRuyi-Project/linux/commit/4c6b2b414be67670138290d0e05ad9c86a99bc65

Describe the GL3523 companion hubs, their peer relationship and the four
USB-A connectors. Keep the fixed hub core supply separate from
GPIO0_27-controlled VBUS and the USB PHY analog rail.

GPIO2_30 selects the onboard hub. Configure the VBUS pad while leaving
mux selection to the GPIO request, and retain the enabled supply at
firmware handoff. Keep the USB2 PHY out of suspend so companion-hub
port-status requests and storage enumeration complete.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../boot/dts/thead/th1520-milkv-meles.dts     | 260 ++++++++++++++++++
 1 file changed, 260 insertions(+)

diff --git a/arch/riscv/boot/dts/thead/th1520-milkv-meles.dts b/arch/riscv/boot/dts/thead/th1520-milkv-meles.dts
index 1c9de6b37a3e6..dfdcaad7cf104 100644
--- a/arch/riscv/boot/dts/thead/th1520-milkv-meles.dts
+++ b/arch/riscv/boot/dts/thead/th1520-milkv-meles.dts
@@ -38,6 +38,110 @@ wifi_32k: clock-wifi-32k {
 		/* The module LPO input is supplied by PMIC_32K_OUT. */
 	};
 
+	connector-usb-a-1 {
+		compatible = "usb-a-connector";
+		vbus-supply = <&usb_vbus>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				usb_a_1_hs_ep: endpoint {
+					remote-endpoint = <&hub_hs_port1_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				usb_a_1_ss_ep: endpoint {
+					remote-endpoint = <&hub_ss_port1_ep>;
+				};
+			};
+		};
+	};
+
+	connector-usb-a-2 {
+		compatible = "usb-a-connector";
+		vbus-supply = <&usb_vbus>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				usb_a_2_hs_ep: endpoint {
+					remote-endpoint = <&hub_hs_port2_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				usb_a_2_ss_ep: endpoint {
+					remote-endpoint = <&hub_ss_port2_ep>;
+				};
+			};
+		};
+	};
+
+	connector-usb-a-3 {
+		compatible = "usb-a-connector";
+		vbus-supply = <&usb_vbus>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				usb_a_3_hs_ep: endpoint {
+					remote-endpoint = <&hub_hs_port3_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				usb_a_3_ss_ep: endpoint {
+					remote-endpoint = <&hub_ss_port3_ep>;
+				};
+			};
+		};
+	};
+
+	connector-usb-a-4 {
+		compatible = "usb-a-connector";
+		vbus-supply = <&usb_vbus>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				usb_a_4_hs_ep: endpoint {
+					remote-endpoint = <&hub_hs_port4_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				usb_a_4_ss_ep: endpoint {
+					remote-endpoint = <&hub_ss_port4_ep>;
+				};
+			};
+		};
+	};
+
 	hdmi-connector {
 		compatible = "hdmi-connector";
 		type = "a";
@@ -63,6 +167,40 @@ fan: pwm-fan {
 		#cooling-cells = <2>;
 	};
 
+	/* AVDD33_USB3 is supplied by the always-on DA9063 LDO9 rail. */
+	avdd33_usb3: regulator-avdd33-usb3 {
+		compatible = "regulator-fixed";
+		regulator-name = "AVDD33_USB3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	usb_vbus: regulator-usb-vbus {
+		/* U26 switches connector VBUS, not the GL3523 core supplies. */
+		compatible = "regulator-fixed";
+		regulator-name = "USB_VBUS";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio0 27 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_vbus_pins>;
+		/* Adopt the firmware's high enable level without a low pulse. */
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	/* GL3523 core power; independent of the connector VBUS switch. */
+	vcc_3v3: regulator-vcc-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
 	wifi_vbat: regulator-wifi-vbat {
 		compatible = "regulator-fixed";
 		regulator-name = "WIFI_3V3";
@@ -142,6 +280,14 @@ &gpio2 {
 			  "", "", "", "", "GPIO2_22", "GPIO2_23",
 			  "GPIO2_24", "GPIO2_25", "", "", "", "", "",
 			  "GPIO2_31";
+
+	/* Vendor wiring, verified on Meles V1.3: low selects the GL3523. */
+	usb-hub-select-hog {
+		gpio-hog;
+		gpios = <30 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "usb-hub-select";
+	};
 };
 
 &gpio3 {
@@ -275,6 +421,16 @@ rx-pins {
 };
 
 &padctrl1_apsys {
+	usb_vbus_pins: usb-vbus-0 {
+		usb-pins {
+			pins = "GPIO0_27";
+			/* The regulator's GPIO request selects the pin mux. */
+			bias-disable;
+			drive-strength = <7>;
+			input-disable;
+		};
+	};
+
 	wifi_enable_pins: wifi-enable-0 {
 		gpio-pins {
 			pins = "GPIO0_20";
@@ -344,3 +500,107 @@ &uart0 {
 
 	status = "okay";
 };
+
+/* RESETn is an RC circuit; neither companion hub has a reset GPIO. */
+&usb {
+	dr_mode = "host";
+	snps,dis_u2_susphy_quirk;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	status = "okay";
+
+	hub_hs: hub@1 {
+		compatible = "usb5e3,610";
+		reg = <1>;
+		peer-hub = <&hub_ss>;
+		vdd-supply = <&vcc_3v3>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@1 {
+				reg = <1>;
+
+				hub_hs_port1_ep: endpoint {
+					remote-endpoint = <&usb_a_1_hs_ep>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+
+				hub_hs_port2_ep: endpoint {
+					remote-endpoint = <&usb_a_2_hs_ep>;
+				};
+			};
+
+			port@3 {
+				reg = <3>;
+
+				hub_hs_port3_ep: endpoint {
+					remote-endpoint = <&usb_a_3_hs_ep>;
+				};
+			};
+
+			port@4 {
+				reg = <4>;
+
+				hub_hs_port4_ep: endpoint {
+					remote-endpoint = <&usb_a_4_hs_ep>;
+				};
+			};
+		};
+	};
+
+	hub_ss: hub@2 {
+		compatible = "usb5e3,620";
+		reg = <2>;
+		peer-hub = <&hub_hs>;
+		vdd-supply = <&vcc_3v3>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@1 {
+				reg = <1>;
+
+				hub_ss_port1_ep: endpoint {
+					remote-endpoint = <&usb_a_1_ss_ep>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+
+				hub_ss_port2_ep: endpoint {
+					remote-endpoint = <&usb_a_2_ss_ep>;
+				};
+			};
+
+			port@3 {
+				reg = <3>;
+
+				hub_ss_port3_ep: endpoint {
+					remote-endpoint = <&usb_a_3_ss_ep>;
+				};
+			};
+
+			port@4 {
+				reg = <4>;
+
+				hub_ss_port4_ep: endpoint {
+					remote-endpoint = <&usb_a_4_ss_ep>;
+				};
+			};
+		};
+	};
+};
+
+&usb_phy {
+	avdd33-usb3-supply = <&avdd33_usb3>;
+
+	status = "okay";
+};
-- 
2.56.0

