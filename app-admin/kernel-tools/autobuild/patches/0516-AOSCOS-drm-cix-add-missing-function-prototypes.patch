From 9977e3cc906f136dca772a6e461c37c1b0e732ac Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Tue, 12 May 2026 14:43:58 +0800
Subject: [PATCH 516/521] AOSCOS: drm: cix: add missing function prototypes

Suppress build errors with -Werror=missing-prototypes.

Fixes: "CIXTECH: drm: add cix linlon dp driver"
Link: https://github.com/cixtech/cix-linux-main/issues/26
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 drivers/gpu/drm/cix/dptx/hdcp/hdcp2_tx_state.c | 6 +++---
 drivers/gpu/drm/cix/linlon-dp/linlondp_plane.c | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/cix/dptx/hdcp/hdcp2_tx_state.c b/drivers/gpu/drm/cix/dptx/hdcp/hdcp2_tx_state.c
index 598f67295f70b..792ee50ff106c 100644
--- a/drivers/gpu/drm/cix/dptx/hdcp/hdcp2_tx_state.c
+++ b/drivers/gpu/drm/cix/dptx/hdcp/hdcp2_tx_state.c
@@ -48,7 +48,7 @@ static const uint8_t product_lc128[] = { 0x93U, 0xceU, 0x5aU, 0x56U, 0xa0U, 0xa1
 //  Returns:
 //      None
 //------------------------------------------------------------------------------
-void hdcp2_cipher_enable(struct cix_hdcp *hdcp, void *kdata)
+static void hdcp2_cipher_enable(struct cix_hdcp *hdcp, void *kdata)
 {
 	hdcp2_cipher_data_t *tx_data = kdata;
 
@@ -77,7 +77,7 @@ void hdcp2_cipher_enable(struct cix_hdcp *hdcp, void *kdata)
 //  Returns:
 //      None
 //------------------------------------------------------------------------------
-void hdcp2_cipher_disable(struct cix_hdcp *hdcp)
+static void hdcp2_cipher_disable(struct cix_hdcp *hdcp)
 {
 	hdcp2_hw_tx_enable_write(
 		hdcp,
@@ -105,7 +105,7 @@ void hdcp2_cipher_disable(struct cix_hdcp *hdcp)
 //  Returns:
 //      none
 //------------------------------------------------------------------------------
-void hdcp2_tx_state_init(struct cix_hdcp *hdcp)
+static void hdcp2_tx_state_init(struct cix_hdcp *hdcp)
 {
 	hdcp2_hw_tx_enable_write(
 		hdcp,
diff --git a/drivers/gpu/drm/cix/linlon-dp/linlondp_plane.c b/drivers/gpu/drm/cix/linlon-dp/linlondp_plane.c
index 3294adfd86165..4863123a53a85 100644
--- a/drivers/gpu/drm/cix/linlon-dp/linlondp_plane.c
+++ b/drivers/gpu/drm/cix/linlon-dp/linlondp_plane.c
@@ -289,7 +289,7 @@ linlondp_plane_atomic_get_property(struct drm_plane *plane,
 	return 0;
 }
 
-int linlondp_atomic_replace_property_blob_from_id(
+static int linlondp_atomic_replace_property_blob_from_id(
 	struct drm_device *dev, struct drm_property_blob **blob,
 	uint64_t blob_id, ssize_t expected_size, ssize_t expected_elem_size,
 	bool *replaced)
-- 
