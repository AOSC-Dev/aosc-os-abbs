From 6fb6d8e4874e917189b7c21e07dd62829fd4bd90 Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 7 Oct 2026 01:59:30 +0800
Subject: [PATCH 351/468] RUYI: dt-bindings: usb: describe the FUSB301 Type-C
 controller

FROM: https://github.com/openRuyi-Project/linux/commit/0abb20542105dd1f3925268f0bdad0cc5b7e485a

Describe autonomous attachment detection, the USB-C connector and
optional software-controlled VBUS. Require the power-role policy and
exclude unsupported Power Delivery and Try.SRC/Try.SNK operation.

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 .../bindings/usb/onsemi,fusb301.yaml          | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml

diff --git a/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml b/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml
new file mode 100644
index 0000000000000..b0b503ed942ca
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/onsemi,fusb301.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: onsemi FUSB301 autonomous USB Type-C controller
+
+maintainers:
+  - Han Gao <gaohan@iscas.ac.cn>
+
+description: |
+  FUSB301 detects Type-C attachment, partner current advertisement and
+  cable orientation. It does not implement USB Power Delivery. Its ID
+  output can control an external VBUS switch independently of software.
+
+properties:
+  compatible:
+    const: onsemi,fusb301
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  vbus-supply:
+    description: Optional software-controlled source VBUS supply.
+
+  connector:
+    type: object
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+    properties:
+      compatible:
+        const: usb-c-connector
+      try-power-role: false
+    required:
+      - pd-disable
+      - power-role
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - connector
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        typec@25 {
+            compatible = "onsemi,fusb301";
+            reg = <0x25>;
+            interrupts-extended = <&gpio 85 IRQ_TYPE_LEVEL_LOW>;
+            connector {
+                compatible = "usb-c-connector";
+                power-role = "dual";
+                data-role = "dual";
+                typec-power-opmode = "default";
+                pd-disable;
+            };
+        };
+    };
-- 
