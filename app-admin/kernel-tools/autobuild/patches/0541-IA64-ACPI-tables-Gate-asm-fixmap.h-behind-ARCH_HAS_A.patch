From 8c326ca761310e1064087160d84b37ec4d25d8be Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Sun, 13 Sep 2026 15:15:51 +0200
Subject: [PATCH 541/634] IA64: ACPI: tables: Gate asm/fixmap.h behind
 ARCH_HAS_ACPI_TABLE_UPGRADE

Commit d3436d33341b ("ACPI: tables: Add missing #include
<asm/fixmap.h>") added an unconditional #include <asm/fixmap.h> into
drivers/acpi/tables.

ia64 is an ACPI architecture, but does not have asm/fixmap.h, which
makes the build fail. As asm/fixmap.h is only needed for NR_FIX_BITMAPS,
which is gated behind ARCH_HAS_ACPI_TABLE upgrade - which ia64 does not
have - gate the include as well.

Fixes: d3436d33341b ("ACPI: tables: Add missing #include <asm/fixmap.h>")
Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 drivers/acpi/tables.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/acpi/tables.c b/drivers/acpi/tables.c
index eb93c060426ff..5953f70c31394 100644
--- a/drivers/acpi/tables.c
+++ b/drivers/acpi/tables.c
@@ -22,7 +22,6 @@
 #include <linux/initrd.h>
 #include <linux/security.h>
 #include <linux/kmemleak.h>
-#include <asm/fixmap.h>
 #include "internal.h"
 
 #ifdef CONFIG_ACPI_CUSTOM_DSDT
@@ -382,6 +381,7 @@ static void acpi_table_taint(struct acpi_table_header *table)
 }
 
 #ifdef CONFIG_ACPI_TABLE_UPGRADE
+#include <asm/fixmap.h>	/* for NR_FIX_BTMAPS */
 static u64 acpi_tables_addr;
 static int all_tables_size;
 
