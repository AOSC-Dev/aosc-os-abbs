From 9afab4252f90c53cbab8bc52903a81ffaa91fca4 Mon Sep 17 00:00:00 2001
From: Tomas Glozar <tglozar@gmail.com>
Date: Thu, 3 Sep 2026 22:49:00 +0200
Subject: [PATCH 535/634] IA64: disentangle NUMA <-> !FLATMEM cycle

Commit 34568000f3c9 ("mm/Kconfig: make FLATMEM depend on !NUMA") enabled
a dependency of FLATMEM on !NUMA for all architectures. ia64 has a
pre-existing declaration of the dependency in the inverse order
(NUMA depending on !FLATMEM).

Remove the ia64 dependency and select NUMA by default instead to fix
Kconfig cyclical dependency error.

Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 arch/ia64/Kconfig | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/ia64/Kconfig b/arch/ia64/Kconfig
index 34874e4a02316..6520ebb782899 100644
--- a/arch/ia64/Kconfig
+++ b/arch/ia64/Kconfig
@@ -68,7 +68,6 @@ config IA64
 	select HAVE_ARCH_AUDITSYSCALL
 	select NEED_DMA_MAP_STATE
 	select NEED_SG_DMA_LENGTH
-	select NUMA if !FLATMEM
 	select PCI_MSI_ARCH_FALLBACKS if PCI_MSI
 	select ZONE_DMA32
 	select FUNCTION_ALIGNMENT_32B
@@ -300,7 +299,7 @@ config ARCH_SPARSEMEM_DEFAULT
 
 config NUMA
 	bool "NUMA support"
-	depends on !FLATMEM
+	default y
 	select SMP
 	select USE_PERCPU_NUMA_NODE_ID
 	help
-- 
2.56.0

