From cebbf6a7888d5f13ae071b366464ab8285996494 Mon Sep 17 00:00:00 2001
From: Icenowy Zheng <uwu@icenowy.me>
Date: Mon, 12 Oct 2026 22:51:46 +0800
Subject: [PATCH 365/468] RUYI: drm/spacemit: map shmem GEMs as writecombine

FROM: https://github.com/openRuyi-Project/linux/commit/ec40a7d8a618f139c01655b8345ed4ffb73eff7e

The SpacemiT DPU isn't coherent with the CPU and SHMEM GEM helpers
defaults to cached mapping.

Set map_wc property for mapping GEMs as writecombine.

Signed-off-by: Icenowy Zheng <uwu@icenowy.me>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 drivers/gpu/drm/spacemit/spacemit_drm.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/gpu/drm/spacemit/spacemit_drm.c b/drivers/gpu/drm/spacemit/spacemit_drm.c
index 12b2fe8b6fc99..fc4e6adfa7f01 100644
--- a/drivers/gpu/drm/spacemit/spacemit_drm.c
+++ b/drivers/gpu/drm/spacemit/spacemit_drm.c
@@ -75,6 +75,22 @@ int spacemit_drm_mode_config_init(struct drm_device *drm)
 	return 0;
 }
 
+static struct drm_gem_object *spacemit_create_object(struct drm_device *dev, size_t size)
+{
+	struct drm_gem_shmem_object *obj;
+
+	if (size == 0)
+		return ERR_PTR(-EINVAL);
+
+	obj = kzalloc_obj(*obj);
+	if (!obj)
+		return ERR_PTR(-ENOMEM);
+
+	obj->map_wc = true;
+
+	return &obj->base;
+}
+
 DEFINE_DRM_GEM_FOPS(spacemit_drm_fops);
 
 struct drm_driver spacemit_drm_drv = {
@@ -84,6 +100,8 @@ struct drm_driver spacemit_drm_drv = {
 	DRM_GEM_SHMEM_DRIVER_OPS,
 	DRM_FBDEV_SHMEM_DRIVER_OPS,
 
+	.gem_create_object = spacemit_create_object,
+
 	.name		= DRIVER_NAME,
 	.desc		= DRIVER_DESC,
 	.major		= DRIVER_MAJOR,
-- 
