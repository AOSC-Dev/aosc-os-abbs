PKGNAME=kernel-tools
PKGSEC=utils
PKGDEP="glib ncurses pciutils sysfsutils systemd binutils numactl babeltrace \
        libunwind python-3 libtraceevent"
# FIXME: No support for libunwind.
PKGDEP__NOUNWIND="${PKGDEP/libunwind/}"
PKGDEP__ALPHA="${PKGDEP__NOUNWIND}"
PKGDEP__RISCV64="${PKGDEP__NOUNWIND}"
BUILDDEP="asciidoc xmlto"
PKGDES="Utilities and tools for the Linux Kernel"

PKGPROV="linux-tools libtraceevent cpupower x86-energy-perf-policy usbip tmon \
         cgroup-event-listener turbostat perf"
AB_FLAGS_SPECS=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
