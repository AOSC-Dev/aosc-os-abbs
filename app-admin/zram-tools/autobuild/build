abinfo "Installing zramswap (main executable) ..."
install -Dvm755 "$SRCDIR"/zramswap \
    "$PKGDIR"/usr/bin/zramswap

abinfo "Installing man pages ..."
install -Dvm644 "$SRCDIR"/zramswap.8 \
    "$PKGDIR"/usr/share/man/man8/zramswap.8

abinfo "Installing system service ..."
install -Dvm644 "$SRCDIR"/zramswap.service \
    "$PKGDIR"/usr/lib/systemd/system/zramswap.service

abinfo "Installing zramswap configuration ..."
install -Dvm644 "$SRCDIR"/conf/zramswap \
    "$PKGDIR"/etc/default/zramswap
