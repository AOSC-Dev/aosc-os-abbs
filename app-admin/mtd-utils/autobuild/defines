PKGNAME=mtd-utils
PKGSEC=admin
PKGDEP="lzo util-linux zstd"
PKGDES="Utilities for MTD devices"

AUTOTOOLS_AFTER=(
    '--enable-largefile'
    '--enable-ubihealthd'
    '--with-jffs'
    '--with-ubifs'
    '--with-xattr'
    '--with-lzo'
    '--with-zstd'
    '--without-selinux'
    '--with-crypto'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
