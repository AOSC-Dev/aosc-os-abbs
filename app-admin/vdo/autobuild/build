abinfo "Building vdo userspace tools..."
make V=1 VERBOSE=1 \
	MY_FLAGS="${CFLAGS} ${LDFLAGS}"
	MY_LDFLAGS="${LDFLAGS}"
	EXTRA_FLAGS="${CFLAGS} ${LDFLAGS}"
	EXTRA_LDFLAGS="${LDFLAGS}"

abinfo "Installing vdo userspace tools..."
make install V=1 VERBOSE=1 BUILDROOT="$PKGDIR" \
	 "${MAKE_INSTALL_DEF[@]}" DESTDIR="$PKGDIR"
