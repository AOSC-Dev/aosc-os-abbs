mkdir -pv "$PKGDIR"/usr/lib/systemd/system-preset

abinfo "Writing 70-aosc-os-cosmic.preset ..."
cat > "$PKGDIR"/usr/lib/systemd/system-preset/70-aosc-os-cosmic.preset << EOF
## 70-aosc-os-cosmic.preset
## Systemd unit preset for AOSC OS COSMIC distributions.

# COSMIC-GREETER
enable cosmic-greeter.service
EOF
