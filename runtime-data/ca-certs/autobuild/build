abinfo "Running make-ca ..."
# FIXME: anything affecting the install path of the p11-kit objects
# (-D, -P, and -a) are broken, see
# https://github.com/lfs-book/make-ca/issues/40.  So we cannot rely on them.
make-ca -f -C "$SRCDIR"/certdata.txt          \
        -S "$PKGDIR"/etc/ssl                  \
        -b "$PKGDIR"/etc/pki/tls/certs        \
        -j "$PKGDIR"/etc/pki/tls/java

abinfo "Copying p11-kit objects ..."
cp -rv /etc/pki/anchors{,.md5sums} "$PKGDIR"/etc/pki

abinfo "Creating compatibility symlink for ca-bundle.crt ..."
ln -sv "../../pki/tls/certs/ca-bundle.crt" "$PKGDIR/etc/ssl/certs/ca-certificates.crt"
ln -sv "../pki/tls/certs/ca-bundle.crt" "$PKGDIR/etc/ssl/ca-bundle.crt"
