abinfo "Running make-ca ..."
make-ca -f -C "$SRCDIR"/certdata.txt -D "$PKGDIR"

abinfo "Creating compatibility symlink for ca-bundle.crt ..."
ln -sv "../../pki/tls/certs/ca-bundle.crt" "$PKGDIR/etc/ssl/certs/ca-certificates.crt"
ln -sv "../pki/tls/certs/ca-bundle.crt" "$PKGDIR/etc/ssl/ca-bundle.crt"
