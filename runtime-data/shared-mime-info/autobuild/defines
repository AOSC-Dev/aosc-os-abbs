PKGNAME=shared-mime-info
PKGSEC=misc
PKGDEP="glib libxml2"
BUILDDEP="docbook-xml"
PKGDES="Freedesktop.org shared MIME info"

ABTYPE=meson
MESON_AFTER=(
    '-Dwrap_mode=default'
    '-Dupdate-mimedb=false'
    '-Dbuild-tests=false'
    # Note: Unnecessary and not installed.
    '-Dbuild-spec=false'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
