PKGNAME=mongo-c-driver
PKGSEC=database
PKGDEP="cyrus-sasl libmongocrypt openssl snappy zlib zstd"
# Note: Sphinx to build man pages.
BUILDDEP="sphinx"
PKGDES="MongoDB driver for C"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_TESTING=OFF'
    '-DENABLE_CLIENT_SIDE_ENCRYPTION=ON'
    '-DENABLE_COVERAGE=OFF'
    '-DENABLE_CRYPTO_SYSTEM_PROFILE=OFF'
    '-DENABLE_DEBUG_ASSERTIONS=OFF'
    '-DENABLE_EXAMPLES=OFF'
    '-DENABLE_HTML_DOCS=OFF'
    '-DENABLE_MAINTAINER_FLAGS=OFF'
    '-DENABLE_MAN_PAGES=ON'
    '-DENABLE_MONGOC=ON'
    '-DENABLE_MONGODB_AWS_AUTH=ON'
    '-DENABLE_PIC=ON'
    '-DENABLE_RDTSCP=OFF'
    '-DENABLE_SASL=CYRUS'
    '-DENABLE_SHARED=ON'
    '-DENABLE_SHARED_LIBBSON_INSTALL=ON'
    '-DENABLE_SHM_COUNTERS=ON'
    '-DENABLE_SNAPPY=ON'
    '-DENABLE_SRV=ON'
    '-DENABLE_SSL=OPENSSL'
    '-DENABLE_STATIC=OFF'
    '-DENABLE_STATIC_LIBBSON_INSTALL=OFF'
    '-DENABLE_TESTS=OFF'
    '-DENABLE_TRACING=OFF'
    '-DENABLE_UNINSTALL=OFF'
    '-DENABLE_ZLIB=SYSTEM'
    '-DENABLE_ZSTD=ON'
    '-DMONGO_FUZZ=OFF'
)
CMAKE_AFTER__AMD64=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_RDTSCP=ON'
)
# FIXME: No libmongocrypt.
CMAKE_AFTER__NOCRYPT=(
    "${CMAKE_AFTER[@]}"
    '-DENABLE_CLIENT_SIDE_ENCRYPTION=OFF'
)
CMAKE_AFTER__LOONGARCH64=(
    "${CMAKE_AFTER__NOCRYPT[@]}"
)
CMAKE_AFTER__LOONGARCH64_NOSIMD=(
    "${CMAKE_AFTER__NOCRYPT[@]}"
)
CMAKE_AFTER__LOONGSON3=(
    "${CMAKE_AFTER__NOCRYPT[@]}"
)
