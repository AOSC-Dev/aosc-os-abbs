PKGNAME=libmongocrypt
PKGSEC=database
PKGDEP="glibc"
PKGDES="C library to implement In-Use (client-side) encryption in MongoDB driver for C"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_TESTING=OFF'
    '-DENABLE_AUTOMATIC_INIT_AND_CLEANUP=ON'
    '-DENABLE_BUILD_FOR_PPA=OFF'
    '-DENABLE_MORE_WARNINGS_AS_ERRORS=OFF'
    '-DENABLE_ONLINE_TESTS=OFF'

    # Note: Needed for vendored components.
    '-DFETCHCONTENT_FULLY_DISCONNECTED=OFF'
    '-DFETCHCONTENT_UPDATES_DISCONNECTED=OFF'

    '-DINTEL_DFP_LIBRARY_PATCH_ENABLED=ON'
    '-DLIBBSON_PATCH_ENABLED=ON'
    '-DUSE_SHARED_LIBBSON=ON'

    '-DENABLE_STATIC=OFF'
)
