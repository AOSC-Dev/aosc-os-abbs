# Adapted from:
# https://gitlab.archlinux.org/archlinux/packaging/packages/grml-zsh-config

abinfo "Building man pages for grml-zsh-config"
make -C "$SRCDIR/doc"

abinfo "Installing grml-zsh-config"
install -Dv -m644 "$SRCDIR/etc/skel/.zshrc" "${PKGDIR}/etc/skel/.zshrc"
install -Dv -m644 "$SRCDIR/etc/zsh/keephack" "${PKGDIR}/etc/zsh/keephack"
install -Dv -m644 "$SRCDIR/etc/zsh/zshrc" "${PKGDIR}/etc/zsh/zshrc"
install -Dv -m644 "$SRCDIR/doc/grmlzshrc.5" "${PKGDIR}/usr/share/man/man5/grmlzshrc.5"
