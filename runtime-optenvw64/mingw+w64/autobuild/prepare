# NOTE: mingw+w64 is compiled with gcc+w64, which is not guaranteed to support
# our default set of compiler/linker flags
abinfo "Clearing CFLAGS/CPPFLAGS/CXXFLAGS/LDFLAGS ..."
unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS

abinfo "Setting up CFLAGS ..."
# FIXME: FTBFS with `-Wincompatible-pointer-types`
export CFLAGS+=" -I/opt/w64/include/ -Wno-error=incompatible-pointer-types"

abinfo "Overriding ld ..."
ln -sv /usr/bin/ld.bfd "$SRCDIR"/ld
export PATH="$SRCDIR:$PATH"

abinfo "Setting up w64 subsystem environment ..."
source /etc/profile.d/w64subsystem.sh
