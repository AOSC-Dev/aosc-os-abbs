abinfo "Installing systemd sysusers.d and tmpfiles.d configuration ..."
install -Dvm644 "$SRCDIR"/assets/systemd/sysusers-dms-greeter.conf "$PKGDIR"/usr/lib/sysusers.d/dms-greeter.conf
install -Dvm644 "$SRCDIR"/assets/systemd/tmpfiles-dms-greeter.conf "$PKGDIR"/usr/lib/tmpfiles.d/dms-greeter.conf

abinfo "Installing shell completions ..."
"$PKGDIR"/usr/bin/dms-greeter completion bash > "$SRCDIR"/bash-completions
"$PKGDIR"/usr/bin/dms-greeter completion fish > "$SRCDIR"/fish-completions
"$PKGDIR"/usr/bin/dms-greeter completion zsh > "$SRCDIR"/zsh-completions
install -Dvm644 "$SRCDIR"/bash-completions "$PKGDIR"/usr/share/bash-completion/completions/dms-greeter
install -Dvm644 "$SRCDIR"/fish-completions "$PKGDIR"/usr/share/fish/vendor_completions.d/dms-greeter.fish
install -Dvm644 "$SRCDIR"/zsh-completions "$PKGDIR"/usr/share/zsh/site-functions/_dms-greeter
