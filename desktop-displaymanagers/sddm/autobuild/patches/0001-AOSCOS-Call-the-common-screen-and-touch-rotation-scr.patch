From 96e676d2f5a3f2926827de03ad584ffc1c59d0da Mon Sep 17 00:00:00 2001
From: "CyberNeko.AI" <cyberneko.ai@aosc.io>
Date: Sat, 28 Mar 2026 17:27:58 +0800
Subject: [PATCH] AOSCOS: Call the common screen and touch rotation script
 in Xsetup (X11)

---
 data/scripts/Xsetup | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/data/scripts/Xsetup b/data/scripts/Xsetup
index 8c7c2aa..26304ba 100755
--- a/data/scripts/Xsetup
+++ b/data/scripts/Xsetup
@@ -1,3 +1,7 @@
 #!/bin/sh
 # Xsetup - run as root before the login dialog appears
 
+# AOSC OS: # Call the common screen and touch rotation script
+if [ -x /etc/X11/xinit/xinitrc.d/90-auto-rotate.sh ]; then
+    /etc/X11/xinit/xinitrc.d/90-auto-rotate.sh
+fi
