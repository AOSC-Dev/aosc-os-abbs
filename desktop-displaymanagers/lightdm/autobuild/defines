PKGNAME=lightdm
PKGSEC=x11
PKGDEP="polkit systemd accountsservice xorg-server \
        dm-shared-dbus-config libxklavier"
BUILDDEP="vala itstool gtk-doc intltool qt-5 qt-6 gtk-3 yelp-tools"
PKGDES="A lightweight display manager"

AUTOTOOLS_AFTER="--libexecdir=/usr/lib/lightdm \
                 --with-greeter-user=lightdm \
                 --with-greeter-session=lightdm-gtk-greeter \
                 --disable-static \
                 --disable-tests \
                 --enable-liblightdm-qt5 \
                 --enable-liblightdm-qt6 \
                 --enable-vala"
ABSHADOW=0

BUILD_READY() {
  sed -i 's|-@USE_NLS@|-yes|g' po/Makefile.in.in
}
