From 7f36119d36020d52ee855d2b689bf3600460acce Mon Sep 17 00:00:00 2001
From: Vlad Shakhov <lumpen.intellectual@gmail.com>
Date: Wed, 8 Apr 2026 10:59:52 +0800
Subject: [PATCH 02/12] DEBIAN: Increase the size of buffers for name/password
 to follow the protocol.

Link: https://salsa.debian.org/debian/wdm/-/blob/debian/1.28-27/debian/patches/02_fix_login_overflow.patch
Signed-off-by: Xi Ruoyao <xry111@xry111.site>
---
 src/wdm/Greet.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/wdm/Greet.c b/src/wdm/Greet.c
index 4577b8b..782620f 100644
--- a/src/wdm/Greet.c
+++ b/src/wdm/Greet.c
@@ -134,7 +134,8 @@ extern char *wdmCursorTheme;
 extern int   wdmXineramaHead;
 
 static int      pipe_filedes[2];
-static char	name[128], password[128];
+#define CREDENTIAL_LEN 258
+static char	name[CREDENTIAL_LEN], password[CREDENTIAL_LEN];
 static char     xsessionArg[256], exitArg[256];
 
 struct display *Save_d=NULL;
@@ -280,6 +281,8 @@ static int Greet (struct display *d, struct greet_info *greet)
 {
     int code = 0, done = 0, extension_code=0;
 
+    memset(name, 0, CREDENTIAL_LEN );
+    memset(password, 0, CREDENTIAL_LEN);
     readstring(pipe_filedes[0], name);  /* username */
     readstring(pipe_filedes[0], password);
 
-- 
2.53.0

