PKGNAME=dotnet-sdk-10.0-source-built-artifacts
PKGSEC=devel
PKGDES="Microsoft .NET source-built artifacts (version 10)"
PKGDEP=""
BUILDDEP="dotnet-sdk-10.0-source-built-artifacts dotnet-sdk-10.0 llvm lttng-ust"

# FIXME: could not scrape payload in src/runtime/artifacts/obj/coreclr/linux.x64.Release/
# vm/datadescriptor/CMakeFiles/cdac_contract_descriptor_temp.dir/__/__/debug/datadescriptor-shared/datadescriptor.cpp.o
NOLTO=1
USECLANG=1
# Note: source built artifact itself is a tarball
ABSTRIP=0

# Note: .NET 10 have following Linux architectures defined in runtime ID graph:
#     .NET RID    AOSC
# -----------------------
# (1) arm         armv7hf
#     arm64       arm64
# (2) armel       armv5hf
# (3) armv6       armv6hf
#     loongarch64 loongarch64[_nosimd]
# (2) mips64      loongson3
#     ppc64le     ppc64el
#     riscv64     riscv64
#     s390x       -
#     x64         amd64
# (4) x86         i486
#  (see: https://github.com/dotnet/runtime/blob/f0c7a08c8dea85b0271b5ed128530169b9ad79ff/src/libraries/Microsoft.NETCore.Platforms/src/PortableRuntimeIdentifierGraph.json)
#  
# FIXME: 1: while cross compiling of arm 10.0.100 SDK succeed, 10.0.100 is unable to compile recent (10.0.114) SDK directly
#           either cross compiling 10.0.114 directly or native build SDK between them one by one
# Note:  2: armel and mips64 is not included in System.Runtime.InteropServices.Architecture enum, and there is no microsoft provided cross compiling docker image
# FIXME: 3: when cross compiling, armv6 is unable to determine System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture
#           see: https://github.com/dotnet/runtime/blob/60629d14374c56f1cb51819049ad1fa529307f8d/src/libraries/System.Private.CoreLib/src/System/Runtime/InteropServices/RuntimeInformation.cs#L50
# FIXME: 4: there is no microsoft provided cross compiling docker image, hadn't figured out way to build it natively yet, linux-x86 is never officially supported
FAIL_ARCH="!(amd64|arm64|loongarch64|loongarch64_nosimd|riscv64|ppc64el)"
