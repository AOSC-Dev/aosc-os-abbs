From faaf5286e9affdae8ee6f7b9d858125e9f7fb133 Mon Sep 17 00:00:00 2001
From: am11 <3840695+am11@users.noreply.github.com>
Date: Mon, 23 Nov 2026 12:40:05 +0200
Subject: [PATCH] Don't resolve an apphost for excluded Helix projects in
 source-build

Helix is excluded from source-only builds, but the excluded projects are still
restored. Restoring an executable such as the Helix JobMonitor tool infers
UseAppHost and resolves an apphost for the target RID, which source-build may not
have (NETSDK1084 on linux-riscv64).

Fixes #11013
---
 src/arcade/src/Microsoft.DotNet.Helix/Directory.Build.props | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/arcade/src/Microsoft.DotNet.Helix/Directory.Build.props b/src/arcade/src/Microsoft.DotNet.Helix/Directory.Build.props
index 5d8e3146615c..8a8c61d3b63d 100644
--- a/src/arcade/src/Microsoft.DotNet.Helix/Directory.Build.props
+++ b/src/arcade/src/Microsoft.DotNet.Helix/Directory.Build.props
@@ -5,6 +5,9 @@
   <!-- Exclude Helix from source-build until we find a reason to use it. -->
   <PropertyGroup>
     <ExcludeFromSourceOnlyBuild>true</ExcludeFromSourceOnlyBuild>
+    <!-- Excluded projects are still restored, which resolves an apphost for executables such as the
+         JobMonitor tool; source-build may have none for the target RID (e.g. linux-riscv64). -->
+    <UseAppHost Condition="'$(DotNetBuildSourceOnly)' == 'true'">false</UseAppHost>
   </PropertyGroup>
 
 </Project>
