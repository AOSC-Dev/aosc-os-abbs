From a06061661986e5faf8acff13dc36e6ebf2a92c91 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Sat, 7 Nov 2026 17:44:03 +0800
Subject: [PATCH 2/2] AOSCOS: Patch rust-lang/libc for loongson3

Patch source: https://github.com/rust-lang/libc/pull/5651
---
 Cargo.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Cargo.toml b/Cargo.toml
index b7339be463..dcaa182f15 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -317,6 +317,7 @@ node-semver = { git = "https://github.com/pnpm/node-semver-rs", rev = "3d74d6b7f
 # Adds the `nightly` feature. Drop once an upstream release carries it.
 # See <https://github.com/pnpm/pnpm/pull/16951>.
 dashmap = { git = "https://github.com/pnpm/dashmap", rev = "4401b5c0b2626266dd5d5a9202677bca8b53e57a" }
+libc = { path = "vendor/libc" }
 
 [workspace.metadata.workspaces]
 allow_branch = "main"
-- 
2.56.0

