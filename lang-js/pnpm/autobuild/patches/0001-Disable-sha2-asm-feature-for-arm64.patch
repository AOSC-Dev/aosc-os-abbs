From 281744728ee2c3b9fa07a5f703f3eaafb3854903 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Tue, 29 Sep 2026 22:10:54 +0800
Subject: [PATCH 1/2] AOSCOS: Disable sha2 asm feature for arm64

sha2's asm feature needs `-march=armv8-a+crypto`, but we are targeting `-march=armv8-a`
---
 pnpm/crates/crypto-hash/Cargo.toml | 2 +-
 pnpm/crates/store-dir/Cargo.toml   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/pnpm/crates/crypto-hash/Cargo.toml b/pnpm/crates/crypto-hash/Cargo.toml
index 65503d52cc..c6c2c0b015 100644
--- a/pnpm/crates/crypto-hash/Cargo.toml
+++ b/pnpm/crates/crypto-hash/Cargo.toml
@@ -18,7 +18,7 @@ ssri = { workspace = true }
 # Match pnpm-store-dir's Windows-aware feature gate so this crate
 # inherits the `asm` backend on every target where it compiles.
 [target.'cfg(not(windows))'.dependencies]
-sha2 = { workspace = true, features = ["asm"] }
+sha2 = { workspace = true }
 
 [dev-dependencies]
 tempfile = { workspace = true }
diff --git a/pnpm/crates/store-dir/Cargo.toml b/pnpm/crates/store-dir/Cargo.toml
index 43082d5d54..b752d97303 100644
--- a/pnpm/crates/store-dir/Cargo.toml
+++ b/pnpm/crates/store-dir/Cargo.toml
@@ -44,7 +44,7 @@ url = { workspace = true }
 # files (`LNK1181: cannot open input file ...sha512_x64.o`), and the
 # MinGW build under MSYS2 fails too.
 [target.'cfg(not(windows))'.dependencies]
-sha2 = { workspace = true, features = ["asm"] }
+sha2 = { workspace = true }
 
 [target.'cfg(windows)'.dependencies]
 windows-sys = { workspace = true, features = ["Win32_Storage_FileSystem"] }
-- 
