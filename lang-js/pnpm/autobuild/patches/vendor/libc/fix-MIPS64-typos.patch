From bf89a0a1e35b4d0dfe6c0f180d12bb7d83d20774 Mon Sep 17 00:00:00 2001
From: Henry Chen <chenx97@aosc.io>
Date: Tue, 20 Oct 2026 18:33:50 +0800
Subject: [PATCH] linux, glibc: fix typos that rule out mips64{,r6} by accident

---
 src/new/glibc/sysdeps/nptl/mod.rs          |  4 ++--
 src/new/glibc/sysdeps/unix/linux/mod.rs    | 12 ++++++------
 src/new/linux_uapi/arch/mips/asm/socket.rs | 14 +++++++-------
 src/new/linux_uapi/asm/mod.rs              |  4 ++--
 4 files changed, 17 insertions(+), 17 deletions(-)

diff --git a/src/new/glibc/sysdeps/nptl/mod.rs b/src/new/glibc/sysdeps/nptl/mod.rs
index 6ea74cd9412e..f41891a86d00 100644
--- a/src/new/glibc/sysdeps/nptl/mod.rs
+++ b/src/new/glibc/sysdeps/nptl/mod.rs
@@ -8,9 +8,9 @@ pub(crate) mod bits {
     #[cfg_attr(
         any(
             target_arch = "mips",
+            target_arch = "mips64",
             target_arch = "mips32r6",
-            target_arch = "mips",
-            target_arch = "mips32r6",
+            target_arch = "mips64r6",
         ),
         path = "../../mips/nptl/bits/struct_mutex.rs"
     )]
diff --git a/src/new/glibc/sysdeps/unix/linux/mod.rs b/src/new/glibc/sysdeps/unix/linux/mod.rs
index 3d8a449a812a..927688161f73 100644
--- a/src/new/glibc/sysdeps/unix/linux/mod.rs
+++ b/src/new/glibc/sysdeps/unix/linux/mod.rs
@@ -7,9 +7,9 @@ pub(crate) mod bits {
     #[cfg_attr(
         any(
             target_arch = "mips",
+            target_arch = "mips64",
             target_arch = "mips32r6",
-            target_arch = "mips",
-            target_arch = "mips32r6",
+            target_arch = "mips64r6",
         ),
         path = "../mips/bits/sigaction.rs"
     )]
@@ -23,9 +23,9 @@ pub(crate) mod bits {
     #[cfg_attr(
         any(
             target_arch = "mips",
+            target_arch = "mips64",
             target_arch = "mips32r6",
-            target_arch = "mips",
-            target_arch = "mips32r6",
+            target_arch = "mips64r6",
         ),
         path = "../mips/bits/signum_arch.rs"
     )]
@@ -38,9 +38,9 @@ pub(crate) mod bits {
     #[cfg_attr(
         any(
             target_arch = "mips",
+            target_arch = "mips64",
             target_arch = "mips32r6",
-            target_arch = "mips",
-            target_arch = "mips32r6",
+            target_arch = "mips64r6",
         ),
         path = "../mips/bits/socket_type.rs"
     )]
diff --git a/src/new/linux_uapi/arch/mips/asm/socket.rs b/src/new/linux_uapi/arch/mips/asm/socket.rs
index 298c77058475..8d4ab07e96ec 100644
--- a/src/new/linux_uapi/arch/mips/asm/socket.rs
+++ b/src/new/linux_uapi/arch/mips/asm/socket.rs
@@ -103,13 +103,6 @@ const SO_TIMESTAMP_OLD: c_int = 29;
 const SO_TIMESTAMPNS_OLD: c_int = 35;
 const SO_TIMESTAMPING_OLD: c_int = 37;
 
-const SO_TIMESTAMP_NEW: c_int = 63;
-const SO_TIMESTAMPNS_NEW: c_int = 64;
-const SO_TIMESTAMPING_NEW: c_int = 65;
-
-const SO_RCVTIMEO_NEW: c_int = 66;
-const SO_SNDTIMEO_NEW: c_int = 67;
-
 pub const SO_DETACH_REUSEPORT_BPF: c_int = 68;
 
 pub const SO_PREFER_BUSY_POLL: c_int = 69;
@@ -146,6 +139,13 @@ cfg_if! {
         #[allow(deprecated)]
         const TIME_T_LONG: bool = size_of::<crate::time_t>() == size_of::<c_long>();
 
+        const SO_TIMESTAMP_NEW: c_int = 63;
+        const SO_TIMESTAMPNS_NEW: c_int = 64;
+        const SO_TIMESTAMPING_NEW: c_int = 65;
+
+        const SO_RCVTIMEO_NEW: c_int = 66;
+        const SO_SNDTIMEO_NEW: c_int = 67;
+
         pub const SO_TIMESTAMP: c_int = if TIME_T_LONG {
             SO_TIMESTAMP_OLD
         } else {
diff --git a/src/new/linux_uapi/asm/mod.rs b/src/new/linux_uapi/asm/mod.rs
index 720e923c7739..f4e071a19680 100644
--- a/src/new/linux_uapi/asm/mod.rs
+++ b/src/new/linux_uapi/asm/mod.rs
@@ -4,9 +4,9 @@
 #[cfg_attr(
     any(
         target_arch = "mips",
+        target_arch = "mips64",
         target_arch = "mips32r6",
-        target_arch = "mips",
-        target_arch = "mips32r6",
+        target_arch = "mips64r6",
     ),
     path = "../arch/mips/asm/socket.rs"
 )]
