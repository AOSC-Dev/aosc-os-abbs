From d7f0d5df5f74bcdef2e9dd6fda9d8813ef38adb7 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Tue, 29 Sep 2026 22:14:03 +0800
Subject: [PATCH 1/2] Remove pnpm-managed cargo sources

We cannot use pnpm to install them because we are building pnpm.
---
 .cargo/config.toml | 15 ---------------
 1 file changed, 15 deletions(-)

diff --git a/.cargo/config.toml b/.cargo/config.toml
index 2de57970a1..f962963a1d 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -10,18 +10,3 @@ rustflags = ["-C", "link-arg=-B.github/scripts/rust-lld"]
 [target.wasm32-wasip1-threads]
 rustflags = ["--cfg", "tokio_unstable"]
 
-# >>> pnpm-managed cargo sources >>>
-[source.crates-io]
-replace-with = "pnpm-crates-io"
-
-[source.pnpm-crates-io]
-directory = ".pnpm/crates/crates-io"
-
-[source.pnpm-git]
-directory = ".pnpm/crates/git"
-
-[source."git+https://github.com/pnpm/node-semver-rs?rev=3d74d6b7f4de1de2006cf2f7663aac09de65b1f6"]
-git = "https://github.com/pnpm/node-semver-rs"
-rev = "3d74d6b7f4de1de2006cf2f7663aac09de65b1f6"
-replace-with = "pnpm-git"
-# <<< pnpm-managed cargo sources <<<
-- 
2.56.0

