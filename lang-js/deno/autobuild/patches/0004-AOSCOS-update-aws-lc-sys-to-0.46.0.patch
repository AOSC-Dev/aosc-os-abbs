From 4921df4377251a700677bb131df86b49d5fb465b Mon Sep 17 00:00:00 2001
From: CAB233 <yidaduizuoye@outlook.com>
Date: Thu, 22 Oct 2026 13:26:38 +0800
Subject: [PATCH 4/4] AOSCOS: update aws-lc-sys to 0.46.0

To fix LTO build with aws-lc-rs 1.18.2.
---
 Cargo.lock | 18 +++---------------
 Cargo.toml |  2 +-
 2 files changed, 4 insertions(+), 16 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index d38a13455b..870268107b 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -442,23 +442,11 @@ version = "1.18.2"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "faac5829c2b74c28f830747e7818ccfb684261b5f48a1118b1e2a13d36dfab13"
 dependencies = [
- "aws-lc-sys 0.46.0",
+ "aws-lc-sys",
  "untrusted 0.7.1",
  "zeroize",
 ]
 
-[[package]]
-name = "aws-lc-sys"
-version = "0.40.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "f50037ee5e1e41e7b8f9d161680a725bd1626cb6f8c7e901f91f942850852fe7"
-dependencies = [
- "cc",
- "cmake",
- "dunce",
- "fs_extra",
-]
-
 [[package]]
 name = "aws-lc-sys"
 version = "0.46.0"
@@ -2383,7 +2371,7 @@ dependencies = [
 name = "deno_crypto_provider"
 version = "0.54.0"
 dependencies = [
- "aws-lc-sys 0.40.0",
+ "aws-lc-sys",
  "ed448-goldilocks",
 ]
 
@@ -2937,7 +2925,7 @@ dependencies = [
  "aead-gcm-stream",
  "aes",
  "aws-lc-rs",
- "aws-lc-sys 0.40.0",
+ "aws-lc-sys",
  "base64 0.22.1",
  "blake2 0.10.6",
  "cbc",
diff --git a/Cargo.toml b/Cargo.toml
index d41f9e6e25..2b80d8e892 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -193,7 +193,7 @@ async-once-cell = "0.5.4"
 async-stream = "0.3"
 async-trait = "0.1.73"
 aws-lc-rs = { version = "1.18.2" }
-aws-lc-sys = { version = "0.40.0", features = ["prebuilt-nasm"] }
+aws-lc-sys = { version = "0.46.0", features = ["prebuilt-nasm"] }
 backhand = { version = "0.25.1", default-features = false, features = ["zstd"] }
 base32 = "=0.5.1"
 base64 = "0.22.1"
-- 
2.56.0

