From: CAB233 <yidaduizuoye@outlook.com>
Date: Fri, 23 Oct 2026 11:52:05 +0800
Subject: [PATCH] AOSCOS: point upgrade at oma
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This commit is authored with assistance from AI/LLM:

- Model: GPT-5.6 sol
- Platform: ChatGPT Web
- Agent platform: none
- Prompt:
  移除 nub 的 upgrade 功能
---
 crates/nub-cli/src/cli.rs | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/crates/nub-cli/src/cli.rs b/crates/nub-cli/src/cli.rs
index 8b0728ab..386029fc 100644
--- a/crates/nub-cli/src/cli.rs
+++ b/crates/nub-cli/src/cli.rs
@@ -3356,13 +3356,11 @@ fn dispatch_subcommand(rest: Vec<String>) -> Result<i32> {
             force,
             args,
         }),
-        Some(Command::Upgrade {
-            version,
-            canary,
-            stable,
-            dry_run,
-            yes,
-        }) => run_upgrade(version.as_deref(), canary, stable, dry_run, yes),
+        Some(Command::Upgrade { .. }) => {
+            anyhow::bail!(
+                "Nub is managed by oma. Please update it with `oma upgrade nub`."
+            )
+        },
         Some(Command::Help { command }) => {
             // `nub help <cmd>` routes to that command's help; `nub help` alone →
             // the curated top-level page. Same router as `nub <cmd> -h`.
-- 
