# See: npm/build-local.sh

abinfo "Building nub-native.node ..."
pushd "$SRCDIR"/crates/nub-native
cargo build --release --locked --package nub-native
popd

abinfo "Installing nub-native.node ..."
install -Dvm755 "$SRCDIR"/target/release/libnub_native.so \
    "$SRCDIR"/runtime/addons/nub-native.node
rm -v "$SRCDIR"/target/release/libnub_native.so

abinfo "Installing runtime dependencies ..."
# FIXME: `--node-linker hoisted` was added so that `jsbi` would appear in node_modules,
# but `nub ci` does not support this parameter.
nub install --frozen-lockfile --node-linker hoisted
mkdir -pv "$SRCDIR"/runtime/node_modules/{@oxc-project,@js-temporal,@petamoriken}
cp -RLv "$SRCDIR"/node_modules/@oxc-project/runtime "$SRCDIR"/runtime/node_modules/@oxc-project/
cp -RLv "$SRCDIR"/node_modules/urlpattern-polyfill "$SRCDIR"/runtime/node_modules/
cp -RLv "$SRCDIR"/node_modules/@js-temporal/polyfill "$SRCDIR"/runtime/node_modules/@js-temporal/
cp -RLv "$SRCDIR"/node_modules/jsbi "$SRCDIR"/runtime/node_modules/
cp -RLv "$SRCDIR"/node_modules/@petamoriken/float16 "$SRCDIR"/runtime/node_modules/@petamoriken/
