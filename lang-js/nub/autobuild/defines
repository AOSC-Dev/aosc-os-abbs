PKGNAME=nub
PKGSEC=devel
PKGDEP="gcc-runtime glibc"
BUILDDEP="rustc llvm nub"
PKGDES="All-in-one Node.js toolkit"

ABTYPE=rust
USECLANG=1
CARGO_AFTER=(
    '-p' 'nub-cli'
    '--features' 'embed-runtime,compile'
)

# FIXME: Check cargo.lock. Re-enable LTO when aws-lc-rs >= 1.18.1
# and aws-lc-sys >= 0.45.0.
# 
# Ref: https://github.com/aws/aws-lc-rs/issues/1211
NOLTO=1
