PKGNAME=bun
PKGSEC=devel
PKGDEP="glibc icu"
# Note: llvm-21 is not substitutable.  scripts/build/tools.ts pins the accepted
# range to LLVM 21.1.x, and upstream warns that a mismatched LLVM causes
# allocator failures at runtime (CONTRIBUTING.md).
# Note: ruby runs JavaScriptCore's code generators and offlineasm, the same
# reason runtime-web/webkit2gtk lists it; unzip unpacks the bootstrap binary
# declared in spec.
BUILDDEP="llvm-21 ruby unzip"
# Note: libjpeg-turbo's x86_64 SIMD kernels are NASM syntax, and
# scripts/build/compile.ts asserts on the assembler at the use site rather
# than at toolchain resolution, so this is a hard requirement on x86_64
# only.
BUILDDEP__AMD64="${BUILDDEP} nasm"
PKGDES="Fast all-in-one JavaScript runtime, bundler, test runner, and package manager"

ABTYPE=self
# Note: Bun's build system computes its own compiler flags and invokes clang
# directly.  USECLANG only matters here so that autobuild4 exports the
# unversioned `clang'/`clang++' names, which autobuild/prepare then resolves to
# LLVM 21 through $PATH.
USECLANG=1

# Note: Upstream supports x86_64 and aarch64;
# patches/0001-build-add-a-loongarch64-target.patch (a no-op on the released
# architectures) carries the LoongArch port.  What the LoongArch ports lack,
# by design rather than by omission:
#   - JavaScriptCore has no LoongArch MacroAssembler backend, so JSC runs the
#     CLoop interpreter: WebAssembly is unavailable and JS execution is
#     markedly slower (Source/cmake/WebKitFeatures.cmake).  Loongson has an
#     out-of-tree JIT port (loongson/WebKit, branch main-ls) that would lift
#     this, but it needs a substantial rebase.
#   - TinyCC has no LoongArch code generator, so bun:ffi cc() degrades to the
#     dlopen-only path, exactly as upstream already does on Android.
FAIL_ARCH="!(amd64|arm64|loongarch64|loongarch64_nosimd)"
