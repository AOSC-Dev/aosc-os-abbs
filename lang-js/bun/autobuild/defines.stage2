PKGNAME=bun
PKGSEC=devel
PKGDEP="glibc"
# NOTE: Use nodejs to install `bun` binary
BUILDDEP="zig rustc llvm nodejs-22"
PKGDES="A JavaScript runtime, bundler, test runner, and package manager"

ABTYPE=cmakeninja

CMAKE_AFTER=(
    '-DWEBKIT_LOCAL=ON'
    '-DWEBKIT_PATH=WebKit'
    '-DENABLE_LTO=ON'
)

USECLANG=1
