From: liushuyu <liushuyu011@gmail.com>
Date: Tue, 18 Mar 2025 12:11:04 +0800
Subject: [PATCH 1/2] Source/cmake/OptionsJSCOnly.cmake: remove forced unit
 tests

---
 Source/cmake/OptionsJSCOnly.cmake | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/Source/cmake/OptionsJSCOnly.cmake b/Source/cmake/OptionsJSCOnly.cmake
index 2dd215b2ea0d..07e984592569 100644
--- a/Source/cmake/OptionsJSCOnly.cmake
+++ b/Source/cmake/OptionsJSCOnly.cmake
@@ -101,12 +101,6 @@ else ()
 endif ()
 WEBKIT_OPTION_END()
 
-if (WIN32)
-    set(ENABLE_API_TESTS OFF)
-else ()
-    set(ENABLE_API_TESTS ON)
-endif ()
-
 if (WTF_CPU_ARM OR WTF_CPU_MIPS)
     SET_AND_EXPOSE_TO_BUILD(USE_CAPSTONE TRUE)
 endif ()
