From 649cc12a9aba3a013742a3f2bafba5216ae9912e Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Tue, 18 Mar 2025 12:11:34 +0800
Subject: [PATCH 2/2] Source/WTF/wtf/bun/RunLoopBun.cpp: make the file more GCC
 compliant

---
 Source/WTF/wtf/bun/RunLoopBun.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Source/WTF/wtf/bun/RunLoopBun.cpp b/Source/WTF/wtf/bun/RunLoopBun.cpp
index 02817dbb4b37..996fa6c5b584 100644
--- a/Source/WTF/wtf/bun/RunLoopBun.cpp
+++ b/Source/WTF/wtf/bun/RunLoopBun.cpp
@@ -7,11 +7,11 @@
 
 // Ensure we cleaned up the mess in RunLoopGeneric.cpp
 #if defined(RunLoop)
-#error RunLoop was not undef'd
+#error RunLoop was not undef`d
 #elif defined(m_runLoop)
-#error m_runLoop was not undef'd
+#error m_runLoop was not undef`d
 #elif defined(m_scheduledTask)
-#error m_scheduledTask was not undef'd
+#error m_scheduledTask was not undef`d
 #endif
 
 namespace WTF {
@@ -201,6 +201,7 @@ void RunLoop::wakeUp()
     case Kind::Bun:
         // Do nothing. This means that JSRunLoopTimer::Manager::PerVMData's RunLoop::Timer leaks instead
         // of being freed.
+        ;
     }
 }
 
-- 
2.49.0

