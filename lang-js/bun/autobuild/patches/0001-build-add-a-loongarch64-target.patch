--- a/patches/boringssl/loongarch-target.patch	1970-01-01 08:00:00.000000000 +0800
+++ b/patches/boringssl/loongarch-target.patch	2026-08-28 19:53:53.437160093 +0800
@@ -0,0 +1,19 @@
+BoringSSL's target.h enumerates supported CPUs and errors out otherwise; its
+own comment says out-of-list platforms "must be able to carry local patches.
+In which case patching this list is trivial."  So: loongarch64 is a standard
+64-bit little-endian two's-complement machine, and with no OPENSSL_<ARCH>
+asm macro defined every hand-written kernel self-guards to empty, leaving
+the plain C implementations.
+
+--- a/include/openssl/target.h
++++ b/include/openssl/target.h
+@@ -43,6 +43,9 @@
+ #elif defined(__riscv) && __SIZEOF_POINTER__ == 8
+ #define OPENSSL_64_BIT
+ #define OPENSSL_RISCV64
++#elif defined(__loongarch__) && __SIZEOF_POINTER__ == 8
++#define OPENSSL_64_BIT
++#define OPENSSL_LOONGARCH64
+ #elif defined(__riscv) && __SIZEOF_POINTER__ == 4
+ #define OPENSSL_32_BIT
+ #elif defined(__pnacl__)
--- a/patches/mimalloc/mi-atomic-pause-fallback.patch	1970-01-01 08:00:00.000000000 +0800
+++ b/patches/mimalloc/mi-atomic-pause-fallback.patch	2026-08-28 19:45:51.434258973 +0800
@@ -0,0 +1,18 @@
+mi_atomic_pause()'s final fallback spells the literal identifiers
+mi_atomic_thread_fence/mi_memory_order_seq_cst, which only exist in the
+MSVC-C branch of this header; in C++ mode they must be composed through the
+mi_atomic()/mi_memory_order() macros.  Never compiled before: x86, arm and
+aarch64 all take the inline-asm arms above, so loongarch64 is the first
+architecture to reach the fallback.
+
+--- a/include/mimalloc/atomic.h
++++ b/include/mimalloc/atomic.h
+@@ -411,7 +411,7 @@
+ }
+ #else
+ static inline void mi_atomic_pause(void) {
+-  mi_atomic_thread_fence(mi_memory_order_seq_cst);
++  mi_atomic(thread_fence)(mi_memory_order(seq_cst));
+ }
+ #endif
+ 
