# The `release-local' profile is Release plus a locally built JavaScriptCore
# (scripts/build/profiles.ts).  Upstream's release builds enable LTO; leave it
# off until the build is known to fit the buildbots.
#
# --canary=off: config.ts defaults `canary' to true, which would stamp the
# binary as `1.4.0-canary.1'.  This is a release.
#
# Note: `baseline' is left at its x86_64 default of true.  It targets Nehalem
# (flags.ts), so the package runs on any x86-64 instead of requiring AVX2,
# matching the -march=x86-64 the buildkit compiles everything else with.
#
# Note: short flags reach ninja verbatim (scripts/build.ts), which is how
# ABTHREADS controls parallelism here.
#
# Note: Bun's build system computes its own compiler flags and ignores $CFLAGS,
# so autobuild4's hardening never reaches it, and the binary is deliberately
# non-PIE -- deps/webkit.ts passes -DCMAKE_POSITION_INDEPENDENT_CODE=OFF along
# with -fno-pic/-no-pie so JSC's const-pointer tables land in .rodata, and bun
# links -no-pie to match.
# The SIMD-less LoongArch port carries its own flag set (see the nosimd knob
# in patches/0001).
_arch_flags=()
if ab_match_arch loongarch64_nosimd; then
    _arch_flags+=(--nosimd=on)
fi

abinfo "Building Bun ..."
bun scripts/build.ts \
    --profile=release-local \
    --canary=off \
    "${_arch_flags[@]}" \
    --build-dir="$SRCDIR"/abbuild \
    -j"$ABTHREADS"

# Plain release builds emit both `bun-profile' (unstripped) and a stripped
# `bun' (config.ts: bunExeName/shouldStrip).  Install the unstripped one and
# let autobuild4 split the debug symbols; the local JavaScriptCore is built
# RelWithDebInfo for the same reason.
abinfo "Installing Bun ..."
install -Dvm755 "$SRCDIR"/abbuild/bun-profile "$PKGDIR"/usr/bin/bun
# Note: upstream's installer exposes the package runner under this name.
ln -sv bun "$PKGDIR"/usr/bin/bunx

abinfo "Installing shell completions ..."
install -Dvm644 "$SRCDIR"/completions/bun.bash \
    "$PKGDIR"/usr/share/bash-completion/completions/bun
install -Dvm644 "$SRCDIR"/completions/bun.fish \
    "$PKGDIR"/usr/share/fish/vendor_completions.d/bun.fish
install -Dvm644 "$SRCDIR"/completions/bun.zsh \
    "$PKGDIR"/usr/share/zsh/site-functions/_bun
