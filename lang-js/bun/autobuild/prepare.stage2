pushd "$SRCDIR"/../WebKit

abinfo "Patching WebKit ..."
ab_apply_patches "$SRCDIR"/autobuild/patches/*.deferred

abinfo "Building upstream patched WebKit ..."
mkdir "$SRCDIR"/../WebKit/build
pushd "$SRCDIR"/../WebKit/build
cmake .. "${CMAKE_DEF[@]}" -GNinja \
    -DCMAKE_INSTALL_PREFIX=/ \
    -DPORT="JSCOnly" \
    -DENABLE_STATIC_JSC=ON \
    -DENABLE_BUN_SKIP_FAILING_ASSERTIONS=ON \
    -DUSE_THIN_ARCHIVES=OFF \
    -DUSE_BUN_JSC_ADDITIONS=ON \
    -DUSE_BUN_EVENT_LOOP=ON \
    -DENABLE_FTL_JIT=ON \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DALLOW_LINE_AND_COLUMN_NUMBER_IN_BUILTINS=ON \
    -DENABLE_REMOTE_INSPECTOR=ON \
    -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=lld" \
    -DENABLE_API_TESTS=OFF

cmake --build .
popd

# Note: adapted from upstream's building Dockerfile
# Ref:
# https://github.com/oven-sh/WebKit/blob/main/Dockerfile#L216-L228
abinfo "Installing WebKit ..."
mkdir -pv "$SRCDIR"/WebKit/lib \
    "$SRCDIR"/WebKit/include \
    "$SRCDIR"/WebKit/include/JavaScriptCore \
    "$SRCDIR"/WebKit/include/glibc \
    "$SRCDIR"/WebKit/include/wtf \
    "$SRCDIR"/WebKit/include/bmalloc \
    "$SRCDIR"/WebKit/include/unicode \
    "$SRCDIR"/WebKit/Source/JavaScriptCore

cp -rv "$SRCDIR"/../WebKit/build/lib/*.a "$SRCDIR"/WebKit/lib
cp -v "$SRCDIR"/../WebKit/build/*.h "$SRCDIR"/WebKit/include
cp -rv "$SRCDIR"/../WebKit/build/bin "$SRCDIR"/WebKit/bin
cp -v "$SRCDIR"/../WebKit/build/*.json "$SRCDIR"/WebKit
find "$SRCDIR"/../WebKit/build/JavaScriptCore/DerivedSources/ \
    -name "*.h" \
    -exec sh -c 'cp -v "$1" "$SRCDIR/WebKit/include/JavaScriptCore/$(basename "$1")"' sh {} \;
find "$SRCDIR"/../WebKit/build/JavaScriptCore/DerivedSources/ \
    -name "*.json" \
    -exec sh -c 'cp -v "$1" "$SRCDIR/WebKit/$(basename "$1")"' sh {} \;
find "$SRCDIR"/../WebKit/build/JavaScriptCore/Headers/JavaScriptCore/ \
    -name "*.h" \
    -exec cp -v {} "$SRCDIR"/WebKit/include/JavaScriptCore/ \;
find "$SRCDIR"/../WebKit/build/JavaScriptCore/PrivateHeaders/JavaScriptCore/ \
    -name "*.h" \
    -exec cp -v {} "$SRCDIR"/WebKit/include/JavaScriptCore/ \;
cp -rv "$SRCDIR"/../WebKit/build/WTF/Headers/wtf/ "$SRCDIR"/WebKit/include
cp -rv "$SRCDIR"/../WebKit/build/bmalloc/Headers/bmalloc/ "$SRCDIR"/WebKit/include
cp -rv "$SRCDIR"/../WebKit/Source/JavaScriptCore/Scripts "$SRCDIR"/WebKit/Source/JavaScriptCore
cp -v "$SRCDIR"/../WebKit/Source/JavaScriptCore/create_hash_table "$SRCDIR"/WebKit/Source/JavaScriptCore

popd

# NOTE: bootstrap with an older version of Bun
abinfo "Installing Bun binary ..."
npm install -g bun
mkdir -pv "$HOME"/.bun/bin/
cp -rv /usr/lib/node-22/lib/node_modules/bun/bin/bun.exe \
    "$HOME"/.bun/bin/bun
