VER=1.4.0
# Note: bumping VER also requires updating GIT_SHA in autobuild/prepare --
# the build fails to const-evaluate without a real commit hash.

# Note: Bun links its own fork of JavaScriptCore, pinned to an exact commit.
# This must match WEBKIT_VERSION in scripts/build/deps/webkit.ts of the same
# Bun tag; the fork tags its release builds as `autobuild-<commit>'.
# Ref: https://github.com/oven-sh/bun/blob/bun-v1.4.0/scripts/build/deps/webkit.ts#L6
# FIXME: The WebKit source ships as a repacked tarball (git archive of the tag
# minus the test suites and website data -- 228 MB instead of a 12 GiB
# repository).  GitHub refuses to generate archives for a repository this
# large (HTTP 422), and the blobless-clone route made buildit's LoongArch
# builders fail the promisor blob fetch with HTTP 408 on every attempt.
# Interim-hosted on a GitHub release; move to repo.aosc.io/aosc-repacks
# together with the bootstrap below before merging.
WEBKIT_VER=0f966e81b78c84bb23213e391bc679c4ef83e56b

SRCS_COMMON="git::commit=tags/bun-v$VER;rename=bun::https://github.com/oven-sh/bun.git \
             tbl::https://github.com/vahiru/aosc-os-abbs/releases/download/bun-bootstrap-v$VER/WebKit-jsconly-autobuild-0f966e81.tar.xz"
CHKSUMS_COMMON="SKIP \
                sha256::033e69572b989254512251c1c3d3013785ab289722f5f655571a8b3dae18861e"

# FIXME: Building Bun requires a working Bun.  scripts/build.ts drives
# configure, code generation and source bundling, and upstream documents no
# path that avoids it (CONTRIBUTING.md).  Upstream publishes release binaries
# for x86_64 and aarch64 only, hence one bootstrap per architecture.  The x64
# bootstrap is the `baseline' build so that it also runs on buildbots without
# AVX2.  The loongarch64 bootstrap is self-produced: cross-compiled from this
# very recipe's patches against the AOSC OS loongarch64 buildkit sysroot, as
# the nosimd variant so one binary serves both LoongArch ports (it only drives
# code generation; performance is irrelevant).
# FIXME: The loongarch64 bootstrap is interim-hosted on a GitHub release;
# move it to https://repo.aosc.io/aosc-repacks/ before merging.
SRCS__AMD64="$SRCS_COMMON \
             file::rename=bun-bootstrap.zip::https://github.com/oven-sh/bun/releases/download/bun-v$VER/bun-linux-x64-baseline.zip"
CHKSUMS__AMD64="$CHKSUMS_COMMON \
                sha256::184fb4595f0d401a217cf7c78c1bc430ba83314dab7a8b94805babbf7fa7097f"

SRCS__ARM64="$SRCS_COMMON \
             file::rename=bun-bootstrap.zip::https://github.com/oven-sh/bun/releases/download/bun-v$VER/bun-linux-aarch64.zip"
CHKSUMS__ARM64="$CHKSUMS_COMMON \
                sha256::4b1a332ee861983eb93bcfe6f770fff94e3e31b2c388bdaea3c8ed35e58eed0e"

# Note: the asset name carries the content hash -- acbs caches downloads by
# URL, so replacing a file in place would leave builders serving stale copies.
LOONG_BOOTSTRAP="file::rename=bun-bootstrap.zip::https://github.com/vahiru/aosc-os-abbs/releases/download/bun-bootstrap-v$VER/bun-linux-loong64-b79ee6d7.zip"
LOONG_BOOTSTRAP_SHA="sha256::b79ee6d7411f6cde4893f675c10b226bec4a9049a30a6ce237a8c55fbaa01026"
SRCS__LOONGARCH64="$SRCS_COMMON $LOONG_BOOTSTRAP"
CHKSUMS__LOONGARCH64="$CHKSUMS_COMMON $LOONG_BOOTSTRAP_SHA"
SRCS__LOONGARCH64_NOSIMD="$SRCS_COMMON $LOONG_BOOTSTRAP"
CHKSUMS__LOONGARCH64_NOSIMD="$CHKSUMS_COMMON $LOONG_BOOTSTRAP_SHA"

SUBDIR="bun"
CHKUPDATE="anitya::id=372727"

# Note: The build compiles all of JavaScriptCore, some twenty vendored C/C++
# libraries and a large Rust workspace, so the envelope matches WebKitGTK's.
ENVREQ="total_mem=60 core=16"
