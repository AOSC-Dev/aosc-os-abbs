From 9bd6f853d229a8df7b6675bb5452caff3c3de354 Mon Sep 17 00:00:00 2001
From: lazerg <lazerg2@gmail.com>
Date: Wed, 21 Oct 2026 16:42:03 +0500
Subject: [PATCH] FROMLIST: src: fix build with `--shared-brotli`

Assisted-by: Claude Code
Signed-off-by: lazerg <lazerg2@gmail.com>

Link: https://github.com/nodejs/node/pull/66895
Link: https://github.com/nodejs/node/issues/66894
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 node.gypi                                | 2 ++
 src/node_zlib.cc                         | 2 ++
 test/parallel/test-zlib-invalid-input.js | 2 +-
 unofficial.gni                           | 3 +++
 4 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/node.gypi b/node.gypi
index 9eb972adc47..c07082d4904 100644
--- a/node.gypi
+++ b/node.gypi
@@ -252,6 +252,8 @@
 
     [ 'node_shared_brotli=="false"', {
       'dependencies': [ 'deps/brotli/brotli.gyp:brotli' ],
+    }, {
+      'defines': [ 'NODE_SHARED_BROTLI' ],
     }],
 
     [ 'node_use_sqlite=="true" and node_shared_sqlite=="false"', {
diff --git a/src/node_zlib.cc b/src/node_zlib.cc
index 3cb736c22aa..f6025341880 100644
--- a/src/node_zlib.cc
+++ b/src/node_zlib.cc
@@ -2268,7 +2268,9 @@ void DefineZlibConstants(Local<Object> target) {
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_FORMAT_PADDING_1);
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_FORMAT_PADDING_2);
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_FORMAT_DISTANCE);
+#ifndef NODE_SHARED_BROTLI
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_FORMAT_BLOCK_SWITCH);
+#endif
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_DICTIONARY_NOT_SET);
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_INVALID_ARGUMENTS);
   NODE_DEFINE_CONSTANT(target, BROTLI_DECODER_ERROR_ALLOC_CONTEXT_MODES);
diff --git a/test/parallel/test-zlib-invalid-input.js b/test/parallel/test-zlib-invalid-input.js
index 976d4640eba..ec534e5f76e 100644
--- a/test/parallel/test-zlib-invalid-input.js
+++ b/test/parallel/test-zlib-invalid-input.js
@@ -89,7 +89,7 @@ Object.defineProperty(spoofedLength, 'byteLength', { get: () => 5000 });
   deflate.close();
 }
 
-{
+if (!process.config.variables.node_shared_brotli) {
   // A block switch is invalid when the stream declares only one block type.
   const invalidBlockSwitch = Buffer.from(
     '200010414141fcffff07002228f00b60f7f41f000000',
diff --git a/unofficial.gni b/unofficial.gni
index 5878f079d94..d88fadd1212 100644
--- a/unofficial.gni
+++ b/unofficial.gni
@@ -58,6 +58,9 @@ template("node_gn_build") {
     if (v8_enable_i18n_support) {
       defines += [ "NODE_HAVE_I18N_SUPPORT=1" ]
     }
+    if (node_shared_brotli) {
+      defines += [ "NODE_SHARED_BROTLI" ]
+    }
   }
 
   config("node_external_config") {
-- 
2.56.0

