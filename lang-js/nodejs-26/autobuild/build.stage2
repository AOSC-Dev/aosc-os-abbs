#### Control part variable.
_NODE_PREFIX=/usr/lib/node-${PKGVER%%.*}

abinfo "Configuring Node.js ..."
export WITHOUT_LIEF=""
export LDFLAGS="$LDFLAGS -latomic"
if ab_match_arch loongson3; then
# FIXME:
# ../deps/LIEF/include/LIEF/asm/mips/opcodes.hpp:22:11: error: expected identifier or '{'
# 22 | namespace mips {
# | ^
# <built-in>:420:14: note: expanded from macro 'mips'
    abinfo "Disabling LIEF for loongson3 ..."
    export WITHOUT_LIEF="--without-lief"
fi
# FIXME: According to https://github.com/nodejs/node/issues/62676
# Use bundled icu for now until v8 has fixed the problem
# FIXME: intentionally split $NODE_FLAGS_ARCH
# shellcheck disable=SC2086
"$SRCDIR"/configure \
    --prefix="${_NODE_PREFIX}" \
    --ninja \
    --shared-ada \
    --shared-brotli \
    --shared-cares \
    --shared-ffi \
    --shared-hdr-histogram \
    --shared-libuv \
    --shared-nghttp2 \
    --shared-nghttp3 \
    --shared-ngtcp2 \
    --shared-openssl \
    --shared-simdutf \
    --shared-sqlite \
    --shared-zstd \
    --shared-zlib \
    --with-intl=full-icu \
    --with-corepack \
    --v8-enable-temporal-support \
    $WITHOUT_LIEF \
    $NODE_FLAGS_ARCH

abinfo "Building Node.js ..."
make "$MAKEFLAGS"

abinfo "Installing Node.js ..."
make install \
    DESTDIR="$PKGDIR"

abinfo "Installing node-gyp ..."
install -Dvm755 \
   "$PKGDIR"/"${_NODE_PREFIX}"/lib/node_modules/npm/bin/node-gyp-bin/node-gyp \
   "$PKGDIR"/"${_NODE_PREFIX}"/bin/node-gyp

# Note:
# original line is:
#   node "`dirname "$0"`/../../node_modules/node-gyp/bin/node-gyp.js" "$@"
# see https://github.com/npm/cli/blob/eacec5f49060d3dfcdc3c7043115619e4bb22864/bin/node-gyp-bin/node-gyp#L3
# should replace to:
#   node /usr/lib/node-%version%/lib/node_modules/npm/node_modules/node-gyp/bin//node-gyp.js "$@"
checksum_before_replace=$(sha256sum "$PKGDIR"/"${_NODE_PREFIX}"/bin/node-gyp)
# intentionally use single quote for literal
# shellcheck disable=SC2016
original_gyp_path='"`dirname "$0"`/../../node_modules/node-gyp/bin/node-gyp.js"'
actual_gyp_path="$_NODE_PREFIX/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js"
sed -e "s|$original_gyp_path|$actual_gyp_path|" -i "$PKGDIR"/"${_NODE_PREFIX}"/bin/node-gyp
checksum_after_replace=$(sha256sum "$PKGDIR"/"${_NODE_PREFIX}"/bin/node-gyp)
if [[ "$checksum_before_replace" == "$checksum_after_replace" ]]; then
	abwarn "sed replaced nothing, aborting ..."
	abinfo "Content of $PKGDIR/$_NODE_PREFIX/bin/node-gyp :"
	cat "$PKGDIR"/"${_NODE_PREFIX}"/bin/node-gyp
	exit 1
fi

abinfo "Creating Corepack shims..."
PATH="$PATH:$PKGDIR/${_NODE_PREFIX}/bin" \
"$PKGDIR"/"${_NODE_PREFIX}"/bin/corepack \
	enable
