function replace_string() {
	src=$3
	tmp=""
	if [[ $# -gt 3 ]]; then
		dst=$4
	else
		tmp=$(mktemp "ab_replace_string.XXXXXXXX")
		dst=$tmp
	fi
	sed -e "s|$1|$2|" "$src" > "$dst"

	if cmp --silent -- "$src" "$dst"; then
		abwarn "Replaced nothing, aborting ..."
		abinfo "Content of $src :"
		cat "$src"
		if [[ "" != "$tmp" ]]; then
			rm "$tmp"
		fi
		exit 1
	fi

	if [[ "" != "$tmp" ]]; then
		cat "$tmp" > "$src"
	fi
}

#### Control part variable.
VERSION=${PKGVER%%.*}
NODE_PREFIX=/usr/lib/node-$VERSION
PRIORTY=$VERSION # Set to $VERSION for non default version, set to 100 for default version

abinfo "Configuring Node.js ..."
ARGV=(
	"--prefix=$NODE_PREFIX"
	"--ninja"
	"--shared-ada"
	"--shared-brotli"
	"--shared-cares"
	"--shared-libuv"
	"--shared-nghttp2"
	"--shared-nghttp3"
	"--shared-ngtcp2"
	"--shared-openssl"
	"--shared-simdutf"
	"--shared-sqlite"
	"--shared-zstd"
	"--shared-zlib"
	"--with-intl=system-icu"
	# Note: disabled as pnpm is already packaged and corepack is removed from newer release
	"--without-corepack"
)

if ab_match_arch loongson3; then
    abinfo "Loongson 3 detected, specifying r2 target and fp64 FPU mode ..."
	ARGV+=(
		"--with-mips-arch-variant=r2"
		"--with-mips-fpu-mode=fp64"
	)
fi

"$SRCDIR"/configure "${ARGV[@]}"

abinfo "Building Node.js ..."
make "$MAKEFLAGS"

abinfo "Installing Node.js ..."
make install \
    DESTDIR="$PKGDIR"

abinfo "Installing node-gyp ..."
install -Dvm755 \
   "$PKGDIR"/"$NODE_PREFIX"/lib/node_modules/npm/bin/node-gyp-bin/node-gyp \
   "$PKGDIR"/"$NODE_PREFIX"/bin/node-gyp

# Note:
# original line is:
#   node "`dirname "$0"`/../../node_modules/node-gyp/bin/node-gyp.js" "$@"
# see https://github.com/npm/cli/blob/eacec5f49060d3dfcdc3c7043115619e4bb22864/bin/node-gyp-bin/node-gyp#L3
# should replace to:
#   node /usr/lib/node-%version%/lib/node_modules/npm/node_modules/node-gyp/bin//node-gyp.js "$@"
# intentionally use single quote for literal
# shellcheck disable=SC2016
original_gyp_path='"`dirname "$0"`/../../node_modules/node-gyp/bin/node-gyp.js"'
actual_gyp_path="$NODE_PREFIX/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js"
replace_string "$original_gyp_path" "$actual_gyp_path" "$PKGDIR"/"$NODE_PREFIX"/bin/node-gyp

abinfo "Generating postinst scripts (priorty $PRIORTY) ..."
echo "update-alternatives --install /usr/bin/node node $NODE_PREFIX/bin/node $PRIORTY \\" > "$SRCDIR/autobuild/postinst"
for i in "$PKGDIR/$NODE_PREFIX/bin/"*; do
    BIN="$(basename "$i")"
	if [[ "$BIN" == "node" ]]; then
		continue
	fi
	echo "    --slave /usr/bin/$BIN $BIN $NODE_PREFIX/bin/$BIN \\" >> "$SRCDIR/autobuild/postinst"
done
echo "" >> "$SRCDIR/autobuild/postinst"

replace_string %PFX% "$NODE_PREFIX" "$SRCDIR"/autobuild/postrm.in "$SRCDIR"/autobuild/postrm
