PKGNAME=sane-backends
PKGSEC=libs
PKGDES="Base libraries for SANE scanning interface"
PKGDEP="avahi cups libieee1284 libgphoto2 libjpeg-turbo libtiff libusb \
        net-snmp poppler v4l-utils"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
	"--enable-pthread"
	"--disable-locking"
)
ABSHADOW=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
