PKGNAME=libblockdev
PKGSEC=libs
PKGDEP="bcache-tools btrfs-progs cryptsetup dosfstools gcc-runtime glib glibc \
        gptfdisk json-glib keyutils kmod libatasmart libbytesize lvm2 mdadm \
        ndctl nspr nss parted systemd util-linux-runtime volume-key xfsprogs \
        yaml libnvme"
PKGDEP__RETRO="btrfs-progs dosfstools gcc-runtime glib glibc gptfdisk \
        json-glib kmod libatasmart libbytesize parted systemd \
        util-linux-runtime xfsprogs yaml libnvme"
BUILDDEP="gobject-introspection autoconf-archive"
BUILDDEP__RETRO="autoconf-archive lvm2 mdadm"
PKGSUG__RETRO="lvm2 mdadm"
PKGDES="Library to manipulate block devices"

AUTOTOOLS_AFTER=(
    '--with-dm=no'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-nvdimm'
    # Note: Now a hard requirement in UDisks.
    '--with-nvme'
    # Note: No cryptosetup for Afterglow.
    '--without-crypto'
    '--enable-introspection=no'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
