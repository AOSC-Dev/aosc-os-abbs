From f0f7851b84c63bac01cc8baecc77f3fe677dd4c0 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Thu, 11 Jun 2026 18:34:40 +0800
Subject: [PATCH] AOSCOS: Compress-Raw-Zlib: use system Zlib

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 cpan/Compress-Raw-Zlib/config.in | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/cpan/Compress-Raw-Zlib/config.in b/cpan/Compress-Raw-Zlib/config.in
index 0539d196db..a23bc7104a 100644
--- a/cpan/Compress-Raw-Zlib/config.in
+++ b/cpan/Compress-Raw-Zlib/config.in
@@ -11,9 +11,9 @@
 #    Setting the Gzip OS Code
 #
 
-BUILD_ZLIB      = True
-ZLIB_INCLUDE    = ./zlib-src
-ZLIB_LIB        = ./zlib-src
+BUILD_ZLIB = False
+ZLIB_INCLUDE    = /usr/include
+ZLIB_LIB        = /usr/lib
 OLD_ZLIB        = False
 GZIP_OS_CODE    = AUTO_DETECT
 USE_ZLIB_NG     = False
-- 
2.52.0

