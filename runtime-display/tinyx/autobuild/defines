PKGNAME=tinyx
PKGSEC=x11
PKGDEP="freetype libpng x11-lib x11-font"
PKGDES="Minimal, generic X server (Tiny Core Linux fork)"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    "--with-fontdir=/usr/share/fonts"
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
