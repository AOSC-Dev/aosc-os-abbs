PKGNAME=openshadinglanguage
PKGSEC=libs
PKGDEP="openimageio ilmbase imath flex pugixml partio numpy freetype libpng libtiff zlib ncurses qt-6"
BUILDDEP="llvm pybind11 python-3 robin-map"
PKGDES="Shading language for production GI renderers"

CMAKE_AFTER=(
    '-DBUILD_SHARED_LIBS=ON'
    '-DINSTALL_DOCS=OFF'
    '-DOSL_BUILD_PLUGINS=ON'
    '-DOSL_BUILD_SHADERS=ON'
    '-DUSE_PYTHON=ON'
    '-DUSE_QT=ON'
    '-DCMAKE_CXX_STANDARD=17'
)
