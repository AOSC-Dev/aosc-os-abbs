PKGNAME=libdrm-loonggpu
PKGDES="Direct Rendering Manager runtime library for LoongGPU with 4K and 16K page size support"
PKGDEP="x11-lib libdrm"
PKGSEC=libs

ABTPYE=self
MESON_AFTER=(
    '-Dudev=true'
    '-Dinstall-test-programs=true'
    '-Dvalgrind=disabled'
    '-Dradeon=disabled'
    '-Dnouveau=disabled'
    '-Dvmwgfx=disabled'
    '-Detnaviv=disabled'
)

PKGREP="libldrm ldrm"
PKGPROV="libldrm ldrm==2:2"
PKGCONFL="libldrm ldrm"

FAIL_ARCH="!(loongarch64)"
