+  'loonggpu_stress',
+  files(
+    'amdgpu_stress.c'
+  ),
+  c_args : [
+    '-DLOONGGPU',
+    '-Damdgpu_bo_alloc=loonggpu_bo_alloc',
+    '-Damdgpu_bo_cpu_map=loonggpu_bo_cpu_map',
