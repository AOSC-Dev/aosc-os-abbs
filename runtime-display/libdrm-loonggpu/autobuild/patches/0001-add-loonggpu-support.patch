diff --git a/tests/amdgpu/amdgpu_stress.c b/tests/amdgpu/amdgpu_stress.c
index f919351e1f17..ed4441576c28 100644
--- a/tests/amdgpu/amdgpu_stress.c
+++ b/tests/amdgpu/amdgpu_stress.c
@@ -99,7 +99,11 @@ static int amdgpu_open_device(void)
 			continue;
 
 		/* If this is not AMD GPU vender ID, skip*/
+#ifdef LOONGGPU
+		if (devices[i]->deviceinfo.pci->vendor_id != 0x0014)
+#else
 		if (devices[i]->deviceinfo.pci->vendor_id != 0x1002)
+#endif
 			continue;
 
 		if (!(devices[i]->available_nodes & 1 << DRM_NODE_RENDER))
@@ -121,7 +125,12 @@ static int amdgpu_open_device(void)
 			continue;
 		}
 
+#ifdef LOONGGPU
+		if (strcmp(version->name, "gsgpu") &&
+		    strcmp(version->name, "loonggpu")) {
+#else
 		if (strcmp(version->name, "amdgpu")) {
+#endif
 			/* This is not AMDGPU driver, skip.*/
 			drmFreeVersion(version);
 			close(fd);
diff --git a/tests/amdgpu/meson.build b/tests/amdgpu/meson.build
index d663dcae198d..4dc6fb5bef1c 100644
--- a/tests/amdgpu/meson.build
+++ b/tests/amdgpu/meson.build
@@ -28,3 +28,27 @@ amdgpu_stress = executable(
