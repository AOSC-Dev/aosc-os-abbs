new file mode 100644
index 000000000000..f81a347dfd09
--- /dev/null
+++ b/data/loonggpu.ids
@@ -0,0 +1,8 @@
+# List of LOONGGPU IDs
+#
+# Syntax:
+# device_id,	revision_id,	product_name        <-- single tab after comma
+
