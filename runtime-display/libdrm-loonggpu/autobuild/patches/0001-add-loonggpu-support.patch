index 9c26b66e0c35..72b5410450eb 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -24,4 +24,9 @@ if with_amdgpu
     install_mode : 'rw-r--r--',
     install_dir : datadir_amdgpu,
   )
