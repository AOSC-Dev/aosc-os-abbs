build_meson_configure

build_meson_build

abinfo "Installing binaries ..."
DESTDIR="$BLDDIR" ninja install
mkdir -pv $PKGDIR/usr/lib
cp -av $BLDDIR/usr/lib/libdrm_loonggpu.so* $PKGDIR/usr/lib
ln -sv libdrm_loonggpu.so.1.${PKGVER##*.}.0 $PKGDIR/usr/lib/libldrm.so.1
mkdir -pv $PKGDIR/usr/bin
cp -av $BLDDIR/usr/bin/loonggpu_stress $PKGDIR/usr/bin
mkdir -pv $PKGDIR/usr/share/libdrm
cp -av $BLDDIR/usr/share/libdrm/loonggpu.ids $PKGDIR/usr/share/libdrm
