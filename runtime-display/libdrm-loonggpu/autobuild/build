SO_NAME=libdrm_loonggpu.so.1.${PKGVER##*.}.0

build_meson_configure

abinfo "Building binaries ..."
ninja -C $BLDDIR amdgpu/$SO_NAME tests/amdgpu/loonggpu_stress

abinfo "Installing binaries ..."
mkdir -pv $PKGDIR/usr/lib
cp -v $BLDDIR/amdgpu/$SO_NAME $PKGDIR/usr/lib
ln -sv $SO_NAME $PKGDIR/usr/lib/libdrm_loonggpu.so.1
ln -sv libdrm_loonggpu.so.1 $PKGDIR/usr/lib/libdrm_loonggpu.so
mkdir -pv $PKGDIR/usr/bin
cp -v $BLDDIR/tests/amdgpu/loonggpu_stress $PKGDIR/usr/bin
mkdir -pv $PKGDIR/usr/share/libdrm
cp -v data/loonggpu.ids $PKGDIR/usr/share/libdrm
