PKGNAME=xf86-video-ati
PKGDES="XF86 driver for ATI graphics cards"
PKGDEP="xorg-server libdrm"
PKGSEC=x11
PKGREP="xf86-video-ati+glamor"

# FIXME: Causes crashes on X.Org Server startup.
AB_FLAGS_RRO=0
AB_FLAGS_NOW=0

AUTOTOOLS_AFTER=(
    '--enable-glamor'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-glamor'
)
