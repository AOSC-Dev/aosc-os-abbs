abinfo "Creating symlinks for X.Org DRI components ..."
mkdir -pv "$PKGDIR"/usr/lib/xorg/modules/dri
cd "$PKGDIR"/usr/lib/xorg/modules/dri
# Note: All except `i915_dri.so', which will be installed via alternatives.
ln -sv ../../../dri-amber/* .
[ -e i915_dri.so ] && rm -v i915_dri.so

abinfo "Removing unused files ..."
rm -rv \
    "$PKGDIR"/usr/include \
    "$PKGDIR"/usr/lib/pkgconfig \
    "$PKGDIR"/usr/share/drirc.d
