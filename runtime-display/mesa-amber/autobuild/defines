PKGNAME=mesa-amber
PKGSEC=libs
PKGDES="Runtime library for OpenGL, Vulkan, OpenCL, and more (Amber branch for legacy devices)"
# Note: mesa provides libgbm.
PKGDEP="x11-lib libdrm expat systemd elfutils nettle libva wayland lm-sensors \
        libglvnd llvm-runtime mesa"
PKGDEP__RETRO="x11-lib elfutils libdrm libglvnd libva expat systemd mesa llvm-runtime"
PKGDEP__RETRO_NOLLVM="${PKGDEP__RETRO/llvm-runtime/}"
PKGDEP__ALPHA="${PKGDEP__RETRO_NOLLVM}"
PKGDEP__IA64="${PKGDEP__RETRO_NOLLVM}"

BUILDDEP="x11-proto mako systemd llvm glslang"
BUILDDEP__RETRO_NOLLVM="x11-proto mako pyyaml glslang"
BUILDDEP__ALPHA="${BUILDDEP__RETRO_NOLLVM}"
BUILDDEP__IA64="${BUILDDEP__RETRO_NOLLVM}"

ABTYPE=meson
MESON_AFTER=(
# Note: For stable-bound updates, use the following to disable assert().
    '-Db_ndebug=true'
# Note: Comment out line above for preview (RC or x.y.0) releases.

    '-Dplatforms=x11,wayland'
    '-Degl-native-platform=auto'

# Note: Install to a separate path so that lib*GL_amber.so wouldn't look
# up libraries/DRI that it shouldn't see.
#
# We will symlink these back to our standard X.Org path
# (/usr/lib/xorg/modules/dri), so that X.Org can still load them.
    '-Ddri-drivers-path=/usr/lib/dri-amber'

# Note: No Gallium driver to be shipped with Amber.
    '-Dgallium-extra-hud=false'
    '-Dgallium-va=disabled'

    '-Dstatic-libclc='
    '-Dshader-cache=enabled'
    '-Dshader-cache-default=true'
    '-Dvulkan-layers=device-select,overlay'
    '-Dgles1=enabled'
    '-Dgles2=enabled'
    '-Dopengl=true'
    '-Dglx=dri'
    '-Degl=enabled'
    '-Dglvnd=enabled'
    '-Dllvm=enabled'
    '-Dshared-llvm=enabled'
    '-Ddraw-use-llvm=true'
    '-Dvalgrind=disabled'
    '-Dlibunwind=false'
    '-Dlmsensors=enabled'
    '-Dtools='
    '-Dxlib-lease=enabled'
    '-Dglx-direct=true'
    '-Dzstd=enabled'
    '-Dzlib=enabled'
    '-Dsse2=false'
    '-Dperfetto=false'
    '-Dvmware-mks-stats=false'
    '-Dwrap_mode=default'

# Note: For coexistence via libglvnd
#
# See: https://docs.mesa3d.org/amber.html
    '-Damber=true'

    '-Dgallium-drivers='
    '-Dvulkan-drivers='
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dplatforms=x11'
    '-Dgallium-extra-hud=false'
    '-Dvulkan-layers=device-select,overlay'
    '-Dlibunwind=disabled'
    '-Dlmsensors=disabled'
    '-Dzstd=disabled'
    '-Dshader-cache=disabled'
    '-Dshader-cache-default=false'
# Note: Required by Intel commons:
#
#   /usr/bin/ld: [...]/mesa-26.2.6/abbuild/../src/intel/decoder/intel_decoder.c:748:(.text.get_embedded_xml_data+0x157): undefined reference to `inflate'
    '-Dzlib=enabled'
)

# Note: Fragment for use with architectures without LLVM.
MESON_AFTER__RETRO_NOLLVM=(
    # FIXME: No LLVM support.
    '-Dllvm=disabled'
    '-Dvulkan-layers='
)
# Note: Fragments for architecture-specific configurations.
MESON_AFTER__X86=(
    '-Ddri-drivers=r100,r200,i915,nouveau'
)
MESON_AFTER__OTHER=(
    '-Ddri-drivers=r100,r200,nouveau'
)

# Amber provides the following that we can enable:
#
#   AMD Radeon R100 (7000 series, VE, LE, IGP, etc.), R200 (8500,
#   9000, and 9200 series). R100 is named `radeon_dri' after
#   installation.
#
#   Intel 830/845/855/865 series integrated graphics (only keeping
#   `i830_dri' after installation, `i915_dri' is supplied by mainline
#   Gallium module).
#
#   NVIDIA Riva TNT/TNT2, GeForce 256, GeForce 2/3/4 Ti/MX, and their
#   Go series variants (named `nouveau_vieux_dri' after installation.
#
# It is also clear from the information above that Mesa Amber is not
# useful for some of our ports. Exclude them here.

# FIXME: No LLVM support.
MESON_AFTER__ALPHA=(
    "${MESON_AFTER__RETRO[@]}"
    "${MESON_AFTER__RETRO_NO_LLVM[@]}"
    "${MESON_AFTER__OTHER[@]}"
)

MESON_AFTER__AMD64=(   
    "${MESON_AFTER[@]}"
    "${MESON_AFTER__X86[@]}"
)
MESON_AFTER__I486=(
    "${MESON_AFTER__RETRO[@]}"
    "${MESON_AFTER__X86[@]}"
)

# FIXME: No LLVM support.
MESON_AFTER__IA64=(
    "${MESON_AFTER__RETRO[@]}"
    "${MESON_AFTER__RETRO_NO_LLVM[@]}"
    "${MESON_AFTER__OTHER[@]}"
)

MESON_AFTER__POWERPC=(
    "${MESON_AFTER__RETRO[@]}"
    "${MESON_AFTER__OTHER[@]}"
)
MESON_AFTER__PPC64=(
    "${MESON_AFTER__RETRO[@]}"
    "${MESON_AFTER__OTHER[@]}"
)
MESON_AFTER__SPARC64=(
    "${MESON_AFTER__RETRO[@]}"
    "${MESON_AFTER__OTHER[@]}"
)

# FIXME: LLVM + Mesa + LTO + AMDGPU = artifacts.
NOLTO=1

# Note: Useful only for some.
FAIL_ARCH="!(alpha|amd64|i486|ia64|powerpc|ppc64|sparc64)"
