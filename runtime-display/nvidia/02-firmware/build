NV_ARCH="undefined"

case "$ABHOST" in
    amd64)
        NV_ARCH="x86_64"
        ;;
    arm64)
        NV_ARCH="aarch64"
        ;;
    *)
        abdie "Unsupported architecture"
esac

pushd "$SRCDIR"/NVIDIA-Linux-${NV_ARCH}-${PKGVER}

abinfo "Installing firmware binaries ..."
install -Dvm644 firmware/*.bin \
    -t "$PKGDIR"/usr/lib/firmware/nvidia/"$PKGVER"/

popd
