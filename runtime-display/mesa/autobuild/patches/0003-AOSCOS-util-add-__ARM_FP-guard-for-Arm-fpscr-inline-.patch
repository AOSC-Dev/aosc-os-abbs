From cc18cc2feabc0cb22a91139782e05675aa705138 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Sun, 1 Nov 2026 22:38:54 +0800
Subject: [PATCH 3/3] AOSCOS: util: add __ARM_FP guard for Arm `fpscr' inline
 assembly

The preprocessor macro __ARM_FP is not defined for soft float targets
(e.g., -mcpu=armv7m or -mcpu=aarch64+nofp). Use it as a guard to fix build
on soft-float targets.

Link: https://reviews.llvm.org/D145781
Link: https://gcc.gnu.org/legacy-ml/gcc-patches/2014-12/msg00250.html
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 src/util/u_math.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/util/u_math.c b/src/util/u_math.c
index 722eac7f733..879585b40c0 100644
--- a/src/util/u_math.c
+++ b/src/util/u_math.c
@@ -90,7 +90,7 @@ util_fpstate_get(void)
    if (util_get_cpu_caps()->has_neon) {
 #ifdef HAVE___BUILTIN_ARM_GET_FPSCR
       fpstate = __builtin_arm_get_fpscr();
-#else
+#elif defined(__ARM_FP)
       __asm__ volatile("vmrs %0, fpscr" : "=r"(fpstate));
 #endif
    }
@@ -100,7 +100,7 @@ util_fpstate_get(void)
       fpstate = (unsigned)__builtin_aarch64_get_fpcr();
 #elif DETECT_CC_MSVC
       fpstate = (unsigned)_ReadStatusReg(ARM64_FPCR);
-#else
+#elif defined(__ARM_FP)
       uint64_t fpcr;
       __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
       fpstate = (unsigned)fpcr;
@@ -157,7 +157,7 @@ util_fpstate_set(unsigned fpstate)
    if (util_get_cpu_caps()->has_neon) {
 #ifdef HAVE___BUILTIN_ARM_SET_FPSCR
       __builtin_arm_set_fpscr(fpstate);
-#else
+#elif defined(__ARM_FP)
       __asm__ volatile("vmsr fpscr, %0" :: "r"(fpstate));
 #endif
    }
@@ -167,7 +167,7 @@ util_fpstate_set(unsigned fpstate)
       __builtin_aarch64_set_fpcr(fpstate);
 #elif DETECT_CC_MSVC
       _WriteStatusReg(ARM64_FPCR, fpstate);
-#else
+#elif defined(__ARM_FP)
       uint64_t fpcr = fpstate;
       __asm__ volatile("msr fpcr, %0" :: "r"(fpcr));
 #endif
