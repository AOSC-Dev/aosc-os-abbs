PKGNAME=mesa
PKGSEC=libs
PKGDES="Runtime library for OpenGL, Vulkan, OpenCL, and more"
PKGDEP="x11-lib libdrm expat systemd elfutils nettle libva wayland lm-sensors \
        libglvnd llvm-runtime libcl libclc spirv-llvm-translator \
        libdisplay-info xcb-util-keysyms libconfig"
PKGDEP__RETRO="x11-lib elfutils libdrm libglvnd libva expat systemd llvm-runtime"
PKGDEP__RETRO_NOLLVM="${PKGDEP__RETRO/llvm-runtime/}"
PKGDEP__ALPHA="${PKGDEP__RETRO_NOLLVM}"
PKGDEP__IA64="${PKGDEP__RETRO_NOLLVM}"

# Note: Recommend Amber for Afterglow architectures with it available.
PKGRECOM=""
PKGRECOM__ALPHA="mesa-amber"
PKGRECOM__I486="mesa-amber"
PKGRECOM__IA64="mesa-amber"
PKGRECOM__POWERPC="mesa-amber"
PKGRECOM__PPC64="mesa-amber"
PKGRECOM__SPARC64="mesa-amber"

BUILDDEP="x11-proto mako systemd llvm libunwind glslang spirv-tools \
          ply rustc rust-bindgen pycparser cbindgen pyyaml directx-headers"
# Note: SPIRV dependencies are used only during build-time for GPU NIR/
# assembly/binaries.
BUILDDEP__RETRO=" \
          x11-proto llvm mako glslang pyyaml setuptools-python3 \
          spirv-llvm-translator spirv-tools"
# FIXME: Some architectures have no LLVM support.
BUILDDEP__RETRO_NOLLVM="x11-proto mako pyyaml glslang"
BUILDDEP__ALPHA="${BUILDDEP__RETRO_NOLLVM}"
BUILDDEP__IA64="${BUILDDEP__RETRO_NOLLVM}"

ABTYPE=meson
# Note: -Dwrap_mode=default is used for Crate dependencies.
MESON_AFTER=(
# Note: For stable-bound updates, use the following to disable assert().
    '-Db_ndebug=true'
# Note: Comment out line above for preview (RC or x.y.0) releases.
    '-Dsplit-debug=disabled'
    '-Dplatforms=x11,wayland'
    '-Degl-native-platform=auto'
    '-Ddri-drivers-path=/usr/lib/dri-mesa'
    '-Dgallium-extra-hud=true'
    '-Dgallium-va=enabled'
    '-Dgallium-rusticl=true'
    '-Dstatic-libclc='
    '-Damdgpu-virtio=true'
    '-Dimagination-srv=true'
    '-Dshader-cache=enabled'
    '-Dshader-cache-default=true'
    '-Dvulkan-layers=device-select,overlay,screenshot'
    '-Dgles1=enabled'
    '-Dgles2=enabled'
    '-Dopengl=true'
    '-Dlibgbm-external=false'
    '-Dglx=dri'
    '-Degl=enabled'
    '-Dglvnd=enabled'
    '-Dllvm=enabled'
    '-Dshared-llvm=enabled'
    '-Ddraw-use-llvm=true'
    '-Damd-use-llvm=true'
    '-Dllvm-orcjit=true'
    '-Dvalgrind=disabled'
    '-Dlibunwind=true'
    '-Dlmsensors=enabled'
    '-Dhtml-docs=disabled'
    '-Dtools='
    '-Dxlib-lease=enabled'
    '-Dglx-direct=true'
    '-Dzstd=enabled'
    '-Dzlib=enabled'
    '-Dsse2=false'
    '-Dperfetto=false'
    '-Dteflon=false'
    '-Dgpuvis=false'
    '-Dsysprof=false'
    '-Dvmware-mks-stats=false'
    '-Dvulkan-beta=false'

# Note: Intel Ray Tracing is available for all 64-bit architectures.
    '-Dintel-rt=enabled'

    '-Dintel-elk=false'
    '-Dvideo-codecs=all'
    '-Dgallium-d3d12-video=enabled'
    '-Dgallium-d3d12-graphics=enabled'
    '-Dxmlconfig=enabled'

# Note: clc and precomp-compiler are both required for certain drivers
# during build-time, so we keep them as `auto' to fit different build
# configurations.
    '-Dmesa-clc=auto'
    '-Dprecomp-compiler=auto'

    '-Dvirtgpu_kumquat=true'
    '-Dwrap_mode=default'
    '-Dlegacy-wayland=bind-wayland-display'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dplatforms=x11'
    '-Dgallium-extra-hud=false'
    '-Dgallium-rusticl=false'
    '-Dvulkan-layers=device-select,overlay'
    '-Dlibunwind=disabled'
    '-Dlmsensors=disabled'
    '-Dzstd=disabled'
    '-Dshader-cache=disabled'
    '-Dshader-cache-default=false'
# Note: Required by Intel commons:
#
#   /usr/bin/ld: [...]/mesa-26.2.6/abbuild/../src/intel/decoder/intel_decoder.c:748:(.text.get_embedded_xml_data+0x157): undefined reference to `inflate'
    '-Dzlib=enabled'
    '-Dgallium-d3d12-video=disabled'
    '-Dgallium-d3d12-graphics=disabled'
    '-Dxmlconfig=disabled'

# Note: clc and precomp-compiler are both required for certain drivers
# during build-time, so we keep them as `auto' to fit different build
# configurations.
    '-Dmesa-clc=auto'
    '-Dprecomp-compiler=auto'

# Note: Intel Ray Tracing only available for 64-bit architectures.
    '-Dintel-rt=disabled'

    '-Dvirtgpu_kumquat=false'
)

# Note: Mainline configuration classes.
MESON_AFTER__X86=(
    "${MESON_AFTER[@]}"
    '-Dgallium-drivers=asahi,crocus,d3d12,etnaviv,freedreno,i915,iris,lima,llvmpipe,nouveau,panfrost,r300,r600,radeonsi,softpipe,svga,tegra,v3d,vc4,virgl,zink'
    '-Dgallium-rusticl-enable-drivers=asahi,radeonsi'
    '-Dvulkan-drivers=amd,asahi,broadcom,freedreno,intel,intel_hasvk,panfrost,swrast,virtio,nouveau,gfxstream'
    '-Dfreedreno-kmds=msm,kgsl,virtio,wsl'
    '-Dintel-elk=true'
    '-Dlibunwind=enabled'
    '-Dsse2=true'
)
MESON_AFTER__ARM=(
    "${MESON_AFTER[@]}"
    '-Dgallium-drivers=asahi,d3d12,etnaviv,freedreno,i915,iris,lima,llvmpipe,nouveau,panfrost,r300,r600,radeonsi,softpipe,svga,tegra,v3d,vc4,virgl,zink'
    '-Dgallium-rusticl-enable-drivers=asahi,radeonsi'
    '-Dvulkan-drivers=amd,asahi,broadcom,freedreno,intel,panfrost,swrast,virtio,nouveau,gfxstream'
    '-Dfreedreno-kmds=msm,kgsl,virtio,wsl'
)
MESON_AFTER__OTHER=(
    "${MESON_AFTER[@]}"
    '-Dgallium-drivers=etnaviv,iris,llvmpipe,nouveau,r300,r600,radeonsi,softpipe,virgl,zink'
    '-Dgallium-rusticl-enable-drivers=radeonsi'
    '-Dvulkan-drivers=amd,intel,swrast,virtio,nouveau,gfxstream'
)
# Note: Afterglow (retro) configuration classes.
MESON_AFTER__RETRO_X86=(
    "${MESON_AFTER__RETRO[@]}"
    '-Dgallium-drivers=r300,r600,i915,nouveau,crocus'
    '-Dvulkan-drivers='
# Note: Required to build crocus (pre-Gen8 graphics) driver.
    '-Dintel-elk=true'
)
MESON_AFTER__RETRO_ARM=(
    "${MESON_AFTER__RETRO[@]}"
    '-Dgallium-drivers=freedreno,tegra,vc4,nouveau,virgl,lima,panfrost'
    '-Dvulkan-drivers='
)
MESON_AFTER__RETRO_OTHER=(
    "${MESON_AFTER__RETRO[@]}"
    '-Dgallium-drivers=r300,r600,nouveau'
    '-Dvulkan-drivers='
)
# Note: Fragment for use with architectures without LLVM.
MESON_AFTER__RETRO_NOLLVM=(
    # FIXME: No LLVM support.
    '-Dllvm=disabled'
    '-Dvulkan-layers='
)

# Note: Mainline configurations.
MESON_AFTER__AMD64=(
    "${MESON_AFTER__X86[@]}"
)
MESON_AFTER__ARM64=(
    "${MESON_AFTER__ARM[@]}"
    '-Dlibunwind=disabled'
)
MESON_AFTER__LOONGARCH64=(
    "${MESON_AFTER__OTHER[@]}"
    '-Dlibunwind=enabled'
    '-Dvalgrind=disabled'
)
MESON_AFTER__LOONGARCH64_NOSIMD=(
    "${MESON_AFTER__LOONGARCH64[@]}"
)
# FIXME: libc crate is broken (required by rusticl and gfxtream Vulkan driver).
MESON_AFTER__LOONGSON3=(
    "${MESON_AFTER__OTHER[@]}"
    '-Dlibunwind=enabled'
    '-Dgallium-rusticl=false'
    '-Dgallium-rusticl-enable-drivers='
    '-Dvulkan-drivers=amd,intel,swrast,virtio,nouveau'
)
MESON_AFTER__PPC64EL=(
    "${MESON_AFTER__OTHER[@]}"
    '-Dlibunwind=enabled'
)
MESON_AFTER__RISCV64=(
    "${MESON_AFTER__OTHER[@]}"
    '-Dlibunwind=disabled'
    '-Dvalgrind=disabled'
)

# Note: Afterglow (retro) configurations.
MESON_AFTER__ALPHA=(
    "${MESON_AFTER__RETRO_OTHER[@]}"
    "${MESON_AFTER__RETRO_NOLLVM[@]}"
)
MESON_AFTER__ARMV4=(
    "${MESON_AFTER__RETRO_ARM[@]}"
    # Note: None of the usable ARMv4 devices actually come with a GPU.
    '-Dgallium-drivers=softpipe'
    '-Dgallium-va=disabled'
    '-Degl=disabled'
)
MESON_AFTER__ARMV5TE=(
    "${MESON_AFTER__RETRO_ARM[@]}"
    # Note: None of the usable ARMv5TE devices actually come with a GPU.
    '-Dgallium-drivers=softpipe'
    '-Dgallium-va=disabled'
    '-Degl=disabled'
)
MESON_AFTER__ARMV6HF=(
    "${MESON_AFTER__RETRO_ARM[@]}"
)
MESON_AFTER__ARMV7HF=(
    "${MESON_AFTER__RETRO_ARM[@]}"
)
MESON_AFTER__I486=(
    "${MESON_AFTER__RETRO_X86[@]}"
)
MESON_AFTER__IA64=(
    "${MESON_AFTER__RETRO_OTHER[@]}"
    "${MESON_AFTER__RETRO_NOLLVM[@]}"
)
MESON_AFTER__LOONGSON2F=(
    "${MESON_AFTER__RETRO_OTHER[@]}"
)
MESON_AFTER__POWERPC=(
    "${MESON_AFTER__RETRO_OTHER[@]}"
)
MESON_AFTER__PPC64=(
    "${MESON_AFTER__RETRO_OTHER[@]}"
)

# FIXME: LLVM + Mesa + LTO + AMDGPU = artifacts.
NOLTO=1

# Note: Extra Provides for Spiral.
PKGPROV="libglx-mesa0_spiral"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
