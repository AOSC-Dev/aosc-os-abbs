PKGNAME=mesa
PKGSEC=libs
PKGDES="MesaLib - a OpenGL implementation"
PKGDEP="x11-lib libdrm expat elfutils nettle libglvnd pyyaml"
BUILDDEP="x11-proto mako"

ABTYPE=meson
MESON_AFTER=(
    '-Dplatforms=x11'
    '-Dzstd=enabled'
    '-Dzlib=enabled'
    '-Dgles1=enabled'
    '-Dgles2=enabled'
    '-Dopengl=true'
    '-Dglx=disabled'
    '-Degl=disabled'
    '-Dglvnd=enabled'
    '-Dllvm=disabled'
    '-Dshared-llvm=disabled'
    '-Ddraw-use-llvm=false'
    '-Dvalgrind=disabled'
    '-Dlibunwind=disabled'
    '-Dlmsensors=disabled'
    '-Dgallium-drivers='
    '-Dgallium-rusticl-enable-drivers='
    '-Dvulkan-drivers='
    '-Dfreedreno-kmds='
    '-Dvideo-codecs='
)

# FIXME: LLVM + Mesa + LTO + AMDGPU = artifacts.
NOLTO=1

# Note: Extra Provides for Spiral.
PKGPROV="libglx-mesa0_spiral"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
