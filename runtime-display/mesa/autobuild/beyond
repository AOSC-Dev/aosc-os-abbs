# Amber provides the following that we can enable:
#
#   AMD Radeon R100 (7000 series, VE, LE, IGP, etc.), R200 (8500,
#   9000, and 9200 series). R100 is named `radeon_dri' after
#   installation.
#
#   Intel 830/845/855/865 series integrated graphics (only keeping
#   `i830_dri' after installation, `i915_dri' is supplied by mainline
#   Gallium module).
#
#   NVIDIA Riva TNT/TNT2, GeForce 256, GeForce 2/3/4 Ti/MX, and their
#   Go series variants (named `nouveau_vieux_dri' after installation.
#
# It is also clear from the information above that Mesa Amber is not
# useful for some of our ports. Exclude them here.
if ! ab_match_arch arm64 && \
   ! ab_match_arch armv4 && \
   ! ab_match_arch armv5te && \
   ! ab_match_arch armv6hf && \
   ! ab_match_arch armv7hf && \
   ! ab_match_arch loongarch64 && \
   ! ab_match_arch loongarch64_nosimd && \
   ! ab_match_arch loongson2f && \
   ! ab_match_arch loongson3 && \
   ! ab_match_arch m68k && \
   ! ab_match_arch ppc64el && \
   ! ab_match_arch riscv64 && \
   ! ab_match_arch sh3; then
    # Manually merge mainline/retro MESON_AFTER__AMBER.
    if ab_match_arch retro; then
        MESON_AFTER__AMBER=(
            "${MESON_AFTER__AMBER_RETRO[@]}"
        )
    fi

    if ab_match_arch amd64 || \
       ab_match_arch i486; then
        MESON_AFTER__AMBER=(
            "${MESON_AFTER__AMBER[@]}"
            '-Ddri-drivers=r100,r200,i915,nouveau'
        )
    else
        MESON_AFTER__AMBER=(
            "${MESON_AFTER__AMBER[@]}"
            '-Ddri-drivers=r100,r200,nouveau'
        )
    fi

    # Note: Routine to build Amber extras.
    cd "$SRCDIR"/../mesa-${__AMBER_VER}

    abinfo "Applying patches ..."
    ab_apply_patches "$SRCDIR"/autobuild/patches/amber/*.patch

    abinfo "Creating build directory ..."
    mkdir -pv abbuild && cd abbuild

    abinfo "Configuring Amber extras ..."
    meson .. \
        "${MESON_DEF[@]}" \
        "${MESON_AFTER__AMBER[@]}"

    abinfo "Building Amber extras ..."
    ninja --verbose

    abinfo "Installing Amber extras ..."
    # Note: Before we overwrite anything, drop files that conflicts with
    # mainline Mesa.
    #
    # Install to a "staging" directory.
    DESTDIR=./amberdist \
        ninja install
    cd ./amberdist
    rm -v \
        ./usr/lib/libgbm.* \
        ./usr/lib/libglapi.* \
        ./usr/lib/xorg/modules/dri/i915_dri.so
    rm -rv \
        ./usr/include \
        ./usr/lib/pkgconfig \
        ./usr/share/drirc.d
    # And now install to the final $PKGDIR.
    cp -av ./* "$PKGDIR"/
fi

abinfo "Making a symlink from libGLX_mesa to libGLX_indirect ..."
ln -sv libGLX_mesa.so.0 \
    "$PKGDIR"/usr/lib/libGLX_indirect.so.0
