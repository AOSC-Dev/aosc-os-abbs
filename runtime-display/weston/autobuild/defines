PKGNAME=weston
PKGSEC=misc
PKGDEP="poppler glu mtdev libinput libunwind pango colord wayland freerdp \
        pipewire xwayland seatd libdisplay-info neatvnc xcb-util-cursor \
        lua-5.4 pixman libxkbcommon libevdev libdrm lcms2 vulkan systemd"
BUILDDEP="wayland-protocols glslang"
PKGDES="Basic Wayland compositor"

ABTYPE=meson
MESON_AFTER=(
    '-Dbackend-drm=true'
    '-Dbackend-headless=true'
    '-Dbackend-pipewire=true'
    '-Dbackend-rdp=true'
    '-Dbackend-vnc=true'
    '-Dbackend-wayland=true'
    '-Dbackend-x11=true'
    '-Dbackend-default=drm'
    '-Drenderer-gl=true'
    '-Drenderer-vulkan=true'
    '-Dxwayland=true'
    '-Dsystemd=true'
    '-Ddeprecated-remoting=false'
    '-Ddeprecated-pipewire=false'
    '-Dshell-desktop=true'
    '-Dshell-ivi=true'
    '-Dshell-kiosk=true'
    '-Dshell-lua=true'
    '-Ddeprecated-xdg-shell-v6-unstable=false'
    '-Dcolor-management-lcms=true'
    '-Dimage-jpeg=true'
    '-Dimage-webp=true'
    '-Dtools=calibrator,debug,info,terminal,touch-calibrator'
    '-Ddemo-clients=true'
    '-Dsimple-clients=all'
    '-Dresize-pool=true'
    '-Dtests=false'
    '-Dtest-junit-xml=false'
    '-Ddoc=false'
    '-Dperfetto=false'
    '-Dallow-deprecated-modeset=false'
)
