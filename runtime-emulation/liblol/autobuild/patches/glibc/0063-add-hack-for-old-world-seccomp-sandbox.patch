-#undef __NR_newfstatat
diff --git a/sysdeps/unix/sysv/linux/loongarch/lp64/arch-syscall.h b/sysdeps/unix/sysv/linux/loongarch/lp64/arch-syscall.h
index f7294acaad..121a148803 100644
--- a/sysdeps/unix/sysv/linux/loongarch/lp64/arch-syscall.h
+++ b/sysdeps/unix/sysv/linux/loongarch/lp64/arch-syscall.h
@@ -61,6 +61,7 @@
 #define __NR_fsmount 432
 #define __NR_fsopen 430
 #define __NR_fspick 433
+#define __NR_fstat 80
 #define __NR_fstatfs 44
 #define __NR_fsync 82
 #define __NR_ftruncate 46
@@ -172,6 +173,7 @@
 #define __NR_munmap 215
 #define __NR_name_to_handle_at 264
 #define __NR_nanosleep 101
+#define __NR_newfstatat 79
 #define __NR_nfsservctl 42
 #define __NR_open_by_handle_at 265
 #define __NR_open_tree 428
diff --git a/sysdeps/unix/sysv/linux/loongarch/lp64/kernel-features.h b/sysdeps/unix/sysv/linux/loongarch/lp64/kernel-features.h
new file mode 100644
index 0000000000..a4c343cf31
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/loongarch/lp64/kernel-features.h
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include_next <kernel-features.h>
+
+/* Allow falling back to syscalls "easier to audit" for statx() itself.  */
+#undef __ASSUME_STATX
