PKGNAME=mbedtls
PKGSEC=libs
PKGDEP="glibc"
PKGDES="Portable cryptographic and SSL/TLS library"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DDISABLE_PACKAGE_CONFIG_AND_INS=OFF'
    '-DENABLE_PROGRAMS=ON'
    '-DENABLE_TESTING=OFF'
    '-DGEN_FILES=OFF'
    '-DINSTALL_MBEDTLS_HEADERS=ON'
    '-DLINK_WITH_PTHREAD=OFF'
    '-DLINK_WITH_TRUSTED_STORAGE=OFF'
    '-DUSE_SHARED_MBEDTLS_LIBRARY=ON'
    '-DUSE_STATIC_MBEDTLS_LIBRARY=ON'
)

NOSTATIC=0
NOSTATIC__RETRO=1

PKGBREAK="bctoolbox<=0.6.0-4 belle-sip<=1.6.3-4 bzrtp<=1.0.6-4 dislocker<=0.7.3-2 \
          dolphin-emu<=1:2509-4 julia<=1.1.0-2 godot<=4.7 imhex<=1.38.1 \
          ncbi-vdb<=3.0.2-1 nng<=1.10.1-1 obs-studio<=32.1.2 openrgb<=0.9-1 \
          pkcs11-helper<=1.30.0-1 shadowsocks-libev<=3.3.6 thedarkmod<=2.06-1"
