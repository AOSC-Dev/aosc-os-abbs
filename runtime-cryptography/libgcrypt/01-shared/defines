PKGNAME=libgcrypt
PKGDES="General purpose cryptographic library based on the code from GnuPG"
PKGDEP="libgpg-error"
PKGSEC=libs
ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--disable-padlock-support'
    '--without-capabilities'
    '--enable-static'
)
AUTOTOOLS_AFTER__ARMV7HF=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-neon-support'
    '--disable-arm-crypto-support'
    '--disable-sve-support'
    '--disable-sve2-support'
)
AUTOTOOLS_AFTER__POWERPC=(
    "${AUTOTOOLS_AFTER[@]}"
    # Note: Only available since Power ISA v2.07 (Power8).
    '--disable-ppc-crypto-support'
)
AUTOTOOLS_AFTER__PPC64=(
    "${AUTOTOOLS_AFTER[@]}"
    # Note: Only available since Power ISA v2.07 (Power8).
    '--disable-ppc-crypto-support'
)

# FIXME: Broken conditional compilation?
#
# lto1: error: '-mvsx' and '-mno-altivec' are incompatible
# lto1: error: '-mno-vsx' turns off '-mcrypto'
# lto-wrapper: fatal error: gcc returned 1 exit status
# compilation terminated.
NOLTO__POWERPC=1

# FIXME: lto1: fatal error: target specific builtin not available
NOLTO__RISCV64=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
