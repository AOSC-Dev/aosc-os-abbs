abinfo "Configuring botan-2 ..."
"$SRCDIR"/configure.py --prefix=/usr \
               --with-bzip \
               --with-lzma \
               --with-zlib \
               --with-os-feature=getrandom \
               --with-rst2man

abinfo "Building botan-2 ..."
make

abinfo "Installing botan-2 ..."
make install DESTDIR="$PKGDIR"
