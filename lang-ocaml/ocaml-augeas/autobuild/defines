PKGNAME=ocaml-augeas
PKGSEC=ocaml
PKGDEP="augeas"
BUILDDEP="ocaml findlib"
PKGDES="OCaml bindings for Augeas configuration API"

ABTYPE=autotools
MAKE_AFTER="OCAMLFIND_DESTDIR=$PKGDIR/usr/lib/ocaml"

# FIXME: make: *** No rule to make target 'augeas-c.o', needed by 'mlaugeas.cma'.  Stop.
ABSHADOW=0

# NOTE: Used for libguestfs.
# 
# /usr/bin/ld: cannot find /usr/lib/ocaml/augeas/mlaugeas.a: No such file or directory
NOSTATIC=0

# FIXME:
# File "test_augeas.ml", line 24, characters 18-24:
# 24 | let flags = [ Augeas.AugSaveBackup ] in
# ^^^^^^
# Error: Unbound module Augeas 
NOPARALLEL=1

# FIXME: ocamlfind: Not supported in your configuration: ocamlopt
FAIL_ARCH="!(amd64|arm64|ppc64el|riscv64)"
