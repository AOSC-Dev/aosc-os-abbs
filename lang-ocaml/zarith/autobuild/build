abinfo "Setting build flags ..."
# FIXME: ocamlmklib rejects raw -Wl,... flags; it only accepts -Wl,-rpath,...
unset LDFLAGS

abinfo "Building zarith ..."
cd "$SRCDIR"
./configure -installdir "$PKGDIR"/usr/lib/ocaml
make

abinfo "Installing zarith ..."
mkdir -p "$PKGDIR"/usr/lib/ocaml
make install INSTALLDIR="$PKGDIR/usr/lib/ocaml"
