abinfo "Building openclcapsviewer GUI ..."
qmake-qt6 DEFINES+=X11 OpenCLCapsViewer.pro
make "${MAKE_DEF[@]}" "${MAKE_AFTER[@]}"

abinfo "Installing openclcapsviewer GUI ..."
install -Dvm755 "$SRCDIR/OpenCLCapsViewer" "$PKGDIR/usr/bin/OpenCLCapsViewer"

abinfo "Building openclcapsviewer CLI ..."
qmake-qt6 OpenCLCapsViewerCLI.pro
make "${MAKE_DEF[@]}" "${MAKE_AFTER[@]}"

abinfo "Installing openclcapsviewer CLI ..."
install -Dvm755 "$SRCDIR/OpenCLCapsViewer" "$PKGDIR/usr/bin/OpenCLCapsViewerCLI"

abinfo "Installing openclcapsviewer icon ..."
install -Dvm644 "$SRCDIR/Resources/icon.png" "$PKGDIR/usr/share/icons/hicolor/256x256/apps/openclcapsviewer.png"
