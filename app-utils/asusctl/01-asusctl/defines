PKGNAME=asusctl
PKGDES="Utilities for ASUS gaming devices"
PKGSEC=utils
PKGDEP="fontconfig gcc-runtime glibc libusb systemd"
BUILDDEP="rustc llvm gettext"
ABTYPE=rust
CARGO_AFTER=(
    '-p' 'asusctl'
    '-p' 'asusd'
    '-p' 'asusd-user'
    '-p' 'asus-shutdown'
    '-p' 'rog-control-center'
    '-F' 'rog-control-center/x11'
)
FAIL_ARCH="!(amd64)"
