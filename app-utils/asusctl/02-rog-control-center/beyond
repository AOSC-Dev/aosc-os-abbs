APP_ID="org.opengamingcollective.rog-control-center"

abinfo "Installing desktop entry..."
install -Dvm644 "$SRCDIR/rog-control-center/data/$APP_ID.desktop" \
    "$PKGDIR/usr/share/applications/$APP_ID.desktop"

abinfo "Installing icon..."
install -Dvm644 "$SRCDIR/rog-control-center/data/rog-control-center.png" \
    "$PKGDIR/usr/share/icons/hicolor/512x512/apps/rog-control-center.png"

abinfo "Installing AppStream metainfo..."
install -Dvm644 "$SRCDIR/rog-control-center/data/$APP_ID.metainfo.xml" \
    "$PKGDIR/usr/share/metainfo/$APP_ID.metainfo.xml"

abinfo "Installing aura keyboard layouts..."
find "$SRCDIR/rog-aura/data/layouts" -type f -name '*.ron' \
    -exec install -Dvm644 "{}" -t "$PKGDIR/usr/share/rog-gui/layouts" ';'

abinfo "Installing notification icons..."
install -Dvm644 -t "$PKGDIR/usr/share/icons/hicolor/512x512/apps" \
    "$SRCDIR"/data/icons/asus_notif_*.png

abinfo "Installing status icons..."
install -Dvm644 -t "$PKGDIR/usr/share/icons/hicolor/scalable/status" \
    "$SRCDIR/data/icons/scalable/gpu-compute.svg" \
    "$SRCDIR/data/icons/scalable/gpu-hybrid.svg" \
    "$SRCDIR/data/icons/scalable/gpu-integrated.svg" \
    "$SRCDIR/data/icons/scalable/gpu-nvidia.svg" \
    "$SRCDIR/data/icons/scalable/gpu-vfio.svg" \
    "$SRCDIR/data/icons/scalable/notification-reboot.svg"

abinfo "Installing translations..."
TRANSDIR="$(compgen -G \
    "$SRCDIR/target/release/build/rog-control-center-*/out/translations" \
    | head -n1)"
if [ -n "$TRANSDIR" ]; then
    while IFS= read -r -d '' mo; do
        install -Dvm644 "$mo" \
            "$PKGDIR/usr/share/locale/${mo#"$TRANSDIR"/}"
    done < <(find "$TRANSDIR" -type f -name 'rog-control-center.mo' -print0)
else
    abwarn "No compiled translations found, skipping locale install."
fi
