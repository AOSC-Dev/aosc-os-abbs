Subject: [PATCH 1/2] install binary to bin instead of sbin

---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index ac9b134..6ff285b 100644
--- a/Makefile
+++ b/Makefile
@@ -40,7 +40,7 @@ CFLAGS+=-fanalyzer
 endif
 
 PREFIX?=$(DESTDIR)/usr
-BINDIR?=$(PREFIX)/sbin
+BINDIR?=$(PREFIX)/bin
 INSTALL?=install
 STRIP?=strip
 
