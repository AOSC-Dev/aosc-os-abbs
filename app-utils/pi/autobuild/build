abinfo "Installing nodejs devDependencies..."
npm ci --ignore-scripts 

abinfo "Building Pi..."
npm run build

abinfo "Minifying nodejs dependencies..."
rm -rv "${SRCDIR}"/node_modules
npm ci --omit=dev --omit=peer --ignore-scripts 

abinfo "Installing Pi..."
install -dvm755 "${PKGDIR}"/usr/lib/pi
cp -av "${SRCDIR}"/node_modules "${PKGDIR}"/usr/lib/pi/node_modules
# Note: Copy all necessary files for all packages except coding-agent
for i in ai agent tui; do
    install -dvm755 "${PKGDIR}"/usr/lib/pi/packages/$i
    cp -av "${SRCDIR}"/packages/$i/dist "${PKGDIR}"/usr/lib/pi/packages/$i/
    cp -av "${SRCDIR}"/packages/$i/package.json  "${PKGDIR}"/usr/lib/pi/packages/$i/
    cp -av "${SRCDIR}"/packages/$i/README.md  "${PKGDIR}"/usr/lib/pi/packages/$i/
  done
# Note: Copy all necessary files for coding-agent as it also includes docs and examples and CHANGELOG.md
install -dvm755 "${PKGDIR}"/usr/lib/pi/packages/coding-agent
cp -av "${SRCDIR}"/packages/coding-agent/dist "${SRCDIR}"/packages/coding-agent/docs "${SRCDIR}"/packages/coding-agent/examples \
    "${SRCDIR}"/packages/coding-agent/package.json "${SRCDIR}"/packages/coding-agent/README.md "${SRCDIR}"/packages/coding-agent/CHANGELOG.md \
    "${PKGDIR}"/usr/lib/pi/packages/coding-agent/
install -dvm755 "${PKGDIR}"/usr/bin
ln -sv "../lib/pi/packages/coding-agent/dist/cli.js" "${PKGDIR}/usr/bin/pi-agent"
