From 9beb5be7bc53c34d4ce8e8f66b5560af129a25e2 Mon Sep 17 00:00:00 2001
From: Qing Yun <kf@aosc.io>
Date: Thu, 30 Jul 2026 01:01:01 +0800
Subject: [PATCH] AOSCOS: remove first run dialog

---
 data/io.missioncenter.MissionCenter.gschema.xml |  2 +-
 resources/ui/window.blp                         |  5 -----
 src/application.rs                              |  4 ----
 src/window.rs                                   | 12 ------------
 4 files changed, 1 insertion(+), 22 deletions(-)

diff --git a/data/io.missioncenter.MissionCenter.gschema.xml b/data/io.missioncenter.MissionCenter.gschema.xml
index 2b432b5..983242b 100644
--- a/data/io.missioncenter.MissionCenter.gschema.xml
+++ b/data/io.missioncenter.MissionCenter.gschema.xml
@@ -298,7 +298,7 @@
         </key>
 
         <key name="first-time-running" type="b">
-            <default>true</default>
+            <default>false</default>
             <summary>If it's your first time running Mission Center</summary>
         </key>
     </schema>
diff --git a/resources/ui/window.blp b/resources/ui/window.blp
index 760a570..b53818b 100644
--- a/resources/ui/window.blp
+++ b/resources/ui/window.blp
@@ -254,11 +254,6 @@ menu primary_menu {
             verb-icon: "external-link-symbolic";
             action: "app.open-wiki";
         }
-
-        item {
-            label: _("Show _First Run Dialog");
-            action: "app.first-run-dialog";
-        }
     }
 
     section {
diff --git a/src/application.rs b/src/application.rs
index ef8c5cc..137c510 100644
--- a/src/application.rs
+++ b/src/application.rs
@@ -433,9 +433,6 @@ impl MissionCenterApplication {
                 });
             })
             .build();
-        let first_run_dialog_action = gio::ActionEntry::builder("first-run-dialog")
-            .activate(move |app: &Self, _, _| app.show_first_run_dialog())
-            .build();
 
         self.add_action_entries([
             quit_action,
@@ -444,7 +441,6 @@ impl MissionCenterApplication {
             about_system_action,
             keyboard_shortcuts_action,
             open_wiki_action,
-            first_run_dialog_action,
         ]);
 
         self.set_accels_for_action("app.preferences", &["<Control>comma"]);
diff --git a/src/window.rs b/src/window.rs
index 099f6b3..46889f4 100644
--- a/src/window.rs
+++ b/src/window.rs
@@ -1218,18 +1218,6 @@ impl MissionCenterWindow {
                 "Failed to get sys_info from MissionCenterApplication"
             );
         }
-
-        if settings!().boolean("first-time-running") {
-            app!().show_first_run_dialog();
-            settings!()
-                .set_boolean("first-time-running", false)
-                .unwrap_or_else(|_| {
-                    g_critical!(
-                        "MissionCenter::Application",
-                        "Failed to save first-time-running setting"
-                    )
-                })
-        }
     }
 
     pub fn update_readings(&self, readings: &mut Readings) -> bool {
-- 
2.55.0

