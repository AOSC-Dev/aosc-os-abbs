PKGNAME=util-linux
PKGSEC=utils
PKGDES="Utilities and management tools for Linux (binaries)"
PKGDEP="coreutils file libcap-ng libutempter linux-pam python-3 slang \
        systemd util-linux-runtime zlib"
PKGDEP__RETRO="${PKGDEP/python-3/}"

PKGPROV="util-linux"
PKGREP="util-linux<=2.39.3-2"
PKGBREAK="util-linux<=2.39.3-2"

ABTYPE=self

PKGESS=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
