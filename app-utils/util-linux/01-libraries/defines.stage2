PKGNAME=util-linux-runtime
PKGSEC=utils
PKGDES="Utilities and management tools for Linux (runtime libraries)"
PKGDEP="glibc"
BUILDDEP="coreutils"

AUTOTOOLS_AFTER=(
    '--localstatedir=/run'
    '--enable-fs-paths-extra=/usr/bin'
    '--disable-chfn-chsh'
    '--disable-login'
    '--disable-nologin'
    '--disable-su'
    '--disable-newgrp'
    '--enable-write'
    '--enable-mesg'
    '--without-python'
)
