# FIXME: Go cgo uses -marm for generated wrappers,
# -mthumb can cause runtime crashes.
#
# https://github.com/golang/go/blob/840c8327132051c7ef099b069c5b0861638170b5/src/cmd/cgo/gcc.go#L1771
if ab_match_arch armv7hf ; then
	abinfo "Disabling Thumb ..."
	export CFLAGS="${CFLAGS/-mthumb/} -marm"
	export CXXFLAGS="${CXXFLAGS/-mthumb/} -marm"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXLAGS}"
fi
