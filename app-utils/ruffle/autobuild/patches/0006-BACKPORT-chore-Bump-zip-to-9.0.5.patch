From 30cd2ac6c5608332745118e77c8d8a2549d0ddde Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?T=C3=96R=C3=96K=20Attila?= <torokati44@gmail.com>
Date: Wed, 21 Oct 2026 23:20:57 +0200
Subject: [PATCH 6/6] BACKPORT: chore: Bump zip to 9.0.5

---
 Cargo.lock                              | 5 +++--
 Cargo.toml                              | 2 +-
 frontend-utils/src/bundle/exporter.rs   | 4 ++--
 frontend-utils/src/bundle/source/zip.rs | 3 ++-
 4 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 2150895ec..109b2723c 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -7877,14 +7877,15 @@ dependencies = [
 
 [[package]]
 name = "zip"
-version = "8.6.0"
+version = "9.0.5"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "2d04a6b5381502aa6087c94c669499eb1602eb9c5e8198e534de571f7154809b"
+checksum = "6e04976da629d3b04204ba8105b396a193af8ad2583b2c79bfb3ab8af580a11e"
 dependencies = [
  "crc32fast",
  "flate2",
  "indexmap",
  "memchr",
+ "nix",
  "typed-path",
  "zopfli",
 ]
diff --git a/Cargo.toml b/Cargo.toml
index 5f492ffea..092f974e4 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -54,7 +54,7 @@ version = "0.7.1"
 rand = { version = "0.10.1", default-features = false }
 png = "0.18.1"
 proc-macro2 = "1.0.106"
-zip = { version = "8.6.0", default-features = false }
+zip = { version = "9.0.5", default-features = false }
 quote = "1.0.45"
 tracing = "0.1.43"
 tracing-subscriber = { version = "0.3.23", features = ["env-filter"] }
diff --git a/frontend-utils/src/bundle/exporter.rs b/frontend-utils/src/bundle/exporter.rs
index 412d57f6e..be4476684 100644
--- a/frontend-utils/src/bundle/exporter.rs
+++ b/frontend-utils/src/bundle/exporter.rs
@@ -43,7 +43,7 @@ impl<W: Write + Seek> BundleExporter<W> {
         path: P,
         content: &mut R,
     ) -> BundleExportResult<()> {
-        let options: FileOptions<'_, ()> = FileOptions::default();
+        let options: FileOptions<'_, '_, ()> = FileOptions::default();
 
         self.writer
             .start_file_from_path(Path::new("content").join(path), options)?;
@@ -60,7 +60,7 @@ impl<W: Write + Seek> BundleExporter<W> {
     }
 
     fn write_info(&mut self) -> BundleExportResult<()> {
-        let options: FileOptions<'_, ()> = FileOptions::default();
+        let options: FileOptions<'_, '_, ()> = FileOptions::default();
 
         self.writer
             .start_file_from_path(Path::new(BUNDLE_INFORMATION_FILENAME), options)?;
diff --git a/frontend-utils/src/bundle/source/zip.rs b/frontend-utils/src/bundle/source/zip.rs
index 6f133a566..9c83c5fef 100644
--- a/frontend-utils/src/bundle/source/zip.rs
+++ b/frontend-utils/src/bundle/source/zip.rs
@@ -43,7 +43,8 @@ impl<R: Read + Seek> ZipSource<R> {
         self.0
             .borrow()
             .file_names()
-            .map(ToOwned::to_owned)
+            .flatten()
+            .map(String::from)
             .collect()
     }
 }
