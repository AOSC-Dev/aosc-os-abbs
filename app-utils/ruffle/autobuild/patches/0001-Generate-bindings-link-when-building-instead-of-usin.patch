From a589975a47370ca39c033174d3eb39f18c3b21bc Mon Sep 17 00:00:00 2001
From: RawDiamondMC <RawDiamondMC@aosc.io>
Date: Sun, 21 Jun 2026 14:37:06 +0800
Subject: [PATCH 1/2] Generate bindings & link when building instead of using
 dl_open

Signed-off-by: RawDiamondMC <RawDiamondMC@aosc.io>
---
 Cargo.lock                             |  1 +
 video/external/Cargo.toml              |  3 +++
 video/external/build.rs                | 10 ++++++++++
 video/external/src/decoder/openh264.rs | 21 ++++-----------------
 4 files changed, 18 insertions(+), 17 deletions(-)
 create mode 100644 video/external/build.rs

diff --git a/Cargo.lock b/Cargo.lock
index 235dff114..9f9e1a127 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5015,6 +5015,7 @@ dependencies = [
 name = "ruffle_video_external"
 version = "0.5.0"
 dependencies = [
+ "bindgen",
  "bzip2",
  "hex",
  "js-sys",
diff --git a/video/external/Cargo.toml b/video/external/Cargo.toml
index 8b3aa4750..c936af0ff 100644
--- a/video/external/Cargo.toml
+++ b/video/external/Cargo.toml
@@ -30,6 +30,9 @@ wasm-bindgen = { workspace = true, optional = true }
 tracing-subscriber = { workspace = true, features = ["registry"], optional = true }
 tracing-wasm = { workspace = true, optional = true }
 
+[build-dependencies]
+bindgen = "0.72.1"
+
 [dependencies.web-sys]
 workspace = true
 optional = true
diff --git a/video/external/build.rs b/video/external/build.rs
new file mode 100644
index 000000000..9ad0ad489
--- /dev/null
+++ b/video/external/build.rs
@@ -0,0 +1,10 @@
+fn main() {
+    println!("cargo::rustc-link-lib=openh264");
+    bindgen::Builder::default()
+            .header("/usr/include/wels/codec_api.h")
+            .prepend_enum_name(false)
+            .generate()
+            .expect("Unable to generate bindings")
+            .write_to_file("./src/decoder/openh264_sys.rs")
+            .expect("Failed to write bindings to file");
+}
diff --git a/video/external/src/decoder/openh264.rs b/video/external/src/decoder/openh264.rs
index 2231209a2..0dacf862f 100644
--- a/video/external/src/decoder/openh264.rs
+++ b/video/external/src/decoder/openh264.rs
@@ -8,7 +8,7 @@ use std::ptr;
 use std::sync::Arc;
 
 use crate::decoder::VideoDecoder;
-use crate::decoder::openh264_sys::{self, ISVCDecoder, OpenH264, videoFormatI420};
+use crate::decoder::openh264_sys::{self, ISVCDecoder, videoFormatI420};
 
 use ruffle_render::bitmap::BitmapFormat;
 use ruffle_video::error::Error;
@@ -39,7 +39,6 @@ pub enum OpenH264Error {
 
 /// OpenH264 codec representation.
 pub struct OpenH264Codec {
-    openh264: Arc<OpenH264>,
 }
 
 impl OpenH264Codec {
@@ -154,23 +153,14 @@ impl OpenH264Codec {
     where
         P: AsRef<::std::ffi::OsStr>,
     {
-        let openh264 = unsafe { OpenH264::new(filename)? };
-
-        let version = unsafe { openh264.WelsGetCodecVersion() };
-        let version = OpenH264Version(version.uMajor, version.uMinor, version.uRevision);
-
-        if Self::VERSION != version {
-            return Err(OpenH264Error::VersionMismatchError(Self::VERSION, version));
-        }
-
         Ok(Self {
-            openh264: Arc::new(openh264),
         })
     }
 
     /// Loads the OpenH264 library - first trying one installed on the system (on supported platforms),
     /// then falling back to a local file in `directory`, downloading it into there if necessary.
     pub fn load(directory: &Path) -> Result<Self, Box<dyn std::error::Error>> {
+        return Ok(Self {});
         let openh264_data = Self::get_data()?;
 
         for filename in openh264_data.local_filenames {
@@ -197,7 +187,6 @@ pub struct H264Decoder {
     /// How many bytes are used to store the length of the NALU (1, 2, 3, or 4).
     length_size: u8,
 
-    openh264: Arc<OpenH264>,
     decoder: *mut ISVCDecoder,
 }
 
@@ -209,10 +198,9 @@ struct OpenH264Data {
 
 impl H264Decoder {
     pub fn new(h264: &OpenH264Codec) -> Self {
-        let openh264 = h264.openh264.clone();
         let mut decoder: *mut ISVCDecoder = ptr::null_mut();
         unsafe {
-            openh264.WelsCreateDecoder(&mut decoder);
+            openh264_sys::WelsCreateDecoder(&mut decoder);
 
             let decoder_vtbl = (*decoder).as_ref().unwrap();
 
@@ -223,7 +211,6 @@ impl H264Decoder {
 
             Self {
                 length_size: 0,
-                openh264,
                 decoder,
             }
         }
@@ -236,7 +223,7 @@ impl Drop for H264Decoder {
             let decoder_vtbl = (*self.decoder).as_ref().unwrap();
 
             (decoder_vtbl.Uninitialize.unwrap())(self.decoder);
-            self.openh264.WelsDestroyDecoder(self.decoder);
+            openh264_sys::WelsDestroyDecoder(self.decoder);
         }
     }
 }
-- 
