Subject: [PATCH 3/4] AOSCOS: add zh_CN and zh_TW translations for oma

Signed-off-by: Kaiyang Wu <origincode@aosc.io>
---
 po/zh_CN.po | 10 +++++++++-
 po/zh_TW.po | 10 +++++++++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/po/zh_CN.po b/po/zh_CN.po
index 321e443f..2832a05d 100644
--- a/po/zh_CN.po
+++ b/po/zh_CN.po
@@ -178,7 +178,7 @@ msgid "Delete the backup files"
 msgstr "删除备份文件"
 
 #: ../cleaners/apt.xml ../cleaners/dnf.xml ../cleaners/pacman.xml
-#: ../cleaners/snap.xml ../cleaners/yum.xml
+#: ../cleaners/snap.xml ../cleaners/yum.xml ../cleaner/oma.yml
 msgid "Package manager"
 msgstr "包管理器"
 
@@ -686,6 +686,14 @@ msgstr "清空“最近使用”列表"
 msgid "Custom folders will be reset."
 msgstr "将重置自定义文件夹。"
 
+#: ../cleaners/oma.xml
+msgid "Package cache"
+msgstr "软件包缓存"
+
+#: ../cleaners/oma.xml
+msgid "Delete system package cache"
+msgstr "删除系统软件包缓存"
+
 #: ../cleaners/profanity.xml
 msgid "Downloaded files"
 msgstr "已下载的文件"
diff --git a/po/zh_TW.po b/po/zh_TW.po
index 21afcec4..247f9baa 100644
--- a/po/zh_TW.po
+++ b/po/zh_TW.po
@@ -177,7 +177,7 @@ msgid "Delete the backup files"
 msgstr "刪除備份檔案"
 
 #: ../cleaners/apt.xml ../cleaners/dnf.xml ../cleaners/pacman.xml
-#: ../cleaners/snap.xml ../cleaners/yum.xml
+#: ../cleaners/snap.xml ../cleaners/yum.xml ../cleaners/oma.xml
 msgid "Package manager"
 msgstr "軟體包管理員"
 
@@ -683,6 +683,14 @@ msgstr "刪除最近使用檔案清單"
 msgid "Custom folders will be reset."
 msgstr "自訂資料夾將被重置。"
 
+#: ../cleaners/oma.xml
+msgid "Package cache"
+msgstr "軟體包快取"
+
+#: ../cleaners/oma.xml
+msgid "Delete system package cache"
+msgstr "刪除系統軟體包快取"
+
 #: ../cleaners/profanity.xml
 msgid "Downloaded files"
 msgstr "已下載的檔案"
