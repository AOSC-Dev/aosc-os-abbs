Signed-off-by: Kaiyang Wu <origincode@aosc.io>
---
 po/zh_CN.po | 10 +++++++++-
 po/zh_TW.po | 10 +++++++++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/po/zh_CN.po b/po/zh_CN.po
index 41d9b200..51e4a122 100644
--- a/po/zh_CN.po
+++ b/po/zh_CN.po
@@ -172,7 +172,7 @@ msgid "Delete the most recently used list"
 msgstr "清空“最近使用”列表"
 
 #: ../cleaners/dnf.xml ../cleaners/yum.xml ../cleaners/pacman.xml
-#: ../cleaners/apt.xml ../cleaners/snap.xml
+#: ../cleaners/apt.xml ../cleaners/snap.xml ../cleaner/oma.xml
 msgid "Package manager"
 msgstr "包管理器"
 
@@ -186,6 +186,14 @@ msgid ""
 "list autoremove\"."
 msgstr "运行“dnf list automemove”以检查将被删除的详细软件包列表。"
 
+#: ../cleaners/oma.xml
+msgid "Package cache"
+msgstr "软件包缓存"
+
+#: ../cleaners/oma.xml
+msgid "Delete system package cache"
+msgstr "删除系统软件包缓存"
+
 #: ../cleaners/amsn.xml ../cleaners/yahoo_messenger.xml ../cleaners/pidgin.xml
 #: ../cleaners/emesene.xml ../cleaners/slack.xml ../cleaners/hexchat.xml
 #: ../cleaners/zoom.xml ../cleaners/skype.xml ../cleaners/profanity.xml
diff --git a/po/zh_TW.po b/po/zh_TW.po
index 2697eb6f..06774b83 100644
--- a/po/zh_TW.po
+++ b/po/zh_TW.po
@@ -171,7 +171,7 @@ msgid "Delete the most recently used list"
 msgstr "刪除最近使用檔案清單"
 
 #: ../cleaners/dnf.xml ../cleaners/yum.xml ../cleaners/pacman.xml
-#: ../cleaners/apt.xml ../cleaners/snap.xml
+#: ../cleaners/apt.xml ../cleaners/snap.xml ../cleaners/oma.xml
 msgid "Package manager"
 msgstr "軟體包管理員"
 
@@ -185,6 +185,14 @@ msgid ""
 "list autoremove\"."
 msgstr "請仔細檢查所列的軟體包；之後將執行「dnf list autoremove」移除它們。"
 
+#: ../cleaners/oma.xml
+msgid "Package cache"
+msgstr "軟體包快取"
+
+#: ../cleaners/oma.xml
+msgid "Delete system package cache"
+msgstr "刪除系統軟體包快取"
+
 #: ../cleaners/amsn.xml ../cleaners/yahoo_messenger.xml ../cleaners/pidgin.xml
 #: ../cleaners/emesene.xml ../cleaners/slack.xml ../cleaners/hexchat.xml
 #: ../cleaners/zoom.xml ../cleaners/skype.xml ../cleaners/profanity.xml
