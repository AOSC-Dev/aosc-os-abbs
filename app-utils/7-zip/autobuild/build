abinfo "Building 7-zip ..."
for component in Bundles/{Alone,Alone2,Alone7z,Format7zF,LzmaCon,SFXCon} UI/{Console,Client7z}; do
    abinfo "Building component $component ..."
    make -C "$SRCDIR"/CPP/7zip/$component -f "$SRCDIR"/CPP/7zip/cmpl_gcc${ARCH_SUFFIX}.mak
done

abinfo "Installing 7-zip ..."
install -v -Dm755 \
    "${SRCDIR}/CPP/7zip/Bundles/Alone/b/g${ARCH_SUFFIX}/7za" \
    "${SRCDIR}/CPP/7zip/Bundles/Alone2/b/g${ARCH_SUFFIX}/7zz" \
    "${SRCDIR}/CPP/7zip/Bundles/Alone7z/b/g${ARCH_SUFFIX}/7zr" \
    "${SRCDIR}/CPP/7zip/Bundles/Format7zF/b/g${ARCH_SUFFIX}/7z.so" \
    "${SRCDIR}/CPP/7zip/Bundles/LzmaCon/b/g${ARCH_SUFFIX}/lzma" \
    "${SRCDIR}/CPP/7zip/Bundles/SFXCon/b/g${ARCH_SUFFIX}/7zCon" \
    "${SRCDIR}/CPP/7zip/UI/Console/b/g${ARCH_SUFFIX}/7z" \
    "${SRCDIR}/CPP/7zip/UI/Client7z/b/g${ARCH_SUFFIX}/7zcl" \
    -t "$PKGDIR"/usr/lib/7-zip/
install -v -Dm644 "${SRCDIR}/DOC/"* -t "${PKGDIR}/usr/share/doc/${PKGNAME}"

abinfo "Creating symlink ..."
mkdir -p "$PKGDIR"/usr/bin/
ln -sv ../lib/7-zip/7z "$PKGDIR"/usr/bin/7z
ln -sv ../lib/7-zip/7za "$PKGDIR"/usr/bin/7za
ln -sv ../lib/7-zip/7zr "$PKGDIR"/usr/bin/7zr
ln -sv ../lib/7-zip/7zz "$PKGDIR"/usr/bin/7zz
