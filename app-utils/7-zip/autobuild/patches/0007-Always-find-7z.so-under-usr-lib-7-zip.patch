From 829f088a55e5a1d96379d454821e1a2ad3e5b077 Mon Sep 17 00:00:00 2001
From: RawDiamondMC <RawDiamondMC@aosc.io>
Date: Wed, 29 Jul 2026 12:59:19 +0800
Subject: [PATCH 7/8] Always find 7z.so under /usr/lib/7-zip

Signed-off-by: RawDiamondMC <RawDiamondMC@aosc.io>
---
 CPP/7zip/UI/Common/ArchiveCommandLine.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/CPP/7zip/UI/Common/ArchiveCommandLine.cpp b/CPP/7zip/UI/Common/ArchiveCommandLine.cpp
index f273870..62590cc 100644
--- a/CPP/7zip/UI/Common/ArchiveCommandLine.cpp
+++ b/CPP/7zip/UI/Common/ArchiveCommandLine.cpp
@@ -1894,8 +1894,13 @@ FString GetModuleDirPrefix()
   FString s;
 
   s = fas2fs(g_ModuleDirPrefix);
-  if (s.IsEmpty())
-    s = FTEXT(".") FSTRING_PATH_SEPARATOR;
+  // AOSCOS: Hardcode the 7z.so location to fix errors.
+  // The original logic is to find 7z location by args[0] and append
+  // 7z.so after that, which will cause errors if `7z` is a symlink.
+  // `Codec Load Error: E_FAIL: Unspecified error`
+  // On AOSC OS, 7z.so will be installed under /usr/lib/7-zip/7z.so .
+  // So ignore the args[0] and pin the location
+  s = FTEXT("/usr/lib/7-zip") FSTRING_PATH_SEPARATOR;
   return s;
   /*
   setenv("_7ZIP_HOME_DIR", "/test/", 0);
-- 
