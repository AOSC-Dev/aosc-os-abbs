abinfo "Building the satty program ..."
cargo build --frozen --release --all-features

abinfo "Installing the satty program ..."
install -Dvm755 "$SRCDIR"/target/release/satty \
	"$PKGDIR"/usr/bin/satty

install -vDm644 "$SRCDIR"/completions/_satty \
	"$PKGDIR"/usr/share/zsh/site-functions/_satty
install -vDm644 "$SRCDIR"/completions/satty.bash \
	"$PKGDIR"/usr/share/bash-completion/completions/satty
install -vDm644 "$SRCDIR"/completions/satty.fish \
	"$PKGDIR"/usr/share/fish/vendor_completions.d/satty.fish
install -vDm644 "$SRCDIR"/completions/satty.nu \
	"$PKGDIR"/usr/share/nushell/completions/satty.nu
install -vDm644 "$SRCDIR"/completions/satty.elv \
	"$PKGDIR"/usr/share/elvish/lib/satty.elv

install -vDm644 -t "$PKGDIR"/usr/share/applications/satty.desktop "$SRCDIR"/satty.desktop
install -vDm644 -t "$PKGDIR"/usr/share/icons/hicolor/scalable/apps/satty.svg "$SRCDIR"/assets/satty.svg

install -vDm644 -t "$PKGDIR"/usr/share/doc/$pkgname "$SRCDIR"/README.md
cp -va -t "$PKGDIR"/usr/share/doc/$pkgname "$SRCDIR"/assets
