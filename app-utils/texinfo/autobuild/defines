PKGNAME=texinfo
PKGDES='Utilities to view and generate "info" documentations'
# FIXME: DPKG trigger produces an error due to dependency loop
#        Dropping all dependencies, and hoping for the best
# dpkg: cycle found while processing triggers:
#  chain of packages whose triggers are or may be responsible:
#   texinfo -> texinfo
#  packages' pending triggers which are or may be unresolvable:
#   texinfo: /usr/share/info
# dpkg: error processing package texinfo (--configure):
#  triggers looping, abandoned
# Errors were encountered while processing:
#  texinfo
PKGRECOM="glibc ncurses gzip perl findutils"
PKGSEC=utils

ABTYPE=autotools
# Note: Multi-level source tree.
#
# === configuring in tta ([...]/texinfo-7.3/abbuild/tta)
# [...]
# configure: error: unrecognized options: --enable-threads, --disable-multiplatform, --enable-perl-api-texi-build, --without-included-regex
# configure: error: [...]/texinfo-7.3/tta/configure failed for tta
AUTOTOOLS_STRICT=0
RECONF=0
AUTOTOOLS_AFTER=(
    '--enable-largefile'
    '--enable-threads=posix'
    '--disable-rpath'
    '--disable-multiplatform'
    '--enable-nls'
    '--enable-perl-xs'
    '--enable-xs-perl-libintl'
    '--enable-using-c-texi2any'
    '--enable-perl-api-texi-build'
    '--enable-year2038'

    # Note: All defaults to no.
    '--without-included-regex'
    '--without-external-Unicode-EastAsianWidth'
    '--without-external-Text-Unidecode'
    '--without-external-libintl-perl'
    '--without-swig'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
