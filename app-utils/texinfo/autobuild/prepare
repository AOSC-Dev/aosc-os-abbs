# Note: Taken from Debian's control/rules, without this, architectures
# with demands for explicit Y2038 and 64-bit file support would fail to
# build, due to missing C preprocessor definition.
abinfo "Applying compiler and linker flags to Perl modules ..."
export PERL_EXT_CFLAGS="${CFLAGS}"
export PERL_EXT_CPPFLAGS="${CPPFLAGS}"
export PERL_EXT_LDFLAGS="${LDFLAGS}"
