PKGNAME=file
PKGSEC=utils
PKGDEP="bzip2 libseccomp xz zlib"
PKGDEP__RETRO="bzip2 xz zlib"
BUILDDEP="setuptools"
BUILDDEP__RETRO=""
PKGDES="Utility to inspect file types"

AUTOTOOLS_AFTER=(
    '--enable-elf'
    '--enable-elf-core'
    '--enable-zlib'
    '--enable-bzlib'
    '--enable-xzlib'
    '--enable-libseccomp'
    '--enable-fsect-man5'
    '--enable-largefile'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-libseccomp'
)
