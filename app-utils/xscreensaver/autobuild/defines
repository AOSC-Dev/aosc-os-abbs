PKGNAME=xscreensaver
PKGSEC=x11
PKGDEP="gtk-3 glu"
PKGDEP__RETRO="${PKGDEP/gtk-3/motif}"
BUILDDEP="bc intltool"
PKGDES="Screensaver and locker for the X Window System"

AUTOTOOLS_AFTER__COMMON=(
    '--libexecdir=/usr/lib'
    '--with-pam'
    '--with-login-manager'
    '--with-gl'
    '--without-gle'
    '--with-jpeg'
)

AUTOTOOLS_AFTER=(
	"${AUTOTOOLS_AFTER__COMMON[@]}"
    '--with-gtk'
    '--with-pixbuf'
)

AUTOTOOLS_AFTER__RETRO=(
	"${AUTOTOOLS_AFTER__COMMON[@]}"
    '--with-motif'
    '--without-pixbuf'
)

MAKE_AFTER=(
	install_prefix="$PKGDIR"
	# Note: update icon cache at build time is unnecessary
	UPDATE_ICON_CACHE=/usr/bin/true
	# Note: required when installing systemd service, manually specify is required when building without GTK
	GTK_SHAREDIR=/usr/share/xscreensaver/
)

# FIXME: configure.ac:1171: error: possibly undefined macro: AM_GNU_GETTEXT
RECONF=0
# FIXME: xshadertoy-compile.pl: glsl/bestill0-0.glsl: No such file or directory
ABSHADOW=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
