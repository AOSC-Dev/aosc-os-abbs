PKGNAME=lz4
PKGSEC=libs
PKGDEP="glibc"
PKGDES="Utilities for the lz4 lossless data compression algorithm"

PKGEPOCH=1
AB_FLAGS_O3=1

# Note: -Dmemory-usage=0, "See LZ4_MEMORY_USAGE. 0 means use the LZ4 default."
MESON_AFTER="-Ddebug-level=1 \
             -Dunstable=false \
             -Dprograms=true \
             -Dcontrib=true \
             -Dexamples=true \
             -Dmemory-usage=0"

