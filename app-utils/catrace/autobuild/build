abinfo "Installing frontend dependencies ..."
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
pnpm install --frozen-lockfile

abinfo "Building Catrace ..."
cargo tauri build --no-bundle -- --locked

abinfo "Installing Catrace ..."
install -Dvm755 \
    "$SRCDIR"/src-tauri/target/release/catrace \
    "$PKGDIR"/usr/bin/catrace

abinfo "Installing application icon ..."
install -Dvm644 \
    "$SRCDIR"/src-tauri/icons/icon.png \
    "$PKGDIR"/usr/share/pixmaps/catrace.png

abinfo "Installing desktop entry ..."
install -Dvm644 \
    "$SRCDIR"/catrace.desktop \
    "$PKGDIR"/usr/share/applications/catrace.desktop
