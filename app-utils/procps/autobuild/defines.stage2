PKGNAME=procps
PKGSEC=utils
PKGDEP="ncurses"
BUILDDEP="po4a"
PKGDES="Utilities to manage system processes and resources"

PKGPROV="procps-ng"

# Note: --disable-kill, kill(1) is provided by util-linux.
AUTOTOOLS_AFTER=(
    '--exec-prefix=/'
    '--enable-largefile'
    '--enable-nls'
    '--disable-rpath'
    '--enable-watch8bit'
    '--disable-libselinux'
    '--enable-harden-flags'
    '--enable-pidof'
    '--disable-kill'
    '--enable-w'
    '--enable-skill'
    '--enable-examples'
    '--enable-sigwinch'
    '--enable-wide-percent'
    '--enable-wide-memory'
    '--enable-modern-top'
    '--enable-numa'
    '--enable-w-from'
    '--disable-whining'
    '--with-ncurses'
    '--without-systemd'
    '--without-elogind'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
