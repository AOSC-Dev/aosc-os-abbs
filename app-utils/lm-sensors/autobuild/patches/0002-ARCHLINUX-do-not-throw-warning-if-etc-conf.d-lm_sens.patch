From 829145848684e9a631fcb8c6eb287adbbc3623fb Mon Sep 17 00:00:00 2001
From: Xi Ruoyao <xry111@xry111.site>
Date: Fri, 27 Mar 2026 11:41:15 +0800
Subject: [PATCH 2/5] ARCHLINUX: do not throw warning if /etc/conf.d/lm_sensors
 does not exist

---
 prog/init/lm_sensors.service | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/prog/init/lm_sensors.service b/prog/init/lm_sensors.service
index a9b6c964..e7dbae26 100644
--- a/prog/init/lm_sensors.service
+++ b/prog/init/lm_sensors.service
@@ -11,7 +11,7 @@ ProtectKernelLogs=true
 ProtectControlGroups=true
 RestrictRealtime=true
 # end of automatic additions
-EnvironmentFile=/etc/conf.d/lm_sensors
+EnvironmentFile=-/etc/conf.d/lm_sensors
 Type=oneshot
 RemainAfterExit=yes
 ExecStart=-/sbin/modprobe -qab $BUS_MODULES $HWMON_MODULES
-- 
