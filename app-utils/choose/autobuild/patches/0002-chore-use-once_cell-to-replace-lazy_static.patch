From a919ca99ea038046dabdb41a707e8906fcf8363e Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Sat, 30 Mar 2024 12:04:58 +0800
Subject: [PATCH] chore: replace lazy_static with once_cell

---
 Cargo.lock   | 14 +++++++-------
 Cargo.toml   |  2 +-
 src/main.rs  |  3 ---
 src/parse.rs |  6 +++---
 4 files changed, 11 insertions(+), 14 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 486a673..87260cf 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -22,22 +22,22 @@ name = "choose"
 version = "1.3.7"
 dependencies = [
  "backslash",
- "lazy_static",
+ "once_cell",
  "regex",
 ]
 
-[[package]]
-name = "lazy_static"
-version = "1.5.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "bbd2bcb4c963f2ddae06a2efc7e9f3591312473c50c6685e1f298068316e66fe"
-
 [[package]]
 name = "memchr"
 version = "2.8.3"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "cf8baf1c55e62ffcace7a9f06f4bd9cd3f0c4beb022d3b367256b91b87513d98"
 
+[[package]]
+name = "once_cell"
+version = "1.21.4"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "9f7c3e4beb33f85d45ae3e3a1792185706c8e16d043238c593331cc7cd313b50"
+
 [[package]]
 name = "regex"
 version = "1.13.1"
diff --git a/Cargo.toml b/Cargo.toml
index 34e7fc6..1b710a4 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -17,5 +17,5 @@ exclude = [
 
 [dependencies]
 regex = "1"
-lazy_static = "1"
+once_cell = "1"
 backslash = "0"
diff --git a/src/main.rs b/src/main.rs
index 133cd7c..c16f5c3 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -2,9 +2,6 @@ use std::fs::File;
 use std::io::{self, Read};
 use std::process;
 
-#[macro_use]
-extern crate lazy_static;
-
 mod choice;
 mod config;
 mod error;
diff --git a/src/parse.rs b/src/parse.rs
index bb38156..ae8a02f 100644
--- a/src/parse.rs
+++ b/src/parse.rs
@@ -1,15 +1,15 @@
 use std::string::FromUtf8Error;
 
 use backslash::escape_ascii;
+use once_cell::sync::Lazy;
 use regex::Regex;
 
 use crate::choice::{Choice, ChoiceKind};
 use crate::error::ParseRangeError;
 use crate::parse_error::ParseError;
 
-lazy_static! {
-    pub static ref PARSE_CHOICE_RE: Regex = Regex::new(r"^(-?\d*)(:|\.\.=?)(-?\d*)$").unwrap();
-}
+
+pub static PARSE_CHOICE_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"^(-?\d*)(:|\.\.=?)(-?\d*)$").unwrap());
 
 pub fn choice(src: &str) -> Result<Choice, ParseError> {
     let cap = match PARSE_CHOICE_RE.captures_iter(src).next() {
-- 
