From af4a3fb14ee39cc930c1176c11e768a65047b9a8 Mon Sep 17 00:00:00 2001
From: Henry Chen <henry.chen@oss.cipunited.com>
Date: Tue, 29 Sep 2026 17:17:08 +0800
Subject: [PATCH 3/3] HOMEBREW: Drop GlobPath and intoFbString due to missing
 headers

---
 eden/fs/service/eden.thrift | 3 ---
 watchman/watcher/eden.cpp   | 2 +-
 2 files changed, 1 insertion(+), 4 deletions(-)

diff --git a/eden/fs/service/eden.thrift b/eden/fs/service/eden.thrift
index 6f9993186..0e5fa1233 100644
--- a/eden/fs/service/eden.thrift
+++ b/eden/fs/service/eden.thrift
@@ -11,8 +11,6 @@ include "thrift/annotation/cpp.thrift"
 include "thrift/annotation/rust.thrift"
 include "thrift/annotation/thrift.thrift"
 
-cpp_include "eden/fs/utils/GlobPath.h"
-
 @thrift.AllowLegacyMissingUris
 package;
 
@@ -107,7 +105,6 @@ typedef binary BinaryHash
  */
 typedef binary PathString
 
-@cpp.Adapter{name = "::facebook::eden::GlobPathAdapter"}
 typedef PathString GlobPathValue
 
 /**
diff --git a/watchman/watcher/eden.cpp b/watchman/watcher/eden.cpp
index 66bd8f98c..afb9c0a79 100644
--- a/watchman/watcher/eden.cpp
+++ b/watchman/watcher/eden.cpp
@@ -650,7 +650,7 @@ void appendGlobResultToNameAndDTypeVec(
     // our DType enum is declared in terms of those bits
     auto dtype = i < numDTypes ? static_cast<DType>(glob.dtypes().value()[i])
                                : DType::Unknown;
-    results.emplace_back(std::move(name).intoFbString(), dtype);
+    results.emplace_back(std::move(name), dtype);
     ++i;
   }
 }
