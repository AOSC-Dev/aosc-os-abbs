abinfo "Building and installing ..."
ZIG_FLAGS=(
    "--verbose"
    "--summary" "all"
    "--prefix" "/usr"
    "--system" "$SRCDIR/offline-cache/p"
    "-Doptimize=ReleaseFast"
    "-Dcpu=baseline"
    "-Dversion-string=$PKGVER"
    "-Demit-docs=false"
)

DESTDIR="$PKGDIR" zig build "${ZIG_FLAGS[@]}"
