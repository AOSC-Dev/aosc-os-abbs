PKGNAME=ghostty
PKGSEC=utils
BUILDDEP="blueprint-compiler zig"
BUILDDEP__AMD64="${BUILDDEP} pandoc"
BUILDDEP__ARM64="${BUILDDEP__AMD64}"
PKGDEP="fontconfig freetype glib glibc gtk-4 gtk4-layer-shell harfbuzz \
        libadwaita onig wayland x11-lib"
PKGDES="A GPU-accelerated terminal emulator"

ABTYPE=self

# FIXME: Zig 0.17.1 only supports amd64, arm64, loongarch64, riscv64 and ppc64el
# FIXME: Graphene 1.10.8 only compatible with Ghottty on amd64 & arm64
FAIL_ARCH="!(amd64|arm64)"
