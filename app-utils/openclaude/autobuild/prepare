export PATH="${PATH}:${BLDDIR}/bun-linux-x64-baseline"
export BUN_FEATURE_FLAG_DISABLE_NATIVE_DEPENDENCY_LINKER=1
BUN_VER=1.3.14

abinfo "Preparing building directory tree..."
mkdir -pv "${BLDDIR}"
mkdir -pv "${PKGDIR}"/usr/bin

abinfo "Downloading bun v${BUN_VER}, linux-x64-baseline..."
wget -vv "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VER}/bun-linux-x64-baseline.zip" -O "${BLDDIR}"/bun.zip

abinfo "Extracting bun..."
unzip -d "${BLDDIR}" "${BLDDIR}"/bun.zip
