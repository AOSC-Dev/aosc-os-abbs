PKGNAME=kbd
PKGSEC=utils
PKGDEP="glibc linux-pam"
PKGDES="Utilities to manage Linux console fonts and keymaps"

AUTOTOOLS_AFTER=(
    '--datadir=/usr/share/kbd'
    '--disable-code-coverage'
    '--enable-nls'
    '--disable-rpath'
    '--disable-werror'
    '--enable-optional-progs'
    '--enable-libkeymap'
    '--enable-libkfont'
    '--disable-vlock'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-optional-progs'
)

MAKE_AFTER=(
    'KEYCODES_PROGS=yes'
    'RESIZECONS_PROGS=yes'
)
MAKE_AFTER__RETRO=(
    "${MAKE_AFTER[@]}"
    'KEYCODES_PROGS=no'
    'RESIZECONS_PROGS=no'
)

PKGESS=1
