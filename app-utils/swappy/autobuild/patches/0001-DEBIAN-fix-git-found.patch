From bab386c98887129d5f877c2de0bfd8a62720a1c7 Mon Sep 17 00:00:00 2001
From: Krzysztof Adamski <k@japko.eu>
Date: Thu, 19 Nov 2026 22:49:03 +0800
Subject: [PATCH] DEBIAN: fix git found

Origin: https://salsa.debian.org/kadamski/swappy
Upstream-commit: d2ed5c4079cc3abda10ab0cb28735dac5ac997fc
---
 meson.build | 12 ------------
 1 file changed, 12 deletions(-)

diff --git a/meson.build b/meson.build
index f5a76a7..180891e 100644
--- a/meson.build
+++ b/meson.build
@@ -12,18 +12,6 @@ project(
 )
 
 version = '"@0@"'.format(meson.project_version())
-git = find_program('git', native: true, required: false)
-if git.found()
-	git_commit = run_command([git, 'rev-parse', '--short', 'HEAD'], check:true)
-	git_branch = run_command([git, 'rev-parse', '--abbrev-ref', 'HEAD'], check:true)
-	if git_commit.returncode() == 0 and git_branch.returncode() == 0
-		version = '"@0@-@1@ (" __DATE__ ", branch \'@2@\')"'.format(
-			meson.project_version(),
-			git_commit.stdout().strip(),
-			git_branch.stdout().strip(),
-		)
-	endif
-endif
 add_project_arguments('-DSWAPPY_VERSION=@0@'.format(version), language: 'c')
 
 add_project_arguments('-Wno-unused-parameter', language: 'c')
-- 
2.56.0

