abinfo "Installing dependencies..."
npm ci

abinfo "Building oh-my-rime..."
cargo tauri build --no-bundle

abinfo "Installing oh-my-rime..."
install -Dvm755 "$SRCDIR"/src-tauri/target/release/oh-my-rime "$PKGDIR"/usr/bin/oh-my-rime

abinfo "Installing application icon ..."
install -Dvm644 "$SRCDIR"/src-tauri/icons/32x32.png \
    "$PKGDIR"/usr/share/icons/hicolor/32x32/apps/oh-my-rime.png
install -Dvm644 "$SRCDIR"/src-tauri/icons/128x128.png \
    "$PKGDIR"/usr/share/icons/hicolor/128x128/apps/oh-my-rime.png
install -Dvm644 "$SRCDIR"/src-tauri/icons/128x128@2x.png \
    "$PKGDIR"/usr/share/icons/hicolor/256x256/apps/oh-my-rime.png
