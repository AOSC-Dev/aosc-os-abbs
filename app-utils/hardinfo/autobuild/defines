PKGNAME=hardinfo
PKGSEC=utils
PKGDEP="gtk-3 libsoup zlib json-glib sysbench hddtemp"
# LuaJIT is not available on riscv64 for now.
PKGDEP__RISCV64="${PKGDEP/sysbench/}"
PKGDEP__RETRO="gtk-2 json-glib zlib"
BUILDDEP="intltool"
PKGDES="System information and benchmark tool"

CMAKE_AFTER__MAINLINE=(
    # Note: Use GTK 3.x instead of outdated GTK 2.x on mainline architecture.
    '-DHARDINFO_GTK3=1'
    # Note: Turn on debug message printing.
    '-DHARDINFO_DEBUG=1'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DHARDINFO_GTK3=0'
)
