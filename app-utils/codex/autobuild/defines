PKGNAME=codex
PKGSEC=utils
PKGDES="Coding agent that runs in terminal"
PKGDEP="gcc-runtime glibc openssl git ripgrep"
BUILDDEP="help2man rustc llvm"

ABTYPE=rust
USECLANG=1
CARGO_AFTER=(
    '--bin' 'codex'
    '--bin' 'codex-responses-api-proxy'
)

# Note: codex only support amd64 and arm64, possibly support riscv64.
# Ref: https://github.com/openai/codex/issues/6150
FAIL_ARCH="!(amd64|arm64)"
