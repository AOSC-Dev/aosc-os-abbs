PKGNAME=kmscon
PKGSEC=utils
PKGDEP="libdrm libtsm mesa pango systemd unifont xkeyboard-config seatd"
PKGDEP__RETRO="libdrm libtsm systemd unifont xkeyboard-config seatd"
PKGDES="Terminal emulator based on Kernel Mode Setting (KMS)"

MESON_AFTER=(
	'-Dextra_debug=false'
	'-Dtests=false'
	'-Ddocs=disabled'
	'-Dlibseat=enabled'
	'-Dvideo_fbdev=enabled'
	'-Dvideo_drm2d=enabled'
	'-Dvideo_drm3d=enabled'
	'-Drenderer_gltex=enabled'
	'-Dfont_unifont=enabled'
	'-Dfont_pango=enabled'
)

MESON_AFTER__RETRO=(
	'-Dextra_debug=false'
	'-Dtests=false'
	'-Ddocs=disabled'
	'-Dlibseat=enabled'
	'-Dvideo_fbdev=enabled'
	'-Dvideo_drm2d=enabled'
	'-Dvideo_drm3d=disabled'
	'-Drenderer_gltex=disabled'
	'-Dfont_unifont=enabled'
	'-Dfont_pango=disabled'
)

PKGREP="kmscon-enablement"
PKGBREAK="kmscon-enablement"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
