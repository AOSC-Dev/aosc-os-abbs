From 84bfce481d686ddc7b849e17cb9d9ae90dadc342 Mon Sep 17 00:00:00 2001
From: CyberNeko-AI <cyberneko.ai@aosc.io>
Date: Wed, 1 Apr 2026 15:04:16 +0800
Subject: [PATCH 3/3] AOSCOS: add global cursor position mechanism

This commit is authored with assistance from AI/LLM:
- Model: Gemini 3.1 Pro
- Platform: Google Gemini (https://gemini.google.com/)
- Agent platform: Antigravity IDE (https://antigravity.google/product/antigravity-ide/)
- Prompt:
```
  "When switching between a touchpad (relative input) and a touchscreen
  (absolute input) in `kmscon`, the cursor jumps back to its
  previous position. How to implement a global cursor position
  mechanism in the terminal state machine to fix this state
  desynchronization?"
```

Signed-off-by: CyberNeko-AI <cyberneko.ai@aosc.io>
---
 src/input/input.h         |  3 +++
 src/input/input_pointer.c | 21 ++++++++++++++++-----
 src/terminal.c            | 16 ++++++++++++++--
 3 files changed, 33 insertions(+), 7 deletions(-)

diff --git a/src/input/input.h b/src/input/input.h
index 45f2306..b1f9062 100644
--- a/src/input/input.h
+++ b/src/input/input.h
@@ -80,6 +80,9 @@ struct input_pointer_event {
 	bool pressed;
 	bool double_click;
 	bool is_touchscreen;
+	int32_t delta_x;
+	int32_t delta_y;
+	bool is_relative;
 };
 
 #define INPUT_HAS_MODS(_ev, _mods) (((_ev)->mods & (_mods)) == (_mods))
diff --git a/src/input/input_pointer.c b/src/input/input_pointer.c
index b7cf683..a3aa26f 100644
--- a/src/input/input_pointer.c
+++ b/src/input/input_pointer.c
@@ -17,7 +17,7 @@ static void pointer_update_inactivity_timer(struct input_dev *dev)
 	ev_timer_update(dev->input->hide_pointer, &spec);
 }
 
-static void pointer_dev_send_move(struct input_dev *dev)
+static void pointer_dev_send_move(struct input_dev *dev, int32_t dx, int32_t dy, bool is_rel)
 {
 	struct input_pointer_event pev = {0};
 
@@ -25,6 +25,9 @@ static void pointer_dev_send_move(struct input_dev *dev)
 	pev.pointer_x = dev->pointer.x;
 	pev.pointer_y = dev->pointer.y;
 	pev.is_touchscreen = (dev->pointer.kind == POINTER_TOUCHSCREEN);
+	pev.delta_x = dx;
+	pev.delta_y = dy;
+	pev.is_relative = is_rel;
 
 	/* Include button state if a button is pressed during motion (drag) */
 	if (dev->pointer.pressed_button != BUTTON_NONE) {
@@ -81,7 +84,7 @@ void pointer_dev_rel(struct input_dev *dev, uint16_t code, int32_t value)
 			dev->pointer.x = 0;
 		if (dev->pointer.x > dev->input->pointer_max_x)
 			dev->pointer.x = dev->input->pointer_max_x;
-		pointer_dev_send_move(dev);
+		pointer_dev_send_move(dev, value, 0, true);
 		break;
 	case REL_Y:
 		dev->pointer.y += value;
@@ -89,7 +92,7 @@ void pointer_dev_rel(struct input_dev *dev, uint16_t code, int32_t value)
 			dev->pointer.y = 0;
 		if (dev->pointer.y > dev->input->pointer_max_y)
 			dev->pointer.y = dev->input->pointer_max_y;
-		pointer_dev_send_move(dev);
+		pointer_dev_send_move(dev, 0, value, true);
 		break;
 	case REL_WHEEL:
 		pointer_dev_send_wheel(dev, value);
@@ -101,6 +104,9 @@ void pointer_dev_rel(struct input_dev *dev, uint16_t code, int32_t value)
 
 static void pointer_dev_abs_x(struct input_dev *dev, int32_t value)
 {
+	int32_t old_x = dev->pointer.x;
+	bool is_rel = false;
+
 	switch (dev->pointer.kind) {
 	case POINTER_TOUCHPAD:
 		if (dev->pointer.touchpad_needs_sync_off_x) {
@@ -119,6 +125,7 @@ static void pointer_dev_abs_x(struct input_dev *dev, int32_t value)
 				dev->pointer.off_x = dev->input->pointer_max_x - value;
 			}
 		}
+		is_rel = true;
 		break;
 	case POINTER_TOUCHSCREEN:
 	case POINTER_VMOUSE:
@@ -128,11 +135,14 @@ static void pointer_dev_abs_x(struct input_dev *dev, int32_t value)
 	default:
 		return;
 	}
-	pointer_dev_send_move(dev);
+	pointer_dev_send_move(dev, dev->pointer.x - old_x, 0, is_rel);
 }
 
 static void pointer_dev_abs_y(struct input_dev *dev, int32_t value)
 {
+	int32_t old_y = dev->pointer.y;
+	bool is_rel = false;
+
 	switch (dev->pointer.kind) {
 	case POINTER_TOUCHPAD:
 		if (dev->pointer.touchpad_needs_sync_off_y) {
@@ -151,6 +161,7 @@ static void pointer_dev_abs_y(struct input_dev *dev, int32_t value)
 				dev->pointer.off_y = dev->input->pointer_max_y - value;
 			}
 		}
+		is_rel = true;
 		break;
 	case POINTER_TOUCHSCREEN:
 	case POINTER_VMOUSE:
@@ -160,7 +171,7 @@ static void pointer_dev_abs_y(struct input_dev *dev, int32_t value)
 	default:
 		return;
 	}
-	pointer_dev_send_move(dev);
+	pointer_dev_send_move(dev, 0, dev->pointer.y - old_y, is_rel);
 }
 
 void pointer_dev_abs(struct input_dev *dev, uint16_t code, int32_t value)
diff --git a/src/terminal.c b/src/terminal.c
index c3466d5..bdf0d16 100644
--- a/src/terminal.c
+++ b/src/terminal.c
@@ -1135,8 +1135,20 @@ static void pointer_event(struct input *input, struct input_pointer_event *ev, v
 				log_h = sh;
 		}
 
-		if (ev->is_touchscreen && orientation != OR_NORMAL && log_w > 0 &&
-		    log_h > 0 && log_w != INT_MAX && log_h != INT_MAX) {
+		if (ev->is_relative) {
+			px = term->pointer.x + ev->delta_x;
+			py = term->pointer.y + ev->delta_y;
+
+			if (px < 0)
+				px = 0;
+			if (py < 0)
+				py = 0;
+			if (log_w != INT_MAX && px >= (int32_t)log_w)
+				px = log_w - 1;
+			if (log_h != INT_MAX && py >= (int32_t)log_h)
+				py = log_h - 1;
+		} else if (ev->is_touchscreen && orientation != OR_NORMAL && log_w > 0 &&
+			   log_h > 0 && log_w != INT_MAX && log_h != INT_MAX) {
 			if (orientation == OR_RIGHT) {
 				px = ev->pointer_y * log_w / log_h;
 				py = log_h - (ev->pointer_x * log_h / log_w);
-- 
