From e3aec38ab31ba1c5207c1116f89ee888cf09e3d3 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Sun, 2 Aug 2026 01:36:08 +0800
Subject: [PATCH 2/2] AOSCOS: REVERT: Revert "Display: defaults
 `disableLinewrap` to `false`"

This reverts commit 104b33c1f7dd79c1482c364cc38723747e079a34.

Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
Signed-off-by: Kaiyang Wu <origincode@aosc.io>
---
 src/options/display.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/options/display.c b/src/options/display.c
index f764e2d7a..18a6e1bb9 100644
--- a/src/options/display.c
+++ b/src/options/display.c
@@ -954,9 +954,11 @@ void ffOptionsInitDisplay(FFOptionsDisplay* options) {
 
     options->showErrors = false;
     options->pipe = !ffIsTerminal(STDOUT_FILENO) || !!getenv("NO_COLOR");
-    options->disableLinewrap = false;
 
-#ifndef NDEBUG
+#ifdef NDEBUG
+    options->disableLinewrap = !options->pipe;
+#else
+    options->disableLinewrap = false;
     options->debugMode = !!getenv("FF_DEBUG");
 #endif
 
