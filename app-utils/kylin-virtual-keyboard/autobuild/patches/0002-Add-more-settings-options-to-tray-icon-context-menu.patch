 }
+
+QString VirtualKeyboardEntryManager::getAutostartDesktopPath() const {
+    return QStandardPaths::writableLocation(QStandardPaths::ConfigLocation)
+           + "/autostart/kylin-virtual-keyboard.desktop";
+}
+
+bool VirtualKeyboardEntryManager::isAutostartEnabled() const {
+    QString userDesktop = getAutostartDesktopPath();
+    if (!QFile::exists(userDesktop)) {
+        return true;
+    }
+    QSettings settings(userDesktop, QSettings::IniFormat);
+    return settings.value("Desktop Entry/Hidden", false).toBool() == false;
+}
+
+void VirtualKeyboardEntryManager::setAutostartEnabled(bool enabled) {
+    QString userDesktop = getAutostartDesktopPath();
+    QDir dir = QFileInfo(userDesktop).dir();
+    if (!dir.exists()) {
+        dir.mkpath(".");
+    }
+
+    if (enabled) {
+        QFile::remove(userDesktop);
+    } else {
+        QSettings settings(userDesktop, QSettings::IniFormat);
+        settings.beginGroup("Desktop Entry");
+        settings.setValue("Name", "kylin-virtual-keyboard");
+        settings.setValue("Hidden", true);
+        settings.endGroup();
+        settings.sync();
+    }
+}
+
+void VirtualKeyboardEntryManager::createAutostartAction() {
+    autostartAction_.reset(new QAction(tr("Autostart"), this));
+    autostartAction_->setCheckable(true);
+    autostartAction_->setChecked(isAutostartEnabled());
+
+    connect(autostartAction_.get(), &QAction::triggered, [this](bool checked) {
+        setAutostartEnabled(checked);
+    });
+}
+
+void VirtualKeyboardEntryManager::createAnimationAction() {
+    animationAction_.reset(new QAction(tr("Enable animation"), this));
+    animationAction_->setCheckable(true);
+    animationAction_->setChecked(
+        VirtualKeyboardSettings::getInstance().isAnimationEnabled());
+
+    connect(animationAction_.get(), &QAction::triggered, [](bool checked) {
+        QGSettings gsettings("org.ukui.virtualkeyboard");
+        gsettings.set("animation-enabled", checked);
+    });
+}
+
+void VirtualKeyboardEntryManager::createScaleSubMenu() {
+    scaleSubMenu_.reset(new QMenu(tr("Keyboard size")));
+    scaleActionGroup_.reset(new QActionGroup(this));
+    scaleActionGroup_->setExclusive(true);
+
+    int currentScale = static_cast<int>(
+        VirtualKeyboardSettings::getInstance().calculateVirtualKeyboardScaleFactor() * 100);
+
+    for (int scale = 20; scale <= 100; scale += 10) {
+        QString label = tr("%1%").arg(scale);
+        QAction *action = scaleSubMenu_->addAction(label);
+        action->setCheckable(true);
+        action->setChecked(currentScale == scale);
+        action->setData(scale);
+        scaleActionGroup_->addAction(action);
+
+        connect(action, &QAction::triggered, [scale]() {
+            QGSettings gsettings("org.ukui.virtualkeyboard");
+            gsettings.set("virtual-keyboard-scale-factor", scale);
+        });
+    }
+}
+
+void VirtualKeyboardEntryManager::createTrayIconSubMenu() {
+    trayIconSubMenu_.reset(new QMenu(tr("Tray icon")));
+    trayIconActionGroup_.reset(new QActionGroup(this));
+    trayIconActionGroup_->setExclusive(true);
+
+    struct PolicyOption {
+        QString value;
+        QString label;
+    };
+    QVector<PolicyOption> options = {
+        {"NeverShow", tr("Never show")},
+        {"AlwaysShow", tr("Always show")},
+        {"ShowWhenKeyboardIsConnected", tr("Show when keyboard connected")}
+    };
+
+    QString currentPolicy = VirtualKeyboardSettings::getInstance().trayIconShow();
+
+    for (const auto &opt : options) {
+        QAction *action = trayIconSubMenu_->addAction(opt.label);
+        action->setCheckable(true);
+        action->setChecked(currentPolicy == opt.value);
+        action->setData(opt.value);
+        trayIconActionGroup_->addAction(action);
+
+        connect(action, &QAction::triggered, [opt]() {
+            QGSettings gsettings("org.ukui.virtualkeyboard");
+            gsettings.set("tray-icon-show-policy", opt.value);
+        });
+    }
+}
+
+void VirtualKeyboardEntryManager::initOtherTrayContextMenu() {
+
+    floatButtonContextMenu_->addSeparator();
+
+    // 开机自启
+    createAutostartAction();
+    floatButtonContextMenu_->addAction(autostartAction_.get());
+
+    // 动画开关
+    createAnimationAction();
+    floatButtonContextMenu_->addAction(animationAction_.get());
+
+    floatButtonContextMenu_->addSeparator();
+
+    // 键盘大小子菜单
+    createScaleSubMenu();
+    floatButtonContextMenu_->addMenu(scaleSubMenu_.get());
+
+    // 托盘显示策略子菜单
+    createTrayIconSubMenu();
+    floatButtonContextMenu_->addMenu(trayIconSubMenu_.get());
+}
+
+void VirtualKeyboardEntryManager::updateMenuState() {
+    autostartAction_->setChecked(isAutostartEnabled());
+    animationAction_->setChecked(
+        VirtualKeyboardSettings::getInstance().isAnimationEnabled());
+
+    int currentScale = static_cast<int>(
+        VirtualKeyboardSettings::getInstance().calculateVirtualKeyboardScaleFactor() * 100);
+    for (QAction *action : scaleActionGroup_->actions()) {
+        action->setChecked(action->data().toInt() == currentScale);
+    }
+
+    QString currentPolicy = VirtualKeyboardSettings::getInstance().trayIconShow();
+    for (QAction *action : trayIconActionGroup_->actions()) {
+        action->setChecked(action->data().toString() == currentPolicy);
+    }
+}
