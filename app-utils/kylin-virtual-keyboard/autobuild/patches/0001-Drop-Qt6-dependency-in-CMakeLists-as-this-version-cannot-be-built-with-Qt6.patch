From: Melorise <0d00@0721.hk>
Date: Fri, 17 Apr 2026 19:48:46 +0800
Subject: [PATCH 1/4] Drop Qt6 dependency in CMakeLists as this version cannot
 be built with Qt6

---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3e49132..f076d4b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -18,7 +18,7 @@ if (NOT spdlog_FOUND)
 endif()
 
 
-find_package(QT NAMES Qt6 Qt5 REQUIRED)
+find_package(QT NAMES Qt5 REQUIRED)
 find_package(Qt${QT_VERSION_MAJOR} COMPONENTS Core Gui Widgets Concurrent DBus Quick QuickControls2 REQUIRED)
 if (NOT Qt${QT_VERSION_MAJOR}_FOUND)
     message(FATAL_ERROR "Qt${QT_VERSION_MAJOR} not found!")
