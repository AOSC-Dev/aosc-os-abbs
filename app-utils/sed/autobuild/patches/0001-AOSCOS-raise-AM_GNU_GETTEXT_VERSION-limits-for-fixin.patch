From 31aaa5af50cebcc480b7a04c01ab74b2c538d093 Mon Sep 17 00:00:00 2001
From: "Lain \"Fearyncess\" Yang" <i@lain.vg>
Date: Mon, 27 Jul 2026 18:32:48 +0800
Subject: [PATCH] AOSCOS: raise AM_GNU_GETTEXT_VERSION limits for fixing
 autoreconf gettext failures

Ref: https://lists.nongnu.org/archive/html/nano-devel/2024-05/msg00020.html
---
 configure.ac | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index 159df0a..f67d222 100644
--- a/configure.ac
+++ b/configure.ac
@@ -110,7 +110,7 @@ AC_CHECK_HEADERS_ONCE(locale.h errno.h wchar.h wctype.h mcheck.h,
 AC_C_CONST
 AC_TYPE_SIZE_T
 
-AM_GNU_GETTEXT_VERSION([0.19.2])
+AM_GNU_GETTEXT_VERSION([0.20])
 AM_GNU_GETTEXT([external])
 
 AC_CHECK_FUNCS_ONCE(isatty isascii memcpy strchr strtoul readlink
-- 
2.55.0

