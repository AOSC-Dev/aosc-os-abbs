PKGNAME=gnuplot
PKGSEC=utils
PKGDEP="x11-lib readline cairo libgd qt-5"
PKGDEP__RETRO="x11-lib readline cairo libgd"
BUILDDEP="texinfo"
PKGDES="Graphing/Plotting utility to generate 2D and 3D visualizations of functions, data, and data fits"

ABTYPE=autotools
# Note: --disable-wxwidgets, use Qt as default.
AUTOTOOLS_AFTER=(
    '--with-gihdir=/usr/share/gnuplot'
    '--with-readline=gnu'
    '--libexecdir=/usr/bin'
    '--with-texdir=/usr/share/texmf'
    '--disable-wxwidgets'
    '--with-qt=qt6'
)
MAKE_AFTER="pkglibexecdir=/usr/bin"

# FIXME: Somehow unable to build when compiling on lots of platform,
# related to failing testing.
#
# On some platform (arm64), it calls:
#
#   test "[...]/gnuplot-6.0.2" = ".." || rm -f ./dodecahedron.dat
#   Making all in plugin
#   Could not open polygon input file
#   make[2]: *** [Makefile:726: binary3] Error 1
#   make[2]: *** Waiting for unfinished jobs....
NOPARALLEL=1
