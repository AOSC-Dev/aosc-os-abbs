PKGNAME=gnuplot
PKGSEC=utils
PKGDEP="x11-lib readline cairo libgd qt-5"
PKGDEP__RETRO="x11-lib readline cairo libgd"
BUILDDEP="emacs texinfo texlive"
BUILDDEP__RETRO="texinfo"
PKGDES="Plotter which outputs to X11, PostScript, PNG, GIF and others"

ABTYPE=autotools
# Note: --disable-wxwidgets, use Qt as default.
AUTOTOOLS_AFTER=(
    '--with-gihdir=/usr/share/gnuplot'
    '--with-readline=gnu'
    '--libexecdir=/usr/bin'
    '--with-texdir=/usr/share/texmf'
    '--disable-wxwidgets'
    '--with-qt=qt5'
)
MAKE_AFTER="pkglibexecdir=/usr/bin"

# FIXME: Somehow unable to build when compiling on lots of platform,
# related to failing testing.
