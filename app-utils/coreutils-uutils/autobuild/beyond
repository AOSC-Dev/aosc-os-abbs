mv -v "${PKGDIR}/usr/bin/coreutils" "${PKGDIR}/usr/bin/uu-coreutils"

mkdir -vp "${PKGDIR}/usr/share/man/man1"
mkdir -vp "${PKGDIR}/usr/share/bash-completion/completions"
mkdir -vp "${PKGDIR}/usr/share/zsh/site-functions"
mkdir -vp "${PKGDIR}/usr/share/fish/vendor_completions.d"

for i in `"${PKGDIR}/usr/bin/uu-coreutils" --list`; do
  ln -svf uu-coreutils "${PKGDIR}/usr/bin/uu-${i##*/}"
  "${PKGDIR}/usr/bin/uudoc" manpage "${i##*/}" > "${PKGDIR}/usr/share/man/man1/uu-${i##*/}.1"
  "${PKGDIR}/usr/bin/uudoc" completion "${i##*/}" bash > "${PKGDIR}/usr/share/bash-completion/completions/uu-${i##*/}"
  "${PKGDIR}/usr/bin/uudoc" completion "${i##*/}" zsh > "${PKGDIR}/usr/share/zsh/site-functions/_uu-${i##*/}"
  "${PKGDIR}/usr/bin/uudoc" completion "${i##*/}" fish > "${PKGDIR}/usr/share/fish/vendor_completions.d/uu-${i##*/}.fish"
done
