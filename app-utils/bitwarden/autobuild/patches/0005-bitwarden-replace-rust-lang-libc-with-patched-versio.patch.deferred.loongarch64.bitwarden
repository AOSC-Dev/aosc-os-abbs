From 89221fb273ac0524b2a075e8bbb6d46c96ab8bd9 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Tue, 21 Apr 2026 18:42:44 +0800
Subject: [PATCH 5/5] bitwarden: replace rust-lang/libc with patched version
 for loongarch64

---
 apps/desktop/desktop_native/Cargo.toml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/apps/desktop/desktop_native/Cargo.toml b/apps/desktop/desktop_native/Cargo.toml
index e5abd9adee..2e0844e248 100644
--- a/apps/desktop/desktop_native/Cargo.toml
+++ b/apps/desktop/desktop_native/Cargo.toml
@@ -109,3 +109,6 @@ cargo-sort = { version = "2.0.2", locked = true }
 cargo-udeps = { version = "0.1.57", locked = true }
 cargo-llvm-cov = { version = "0.6.16", locked = true }
 cargo-xwin = { version = "0.23.0", locked = true }
+
+[patch.crates-io]
+libc = { path = "../../../../rust-lang-libc" }
-- 
2.55.0

