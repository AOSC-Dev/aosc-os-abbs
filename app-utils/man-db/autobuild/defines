PKGNAME=man-db
PKGSEC=utils
PKGDEP="bzip2 gdbm groff gzip less libpipeline libseccomp lzip xz zlib zstd"
PKGDEP__RETRO="${PKGDEP/libseccomp/}"
# Note: elinks: recommended for reading HTML manpage outputs (rare use case).
PKGRECOM="elinks"
BUILDDEP="po4a"
PKGDES="Utilities to read and manage man pages"

# Note: --disable-cache-owner allows man-db to use root as the default owner
# for its cache.
AUTOTOOLS_AFTER=(
    '--disable-cache-owner'
    '--disable-setuid'
    '--disable-undoc'
    '--enable-automatic-create'
    '--enable-cats'
    '--enable-mandirs=GNU'
    '--enable-manual'
    '--enable-largefile'
    '--enable-year2038'
    '--enable-threads=posix'
    '--enable-mb-groff'
    '--enable-nls'
    '--disable-rpath'
    '--with-db=gdbm'
    '--with-browser=/usr/bin/elinks'
    '--with-pager=/usr/bin/less'
    '--with-nroff=/usr/bin/nroff'
    '--with-eqn=/usr/bin/eqn'
    '--with-neqn=/usr/bin/neqn'
    '--with-tbl=/usr/bin/tbl'
    '--with-col=/usr/bin/col'
    '--with-vgrind=/usr/bin/vgrind'
    '--with-refer=/usr/bin/refer'
    '--with-grap=/usr/bin/grap'
    '--with-pic=/usr/bin/pic'
    '--with-gzip=/usr/bin/gzip'
    '--with-compress=/usr/bin/compress'
    '--with-bzip2=/usr/bin/bzip2'
    '--with-xz=/usr/bin/xz'
    '--with-lzma=/usr/bin/lzma'
    '--with-lzip=/usr/bin/lzip'
    '--with-zstd=/usr/bin/zstd'
    '--without-included-regex'
    '--with-libseccomp'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-libseccomp'
)
