From 6ce73e58212ce286e990825985e53bd8fe9aca2b Mon Sep 17 00:00:00 2001
From: Xi Ruoyao <xry111@xry111.site>
Date: Mon, 30 Mar 2026 23:04:16 +0800
Subject: [PATCH 5/5] AOSCOS: Hard code the version string

Avoid "-dirty" in the git-version-gen output.

Signed-off-by: Xi Ruoyao <xry111@xry111.site>
---
 bootstrap | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/bootstrap b/bootstrap
index 874831e..0811eba 100755
--- a/bootstrap
+++ b/bootstrap
@@ -75,10 +75,7 @@ init() {
     mkdir m4
     ln tests/sharutils.m4 m4/.
 
-    sharutils_version=$(
-        cd ${progsrc} || die "$progsrc directory is invalid"
-        test -d .git  || die "$progsrc directory is invalid"
-        ${gldir}/build-aux/git-version-gen ${progdir}/sharutils.ver)
+    sharutils_version=4.15.2
     sharutils_eaddr=$(autoconf -t 'AC_INIT:$3' configure.ac.git)
 
     autoconf_version=$(
-- 
2.53.0

