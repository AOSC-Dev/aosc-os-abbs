From b922d6be7433657bb685a6c648fcd00ace26cf20 Mon Sep 17 00:00:00 2001
From: Kaiyang Wu <wukaiyang@loongfans.cn>
Date: Fri, 16 Oct 2026 15:38:42 +0800
Subject: [PATCH] UPSTREAM: Flip black and white colours for light mode.

(cherry picked from commit b111fb23ff356b54f7ab47f1645d6dda797b9e0f)
Signed-off-by: Kaiyang Wu <wukaiyang@loongfans.cn>
---
 options-table.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/options-table.c b/options-table.c
index c7b16711..4c20ce05 100644
--- a/options-table.c
+++ b/options-table.c
@@ -1,4 +1,4 @@
-/* $OpenBSD: options-table.c,v 1.249 2026/10/05 09:03:11 nicm Exp $ */
+/* $OpenBSD: options-table.c,v 1.253 2026/10/15 13:08:43 nicm Exp $ */
 
 /*
  * Copyright (c) 2011 Nicholas Marriott <nicholas.marriott@gmail.com>
@@ -655,7 +655,7 @@ const struct options_table_entry options_table[] = {
 	  .type = OPTIONS_TABLE_STRING,
 	  .scope = OPTIONS_TABLE_SERVER,
 	  .flags = OPTIONS_TABLE_IS_COLOUR,
-	  .default_str = "#{?#{e|>=:#{client_colours},256},gray10,black}",
+	  .default_str = "#{?#{e|>=:#{client_colours},256},gray95,black}",
 	  .text = "Light theme colour for black."
 	},
 
@@ -663,7 +663,7 @@ const struct options_table_entry options_table[] = {
 	  .type = OPTIONS_TABLE_STRING,
 	  .scope = OPTIONS_TABLE_SERVER,
 	  .flags = OPTIONS_TABLE_IS_COLOUR,
-	  .default_str = "#{?#{e|>=:#{client_colours},256},gray95,white}",
+	  .default_str = "#{?#{e|>=:#{client_colours},256},gray10,white}",
 	  .text = "Light theme colour for white."
 	},
 
