From 68721ba9a10bfa35e3eaf87831c0e181a56bff8d Mon Sep 17 00:00:00 2001
From: Ruikai Liu <rickliu2000@foxmail.com>
Date: Thu, 8 Oct 2026 11:26:55 +0800
Subject: [PATCH] Define HWY_ARCH_MAX_BYTES on missing case for HWY_ARCH_*

Architectures with no native highway targets (e.g. mips) use the fallback target: HWY_EMU128 with 16-byte vectors, or HWY_SCALAR with 8-byte vectors when EMU128 is opted out.
Define HWY_ARCH_MAX_BYTES as 16 in the unknown case instead of failing the build.
---
 hwy/detect_compiler_arch.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hwy/detect_compiler_arch.h b/hwy/detect_compiler_arch.h
index 792ec5c7..f98dcec1 100644
--- a/hwy/detect_compiler_arch.h
+++ b/hwy/detect_compiler_arch.h
@@ -442,7 +442,7 @@
 #elif HWY_ARCH_PPC || HWY_ARCH_S390X || HWY_ARCH_ARM_V7 || HWY_ARCH_ARM_OLD
 #define HWY_ARCH_MAX_BYTES 16
 #else
-#error "Missing case for HWY_ARCH_*"
+#define HWY_ARCH_MAX_BYTES 16
 #endif
 
 //------------------------------------------------------------------------------
