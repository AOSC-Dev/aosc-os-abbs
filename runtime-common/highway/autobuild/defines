PKGNAME=highway
PKGSEC=libs
PKGDEP="gcc-runtime"
BUILDDEP="gtest"
PKGDES="C++ library to provide portable SIMD/vector intrinsics"
BUILDDEP__LOONGSON3="${BUILDDEP} llvm"
BUILDDEP__LOONGARCH64_NOSIMD="${BUILDDEP} llvm"
BUILDDEP__RISCV64="${BUILDDEP} llvm"

ABTYPE=cmakeninja
# NOTE: Set HWY_ENABLE_TESTS=ON to generate hwy_gtest.h for libjxl.
CMAKE_AFTER=(
    "-DBUILD_SHARED_LIBS=ON"
    "-DBUILD_TESTING=OFF"
    "-DHWY_ENABLE_TESTS=ON"
    "-DHWY_SYSTEM_GTEST=ON"
)
CMAKE_AFTER__ARMV7HF=(
    "${CMAKE_AFTER[@]}"
    "-DHWY_CMAKE_ARM7=ON"
)

USECLANG__LOONGSON3=1
USECLANG__LOONGARCH64_NOSIMD=1
USECLANG__RISCV64=1
PKGBREAK="libjxl<=0.7.0"
