PKGNAME=protobuf
PKGSEC=libs
PKGDEP="gcc-runtime python-3 zlib abseil-cpp"
PKGDEP__RETRO="${PKGDEP/python-3/}"
BUILDDEP="setuptools-python3"
BUILDDEP__RETRO=""
PKGDES="Library to encode structured data"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    "-Dprotobuf_BUILD_TESTS=OFF"
    "-Dprotobuf_BUILD_CONFORMANCE=OFF"
    "-Dprotobuf_BUILD_EXAMPLES=ON"
    "-Dprotobuf_BUILD_PROTOC_BINARIES=ON"
    "-Dprotobuf_BUILD_SHARED_LIBS=ON"
    "-Dprotobuf_MSVC_STATIC_RUNTIME=OFF"
    "-Dprotobuf_ABSL_PROVIDER=package"
)

# FIXME: generates `/usr/lib/libupb.a`
NOSTATIC=0

# FIXME: produces broken binaries.
NOLTO__IA64=1

PKGBREAK="android-platform-tools<=35.0.2-10 apache-arrow<=23.0.1-1 \
          bear<=3.1.6-4 compiz<=0.9.14.2-7 et<=6.2.9-2 grpc<=1.81.1 \
          kicad<=9.0.6-1 libphonenumber<=9.0.31 marble-runtime<=23.08.5-3 \
          mixxx<=2.5.2-2 mosh<=1.4.0-4 onnxruntime<=1.23.2-1 opencv<=4.13.0-4 \
          protobuf-c<=1.5.2-1 proton-bridge<=3.21.2-12 qgis<=3.44.11 \
          qt-6<=6.11.1 telegram-desktop<=6.9.3 vlc<=3.0.23+2-3 \
          warzone2100<=4.6.3"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
