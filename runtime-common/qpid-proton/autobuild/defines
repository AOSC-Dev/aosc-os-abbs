PKGNAME=qpid-proton
PKGSEC=libs
PKGDEP="cyrus-sasl glibc jsoncpp openssl"
BUILDDEP="swig"
PKGDES="Library to implement the Advanced Message Queuing Protocol (AMQP)"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_CPP=ON'
    '-DBUILD_EXAMPLES=OFF'
    '-DBUILD_GO=ON'
    '-DBUILD_PYTHON=ON'
    '-DBUILD_PYTHON_UNBUNDLED_PKG=OFF'
    '-DBUILD_RUBY=ON'
    '-DBUILD_STATIC_LIBS=OFF'
    '-DBUILD_TESTING=OFF'
    '-DBUILD_TLS=ON'
    '-DBUILD_TOOLS=ON'
    '-DENABLE_BENCHMARKS=OFF'
    '-DENABLE_FDLIMIT_TEST=OFF'
    '-DENABLE_FUZZ_TESTING=OFF'

    # Note: Per upstream default.
    '-DENABLE_HIDE_UNEXPORTED_SYMBOLS=ON'

    '-DENABLE_JSONCPP=ON'
    '-DENABLE_LINKTIME_OPTIMIZATION=ON'
    '-DENABLE_OPENTELEMETRYCPP=OFF'
    '-DENABLE_PYTHON_ISOLATED=ON'
    '-DENABLE_TOX_TEST=OFF'
    '-DFUZZ_LONG_TESTS=OFF'
    '-DFUZZ_REGRESSION_TESTS=OFF'
    '-DTHREADERCISER=OFF'
)
