PKGNAME=newt
PKGSEC=libs
PKGDEP="gpm popt slang python-3 tcl"
PKGDEP__RETRO="gpm popt slang"
PKGDES="Library to create widget-based terminal user interfaces"

PKGPROV="whiptail"

# FIXME: Makefile reads hard-coded "$SRCDIR"/configure.ac (in relative path)
# for some reason.
ABSHADOW=0

AUTOTOOLS_AFTER=(
    '--enable-largefile'
    '--enable-nls'
    '--with-python'
    '--with-tcl'
    '--with-gpm-support'
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-python'
    '--without-tcl'
)
