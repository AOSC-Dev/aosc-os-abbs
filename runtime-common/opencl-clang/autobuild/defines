PKGNAME=opencl-clang
PKGSEC=libs
# Note: Build system specifies LLVM versions.
PKGDEP="llvm-runtime-22 spirv-llvm-translator"
BUILDDEP="llvm-22"
PKGDES="Thin wrapper library around Clang"

CMAKE_AFTER=(
    "-DLLVMSPIRV_INCLUDED_IN_LLVM=OFF"
    "-DSPIRV_TRANSLATOR_DIR=/usr"
    "-DPREFERRED_LLVM_VERSION=${__SYSTEM_LLVM_VER}"
    "-DLLVM_NO_DEAD_STRIP=ON"
    "-DLLVM_INCLUDE_DIRS=/usr/include"
)
ABTYPE=cmakeninja
USECLANG=1
