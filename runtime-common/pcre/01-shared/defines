PKGNAME=pcre
PKGDES="Perl Compatible Regular Expression"
PKGSEC=libs
PKGDEP="zlib bzip2 readline glibc"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--enable-utf'
    '--enable-unicode-properties'
    '--enable-pcregrep-libz'
    '--enable-pcregrep-libbz2'
    '--enable-pcretest-libreadline'
    '--enable-pcre16'
    '--enable-pcre32'
    '--enable-jit'
    '--enable-static'
    '--enable-shared'
)
# FIXME: JIT not supported.
#
# [...]/pcre-8.45/pcre_jit_compile.c:65:2: error: #error Unsupported architecture
#    65 | #error Unsupported architecture
#       |  ^~~~~
# [...]/pcre-8.45/pcre_jit_compile.c: In function 'pcre_jit_free_unused_memory':
# [...]/pcre-8.45/pcre_jit_compile.c:11844:1: error: implicit declaration of function 'sljit_free_unused_memory_exec'; did you mean 'pcre_jit_free_unused_memory'? [-Wimplicit-function-declaration]
# 11844 | sljit_free_unused_memory_exec();
#       | ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#       | pcre_jit_free_unused_memory
AUTOTOOLS_AFTER__NOJIT=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-jit'
    '--disable-pcregrep-jit'
)
AUTOTOOLS_AFTER__ALPHA=("${AUTOTOOLS_AFTER__NOJIT[@]}")
AUTOTOOLS_AFTER__ARMV4=("${AUTOTOOLS_AFTER__NOJIT[@]}")
AUTOTOOLS_AFTER__ARMV6HF=("${AUTOTOOLS_AFTER__NOJIT[@]}")
AUTOTOOLS_AFTER__ARMV7HF=("${AUTOTOOLS_AFTER__NOJIT[@]}")
AUTOTOOLS_AFTER__LOONGARCH64=("${AUTOTOOLS_AFTER__NOJIT[@]}")
AUTOTOOLS_AFTER__LOONGARCH64_NOSIMD=("${AUTOTOOLS_AFTER__LOONGARCH64[@]}")
AUTOTOOLS_AFTER__M68K=("${AUTOTOOLS_AFTER__NOJIT[@]}")
AUTOTOOLS_AFTER__RISCV64=("${AUTOTOOLS_AFTER__NOJIT[@]}")

RECONF=0
AB_FLAGS_O3=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
