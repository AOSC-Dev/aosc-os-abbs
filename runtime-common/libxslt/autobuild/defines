PKGNAME=libxslt
PKGDEP="libgcrypt libgpg-error libxml2 python-3"
PKGDEP__RETRO="libxml2"
PKGSEC=libs
PKGDES="Library and utilities to handle eXtensible Stylesheet Language Transformations (XSLT)"

AUTOTOOLS_AFTER=(
    '--with-python=/usr/bin/python3'
    'PYTHON=/usr/bin/python3'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-crypto'
    '--without-python'
)

AB_FLAGS_O3=1
