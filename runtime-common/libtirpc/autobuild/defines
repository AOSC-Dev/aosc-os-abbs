PKGNAME=libtirpc
PKGSEC=libs
PKGDES="Transport Independent RPC library (SunRPC replacement)"

PKGDEP="krb5 e2fsprogs"
PKGDEP__RETRO="glibc"

AUTOTOOLS_AFTER=(
    '--sysconf=/etc'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-gssapi'
)

PKGBREAK="linux-pam<=1.3.0-1 rpcbind<=0.2.4 zfs<=0.7.2-1 dracut<=045"
