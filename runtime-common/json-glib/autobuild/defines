PKGNAME=json-glib
PKGSEC=libs
PKGDEP="glib"
BUILDDEP="gobject-introspection"
PKGDES="JSON parser library built on GLib"

ABTYPE=meson
MESON_AFTER=(
    '-Dintrospection=enabled'
    '-Dgtk_doc=disabled'
    '-Dman=true'
    '-Dtests=false'
    '-Dnls=enabled'
)
MESON_AFTER__RETRO=(
    '"${MESON_AFTER[@]}"
    '-Dintrospection=disabled'
)
