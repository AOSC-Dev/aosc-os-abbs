PKGNAME=librdkafka
PKGSEC=libs
PKGDEP="curl cyrus-sasl gcc-runtime lz4 openssl zlib zstd"
PKGDES="C/C++ library to implement the Apache Kafka client protocol"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DENABLE_DEVEL=OFF'
    '-DENABLE_LZ4_EXT=ON'
    '-DENABLE_REFCNT_DEBUG=OFF'
    '-DRDKAFKA_BUILD_EXAMPLES=OFF'
    '-DRDKAFKA_BUILD_STATIC=OFF'
    '-DRDKAFKA_BUILD_TESTS=OFF'
    '-DWITHOUT_OPTIMIZATION=OFF'
    '-DWITH_CURL=ON'
    '-DWITH_PLUGINS=ON'
    '-DWITH_SASL=ON'
    '-DWITH_SSL=ON'
    '-DWITH_ZLIB=ON'
    '-DWITH_ZSTD=ON'
)
