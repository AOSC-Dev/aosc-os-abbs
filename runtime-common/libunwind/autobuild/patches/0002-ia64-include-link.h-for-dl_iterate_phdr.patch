From aa8fe61c1b9f76eff4271fa792c6db119f4a6749 Mon Sep 17 00:00:00 2001
From: Matt Turner <mattst88@gmail.com>
Date: Sun, 11 Oct 2026 18:13:52 -0400
Subject: [PATCH] ia64: include <link.h> for dl_iterate_phdr()

Ginit.c and mi/Gset_iterate_phdr_function.c refer to dl_iterate_phdr(),
which every other target gets declared by way of dwarf.h.  ia64 does not
use the DWARF unwinder and so never includes it, and fails to compile:

    src/ia64/Ginit.c:375:44: error: 'dl_iterate_phdr' undeclared
---
 include/tdep-ia64/libunwind_i.h | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/include/tdep-ia64/libunwind_i.h b/include/tdep-ia64/libunwind_i.h
index 8c737cd5..cb7b86ec 100644
--- a/include/tdep-ia64/libunwind_i.h
+++ b/include/tdep-ia64/libunwind_i.h
@@ -33,6 +33,16 @@ WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.  */
 #include "mempool.h"
 #include <stdatomic.h>
 
+#ifndef UNW_REMOTE_ONLY
+# if defined(HAVE_LINK_H)
+#  include <link.h>
+# elif defined(HAVE_SYS_LINK_H)
+#  include <sys/link.h>
+# else
+#  error Could not find <link.h>
+# endif
+#endif
+
 typedef struct
   {
     /* no ia64-specific fast trace */
-- 
2.56.0

