PKGNAME=rrdtool
PKGDES="Round Robin Database Tool to store and display time-series data"
PKGSEC=libs
PKGDEP="perl libxml2 pango"
ABSHADOW=no

MAKE_AFTER="LIBS=\"-lglib-2.0\" includedir=/usr/include"
AUTOTOOLS_AFTER=(
    '--disable-lua'
    '--disable-perl'
    '--enable-perl'
    '--enable-perl-site-install'
    '--with-perl-options=\"INSTALLDIRS=vendor\"'
    '--disable-ruby'
    '--disable-python'
    '--disable-libwrap'
    '--disable-tcl'
)

NOPARALLEL=1
ABSHADOW=0

