PKGNAME=minizip
PKGSEC=libs
# NOTE: xz provides liblzma
PKGDEP="zlib bzip2 zstd xz"
PKGDES="Mini zip and unzip based on zlib"

ABTYPE=cmakeninja
# NOTE: disabling MZ_PPMD to avoid shipping the libppmd.a static library
CMAKE_AFTER=(
    '-DBUILD_SHARED_LIBS=ON'
    '-DMZ_PPMD=OFF'
)

PKGBREAK="minizip<=1.3.1 minizip-static<=1:4.2.2-1"
PKGREP="minizip<=1.3.1 minizip-static<=1:4.2.2-1"
