abinfo "Running configure ..."
"$SRCDIR"/configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --infodir=/usr/share/info \
    --mandir=/usr/share/man \
    --enable-shared \
    CPPFLAGS="${CPPFLAGS}" \
    CFLAGS="${CFLAGS}" \
    LDFLAGS="${LDFLAGS}"

abinfo "Building lzlib ..."
make

abinfo "Installing lzlib ..."
make install \
    DESTDIR="$PKGDIR"

abinfo "Setting executable bits on shared objects ..."
chmod -v +x "$PKGDIR"/usr/lib/*.so*
