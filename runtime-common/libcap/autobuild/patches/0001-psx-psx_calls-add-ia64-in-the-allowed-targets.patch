From cb51b7d59102e30b81a4701ccd25f13f85be38b8 Mon Sep 17 00:00:00 2001
From: Xinhui Yang <cyan@cyano.uk>
Date: Tue, 17 Nov 2026 14:41:10 +0800
Subject: [PATCH] psx/psx_calls: add ia64 in the allowed targets

---
 psx/psx_calls.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/psx/psx_calls.c b/psx/psx_calls.c
index 5e38cb9..8b400d9 100644
--- a/psx/psx_calls.c
+++ b/psx/psx_calls.c
@@ -50,7 +50,7 @@
     || defined(__alpha__) || defined(__hppa__) || defined(__sh__) \
     || defined(__m68k__) || defined(__sparc__) || defined(__arc__) \
     || defined(__microblaze__) || defined(__or1k__) \
-    || defined(__xtensa__)
+    || defined(__xtensa__) || defined(__ia64__)
 
 #undef _NSIG
 #undef _NSIG_BPW
