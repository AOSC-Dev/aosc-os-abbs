PKGNAME=libksi
PKGSEC=libs
PKGDEP="glibc openssl"
PKGDES="Client library for the Guardtime KSI (Keyless Signature Infrastructure) Blockchain"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--with-net-tcp'
    '--with-net-http'
    '--with-net-file'
    '--with-sm3-hash-algorithm'
    '--with-hash-provider=openssl'
    '--with-cafile=ca-bundle.crt'
)
