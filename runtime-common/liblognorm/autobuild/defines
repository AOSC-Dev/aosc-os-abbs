PKGNAME=liblognorm
PKGSEC=libs
PKGDEP="libestr libfastjson pcre2"
PKGDES="Samples-based normalization library"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--enable-regexp'
    '--disable-debug'
    '--enable-advanced-stats'

    # Note: Per the Styling Manual.
    '--disable-docs'

    '--disable-testbench'
    '--disable-valgrind'
    '--enable-tools'
    '--enable-turbo'
)
