abinfo "Building gsettings-qt5..."
CMAKE_AFTER=(
     '-DENABLE_QT6=OFF'
     '-DQT_MAJOR_VERSION=5'
     '-DCMAKE_INSTALL_PREFIX=/usr'
)
build_cmakeninja_configure
build_cmakeninja_build
build_cmakeninja_install

abinfo "Cleaning up ..."
rm -rv "$BLDDIR"

abinfo "Building gsettings-qt6..."
CMAKE_AFTER=(
    '-DENABLE_QT6=ON'
    '-DQT_MAJOR_VERSION=6'
    '-DQML_PLUGIN_DUMP=/usr/lib/qt6/bin/qmlplugindump'
    '-DCMAKE_INSTALL_PREFIX=/usr'
)
build_cmakeninja_configure
build_cmakeninja_build
build_cmakeninja_install
