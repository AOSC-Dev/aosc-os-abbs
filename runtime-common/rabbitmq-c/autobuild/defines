PKGNAME=rabbitmq-c
PKGSEC=libs
PKGDEP="glibc openssl popt"
BUILDDEP="xmlto"
PKGDES="Client library for RabbitMQ"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_API_DOCS=OFF'
    '-DBUILD_EXAMPLES=OFF'
    '-DBUILD_OSSFUZZ=OFF'
    '-DBUILD_SHARED_LIBS=ON'
    '-DBUILD_STATIC_LIBS=OFF'
    '-DBUILD_TESTING=OFF'
    '-DBUILD_TOOLS=ON'
    '-DENABLE_SSL_ENGINE_API=ON'
    '-DENABLE_SSL_SUPPORT=ON'
    '-DINSTALL_STATIC_LIBS=OFF'
    '-DRUN_SYSTEM_TESTS=OFF'
)

