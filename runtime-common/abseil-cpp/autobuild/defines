          protobuf-c<=1.5.2-1 proton-bridge<=3.21.2-12 qt-6<=6.11.1 \
          re2<=20251105 telegram-desktop<=6.9.3 \
          vlc<=3.0.23+2-3 webrtc-audio-processing<=2.1"

