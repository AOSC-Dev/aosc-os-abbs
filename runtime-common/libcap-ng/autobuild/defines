PKGNAME=libcap-ng
PKGSEC=libs
PKGDEP="glibc python-3"
PKGDEP__RETRO="glibc"
BUILDDEP="swig"
BUILDDEP__RETRO=""
PKGDES="Library to handle POSIX capabilities"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--enable-static=no'
    '--with-python3'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-python3'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
