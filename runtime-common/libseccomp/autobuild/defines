PKGNAME=libseccomp
PKGSEC=libs
PKGDEP="glibc"
BUILDDEP="gperf"
PKGDES="Enhanced seccomp library"

NOPARALLEL=1
NOSTATIC=0
NOSTATIC__RETRO=1

AUTOTOOLS_AFTER="--enable-static"

PKGEPOCH=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
# NOTE: no ia64 support.
FAIL_ARCH="!(mainline|i486|armv4|armv6hf|armv7hf|powerpc|ppc64|sparc64|hppa|sh4|loongson2f)"
