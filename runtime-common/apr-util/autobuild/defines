PKGNAME=apr-util
PKGSEC=libs
PKGDEP="apr expat nss openldap openssl postgresql-runtime"
BUILDDEP="postgresql"
PKGSUG="db gdbm mariadb postgresql sqlite unixodbc"
PKGSUG__RETRO="db gdbm sqlite"
BUILDDEP="${PKGSUG}"
BUILDDEP__RETRO="${PKGSUG__RETRO}"
PKGDES="Utilities for the Apache Portable Runtime"

AUTOTOOLS_AFTER=(
    '--with-apr=/usr'
    '--with-ldap'
    '--with-crypto'
    '--with-gdbm=/usr'
    '--with-sqlite3=/usr'
    '--with-nss=/usr'
    '--with-odbc=/usr'
    '--with-berkeley-db=no'
    '--with-pgsql=/usr'
    '--with-oracle=/usr'
    '--with-openssl=/usr'
    '--with-mysql=/usr'
    '--with-dbm=gdbm'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--without-odbc'
    '--without-pgsql'
    '--without-oracle'
)
