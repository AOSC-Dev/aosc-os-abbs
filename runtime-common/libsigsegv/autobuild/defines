PKGNAME=libsigsegv
PKGSEC=libs
PKGDEP="glibc"
PKGDES="Page fault detection library"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--enable-shared'
)
AUTOTOOLS_AFTER__ALPHA=(
    "${AUTOTOOLS_AFTER[@]}"
    # FIXME: configure misdetects the host system as NetBSD (Alpha), the
    # test file, $srcdir/src/fault-netbsd-alpha.c, should have failed to
    # compile (thereby failing the test, instead of considering the system
    # as NetBSD) - but it didn't.
    #
    # fault-netbsd-alpha.h:18:10: fatal error: machine/reg.h: No such file or directory
    #    18 | #include <machine/reg.h>
    #       |          ^~~~~~~~~~~~~~~
    # compilation terminated.
    'sv_cv_fault_netbsd_alpha=no'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
