PKGNAME=amarok-trinity
PKGSEC=Trinity
PKGDEP="akode libgpod libifp libmtp libnjb libvisual mp4v2 sdl12-compat \
        sqlite taglib tdebase xine-lib ruby postgresql-runtime"
BUILDDEP="tde-common-cmake postgresql"
PKGSUG="postgresql"
PKGDES="Audio player and library manager for the Trinity Desktop Environment"

CMAKE_AFTER=(
	"-DLIB_INSTALL_DIR=/usr/lib"
	"-DBUILD_ALL=ON"
	"-DWITH_ALL_OPTIONS=ON"
	"-DWITH_EMBEDDED_SQLITE=OFF"
	"-DWITH_GCC_VISIBILITY=OFF"
	"-DWITH_MYSQL=ON"
	"-DWITH_POSTGRESQL=ON"
	"-DWITH_XINE=ON"
	"-DWITH_YAUAP=ON"
)
CMAKE_AFTER__RETRO=(
	"${CMAKE_AFTER[@]}"
	"-DWITH_MYSQL=OFF"
	"-DWITH_POSTGRESQL=OFF"
	"-DWITH_XINE=OFF"
	"-DWITH_YAUAP=OFF"
)

PKGCONFL="amarok"

# Note: Required for component discovery.
NOLIBTOOL=0
