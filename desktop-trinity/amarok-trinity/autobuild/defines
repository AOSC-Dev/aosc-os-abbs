PKGNAME=amarok-trinity
PKGSEC=Trinity
# Ruby for DAAP support.
PKGDEP="akode libgpod libifp libmtp libnjb libvisual mp4v2 sdl12-compat \
        sqlite taglib tdebase xine-lib ruby postgresql-runtime"
PKGDEP__RETRO="akode libgpod libifp libmtp libnjb libvisual mp4v2 sdl12-compat \
               sqlite taglib tdebase ruby"
BUILDDEP="tde-common-cmake postgresql"
BUILDDEP__RETRO="tde-common-cmake"
PKGDES="Audio player and library manager for the Trinity Desktop Environment"
PKGSUG="postgresql"

ABTYPE=cmakeninja
CMAKE_AFTER=(
	"-DLIB_INSTALL_DIR=/usr/lib"
	"-DBUILD_ALL=ON"
	"-DWITH_ALL_OPTIONS=ON"
	"-DWITH_EMBEDDED_SQLITE=OFF"
	"-DWITH_GCC_VISIBILITY=OFF"
	"-DWITH_MYSQL=ON"
	"-DWITH_POSTGRESQL=ON"
	"-DWITH_XINE=ON"
	"-DWITH_YAUAP=ON"
)
CMAKE_AFTER__RETRO=(
	"${CMAKE_AFTER[@]}"
	"-DWITH_MYSQL=OFF"
	"-DWITH_POSTGRESQL=OFF"
	"-DWITH_XINE=OFF"
	"-DWITH_YAUAP=OFF"
)

PKGCONFL="amarok"

NOLIBTOOL=0
# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
