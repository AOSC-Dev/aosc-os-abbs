PKGNAME=kaffeine-trinity
PKGSEC=Trinity
PKGDEP="gst-plugins-base-1-0 lame libcdio-paranoia libdvbpsi libogg tdelibs xine-lib"
PKGDEP__RETRO="lame libcdio-paranoia libdvbpsi libogg tdelibs xine-lib"
BUILDDEP="tde-common-cmake"
PKGDES="Media player for the Trinity Desktop Environment"

CMAKE_AFTER=(
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DBUILD_ALL=ON'
    '-DUSE_TQT_ONLY=OFF'
    '-DWITH_XINIT_WORKAROUND=OFF'
    '-DWITH_ALL_OPTIONS=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DWITH_GSTREAMER=OFF'
)

PKGCONFL="kaffeine"

# Note: Required for component discovery.
NOLIBTOOL=0
