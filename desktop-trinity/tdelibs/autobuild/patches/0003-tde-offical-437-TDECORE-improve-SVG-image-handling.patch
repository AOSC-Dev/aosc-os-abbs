+
+    ok &= checkRender("basic",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\" viewBox=\"0 0 64 32\">"
+        "<rect width=\"64\" height=\"32\" fill=\"#336699\"/>"
+        "</svg>");
+
+    ok &= checkRender("gradient-whitespace",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\">"
+        "<defs><linearGradient id=\"g\">\n"
+        " <stop offset=\"0\" style=\"stop-color:#000000;stop-opacity:1\"/>\n"
+        " <stop offset=\"1\" style=\"stop-color:#ffffff;stop-opacity:1\"/>\n"
+        "</linearGradient></defs><rect width=\"64\" height=\"32\" fill=\"url(#g)\"/>"
+        "</svg>");
+
+    ok &= checkRender("odd-points",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\">"
+        "<polygon points=\"1,30 32,1 63\"/><circle cx=\"32\" cy=\"16\" r=\"6\"/>"
+        "</svg>");
+
+    ok &= checkRender("malformed-style",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\">"
+        "<rect width=\"64\" height=\"32\" style=\"fill:#ddeeff;broken-token;stroke:#000000\"/>"
+        "</svg>");
+
+    ok &= checkRender("malformed-transform",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\">"
+        "<g transform=\"rotate() broken scale(\"><rect width=\"20\" height=\"20\"/></g>"
+        "</svg>");
+
+    ok &= checkRender("malformed-rgb",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\">"
+        "<rect width=\"64\" height=\"32\" fill=\"rgb(1,2)\"/>"
+        "</svg>");
+
+    ok &= checkRender("valid-transform",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"32\">"
+        "<g transform=\"translate(4,2) scale(1.2) rotate(5)\"><rect width=\"20\" height=\"10\"/></g>"
+        "</svg>");
+
+    ok &= checkRejected("malformed-xml",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\"><rect>");
+    ok &= checkRejected("malformed-viewbox",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 broken 20\"><rect/></svg>");
+
+    ok &= checkExternalImagePolicy();
+
+    if (!ok)
+        return 1;
+
+    printf("KSVGIconEngine SVG data tests: PASS\n");
+    return 0;
+}
