@@ -0,0 +1,191 @@
+/*
+    Regression tests for KSVGIconEngine byte-array loading.
+
+    These checks are intentionally small and dependency-free so malformed SVG
+    supplied by TDEHTML can be exercised without a browser process.
+*/
+
+#include "svgicons/ksvgiconengine.h"
+
+#include <tqcolor.h>
+#include <tqcstring.h>
+#include <tqfile.h>
+#include <tqimage.h>
+#include <tqstring.h>
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static TQByteArray bytes(const TQString &text)
+{
+    TQCString utf8 = text.utf8();
+    TQByteArray data(utf8.length());
+    if (data.size())
+        memcpy(data.data(), utf8.data(), data.size());
+    return data;
+}
+
+static bool checkRender(const char *name, const TQString &svg, int width = 64, int height = 32)
+{
+    fprintf(stderr, "RUN: %s\n", name);
+    fflush(stderr);
+
+    KSVGIconEngine engine;
+    if (!engine.loadData(width, height, bytes(svg))) {
+        fprintf(stderr, "%s: loadData() failed\n", name);
+        return false;
+    }
+
+    TQImage *image = engine.image();
+    if (!image) {
+        fprintf(stderr, "%s: image() returned null\n", name);
+        return false;
+    }
+
+    bool ok = !image->isNull() && image->width() == width && image->height() == height;
+    if (!ok) {
+        fprintf(stderr, "%s: unexpected output image size %dx%d\n",
+                name, image->width(), image->height());
+    }
+    delete image;
+    return ok;
+}
+
+static bool checkRejected(const char *name, const TQString &svg)
+{
+    fprintf(stderr, "RUN: %s\n", name);
+    fflush(stderr);
+
+    KSVGIconEngine engine;
+    if (engine.loadData(64, 32, bytes(svg))) {
+        fprintf(stderr, "%s: malformed input was accepted\n", name);
+        return false;
+    }
+    return true;
+}
+
+static bool checkExternalImagePolicy()
+{
+    fprintf(stderr, "RUN: external-image-policy\n");
+    fflush(stderr);
+
+    TQString ppmPath = TQString("/tmp/ksvgiconenginetest-%1.ppm").arg((long)getpid());
+
+    // A 1x1 opaque magenta PPM used to check whether an external image is
+    // actually loaded by the SVG engine.
+    TQFile ppm(ppmPath);
+    if (!ppm.open(IO_WriteOnly)) {
+        fprintf(stderr, "external-image-policy: cannot create temporary PPM\n");
+        return false;
+    }
+    const char ppmData[] = "P6\n1 1\n255\n\377\000\377";
+    ppm.writeBlock(ppmData, sizeof(ppmData) - 1);
+    ppm.close();
+
+    TQString svg = TQString::fromLatin1(
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" "
+        "xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"20\" height=\"20\">"
+        "<image x=\"0\" y=\"0\" width=\"20\" height=\"20\" xlink:href=\"%1\"/>"
+        "</svg>").arg(ppmPath);
+
+    bool ok = true;
+
+    // Preserve the historical behaviour by default.
+    KSVGIconEngine defaultEngine;
+    if (!defaultEngine.allowExternalImages()) {
+        fprintf(stderr, "external-image-policy: external images are not enabled by default\n");
+        ok = false;
+    }
+    else if (!defaultEngine.loadData(20, 20, bytes(svg))) {
+        fprintf(stderr, "external-image-policy: default SVG failed to render\n");
+        ok = false;
+    }
+    else {
+        TQImage *image = defaultEngine.image();
+        if (!image || image->isNull() || tqAlpha(image->pixel(10, 10)) == 0) {
+            fprintf(stderr, "external-image-policy: default behaviour changed\n");
+            ok = false;
+        }
+        delete image;
+    }
+
+    // Consumers handling untrusted content can explicitly disable it.
+    KSVGIconEngine restrictedEngine;
+    restrictedEngine.setAllowExternalImages(false);
+    if (restrictedEngine.allowExternalImages()) {
+        fprintf(stderr, "external-image-policy: external images were not disabled\n");
+        ok = false;
+    }
+    else if (!restrictedEngine.loadData(20, 20, bytes(svg))) {
+        fprintf(stderr, "external-image-policy: restricted SVG failed to render\n");
+        ok = false;
+    }
+    else {
+        TQImage *image = restrictedEngine.image();
+        if (!image || image->isNull() || tqAlpha(image->pixel(10, 10)) != 0) {
+            fprintf(stderr, "external-image-policy: restricted SVG read a local file\n");
+            ok = false;
+        }
+        delete image;
+    }
+
+    TQFile::remove(ppmPath);
+    return ok;
+}
+
+int main()
+{
