From 6b6e8bd7693e89ea1606d4c30c70f04f16c9e2f0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sebasti=C3=A3o=20Guerra?= <sebastiao.luiz.guerra@gmail.com>
Date: Wed, 14 Oct 2026 22:27:32 -0300
Subject: [PATCH 1/2] tdehtml: apply SVG viewBox origin
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Sebastião Guerra <sebastiao.luiz.guerra@gmail.com>
---
 tdecore/svgicons/ksvgiconengine.cpp  |  7 +++-
 tdecore/tests/ksvgiconenginetest.cpp | 62 ++++++++++++++++++++++++----
 2 files changed, 59 insertions(+), 10 deletions(-)

diff --git a/tdecore/svgicons/ksvgiconengine.cpp b/tdecore/svgicons/ksvgiconengine.cpp
index a68a0859f..45263e14c 100644
--- a/tdecore/svgicons/ksvgiconengine.cpp
+++ b/tdecore/svgicons/ksvgiconengine.cpp
@@ -761,6 +761,8 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 		return false;
 
 	bool hasViewBox = rootElement.hasAttribute("viewBox");
+	double viewBoxX = 0.0;
+	double viewBoxY = 0.0;
 	double viewBoxWidth = 0.0;
 	double viewBoxHeight = 0.0;
 	if(hasViewBox)
@@ -775,8 +777,8 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 		bool okY = false;
 		bool okWidth = false;
 		bool okHeight = false;
-		points[0].toDouble(&okX);
-		points[1].toDouble(&okY);
+		viewBoxX = points[0].toDouble(&okX);
+		viewBoxY = points[1].toDouble(&okY);
 		viewBoxWidth = points[2].toDouble(&okWidth);
 		viewBoxHeight = points[3].toDouble(&okHeight);
 		if(!okX || !okY || !okWidth || !okHeight || viewBoxWidth <= 0.0 || viewBoxHeight <= 0.0)
@@ -827,6 +829,7 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 		d->height = viewBoxHeight;
 
 		d->painter->worldMatrix()->scale(vratiow, vratioh);
+		d->painter->worldMatrix()->translate(-viewBoxX, -viewBoxY);
 	}
 	else
 	{
diff --git a/tdecore/tests/ksvgiconenginetest.cpp b/tdecore/tests/ksvgiconenginetest.cpp
index 2d0efcdc5..dfde18b88 100644
--- a/tdecore/tests/ksvgiconenginetest.cpp
+++ b/tdecore/tests/ksvgiconenginetest.cpp
@@ -10,15 +10,15 @@
 #include <tqcolor.h>
 #include <tqbuffer.h>
 #include <tqcstring.h>
-#include <tqfile.h>
 #include <tqimage.h>
 #include <tqstring.h>
 
 #include <kmdcodec.h>
+#include <tdetempfile.h>
+#include <tdeinstance.h>
 
 #include <stdio.h>
 #include <string.h>
-#include <unistd.h>
 
 static TQByteArray bytes(const TQString &text)
 {
@@ -206,23 +206,61 @@ static bool checkViewBoxFailurePreservesPainter()
     return preserved;
 }
 
+static bool checkViewBoxOrigin(const char *name, const TQString &svg)
+{
+    fprintf(stderr, "RUN: %s\n", name);
+    fflush(stderr);
+
+    KSVGIconEngine engine;
+    if (!engine.loadData(40, 30, bytes(svg))) {
+        fprintf(stderr, "%s: SVG failed to load\n", name);
+        return false;
+    }
+
+    TQImage *image = engine.image();
+    if (!image || image->isNull()) {
+        fprintf(stderr, "%s: no rendered image\n", name);
+        delete image;
+        return false;
+    }
+
+    const TQRgb inside = image->pixel(4, 3);
+    const TQRgb outsideX = image->pixel(9, 3);
+    const TQRgb outsideY = image->pixel(4, 7);
+    const bool ok = tqRed(inside) > 200 && tqGreen(inside) < 50 && tqBlue(inside) > 200 &&
+                    tqAlpha(outsideX) == 0 && tqAlpha(outsideY) == 0;
+    if (!ok)
+        fprintf(stderr, "%s: viewBox origin or nonuniform scaling was not applied\n", name);
+    delete image;
+    return ok;
+}
+
 static bool checkExternalImagePolicy()
 {
     fprintf(stderr, "RUN: external-image-policy\n");
     fflush(stderr);
 
-    TQString ppmPath = TQString("/tmp/ksvgiconenginetest-%1.ppm").arg((long)getpid());
+    KTempFile ppmFile(TQString::null, ".ppm");
+    ppmFile.setAutoDelete(true);
+    if (ppmFile.status() != 0) {
+        fprintf(stderr, "external-image-policy: cannot create temporary PPM\n");
+        return false;
+    }
 
     // A 1x1 opaque magenta PPM used to check whether an external image is
     // actually loaded by the SVG engine.
-    TQFile ppm(ppmPath);
-    if (!ppm.open(IO_WriteOnly)) {
+    FILE *ppm = ppmFile.fstream();
+    if (!ppm) {
         fprintf(stderr, "external-image-policy: cannot create temporary PPM\n");
         return false;
     }
     const char ppmData[] = "P6\n1 1\n255\n\377\000\377";
-    ppm.writeBlock(ppmData, sizeof(ppmData) - 1);
-    ppm.close();
+    if (fwrite(ppmData, 1, sizeof(ppmData) - 1, ppm) != sizeof(ppmData) - 1 ||
+        !ppmFile.close()) {
+        fprintf(stderr, "external-image-policy: cannot write temporary PPM\n");
+        return false;
+    }
+    const TQString ppmPath = ppmFile.name();
 
     TQString svg = TQString::fromLatin1(
         "<svg xmlns=\"http://www.w3.org/2000/svg\" "
@@ -273,12 +311,12 @@ static bool checkExternalImagePolicy()
         delete image;
     }
 
-    TQFile::remove(ppmPath);
     return ok;
 }
 
 int main()
 {
+    TDEInstance instance("ksvgiconenginetest");
     bool ok = true;
 
     ok &= checkRender("basic",
@@ -327,6 +365,14 @@ int main()
     ok &= checkExternalImagePolicy();
     ok &= checkEmbeddedImageDataPolicy();
     ok &= checkViewBoxFailurePreservesPainter();
+    ok &= checkViewBoxOrigin("viewbox-nonzero-origin",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"10 20 100 100\">"
+        "<rect x=\"10\" y=\"20\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
+        "</svg>");
+    ok &= checkViewBoxOrigin("viewbox-zero-origin",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\">"
+        "<rect x=\"0\" y=\"0\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
+        "</svg>");
 
     if (!ok)
         return 1;
-- 
