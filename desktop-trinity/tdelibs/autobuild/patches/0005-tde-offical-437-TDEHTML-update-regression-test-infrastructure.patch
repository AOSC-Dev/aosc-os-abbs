From cb8f521d3ab397b2907b7816eae8770e9ad90e23 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sebasti=C3=A3o=20Guerra?= <sebastiao.luiz.guerra@gmail.com>
Date: Sun, 13 Sep 2026 09:50:21 -0300
Subject: [PATCH 3/7] TDEHTML: update regression test infrastructure
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Make the historical TDEHTML regression runner buildable on current systems.

Handle installations without the private TQt font engine header and fix compatibility issues found while running the SVG regression tests.

Signed-off-by: Sebastião Guerra <sebastiao.luiz.guerra@gmail.com>
---
 tdehtml/CMakeLists.txt      | 28 ++++++++++++++++++++++++++++
 tdehtml/test_regression.cpp |  9 +++++----
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/tdehtml/CMakeLists.txt b/tdehtml/CMakeLists.txt
index 70fea75bd..3f82a990d 100644
--- a/tdehtml/CMakeLists.txt
+++ b/tdehtml/CMakeLists.txt
@@ -139,3 +139,31 @@ tde_add_kpart( ${target}
   LINK tdehtml-shared
   DESTINATION ${PLUGIN_INSTALL_DIR}
 )
+
+
+##### regression test harness ####################
+
+# Keep the historical TDEHTML regression runner available from the
+# CMake build.  It is intentionally not registered as a plain CTest
+# because it needs an explicit regression data directory.
+set( testregression_SRCS test_regression.cpp )
+
+# test_regression_fontoverload.cpp uses TQt's private font engine API to
+# make paint dumps deterministic.  Some distributions do not install that
+# private header, so keep the regression runner usable without it.
+find_path( TQT_QFONTENGINE_PRIVATE_DIR
+  NAMES qfontengine_p.h
+  PATHS ${TQT_INCLUDE_DIRS}
+  PATH_SUFFIXES private
+)
+
+if( TQT_QFONTENGINE_PRIVATE_DIR )
+  list( APPEND testregression_SRCS test_regression_fontoverload.cpp )
+else()
+  message( STATUS "TQt private qfontengine_p.h not found; testregression will use the system font engine" )
+endif()
+
+tde_add_check_executable( testregression AUTOMOC
+  SOURCES ${testregression_SRCS}
+  LINK tdehtml-shared kjs-shared
+)
diff --git a/tdehtml/test_regression.cpp b/tdehtml/test_regression.cpp
index 81b0b9a4e..0f9dd70ca 100644
--- a/tdehtml/test_regression.cpp
+++ b/tdehtml/test_regression.cpp
@@ -39,7 +39,7 @@
 #include <stdio.h>
 
 #include "css/cssstyleselector.h"
-#include <dom_string.h>
+#include "dom/dom_string.h"
 #include "rendering/render_style.h"
 #include "rendering/render_layer.h"
 #include "tdehtmldefaults.h"
@@ -661,7 +661,8 @@ int main(int argc, char *argv[])
     tdehtml::CSSStyleSelector::clear();
     tdehtml::RenderStyle::cleanup();
 
-    kill( xvfb, SIGINT );
+    if ( xvfb > 0 )
+        kill( xvfb, SIGINT );
 
     return rv;
 }
@@ -1141,7 +1142,7 @@ void RegressionTest::doFailureReport( const TQString& test, int failures )
         FILE *pipe = popen( TQString::fromLatin1( "diff -u baseline/%1-render %3/%2-render" )
                             .arg ( test, test, relOutputDir ).latin1(), "r" );
         TQTextIStream *is = new TQTextIStream( pipe );
-        for ( int line = 0; line < 100 && !is->eof(); ++line ) {
+        for ( int lineNumber = 0; lineNumber < 100 && !is->eof(); ++lineNumber ) {
             TQString line = is->readLine();
             line = line.replace( '<', "&lt;" );
             line = line.replace( '>', "&gt;" );
@@ -1157,7 +1158,7 @@ void RegressionTest::doFailureReport( const TQString& test, int failures )
         FILE *pipe = popen( TQString::fromLatin1( "diff -u baseline/%1-dom %3/%2-dom" )
                             .arg ( test, test, relOutputDir ).latin1(), "r" );
         TQTextIStream *is = new TQTextIStream( pipe );
-        for ( int line = 0; line < 100 && !is->eof(); ++line ) {
+        for ( int lineNumber = 0; lineNumber < 100 && !is->eof(); ++lineNumber ) {
             TQString line = is->readLine();
             line = line.replace( '<', "&lt;" );
             line = line.replace( '>', "&gt;" );
-- 
