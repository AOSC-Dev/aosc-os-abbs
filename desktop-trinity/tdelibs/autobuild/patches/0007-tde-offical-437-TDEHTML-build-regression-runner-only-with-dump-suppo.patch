From d9a311499829a72c37169f03e8e2086f57b9a782 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sebasti=C3=A3o=20Guerra?= <sebastiao.luiz.guerra@gmail.com>
Date: Thu, 1 Oct 2026 10:04:20 -0300
Subject: [PATCH 5/7] TDEHTML: build regression runner only with dump support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The historical runner calls RenderLayer::dump(), so register it only when that API is compiled.

Signed-off-by: Sebastião Guerra <sebastiao.luiz.guerra@gmail.com>
---
 tdehtml/CMakeLists.txt | 28 ++++++++++++++++++++++++----
 1 file changed, 24 insertions(+), 4 deletions(-)

diff --git a/tdehtml/CMakeLists.txt b/tdehtml/CMakeLists.txt
index 3f82a990d..a27aca5bb 100644
--- a/tdehtml/CMakeLists.txt
+++ b/tdehtml/CMakeLists.txt
@@ -163,7 +163,27 @@ else()
   message( STATUS "TQt private qfontengine_p.h not found; testregression will use the system font engine" )
 endif()
 
-tde_add_check_executable( testregression AUTOMOC
-  SOURCES ${testregression_SRCS}
-  LINK tdehtml-shared kjs-shared
-)
+# RenderLayer::dump() is compiled when the active C++ configuration omits NDEBUG.
+string( TOUPPER "${CMAKE_BUILD_TYPE}" _tdehtml_build_type )
+set( _tdehtml_active_cxx_flags "${CMAKE_CXX_FLAGS_${_tdehtml_build_type}}" )
+set( _tdehtml_saved_required_flags "${CMAKE_REQUIRED_FLAGS}" )
+set( CMAKE_REQUIRED_FLAGS "${CMAKE_REQUIRED_FLAGS} ${_tdehtml_active_cxx_flags}" )
+unset( TDEHTML_HAS_RENDERLAYER_DUMP CACHE )
+unset( TDEHTML_HAS_RENDERLAYER_DUMP )
+check_cxx_source_compiles( "
+#ifdef NDEBUG
+#error NDEBUG disables RenderLayer::dump()
+#endif
+int main() { return 0; }"
+  TDEHTML_HAS_RENDERLAYER_DUMP )
+set( CMAKE_REQUIRED_FLAGS "${_tdehtml_saved_required_flags}" )
+unset( _tdehtml_build_type )
+unset( _tdehtml_active_cxx_flags )
+unset( _tdehtml_saved_required_flags )
+
+if( TDEHTML_HAS_RENDERLAYER_DUMP )
+  tde_add_check_executable( testregression AUTOMOC
+    SOURCES ${testregression_SRCS}
+    LINK tdehtml-shared kjs-shared
+  )
+endif()
-- 
