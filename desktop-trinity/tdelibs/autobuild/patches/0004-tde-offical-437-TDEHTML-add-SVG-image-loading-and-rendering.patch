 static TQString buildAcceptHeader()
 {
+#ifdef HAVE_LIBART
+    return "image/png, image/jpeg, image/svg+xml, video/x-mng, image/jp2, image/gif;q=0.5,*/*;q=0.1";
+#else
     return "image/png, image/jpeg, video/x-mng, image/jp2, image/gif;q=0.5,*/*;q=0.1";
+#endif
+}
+
+#ifdef HAVE_LIBART
+static bool svgLengthToPixels(const TQString &text, double &pixels)
+{
+    TQString value = text.stripWhiteSpace().lower();
+    if (value.isEmpty() || value.endsWith("%") || value.endsWith("em") || value.endsWith("ex"))
+        return false;
+
+    double multiplier = 1.0;
+    int suffixLength = 0;
+    const double dpi = 90.0; // Keep in sync with KSVGIconPainter::dpi().
+
+    if (value.endsWith("px")) {
+        suffixLength = 2;
+    } else if (value.endsWith("cm")) {
+        multiplier = dpi / 2.54;
+        suffixLength = 2;
+    } else if (value.endsWith("mm")) {
+        multiplier = dpi / 25.4;
+        suffixLength = 2;
+    } else if (value.endsWith("in")) {
+        multiplier = dpi;
+        suffixLength = 2;
+    } else if (value.endsWith("pt")) {
+        multiplier = dpi / 72.0;
+        suffixLength = 2;
+    } else if (value.endsWith("pc")) {
+        multiplier = dpi / 6.0;
+        suffixLength = 2;
+    }
+
+    if (suffixLength)
+        value.truncate(value.length() - suffixLength);
+
+    bool ok = false;
+    double number = value.toDouble(&ok);
+    if (!ok || number <= 0.0)
+        return false;
+
+    pixels = number * multiplier;
+    return pixels > 0.0;
 }
 
+static bool svgViewBoxRatio(const TQDomElement &root, double &ratio)
+{
+    if (!root.hasAttribute("viewBox"))
+        return false;
+
+    TQString viewBox = root.attribute("viewBox");
+    viewBox.replace(',', ' ');
+    TQStringList values = TQStringList::split(TQRegExp("\\s+"), viewBox.simplifyWhiteSpace());
+    if (values.count() != 4)
+        return false;
+
+    bool okWidth = false;
+    bool okHeight = false;
+    double width = values[2].toDouble(&okWidth);
+    double height = values[3].toDouble(&okHeight);
+    if (!okWidth || !okHeight || width <= 0.0 || height <= 0.0)
+        return false;
+
+    ratio = width / height;
+    return ratio > 0.0;
+}
+
+static TQSize svgIntrinsicSize(const TQDomElement &root)
+{
+    double width = 0.0;
+    double height = 0.0;
+    bool hasWidth = root.hasAttribute("width") && svgLengthToPixels(root.attribute("width"), width);
+    bool hasHeight = root.hasAttribute("height") && svgLengthToPixels(root.attribute("height"), height);
+
+    double ratio = 0.0;
+    bool hasRatio = svgViewBoxRatio(root, ratio);
+
+    if (!hasWidth && !hasHeight) {
+        width = 300.0;
+        height = 150.0;
+    } else if (hasWidth && !hasHeight) {
+        height = hasRatio ? width / ratio : 150.0;
+    } else if (!hasWidth && hasHeight) {
+        width = hasRatio ? height * ratio : 300.0;
+    }
+
+    // SVG dimensions come from untrusted input. Avoid tiny XML files causing
+    // unbounded raster allocations before TDEHTML gets a chance to lay them out.
+    const double maxDimension = 4096.0;
+    if (width > maxDimension || height > maxDimension) {
+        double scale = kMin(maxDimension / width, maxDimension / height);
+        width *= scale;
+        height *= scale;
+    }
+
+    int pixelWidth = kMax(1, static_cast<int>(width + 0.5));
+    int pixelHeight = kMax(1, static_cast<int>(height + 0.5));
+    return TQSize(pixelWidth, pixelHeight);
+}
+#endif
