 }
 
+#ifdef HAVE_LIBART
+bool CachedImage::renderSVG(int width, int height, TQPixmap &pixmap) const
+{
+    if (svgData.size() == 0 || width <= 0 || height <= 0)
+        return false;
+
+    KSVGIconEngine engine;
+    engine.setAllowExternalImages(false);
+    if (!engine.loadData(width, height, svgData))
+        return false;
+
+    TQImage *image = engine.image();
+    if (!image)
+        return false;
+
+    bool ok = !image->isNull() && pixmap.convertFromImage(*image);
+    delete image;
+    return ok && !pixmap.isNull();
+}
+
+bool CachedImage::loadSVG(const TQByteArray &data)
+{
+    if (data.size() == 0)
+        return false;
+
+    TQDomDocument document("svg");
+    if (!document.setContent(data))
+        return false;
+
+    TQDomElement root = document.documentElement();
+    TQString tagName = root.tagName().lower();
+    if (tagName != "svg" && !tagName.endsWith(":svg"))
+        return false;
+
+    TQSize size = svgIntrinsicSize(root);
+
+    svgData = data;
+    m_isSVG = true;
+
+    TQPixmap *svgPixmap = new TQPixmap;
+    if (!renderSVG(size.width(), size.height(), *svgPixmap)) {
+        delete svgPixmap;
+        svgData.resize(0);
+        m_isSVG = false;
+        return false;
+    }
+
+    delete p;
+    p = svgPixmap;
+    return true;
+}
+#endif
