From e2d405dc41135696e606847e80ff62570ac3a33c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sebasti=C3=A3o=20Guerra?= <sebastiao.luiz.guerra@gmail.com>
Date: Fri, 16 Oct 2026 17:15:07 -0300
Subject: [PATCH 7/7] tdecore: validate SVG viewBox syntax
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Sebastião Guerra <sebastiao.luiz.guerra@gmail.com>
---
 tdecore/svgicons/ksvgiconengine.cpp  | 33 +++++++++++----
 tdecore/tests/ksvgiconenginetest.cpp | 61 +++++++++++++++++++++-------
 2 files changed, 72 insertions(+), 22 deletions(-)

diff --git a/tdecore/svgicons/ksvgiconengine.cpp b/tdecore/svgicons/ksvgiconengine.cpp
index 45263e14c..f65b88b21 100644
--- a/tdecore/svgicons/ksvgiconengine.cpp
+++ b/tdecore/svgicons/ksvgiconengine.cpp
@@ -27,6 +27,7 @@
 
 #include <kmdcodec.h>
 
+#include <float.h>
 #include <limits.h>
 
 #include <zlib.h>
@@ -765,11 +766,20 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 	double viewBoxY = 0.0;
 	double viewBoxWidth = 0.0;
 	double viewBoxHeight = 0.0;
+	double viewBoxRatioW = 0.0;
+	double viewBoxRatioH = 0.0;
 	if(hasViewBox)
 	{
-		TQString viewBox = rootElement.attribute("viewBox");
-		viewBox.replace(',', ' ');
-		TQStringList points = TQStringList::split(TQRegExp("\\s+"), viewBox.simplifyWhiteSpace());
+		TQString viewBox = rootElement.attribute("viewBox").simplifyWhiteSpace();
+		TQString number = "[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][+-]?[0-9]+)?";
+		TQString separator = "([\\s]*,[\\s]*|[\\s]+)";
+		TQRegExp viewBoxPattern(
+			"^[\\s]*" + number + separator + number + separator +
+			number + separator + number + "[\\s]*$");
+		if(!viewBoxPattern.exactMatch(viewBox))
+			return false;
+
+		TQStringList points = TQStringList::split(TQRegExp("[,\\s]+"), viewBox);
 		if(points.count() != 4)
 			return false;
 
@@ -781,7 +791,17 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 		viewBoxY = points[1].toDouble(&okY);
 		viewBoxWidth = points[2].toDouble(&okWidth);
 		viewBoxHeight = points[3].toDouble(&okHeight);
-		if(!okX || !okY || !okWidth || !okHeight || viewBoxWidth <= 0.0 || viewBoxHeight <= 0.0)
+		if(!okX || !okY || !okWidth || !okHeight ||
+			!(viewBoxWidth > 0.0) || !(viewBoxHeight > 0.0) ||
+			!(viewBoxX <= DBL_MAX && viewBoxX >= -DBL_MAX) ||
+			!(viewBoxY <= DBL_MAX && viewBoxY >= -DBL_MAX) ||
+			viewBoxWidth > DBL_MAX || viewBoxHeight > DBL_MAX)
+			return false;
+
+		viewBoxRatioW = width / viewBoxWidth;
+		viewBoxRatioH = height / viewBoxHeight;
+		if(!(viewBoxRatioW > 0.0) || !(viewBoxRatioH > 0.0) ||
+			viewBoxRatioW > DBL_MAX || viewBoxRatioH > DBL_MAX)
 			return false;
 	}
 
@@ -822,13 +842,10 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 	// Apply viewbox
 	if(hasViewBox)
 	{
-		double vratiow = width / viewBoxWidth;
-		double vratioh = height / viewBoxHeight;
-
 		d->width = viewBoxWidth;
 		d->height = viewBoxHeight;
 
-		d->painter->worldMatrix()->scale(vratiow, vratioh);
+		d->painter->worldMatrix()->scale(viewBoxRatioW, viewBoxRatioH);
 		d->painter->worldMatrix()->translate(-viewBoxX, -viewBoxY);
 	}
 	else
diff --git a/tdecore/tests/ksvgiconenginetest.cpp b/tdecore/tests/ksvgiconenginetest.cpp
index dfde18b88..648b2a52d 100644
--- a/tdecore/tests/ksvgiconenginetest.cpp
+++ b/tdecore/tests/ksvgiconenginetest.cpp
@@ -62,7 +62,7 @@ static bool checkRejected(const char *name, const TQString &svg)
 
     KSVGIconEngine engine;
     if (engine.loadData(64, 32, bytes(svg))) {
-        fprintf(stderr, "%s: malformed input was accepted\n", name);
+        fprintf(stderr, "%s: invalid input was accepted\n", name);
         return false;
     }
     return true;
@@ -190,20 +190,29 @@ static bool checkViewBoxFailurePreservesPainter()
     const TQRgb expected = before->pixel(10, 10);
     delete before;
 
-    const TQString invalidSVG = TQString::fromLatin1(
-        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 broken 20\">"
-        "<rect width=\"20\" height=\"20\" fill=\"#0000ff\"/></svg>");
-    if (engine.loadData(20, 20, bytes(invalidSVG))) {
-        fprintf(stderr, "viewbox-failure-preserves-painter: invalid SVG was accepted\n");
-        return false;
-    }
+    const TQString invalidSVGs[] = {
+        TQString::fromLatin1(
+            "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 broken 20\">"
+            "<rect width=\"20\" height=\"20\" fill=\"#0000ff\"/></svg>"),
+        TQString::fromLatin1(
+            "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 5e-308 100\">"
+            "<rect width=\"20\" height=\"20\" fill=\"#0000ff\"/></svg>")
+    };
+    for (unsigned int i = 0; i < sizeof(invalidSVGs) / sizeof(invalidSVGs[0]); ++i) {
+        if (engine.loadData(20, 20, bytes(invalidSVGs[i]))) {
+            fprintf(stderr, "viewbox-failure-preserves-painter: invalid SVG was accepted\n");
+            return false;
+        }
 
-    TQImage *after = engine.image();
-    const bool preserved = after && !after->isNull() && after->pixel(10, 10) == expected;
-    delete after;
-    if (!preserved)
-        fprintf(stderr, "viewbox-failure-preserves-painter: prior render was replaced\n");
-    return preserved;
+        TQImage *after = engine.image();
+        const bool preserved = after && !after->isNull() && after->pixel(10, 10) == expected;
+        delete after;
+        if (!preserved) {
+            fprintf(stderr, "viewbox-failure-preserves-painter: prior render was replaced\n");
+            return false;
+        }
+    }
+    return true;
 }
 
 static bool checkViewBoxOrigin(const char *name, const TQString &svg)
@@ -361,6 +370,18 @@ int main()
         "<svg xmlns=\"http://www.w3.org/2000/svg\"><rect>");
     ok &= checkRejected("malformed-viewbox",
         "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 broken 20\"><rect/></svg>");
+    ok &= checkRejected("malformed-viewbox-separators",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"10,,20,100,100\"><rect/></svg>");
+    ok &= checkRejected("wrong-viewbox-value-count",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100\"><rect/></svg>");
+    ok &= checkRejected("zero-viewbox-width",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 0 100\"><rect/></svg>");
+    ok &= checkRejected("zero-viewbox-height",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 0\"><rect/></svg>");
+    ok &= checkRejected("negative-viewbox-width",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 -100 100\"><rect/></svg>");
+    ok &= checkRejected("overflowing-viewbox-width",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1e999 100\"><rect/></svg>");
 
     ok &= checkExternalImagePolicy();
     ok &= checkEmbeddedImageDataPolicy();
@@ -369,6 +390,18 @@ int main()
         "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"10 20 100 100\">"
         "<rect x=\"10\" y=\"20\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
         "</svg>");
+    ok &= checkViewBoxOrigin("viewbox-comma-nonzero-origin",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"10,20,100,100\">"
+        "<rect x=\"10\" y=\"20\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
+        "</svg>");
+    ok &= checkViewBoxOrigin("viewbox-comma-whitespace-nonzero-origin",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"10, 20, 100, 100\">"
+        "<rect x=\"10\" y=\"20\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
+        "</svg>");
+    ok &= checkViewBoxOrigin("viewbox-mixed-nonzero-origin",
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"10 20,100 100\">"
+        "<rect x=\"10\" y=\"20\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
+        "</svg>");
     ok &= checkViewBoxOrigin("viewbox-zero-origin",
         "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\">"
         "<rect x=\"0\" y=\"0\" width=\"20\" height=\"20\" fill=\"#ff00ff\"/>"
-- 
2.56.0

