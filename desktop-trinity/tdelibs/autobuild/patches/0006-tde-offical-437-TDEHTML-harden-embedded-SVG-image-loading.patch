+static TQByteArray sampleImageData()
+{
+    TQImage source(1, 1, 32);
+    source.setPixel(0, 0, tqRgba(255, 0, 255, 255));
+
+    TQByteArray data;
+    TQBuffer buffer(data);
+    if (!buffer.open(IO_WriteOnly) || !source.save(&buffer, "PNG"))
+        return TQByteArray();
+    buffer.close();
+    return data;
+}
+
+static TQString embeddedImageURI(const TQByteArray &imageData)
+{
+    TQByteArray encoded;
+    KCodecs::base64Encode(imageData, encoded);
+    return TQString::fromLatin1("data:image/png;base64,") +
+           TQString::fromLatin1(encoded.data(), encoded.size());
+}
+
+static bool checkEmbeddedImage(const char *name, const TQString &uri,
+                              int maxDecodedSize, bool expectedVisible)
+{
+    fprintf(stderr, "RUN: %s\n", name);
+    fflush(stderr);
+
+    TQString svg = TQString::fromLatin1(
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" "
+        "xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"20\" height=\"20\">"
+        "<image x=\"0\" y=\"0\" width=\"20\" height=\"20\" "
+        "xlink:href=\"%1\"/></svg>").arg(uri);
+
+    KSVGIconEngine engine;
+    engine.setAllowExternalImages(false);
+    if (maxDecodedSize >= 0)
+        engine.setMaxEmbeddedImageDataSize(maxDecodedSize);
+    if (!engine.loadData(20, 20, bytes(svg))) {
+        fprintf(stderr, "%s: SVG failed to load\n", name);
+        return false;
+    }
+
+    TQImage *image = engine.image();
+    if (!image || image->isNull()) {
+        fprintf(stderr, "%s: no rendered image\n", name);
+        delete image;
+        return false;
+    }
+
+    const TQRgb pixel = image->pixel(10, 10);
+    const bool visible = tqAlpha(pixel) != 0 && tqRed(pixel) > 200 && tqBlue(pixel) > 200;
+    delete image;
+    if (visible != expectedVisible) {
+        fprintf(stderr, "%s: embedded image visibility was %s, expected %s\n",
+                name, visible ? "visible" : "transparent",
+                expectedVisible ? "visible" : "transparent");
+        return false;
+    }
+    return true;
+}
+
+static bool checkEmbeddedImageDataPolicy()
+{
+    const TQByteArray imageData = sampleImageData();
+    const TQString validURI = embeddedImageURI(imageData);
+    bool ok = true;
+
+    ok &= checkEmbeddedImage("embedded-image-default-unlimited", validURI, -1, true);
+    ok &= checkEmbeddedImage("embedded-image-under-limit", validURI, 1024, true);
+    ok &= checkEmbeddedImage("embedded-image-at-limit", validURI, imageData.size(), true);
+
+    TQByteArray oversizedImageData(imageData.size() + 1);
+    memcpy(oversizedImageData.data(), imageData.data(), imageData.size());
+    oversizedImageData[imageData.size()] = '\0';
+    ok &= checkEmbeddedImage("embedded-image-over-limit",
+                             embeddedImageURI(oversizedImageData), imageData.size(), false);
+
+    // The PNG's canonical payload exceeds the derived eight-byte maximum for
+    // a six-byte decoded limit.
+    ok &= checkEmbeddedImage("embedded-image-over-encoded-limit", validURI, 6, false);
+
+    TQString invalidCharacterURI = validURI;
+    const int payloadStart = invalidCharacterURI.find(',') + 1;
+    invalidCharacterURI[payloadStart] = '!';
+    ok &= checkEmbeddedImage("embedded-image-invalid-character", invalidCharacterURI, 1024, false);
+
+    TQString invalidQuartetURI = validURI;
+    invalidQuartetURI.truncate(invalidQuartetURI.length() - 1);
+    ok &= checkEmbeddedImage("embedded-image-invalid-quartet", invalidQuartetURI, 1024, false);
+
+    ok &= checkEmbeddedImage("embedded-image-misplaced-padding",
+        "data:image/png;base64,=" + validURI.mid(validURI.find(',') + 1), 1024, false);
+    ok &= checkEmbeddedImage("embedded-image-excessive-padding",
+        "data:image/png;base64,A===", 1024, false);
+    ok &= checkEmbeddedImage("embedded-image-non-image-type",
+        "data:text/plain;base64," + validURI.mid(validURI.find(',') + 1), 1024, false);
+    ok &= checkEmbeddedImage("embedded-image-missing-base64-marker",
+        "data:image/png," + validURI.mid(validURI.find(',') + 1), 1024, false);
+
+    return ok;
+}
+
+static bool checkViewBoxFailurePreservesPainter()
+{
+    fprintf(stderr, "RUN: viewbox-failure-preserves-painter\n");
+    fflush(stderr);
+
+    KSVGIconEngine engine;
+    const TQString validSVG = TQString::fromLatin1(
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\">"
+        "<rect width=\"20\" height=\"20\" fill=\"#ff0000\"/></svg>");
+    if (!engine.loadData(20, 20, bytes(validSVG)))
+        return false;
+
+    TQImage *before = engine.image();
+    if (!before || before->isNull()) {
+        delete before;
+        return false;
+    }
+    const TQRgb expected = before->pixel(10, 10);
+    delete before;
+
+    const TQString invalidSVG = TQString::fromLatin1(
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 broken 20\">"
+        "<rect width=\"20\" height=\"20\" fill=\"#0000ff\"/></svg>");
+    if (engine.loadData(20, 20, bytes(invalidSVG))) {
+        fprintf(stderr, "viewbox-failure-preserves-painter: invalid SVG was accepted\n");
+        return false;
+    }
+
+    TQImage *after = engine.image();
+    const bool preserved = after && !after->isNull() && after->pixel(10, 10) == expected;
+    delete after;
+    if (!preserved)
+        fprintf(stderr, "viewbox-failure-preserves-painter: prior render was replaced\n");
+    return preserved;
+}
+
 static bool checkExternalImagePolicy()
 {
     fprintf(stderr, "RUN: external-image-policy\n");
@@ -93,6 +234,7 @@ static bool checkExternalImagePolicy()
 
     // Preserve the historical behaviour by default.
     KSVGIconEngine defaultEngine;
+    defaultEngine.setMaxEmbeddedImageDataSize(1);
     if (!defaultEngine.allowExternalImages()) {
         fprintf(stderr, "external-image-policy: external images are not enabled by default\n");
         ok = false;
@@ -113,6 +255,7 @@ static bool checkExternalImagePolicy()
     // Consumers handling untrusted content can explicitly disable it.
     KSVGIconEngine restrictedEngine;
     restrictedEngine.setAllowExternalImages(false);
+    restrictedEngine.setMaxEmbeddedImageDataSize(1);
     if (restrictedEngine.allowExternalImages()) {
         fprintf(stderr, "external-image-policy: external images were not disabled\n");
         ok = false;
@@ -182,6 +325,8 @@ int main()
         "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 broken 20\"><rect/></svg>");
 
     ok &= checkExternalImagePolicy();
+    ok &= checkEmbeddedImageDataPolicy();
+    ok &= checkViewBoxFailurePreservesPainter();
 
     if (!ok)
         return 1;
