+
 bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &svgDocument)
 {
 	// Check for root element
@@ -644,6 +760,29 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 	if(rootElement.isNull() || (rootName != "svg" && !rootName.endsWith(":svg")))
 		return false;
 
+	bool hasViewBox = rootElement.hasAttribute("viewBox");
+	double viewBoxWidth = 0.0;
+	double viewBoxHeight = 0.0;
+	if(hasViewBox)
+	{
+		TQString viewBox = rootElement.attribute("viewBox");
+		viewBox.replace(',', ' ');
+		TQStringList points = TQStringList::split(TQRegExp("\\s+"), viewBox.simplifyWhiteSpace());
+		if(points.count() != 4)
+			return false;
+
+		bool okX = false;
+		bool okY = false;
+		bool okWidth = false;
+		bool okHeight = false;
+		points[0].toDouble(&okX);
+		points[1].toDouble(&okY);
+		viewBoxWidth = points[2].toDouble(&okWidth);
+		viewBoxHeight = points[3].toDouble(&okHeight);
+		if(!okX || !okY || !okWidth || !okHeight || viewBoxWidth <= 0.0 || viewBoxHeight <= 0.0)
+			return false;
+	}
+
 	if(d->painter)
 	{
 		delete d->painter;
@@ -679,30 +818,13 @@ bool KSVGIconEngine::loadDocument(int width, int height, const TQDomDocument &sv
 	d->painter->setClippingRect(0, 0, width, height);
 
 	// Apply viewbox
-	if(rootElement.hasAttribute("viewBox"))
+	if(hasViewBox)
 	{
-		TQString viewBox = rootElement.attribute("viewBox");
-		viewBox.replace(',', ' ');
-		TQStringList points = TQStringList::split(TQRegExp("\\s+"), viewBox.simplifyWhiteSpace());
-		if(points.count() != 4)
-			return false;
-
-		bool okX = false;
-		bool okY = false;
-		bool okWidth = false;
-		bool okHeight = false;
-		points[0].toDouble(&okX);
-		points[1].toDouble(&okY);
-		double w = points[2].toDouble(&okWidth);
-		double h = points[3].toDouble(&okHeight);
-		if(!okX || !okY || !okWidth || !okHeight || w <= 0.0 || h <= 0.0)
-			return false;
-
-		double vratiow = width / w;
-		double vratioh = height / h;
+		double vratiow = width / viewBoxWidth;
+		double vratioh = height / viewBoxHeight;
 
-		d->width = w;
-		d->height = h;
+		d->width = viewBoxWidth;
+		d->height = viewBoxHeight;
 
 		d->painter->worldMatrix()->scale(vratiow, vratioh);
 	}
