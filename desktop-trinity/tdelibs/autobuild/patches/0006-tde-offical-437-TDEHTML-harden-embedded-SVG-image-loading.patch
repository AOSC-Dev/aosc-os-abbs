+
+	bool decodeEmbeddedImage(const TQString &href, TQByteArray &output) const
+	{
+		static const char dataImagePrefix[] = "data:image/";
+		static const char base64Marker[] = ";base64,";
+		const int prefixLength = sizeof(dataImagePrefix) - 1;
+		const int markerLength = sizeof(base64Marker) - 1;
+
+		if (!href.startsWith(dataImagePrefix))
+			return false;
+
+		const int markerPosition = href.find(base64Marker, prefixLength);
+		if (markerPosition <= prefixLength)
+			return false;
+
+		const int mediaTypeEnd = href.find(';', prefixLength);
+		if (mediaTypeEnd <= prefixLength || mediaTypeEnd > markerPosition)
+			return false;
+
+		// Validate the MIME subtype and keep the header ASCII and whitespace-free.
+		for (int i = prefixLength; i < markerPosition; ++i)
+		{
+			const unsigned int ch = href[i].unicode();
+			if (ch <= 0x20 || ch >= 0x7f || ch == ',')
+				return false;
+			if (i < mediaTypeEnd &&
+			    !((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+			      (ch >= '0' && ch <= '9') || ch == '!' || ch == '#' ||
+			      ch == '$' || ch == '%' || ch == '&' || ch == '*' ||
+			      ch == '\'' || ch == '+' || ch == '-' || ch == '.' ||
+			      ch == '^' || ch == '_' || ch == '`' || ch == '|' || ch == '~'))
+				return false;
+		}
+
+		const int payloadPosition = markerPosition + markerLength;
+		const int encodedLength = href.length() - payloadPosition;
+		if ((encodedLength % 4) != 0)
+			return false;
+
+		int padding = 0;
+		while (padding < encodedLength &&
+		       href[payloadPosition + encodedLength - padding - 1] == '=')
+			++padding;
+		if (padding > 2)
+			return false;
+
+		for (int i = 0; i < encodedLength; ++i)
+		{
+			const unsigned int ch = href[payloadPosition + i].unicode();
+			const bool base64Char = (ch >= 'A' && ch <= 'Z') ||
+			                        (ch >= 'a' && ch <= 'z') ||
+			                        (ch >= '0' && ch <= '9') ||
+			                        ch == '+' || ch == '/';
+			if (base64Char)
+			{
+				if (i >= encodedLength - padding)
+					return false;
+			}
+		else if (ch != '=' || i < encodedLength - padding)
+				return false;
+		}
+
+		const unsigned int decodedLength =
+			static_cast<unsigned int>(encodedLength / 4) * 3 - padding;
+
+		// Canonical base64 requires unused low bits in the final symbol to be zero.
+		if (padding > 0)
+		{
+			const TQChar last = href[payloadPosition + encodedLength - padding - 1];
+			unsigned int value;
+			if (last >= 'A' && last <= 'Z')
+				value = last.unicode() - 'A';
+			else if (last >= 'a' && last <= 'z')
+				value = last.unicode() - 'a' + 26;
+			else if (last >= '0' && last <= '9')
+				value = last.unicode() - '0' + 52;
+			else if (last == '+')
+				value = 62;
+			else
+				value = 63;
+			if ((padding == 1 && (value & 0x03)) ||
+			    (padding == 2 && (value & 0x0f)))
+				return false;
+		}
+
+		if (m_maxEmbeddedImageDataSize >= 0)
+		{
+			const unsigned int maxDecoded = m_maxEmbeddedImageDataSize;
+			const unsigned int groups = maxDecoded / 3 + (maxDecoded % 3 != 0);
+			const unsigned int maxEncoded = groups > static_cast<unsigned int>(INT_MAX / 4)
+				? static_cast<unsigned int>(INT_MAX) : groups * 4;
+			if (static_cast<unsigned int>(encodedLength) > maxEncoded ||
+			    decodedLength > maxDecoded)
+				return false;
+		}
+
+		// Only accepted input is copied or converted to UTF-8.
+		TQCString input = href.mid(payloadPosition).utf8();
+		KCodecs::base64Decode(input, output);
+		if (output.size() != static_cast<int>(decodedLength) ||
+		    (m_maxEmbeddedImageDataSize >= 0 &&
+		     output.size() > m_maxEmbeddedImageDataSize))
+		{
+			output.resize(0);
+			return false;
+		}
+		return true;
+	}
+
 	void parseTransform(const TQString &transform)
 	{
 		// Combine new and old matrix
@@ -446,15 +562,9 @@ public:
