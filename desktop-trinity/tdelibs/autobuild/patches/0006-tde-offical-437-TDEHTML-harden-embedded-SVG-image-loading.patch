 tdecore/svgicons/ksvgiconengine.h    |   2 +
 tdecore/tests/ksvgiconenginetest.cpp | 145 +++++++++++++++++++++
 tdehtml/misc/loader.cpp              |   1 +
 4 files changed, 300 insertions(+), 30 deletions(-)

