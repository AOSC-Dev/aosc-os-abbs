PKGNAME=arts
PKGSEC=Trinity
PKGDEP="audiofile glib gsl jack libmad libtool libvorbis pulseaudio \
        tqtinterface sndio"
PKGDEP__RETRO=" \
        audiofile glib libmad libtool libvorbis tqtinterface sndio"
BUILDDEP="tde-common-cmake"
PKGDES="Analog Realtime Synthesizer, sound system for the Trinity Desktop Environment"

# Note:
#   The install of the mcop-shared target requires changing an RPATH from the build tree,
#   but this is not supported with the Ninja generator unless on an ELF-based or XCOFF-based platform.
ABTYPE=cmake
CMAKE_AFTER=(
    '-DCMAKE_NO_BUILTIN_CHRPATH=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DCMAKE_INSTALL_PREFIX=/usr'
    '-DBIN_INSTALL_DIR=/usr/bin'
    '-DINCLUDE_INSTALL_DIR=/usr/include'
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DCMAKE_SKIP_RPATH=OFF'
    '-DWITH_ALSA=ON'
    '-DWITH_AUDIOFILE=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DWITH_VORBIS=ON'
    '-DWITH_MAD=ON'
    '-DWITH_ESOUND=OFF'
    '-DWITH_JACK=ON'
    '-DWITH_SNDIO=ON'
    '-DWITH_ALL_OPTIONS=ON'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DWITH_JACK=OFF'
)

# FIXME: `cmake build' breaks build.
#
# CMake Error at mcop/cmake_install.cmake:105 (file):
#   file INSTALL cannot find
#   "/var/cache/acbs/build/acbs.i_amzbi7/arts-trinity-14.1.6/abbuild/mcop/CMakeFiles/CMakeRelink.dir/libmcop.so.1.0.0":
#   No such file or directory.
# Call Stack (most recent call first):
#   cmake_install.cmake:108 (include)
ABUSECMAKEBUILD=0

# Note: Required for component detection.
NOLIBTOOL=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
