PKGNAME=arts
PKGSEC=Trinity
PKGDEP="audiofile glib gsl jack libmad libtool libvorbis pulseaudio \
        tqtinterface sndio"
PKGDEP__RETRO=" \
        audiofile glib gsl libmad libtool libvorbis tqtinterface sndio"
BUILDDEP="tde-common-cmake"
PKGDES="Analog Realtime Synthesizer, sound system for the Trinity Desktop Environment"

CMAKE_AFTER=(
    '-DCMAKE_NO_BUILTIN_CHRPATH=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DCMAKE_INSTALL_PREFIX=/usr'
    '-DBIN_INSTALL_DIR=/usr/bin'
    '-DINCLUDE_INSTALL_DIR=/usr/include'
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DCMAKE_SKIP_RPATH=OFF'
    '-DWITH_ALSA=ON'
    '-DWITH_AUDIOFILE=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DWITH_VORBIS=ON'
    '-DWITH_MAD=ON'
    '-DWITH_ESOUND=OFF'
    '-DWITH_JACK=ON'
    '-DWITH_SNDIO=ON'
    '-DWITH_ALL_OPTIONS=ON'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DWITH_JACK=OFF'
)

NOSTATIC=0

# Note: Required for component discovery.
NOLIBTOOL=0
