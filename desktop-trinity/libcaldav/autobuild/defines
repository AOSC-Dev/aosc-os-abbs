PKGNAME=libcaldav
PKGSEC=libs
PKGDEP="curl glib"
BUILDDEP="tde-common-cmake"
PKGDES="Client library adding support for the CalDAV protocol (RFC 4791)"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DWITH_ALL_OPTIONS=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DBUILD_ALL=ON'
)

