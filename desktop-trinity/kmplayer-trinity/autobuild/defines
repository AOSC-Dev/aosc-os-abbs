PKGNAME=kmplayer-trinity
PKGSEC=Trinity
PKGDEP="dbus-glib gstreamer mplayer tdelibs xine-ui"
PKGDEP__RETRO="dbus-glib mplayer tdelibs xine-ui"
PKGDEP__ARMV4="${PKGDEP__RETRO}"
PKGDEP__ARMV6HF="${PKGDEP__RETRO}"
PKGDEP__ARMV7HF="${PKGDEP__RETRO}"
PKGDEP__I486="${PKGDEP__RETRO}"
PKGDEP__LOONGSON2F="${PKGDEP__RETRO}"
PKGDEP__M68K="${PKGDEP__RETRO}"
PKGDEP__POWERPC="${PKGDEP__RETRO}"
PKGDEP__PPC64="${PKGDEP__RETRO}"
BUILDDEP="koffice-trinity tde-common-cmake"
PKGDES="Multi-backend media player for the Trinity Desktop Environment"

CMAKE_AFTER=(
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DBUILD_ALL=ON'
    '-DWITH_ALL_OPTIONS=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DWITH_CAIRO=ON'
    '-DWITH_EXPAT=ON'
    '-DWITH_XTEST=ON'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DBUILD_KGSTPLAYER=OFF'
)

PKGCONFL="kmplayer"

# Note: Needed for plugin detection.
NOLIBTOOL=0

# FIXME: Sync from app-multimedia/mplayer.
# The architecture of your CPU (UNKNOWN) is not supported by this configure script
# It seems nobody has ported MPlayer to your OS or CPU type yet.
FAIL_ARCH="!(amd64|arm64|loongson3|ppc64el)"
