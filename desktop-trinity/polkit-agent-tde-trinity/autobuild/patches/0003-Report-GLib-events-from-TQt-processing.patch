From d66a1529433df275a58e832cae6c8874ef40cdb9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sebasti=C3=A3o=20Guerra?= <sebastiao.luiz.guerra@gmail.com>
Date: Thu, 15 Oct 2026 06:35:18 -0300
Subject: [PATCH 3/4] Report GLib events from TQt processing
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Sebastião Guerra <sebastiao.luiz.guerra@gmail.com>
---
 src/main.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/main.cpp b/src/main.cpp
index bdab847..414f029 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -37,8 +37,9 @@ public:
 
   bool processEvents(ProcessEventsFlags flags) override
   {
-    g_main_context_iteration(nullptr, false);
-    return TQEventLoop::processEvents(flags);
+    bool glibProcessed = g_main_context_iteration(nullptr, false);
+    bool tqtProcessed = TQEventLoop::processEvents(flags);
+    return glibProcessed || tqtProcessed;
   }
 };
 
