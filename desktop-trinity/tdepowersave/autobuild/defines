PKGNAME=tdepowersave
PKGSEC=Trinity
PKGDEP="tdelibs dbus-1-tqt"
BUILDDEP="tde-common-cmake"
PKGDES="Powersaving features and manager for the Trinity Desktop Environment"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DBUILD_ALL=ON'
    '-DBUILD_DOC=OFF'
    '-DBUILD_TRANSLATIONS=ON'
)

# Note: Required for component detection.
NOLIBTOOL=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
