PKGNAME=tqt3
PKGSEC=Trinity
PKGDEP="libjpeg-turbo libmng libpng giflib freetype fontconfig cups glib \
        e2fsprogs x11-lib mesa unixodbc sqlite postgresql-runtime util-linux \
        glu mariadb"
PKGDEP__RETRO=" \
        libjpeg-turbo libmng libpng giflib freetype fontconfig cups glib \
        e2fsprogs x11-lib mesa sqlite glu"
BUILDDEP="postgresql"
BUILDDEP__RETRO=""
PKGDES="TQt GUI Library, version 3"

ABTYPE=self

NOSTATIC=0
NOLTO__LOONGSON2F=1
NOLTO__LOONGSON3=1

# FIXME: Build fails with LTO.
#
# /usr/bin/ld: /tmp/cciwQYol.ltrans9.ltrans.o: .got subsegment exceeds 64K (size 115400)
# /usr/bin/ld: failed to set dynamic section sizes: no more archived files
# collect2: error: ld returned 1 exit status
NOLTO__ALPHA=1

NOLIBTOOL=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
