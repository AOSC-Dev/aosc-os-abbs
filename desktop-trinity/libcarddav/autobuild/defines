PKGNAME=libcarddav
PKGSEC=libs
PKGDEP="curl"
BUILDDEP="tde-common-cmake"
PKGDES="Client library adding support for the CardDAV protocol"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DWITH_ALL_OPTIONS=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
    '-DBUILD_ALL=ON'
    '-DBUILD_DOC=OFF'
)

# Note: Required for component discovery.
NOLIBTOOL=0
