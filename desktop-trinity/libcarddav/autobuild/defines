PKGNAME=libcarddav
PKGSEC=libs
PKGDEP="curl"
BUILDDEP="tde-common-cmake"
PKGDES="Client library adding support for the CardDAV protocol"

ABTYPE=cmakeninja
CMAKE_AFTER="-DLIB_INSTALL_DIR=/usr/lib \
             -DWITH_ALL_OPTIONS=ON \
             -DWITH_GCC_VISIBILITY=OFF \
             -DBUILD_ALL=ON \
             -DBUILD_DOC=ON"
CMAKE_AFTER__RETRO=" \
             ${CMAKE_AFTER} \
             -DBUILD_DOC=OFF"

NOLIBTOOL=0
