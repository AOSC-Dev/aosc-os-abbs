PKGNAME=tqca
PKGSEC=Trinity
PKGDEP="pkcs11-helper tqtinterface"
BUILDDEP="tde-common-cmake"
PKGDES="TQt Cryptographic Architecture"

PKGCONFL="qca"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DWITH_ALL_OPTIONS=ON'
    '-DWITH_GCC_VISIBILITY=OFF'
)

# Note: Required for component detection.
NOLIBTOOL=0

PKGBREAK="tqca-tls<=14.0.10"
PKGREP="tqca-tls<=14.0.10"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
