abinfo "Building pve-docs ..."
cd "$SRCDIR"
make DOCRELEASE="${VER}" asciidoc-pve

abinfo "Installing pve-docs ..."
install -dvm755 "$PKGDIR"/usr/bin
install -vm755 "$SRCDIR"/asciidoc-pve "$PKGDIR"/usr/bin/

install -dvm755 "$PKGDIR"/usr/share/pve-doc-generator
install -vm644 "$SRCDIR"/*.adoc "$PKGDIR"/usr/share/pve-doc-generator/
install -vm644 "$SRCDIR"/*.pl "$PKGDIR"/usr/share/pve-doc-generator/
install -vm644 "$SRCDIR"/*.mk "$PKGDIR"/usr/share/pve-doc-generator/
install -vm644 "$SRCDIR"/*.xml "$PKGDIR"/usr/share/pve-doc-generator/

install -dvm755 "$PKGDIR"/usr/share/pve-doc-generator/asciidoc
install -vm644 "$SRCDIR"/asciidoc/*.conf "$PKGDIR"/usr/share/pve-doc-generator/asciidoc/
