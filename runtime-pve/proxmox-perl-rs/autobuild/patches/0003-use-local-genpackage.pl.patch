From 72d2290e0a0f0f1fd11cf6bc2977a179b0efd3ff Mon Sep 17 00:00:00 2001
From: Ruikai Liu <rickliu2000@outlook.com>
Date: Tue, 10 Mar 2026 16:47:36 +0800
Subject: [PATCH 2/2] use local genpackage.pl

---
 common/pkg/Makefile | 2 +-
 pmg-rs/Makefile     | 2 +-
 pve-rs/Makefile     | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/common/pkg/Makefile b/common/pkg/Makefile
index 5a537f9..3f23903 100644
--- a/common/pkg/Makefile
+++ b/common/pkg/Makefile
@@ -14,7 +14,7 @@ BUILDDIR ?= $(PACKAGE)-$(DEB_VERSION_UPSTREAM)
 
 DESTDIR=
 
-PERLMOD_GENPACKAGE := /usr/lib/perlmod/genpackage.pl \
+PERLMOD_GENPACKAGE := ../../genpackage.pl \
 	--lib=- \
 	--lib-tag=proxmox \
 	--lib-package=Proxmox::Lib::Common \
diff --git a/pmg-rs/Makefile b/pmg-rs/Makefile
index bec3df1..72bf653 100644
--- a/pmg-rs/Makefile
+++ b/pmg-rs/Makefile
@@ -18,7 +18,7 @@ DESTDIR=
 
 PM_DIR := PMG
 
-PERLMOD_GENPACKAGE := /usr/lib/perlmod/genpackage.pl \
+PERLMOD_GENPACKAGE := ../genpackage.pl \
 	--lib=pmg_rs \
 	--lib-tag=proxmox \
 	--lib-package=Proxmox::Lib::PMG \
diff --git a/pve-rs/Makefile b/pve-rs/Makefile
index aa7181e..10decf0 100644
--- a/pve-rs/Makefile
+++ b/pve-rs/Makefile
@@ -18,7 +18,7 @@ DESTDIR=
 
 PM_DIR := PVE
 
-PERLMOD_GENPACKAGE := /usr/lib/perlmod/genpackage.pl \
+PERLMOD_GENPACKAGE := ../genpackage.pl \
 	--lib=pve_rs \
 	--lib-tag=proxmox \
 	--lib-package=Proxmox::Lib::PVE \
-- 
