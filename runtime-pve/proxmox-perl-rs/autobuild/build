abinfo "Setting up proxmox-perl-rs build environment ..."
export BUILD_MODE=release
export PERLMOD_WRITE_PACKAGES=1
export BUILD_TARGET=pve
export RUSTFLAGS="-L/usr/lib/perl5/core_perl/CORE -lperl"
export CFLAGS+=" -I/usr/lib/gcc/x86_64-aosc-linux-gnu/15/include"

abinfo "Building pve-rs..."

pushd "$SRCDIR/pve-rs"
make
popd

pushd "$SRCDIR/common/pkg"
make
popd

abinfo "Installing pve-rs"
install -pd $PKGDIR/usr/lib/perl5/vendor_perl/auto/
install -m0644 pve-rs/target/release/libpve_rs.so $PKGDIR/usr/lib/perl5/vendor_perl/auto/libpve_rs.so
chmod +x $PKGDIR/usr/lib/perl5/vendor_perl/auto/libpve_rs.so
install -pd $PKGDIR/usr/share/perl5/vendor_perl/{PVE/RS/ResourceScheduling,PVE/RS/SDN,PVE/RS/Firewall,Proxmox/Lib,Proxmox/RS,Proxmox/RS/APT}
install -m0644 pve-rs/PVE/RS/*.pm $PKGDIR/usr/share/perl5/vendor_perl/PVE/RS/
install -m0644 pve-rs/PVE/RS/SDN/*.pm $PKGDIR/usr/share/perl5/vendor_perl/PVE/RS/SDN/
install -m0644 pve-rs/PVE/RS/Firewall/*.pm $PKGDIR/usr/share/perl5/vendor_perl/PVE/RS/Firewall/
install -m0644 pve-rs/PVE/RS/ResourceScheduling/*.pm $PKGDIR/usr/share/perl5/vendor_perl/PVE/RS/ResourceScheduling/
install -m0644 pve-rs/common/pkg/PVE/RS/*.pm $PKGDIR/usr/share/perl5/vendor_perl/PVE/RS/
install -m0644 pve-rs/Proxmox/RS/*.pm $PKGDIR/usr/share/perl5/vendor_perl/Proxmox/RS/
install -m0644 pve-rs/Proxmox/RS/APT/*.pm $PKGDIR/usr/share/perl5/vendor_perl/Proxmox/RS/APT
install -m0644 pve-rs/common/pkg/Proxmox/Lib/Common.pm pve-rs/Proxmox/Lib/PVE.pm $PKGDIR/usr/share/perl5/vendor_perl/Proxmox/Lib/
install -m0644 pve-rs/common/pkg/Proxmox/Lib/SslProbe.pm pve-rs/Proxmox/Lib/PVE.pm $PKGDIR/usr/share/perl5/vendor_perl/Proxmox/Lib/

