abinfo "Building proxmox-widget-toolkit ..."
cd "$SRCDIR"/src
make

abinfo "Installing proxmox-widget-toolkit ..."
install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev
install -vm644 "$SRCDIR"/src/*.js "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/

install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/css
install -vm644 "$SRCDIR"/src/css/*.css "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/css/

install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/images
install -vm644 "$SRCDIR"/src/images/*.png "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/images/ 2>/dev/null || true

install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/proxmox-dark
install -vm644 "$SRCDIR"/src/proxmox-dark/*.css "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/proxmox-dark/

install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/api-viewer
install -vm644 "$SRCDIR"/src/api-viewer/*.js "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/api-viewer/ 2>/dev/null || true

install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/form
install -vm644 "$SRCDIR"/src/form/*.js "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/form/

for dir in button data grid mixin node panel window; do
    install -dvm755 "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/$$dir
    install -vm644 "$SRCDIR"/src/$$dir/*.js "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/$$dir/ 2>/dev/null || true
done

# pve-doc requires APIViewer.js to be placed under proxmox-widget-toolkit-dev folder
ln -s /usr/share/javascript/proxmox-widget-toolkit-dev/api-viewer/APIViewer.js "$PKGDIR"/usr/share/javascript/proxmox-widget-toolkit-dev/APIViewer.js
