abinfo "Building pve-cluster ..."
make -C "$SRCDIR"/src

abinfo "Installing pve-cluster ..."
make -C "$SRCDIR"/src/PVE/Cluster install DESTDIR="$PKGDIR"
make -C "$SRCDIR"/src install DESTDIR="$PKGDIR"

install -D -m644 debian/"$PKGNAME".service "$PKGDIR"/usr/lib/systemd/system/"$PKGNAME".service
install -D -m644 debian/sysctl.d/10-pve.conf "$PKGDIR"/etc/sysctl.d/10-pve.conf

