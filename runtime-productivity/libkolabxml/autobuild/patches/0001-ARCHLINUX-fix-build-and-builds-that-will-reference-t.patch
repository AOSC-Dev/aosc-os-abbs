From: Ruikai Liu <rickliu2000@outlook.com>
Date: Fri, 26 Dec 2025 13:26:38 +0800
Subject: [PATCH] ARCHLINUX: fix build and builds that will reference to this
 lib with boost

Link: https://gitlab.archlinux.org/archlinux/packaging/packages/kdepim-runtime/-/blob/a454d5658467ba13710b8cc15f35bee40895c380/boost-1.89.patch
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1f4452a..56f99c4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -92,7 +92,7 @@ endforeach()
 configure_file(libkolabxml-version.h.cmake "${CMAKE_BINARY_DIR}/libkolabxml-version.h" @ONLY)
 
 set(Boost_USE_MULTITHREADED ON)
-find_package(Boost REQUIRED COMPONENTS thread system)
+find_package(Boost REQUIRED COMPONENTS thread)
 if (Boost_FOUND)
     message("Found boost in ${Boost_INCLUDE_DIRS}")
 endif (Boost_FOUND)
