PKGNAME=fftw
PKGSEC=libs
PKGDEP="gcc-runtime"
PKGDES="Library to compute the discrete Fourier transform (DFT)"

PKGREP="fftw-3"
PKGPROV="fftw-3"

AB_FLAGS_O3=1

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"

# Note: We build multiple variant in the build script.
ABTYPE=self
AUTOTOOLS_AFTER=(
    '--prefix=/usr'
    '--enable-shared'
    '--enable-threads'
    '--enable-openmp'
)
# Note: The optimisation flags below reflect what could reasonably be
# found on hardware of each architecture and are runtime detected.
#
# **Not reflective of our baseline.**
AUTOTOOLS_AFTER__AMD64=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-sse'
    '--enable-sse2'
    '--enable-avx'
    '--enable-avx2'
    '--enable-avx512'
    '--enable-avx-128-fma'
)
# FIXME: SVE detection and flag passing error?
#
#   conftest.c: In function 'main':
#   conftest.c:98:2: error: #error compiling without SVE support
#      98 | #error compiling without SVE support
#         |  ^~~~~
#   configure:24609: $? = 1
#   configure: failed program was:
#   [...]
#   | main (void)
#   | {
#   | #if defined(__GNUC__) && !defined(__ARM_FEATURE_SVE)
#   | #error compiling without SVE support
#   | #endif
#   |   ;
#   |   return 0;
#   | }
#   configure:24615: result: no
#   configure:24623: error: Cannot build a SVE program, aborting
AUTOTOOLS_AFTER__ARM64=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-neon'
    '--enable-armv8-pmccntr-el0'
    '--enable-armv8-cntvct-el0'
    '--disable-sve'
)
AUTOTOOLS_AFTER__ARMV7HF=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-neon'
    # FIXME: Fails to build.
    #
    # cycle.h:532:21: error: redefinition of 'getticks'
    #   532 | static inline ticks getticks(void)
    #       |                     ^~~~~~~~
    '--disable-armv7a-cntvct'
    '--enable-armv7a-pmccntr'
)
AUTOTOOLS_AFTER__I486=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-sse'
    '--enable-sse2'
    '--disable-avx'
    '--disable-avx2'
    '--disable-avx512'
    '--disable-avx-128-fma'
)
AUTOTOOLS_AFTER__LOONGARCH64=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-lsx'
    '--enable-lasx'
)
AUTOTOOLS_AFTER__POWERPC=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-altivec'
    '--enable-vsx'
)
AUTOTOOLS_AFTER__PPC64=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-altivec'
    '--enable-vsx'
)
AUTOTOOLS_AFTER__PPC64EL=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-altivec'
    '--enable-vsx'
)
