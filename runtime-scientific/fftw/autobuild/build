for variant in single double long-double quad-precision; do
    abinfo "Preparing AUTOTOOLS_AFTER => AUTOTOOLS_AFTER__FINAL in case of conditional changes"
    abinfo "(i.e., unavailable optimisation in certain variants) ..."
    export AUTOTOOLS_AFTER__FINAL=(${AUTOTOOLS_AFTER[@]})

    # Note: Requires libquadmath with limited architecture support.
    #
    # FIXME: ppc64el has libquadmath but the build fails.
    #
    #   libtool: compile:  gcc -DHAVE_CONFIG_H -I. -I.. -I .. -D_GLIBCXX_ASSERTIONS -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -O2 -pipe -Wno-error -fstack-protector-strong --param=ssp-buffer-size=4 -fexceptions -ggdb -fira-loop-pressure -fira-hoist-pressure -O3 -fno-omit-frame-pointer -flto=auto -msecure-plt -mabi=ieeelongdouble -mcpu=power8 -mtune=power10 -mvsx -MT kdft-dif.lo -MD -MP -MF .deps/kdft-dif.Tpo -c kdft-dif.c -o kdft-dif.o >/dev/null 2>&1
    #   In file included from ../dft/dft.h:25,
    #                    from ../dft/ct.h:21,
    #                    from dftw-direct.c:22:
    #   dftw-direct.c: In function 'destroy':
    #   ../kernel/ifftw.h:74:25: error: implicit declaration of function 'fftwq_stride_destroy'; did you mean 'fftw_stride_destroy'? [-Wimplicit-function-declaration]
    #      74 | # define X(name) CONCAT(fftwq_, name)
    #         |                         ^~~~~~
    #   ../kernel/ifftw.h:63:30: note: in definition of macro 'CONCAT'
    #      63 | #define CONCAT(prefix, name) prefix ## name
    #         |                              ^~~~~~
    #   dftw-direct.c:136:6: note: in expansion of macro 'X'
    #     136 |      X(stride_destroy)(ego->brs);
    #         |      ^
    #
    # Link: https://github.com/FFTW/fftw3/issues/419
    if [[ "${variant}" = "quad-precision" ]] && \
       ( ! ab_match_arch amd64 && \
         ! ab_match_arch ia64 && \
         ! ab_match_arch i486 ); then
       abinfo "Quad precision not supported on ${ARCH}, skipping ..."
       break
    fi

    # Note: Specify the variant.
    #
    # Note: The "double" variant only builds with no variant specified.
    if [[ "${variant}" != "double" ]]; then
        AUTOTOOLS_AFTER__FINAL=(
            "${AUTOTOOLS_AFTER__FINAL[@]}"
            "--enable-${variant}"
        )
    fi

    # FIXME: For x86 (amd64, i486):
    #
    #   configure: error: SSE requires single precision
    #   configure: error: SSE2 requires single or double precision
    #   configure: error: AVX requires single or double precision
    #   configure: error: AVX2 requires single or double precision
    #   configure: error: AVX512 requires single or double precision
    #
    #   Failed after configure - --enable-avx-128-fma:
    #
    #     ../../../simd-support/simd-avx-128-fma.h:25:2: error: #error "AVX only works in single or double precision"
    #        25 | #error "AVX only works in single or double precision"
    #           |  ^~~~~
    #
    # FIXME: For Arm (arm64, armv7hf - those with SIMD enabled):
    #
    #   configure: error: NEON requires single precision
    #
    # FIXME: For LoongArch (loongarch64):
    #
    #   Failed after configure - --enable-lsx, --enable-lasx:
    #
    #     ../../../simd-support/simd-lsx.h:24:2: error: #error "LSX only works in single/double precision"
    #        24 | #error "LSX only works in single/double precision"
    #           |  ^~~~~
    #
    #     ../../../simd-support/simd-lasx.h:24:2: error: #error "LASX only works in single/double precision"
    #        24 | #error "LASX only works in single/double precision"
    #           |  ^~~~~
    #
    # FIXME: For Power (powerpc, ppc64, ppc64el):
    #
    #   configure: error: Altivec requires single precision
    #
    #   Failed after configure - --enable-vsx:
    #
    #     ../../../simd-support/simd-vsx.h:25:4: error: #error "VSX only works in single or double precision"
    #        25 | #  error "VSX only works in single or double precision"
    #           |    ^~~~~
    #
    # Note: For all above^: long-double is not a variant of double.
    if [[ "${variant}" != "single" ]]; then
         AUTOTOOLS_AFTER__FINAL=(
            "${AUTOTOOLS_AFTER__FINAL[@]}"
            '--disable-sse'
            '--disable-neon'
            '--disable-altivec'
        )
    fi
    if [[ "${variant}" = "long-double" || \
          "${variant}" = "quad-precision" ]]; then
        AUTOTOOLS_AFTER__FINAL=(
            "${AUTOTOOLS_AFTER__FINAL[@]}"
            '--disable-sse'
            '--disable-sse2'
            '--disable-avx'
            '--disable-avx2'
            '--disable-avx512'
            '--disable-avx-128-fma'
            '--disable-neon'
            '--disable-altivec'
            '--disable-vsx'
            '--disable-lsx'
            '--disable-lasx'
        )
    fi

    abinfo "Configuring FFTW (${variant}) ..."
    "$SRCDIR"/configure \
        "${AUTOTOOLS_DEF[@]}" \
        "${AUTOTOOLS_AFTER__FINAL[@]}"

    abinfo "Building FFTW (${variant}) ..."
    make

    abinfo "Installing FFTW (${variant}) ..."
    make install \
        DESTDIR="$PKGDIR"

    abinfo "Cleaning up the source tree for the next variant ..."
    make distclean
done
