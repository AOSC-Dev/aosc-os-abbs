PKGNAME=vigra
PKGSEC=libs
PKGDEP="libpng libtiff openexr bash hdf5 fftw numpy python-3"
BUILDDEP="boost"
PKGDES="A computer vision library"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DWITH_OPENEXR=true'
    '-DWITH_VIGRANUMPY=1'
    '-DBUILD_TESTS=OFF'
    '-DDOCINSTALL=share/doc'
    '-DVIGRA_STATIC_LIB=OFF'
)

# FIXME: OOM on M1 buildbots
NOPARALLEL_ARM64=1

AB_FLAGS_O3=1
PKGBREAK="enblend-enfuse<=4.1.5-3 libreoffice<=5.3.2.2"
