PKGNAME=zlib-static
PKGDES="Data compression library with SIMD optimizations (static library)"
PKGDEP="zlib"
PKGSEC=libs

NOSTATIC=0

ABTYPE=cmakeninja
CMAKE_AFTER=(
        '-DBUILD_SHARED_LIBS=OFF'
        '-DZLIB_COMPAT=ON'
        '-DWITH_GZFILEOP=ON'
        '-DWITH_OPTIM=ON'
        '-DWITH_NEW_STRATEGIES=ON'
        '-DWITH_RUNTIME_CPU_DETECTION=ON'
)
CMAKE_AFTER__LOONGARCH64_NOSIMD=(
        "${CMAKE_AFTER[@]}"
        '-DWITH_LSX=OFF'
        '-DWITH_LASX=OFF'
)
CMAKE_AFTER__POWERPC=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_ALTIVEC=OFF'
	'-DWITH_POWER8=OFF'
	'-DWITH_POWER9=OFF'
)
CMAKE_AFTER__PPC64=(
        "${CMAKE_AFTER[@]}"
        '-DWITH_ALTIVEC=ON'
        '-DWITH_POWER8=OFF'
        '-DWITH_POWER9=OFF'
)

ABSPLITDBG=0

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
