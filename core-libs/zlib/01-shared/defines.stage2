PKGNAME="zlib"
PKGDES="A data compression library with SIMD optimizations"
PKGSEC=libs
PKGDEP="glibc"
PKGESS=1

ABTYPE=cmake
CMAKE_AFTER=(
	'-DZLIB_COMPAT=ON'
	'-DWITH_GZFILEOP=ON'
	'-DWITH_OPTIM=ON'
	'-DWITH_NEW_STRATEGIES=ON'
	'-DWITH_RUNTIME_CPU_DETECTION=ON'
	'-DWITH_GTEST=OFF'
	'-DZLIBNG_ENABLE_TESTS=OFF'
)
CMAKE_AFTER__LOONGARCH64_NOSIMD=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_LSX=OFF'
	'-DWITH_LASX=OFF'
)
CMAKE_AFTER__POWERPC=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_ALTIVEC=OFF'
	'-DWITH_POWER8=OFF'
	'-DWITH_POWER9=OFF'
)
CMAKE_AFTER__PPC64=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_ALTIVEC=ON'
	'-DWITH_POWER8=OFF'
	'-DWITH_POWER9=OFF'
)

ABSPIRAL=0
PKGBREAK="zlib<=1.3.1-3"
PKGPROV="zlib"
PKGREP="zlib<=1.3.1-3"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
