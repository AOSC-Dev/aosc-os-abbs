PKGNAME="zlib"
PKGDES="Data compression library with SIMD optimizations"
PKGSEC=libs
PKGDEP="glibc"
# For building test programs.
# You can find the stage 2 recipe which do not build tests.
BUILDDEP="gtest"
PKGESS=1

ABTYPE=cmakeninja
CMAKE_AFTER=(
	'-DBUILD_SHARED_LIBS=ON'
	'-DZLIB_COMPAT=ON'
	'-DWITH_GZFILEOP=ON'
	'-DWITH_OPTIM=ON'
	'-DWITH_NEW_STRATEGIES=ON'
	'-DWITH_RUNTIME_CPU_DETECTION=ON'
)
CMAKE_AFTER__LOONGARCH64_NOSIMD=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_LSX=OFF'
	'-DWITH_LASX=OFF'
)
CMAKE_AFTER__POWERPC=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_ALTIVEC=OFF'
	'-DWITH_POWER8=OFF'
	'-DWITH_POWER9=OFF'
)
CMAKE_AFTER__PPC64=(
	"${CMAKE_AFTER[@]}"
	'-DWITH_ALTIVEC=ON'
	'-DWITH_POWER8=OFF'
	'-DWITH_POWER9=OFF'
)

# Note: Extra Provides for Spiral (Debian compatibility).
PKGPROV="zlib1g_spiral zlib1g-dev_spiral zlib"

# We have switched to zlib-ng.
PKGEPOCH=1

# Matching Debian/Ubuntu.
PKGEPOCH_SPIRAL=1

# zlib-ng does not need separate HWCAPS builds, since they detect CPU
# features on the fly.
AB_HWCAPS=0

PKGBREAK="zlib<=1.3.1-3"
PKGREP="zlib<=1.3.1-3"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
