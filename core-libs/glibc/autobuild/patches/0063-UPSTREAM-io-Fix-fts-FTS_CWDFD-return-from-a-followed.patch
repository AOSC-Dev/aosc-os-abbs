From 3949cf506051556b1d3bb47a17f5133d75aef0e3 Mon Sep 17 00:00:00 2001
From: Adhemerval Zanella <adhemerval.zanella@linaro.org>
Date: Thu, 22 Oct 2026 15:19:07 -0300
Subject: [PATCH 063/116] UPSTREAM: io: Fix fts FTS_CWDFD return from a
 followed directory (BZ 34781)

When fts_read leaves a directory that the application asked it to
follow with fts_set (FTS_FOLLOW), it goes back through fts_symfd, a
descriptor for the parent directory saved when fts_read reached the
entry.

It does this for plain directories marked from the fts_children
list as well, not only for symbolic links.  With FTS_CWDFD, FCHDIR
makes that descriptor the virtual working directory as if it were
changing one level down, so it also pushes the followed directory on
the descriptor ring, and fts_read then closes fts_symfd.  fts_cwd_fd is
then a closed descriptor, the following entries fail with EBADF and are
returned as FTS_DNR or FTS_NS without their contents, while fts_read
and fts_close report success.  fts also closes the descriptor again
later, and if the application opened a file in the meantime, it got
the same descriptor number, so fts uses that file as its working
directory and then closes it.

Make fts_symfd the virtual working directory without pushing the
current one, and drop the ring entry pushed when fts entered the
followed directory, since it refers to the same directory as
fts_symfd.

Following a symbolic link in a physical walk fails earlier because of
BZ 34775, but plain directories trigger the issue.  The gnulib has the
same issue since FTS_CWDFD was added in 2006.

Checked on x86_64-linux-gnu and i686-linux-gnu.

Reviewed-by: Collin Funk <collin.funk1@gmail.com>

(cherry picked from commit 44f548ed82ad51744bcd0b14d121ad237b71a9b3)
---
 NEWS                      |   2 +
 io/Makefile               |   1 +
 io/fts-common.c           |  25 ++++-
 io/tst-fts-cwdfd-follow.c | 217 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 241 insertions(+), 4 deletions(-)
 create mode 100644 io/tst-fts-cwdfd-follow.c

diff --git a/NEWS b/NEWS
index af203e9122..64be502155 100644
--- a/NEWS
+++ b/NEWS
@@ -25,6 +25,8 @@ The following bugs are resolved with this release:
   [34699] build: Parallel build failures with make check xcheck
   [34734] libc: sparc: tcgetattr returns uninitialized bytes in c_cc[17]
     and c_cc[18]
+  [34781] libc: fts: FTS_CWDFD walk breaks after leaving a directory
+    followed with FTS_FOLLOW
   [34875] string: 2.44 regression: Hygon non-temporal threshold can be
     zero
 
diff --git a/io/Makefile b/io/Makefile
index 2a5b4dcb65..970d4353d7 100644
--- a/io/Makefile
+++ b/io/Makefile
@@ -198,6 +198,7 @@ tests := \
   tst-fstatat \
   tst-fts \
   tst-fts-bz22944 \
+  tst-fts-cwdfd-follow \
   tst-fts-lfs \
   tst-fts-newflags \
   tst-ftw-bz26353 \
diff --git a/io/fts-common.c b/io/fts-common.c
index 3825f0aeb4..14b1d4a5d2 100644
--- a/io/fts-common.c
+++ b/io/fts-common.c
@@ -1140,11 +1140,28 @@ cd_dot_dot:
                         SET(FTS_STOP);
                 }
         } else if (p->fts_flags & FTS_SYMFOLLOW) {
-                if (FCHDIR(sp, p->fts_symfd)) {
-                        p->fts_errno = errno;
-                        SET(FTS_STOP);
+                if (ISSET(FTS_CWDFD)) {
+                        /* The descriptor pushed on the ring when changing
+                           into P refers to the same directory as
+                           fts_symfd, so discard it.  It is not there if
+                           the change failed, and the ring is empty if
+                           deeper levels displaced it.  */
+                        if (!(p->fts_flags & FTS_DONTCHDIR)
+                            && ! i_ring_empty (&sp->fts_fd_ring)) {
+                                int fd = i_ring_pop (&sp->fts_fd_ring);
+                                if (0 <= fd)
+                                        close (fd);
+                        }
+                        /* fts_symfd becomes the virtual working directory,
+                           so it must not be closed here.  */
+                        cwd_advance_fd (sp, p->fts_symfd, false);
+                } else {
+                        if (FCHDIR(sp, p->fts_symfd)) {
+                                p->fts_errno = errno;
+                                SET(FTS_STOP);
+                        }
+                        (void)close(p->fts_symfd);
                 }
-                (void)close(p->fts_symfd);
         } else if (!(p->fts_flags & FTS_DONTCHDIR) &&
                    fts_safe_changedir(sp, p->fts_parent, -1, "..")) {
                 p->fts_errno = errno;
diff --git a/io/tst-fts-cwdfd-follow.c b/io/tst-fts-cwdfd-follow.c
new file mode 100644
index 0000000000..d52321a7a8
--- /dev/null
+++ b/io/tst-fts-cwdfd-follow.c
@@ -0,0 +1,217 @@
+/* Check fts_set FTS_FOLLOW on directories in an FTS_CWDFD walk (BZ 34781).
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <array_length.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <fts.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <support/check.h>
+#include <support/descriptors.h>
+#include <support/support.h>
+#include <support/temp_file.h>
+#include <support/xunistd.h>
+
+static char *root;
+
+/* Create the tree:
+
+     root/a/file
+     root/b/file
+     root/c/d/e/f/g/h/file
+     root/z/file
+
+   There are no symbolic links and the walk follows plain directories.  The
+   nested directories under root/c are deep enough to exhaust the descriptor
+   ring used by FTS_CWDFD, so the return from root/c can not rely on it.  */
+static void
+do_prepare (int argc, char **argv)
+{
+  char *tempdir = support_create_temp_directory ("tst-fts-cwdfd-follow-");
+  root = xasprintf ("%s/root", tempdir);
+  free (tempdir);
+  xmkdir (root, 0700);
+  add_temp_file (root);
+
+  static const char *const dirs[] =
+    {
+      "a",
+      "b",
+      "c",
+      "c/d",
+      "c/d/e",
+      "c/d/e/f",
+      "c/d/e/f/g",
+      "c/d/e/f/g/h",
+      "z"
+    };
+  for (size_t i = 0; i < array_length (dirs); i++)
+    {
+      char *path = xasprintf ("%s/%s", root, dirs[i]);
+      xmkdir (path, 0700);
+      add_temp_file (path);
+      free (path);
+    }
+
+  static const char *const files[] =
+    {
+      "a/file",
+      "b/file",
+      "c/d/e/f/g/h/file",
+      "z/file"
+    };
+  for (size_t i = 0; i < array_length (files); i++)
+    {
+      char *path = xasprintf ("%s/%s", root, files[i]);
+      xclose (xopen (path, O_WRONLY | O_CREAT | O_EXCL, 0600));
+      add_temp_file (path);
+      free (path);
+    }
+}
+#define PREPARE do_prepare
+
+static int
+compare_name (const FTSENT **a, const FTSENT **b)
+{
+  return strcmp ((*a)->fts_name, (*b)->fts_name);
+}
+
+static const char *const expected[] =
+  {
+    "a",
+    "a/file",
+    "b",
+    "b/file",
+    "c",
+    "c/d",
+    "c/d/e",
+    "c/d/e/f",
+    "c/d/e/f/g",
+    "c/d/e/f/g/h",
+    "c/d/e/f/g/h/file",
+    "z",
+    "z/file"
+  };
+
+static void
+check_walk (int options, bool sort)
+{
+  printf ("info: options=%#x sort=%d\n", options, sort);
+
+  struct support_descriptors *descriptors = support_descriptors_list ();
+
+  char *paths[] = { root, NULL };
+  FTS *fts = fts_open (paths, options, sort ? compare_name : NULL);
+  TEST_VERIFY_EXIT (fts != NULL);
+
+  bool seen[array_length (expected)] = { false };
+  /* Descriptors that the application opens during the walk.  */
+  int fds[4];
+  size_t nfds = 0;
+  size_t rootlen = strlen (root);
+  FTSENT *ent;
+  while ((ent = fts_read (fts)) != NULL)
+    {
+      const char *rel = ent->fts_path + rootlen;
+      if (*rel == '/')
+        rel++;
+
+      if (ent->fts_info != FTS_D
+	  && ent->fts_info != FTS_DP
+          && ent->fts_info != FTS_F)
+        {
+          FAIL ("%s: unexpected fts_info %d (fts_errno %d)", ent->fts_path,
+                ent->fts_info, ent->fts_errno);
+          continue;
+        }
+
+      /* The returned entry must be reachable through fts_accpath from the
+	 current, possibly virtual, working directory.  */
+      int dirfd = (options & FTS_CWDFD) ? fts->fts_cwd_fd : AT_FDCWD;
+      struct stat st;
+      if (fstatat (dirfd, ent->fts_accpath, &st, AT_SYMLINK_NOFOLLOW) != 0)
+        FAIL ("%s: fstatat (%s): %m", ent->fts_path, ent->fts_accpath);
+      else
+        TEST_VERIFY (st.st_ino == ent->fts_statp->st_ino);
+
+      /* Follow every child of root before fts_read reaches it.  fts_read does
+	 not apply the instruction to the first child.  */
+      if (ent->fts_level == FTS_ROOTLEVEL && ent->fts_info == FTS_D)
+        for (FTSENT *child = fts_children (fts, 0);
+	     child != NULL;
+             child = child->fts_link)
+          TEST_COMPARE (fts_set (fts, child, FTS_FOLLOW), 0);
+
+      /* If fts closed the descriptor of its working directory when it left
+	 the followed directory, this open reuses it.  */
+      if (ent->fts_level == 1 && ent->fts_info == FTS_DP)
+        {
+          TEST_VERIFY_EXIT (nfds < array_length (fds));
+          fds[nfds++] = xopen ("/dev/null", O_RDONLY, 0);
+        }
+
+      if (ent->fts_info != FTS_DP)
+        for (size_t i = 0; i < array_length (expected); i++)
+          if (strcmp (rel, expected[i]) == 0)
+            {
+              TEST_VERIFY (!seen[i]);
+              seen[i] = true;
+            }
+    }
+  TEST_COMPARE (errno, 0);
+  TEST_COMPARE (fts_close (fts), 0);
+
+  for (size_t i = 0; i < array_length (expected); i++)
+    if (!seen[i])
+      FAIL ("%s/%s was not visited", root, expected[i]);
+
+  /* fts must not close descriptors that it does not own.  */
+  for (size_t i = 0; i < nfds; i++)
+    if (fcntl (fds[i], F_GETFD) < 0)
+      FAIL ("descriptor %d was closed by fts: %m", fds[i]);
+    else
+      xclose (fds[i]);
+
+  support_descriptors_check (descriptors);
+  support_descriptors_free (descriptors);
+}
+
+static int
+do_test (void)
+{
+  static const int options[] =
+    {
+      FTS_PHYSICAL,
+      FTS_PHYSICAL | FTS_CWDFD,
+      FTS_PHYSICAL | FTS_CWDFD | FTS_DEFER_STAT,
+    };
+
+  for (size_t i = 0; i < array_length (options); i++)
+    {
+      check_walk (options[i], true);
+      check_walk (options[i], false);
+    }
+
+  return 0;
+}
+
+#include <support/test-driver.c>
-- 
