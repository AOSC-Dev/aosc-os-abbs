From 0774a319f3defa0726cf89abd612e0c8005db8de Mon Sep 17 00:00:00 2001
From: Pierre Blanchard <pierre.blanchard@arm.com>
Date: Fri, 30 Oct 2026 14:14:33 +0000
Subject: [PATCH 069/116] UPSTREAM: AArch64: Preserve SVE pow/powf base
 magnitude across lanes [BZ #34921]

When another lane needs subnormal normalization, svmul_m merges the
original signed x into lanes outside its predicate. This restores the
sign bit previously cleared for negative bases with integer exponents.

(cherry picked from commit 82fe4d0162816a7f103da2e0a4a92bcf45fa483a)
---
 NEWS                           | 2 ++
 SHARED-FILES                   | 4 ++--
 sysdeps/aarch64/fpu/sve/pow.c  | 3 ++-
 sysdeps/aarch64/fpu/sve/powf.c | 3 ++-
 4 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/NEWS b/NEWS
index 6f96e9676b..4bddfbe2d1 100644
--- a/NEWS
+++ b/NEWS
@@ -34,6 +34,8 @@ The following bugs are resolved with this release:
     zero
   [34920] math: Bug in SVE pow and powf with mixed positive and negative
     base lanes with integer exponent
+  [34921] math: Bug in SVE pow and powf with mixed subnormal and
+    negative base lanes with integer exponent
 
 Version 2.44
 
diff --git a/SHARED-FILES b/SHARED-FILES
index cf2a19c015..ebdced42fb 100644
--- a/SHARED-FILES
+++ b/SHARED-FILES
@@ -544,9 +544,9 @@ arm-optimized-routines:
   sysdeps/aarch64/fpu/sve/log2p1f.c
   # math/aarch64/sve/logf.c, revision 8ca4cc0
   sysdeps/aarch64/fpu/sve/logf.c
-  # math/aarch64/sve/pow.c, revision 2c38e83
+  # math/aarch64/sve/pow.c, revision 56dea8e
   sysdeps/aarch64/fpu/sve/pow.c
-  # math/aarch64/sve/powf.c, revision 2c38e83
+  # math/aarch64/sve/powf.c, revision 56dea8e
   sysdeps/aarch64/fpu/sve/powf.c
   # math/aarch64/sve/powr.c, revision 30da949
   sysdeps/aarch64/fpu/sve/powr.c
diff --git a/sysdeps/aarch64/fpu/sve/pow.c b/sysdeps/aarch64/fpu/sve/pow.c
index 6fa3b44a41..6c72c7ef35 100644
--- a/sysdeps/aarch64/fpu/sve/pow.c
+++ b/sysdeps/aarch64/fpu/sve/pow.c
@@ -116,7 +116,8 @@ svfloat64_t SV_NAME_D2 (pow) (svfloat64_t x, svfloat64_t y, const svbool_t pg)
   if (__glibc_unlikely (svptest_any (yint_or_xpos, x_is_subnormal)))
     {
       /* Normalize subnormal x so exponent becomes negative.  */
-      vix = svreinterpret_u64 (svmul_m (x_is_subnormal, x, 0x1p52));
+      vix = svreinterpret_u64 (
+	  svmul_m (x_is_subnormal, svreinterpret_f64 (vix), 0x1p52));
       vix = svand_m (x_is_subnormal, vix, 0x7fffffffffffffff);
       vix = svsub_m (x_is_subnormal, vix, 52ULL << 52);
     }
diff --git a/sysdeps/aarch64/fpu/sve/powf.c b/sysdeps/aarch64/fpu/sve/powf.c
index 8f6da3be21..9dcf54e286 100644
--- a/sysdeps/aarch64/fpu/sve/powf.c
+++ b/sysdeps/aarch64/fpu/sve/powf.c
@@ -104,7 +104,8 @@ svfloat32_t SV_NAME_F2 (pow) (svfloat32_t x, svfloat32_t y, const svbool_t pg)
   if (__glibc_unlikely (svptest_any (yint_or_xpos, x_is_subnormal)))
     {
       /* Normalize subnormal x so exponent becomes negative.  */
-      vix = svreinterpret_u32 (svmul_m (x_is_subnormal, x, 0x1p23f));
+      vix = svreinterpret_u32 (
+	  svmul_m (x_is_subnormal, svreinterpret_f32 (vix), 0x1p23f));
       vix = svand_m (x_is_subnormal, vix, 0x7fffffff);
       vix = svsub_m (x_is_subnormal, vix, d->subnormal_bias);
     }
