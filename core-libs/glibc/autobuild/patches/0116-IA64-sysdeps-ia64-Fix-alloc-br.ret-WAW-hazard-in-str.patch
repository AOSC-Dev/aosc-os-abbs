From fd4b6e995dbf283b751cc44e5bb928dffb1c641e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Rebe?= <rene@exactco.de>
Date: Tue, 4 Aug 2026 21:16:01 +0200
Subject: [PATCH 116/116] IA64: sysdeps/ia64: Fix alloc/br.ret WAW hazard in
 strncmp
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The assembly language implementation of strncmp() is missing a stop
between alloc and a subsequent br.ret in an early bail-out path.

On some system, this causes SIGILL. Add the stop to fix the issue.

Fixes: c469a8ffff12684c2b6dd8353111bfb4559b38c5 ("sysdeps/ia64: Implement pipelined loop for strncmp")
Signed-off-by: René Rebe <rene@exactco.de>
[ commit message ]
Signed-off-by: Tomas Glozar <tglozar@gmail.com>
---
 sysdeps/ia64/strncmp.S | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sysdeps/ia64/strncmp.S b/sysdeps/ia64/strncmp.S
index 5b9ddae80c..c455b9df9e 100644
--- a/sysdeps/ia64/strncmp.S
+++ b/sysdeps/ia64/strncmp.S
@@ -48,6 +48,7 @@
 
 ENTRY(strncmp)
 	alloc	r2 = ar.pfs, 3, 0, 0, 0
+	;;
 	adds	tmp = 1, sx1		// pre-compute sx1 + 1 for both sentinel (sx1 + n + 1) and sy1 (sx1 + 1)
 	mov	one = 1
 	mov	ret0 = r0
-- 
2.56.0

