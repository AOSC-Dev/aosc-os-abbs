From cb648f28f16551bcca94e6c9a0370690a2d30729 Mon Sep 17 00:00:00 2001
From: Adhemerval Zanella <adhemerval.zanella@linaro.org>
Date: Wed, 21 Oct 2026 10:54:11 -0300
Subject: [PATCH 70/72] UPSTREAM: linux: Add C++ and multiple inclusion guards
 to sys/pidfd.h (BZ 34752)

Checked on aarch64-linux-gnu.

Reviewed-by: Carlos O'Donell <carlos@redhat.com>
(cherry picked from commit 69a7039b7507ed0568489ecef945c8a8e158af29)
---
 NEWS                                | 1 +
 sysdeps/unix/sysv/linux/sys/pidfd.h | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/NEWS b/NEWS
index 4bddfbe2d1..8274e5c3ab 100644
--- a/NEWS
+++ b/NEWS
@@ -25,6 +25,7 @@ The following bugs are resolved with this release:
   [34699] build: Parallel build failures with make check xcheck
   [34734] libc: sparc: tcgetattr returns uninitialized bytes in c_cc[17]
     and c_cc[18]
+  [34752] libc: <sys/pidfd.h> not protected for C++
   [34775] libc: Regression in fts with FTS_FOLLOW
   [34781] libc: fts: FTS_CWDFD walk breaks after leaving a directory
     followed with FTS_FOLLOW
diff --git a/sysdeps/unix/sysv/linux/sys/pidfd.h b/sysdeps/unix/sysv/linux/sys/pidfd.h
index 93c7defcac..e6c22d61c0 100644
--- a/sysdeps/unix/sysv/linux/sys/pidfd.h
+++ b/sysdeps/unix/sysv/linux/sys/pidfd.h
@@ -17,6 +17,7 @@
    <https://www.gnu.org/licenses/>.  */
 
 #ifndef _PIDFD_H
+#define _PIDFD_H 1
 
 #include <fcntl.h>
 #include <bits/types/siginfo_t.h>
@@ -115,6 +116,8 @@ struct pidfd_info
 
 #define PIDFD_GET_INFO                        _IOWR(PIDFS_IOCTL_MAGIC, 11, struct pidfd_info)
 
+__BEGIN_DECLS
+
 /* Returns a file descriptor that refers to the process PID.  The
    close-on-exec is set on the file descriptor.  */
 extern int pidfd_open (__pid_t __pid, unsigned int __flags) __THROW;
@@ -136,4 +139,6 @@ extern int pidfd_send_signal (int __pidfd, int __sig, siginfo_t *__info,
    or -1 in case of an error.  */
 extern pid_t pidfd_getpid (int __fd) __THROW;
 
+__END_DECLS
+
 #endif /* _PIDFD_H  */
-- 
2.56.0

