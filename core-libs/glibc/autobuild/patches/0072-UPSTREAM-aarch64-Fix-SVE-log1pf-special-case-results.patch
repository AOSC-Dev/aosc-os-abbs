From e352d61070fa80b7ec9ed70e004091a546d73dc7 Mon Sep 17 00:00:00 2001
From: Dylan Fleming <Dylan.Fleming@arm.com>
Date: Wed, 4 Nov 2026 15:06:39 +0000
Subject: [PATCH 72/80] UPSTREAM: aarch64: Fix SVE log1pf special case results
 [BZ #34940]

In the log1pf special case, inf was loaded as uint32_t,
and then negated with "-" operator. Negative uint32_t inf
when cast to float results in 0x1.01p+31, not -inf.

Reviewed-by: Adhemerval Zanella  <adhemerval.zanella@linaro.org>
(cherry picked from commit a139f123b984dc22af63a7c2f0bca71b72d106fe)
---
 NEWS                             | 1 +
 SHARED-FILES                     | 2 +-
 sysdeps/aarch64/fpu/sve/log1pf.c | 8 ++++----
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/NEWS b/NEWS
index da0a814586..530310e65c 100644
--- a/NEWS
+++ b/NEWS
@@ -39,6 +39,7 @@ The following bugs are resolved with this release:
     negative base lanes with integer exponent
   [34923] math: AArch64: SVE acosh loses accuracy near 1 depending on
     other vector lanes
+  [34940] math: Bug in SVE log1pf special case
 
 Version 2.44
 
diff --git a/SHARED-FILES b/SHARED-FILES
index 0e0c0c82c3..edf8605628 100644
--- a/SHARED-FILES
+++ b/SHARED-FILES
@@ -532,7 +532,7 @@ arm-optimized-routines:
   sysdeps/aarch64/fpu/sve/log10p1f.c
   # math/aarch64/sve/log1p.c, revision 1aad38d
   sysdeps/aarch64/fpu/sve/log1p.c
-  # math/aarch64/sve/log1pf.c, revision 1aad38d
+  # math/aarch64/sve/log1pf.c, revision 5e51e52
   sysdeps/aarch64/fpu/sve/log1pf.c
   # math/aarch64/sve/log2.c, revision 91b052e
   sysdeps/aarch64/fpu/sve/log2.c
diff --git a/sysdeps/aarch64/fpu/sve/log1pf.c b/sysdeps/aarch64/fpu/sve/log1pf.c
index 450892cedf..3982911808 100644
--- a/sysdeps/aarch64/fpu/sve/log1pf.c
+++ b/sysdeps/aarch64/fpu/sve/log1pf.c
@@ -27,11 +27,11 @@ special_case (svfloat32_t x, svfloat32_t y, svbool_t pg, svbool_t special,
 {
   y = svsel_f32 (special, svreinterpret_f32 (sv_u32 (d->nan)), y);
 
-  svbool_t ret_pinf = svcmpeq (pg, x, asfloat (d->inf));
+  svbool_t ret_pinf = svcmpeq (pg, x, INFINITY);
   svbool_t ret_minf = svcmpeq (pg, x, -1.0f);
 
-  y = svsel_f32 (ret_pinf, svreinterpret_f32 (sv_u32 (d->inf)), y);
-  return svsel_f32 (ret_minf, sv_f32 (-d->inf), y);
+  y = svsel_f32 (ret_pinf, sv_f32 (INFINITY), y);
+  return svsel_f32 (ret_minf, sv_f32 (-INFINITY), y);
 }
 
 /* Vector log1pf approximation using polynomial on reduced interval. Worst-case
@@ -43,7 +43,7 @@ svfloat32_t SV_NAME_F1 (log1p) (svfloat32_t x, svbool_t pg)
 
   const struct sv_log1pf_data *d = ptr_barrier (&sv_log1pf_data);
   /* x < -1, Inf/Nan.  */
-  svbool_t special = svcmpeq (pg, svreinterpret_u32 (x), d->inf);
+  svbool_t special = svcmpeq (pg, x, INFINITY);
   special = svorn_z (pg, special, svcmpge (pg, x, -1.0f));
 
   if (__glibc_unlikely (svptest_any (pg, special)))
-- 
2.56.1

