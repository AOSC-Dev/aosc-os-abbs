PKGNAME=libguestfs
PKGSEC=libs
PKGDEP="augeas cdrkit cpio hivex fuse gcc-runtime glibc json-c \
        libconfig libtirpc libvirt libxml2 ncurses pcre2 \
        perl-sys-virt qemu readline"
PKGDEP__OCAML_NATIVE="${PKGDEP} supermin"
PKGSUG="perl python-3 ruby php lua go rustc openjdk"
PKGSUG__OCAML_NATIVE="${PKGSUG} ocaml"
BUILDDEP="${PKGSUG} gperf libintl-perl pcre2 perl-module-build \
          perl-string-shellquote llvm yara ocaml findlib"
BUILDDEP__OCAML_NATIVE="${BUILDDEP} ocaml-augeas"
PKGDES="Access and modify virtual machine disk image"

ABTYPE=autotools
# FIXME: Set --disable-erlang.
# No rule to make target '/usr/lib/erlang/lib/erl_interface-5.8.1/lib/libei.a', needed by 'erl-guestfs'.
#
# FIXME: Set --disable-daemon, --disable-appliance, --disable-appliance-format-auto, --disable-ocaml.
# Only ocaml native architectures have "ocaml-augeas", and --enable-daemon requires --enable-ocaml,
# --enable-appliance requires --enable-daemon.
AUTOTOOLS_AFTER=(
    '--disable-werror'
    '--enable-largefile'
    '--disable-packet-dump'
    '--enable-fuse'
    '--disable-daemon'
    '--disable-install-daemon'
    '--disable-appliance'
    '--disable-appliance-format-auto'
    '--disable-ocaml'
    '--enable-perl'
    '--enable-python'
    '--enable-ruby'
    '--disable-haskell'
    '--enable-php'
    '--disable-erlang'
    '--enable-lua'
    '--enable-golang'
    '--enable-rust'
    '--with-java'
    '--with-libvirt'
    '--with-readline'
    'PYTHON=/usr/bin/python3'
)

# NOTE: '--with-distro=DEBIAN' is used to pass the distro information to supermin,
# so that it can detect packages installed in the appliance using dpkg/apt.
AUTOTOOLS_AFTER__OCAML_NATIVE=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-daemon'
    '--enable-appliance'
    '--enable-appliance-format-auto'
    '--enable-ocaml'
    '--with-distro=DEBIAN'
)

# FIXME: OCaml has LTO disabled, enabling LTO here results in linkage failure.
NOLTO=1

# FIXME: cannot find input file on path at [...]/libguestfs-1.60.1/abbuild/podwrapper.pl line 672.
ABSHADOW=0
