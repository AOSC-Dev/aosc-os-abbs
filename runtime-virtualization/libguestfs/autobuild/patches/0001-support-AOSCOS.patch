From ce6415380c2675eb744fec26541e49eebf750f86 Mon Sep 17 00:00:00 2001
From: CAB233 <yidaduizuoye@outlook.com>
Date: Mon, 7 Sep 2026 15:38:23 +0800
Subject: [PATCH] support AOSCOS

---
 appliance/excludefiles.in       |  1 +
 appliance/hostfiles.in          |  1 +
 appliance/packagelist.in        | 21 +++++++++++++++++++++
 daemon/inspect_fs.ml            |  5 +++++
 daemon/inspect_fs_unix.ml       |  2 ++
 daemon/inspect_types.ml         |  4 ++++
 daemon/inspect_types.mli        |  2 ++
 generator/actions_inspection.ml |  4 ++++
 m4/guestfs-appliance.m4         |  5 +++--
 9 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/appliance/excludefiles.in b/appliance/excludefiles.in
index 181b1828d..5ef456b60 100644
--- a/appliance/excludefiles.in
+++ b/appliance/excludefiles.in
@@ -14,6 +14,7 @@ dnl   ARCHLINUX=1  For Archlinux.
 dnl   SUSE=1       For OpenSUSE.
 dnl   FRUGALWARE=1 For Frugalware.
 dnl   MAGEIA=1     For Mageia.
+dnl   AOSCOS=1     For AOSCOS.
 dnl
 dnl Note that any matching file will be dropped from the appliance.
 dnl Of course, this may break the appliance, so be careful.
diff --git a/appliance/hostfiles.in b/appliance/hostfiles.in
index 58b62e9ff..9229c04b7 100644
--- a/appliance/hostfiles.in
+++ b/appliance/hostfiles.in
@@ -15,6 +15,7 @@ dnl   MAGEIA=1       For Mageia.
 dnl   OPENMANDRIVA=1 For OpenMandriva.
 dnl   OPENCLOUDOS=1  For OpenCloudOS.
 dnl   TENCENTOS=1    For TencentOS.
+dnl   AOSCOS=1       For AOSCOS.
 
 /etc/ld.so.cache
 /lib/lsb/*
diff --git a/appliance/packagelist.in b/appliance/packagelist.in
index 6414ee471..e315682b4 100644
--- a/appliance/packagelist.in
+++ b/appliance/packagelist.in
@@ -13,6 +13,7 @@ dnl   FRUGALWARE=1  For Frugalware.
 dnl   MAGEIA=1      For Mageia.
 dnl   OPENCLOUDOS=1 For OpencloudOS.
 dnl   TENCENTOS=1   For TencentOS.
+dnl   AOSCOS=1      For AOSCOS.
 dnl
 dnl There is also a list of packages which are excluded if they appear
 dnl as dependencies of the packages below.  See: excludelist.in
@@ -266,6 +267,26 @@ ifelse(TENCENTOS,1,
   zstd
 )
 
+ifelse(AOSCOS,1,
+  cdrkit
+  cryptsetup
+  dhcpcd
+  gptfdisk
+  grub
+  iproute2
+  iputils
+  linux+kernel
+  lrzip
+  mtools
+  nilfs-utils
+  ntfs-3g
+  openssh
+  systemd
+  vim
+  xz
+  zstd
+)
+
 include(guestfsd.deps)
 
 acl
diff --git a/daemon/inspect_fs.ml b/daemon/inspect_fs.ml
index 121b267ea..8fa0a716a 100644
--- a/daemon/inspect_fs.ml
+++ b/daemon/inspect_fs.ml
@@ -294,6 +294,8 @@ and check_package_format { distro } =
      Some PACKAGE_FORMAT_APK
   | Some DISTRO_VOID_LINUX ->
      Some PACKAGE_FORMAT_XBPS
+  | Some DISTRO_AOSCOS ->
+     Some PACKAGE_FORMAT_DEB
   | Some DISTRO_BUILDROOT
   | Some DISTRO_CIRROS
   | Some DISTRO_COREOS
@@ -394,6 +396,9 @@ and check_package_management { distro; version } =
   | Some DISTRO_OPENEULER->
      Some PACKAGE_MANAGEMENT_DNF
 
+  | Some DISTRO_AOSCOS ->
+     Some PACKAGE_MANAGEMENT_OMA
+
   | Some DISTRO_BUILDROOT
   | Some DISTRO_CIRROS
   | Some DISTRO_COREOS
diff --git a/daemon/inspect_fs_unix.ml b/daemon/inspect_fs_unix.ml
index 952a7cd15..e72db53cd 100644
--- a/daemon/inspect_fs_unix.ml
+++ b/daemon/inspect_fs_unix.ml
@@ -62,6 +62,7 @@ let re_openmandriva =
   PCRE.compile "OpenMandriva.*release (\\d+)\\.(\\d+)\\.?(\\d+)? .*"
 let re_opencloudos = PCRE.compile "OpenCloudOS.*release (\\d+)"
 let re_tencentos = PCRE.compile "TencentOS.* (\\d+)\\.(\\d+)"
+let re_aoscos = PCRE.compile "AOSC OS.* (\\d+)\\.(\\d+)\\.?(\\d+)?"
 
 let arch_binaries =
   [ "/bin/bash"; "/bin/ls"; "/bin/echo"; "/bin/rm"; "/bin/sh" ]
@@ -146,6 +147,7 @@ and parse_os_release_version_id value data =
 and distro_of_os_release_id = function
   | "alpine" -> Some DISTRO_ALPINE_LINUX
   | "altlinux" -> Some DISTRO_ALTLINUX
+  | "aoscos" -> Some DISTRO_AOSCOS
   | "arch" -> Some DISTRO_ARCHLINUX
   | "centos" -> Some DISTRO_CENTOS
   | "circle" -> Some DISTRO_CIRCLE
diff --git a/daemon/inspect_types.ml b/daemon/inspect_types.ml
index f4ee5d0db..fe3f5586e 100644
--- a/daemon/inspect_types.ml
+++ b/daemon/inspect_types.ml
@@ -69,6 +69,7 @@ and os_type =
 and distro =
   | DISTRO_ALPINE_LINUX
   | DISTRO_ALTLINUX
+  | DISTRO_AOSCOS
   | DISTRO_ARCHLINUX
   | DISTRO_BUILDROOT
   | DISTRO_CENTOS
@@ -123,6 +124,7 @@ and package_management =
   | PACKAGE_MANAGEMENT_APK
   | PACKAGE_MANAGEMENT_APT
   | PACKAGE_MANAGEMENT_DNF
+  | PACKAGE_MANAGEMENT_OMA
   | PACKAGE_MANAGEMENT_PACMAN
   | PACKAGE_MANAGEMENT_PISI
   | PACKAGE_MANAGEMENT_PORTAGE
@@ -211,6 +213,7 @@ and string_of_os_type = function
 and string_of_distro = function
   | DISTRO_ALPINE_LINUX -> "alpinelinux"
   | DISTRO_ALTLINUX -> "altlinux"
+  | DISTRO_AOSCOS -> "aoscos"
   | DISTRO_ARCHLINUX -> "archlinux"
   | DISTRO_BUILDROOT -> "buildroot"
   | DISTRO_CENTOS -> "centos"
@@ -267,6 +270,7 @@ and string_of_package_management = function
   | PACKAGE_MANAGEMENT_APK -> "apk"
   | PACKAGE_MANAGEMENT_APT -> "apt"
   | PACKAGE_MANAGEMENT_DNF -> "dnf"
+  | PACKAGE_MANAGEMENT_OMA -> "oma"
   | PACKAGE_MANAGEMENT_PACMAN -> "pacman"
   | PACKAGE_MANAGEMENT_PISI -> "pisi"
   | PACKAGE_MANAGEMENT_PORTAGE -> "portage"
diff --git a/daemon/inspect_types.mli b/daemon/inspect_types.mli
index 4c6579fba..6445ab638 100644
--- a/daemon/inspect_types.mli
+++ b/daemon/inspect_types.mli
@@ -76,6 +76,7 @@ and os_type =
 and distro =
   | DISTRO_ALPINE_LINUX
   | DISTRO_ALTLINUX
+  | DISTRO_AOSCOS
   | DISTRO_ARCHLINUX
   | DISTRO_BUILDROOT
   | DISTRO_CENTOS
@@ -130,6 +131,7 @@ and package_management =
   | PACKAGE_MANAGEMENT_APK
   | PACKAGE_MANAGEMENT_APT
   | PACKAGE_MANAGEMENT_DNF
+  | PACKAGE_MANAGEMENT_OMA
   | PACKAGE_MANAGEMENT_PACMAN
   | PACKAGE_MANAGEMENT_PISI
   | PACKAGE_MANAGEMENT_PORTAGE
diff --git a/generator/actions_inspection.ml b/generator/actions_inspection.ml
index 3cf6f7dc2..9b0ce2319 100644
--- a/generator/actions_inspection.ml
+++ b/generator/actions_inspection.ml
@@ -161,6 +161,10 @@ Alpine Linux.
 
 ALT Linux.
 
+=item "aoscos"
+
+AOSC OS.
+
 =item "archlinux"
 
 Arch Linux.
diff --git a/m4/guestfs-appliance.m4 b/m4/guestfs-appliance.m4
index fdc5fc728..cdcc8dc75 100644
--- a/m4/guestfs-appliance.m4
+++ b/m4/guestfs-appliance.m4
@@ -122,7 +122,8 @@ if test "x$ENABLE_APPLIANCE" = "xyes"; then
                         [OPENMANDRIVA],[DISTRO=OPENMANDRIVA],
                         [OPENCLOUDOS],[DISTRO=OPENCLOUDOS],
                         [TENCENTOS],[DISTRO=TENCENTOS],
-                        [OPENEULER],[DISTRO=OPENEULER])
+                        [OPENEULER],[DISTRO=OPENEULER]
+                        [AOSC],[DISTRO=AOSCOS])
                 AC_MSG_RESULT([$DISTRO (from /etc/os-release)])
             else
                 AC_MSG_ERROR([/etc/os-release not available, please specify the distro using --with-distro=DISTRO])
@@ -135,7 +136,7 @@ AM_CONDITIONAL([HAVE_RPM],
     [AS_CASE([$DISTRO], [REDHAT | SUSE | OPENMANDRIVA | MAGEIA | OPENCLOUDOS | TENCENTOS | OPENEULER ], [true],
                         [*], [false])])
 AM_CONDITIONAL([HAVE_DPKG],
-    [AS_CASE([$DISTRO], [DEBIAN | UBUNTU ], [true],
+    [AS_CASE([$DISTRO], [DEBIAN | UBUNTU | AOSCOS ], [true],
                         [*], [false])])
 AM_CONDITIONAL([HAVE_PACMAN],
     [AS_CASE([$DISTRO], [ARCHLINUX | FRUGALWARE | ARTIX], [true],
-- 
2.55.0

