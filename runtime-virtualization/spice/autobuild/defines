PKGNAME=spice
PKGSEC=libs
PKGDEP="alsa-lib libjpeg-turbo cyrus-sasl pixman mesa lz4 opus \
        gstreamer libcacard"
BUILDDEP="pyparsing spice-protocol"
PKGDES="SPICE client and server"

ABTYPE=meson
MESON_AFTER=(
    '-Dgstreamer=1.0'
    '-Dlz4=true'
    '-Dsasl=true'
    '-Dopus=enabled'
    '-Dsmartcard=enabled'
    '-Dalignment-checks=false'
    '-Dextra-checks=false'
    '-Dstatistics=false'
    '-Dmanual=true'
    '-Dinstrumentation=no'
    '-Dtests=false'
)
