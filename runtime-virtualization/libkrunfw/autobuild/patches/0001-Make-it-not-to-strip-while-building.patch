From 5e86e53cafee4ef0fa33176e6afef85ca5c46e93 Mon Sep 17 00:00:00 2001
From: Mikura Kyouka <13207280@qq.com>
Date: Sun, 27 Sep 2026 19:32:46 +0800
Subject: [PATCH] Make it not to strip while building

---
 Makefile                 | 3 ---
 config-libkrunfw_aarch64 | 2 +-
 config-libkrunfw_riscv64 | 2 +-
 config-libkrunfw_x86_64  | 2 +-
 4 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/Makefile b/Makefile
index 23a1425..2c691b6 100644
--- a/Makefile
+++ b/Makefile
@@ -205,9 +205,6 @@ ifeq ($(OS),Windows)
 	$(CC) -shared -DABI_VERSION=$(ABI_VERSION) -O2 -o $@ $(KERNEL_C_BUNDLE) $(QBOOT_C_BUNDLE) $(INITRD_C_BUNDLE) -Wl,--kill-at -Wl,--nxcompat
 else
 	$(CC) -fPIC -DABI_VERSION=$(ABI_VERSION) -shared $(SONAME_$(OS)) -o $@ $(KERNEL_C_BUNDLE) $(QBOOT_C_BUNDLE) $(INITRD_C_BUNDLE)
-ifeq ($(OS),Linux)
-	$(STRIP) $(KRUNFW_BINARY_$(OS))
-endif
 endif
 
 install:
diff --git a/config-libkrunfw_aarch64 b/config-libkrunfw_aarch64
index 325ed0c..6d3c3d4 100644
--- a/config-libkrunfw_aarch64
+++ b/config-libkrunfw_aarch64
@@ -3499,7 +3499,7 @@ CONFIG_DEBUG_BUGVERBOSE=y
 #
 CONFIG_AS_HAS_NON_CONST_ULEB128=y
 CONFIG_FRAME_WARN=1024
-CONFIG_STRIP_ASM_SYMS=y
+CONFIG_STRIP_ASM_SYMS=n
 CONFIG_HEADERS_INSTALL=y
 CONFIG_DEBUG_SECTION_MISMATCH=y
 CONFIG_SECTION_MISMATCH_WARN_ONLY=y
diff --git a/config-libkrunfw_riscv64 b/config-libkrunfw_riscv64
index deaba32..c6ad93e 100644
--- a/config-libkrunfw_riscv64
+++ b/config-libkrunfw_riscv64
@@ -3182,7 +3182,7 @@ CONFIG_DEBUG_BUGVERBOSE=y
 #
 CONFIG_AS_HAS_NON_CONST_ULEB128=y
 CONFIG_FRAME_WARN=1024
-CONFIG_STRIP_ASM_SYMS=y
+CONFIG_STRIP_ASM_SYMS=n
 CONFIG_HEADERS_INSTALL=y
 CONFIG_DEBUG_SECTION_MISMATCH=y
 CONFIG_SECTION_MISMATCH_WARN_ONLY=y
diff --git a/config-libkrunfw_x86_64 b/config-libkrunfw_x86_64
index 17e5d9d..b06bec3 100644
--- a/config-libkrunfw_x86_64
+++ b/config-libkrunfw_x86_64
@@ -2788,7 +2788,7 @@ CONFIG_DEBUG_INFO_NONE=y
 # CONFIG_DEBUG_INFO_DWARF4 is not set
 # CONFIG_DEBUG_INFO_DWARF5 is not set
 CONFIG_FRAME_WARN=2048
-CONFIG_STRIP_ASM_SYMS=y
+CONFIG_STRIP_ASM_SYMS=n
 # CONFIG_READABLE_ASM is not set
 # CONFIG_HEADERS_INSTALL is not set
 CONFIG_DEBUG_SECTION_MISMATCH=y
-- 
2.55.0

