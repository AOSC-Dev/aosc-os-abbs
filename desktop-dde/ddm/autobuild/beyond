abinfo "Copying maintainer scripts..."
cp -v "$SRCDIR/debian/ddm.postinst" "$SRCDIR/autobuild/postinst"
cp -v "$SRCDIR/debian/ddm.postrm" "$SRCDIR/autobuild/postrm"
cp -v "$SRCDIR/debian/ddm.prerm" "$SRCDIR/autobuild/prerm"

abinfo "Patching maintainer scripts..."
sed -i "s|addgroup|groupadd|g" "$SRCDIR/autobuild/postinst"
sed -i "s|adduser --system --ingroup dde --home /var/lib/ddm dde|useradd --system -g dde --home-dir /var/lib/ddm dde|g" "$SRCDIR/autobuild/postinst"
