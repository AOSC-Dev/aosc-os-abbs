PKGNAME=dtk6systemsettings
PKGSEC=dde
PKGDEP="dtk6core gcc-runtime glibc libxcrypt qt-6"
BUILDDEP="cmake ninja doxygen"
PKGDES="Qt-based development library for system settings on Deepin"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_DOCS=ON'
    '-DBUILD_EXAMPLES=OFF'
    '-DMKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules'
    '-DCMAKE_INSTALL_LIBDIR=lib'
    '-DCMAKE_INSTALL_PREFIX=/usr'
    '-DDTK_VERSION=6.0.2'
)
