PKGNAME=jasper
PKGDES="Jasper JPEG2000"
PKGSEC=libs
PKGDEP="libjpeg-turbo libheif"
PKGBREAK="gdk-pixbuf<=2.36.0 gegl<=0.2.0-7 gegl-0.3<=1:0.3.8-1 \
          ghostscript<=9.19-1 gimp<=2.8.18 graphicsmagick<=1.3.25-1 \
          gst-plugins-bad-0-10<=1:0.10.23 kdelibs<=4.14.26 libraw<=0.17.2 \
          opencv<=3.1.0-2 openimageio<=1.6.17-1 openscenegraph<=3.4.0-1 \
          tdelibs<=14.0.4"

ABTYPE="cmakeninja"
CMAKE_AFTER=(
    '-DALLOW_IN_SOURCE_BUILD=ON'
    '-DJAS_PACKAGING=ON'
    '-DJAS_ENABLE_CMAKE_PACKAGE_CONFIG=ON'
    '-DJAS_ENABLE_CMAKE_PACKAGE_CONFIG_CPS=ON'
    '-DJAS_ENABLE_HIDDEN=ON'
    '-DJAS_ENABLE_32BIT=OFF'
    '-DJAS_ENABLE_LIBJPEG=ON'
    '-DJAS_ENABLE_LIBHEIF=ON'
    '-DJAS_ENABLE_OPENGL=OFF'
    # disable API docs
    '-DJAS_ENABLE_DOC=OFF'
    '-DJAS_ENABLE_LATEX=OFF'
    # enable utils and man pages
    '-DJAS_ENABLE_PROGRAMS=ON'
    # build all encoding into the library
    '-DJAS_INCLUDE_BMP_CODEC=ON'
    '-DJAS_INCLUDE_JP2_CODEC=ON'
    '-DJAS_INCLUDE_JPC_CODEC=ON'
    '-DJAS_INCLUDE_JPG_CODEC=ON'
    '-DJAS_INCLUDE_HEIC_CODEC=ON'
    '-DJAS_INCLUDE_MIF_CODEC=ON'
    '-DJAS_INCLUDE_PGX_CODEC=ON'
    '-DJAS_INCLUDE_PNM_CODEC=ON'
    '-DJAS_INCLUDE_RAS_CODEC=ON'
    # activate these encodings by default
    '-DJAS_ENABLE_BMP_CODEC=ON'
    '-DJAS_ENABLE_JP2_CODEC=ON'
    '-DJAS_ENABLE_JPC_CODEC=ON'
    '-DJAS_ENABLE_JPG_CODEC=ON'
    '-DJAS_ENABLE_HEIC_CODEC=ON'
    # upstream discourages enabling MIF for security
    '-DJAS_ENABLE_MIF_CODEC=OFF'
    '-DJAS_ENABLE_PGX_CODEC=ON'
    '-DJAS_ENABLE_PNM_CODEC=ON'
    '-DJAS_ENABLE_RAS_CODEC=ON'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
