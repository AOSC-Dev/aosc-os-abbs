PKGNAME=openjpeg
PKGSEC=libs
PKGDEP="lcms2 libpng libtiff zlib"
BUILDDEP="cmake jbigkit"
PKGDES="Library and tools to work with JPEG-2000 images"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    "-DBUILD_DOC=OFF"
    "-DBUILD_STATIC_LIBS=OFF"
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
