PKGNAME=openimageio
PKGSEC=libs
PKGDEP="boost glew jasper libraw libtiff opencolorio opencv openexr \
        openssl pugixml libheif tbb openvdb python-3 giflib imath \
        freetype ptex ffmpeg qt-6 libwebp"
BUILDDEP="cmake pybind11 robin-map fmt llvm"
PKGDES="Library and utilities to handle images"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DUSE_EXTERNAL_PUGIXML=ON'
    '-DOIIO_BUILD_TOOLS=ON'
    '-DUSE_PYTHON=ON'
    '-DUSE_FFMPEG=OFF'
    '-DBUILD_DOCS=OFF'
    '-DINSTALL_DOCS=OFF'
    '-DINSTALL_FONTS=OFF'
    '-DUSE_QT=ON'
    '-DUSE_PTEX=ON'
    '-DBUILD_TESTING=OFF'
    '-DOIIO_BUILD_TESTS=OFF'
    '-DOIIO_DOWNLOAD_MISSING_TESTDATA=OFF'
    '-DCMAKE_CXX_STANDARD=17'
)

PKGBREAK="blender<=4.4.3-1"
