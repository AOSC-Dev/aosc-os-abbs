PKGNAME=imlib2
PKGDES="Image loading, saving, rendering, and manipulation library"
PKGDEP="libtiff giflib bzip2 freetype libpng libid3tag libjpeg-turbo"
PKGSEC=libs

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--sysconfdir=/etc/imlib2'
    '--x-libraries=/usr/lib'
)
AUTOTOOLS_AFTER__AMD64=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-amd64'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
