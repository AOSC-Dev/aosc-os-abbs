PKGNAME=librsvg
PKGSEC=libs
PKGDEP="cairo pango gdk-pixbuf dav1d glib freetype libxml2"
BUILDDEP="gobject-introspection vala rustc llvm cargo-c"
BUILDDEP__RETRO="llvm rustc cargo-c"
PKGDES="SVG rendering and manipulation library"

ABTYPE=meson
MESON_AFTER=(
    '-Dintrospection=enabled'
    '-Dpixbuf=enabled'
    '-Drsvg-convert=enabled'
    '-Dpixbuf-loader=enabled'
    '-Ddocs=disabled'
    '-Dvala=enabled'
    '-Dtests=false'
    '-Davif=enabled'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=disabled'
    '-Dvala=disabled'
)

USECLANG=1
