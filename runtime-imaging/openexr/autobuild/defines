PKGNAME=openexr
PKGSEC=libs
PKGDES="Library to handle High Dynamic Range (HDR) images"
PKGDEP="zlib imath libdeflate openjph"
BUILDDEP="pybind11 llvm"

PKGPROV="ilmbase openexr-viewers"

AB_FLAGS_O3=1
PKGBREAK="blender<=4.4.3-1 darktable<=5.4.1-1 gdal<=3.12.1-3 gegl-0.4<=0.4.68 \
          gimp<=3.2.0 gmic<=3.6.6-2 gstreamer<=1.28.1-1 hugin<=2025.0.1 \
          imagemagick<=6.9.13+37-1 imagemagick+7<=7.1.1+32-1 kimageformats<=5.115.0-3 \
          kio-extras<=23.08.5-2 krita<=5.2.15-1 libjxl<=0.11.1 libvips<=8.18.0-3 \
          opencv<=4.13.0 openimageio<=2.5.19.1-4 openscenegraph<=3.6.5-9 openvdb<=11.0.0-4 \
          povray<=3.7.0.10-3 synfig<=1.5.3 vigra<=1.12.3-2"

# Note: We do not encourage building Doxygen documentation.
CMAKE_AFTER=(
    '-DCMAKE_INSTALL_PREFIX=/usr'
    '-DOPENEXR_INSTALL_DOCS=OFF'
    '-DBUILD_TESTING=OFF'
    '-DOPENEXR_BUILD_EXAMPLES=OFF'
    '-DOPENEXR_BUILD_LIBS=ON'
    '-DOPENEXR_BUILD_PYTHON=OFF'
    '-DOPENEXR_BUILD_TOOLS=ON'
    '-DOPENEXR_USE_TBB=OFF'
    '-DOPENEXR_ENABLE_THREADING=ON'
)

# ilmbase and openexr is replaced by openexr since version 2.4.0
