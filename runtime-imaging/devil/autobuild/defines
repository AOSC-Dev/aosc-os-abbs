PKGNAME=devil
PKGDES="Cross-platform image loading and manipulation toolkit"
PKGSEC=libs
PKGDEP="allegro mesa libjpeg-turbo lcms2 libmng libpng sdl12-compat libtiff \
        x11-lib jasper"
PKGDEP__RETRO="libjpeg-turbo lcms2 libmng libpng libtiff x11-lib jasper"

ABTYPE=cmake

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
