PKGNAME=cairo
PKGSEC=libs
PKGDEP="x11-lib libdrm libpng fontconfig glib pixman lzo"
PKGDES="2D graphics library with support for multiple output devices"

ABTYPE=meson
MESON_AFTER=(
    '-Dfontconfig=enabled'
    '-Dfreetype=enabled'
    '-Dpng=enabled'
    '-Dquartz=disabled'
    '-Dtee=enabled'
    '-Dxcb=enabled'
    '-Dxlib=enabled'
    '-Dxlib-xcb=enabled'
    '-Dzlib=enabled'
    '-Dgtk2-utils=disabled'
    '-Dglib=enabled'
    '-Dspectre=disabled'
    '-Dsymbol-lookup=disabled'
    '-Dgtk_doc=false'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dtee=disabled'
    '-Dspectre=disabled'
)
