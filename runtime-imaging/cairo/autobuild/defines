PKGNAME=cairo
PKGSEC=libs
PKGDEP="x11-lib libpng fontconfig glib pixman lzo zlib libglvnd'
        libxcb freetype"
BUILDDEP="librsvg libspectre poppler"
BUILDDEP__RETRO=""
PKGDES="2D graphics library with support for multiple output devices"

ABTYPE=meson
MESON_AFTER=(
    '-Dfontconfig=enabled'
    '-Dfreetype=enabled'
    '-Dpng=enabled'
    '-Dquartz=disabled'
    '-Dtee=enabled'
    '-Dxcb=enabled'
    '-Dxlib=enabled'
    '-Dxlib-xcb=enabled'
    '-Dzlib=enabled'
    '-Dgtk2-utils=disabled'
    '-Dglib=enabled'
    '-Dspectre=enabled'
    '-Dsymbol-lookup=disabled'
    '-Dgtk_doc=false'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dtee=disabled'
    '-Dspectre=disabled'
)

# Note: Extra Provides for Spiral (Debian compatibility).
PKGPROV="libcairo-gobject2_spiral"
