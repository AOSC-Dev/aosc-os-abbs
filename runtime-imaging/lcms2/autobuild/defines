PKGNAME=lcms2
PKGSEC=libs
PKGDES="Little CMS 2 color management library"
PKGDEP="libtiff"

ABTYPE=autotools
AUTOTOOLS_AFTER=(
    '--with-jpeg=/usr'
    '--with-tiff=/usr'
    '--with-zlib'
    '--with-fastfloat'
    '--with-threaded'
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
