From fc2a48161107de402973f2345e83e8cd084dfcfe Mon Sep 17 00:00:00 2001
From: "Benjamin A. Beasley" <code@musicinmybrain.net>
Date: Tue, 6 May 2025 07:14:35 -0400
Subject: [PATCH] Downstream-only: do not compile static libraries
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When compiling shared libraries, do not compile static libraries. This
patch suffices for Linux, but would have issues on some other platforms,
and itâ€™s not quite the behavior we would probably suggest upstream if we
tried.

We need to patch this rather than removing static libraries after the
fact because the static libraries would still appear in the installed
CMake files, causing problems for other packages like OpenUSD that want
to link OpenSubdiv.
---
 opensubdiv/CMakeLists.txt | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/opensubdiv/CMakeLists.txt b/opensubdiv/CMakeLists.txt
index 2ab3f34a..4e9e99fb 100644
--- a/opensubdiv/CMakeLists.txt
+++ b/opensubdiv/CMakeLists.txt
@@ -120,6 +120,7 @@ if (NOT NO_LIB)
 
     #---------------------------------------------------------------------------
 
+    if( NOT BUILD_SHARED_LIBS )
     # Build static libs ------------------------------------
     add_library(osd_static_cpu
         STATIC
@@ -177,6 +178,7 @@ if (NOT NO_LIB)
 
         install( TARGETS osd_static_gpu EXPORT opensubdiv-targets DESTINATION "${CMAKE_LIBDIR_BASE}" )
     endif()
+    endif()
 
 
     # Build dynamic libs  ----------------------------------
-- 
2.49.0
