PKGNAME=opensubdiv
PKGSEC=libs
PKGDEP="tbb ptex zlib glew glfw libcl"
BUILDDEP="cmake opencl-registry-api docutils pygments"
PKGDES="Open source subdivision surface library"

ABTYPE=cmakeninja

CMAKE_AFTER=(
    '-DBUILD_SHARED_LIBS=ON'
    '-DCMAKE_BUILD_TYPE=Release'
    '-DOpenGL_GL_PREFERENCE=GLVND'
    '-DCMAKE_INSTALL_PREFIX=/usr'
    '-DNO_DOC=ON'
    '-DNO_DX=OFF'
    '-DNO_EXAMPLES=ON'
    '-DNO_REGRESSION=ON'
    '-DNO_GLFW=OFF'
    '-DNO_OMP=OFF'
    '-DNO_OPENCL=OFF'
    '-DNO_OPENGL=OFF'
    '-DNO_PTEX=OFF'
    '-DNO_TBB=OFF'
    '-DNO_TESTS=ON'
    '-DNO_TUTORIALS=OFF'
)

PKGBREAK="blender<=4.4.3-1"
