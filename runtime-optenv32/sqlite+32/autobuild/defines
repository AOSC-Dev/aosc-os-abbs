PKGNAME=sqlite+32
PKGSEC=database
PKGDEP="aosc-aaa+32 readline+32 tcl+32"
BUILDDEP="devel-base+32"
PKGDES="Self-contained SQL database engine (32-bit x86 runtime)"

ABHOST=optenv32

ABTYPE=autosetup
AUTOSETUP_AFTER=(
    '--soname=0'
    '--enable-largefile'
    '--enable-threadsafe'
    '--enable-tcl'
    '--disable-editline'
    '--enable-readline'
    '--disable-amalgamation'
    '--enable-load-extension'
    '--enable-math'
    '--enable-json'
    '--enable-memsys5'
    '--enable-memsys3'
    '--enable-fts3'
    '--enable-fts4'
    '--enable-fts5'
    '--enable-update-limit'
    '--enable-geopoly'
    '--enable-rtree'
    '--enable-session'
)
