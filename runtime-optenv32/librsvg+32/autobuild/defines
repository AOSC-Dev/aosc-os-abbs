PKGNAME=librsvg+32
PKGSEC=libs
PKGDEP="aosc-aaa+32 cairo+32 freetype+32 gdk-pixbuf+32 glib+32 libxml2+32 \
        pango+32"
BUILDDEP="devel-base+32 rustc+32 cargo-c vala"
PKGDES="SVG rendering and manipulation library (32-bit x86 runtime)"

ABTYPE=meson
MESON_AFTER=(
    '-Dvala=enabled'
    '-Dintrospection=disabled'
    '-Dpixbuf=enabled'
    '-Drsvg-convert=enabled'
    '-Dpixbuf-loader=enabled'
    '-Ddocs=disabled'
    '-Dtests=false'
    '-Davif=disabled'
    '-Dtriplet=i686-unknown-linux-gnu'
)

ABHOST=optenv32

USECLANG=1
