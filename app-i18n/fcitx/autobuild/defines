PKGNAME=fcitx
PKGDES="Input method framework with extension support"
PKGSEC=x11
PKGDEP="pango dbus-glib icu shared-mime-info hicolor-icon-theme \
        desktop-file-utils xkeyboard-config imchooser libxkbcommon"
PKGDEP__RETRO="cairo dbus-glib xkeyboard-config libxkbcommon \
               iso-codes json-c"
BUILDDEP="enchant gtk-2 gtk-3 qt-4 extra-cmake-modules \
          gobject-introspection iso-codes"
BUILDDEP__RETRO="extra-cmake-modules gtk-2"
PKGSUG="enchant gettext opencc fcitx-configtool"
PKGSUG__RETRO=""
PKGCONFL="fcitx5"

CMAKE_AFTER=(
    '-DFORCE_OPENCC=ON'
    '-DFORCE_PRESAGE=ON'
    '-DFORCE_ENCHANT=ON'
    '-DENABLE_TEST=OFF'
    '-DENABLE_GTK2_IM_MODULE=ON'
    '-DENABLE_GTK3_IM_MODULE=ON'
    '-DENABLE_QT_IM_MODULE=ON'
    '-DQT_QMAKE_EXECUTABLE=/usr/bin/qmake-qt4'
    '-DCMAKE_SKIP_RPATH=OFF'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DFORCE_OPENCC=OFF'
    '-DFORCE_PRESAGE=OFF'
    '-DFORCE_ENCHANT=OFF'
    '-DENABLE_GTK3_IM_MODULE=OFF'
    '-DENABLE_QT_IM_MODULE=OFF'
    '-DENABLE_QT=OFF'
    '-DENABLE_QT_GUI=OFF'
    '-DENABLE_GIR=OFF'
    '-DSPELL=OFF'
)

# Note: Extra Provides for Spiral (Debian compatibility).
PKGPROV="fcitx-frontend-gtk2_spiral fcitx-frontend-gtk3_spiral \
         fcitx-module-x11_spiral im-config_spiral"
PKGPROV__RETRO="fcitx-frontend-gtk2_spiral fcitx-module-x11_spiral \
                im-config_spiral"

# Note: Debian's Fcitx (4.x) is currently at 1:.
PKGEPOCH_SPIRAL=1
