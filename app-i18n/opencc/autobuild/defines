PKGNAME=opencc
PKGSEC=localization
PKGDEP="gcc-runtime marisa"
PKGDEP__RETRO="gcc-runtime"
BUILDDEP="wheel rapidjson tclap pybind11 chrpath"
BUILDDEP__RETRO="chrpath"
PKGDES="Library and utilities to handle Simplified/Traditional Chinese conversion"

# Note: Need to set LIB_INSTALL_DIR so that the .pc file has the correct
# libdir.
#
# Note: Building Python bindings in beyond.
CMAKE_AFTER=(
    '-DCMAKE_INSTALL_PREFIX=/usr'
    '-DLIB_INSTALL_DIR=/usr/lib'
    '-DBUILD_DOCUMENTATION:BOOL=OFF'
    '-DBUILD_PYTHON:BOOL=ON'
    '-DUSE_SYSTEM_MARISA:BOOL=ON'
    '-DUSE_SYSTEM_PYBIND11:BOOL=ON'
    '-DUSE_SYSTEM_RAPIDJSON:BOOL=ON'
    '-DUSE_SYSTEM_TCLAP:BOOL=ON'
    '-DCMAKE_SKIP_RPATH=OFF'
    '-DPYTHON_EXECUTABLE=/usr/bin/python3'
)
CMAKE_AFTER__RETRO=(
    "${CMAKE_AFTER[@]}"
    '-DBUILD_PYTHON:BOOL=OFF'
)

AB_FLAGS_O3=1
