From b788b09dcb7570ac8d5a8f94bf4fa7e9bece93e5 Mon Sep 17 00:00:00 2001
From: pugaizai <i@pugai.life>
Date: Fri, 22 May 2026 18:52:47 +0800
Subject: [PATCH 2/3] use-system-clang

---
 build/config/linux/BUILD.gn    |  2 +-
 build/toolchain/linux/BUILD.gn | 12 ++----------
 2 files changed, 3 insertions(+), 11 deletions(-)

diff --git a/build/config/linux/BUILD.gn b/build/config/linux/BUILD.gn
index ac81ac075ec..323e79b20e4 100644
--- a/build/config/linux/BUILD.gn
+++ b/build/config/linux/BUILD.gn
@@ -10,7 +10,7 @@ config("sdk") {
 
   if (is_clang) {
     # Don't allow visible symbols from libc++ to be re-exported.
-    ldflags += [ "-Wl,--exclude-libs=libc++.a" ]
+    ldflags += [ "-Wl,--exclude-libs=libc++.a", "-fuse-ld=lld" ]
   }
 
   # Explicitly use static linking for libstdc++ and libgcc to minimize
diff --git a/build/toolchain/linux/BUILD.gn b/build/toolchain/linux/BUILD.gn
index 5ff6db3d5d4..0aec6f0367c 100644
--- a/build/toolchain/linux/BUILD.gn
+++ b/build/toolchain/linux/BUILD.gn
@@ -44,16 +44,8 @@ if (use_rbe) {
   gcc_compiler_prefix = compiler_prefix
 }
 
-# Google's clang does not work for alpine, use alpine's system clang
-if (dart_sysroot == "alpine") {
-  rebased_clang_dir = "/usr/bin"
-} else if (host_cpu == "arm64") {
-  rebased_clang_dir =
-      rebase_path("//buildtools/linux-arm64/clang/bin", root_build_dir)
-} else {
-  rebased_clang_dir =
-      rebase_path("//buildtools/linux-x64/clang/bin", root_build_dir)
-}
+# use system clang
+rebased_clang_dir = "/usr/bin"
 
 template("gcc_toolchain_suite") {
   toolchain_suite(target_name) {
-- 
