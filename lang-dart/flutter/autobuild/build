abinfo "Building Flutter ..."
pushd "$SRCDIR"/engine/src
gn_args=(
    "dart_embed_icu_data=false"
    "use_ccache=false"
    "use_custom_libcxx=false"
    "use_default_linux_sysroot=false"
    "allow_deprecated_api_calls=true"
)
modes=(
    "release"
    "profile"
    "debug"
)
for _mode in "${modes[@]}"; do
    abinfo "Generating ninja files for engine - $_mode ..."
    python3 flutter/tools/gn \
        --no-goma \
        --no-dart-version-git-info \
        --linux \
        --linux-cpu="$FLUTTER_ARCH" \
        --lto \
        --clang \
        --target-triple="$(gcc -dumpmachine)" \
        --no-backtrace \
        --no-stripped \
        --prebuilt-dart-sdk \
        --build-glfw-shell \
        --build-engine-artifacts \
        --no-enable-unittests \
        --enable-fontconfig \
        --runtime-mode="$_mode" \
        --gn-args="${gn_args[*]}"
    abinfo "Building engine artifacts - $_mode ..."
    ninja -C "${FLUTTER_OUT}/linux_${_mode}_${FLUTTER_ARCH}" artifacts
done

abinfo "Building flutter common and product patched sdk ..."
ninja -C "$FLUTTER_OUT_RELEASE" flutter flutter_patched_sdk sky

abinfo "Building debug patched sdk ..."
ninja -C "$FLUTTER_OUT_DEBUG" flutter_patched_sdk
popd

dart --verbosity=error \
    --snapshot-kind="app-jit" \
    --snapshot="$SRCDIR/bin/cache/flutter_tools.snapshot" \
    --packages="$SRCDIR/packages/flutter_tools/.dart_tool/package_config.json" \
    --no-enable-mirrors \
    "$SRCDIR/packages/flutter_tools/bin/flutter_tools.dart"
sed -Ei \
    's|'"$PUB_CACHE"'|/usr/lib/flutter/pub_cache|g' \
    packages/flutter_tools/.dart_tool/package_config.json
find "$PUB_CACHE" -name '*.aot' -delete

abinfo "Packaging Flutter ..."
# our entrypoint
install -dvm755 "$PKGDIR"/usr/bin/
ln -sv ../lib/flutter/bin/flutter "$PKGDIR"/usr/bin/flutter

# our dart
install -Dvm644 "$SRCDIR"/bin/cache/flutter.version.json -t \
    "$PKGDIR"/usr/lib/flutter/bin/cache/
ln -sv ../../../dart-sdk "$PKGDIR"/usr/lib/flutter/bin/cache/dart-sdk

# flutter tool (cli) snapshot
install -Dvm644 "$SRCDIR"/bin/cache/flutter_tools.snapshot \
    "$PKGDIR"/usr/lib/flutter/bin/cache/flutter_tools.snapshot

# patched sdk
install -dvm755 "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/common
cp -rv "$FLUTTER_OUT_RELEASE"/flutter_patched_sdk/ \
    "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/common/flutter_patched_sdk_product
cp -rv "$FLUTTER_OUT_DEBUG"/flutter_patched_sdk/ \
    "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/common/flutter_patched_sdk

# dart:ui package
install -dvm755 "$PKGDIR"/usr/lib/flutter/bin/cache/pkg
cp -rvL "$FLUTTER_OUT_RELEASE"/gen/dart-pkg/sky_engine \
    "$PKGDIR"/usr/lib/flutter/bin/cache/pkg/sky_engine

# flutter tool and framework packages (as part of sdk)
cp -rv "$SRCDIR"/packages "$PKGDIR"/usr/lib/flutter/packages

# needed for flutter analyze
install -dvm755 "$PKGDIR"/usr/lib/flutter/dev
install -dvm755 "$PKGDIR"/usr/lib/flutter/examples
touch "$PKGDIR"/usr/lib/flutter/dev/.intentionally-empty
touch "$PKGDIR"/usr/lib/flutter/examples/.intentionally-empty

# pub dependencies of flutter (part of sdk)
cp -rv "$PUB_CACHE" "$PKGDIR"/usr/lib/flutter/pub_cache

# version files
echo "$PKGVER" > "$PKGDIR"/usr/lib/flutter/version
install -dvm755 "$PKGDIR"/usr/lib/flutter/bin/internal/
cp -v "$SRCDIR/bin/internal/engine.version" \
    "$PKGDIR/usr/lib/flutter/bin/internal/engine.version"

# fonts
install -dvm755 "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/material_fonts
unzip "$SRCDIR"/../fonts.zip \
    -v -d "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/material_fonts

# gradle wrapper (-developer only, needed for flutter create)
install -dvm755 "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/gradle_wrapper
tar xvf "$SRCDIR"/gradle-wrapper.tar.gz \
    -C "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/gradle_wrapper

# build-time artifacts from engine (for use by tool)
for _mode in "${modes[@]}"; do
    case "$_mode" in
        debug) _mode_art_name=linux-"$FLUTTER_ARCH" ;;
        *) _mode_art_name=linux-"$FLUTTER_ARCH"-"$_mode" ;;
    esac
    install -dvm755 "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/"$_mode_art_name"/
    unzip "$FLUTTER_OUT"/linux_"$_mode"_"$FLUTTER_ARCH"/zip_archives/"$_mode_art_name"/artifacts.zip \
        -v -d "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/"$_mode_art_name"/
done
# they are all the same, simply copied from tree
cp -rv "$FLUTTER_OUT_RELEASE"/flutter_linux/ \
    "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/linux-"$FLUTTER_ARCH"/flutter_linux
ln -sv ../linux-"$FLUTTER_ARCH"/flutter_linux \
    "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/linux-"$FLUTTER_ARCH"-profile/flutter_linux
ln -sv ../linux-"$FLUTTER_ARCH"/flutter_linux \
    "$PKGDIR"/usr/lib/flutter/bin/cache/artifacts/engine/linux-"$FLUTTER_ARCH"-release/flutter_linux
install -dvm755 "$PKGDIR"/usr/include/
ln -sv ../lib/flutter/bin/cache/artifacts/engine/linux-"$FLUTTER_ARCH"/flutter_linux \
    "$PKGDIR"/usr/include/flutter_linux

install -Dvm644 "$FLUTTER_OUT_RELEASE"/libflutter_linux_gtk.so \
    "$PKGDIR"/usr/lib/libflutter_linux_gtk.so

# see system-icu.patch.engine
ln -sv /usr/share/icu/*/icudt*l.dat "$PKGDIR"/usr/lib/flutter/icudtl.dat

install -Dvm644 "$FLUTTER_OUT_RELEASE"/libflutter_linux_glfw.so \
    "$PKGDIR"/usr/lib/libflutter_linux_glfw.so
