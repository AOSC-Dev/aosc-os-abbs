From d2a820e503176465bc90b00f6f6f295615eca6c4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E9=93=BA=E7=9B=96=E5=B4=BD?= <i@pugai.life>
Date: Wed, 21 Jan 2026 15:12:31 +0800
Subject: [PATCH] Refactor version regex parsing and handling

---
 engine/src/build/compiler_version.py | 36 +++++++++++++++++++++++-----
 1 file changed, 30 insertions(+), 6 deletions(-)

diff --git a/engine/src/build/compiler_version.py b/engine/src/build/compiler_version.py
index c45257e7..2994e8e2 100755
--- a/engine/src/build/compiler_version.py
+++ b/engine/src/build/compiler_version.py
@@ -46,6 +46,13 @@ def GetEnvironFallback(var_list, default):
   return default
 
 
+def _parse_major_minor_from_match(match):
+  """Return (major:int, minor:int) from a regex match where groups capture digits."""
+  major = int(match.group(1))
+  minor = int(match.group(2)) if match.lastindex and match.group(2) else 0
+  return major, minor
+
+
 def GetVersion(compiler, tool):
   tool_output = tool_error = None
   cache_key = (compiler, tool)
@@ -56,14 +63,14 @@ def GetVersion(compiler, tool):
     # Note that compiler could be something tricky like "distcc g++".
     if tool == "compiler":
       compiler = compiler + " -dumpversion"
-      # 4.6
-      version_re = re.compile(r"(\d+)\.(\d+)")
+      # Accept either "X.Y" or "X" (e.g. "4.6" or "15").
+      version_re = re.compile(r"(\d+)(?:\.(\d+))?")
     elif tool == "assembler":
       compiler = compiler + " -Xassembler --version -x assembler -c /dev/null"
       # Unmodified: GNU assembler (GNU Binutils) 2.24
       # Ubuntu: GNU assembler (GNU Binutils for Ubuntu) 2.22
       # Fedora: GNU assembler version 2.23.2
-      version_re = re.compile(r"^GNU [^ ]+ .* (\d+).(\d+).*?$", re.M)
+      version_re = re.compile(r"^GNU [^ ]+ .* (\d+)\.(\d+).*?$", re.M)
     elif tool == "linker":
       compiler = compiler + " -Xlinker --version"
       # Using BFD linker
@@ -74,7 +81,7 @@ def GetVersion(compiler, tool):
       # Unmodified: GNU gold (GNU Binutils 2.24) 1.11
       # Ubuntu: GNU gold (GNU Binutils for Ubuntu 2.22) 1.11
       # Fedora: GNU gold (version 2.23.2) 1.11
-      version_re = re.compile(r"^GNU [^ ]+ .* (\d+).(\d+).*?$", re.M)
+      version_re = re.compile(r"^GNU [^ ]+ .* (\d+)\.(\d+).*?$", re.M)
     else:
       raise Exception("Unknown tool %s" % tool)
 
@@ -85,11 +92,28 @@ def GetVersion(compiler, tool):
     pipe = subprocess.Popen(compiler, shell=True, env=env,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
     tool_output, tool_error = pipe.communicate()
+
+    # Ensure we have text for regex matching under Python 3.
+    if isinstance(tool_output, bytes):
+      tool_output = tool_output.decode('utf-8', 'replace')
+    if isinstance(tool_error, bytes):
+      tool_error = tool_error.decode('utf-8', 'replace')
+
     if pipe.returncode:
+      # Provide the captured stderr for debugging.
       raise subprocess.CalledProcessError(pipe.returncode, compiler)
 
-    parsed_output = version_re.match(tool_output)
-    result = parsed_output.group(1) + parsed_output.group(2)
+    # Use search() to be flexible about where the version appears.
+    parsed_output = version_re.search(tool_output)
+    if not parsed_output:
+      # If we couldn't parse, include the output to help debugging.
+      raise Exception("Could not parse version from output: %r" % tool_output)
+
+    # Normalize into a comparable numeric-ish string similar to original behavior.
+    # Original returned group1 + group2 (e.g. '4' + '6' -> '46'). We produce major*10+minor:
+    # 4.6 -> 46, 15 -> 150 (interpreted as 15.0 -> 150), which preserves ordering.
+    major, minor = _parse_major_minor_from_match(parsed_output)
+    result = str(major * 10 + minor)
     compiler_version_cache[cache_key] = result
     return result
   except Exception as e:
-- 
