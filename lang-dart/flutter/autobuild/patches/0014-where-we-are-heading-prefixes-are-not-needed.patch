From 29ed3ef6e91bab56190b38a4c84ed4bdac853451 Mon Sep 17 00:00:00 2001
From: pugaizai <i@pugai.life>
Date: Thu, 22 Jan 2026 15:14:16 +0800
Subject: [PATCH] where we are heading prefixes are not needed

---
 engine/src/build/toolchain/linux/BUILD.gn | 17 ++++++-----------
 1 file changed, 6 insertions(+), 11 deletions(-)

diff --git a/engine/src/build/toolchain/linux/BUILD.gn b/engine/src/build/toolchain/linux/BUILD.gn
index b6db422f179..44979bf235c 100644
--- a/engine/src/build/toolchain/linux/BUILD.gn
+++ b/engine/src/build/toolchain/linux/BUILD.gn
@@ -33,16 +33,11 @@ if (use_rbe) {
   link_prefix = ""
 }
 
-if (host_cpu == "arm64") {
-  rebased_clang_dir =
-      rebase_path("$buildtools_path/linux-arm64/clang/bin", root_build_dir)
-} else {
-  rebased_clang_dir =
-      rebase_path("$buildtools_path/linux-x64/clang/bin", root_build_dir)
-}
+# use system clang
+rebased_clang_dir = "/usr/bin"
 
 gcc_toolchain("arm") {
-  prefix = "arm-linux-gnueabihf-"
+  prefix = ""
   if (toolchain_prefix != "") {
     prefix = toolchain_prefix
   }
@@ -80,7 +75,7 @@ gcc_toolchain("clang_arm") {
 }
 
 gcc_toolchain("arm64") {
-  prefix = "aarch64-linux-gnu-"
+  prefix = ""
   if (toolchain_prefix != "") {
     prefix = toolchain_prefix
   }
@@ -169,7 +164,7 @@ gcc_toolchain("x64") {
 }
 
 gcc_toolchain("riscv32") {
-  prefix = "riscv32-linux-gnu-"
+  prefix = ""
   if (toolchain_prefix != "") {
     prefix = toolchain_prefix
   }
@@ -207,7 +202,7 @@ gcc_toolchain("clang_riscv32") {
 }
 
 gcc_toolchain("riscv64") {
-  prefix = "riscv64-linux-gnu-"
+  prefix = ""
   if (toolchain_prefix != "") {
     prefix = toolchain_prefix
   }
-- 
2.52.0

