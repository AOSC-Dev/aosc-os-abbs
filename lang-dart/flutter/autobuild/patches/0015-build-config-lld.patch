From c42fd7c634f1c808d360a6b7d39d2dc52d92d4c5 Mon Sep 17 00:00:00 2001
From: pugaizai <i@pugai.life>
Date: Thu, 22 Jan 2026 18:47:19 +0800
Subject: [PATCH] build-config

---
 engine/src/build/config/compiler/BUILD.gn | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/engine/src/build/config/compiler/BUILD.gn b/engine/src/build/config/compiler/BUILD.gn
index 50f1b60eab1..9cf28a01255 100644
--- a/engine/src/build/config/compiler/BUILD.gn
+++ b/engine/src/build/config/compiler/BUILD.gn
@@ -127,7 +127,7 @@ config("compiler") {
     }
 
     # Linker warnings.
-    if (!(is_chromeos && current_cpu == "arm") && !is_mac && !is_ios) {
+    if (current_cpu != "arm64" && current_cpu != "arm" && !is_mac && !is_ios) {
       # TODO(jochen): Enable this on chromeos on arm. http://crbug.com/356580
       ldflags += [ "-Wl,--fatal-warnings" ]
     }
@@ -402,6 +402,10 @@ config("compiler") {
       ldflags += [ "--target=aarch64-linux-gnu" ]
       cflags += [ "-DBORINGSSL_CLANG_SUPPORTS_DOT_ARCH" ]
     }
+
+    if (is_clang) {
+      ldflags += [ "-fuse-ld=lld" ]
+    }
   }
 
   # Clang-specific compiler flags setup.
@@ -740,12 +744,6 @@ if (is_win) {
     "-Wno-unused-parameter",  # Unused function parameters.
   ]
 
-  if (!is_qnx) {
-    default_warning_flags += [
-      "-Werror",  # Warnings as errors.
-    ]
-  }
-
   if (is_wasm) {
     default_warning_flags += [
       # zlib needs this
-- 
