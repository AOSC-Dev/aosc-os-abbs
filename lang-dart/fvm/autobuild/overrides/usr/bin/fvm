#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

FVM_HOME="$HOME/fvm"
TOOLS_PATH="$FVM_HOME/tools"
PATCH_STORAGE="$FVM_HOME/patch"
DEPOT_TOOLS_URL="https://chromium.googlesource.com/chromium/tools/depot_tools.git"

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_debug() {
    echo -e "${BLUE}[DEBUG]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

version_lte() {
    [ "$1" = "$(printf '%s\n%s' "$1" "$2" | sort -V | head -n1)" ]
}

fetch_newest_stable_version(){
  log_debug "Fetching the newest stable Flutter version from release-monitoring.org..."
  local version
  version=$(curl -s "https://release-monitoring.org/api/v2/versions/?project_id=236318" | jq -r '.stable_versions[0]')
  
  if [ -z "$version" ] || [ "$version" = "null" ]; then
    log_error "Unable to fetch the newest stable Flutter version."
    exit 1
  fi
  
  log_debug "Found newest stable Flutter version: $version"
  echo "$version"
}

select_version_to_install() {
  local argument="$1"
  local flutter_version=""

  if [ -z "$argument" ]; then
    log_debug "No Flutter version specified in arguments. Attempting to read from .fvmrc..."
    if [ -f .fvmrc ]; then
      flutter_version=$(jq -r '.flutter' .fvmrc)
      if [ -z "$flutter_version" ] || [ "$flutter_version" = "null" ]; then
        log_warn ".fvmrc does not contain a valid Flutter version."
        flutter_version=$(fetch_newest_stable_version)
      else
        log_debug "Using Flutter version $flutter_version from .fvmrc."
      fi
    else
      log_debug ".fvmrc not found."
      flutter_version=$(fetch_newest_stable_version)
    fi
  else
    flutter_version="$argument"
    log_debug "Using Flutter version $flutter_version from command arguments."
  fi

  echo "$flutter_version"
}

get_depot_tools(){
  log_debug "Checking for depot_tools..."
  if [ -d "$TOOLS_PATH/depot_tools" ]; then
      log_debug "depot_tools already exists. Updating..."
      git -C "$TOOLS_PATH/depot_tools" pull -q
  else
      log_debug "Cloning depot_tools into $TOOLS_PATH..."
      mkdir -p "$TOOLS_PATH"
      git clone "$DEPOT_TOOLS_URL" "$TOOLS_PATH/depot_tools" --depth 1
  fi
  
  export PATH="$TOOLS_PATH/depot_tools:$PATH"
  log_debug "PATH updated to include depot_tools."
}

get_into_build_path(){
  local flutter_version=$1
  log_debug "Preparing build directory for Flutter Engine version $flutter_version..."
  
  local build_path="$FVM_HOME/caches/flutter_engine_build_$flutter_version"
  mkdir -p "$build_path"
  cd "$build_path" || exit 1
  
  log_debug "Current working directory: $(pwd)"
}

old_prepare_method(){
  local flutter_version=$1
  log_debug "Using OLD method (Version <= 3.27.4)..."

  log_debug "Configuring .gclient..."
  cat <<EOL > .gclient
solutions = [
  {
    "name": "src/flutter",
    "url": "https://github.com/flutter/engine.git",
    "managed": False,
    "custom_deps": {},
    "deps_file": "DEPS",
    "safesync_url": "",
  },
]
EOL

  log_debug "Fetching Flutter Engine via gclient sync..."
  gclient sync --verbose

  local engine_hash
  engine_hash=$(cat "$FVM_HOME/versions/$flutter_version/bin/internal/engine.version")
  
  if [ -z "$engine_hash" ]; then
      log_error "Could not find engine version file at $FVM_HOME/versions/$flutter_version/bin/internal/engine.version"
      exit 1
  fi

  log_debug "Checking out Flutter Engine hash $engine_hash..."
  cd src/flutter || exit 1
  git checkout "$engine_hash"
  
  log_debug "Syncing dependencies..."
  gclient sync
}

new_prepare_method(){
  local flutter_version=$1
  log_debug "Using NEW method (Version > 3.27.4)..."

  log_debug "Cloning Flutter SDK..."
  if [ ! -d "flutter" ]; then
    git clone https://github.com/flutter/flutter.git flutter
  fi
  
  cd flutter || exit 1
  log_debug "Checking out tags/$flutter_version..."
  git checkout "tags/$flutter_version"

  log_debug "Configuring .gclient..."
  cat <<EOL > .gclient
solutions = [
  {
    "name": ".",
    "url": "https://github.com/flutter/flutter.git",
    "managed": False,
    "custom_deps": {},
    "deps_file": "DEPS",
    "safesync_url": "",
  },
]
EOL
  
  log_debug "Fetching dependencies via gclient..."
  gclient sync -v
  
  if [ -d "src/flutter" ]; then
      cd src/flutter || exit 1
  else
      log_error "Directory src/flutter not found after gclient sync."
      exit 1
  fi
}

patch_and_build(){
  local flutter_version=$1
  log_info "Starting build process for Flutter Engine version $flutter_version..."

  log_debug "Generating Ninja build files (runtime-mode: release, cpu: arm64)..."
  ./tools/gn --runtime-mode release --linux --linux-cpu arm64

  local args_file="out/linux_release_arm64/args.gn"
  if [ -f "$args_file" ]; then
      log_debug "Patching flutter_use_fontconfig to true in $args_file..."
      if ! grep -q "flutter_use_fontconfig" "$args_file"; then
          printf 'flutter_use_fontconfig = true\n' >> "$args_file"
      else
          log_warn "Configuration already exists in args.gn, skipping append."
      fi
  else
      log_error "args.gn not found at $args_file. GN generation likely failed."
      exit 1
  fi

  log_info "Building target flutter/shell/platform/linux:flutter_gtk with Ninja..."
  ninja -C out/linux_release_arm64 flutter/shell/platform/linux:flutter_gtk

  local output_lib="out/linux_release_arm64/libflutter_engine.so"
  local target_path="$PATCH_STORAGE/libflutter_engine.so"

  if [ -f "$output_lib" ]; then
      log_info "Build successful. Copying artifact to $target_path..."
      mkdir -p "$PATCH_STORAGE"
      cp "$output_lib" "$target_path"
      echo "$target_path"
  else
      log_error "Build failed. Output file $output_lib not found."
      exit 1
  fi
}

install_and_build_patch() {
  local req_version="$1"
  local flutter_version
  flutter_version=$(select_version_to_install "$req_version")
  
  log_info "Selected Flutter version: $flutter_version"

  log_info "Installing official Flutter SDK version $flutter_version using FVM..."
  fvm install "$flutter_version" --verbose
  fvm global "$flutter_version" --verbose

  log_info "Preparing build environment..."
  get_depot_tools
  get_into_build_path "$flutter_version"

  if version_lte "$flutter_version" "3.27.4"; then
    old_prepare_method "$flutter_version"
  else
    new_prepare_method "$flutter_version"
  fi

  local result_path
  result_path=$(patch_and_build "$flutter_version")

  if [ -n "$result_path" ]; then
    log_info "Patch generation complete: $result_path"
  fi
}

apply_patch_locally(){
  local source_patch="$PATCH_STORAGE/libflutter_engine.so"
  local dest_patch="./build/linux/arm64/release/bundle/libflutter_engine.so"

  if [ ! -f "$source_patch" ]; then
    log_error "Patched engine not found at $source_patch. Run 'install-and-build-patch' first."
    exit 1
  fi

  log_info "Applying patch..."
  mkdir -p "$(dirname "$dest_patch")"
  cp -v "$source_patch" "$dest_patch"
}

COMMAND="$1"
ARG_VERSION="$2"
ARCH=$(uname -m)

case "$COMMAND" in
  "install-and-build-patch")
    if [ "$ARCH" != "aarch64" ]; then
      log_info "Architecture is $ARCH (not arm64). Installing official version without patch."
      fvm install "$ARG_VERSION" --verbose
    else
      log_info "Architecture is arm64. Proceeding with patched installation."
      install_and_build_patch "$ARG_VERSION"
    fi
    ;;

  "apply-patch")
    if [ "$ARCH" != "aarch64" ]; then
      log_info "Architecture is $ARCH. No patch needed."
    else
      apply_patch_locally
    fi
    ;;

  *)
    exec "/usr/bin/dartaotruntime" "/usr/lib/fvm/fvm.aot" "$@"
    ;;
esac
