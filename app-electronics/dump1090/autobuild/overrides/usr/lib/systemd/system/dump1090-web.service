[Unit]
Description=SkyAware web interface for dump1090
Documentation=https://github.com/flightaware/dump1090
Requires=dump1090.service
After=dump1090.service
PartOf=dump1090.service

[Service]
DynamicUser=yes
ExecStartPre=/usr/bin/lighttpd -tt -f /etc/dump1090/lighttpd.conf
ExecStart=/usr/bin/lighttpd -D -f /etc/dump1090/lighttpd.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
