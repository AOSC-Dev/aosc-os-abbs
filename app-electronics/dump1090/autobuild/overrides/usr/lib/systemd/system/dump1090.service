[Unit]
Description=Mode S and ADS-B receiver
Documentation=https://github.com/flightaware/dump1090
After=network.target

[Service]
DynamicUser=yes
SupplementaryGroups=plugdev
RuntimeDirectory=dump1090
EnvironmentFile=-/etc/default/dump1090
ExecStart=/usr/bin/dump1090 --device-type rtlsdr --quiet --net \
    --net-bind-address 127.0.0.1 --write-json /run/dump1090 $OPTIONS
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
