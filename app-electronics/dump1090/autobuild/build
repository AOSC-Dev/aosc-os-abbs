abinfo "Building dump1090 and companion utilities ..."
cd "$SRCDIR"
# FIXME: These SDR libraries are not currently packaged in AOSC OS.
# Enable their backends once bladeRF, HackRF, LimeSuite and SoapySDR return.
make -j"$ABTHREADS" \
    CC="$CC" \
    CFLAGS="$CFLAGS" \
    CPPFLAGS="$CPPFLAGS" \
    LDFLAGS="$LDFLAGS" \
    DUMP1090_VERSION="$PKGVER" \
    RTLSDR=yes BLADERF=no HACKRF=no LIMESDR=no SOAPYSDR=no \
    all faup1090

abinfo "Installing programs ..."
install -Dvm755 dump1090 view1090 -t "$PKGDIR"/usr/bin/
install -Dvm755 faup1090 starch-benchmark \
    -t "$PKGDIR"/usr/libexec/dump1090/

abinfo "Installing the SkyAware web interface ..."
install -dv "$PKGDIR"/usr/share/dump1090/html
cp -av public_html/. "$PKGDIR"/usr/share/dump1090/html/
rm -rv "$PKGDIR"/usr/share/dump1090/html/test
rm -v "$PKGDIR"/usr/share/dump1090/html/README.md

abinfo "Installing documentation and licenses ..."
install -Dvm644 README.md README-json.md README.adaptive-gain.md \
    COPYING LICENSE -t "$PKGDIR"/usr/share/doc/dump1090/
install -Dvm644 public_html/README.md \
    "$PKGDIR"/usr/share/doc/dump1090/README-skyaware.md
