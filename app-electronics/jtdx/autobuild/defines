PKGNAME=jtdx
PKGSEC=hamradio
PKGDEP="fftw gcc-runtime glibc hamlib libusb qt-5"
BUILDDEP="asciidoc boost cmake gcc pkgconf"
PKGDES="Weak-signal digital modes for amateur radio"

ABTYPE=cmakeninja
# FIXME: As in WSJT-X, upstream RS declarations and definitions disagree.
# Disable LTO until these interfaces have been corrected and validated.
NOLTO=1

CMAKE_AFTER=(
    # Normalize upstream's share/doc/JTDX to the package name.
    '-DCMAKE_INSTALL_DOCDIR=share/doc/jtdx'
    # Generate jtdx(1) in beyond; upstream also installs obsolete tool pages.
    '-DWSJT_SKIP_MANPAGES=ON'
    # Skip the unmodified WSJT-X HTML user guide bundled with JTDX.
    '-DWSJT_GENERATE_DOCS=OFF'
)
