abinfo "Replacing bundled Hamlib utilities with links to the system utilities ..."
for utility in rigctl rigctld rigctlcom; do
    rm -v "$PKGDIR/usr/bin/${utility}-jtdx"
    ln -sv "$utility" "$PKGDIR/usr/bin/${utility}-jtdx"
done

abinfo "Generating the JTDX manual page ..."
install -dv "$PKGDIR/usr/share/man/man1"
a2x --format=manpage --doctype=manpage --no-xmllint \
    -a "VERSION=$VER" \
    -D "$PKGDIR/usr/share/man/man1" \
    "$SRCDIR/manpages/man1/jtdx.1.txt"
