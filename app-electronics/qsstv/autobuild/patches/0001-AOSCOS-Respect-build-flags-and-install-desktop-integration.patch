From: AOSC OS Package Maintainers <maintainers@aosc.io>
Subject: [PATCH] AOSCOS: Respect build flags and install desktop integration

Keep distribution optimization flags. Include the existing desktop entry and
42-pixel icon in make install, placing the icon in the unthemed pixmap directory.
Use absolute source paths so installation also works from a build directory.

--- a/qsstv.pro
+++ b/qsstv.pro
@@ -17,8 +17,7 @@

 QMAKE_CXXFLAGS_DEBUG -= -O2
 QMAKE_CXXFLAGS_DEBUG += -O0 -Wno-implicit-fallthrough -Wno-psabi
-QMAKE_CXXFLAGS_RELEASE-= -O2
-QMAKE_CXXFLAGS_RELEASE += -O3 -Wno-implicit-fallthrough -Wno-psabi
+QMAKE_CXXFLAGS_RELEASE += -Wno-implicit-fallthrough -Wno-psabi

 INCLUDEPATH += config dispatch drmrx drmtx dsp editor logbook mainwidgets rig scope sound sstv utils widgets xmlrpc videocapt

@@ -527,10 +526,10 @@
     }
 target.path = $$PREFIX/bin

-shortcutfiles.files =qsstv.desktop
+shortcutfiles.files = $$PWD/qsstv.desktop
 shortcutfiles.path = $$PREFIX/share/applications/
-data.files += icons/qsstv.png
-data.path=$$PREFIX/share/icons/hicolor/42x42/apps/
+data.files += $$PWD/icons/qsstv.png
+data.path=$$PREFIX/share/pixmaps/



@@ -582,7 +581,7 @@
     documentation/manual/images/spectrum1.png \
     documentation/manual/images/cat_flrig.png

-INSTALLS += target
+INSTALLS += target shortcutfiles data

 LIBS +=  -lasound \
          -lpulse \
--- a/qsstv.desktop
+++ b/qsstv.desktop
@@ -9,5 +9,5 @@
 StartupNotify=true
 Terminal=false
 Type=Application
-Categories=Education;
+Categories=Network;HamRadio;
 X-AppImage-Version=1
