From: LengmoAngel <lengmoangel@gmail.com>
Subject: [PATCH] build: fix the libgpiod compiler flags assignment

Spaces around = turn this assignment into a shell command. Preserve the
flags found by pkg-config when regenerating configure with autoreconf.

--- a/m4/build.m4
+++ b/m4/build.m4
@@ -20,7 +20,7 @@
 $X_CFLAGS -pipe -Wall -fexceptions $OPT_CFLAGS $DEBUG_CFLAGS $PTW32_CFLAGS"
 
 #  if test "x$ac_cv_libgpiod" = "xyes"; then
-    FLRIG_BUILD_CXXFLAGS = "$LIBGPIOD_CFLAGS $FLRIG_BUILD_CXXFLAGS"
+    FLRIG_BUILD_CXXFLAGS="$LIBGPIOD_CFLAGS $FLRIG_BUILD_CXXFLAGS"
 #  fi
 
   if test "x$ac_cv_flxmlrpc" != "xyes"; then
