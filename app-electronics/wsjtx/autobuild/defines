PKGNAME=wsjtx
PKGSEC=hamradio
PKGDEP="boost fftw hamlib libusb portaudio qt-5"
BUILDDEP="cmake gcc pkgconf"
PKGDES="Weak-signal digital communication suite for amateur radio"

ABTYPE=cmakeninja
# FIXME: Upstream RS declarations and definitions disagree on argument counts.
# Keep LTO disabled until the interfaces are fixed and decoding is validated.
NOLTO=1

CMAKE_AFTER=(
    '-DWSJT_RELEASE_CHANNEL=GA'
    '-DWSJT_SKIP_MANPAGES=ON'
    '-DWSJT_GENERATE_DOCS=OFF'
    '-DWSJT_BUILD_TESTS=OFF'
    '-DWSJT_SKIP_MAP65=OFF'
    '-DWSJT_SKIP_BUNDLE_FIXUP=ON'
)
