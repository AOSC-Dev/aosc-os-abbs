PKGNAME=yosys
PKGSEC=electronics
PKGDEP="gcc-runtime tcl python-3 zlib readline libffi ncurses"
BUILDDEP="pybind11 cxxheaderparser llvm"
PKGDES="Open-source digital circuit synthesis suite"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DYOSYS_WITH_PYTHON=ON'
    '-DYOSYS_INSTALL_PYTHON=ON'
    '-DYOSYS_INSTALL_LIBRARY=ON'
)

# On MIPS, LTO with GCC causes memory exhaustion,
# NOLTO causes relocation failure,
# only LTO with Clang builds.
USECLANG=1
