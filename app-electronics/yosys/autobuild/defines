PKGNAME=yosys
PKGSEC=electronics
PKGDEP="gcc-runtime tcl python-3 zlib readline libffi"
BUILDDEP="pybind11 cxxheaderparser llvm boost"
PKGDES="Open-source digital circuit synthesis suite"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    # Currently, yosys uses bundled abc on AOSC OS,
    # and yosys decides whether to bundle a dependency,
    # based on build time detection.
    # Should abc be packaged for AOSC OS in the future,
    # yosys would need to depend on it and use external abc.
    '-DYOSYS_WITHOUT_ABC=OFF'
    '-DYOSYS_WITHOUT_ZLIB=OFF'
    '-DYOSYS_WITHOUT_LIBFFI=OFF'
    '-DYOSYS_WITHOUT_READLINE=OFF'
    '-DYOSYS_WITHOUT_EDITLINE=OFF'
    '-DYOSYS_WITHOUT_SLANG=OFF'
    '-DYOSYS_WITHOUT_TCL=OFF'
    '-DYOSYS_WITH_PYTHON=ON'
    '-DYOSYS_USE_BUNDLED_LIBS=OFF'
    '-DYOSYS_INSTALL_DRIVER=ON'
    '-DYOSYS_INSTALL_PYTHON=ON'
    '-DYOSYS_INSTALL_LIBRARY=ON'
    # Do not include SystemVerilog language tools.
    # These tools are part of slang (a SystemVerilog frontend),
    # not to be confused with `S-Lang`.
    # Should slang be packaged for AOSC OS in the future,
    # that package would provide these tools,
    # and yosys would need depend on it.
    '-DSLANG_INCLUDE_TOOLS=OFF'
    # Do not build tests that are not installed
    '-DYOSYS_ENABLE_UNIT_TESTS=OFF'
    '-DYOSYS_ENABLE_COVERAGE=OFF'
    '-DYOSYS_ENABLE_PROFILING=OFF'
    '-DYOSYS_ENABLE_FUNCTIONAL_TESTS=OFF'
)

# On MIPS, LTO with GCC causes memory exhaustion,
# NOLTO causes relocation failure,
# only LTO with Clang builds.
USECLANG=1
