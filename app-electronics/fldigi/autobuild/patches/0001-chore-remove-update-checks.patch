Subject: [PATCH] Remove application update checks

AOSC OS manages application updates through its package repositories.
Remove startup checks, both Help menu entries, and the corresponding
configuration control, including its FLUID source.

--- a/src/main.cxx
+++ b/src/main.cxx
@@ -774,3 +773,0 @@
-
-	if (progdefaults.check_for_updates)
-		cb_mnuCheckUpdate((Fl_Widget *)0, NULL);
--- a/src/dialogs/fl_digi.cxx
+++ b/src/dialogs/fl_digi.cxx
@@ -2812,84 +2811,0 @@
-}
-
-inline int version_check(std::string v1, std::string v2) {
-
-	long v1a, v1b, v1c;
-	long v2a, v2b, v2c;
-	size_t p;
-
-	v1a = atol(v1.c_str()); p = v1.find("."); v1.erase(0, p + 1);
-	v1b = atol(v1.c_str()); p = v1.find("."); v1.erase(0, p + 1);
-	v1c = atol(v1.c_str()); p = v1.find("."); v1.erase(0, p + 1);
-
-	v2a = atol(v2.c_str()); p = v2.find("."); v2.erase(0, p + 1);
-	v2b = atol(v2.c_str()); p = v2.find("."); v2.erase(0, p + 1);
-	v2c = atol(v2.c_str()); p = v2.find("."); v2.erase(0, p + 1);
-
-	long l1, l2;
-	l1 = v1a * 10000 + v1b * 100 + v1c;
-	l2 = v2a * 10000 + v2b * 100 + v2c;
-
-	if (l1 < l2) return -1;
-	if (l1 > l2) return 1;
-	if (v1 == v2) return 0;
-	return 1;
-}
-
-static notify_dialog *latest_dialog = 0;
-void cb_mnuCheckUpdate(Fl_Widget *, void *)
-{
-	const char *url = "https://www.w1hkj.org/files/fldigi/";
-
-	std::string version_str;
-	std::string reply;
-	std::string probable;
-	if (!latest_dialog) latest_dialog = new notify_dialog;
-
-	put_status(_("Checking for updates..."));
-
-	get_http(url, reply, 20.0);
-
-	if (reply.empty()) {
-		probable.assign(_("\
-Internet not available.\n\
-Please check your connection.\n"));
-		latest_dialog->notify(probable.c_str(), 30.0);
-		REQ(show_notifier, latest_dialog);
-		put_status("");
-		return;
-	}
-
-	if (reply.find("Index of /files/fldigi") == std::string::npos) {
-		probable.assign(_("\
-Update site not availabe.\n\
-Please check https://www.w1hkj.org/files/ with your browser.\n"));
-		latest_dialog->notify(probable.c_str(), 30.0);
-		REQ(show_notifier, latest_dialog);
-		put_status("");
-		return;
-	}
-
-	size_t p = reply.find("_setup.exe");
-	size_t p2 = reply.rfind("fldigi", p);
-	p2 += 7;
-	version_str = reply.substr(p2, p - p2);
-	int is_ok = version_check(std::string(PACKAGE_VERSION), version_str);
-
-	if (is_ok == 0) {
-		latest_dialog->notify(_("You are running the latest version"), 15.0);
-		REQ(show_notifier, latest_dialog);
-	} else if (is_ok > 0) {
-		probable.assign(_("\
-You are probably using a development test version.\n\n\
-   In use: ")).append( PACKAGE_VERSION ).append(_("\n\
-   Posted: ")).append(version_str).append("\n");
-		latest_dialog->notify(probable.c_str(), 30.0);
-		REQ(show_notifier, latest_dialog);
-	} else {
-		probable.assign(_("Version ")).
-			append(version_str.c_str()).append(" ").
-			append(_("is available at Source Forge"));
-		latest_dialog->notify(probable.c_str(), 30.0);
-		REQ(show_notifier, latest_dialog);
-	}
-	put_status("");
@@ -7664 +7579,0 @@
-{ icons::make_icon_label(_("Check for updates..."), system_software_update_icon), 0, cb_mnuCheckUpdate, 0, 0, _FL_MULTI_LABEL, 0, 14, 0},
@@ -10759 +10673,0 @@
-		btn_check_for_updates,
