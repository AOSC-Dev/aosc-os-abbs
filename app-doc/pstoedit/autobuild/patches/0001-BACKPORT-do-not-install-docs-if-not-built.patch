From: Wolfgang Glunz <wolfgang.glunz@gmx.de>
Date: Mon, 16 Mar 2026 15:41:42 +0100
Subject: [PATCH] block generation and installation of docs under configure
 --disable-docs - issue #7

https://github.com/woglu/pstoedit/commit/eb77954be5d632e29dc91e2d9b061be208deccb2
---
 Makefile.am | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index 03879ab..5dd861e 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -1,7 +1,9 @@
 ACLOCAL_AMFLAGS = -I m4
 EXTRA_DIST=LICENSE README.md autogen.sh rm_generated.sh
-SUBDIRS = config src doc examples contrib misc othersrc 
-SUBDIRS += QT 
+SUBDIRS = config src examples contrib misc othersrc QT
+if DOCS
+SUBDIRS += doc
+endif
 m4datadir = $(datadir)/aclocal
 # m4data_DATA = m4/pstoedit.m4
 LIBTOOL_DEPS = @LIBTOOL_DEPS@

