# (.text.ijs_recv_buf+0x24): call to `ijs_recv_read' lacks nop, can't restore toc; (plt call stub)
# (.text.ijs_recv_buf+0x80): call to `ijs_recv_read' lacks nop, can't restore toc; (plt call stub)
# /usr/bin/ld: final link failed: bad value
# collect2: error: ld returned 1 exit status
if ab_match_arch ppc64; then
    abinfo "Stripping -ffunction-sections -fdata-sections to fix build ..."
    export CFLAGS="${CFLAGS/-ffunction-sections -fdata-sections/}"
fi
