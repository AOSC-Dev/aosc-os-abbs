abinfo "Setting default build options ..."
cat << EOF > "$SRCDIR"/user.make
OS=Linux
LINUX_OR_OPENBSD := yes
USE_SYSTEM_CMARK_GFM := no # Not shipped
USE_SYSTEM_CURL := yes
USE_SYSTEM_FREETYPE := yes
USE_SYSTEM_GLUT := yes
USE_SYSTEM_GUMBO := yes
USE_SYSTEM_HARFBUZZ := yes
USE_SYSTEM_JBIG2DEC := yes
USE_SYSTEM_JPEGXR := no # Not shipped
USE_SYSTEM_LCMS2 := no # MuPDF patches a vendored LCMS2 for use with fitz
USE_SYSTEM_LEPTONICA := yes
USE_SYSTEM_LIBJPEG := yes
USE_SYSTEM_LIBS := yes
USE_SYSTEM_MUJS := no	# MuJS is part of MuPDF
USE_SYSTEM_OPENJPEG := yes
USE_SYSTEM_TESSERACT := yes
USE_SYSTEM_ZLIB := yes
USE_TESSERACT := yes
VENV_FLAG :=
build := release
shared := yes
verbose := yes
EOF
