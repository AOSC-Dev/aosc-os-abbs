From 6541c1d37ed2d3337b8a7ae92f575bd625656641 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Wed, 8 Jul 2026 00:02:29 +0800
Subject: [PATCH 1/3] Remove update functionalities

---
 app/src/config/tabs/aboutTab.ts | 6 +++---
 kernel/model/updater.go         | 1 +
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/app/src/config/tabs/aboutTab.ts b/app/src/config/tabs/aboutTab.ts
index bc5241981..5b4f3814a 100644
--- a/app/src/config/tabs/aboutTab.ts
+++ b/app/src/config/tabs/aboutTab.ts
@@ -25,7 +25,7 @@ const registerAboutVersionGroup = (tab: SettingTabBuilder) => {
         html: genAboutVersionHtml,
         afterMount: mountAboutVersionSlot,
     });
-    if (!window.siyuan.config.system.isMicrosoftStore && getHostCapabilities().ownsKernel) {
+    if (false && !window.siyuan.config.system.isMicrosoftStore && getHostCapabilities().ownsKernel) {
         group.select("system.updateChannel", {
             title: window.siyuan.languages.updateChannel,
             desc: window.siyuan.languages.updateChannelTip,
@@ -73,10 +73,10 @@ const genAboutVersionHtml = (): string => {
     return `<div class="fn__flex b3-label config-item">
     <div class="fn__flex-1">
         ${genAboutVersionName()}
-        <div class="b3-label__text">${window.siyuan.languages.downloadLatestVer}<span class="fn__space"></span>${genAllChangelogsLink()}</div>
+        <div class="b3-label__text">${genAllChangelogsLink()}</div>
     </div>
     <div class="fn__space"></div>
-    ${genAboutVersionActions(true)}
+    ${genAboutVersionActions(false)}
 </div>`;
 };
 
diff --git a/kernel/model/updater.go b/kernel/model/updater.go
index 8a39a626b..ed70f4fb5 100644
--- a/kernel/model/updater.go
+++ b/kernel/model/updater.go
@@ -230,6 +230,7 @@ func getAnnouncements() (ret []*Announcement) {
 }
 
 func CheckUpdate(showMsg bool) {
+	return
 	if !showMsg {
 		return
 	}
