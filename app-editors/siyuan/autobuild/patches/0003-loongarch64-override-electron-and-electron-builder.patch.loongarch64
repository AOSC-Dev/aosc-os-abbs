From e1ce2b6f68a695ac11c305ab62640c72f18928c1 Mon Sep 17 00:00:00 2001
From: SkyBird233 <52884766+SkyBird233@users.noreply.github.com>
Date: Wed, 8 Jul 2026 00:08:06 +0800
Subject: [PATCH] loongarch64: override electron and electron-builder

---
 app/pnpm-workspace.yaml | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/app/pnpm-workspace.yaml b/app/pnpm-workspace.yaml
index c137c5d..e2d28bd 100644
--- a/app/pnpm-workspace.yaml
+++ b/app/pnpm-workspace.yaml
@@ -1,18 +1,25 @@
 allowBuilds:
   '@parcel/watcher': true
   electron: true
-  electron-winstaller: true
+  electron-winstaller: false
   esbuild: true
+  '@loongdotjs/electron-winstaller': false
 blockExoticSubdeps: false
 minimumReleaseAgeExclude:
   - electron@42.5.0 || 42.9.2
   - app-builder-lib@26.15.6
+  - '@loongdotjs/app-builder-lib@26.15.6'
   - dmg-builder@26.15.6
   - electron-builder-squirrel-windows@26.15.6
   - electron-builder@26.15.6
+  - '@loongdotjs/electron-builder@26.15.6'
 overrides:
   # 锁定 4.0.3:app-builder-lib@26.15.x 代码访问 @electron/get 的 ElectronDownloadCacheMode.ReadWrite,
   # 该导出仅在 @electron/get@4.x 存在(3.x 为 CacheMode,5.x 由 electron@42 引入且 API 不兼容),
   # 故强制统一到 4.0.3 消除多版本碎片化,修复 electron-builder 打包时的 "Cannot read properties of
   # undefined (reading 'ReadWrite')" 错误。
   '@electron/get': 4.0.3
+  'electron': '42.3.0'
+  'electron-builder': 'npm:@loongdotjs/electron-builder'
+  'app-builder-lib': 'npm:@loongdotjs/app-builder-lib'
+  'builder-util': 'npm:@loongdotjs/builder-util'
-- 
2.52.0
