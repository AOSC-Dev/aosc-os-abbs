From 1484c58e839cea44e45dc42133567217b8e4119b Mon Sep 17 00:00:00 2001
From: CAB233 <yidaduizuoye@outlook.com>
Date: Thu, 19 Nov 2026 19:33:05 +0800
Subject: [PATCH 1/2] AOSCOS: Fix executable path in service file

---
 containerd.service | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/containerd.service b/containerd.service
index aa853937c..ce4dcd7f3 100644
--- a/containerd.service
+++ b/containerd.service
@@ -18,8 +18,8 @@ Documentation=https://containerd.io
 After=network.target dbus.service
 
 [Service]
-ExecStartPre=-/sbin/modprobe overlay
-ExecStart=/usr/local/bin/containerd
+ExecStartPre=-/usr/bin/modprobe overlay
+ExecStart=/usr/bin/containerd
 
 Type=notify
 Delegate=yes
-- 
2.56.1

