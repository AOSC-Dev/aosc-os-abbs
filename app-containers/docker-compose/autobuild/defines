PKGNAME=docker-compose
PKGDES="Define and run multi-container applications with Docker"
PKGSEC=admin
PKGDEP="docker"
BUILDDEP="go"

ABTYPE=gomod
GO_PACKAGES=("cmd")
GO_BUILD_AFTER=("-tags=e2e")
GO_LDFLAGS=("-X 'github.com/docker/compose/v${PKGVER%%.*}/internal.Version=${PKGVER}'")

# FIXME: loongson3: Missing docker support
FAIL_ARCH="!(amd64|arm64|ppc64el|loongarch64|loongarch64_nosimd|riscv64)"
