PKGNAME=motif
PKGSEC=libs
PKGDEP="x11-lib libjpeg-turbo libpng xbitmaps"
PKGDES="The Motif user interface component toolkit"

PKGCONFL="lesstif"
PKGPROV="openmotif"

AUTOTOOLS_AFTER=(
	"--disable-printing"
	"--enable-jpeg"
	"--enable-png"
	"--enable-xft"
)

MAKE_AFTER=(
	CFLAGS="$CFLAGS -Wno-incompatible-pointer-types -Wno-int-conversion"
)

