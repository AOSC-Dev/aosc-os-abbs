# test -f XmStrDefs22.ht || ln -s /var/cache/acbs/build/acbs.mfua67_u/motif/lib/Xm/XmStrDefs22.ht XmStrDefs22.ht
# ln: failed to create symbolic link 'XmStrDefs.ht': File exists
ABSHADOW=0

FAIL_ARCH="!(mainline|retro)"
