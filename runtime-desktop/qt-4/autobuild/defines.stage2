PKGNAME=qt-4
PKGSEC=x11
PKGDES="Qt version 4"
PKGDEP="libtiff libpng sqlite ca-certs dbus fontconfig mesa \
        x11-lib alsa-lib xdg-utils hicolor-icon-theme libmng cups \
        icu"
PKGDEP__RETRO=" \
        libtiff libpng sqlite ca-certs dbus fontconfig mesa \
        x11-lib alsa-lib xdg-utils hicolor-icon-theme libmng cups icu"
BUILDDEP="mariadb postgresql sqlite unixodbc"
BUILDDEP__RETRO=""

NOSTATIC=0

PKGBREAK="qtchooser<=1:64"
PKGREP="qtchooser<=1:64"
