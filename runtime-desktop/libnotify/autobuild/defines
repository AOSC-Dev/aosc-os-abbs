PKGNAME=libnotify
PKGSEC=libs
PKGDEP="gtk-4"
PKGDEP__RETRO="gtk-2"
BUILDDEP="xmlto gobject-introspection gnome-common"
BUILDDEP__RETRO=""
PKGDES="Library and utilities to handle desktop notifications"

# FIXME: Binary tool split packages not detected in Spiral LUT.
PKGPROV="libnotify-bin_spiral"

ABTYPE=meson
MESON_AFTER=(
    '-Dman=true'
    '-Dgtk_doc=false'
    '-Ddocbook_docs=disabled'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dintrospection=disabled'
)
