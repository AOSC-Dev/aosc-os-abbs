PKGNAME=libnotify
PKGDES="Desktop notification library"
PKGSEC=libs
PKGDEP="glib gdk-pixbuf glibc"
BUILDDEP="xmlto gobject-introspection gnome-common gtk-4"

# FIXME: Binary tool split packages not detected in Spiral LUT.
PKGPROV="libnotify-bin_spiral"

BUILDDEP__RETRO=""

ABTYPE=meson
MESON_AFTER=(
    '-Dman=true'
    '-Dgtk_doc=false'
    '-Ddocbook_docs=disabled'
)
MESON_AFTER__RETRO=(
    '-Dintrospection=disabled'
    '-Dman=false'
    '-Dgtk_doc=false'
    '-Ddocbook_docs=disabled'
    '-Dtests=false'
)

FAIL_ARCH="!(mainline|retro)"
