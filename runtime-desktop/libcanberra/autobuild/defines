PKGNAME=libcanberra
PKGSEC=libs
PKGDEP="libvorbis libtool pulseaudio gstreamer gtk-3"
PKGDES="Library to implement the XDG Sound Theme Specification"

# FIXME:
#
# /bin/sh: line 5: automake-1.12: command not found
RECONF=0

AUTOTOOLS_AFTER=(
    '--with-builtin=dso'
    '--enable-null'
    '--disable-oss'
    '--enable-alsa'
    '--enable-gstreamer'
    '--with-systemdsystemunitdir=/usr/lib/systemd/system'
    '--disable-gtk-doc'
)
