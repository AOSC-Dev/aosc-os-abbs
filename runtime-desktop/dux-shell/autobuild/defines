PKGNAME=dux-shell
PKGSEC=libs
PKGDES="Desktop shell for Wayland compositors built with Quickshell and Go (Dux Shell)"
PKGDEP="glibc quickshell"
PKGRECOM="accountsservice dux-calendar dux-files dux-gop dux-greeter dux-search"
PKGSUG="cava matugen"
PKGPROV="dms dms-shell"
PKGBREAK="dankmaterialshell<=1.6.3"
PKGREP="dankmaterialshell<=1.6.3"

BUILDDEP="go"

ABTYPE=gomod
GO_PACKAGES=('core/cmd/dms')
GO_BUILD_AFTER=('-tags=distro_binary,withshell')
GO_LDFLAGS=("-X main.Version=$PKGVER")

# Note: Keep BLDDIR inside core/cmd/ so the gomod template's go get
# finds core/cmd/go.mod.
BLDDIR="$SRCDIR"/core/cmd/abbuild
