From 1fa0e79f87bd6e6d734d0bf5b358f476cbbba6a5 Mon Sep 17 00:00:00 2001
From: RawDiamondMC <RawDiamondMC@aosc.io>
Date: Sat, 31 Oct 2026 23:53:20 +0800
Subject: [PATCH 20/20] [Fedora] QtWebEngine: fix SYS_SECCOMP with chromium 141
 and glibc 2.42

Picked from: https://src.fedoraproject.org/rpms/qt5-qtwebengine/blob/rawhide/f/qtwebengine-chromium-141-glibc-2.42-SYS_SECCOMP.patch
---
 .../chromium/sandbox/linux/system_headers/linux_seccomp.h      | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/qtwebengine/src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h b/qtwebengine/src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h
index 1fa47ed09f..dd052fd627 100644
--- a/qtwebengine/src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h
+++ b/qtwebengine/src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h
@@ -220,8 +220,11 @@ struct seccomp_notif_addfd {
 #define SECCOMP_RET_INVALID 0x00010000U  // Illegal return value
 #endif
 
+// check glibc version < 2.42
+#if (__GLIBC__ < 2) || (__GLIBC__ == 2 && __GLIBC_MINOR__ < 42)
 #ifndef SYS_SECCOMP
 #define SYS_SECCOMP                   1
 #endif
+#endif
 
 #endif  // SANDBOX_LINUX_SYSTEM_HEADERS_LINUX_SECCOMP_H_
-- 
2.56.0

