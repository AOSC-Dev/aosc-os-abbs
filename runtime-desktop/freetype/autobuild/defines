PKGNAME=freetype
PKGSEC=libs
PKGDEP="brotli bzip2 libpng zlib"
PKGDEP__RETRO="libpng zlib bzip2"
# FIXME: configuration loop during mass upgrades of base packages.
# dependency loop causing dpkg to fail.
PKGRECOM="harfbuzz"
BUILDDEP="x11-lib harfbuzz"
PKGDES="Library to render fonts"

ABTYPE=meson
MESON_AFTER=(
    '-Dbrotli=enabled'
    '-Dbzip2=enabled'
    '-Dharfbuzz=enabled'
    '-Dmmap=enabled'
    '-Dpng=enabled'
    '-Dzlib=system'
)
MESON_AFTER__RETRO=(
    "${MESON_AFTER[@]}"
    '-Dbrotli=disabled'
    '-Dharfbuzz=disabled'
)
