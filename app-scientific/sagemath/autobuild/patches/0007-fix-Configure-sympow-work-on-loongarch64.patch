From 34be0b84ae7eaefbe657a4baf2b776e5f1e02ef3 Mon Sep 17 00:00:00 2001
From: pch666777 <1005100717@qq.com>
Date: Tue, 11 Nov 2025 15:06:15 +0800
Subject: [PATCH] fix Configure sympow work on loongarch64

---
 .../0003-Add-Loongarch64-build-support.patch  | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)
 create mode 100644 build/pkgs/sympow/patches/0003-Add-Loongarch64-build-support.patch

diff --git a/build/pkgs/sympow/patches/0003-Add-Loongarch64-build-support.patch b/build/pkgs/sympow/patches/0003-Add-Loongarch64-build-support.patch
new file mode 100644
index 00000000000..0622183247b
--- /dev/null
+++ b/build/pkgs/sympow/patches/0003-Add-Loongarch64-build-support.patch
@@ -0,0 +1,38 @@
+From b9747c2326692688d2c2be9df92a504f337e4a6a Mon Sep 17 00:00:00 2001
+From: pch666777 <1005100717@qq.com>
+Date: Tue, 11 Nov 2025 15:00:02 +0800
+Subject: [PATCH] Add Loongarch64 build support
+
+---
+ Configure | 15 ++++++++++++---
+ 1 file changed, 12 insertions(+), 3 deletions(-)
+
+diff --git a/Configure b/Configure
+index ba67fdd..aab644b 100755
+--- a/Configure
++++ b/Configure
+@@ -148,9 +148,18 @@ for FLAG in '-ffp-contract=on' '-mno-fused-madd'; do
+ done
+ 
+ # Select the most appropriate FPU control scheme
+-for FLAG in '-DISOC99_FENV' '-DFPUCONTROLH' '-Dx86'; do
+-    try_add_CFLAG $FLAG && break
+-done
++# NOTE: Loongarch64 never use '-DFPUCONTROLH' and '-Dx86'
++BASE_ARCH_NAME=$(uname -m)
++if [ "$BASE_ARCH_NAME" = "loongarch64" ]; then
++    echo "Building on loongarch64."
++    for FLAG in '-DISOC99_FENV'; do
++        try_add_CFLAG $FLAG && break
++    done
++else
++    for FLAG in '-DISOC99_FENV' '-DFPUCONTROLH' '-Dx86'; do
++        try_add_CFLAG $FLAG && break
++    done
++fi
+ 
+ # Some flags to try as last resort.  These hurt performance, so only add
+ # them if needed.
+-- 
+2.51.1
+
-- 
2.51.1

