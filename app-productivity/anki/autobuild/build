abinfo "Building runner binary ..."
cargo build -p runner --release

abinfo "Building wheels ..."
"$SRCDIR"/out/rust/release/runner build -- wheels -v

abinfo "Installing Python wheels ..."
for file in "$SRCDIR"/out/wheels/*.whl; do
    python3 -m installer --destdir="$PKGDIR" "$file"
done

abinfo "Installing desktop integration files ..."
install -vDm644 "$SRCDIR/qt/installer/linux-template/{{ cookiecutter.format }}/{{ cookiecutter.app_name }}/anki.desktop" "$PKGDIR"/usr/share/applications/anki.desktop
install -vDm644 "$SRCDIR"/qt/installer/app/resources/anki.png "$PKGDIR"/usr/share/pixmaps/anki.png
install -vDm644 "$SRCDIR/qt/installer/linux-template/{{ cookiecutter.format }}/{{ cookiecutter.app_name }}/anki.xpm" "$PKGDIR"/usr/share/pixmaps/anki.xpm
install -vDm644 "$SRCDIR/qt/installer/linux-template/{{ cookiecutter.format }}/{{ cookiecutter.app_name }}/anki.1" "$PKGDIR"/usr/share/man/man1/anki.1
install -vDm644 "$SRCDIR/qt/installer/linux-template/{{ cookiecutter.format }}/{{ cookiecutter.app_name }}/anki.xml" "$PKGDIR"/usr/share/mime/packages/anki.xml
