From 284d386c023feb01608f0494c3fbd471483e5cf1 Mon Sep 17 00:00:00 2001
From: Kaiyang Wu <wukaiyang@loongfans.cn>
Date: Thu, 29 Oct 2026 15:31:45 +0800
Subject: [PATCH] AOSCOS: Revert "block[speedtest]: Use networkquality-rs"

This reverts commit d2621fb0f2f5d57e5c3584395e576f4fa38a9a00.

Signed-off-by: Kaiyang Wu <wukaiyang@loongfans.cn>
---
 .github/workflows/docs.yml       |    2 +-
 .github/workflows/pre-commit.yml |    2 +-
 Cargo.lock                       | 1728 ++++--------------------------
 Cargo.toml                       |    3 +-
 cspell.yaml                      |    2 -
 src/blocks/speedtest.rs          |  399 +------
 6 files changed, 221 insertions(+), 1915 deletions(-)

diff --git a/.github/workflows/docs.yml b/.github/workflows/docs.yml
index 213b6c967..3d3e6a40c 100644
--- a/.github/workflows/docs.yml
+++ b/.github/workflows/docs.yml
@@ -20,7 +20,7 @@ jobs:
       image: archlinux
     steps:
     - name: Get required packages
-      run: pacman --noconfirm --noprogressbar -Syu base-devel clang cmake git libpipewire libpulse lm_sensors notmuch openssl rsync
+      run: pacman --noconfirm --noprogressbar -Syu base-devel clang git libpipewire libpulse lm_sensors notmuch openssl rsync
     - uses: dtolnay/rust-toolchain@stable
     - name: Version information
       run: rustc --version; cargo --version
diff --git a/.github/workflows/pre-commit.yml b/.github/workflows/pre-commit.yml
index 3dafe2ce6..25913a338 100644
--- a/.github/workflows/pre-commit.yml
+++ b/.github/workflows/pre-commit.yml
@@ -30,7 +30,7 @@ jobs:
     steps:
     - name: Get required packages and config git
       run: |
-        pacman --noconfirm --noprogressbar -Syu base-devel clang cmake git libpipewire libpulse lm_sensors notmuch openssl rsync
+        pacman --noconfirm --noprogressbar -Syu base-devel clang git libpipewire libpulse lm_sensors notmuch openssl rsync
         git config --global --add safe.directory "$GITHUB_WORKSPACE"
     - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
       with:
