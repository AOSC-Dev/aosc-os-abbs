-fn deserialize_url_opt<'de, D>(deserializer: D) -> Result<Option<Url>, D::Error>
-where
-    D: Deserializer<'de>,
-{
-    let url_opt = Option::<String>::deserialize(deserializer)?;
-    url_opt
-        .map(|url| url.parse().map_err(serde::de::Error::custom))
-        .transpose()
