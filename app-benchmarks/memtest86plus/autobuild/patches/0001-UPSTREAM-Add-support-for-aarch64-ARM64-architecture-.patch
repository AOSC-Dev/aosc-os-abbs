+        uintptr_t addr = (uintptr_t)start & ~(line_size - 1);
+        while (addr < (uintptr_t)end) {
+            __asm__ __volatile__ ("ic ivau, %0" : : "r" (addr) : "memory");
+            addr += line_size;
+        }
