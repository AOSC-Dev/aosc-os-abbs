diff --git a/system/aarch64/cpuid.c b/system/aarch64/cpuid.c
new file mode 100644
index 0000000..a64b2a6
--- /dev/null
+++ b/system/aarch64/cpuid.c
@@ -0,0 +1,265 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (C) 2026 Sam Demeulemeester
+//
+// ARM64 (AArch64) CPU identification via the MIDR_EL1 register
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "cpuid.h"
+
+#include "string.h"
+
+#include "registers.h"
+
+//------------------------------------------------------------------------------
+// Types
+//------------------------------------------------------------------------------
+
+typedef struct {
+    uint16_t    part_num;
+    const char  name[16];   // 15 chars + NUL max; GCC < 15 doesn't warn if the NUL gets dropped
+} cpu_part_t;
+
+//------------------------------------------------------------------------------
+// Constants
+//------------------------------------------------------------------------------
+
+static const cpu_part_t arm_parts[] = {
+    { 0xD00, "Foundation"   },
+    { 0xD03, "Cortex-A53"   },
+    { 0xD04, "Cortex-A35"   },
+    { 0xD05, "Cortex-A55"   },
+    { 0xD07, "Cortex-A57"   },
