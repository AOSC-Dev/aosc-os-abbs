+    while (addr < (uintptr_t)end) {
+        __asm__ __volatile__ ("dc cvac, %0" : : "r" (addr) : "memory");
+        addr += line_size;
+    }
+    __asm__ __volatile__ ("dsb sy" ::: "memory");
