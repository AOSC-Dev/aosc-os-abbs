         if (config().hasOption("resultdir"))
         {
             Poco::Path rdir = config().getString("resultdir");
diff --git a/frameworks/testfw/hostapp/qt/mainwindow.cpp b/frameworks/testfw/hostapp/qt/mainwindow.cpp
index bdfafbed..e6bf0949 100644
--- a/frameworks/testfw/hostapp/qt/mainwindow.cpp
+++ b/frameworks/testfw/hostapp/qt/mainwindow.cpp
@@ -107,7 +107,7 @@ void MainWindow::onStartTest()
 	env.setHeight(ui_->contentWidget->height());
 	std::string prefix = testPrefix(d);
 	env.setReadPath(basePath_ + "/data/" + prefix + "/");
-	env.setWritePath(basePath_ + "/data/" + prefix + "/");
+	env.setWritePath(QStandardPaths::writableLocation(QStandardPaths::DataLocation));
 	std::string config = d.toJsonString();
 	NGLOG_DEBUG(config);
 	
