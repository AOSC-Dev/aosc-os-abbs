abinfo "Building GUI variant..."
PLATFORM=linux \
CONFIG=Release \
MP_COMPILE=true \
APPLICATION_TYPE=gui \
    "$SRCDIR"/scripts/build.sh

abinfo "Building CLI variant..."
PLATFORM=linux \
CONFIG=Release \
MP_COMPILE=true \
    "$SRCDIR"/scripts/build.sh

abinfo "Installing files ..."
mkdir -pv "$PKGDIR"/usr/lib/gfxbench
cp -av "$SRCDIR"/out/install/linux/* \
    "$PKGDIR"/usr/lib/gfxbench

abinfo "Removing unsupported test cases (to not confuse CLI autotest) ..."
rm -v \
    "$PKGDIR"/usr/lib/gfxbench/config/{dx,gfx,metal_,vulkan_,gl_5_ovr_}*

abinfo "Removing unneeded development, data files for bundled libraries ..."
rm -rv "$PKGDIR"/usr/lib/gfxbench/{include,lib,share,cmake}

abinfo "Removing unneeded Qt-related files ..."
rm -rv "$PKGDIR"/usr/lib/gfxbench/bin/{imageformats,platforms}

abinfo "Installing icon ..."
install -Dvm644 "$SRCDIR"/app_qt/resources/gfxbench/images/icon.png \
    "$PKGDIR"/usr/share/pixmaps/gfxbench.png

abinfo "Creating a symlink to the main executable ..."
mkdir -pv "$PKGDIR"/usr/bin
ln -sfv ../lib/gfxbench/bin/gfxbench \
    "$PKGDIR"/usr/bin/gfxbench
