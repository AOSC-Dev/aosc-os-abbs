From a7b609e7325089ba199e9c6d285a2a89e034f3ab Mon Sep 17 00:00:00 2001
From: miwu04 <me@alanlin.icu>
Date: Wed, 2 Sep 2026 17:14:56 +0800
Subject: [PATCH 5/7] Edit dependencies to support loongarch64

---
 pnpm-workspace.yaml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 60b0fc6..3c654ca 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -7,6 +7,14 @@ allowBuilds:
   meta-json-schema: true
 overrides:
   typescript-eslint: ^8.59.2
+  electron: 42.3.0
+  electron-builder: npm:@loongdotjs/electron-builder@26.15.6
+  vite: ^7.0.0
+  '@vitejs/plugin-legacy': ^7.0.0
+  '@vitejs/plugin-react': ^5.0.0
+  rolldown: npm:@rolldown/binding-wasm32-wasi
+  lightningcss: npm:lightningcss-wasm
+  '@tailwindcss/oxide': npm:@tailwindcss/oxide-wasm32-wasi
 patchedDependencies:
   monaco-worker-manager@2.0.1: patches/monaco-worker-manager@2.0.1.patch
 publicHoistPattern:
-- 
2.55.0

