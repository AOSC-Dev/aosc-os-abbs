abinfo "Building Cloudflared ..."
# Note: Set GOTOOLCHAIN=local to prevent automatic toolchain downloads.
# See: https://github.com/cloudflare/cloudflared/blob/518d7f7969b764df628bb4b1088f0f154901dc4e/Makefile#L46
export GOTOOLCHAIN=local
make cloudflared PREFIX=$PKGDIR/usr PACKAGE_MANAGER=oma

abinfo "Installing Cloudflared ..."
make install PREFIX=$PKGDIR/usr PACKAGE_MANAGER=oma
