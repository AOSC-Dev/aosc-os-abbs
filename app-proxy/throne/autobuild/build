abinfo "Building Core ..."
cd ${SRCDIR}/core/server/gen
protoc -I . --go_out=. --go_opt paths=source_relative --go-grpc_out=. --go-grpc_opt paths=source_relative libcore.proto
cd ${SRCDIR}/core/server
VERSION_SINGBOX=$(go list -m -f '{{.Version}}' github.com/sagernet/sing-box)
go build -v -o ${SRCDIR}/build \
    -trimpath \
    -ldflags "-w -s -X 'github.com/sagernet/sing-box/constant.Version=${VERSION_SINGBOX}'" \
    -tags "with_clash_api,with_gvisor,with_quic,with_wireguard,with_utls,with_ech,with_dhcp"

abinfo "Building Throne ..."
cd ${SRCDIR}/build
cmake -GNinja -DCMAKE_BUILD_TYPE=Release ..
ninja

abinfo "Installing binary and icon ..."
install -Dvm755 ${SRCDIR}/build/{Core,Throne} -t ${PKGDIR}/usr/lib/throne
install -Dvm644 ${SRCDIR}/res/public/Throne.png -t ${PKGDIR}/usr/share/pixmaps
