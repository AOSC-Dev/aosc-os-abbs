From b6f546088e4a0f47ec4f4c45dba24d84532b9327 Mon Sep 17 00:00:00 2001
From: stydxm <stydxm@outlook.com>
Date: Sun, 9 Nov 2025 19:15:18 +0800
Subject: [PATCH 12/12] edit dependencies to support loongarch & ppc

Signed-off-by: stydxm <stydxm@outlook.com>
---
 Cargo.lock           | 11 -----------
 pnpm-workspace.yaml  |  6 ++++++
 scripts/prebuild.mjs |  6 ++++--
 3 files changed, 10 insertions(+), 13 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 080d959d..a96bb217 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -631,7 +631,6 @@ dependencies = [
  "dashmap",
  "dynify",
  "fast-float2",
- "float16",
  "futures-concurrency",
  "futures-lite",
  "hashbrown 0.17.1",
@@ -2424,16 +2423,6 @@ dependencies = [
  "thiserror 2.0.20",
 ]
 
-[[package]]
-name = "float16"
-version = "0.1.5"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "7bffafbd079d520191c7c2779ae9cf757601266cf4167d3f659ff09617ff8483"
-dependencies = [
- "cfg-if",
- "rustc_version 0.2.3",
-]
-
 [[package]]
 name = "fnv"
 version = "1.0.7"
diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index a37885e5..8a7631cb 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -10,3 +10,9 @@ allowBuilds:
   unrs-resolver: true
 minimumReleaseAgeExclude:
   - dayjs@1.11.21
+overrides:
+  "rollup": "npm:@rollup/wasm-node"
+  "lightningcss": "npm:lightningcss-wasm"
+  "vite": "^7.0.0"
+  "@vitejs/plugin-legacy": "^7.0.0"
+  "@vitejs/plugin-react": "^5.0.0"
diff --git a/scripts/prebuild.mjs b/scripts/prebuild.mjs
index 4231bf04..7a0b6e00 100644
--- a/scripts/prebuild.mjs
+++ b/scripts/prebuild.mjs
@@ -181,7 +181,8 @@ const META_ALPHA_MAP = {
   'linux-arm64': 'mihomo-linux-arm64',
   'linux-arm': 'mihomo-linux-armv7',
   'linux-riscv64': 'mihomo-linux-riscv64',
-  'linux-loong64': 'mihomo-linux-loong64',
+  'linux-loong64': 'mihomo-linux-loong64-abi2',
+  'linux-ppc64': 'mihomo-linux-ppc64le',
 }
 
 const META_MAP = {
@@ -195,7 +196,8 @@ const META_MAP = {
   'linux-arm64': 'mihomo-linux-arm64',
   'linux-arm': 'mihomo-linux-armv7',
   'linux-riscv64': 'mihomo-linux-riscv64',
-  'linux-loong64': 'mihomo-linux-loong64',
+  'linux-loong64': 'mihomo-linux-loong64-abi2',
+  'linux-ppc64': 'mihomo-linux-ppc64le',
 }
 
 // Release discovery
