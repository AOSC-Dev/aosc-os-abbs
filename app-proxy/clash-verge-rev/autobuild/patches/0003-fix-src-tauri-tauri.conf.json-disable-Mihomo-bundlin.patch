From 8e191fbc6ace959ca3c721fffa6b968b2ff61beb Mon Sep 17 00:00:00 2001
From: eatradish <sakiiily@aosc.io>
Date: Mon, 13 Jan 2025 14:34:52 +0800
Subject: [PATCH 03/12] fix(src-tauri/tauri.conf.json): disable Mihomo bundling

---
 scripts/prebuild.mjs      | 13 -------------
 src-tauri/tauri.conf.json |  1 -
 2 files changed, 14 deletions(-)

diff --git a/scripts/prebuild.mjs b/scripts/prebuild.mjs
index a7ddce78..81f5e1ec 100644
--- a/scripts/prebuild.mjs
+++ b/scripts/prebuild.mjs
@@ -689,22 +689,9 @@ const resolveUnSetDnsScript = () =>
   })
 
 const tasks = [
-  {
-    name: 'verge-mihomo-alpha',
-    func: () =>
-      getLatestAlphaVersion().then(() => resolveSidecar(clashMetaAlpha())),
-    retry: 5,
-  },
-  {
-    name: 'verge-mihomo',
-    func: () =>
-      getLatestReleaseVersion().then(() => resolveSidecar(clashMeta())),
-    retry: 5,
-  },
   // After both sidecar tasks: it hashes what they downloaded.
   { name: 'core_hashes', func: resolveCoreHashes, retry: 1, winOnly: true },
   { name: 'plugin', func: resolvePlugin, retry: 5, winOnly: true },
-  { name: 'service', func: resolveServiceBundle, retry: 5 },
   { name: 'mmdb', func: resolveMmdb, retry: 5 },
   { name: 'geosite', func: resolveGeosite, retry: 5 },
   { name: 'geoip', func: resolveGeoIP, retry: 5 },
diff --git a/src-tauri/tauri.conf.json b/src-tauri/tauri.conf.json
index 53d09b09..35dc2414 100755
--- a/src-tauri/tauri.conf.json
+++ b/src-tauri/tauri.conf.json
@@ -14,7 +14,6 @@
     ],
     "resources": ["resources"],
     "publisher": "Clash Verge Rev",
-    "externalBin": ["sidecar/verge-mihomo", "sidecar/verge-mihomo-alpha"],
     "copyright": "GNU General Public License v3.0",
     "category": "DeveloperTool",
     "shortDescription": "Clash Verge Rev",
