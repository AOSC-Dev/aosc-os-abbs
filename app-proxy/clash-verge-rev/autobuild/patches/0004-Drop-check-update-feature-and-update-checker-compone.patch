-        maxWidth: 'calc(100vw - 56px)',
-        height: 'min(64vh, 680px)',
-        display: 'flex',
-        flexDirection: 'column',
-        pb: 1,
-      }}
-      okBtn={t('settings.modals.update.actions.update')}
-      cancelBtn={t('shared.actions.cancel')}
-      onClose={() => setOpen(false)}
-      onCancel={() => setOpen(false)}
-      onOk={onUpdate}
-    >
-      <Box
-        sx={{
-          flex: 1,
-          minHeight: 0,
-          overflow: 'auto',
-          pr: 1.5,
-          mr: -1,
-          fontSize: 14,
