PKGNAME=hysteria
PKGSEC=net
PKGDES="A multi-protocol network proxy"
PKGDEP="glibc"
BUILDDEP="go"

ABTYPE=gomod
GO_LDFLAGS=("-X github.com/apernet/hysteria/app/v2/cmd.appVersion=v$PKGVER")
GO_PACKAGES=("app")
# Note: keep BLDDIR inside app/ so the gomod template's go get finds app/go.mod.
BLDDIR="$SRCDIR"/app/abbuild
