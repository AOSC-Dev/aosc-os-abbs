abinfo "Mapping Flutter architecture ..."
if ab_match_arch amd64; then
    export FLUTTER_OUT="$SRCDIR/build/linux/x64/release/bundle"
elif ab_match_arch arm64; then
    export FLUTTER_OUT="$SRCDIR/build/linux/arm64/release/bundle"
fi

abinfo "Setting up flutter ..."
fvm install 3.47.6
fvm global 3.47.6
fvm flutter --disable-analytics

# Get version at "plugins/rust_api/rust/rust-toolchain.toml".
abinfo "Installing specific version of Rust ..."
export RUSTUP_INIT_SKIP_PATH_CHECK=yes
curl https://sh.rustup.rs -sSf | sh -s -- --default-toolchain 1.99.0 -y
export PATH="$HOME"/.cargo/bin:"$PATH"
