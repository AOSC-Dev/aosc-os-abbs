From 9340e51f78777d67f0b9eddfdc4449f83a63fa12 Mon Sep 17 00:00:00 2001
From: stydxm <stydxm@outlook.com>
Date: Sun, 20 Sep 2026 22:14:57 +0800
Subject: [PATCH 1/3] AOSCOS: set 'clash-verge-service' path to
 '/usr/bin/clash-verge-service'

---
 src/bin/install_service.rs | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/src/bin/install_service.rs b/src/bin/install_service.rs
index 2473a75..6211cb3 100644
--- a/src/bin/install_service.rs
+++ b/src/bin/install_service.rs
@@ -24,11 +24,7 @@ use std::path::{Path, PathBuf};
 use std::time::{Duration, Instant};
 
 fn bundled_service_binary() -> Result<PathBuf, Error> {
-    let source = std::env::current_exe()?.with_file_name(if cfg!(windows) {
-        "clash-verge-service.exe"
-    } else {
-        "clash-verge-service"
-    });
+    let source = PathBuf::from("/usr/bin/clash-verge-service");
     let metadata = std::fs::symlink_metadata(&source)
         .with_context(|| format!("failed to inspect bundled service binary {source:?}"))?;
     if !metadata.file_type().is_file() {
@@ -842,8 +838,7 @@ fn main() -> Result<(), Error> {
     let group = resolve_service_group_name()?;
     let debug = options.debug;
     let source = bundled_service_binary()?;
-    let install_dir = clash_verge_service_ipc::prepare_service_install_directory()?;
-    let target = install_dir.join("clash-verge-service");
+    let target = PathBuf::from("/usr/bin/clash-verge-service");
     let staged = stage_binary(&source, &target)?;
     let unit_name = format!("{}.service", clash_verge_service_ipc::SERVICE_SLUG);
     let unit_path = PathBuf::from("/etc/systemd/system").join(&unit_name);
