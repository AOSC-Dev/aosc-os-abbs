PKGNAME=zig
PKGSEC=devel
PKGDEP="llvm-20 zlib zstd"
PKGDES="General-purpose programming language and toolchain for maintaining robust, optimal, and reusable software"

ABTYPE=cmakeninja
USECLANG=1
CMAKE_AFTER=(
    -DZIG_VERSION="${PKGVER}"
    -DZIG_STATIC=OFF
    -DZIG_SHARED_LLVM=ON
    -DZIG_USE_LLVM_CONFIG=ON
    -DZIG_EXTRA_BUILD_ARGS="--build-id=sha1"
)
CMAKE_AFTER__AMD64=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=x86_64-linux-gnu'
	'-DZIG_TARGET_MCPU=x86_64+sse+sse2+allow_light_256_bit+branchfusion+fast_15bytenop+fast_bextr+fast_dpwssd+fast_imm16+fast_lzcnt+fast_movbe+fast_scalar_fsqrt+fast_scalar_shift_masks+fast_variable_perlane_shuffle+fast_vector_fsqrt+sbb_dep_breaking-slow_3ops_lea-slow_incdec+slow_shld'
)
CMAKE_AFTER__ARM64=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=aarch64-linux-gnu'
	'-DZIG_TARGET_MCPU=generic+v8a+neon+fp_armv8+crypto+crc'
)
CMAKE_AFTER__LOONGARCH64=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=loongarch64-linux-gnu'
	# FIXME: use la64v1_0+lsx in 0.16.x
	'-DZIG_TARGET_MCPU=generic_la64+relax'
)
CMAKE_AFTER__LOONGARCH64_NOSIMD=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=loongarch64-linux-gnu'
	# FIXME: use la64v1_0+lsx in 0.16.x
	'-DZIG_TARGET_MCPU=generic_la64-lsx+relax'
)
CMAKE_AFTER__LOONGSON3=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=mips64el-linux-gnuabi64'
	'-DZIG_TARGET_MCPU=mips64r2'
)
CMAKE_AFTER__PPC64EL=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=powerpc64le-linux-gnu'
	'-DZIG_TARGET_MCPU=pwr8+power8_vector+power8_altivec+secure_plt+fast_MFLR+fuse_add_logical-fuse_addi_load-fuse_addis_load+fuse_arith_add+fuse_logical+fuse_logical_add+fuse_sha3+fuse_store+ppc_postra_sched+ppc_prera_sched'
)
CMAKE_AFTER__RISCV64=(
	"${CMAKE_AFTER[@]}"
	'-DZIG_TARGET_TRIPLE=riscv64-linux-gnu'
	'-DZIG_TARGET_MCPU=generic_rv64+rva20u64'
)

# FIXME: loongson3: Deadlock during stage2 to stage3
FAIL_ARCH="!(amd64|arm64|riscv64|loongarch64|loongarch64_nosimd|ppc64el)"
