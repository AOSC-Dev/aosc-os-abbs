+/// Exchanges contents of two memory locations.
 pub fn swap(comptime T: type, a: *T, b: *T) void {
     const tmp = a.*;
     a.* = b.*;
@@ -4463,6 +4509,9 @@ pub fn alignForward(comptime T: type, addr: T, alignment: T) T {
