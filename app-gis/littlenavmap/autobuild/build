# LittleNavmap Autobuild
# Notice: something is from offical build script
MARBLE_SRC="$SRCDIR/../marble"
ATOOLS_SRC="$SRCDIR/../atools"
MARBLE_PREFIX="$BLDDIR/marble-install"
APP_LNM="$PKGDIR/usr/lib/littlenavmap"
APP_LNC="$PKGDIR/usr/lib/littlenavconnect"
LNC_SRC="$SRCDIR/../littlenavconnect"

# --- Stage 1 Build Marble ---

abinfo "Stage 1/4: Configuring Marble (lnm fork) ..."
cmake -S "$MARBLE_SRC" -B "$BLDDIR/marble" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$MARBLE_PREFIX" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DQTONLY=TRUE \
    -DSTATIC_BUILD=TRUE \
    -DBUILD_MARBLE_APPS=NO \
    -DBUILD_MARBLE_TOOLS=NO \
    -DBUILD_MARBLE_TESTS=NO \
    -DBUILD_TESTING=NO \
    -DBUILD_WITH_DBUS=NO \
    -DMARBLE_EMPTY_MAPTHEME=YES \
    -DMOBILE=NO \
    -DWITH_DESIGNER_PLUGIN=NO \
    -DWITH_KDE=NO \
    -DWITH_Phonon=NO \
    -DWITH_Qt5Location=NO \
    -DWITH_Qt5Positioning=NO \
    -DWITH_Qt5SerialPort=NO \
    -DWITH_ZLIB=NO \
    -DWITH_libgps=NO \
    -DWITH_libshp=NO \
    -DWITH_libwlocate=NO \
    || abdie "Failed to configure Marble"

abinfo "Stage 1/4: Building Marble ..."
cmake --build "$BLDDIR/marble" $ABMK || abdie "Failed to build Marble"

abinfo "Stage 1/4: Installing Marble into build prefix ..."
cmake --install "$BLDDIR/marble" || abdie "Failed to install Marble"

# --- Stage 2 Build atools ---

abinfo "Stage 2/4: Building atools (static) ..."
mkdir -p "$BLDDIR/atools"
cd "$BLDDIR/atools"
qmake "$ATOOLS_SRC/atools.pro" CONFIG+=release || abdie "Failed to configure atools"
make $ABMK || abdie "Failed to build atools"

# --- Stage 3 Build Navmap ---

abinfo "Stage 3/4: Building Little Navmap ..."
export ATOOLS_INC_PATH="$ATOOLS_SRC/src"
export ATOOLS_LIB_PATH="$BLDDIR/atools"
export MARBLE_INC_PATH="$MARBLE_PREFIX/include"
export MARBLE_LIB_PATH="$MARBLE_PREFIX/lib"
mkdir -p "$BLDDIR/lnm"
cd "$BLDDIR/lnm"
qmake "$SRCDIR/littlenavmap.pro" CONFIG+=release || abdie "Failed to configure littlenavmap"
make $ABMK || abdie "Failed to build littlenavmap"

# --- Stage 4 Build Navconnect

abinfo "Stage 4/4: Building Little Navconnect ..."
mkdir -p "$BLDDIR/lnc"
cd "$BLDDIR/lnc"
qmake "$LNC_SRC/littlenavconnect.pro" CONFIG+=release || abdie "Failed to configure littlenavconnect"
make $ABMK || abdie "Failed to build littlenavconnect"

# --- Final Stage Pack things together ---

cd "$SRCDIR"

# --- LittleNavMap ---
abinfo "Installing Little Navmap files ..."
install -d "$APP_LNM/lib" "$APP_LNM/plugins" "$APP_LNM/translations"

install -Dm755 "$BLDDIR/lnm/littlenavmap" "$APP_LNM/littlenavmap"
patchelf --set-rpath '$ORIGIN/lib' "$APP_LNM/littlenavmap" \
    || abdie "Failed to set rpath on littlenavmap"
cp -va "$MARBLE_PREFIX/lib/"*.so* "$APP_LNM/lib/"
for _lib in "$APP_LNM/lib/"*.so*; do
    patchelf --set-rpath '$ORIGIN' "$_lib" || abdie "Failed to set rpath on $_lib"
done
cp -va "$MARBLE_PREFIX/lib/marble/plugins/"*.so "$APP_LNM/plugins/"
cp -va "$SRCDIR/marble/data" "$APP_LNM/data"
cp -va "$SRCDIR/help" "$APP_LNM/help"
cp -va "$SRCDIR/web" "$APP_LNM/web"
cp -va "$SRCDIR/customize" "$APP_LNM/customize"
cp -va "$SRCDIR/"*.qm "$APP_LNM/translations/"
cp -va "$ATOOLS_SRC/"*.qm "$APP_LNM/translations/"
echo "$PKGVER" > "$APP_LNM/version.txt"

# --- Liitle Navconnect ---
abinfo "Installing Little Navconnect files ..."
install -d "$APP_LNC/translations"
install -Dm755 "$BLDDIR/lnc/littlenavconnect" "$APP_LNC/littlenavconnect"
cp -va "$LNC_SRC/help" "$APP_LNC/help"
cp -va "$LNC_SRC/"*.qm "$APP_LNC/translations/"
cp -va "$ATOOLS_SRC/"*.qm "$APP_LNC/translations/"
echo "$PKGVER" > "$APP_LNC/version.txt"

# Startup script
install -d "$PKGDIR/usr/bin"
cat > "$PKGDIR/usr/bin/littlenavmap" <<'EOF'
#!/bin/sh
cd /usr/lib/littlenavmap
exec ./littlenavmap "$@"
EOF
cat > "$PKGDIR/usr/bin/littlenavconnect" <<'EOF'
#!/bin/sh
cd /usr/lib/littlenavconnect
exec ./littlenavconnect "$@"
EOF
chmod 755 "$PKGDIR/usr/bin/littlenavmap" "$PKGDIR/usr/bin/littlenavconnect"

# Desktop Icons
install -d "$PKGDIR/usr/share/applications"
install -Dm644 "$SRCDIR/resources/icons/littlenavmap.svg" \
    "$PKGDIR/usr/share/icons/hicolor/scalable/apps/littlenavmap.svg"
install -Dm644 "$LNC_SRC/resources/icons/navconnect.svg" \
    "$PKGDIR/usr/share/icons/hicolor/scalable/apps/littlenavconnect.svg"

cat > "$PKGDIR/usr/share/applications/littlenavmap.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Exec=/usr/bin/littlenavmap
Path=/usr/lib/littlenavmap
Name=Little Navmap
GenericName=Flight Planning and Navigation
Icon=littlenavmap
Terminal=false
Categories=Qt;Utility;Geography;Maps;
EOF
cat > "$PKGDIR/usr/share/applications/littlenavconnect.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Exec=/usr/bin/littlenavconnect
Path=/usr/lib/littlenavconnect
Name=Little Navconnect
GenericName=Flight Simulator Bridge
Icon=littlenavconnect
Terminal=false
Categories=Qt;Utility;Geography;Maps;
EOF


# Last Stage: Docs!

install -d "$PKGDIR/usr/share/doc/littlenavmap"
install -m644 "$SRCDIR/LICENSE.txt" "$SRCDIR/CHANGELOG.txt" "$SRCDIR/README.txt" \
    "$PKGDIR/usr/share/doc/littlenavmap/"

abinfo "Build finished: all stages completed."
