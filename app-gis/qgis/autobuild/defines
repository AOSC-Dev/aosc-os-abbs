PKGNAME=qgis
PKGSEC=science
PKGDEP="proj geos gdal libzip exiv2 pdal qtkeychain qca gsl sip jinja2 \
	psycopg2 pyqt6 pyqt-builder qwt qscintilla postgresql-runtime owslib \
	qscintilla llvm"
PKGDES="Geographic Information System (GIS) software"

ABTYPE=cmakeninja
# System libspatialindex is too new:
# https://github.com/libspatialindex/libspatialindex/issues/276
CMAKE_AFTER=(
	"-DPostgreSQL_INCLUDE_DIR=/usr/lib/postgresql-18/include/"
	"-DQGIS_MANUAL_SUBDIR=share/man"
	"-DWITH_INTERNAL_SPATIALINDEX=TRUE"
	"-DWITH_QTWEBKIT=FALSE"
)

# FIXME:
# /usr/bin/ld: /tmp/lto-llvm-c7ada0.o: in function `QgsRasterHistogramWidget::refreshHistogram()':
# ld-temp.o:(.text._ZN24QgsRasterHistogramWidget16refreshHistogramEv+0xf94): undefined reference to `QwtPlotCurve::setSamples(QList<QPointF> const&)'
NOLTO=1

USECLANG=1
