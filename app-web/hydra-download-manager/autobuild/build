abinfo "Building hydra..."
cargo build --release -p hya-cli -p hya-gui -p hya-host -p hya-plugin-cli

abinfo "Building hydra-youtube and hydra-torrent plugins..."
# Note: hydra-youtube and hydra-torrent plugin need wasm32-wasip1 target to build
env CARGO_ENCODED_RUSTFLAGS="" \
    python3 "$SRCDIR"/plugins/build.py hydra-youtube
# Note: Pin to C++17: GCC 16 defaults to C++23, which causes char8_t/u8path
# error: no match for ‘operator=’(operand types are ‘std::string’ {aka ‘std::__cxx11::basic_string<char>’} 
# and ‘std::u8string’ {aka ‘std::__cxx11::basic_string<char8_t>’})
env CARGO_ENCODED_RUSTFLAGS="" \
    CXXFLAGS="-std=c++17" \
    python3 "$SRCDIR"/plugins/hydra-torrent/build.py 

abinfo "Installing hydra..."
install -Dvm755 "$SRCDIR"/target/release/hydra \
    "$PKGDIR"/usr/bin/hydra
install -Dvm755 "$SRCDIR"/target/release/hydra-gui \
    "$PKGDIR"/usr/bin/hydra-gui
install -Dvm755 "$SRCDIR"/target/release/hydra-host \
    "$PKGDIR"/usr/bin/hydra-host
install -Dvm755 "$SRCDIR"/target/release/hydra-plugin \
    "$PKGDIR"/usr/bin/hydra-plugin

abinfo "Installing hydra-youtube and hydra-torrent plugins..."
install -Dvm755 "$SRCDIR"/plugins/hydra-youtube/youtube-download.hyaplugin \
    "$PKGDIR"/usr/lib/hydra/plugins/hydra-youtube.hyaplugin
install -Dvm755 "$SRCDIR"/target/torrent-download-linux-*.hyaplugin \
    "$PKGDIR"/usr/lib/hydra/plugins/hydra-torrent.hyaplugin

abinfo "Installing desktop entry and application icon ..."
install -Dvm644 "$SRCDIR"/packaging/debian/hydra.desktop \
    "$PKGDIR"/usr/share/applications/hydra.desktop
install -Dvm644 "$SRCDIR"/docs/logo.png \
    "$PKGDIR"/usr/share/icons/hicolor/512x512/apps/hydra.png

abinfo "Installing native Messaging Host Manifests..."
for d in etc/opt/chrome etc/chromium etc/opt/edge; do
    install -Dvm644 "$SRCDIR"/packaging/debian/com.hydra.host.chrome.json "$PKGDIR"/$d/native-messaging-hosts/com.hydra.host.json
done
install -Dvm644 "$SRCDIR"/packaging/debian/com.hydra.host.mozilla.json "$PKGDIR"/usr/lib/mozilla/native-messaging-hosts/com.hydra.host.json

abinfo "Installing shell completions ..."
"$SRCDIR"/target/release/hydra completions bash > "$SRCDIR"/bash-completions
"$SRCDIR"/target/release/hydra completions fish > "$SRCDIR"/fish-completions
"$SRCDIR"/target/release/hydra completions zsh > "$SRCDIR"/zsh-completions
install -Dvm644 "$SRCDIR"/bash-completions "$PKGDIR"/usr/share/bash-completion/completions/hydra
install -Dvm644 "$SRCDIR"/fish-completions "$PKGDIR"/usr/share/fish/vendor_completions.d/hydra.fish
install -Dvm644 "$SRCDIR"/zsh-completions "$PKGDIR"/usr/share/zsh/site-functions/hydra
