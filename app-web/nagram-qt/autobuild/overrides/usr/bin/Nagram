#!/bin/sh
# One-time notice: Nagram is an unofficial third-party Telegram client.
NOTICE_STAMP="${XDG_DATA_HOME:-$HOME/.local/share}/nagram-qt/.aosc-first-run-notice"
if [ ! -e "$NOTICE_STAMP" ]; then
    zenity --warning --width=560 --title="Nagram-Qt" \
        --text="Nagram-Qt is an unofficial, third-party Telegram client. It is not endorsed by Telegram, and using third-party clients may pose risks to your account's security. Proceed at your own discretion." \
        || true
    install -Dm644 /dev/null "$NOTICE_STAMP"
fi
exec /usr/lib/nagram-qt/Nagram "$@"
