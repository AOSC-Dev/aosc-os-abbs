+  if (UPDATES_MANAGED_BY_OS) {
+    showUpdatesManagedDialog()
+    return
+  }
+
   const currentOperationId = ++operationId
   const ch = (channel || preferenceStore.config.updateChannel || 'stable') as UpdateChannel
   requestedChannel.value = ch
