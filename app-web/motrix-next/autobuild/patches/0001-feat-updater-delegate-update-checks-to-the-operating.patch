+function showUpdatesManagedDialog(): void {
+  dialog.info({
+    title: t('app.check-updates-now'),
+    content: UPDATES_MANAGED_BY_OS_MESSAGE,
+    positiveText: t('app.confirm'),
+  })
+}
+
