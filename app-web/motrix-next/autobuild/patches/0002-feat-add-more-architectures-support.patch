From 01d0a83b8153a9ab43850a9f71352c401d4b40cc Mon Sep 17 00:00:00 2001
From: miwu04 <me@alanlin.icu>
Date: Sun, 13 Sep 2026 17:02:47 +0800
Subject: [PATCH 2/5] feat: add more architectures support

---
 src/composables/__tests__/usePlatform.test.ts | 11 +++++++++++
 src/composables/usePlatform.ts                |  4 ++++
 2 files changed, 15 insertions(+)

diff --git a/src/composables/__tests__/usePlatform.test.ts b/src/composables/__tests__/usePlatform.test.ts
index 55f366c6..4e2086c7 100644
--- a/src/composables/__tests__/usePlatform.test.ts
+++ b/src/composables/__tests__/usePlatform.test.ts
@@ -27,4 +27,15 @@ describe('Platform labels', () => {
     expect(usePlatform().platform).toBe(state.platform)
     expect(mockPlatform).toHaveBeenCalledOnce()
   })
+
+  it.each([
+    ['loongarch64', 'LoongArch64'],
+    ['mips64', 'MIPS64el'],
+    ['powerpc64', 'PowerPC64el'],
+    ['riscv64', 'RISC-V64'],
+  ])('labels %s on Linux', async (arch, label) => {
+    mockPlatform.mockReturnValue('linux')
+    const { usePlatform } = await import('../usePlatform')
+    expect(usePlatform().archLabel(arch)).toBe(label)
+  })
 })
diff --git a/src/composables/usePlatform.ts b/src/composables/usePlatform.ts
index 1e978e2c..6f57ce16 100644
--- a/src/composables/usePlatform.ts
+++ b/src/composables/usePlatform.ts
@@ -49,6 +49,10 @@ const ARCH_LABELS: Record<string, string> = {
   aarch64: 'ARM64',
   x86_64: 'x64',
   x86: 'x86',
+  loongarch64: 'LoongArch64',
+  mips64: 'MIPS64el',
+  powerpc64: 'PowerPC64el',
+  riscv64: 'RISC-V64',
 }
 
