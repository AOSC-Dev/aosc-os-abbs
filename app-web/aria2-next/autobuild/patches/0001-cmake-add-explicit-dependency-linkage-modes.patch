From e14ae5e7cc5b8d7edbf5e5f648a8889ebd971577 Mon Sep 17 00:00:00 2001
From: miwu04 <me@alanlin.icu>
Date: Wed, 16 Sep 2026 17:29:59 +0800
Subject: [PATCH] cmake: add explicit dependency linkage modes

---
 cmake/modules/Dependencies.cmake       |  7 +++
 cmake/modules/FeatureChecks.cmake      | 15 ++++++-
 cmake/modules/Options.cmake            | 10 ++++-
 cmake/modules/SystemDependencies.cmake | 60 ++++++++++++++++++++++++++
 cmake/modules/Targets.cmake            |  6 ++-
 5 files changed, 94 insertions(+), 4 deletions(-)
 create mode 100644 cmake/modules/SystemDependencies.cmake

diff --git a/cmake/modules/Dependencies.cmake b/cmake/modules/Dependencies.cmake
index 8acb02c51..3600c361e 100644
--- a/cmake/modules/Dependencies.cmake
+++ b/cmake/modules/Dependencies.cmake
@@ -1,3 +1,5 @@
+if(ARIA2_DEPENDENCY_ROOT)
+
 function(aria2_import_dependency target header)
   set(options)
   set(one_value_args)
@@ -61,6 +63,7 @@ if(ARIA2_ENABLE_BITTORRENT)
     PATHS "${ARIA2_DEPENDENCY_ROOT}/lib/cmake/LibtorrentRasterbar"
     NO_DEFAULT_PATH
     NO_CMAKE_FIND_ROOT_PATH)
+  set(ARIA2_LIBTORRENT_INCLUDE_DIR "${ARIA2_DEPENDENCY_ROOT}/include")
 endif()
 
 unset(CURL_DIR CACHE)
@@ -85,3 +88,7 @@ get_target_property(aria2_curl_link_libraries CURL::libcurl_static
 list(FILTER aria2_curl_link_libraries EXCLUDE REGEX ".*ZLIB::ZLIB.*")
 set_property(TARGET CURL::libcurl_static PROPERTY INTERFACE_LINK_LIBRARIES
   "${aria2_curl_link_libraries}")
+
+else()
+  include(${CMAKE_CURRENT_LIST_DIR}/SystemDependencies.cmake)
+endif()
diff --git a/cmake/modules/FeatureChecks.cmake b/cmake/modules/FeatureChecks.cmake
index 3d6551b8a..05d78a743 100644
--- a/cmake/modules/FeatureChecks.cmake
+++ b/cmake/modules/FeatureChecks.cmake
@@ -167,7 +167,20 @@ set(HAVE_OPENSSL_CRYPTO 1)
 
 if(ARIA2_ENABLE_BITTORRENT)
   cmake_push_check_state(RESET)
-  set(CMAKE_REQUIRED_LIBRARIES LibtorrentRasterbar::torrent-rasterbar)
+  if(ARIA2_DEPENDENCY_LINKAGE STREQUAL "SHARED")
+    # Targets created by add_subdirectory() are not visible to try_compile().
+    set(CMAKE_REQUIRED_INCLUDES
+      "${CMAKE_SOURCE_DIR}/third_party/libtorrent/include"
+      ${Boost_INCLUDE_DIRS})
+    set(CMAKE_REQUIRED_DEFINITIONS
+      -DTORRENT_USE_RTC=0
+      -DTORRENT_USE_OPENSSL
+      -DTORRENT_USE_LIBCRYPTO
+      -DTORRENT_SSL_PEERS)
+  else()
+    set(CMAKE_REQUIRED_LIBRARIES
+      LibtorrentRasterbar::torrent-rasterbar)
+  endif()
   check_cxx_source_compiles("
 #include <libtorrent/config.hpp>
 #ifdef TORRENT_DISABLE_DHT
diff --git a/cmake/modules/Options.cmake b/cmake/modules/Options.cmake
index 6cc3692ec..6b551588e 100644
--- a/cmake/modules/Options.cmake
+++ b/cmake/modules/Options.cmake
@@ -19,6 +19,12 @@ set(ARIA2_BASH_COMPLETION_DIR "" CACHE PATH "Bash completion installation direct
 set(ARIA2_DEPENDENCY_ROOT "" CACHE PATH "Vendored dependency installation")
 set(ARIA2_BOOST_ROOT "" CACHE PATH "Vendored Boost source root")
 
+if((ARIA2_DEPENDENCY_ROOT AND NOT ARIA2_BOOST_ROOT) OR
+    (ARIA2_BOOST_ROOT AND NOT ARIA2_DEPENDENCY_ROOT))
+  message(FATAL_ERROR
+    "ARIA2_DEPENDENCY_ROOT and ARIA2_BOOST_ROOT must be provided together")
+endif()
+
 file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/packaging/dependencies.env"
   ARIA2_WSLAY_VERSION_LINE REGEX "^WSLAY_VERSION=[0-9]+\\.[0-9]+\\.[0-9]+$")
 string(REGEX REPLACE "^WSLAY_VERSION=" ""
@@ -27,10 +33,10 @@ if(NOT ARIA2_WSLAY_VERSION)
   message(FATAL_ERROR "WSLAY_VERSION is missing from packaging/dependencies.env")
 endif()
 
-if(NOT IS_DIRECTORY "${ARIA2_DEPENDENCY_ROOT}")
+if(ARIA2_DEPENDENCY_ROOT AND NOT IS_DIRECTORY "${ARIA2_DEPENDENCY_ROOT}")
   message(FATAL_ERROR "ARIA2_DEPENDENCY_ROOT must reference the vendored dependency installation")
 endif()
-if(NOT IS_DIRECTORY "${ARIA2_BOOST_ROOT}/boost/asio")
+if(ARIA2_BOOST_ROOT AND NOT IS_DIRECTORY "${ARIA2_BOOST_ROOT}/boost/asio")
   message(FATAL_ERROR "ARIA2_BOOST_ROOT must reference the vendored Boost source root")
 endif()
 
diff --git a/cmake/modules/SystemDependencies.cmake b/cmake/modules/SystemDependencies.cmake
new file mode 100644
index 000000000..0f9d43930
--- /dev/null
+++ b/cmake/modules/SystemDependencies.cmake
@@ -0,0 +1,60 @@
+find_package(Threads REQUIRED)
+find_package(Boost REQUIRED)
+find_package(ZLIB REQUIRED)
+find_package(EXPAT REQUIRED)
+find_package(SQLite3 REQUIRED)
+find_package(OpenSSL ${ARIA2_MIN_OPENSSL_VERSION} REQUIRED
+  COMPONENTS Crypto SSL)
+find_package(CURL REQUIRED)
+
+if(NOT TARGET ZLIB::ZLIB)
+  message(FATAL_ERROR "System zlib package must provide the ZLIB::ZLIB target")
+endif()
+if(NOT TARGET EXPAT::EXPAT)
+  message(FATAL_ERROR "System Expat package must provide the EXPAT::EXPAT target")
+endif()
+if(TARGET SQLite3::SQLite3)
+  set(ARIA2_SYSTEM_SQLITE_TARGET SQLite3::SQLite3)
+elseif(TARGET SQLite::SQLite3)
+  set(ARIA2_SYSTEM_SQLITE_TARGET SQLite::SQLite3)
+else()
+  message(FATAL_ERROR "System SQLite3 package must provide a SQLite3 target")
+endif()
+if(NOT TARGET CURL::libcurl)
+  message(FATAL_ERROR "System curl package must provide the CURL::libcurl target")
+endif()
+
+add_library(aria2::zlib ALIAS ZLIB::ZLIB)
+add_library(aria2::expat ALIAS EXPAT::EXPAT)
+add_library(aria2::sqlite ALIAS ${ARIA2_SYSTEM_SQLITE_TARGET})
+set(ARIA2_BOOST_ROOT "${Boost_INCLUDE_DIRS}")
+set(ARIA2_LIBTORRENT_INCLUDE_DIR
+  "${CMAKE_SOURCE_DIR}/third_party/libtorrent/include")
+
+if(ARIA2_ENABLE_BITTORRENT)
+  # Use the patched vendored libtorrent used by the official aria2-next build.
+  # Common dependencies above remain system-provided shared libraries.
+  set(_aria2_saved_build_shared_libs "${BUILD_SHARED_LIBS}")
+  set(BUILD_SHARED_LIBS OFF)
+  set(build_tests OFF)
+  set(build_examples OFF)
+  set(build_tools OFF)
+  set(python-bindings OFF)
+  set(deprecated-functions OFF)
+  set(extensions ON)
+  set(mutable-torrents ON)
+  set(streaming ON)
+  set(i2p OFF)
+  set(webtorrent OFF)
+  set(logging ON)
+  set(encryption ON)
+  set(dht ON)
+  add_subdirectory(
+    "${CMAKE_SOURCE_DIR}/third_party/libtorrent"
+    "${CMAKE_BINARY_DIR}/third_party/libtorrent"
+    EXCLUDE_FROM_ALL)
+  add_library(LibtorrentRasterbar::torrent-rasterbar ALIAS torrent-rasterbar)
+  set(BUILD_SHARED_LIBS "${_aria2_saved_build_shared_libs}")
+endif()
+
+set(ARIA2_SYSTEM_DEPENDENCIES ON)
diff --git a/cmake/modules/Targets.cmake b/cmake/modules/Targets.cmake
index ef68ff534..74d4c78b3 100644
--- a/cmake/modules/Targets.cmake
+++ b/cmake/modules/Targets.cmake
@@ -128,7 +128,11 @@ target_compile_definitions(aria2_core PRIVATE
   BOOST_ASIO_HEADER_ONLY
   BOOST_ERROR_CODE_HEADER_ONLY)
 target_link_libraries(aria2_core PRIVATE spdlog::spdlog_header_only)
-target_link_libraries(aria2_core PUBLIC CURL::libcurl_static)
+if(ARIA2_SYSTEM_DEPENDENCIES)
+  target_link_libraries(aria2_core PUBLIC CURL::libcurl)
+else()
+  target_link_libraries(aria2_core PUBLIC CURL::libcurl_static)
+endif()
 if(ENABLE_WEBSOCKET)
   target_link_libraries(aria2_core PUBLIC wslay)
 endif()
-- 
2.55.0

