PKGNAME=aria2-next
PKGDES="Download utility that supports HTTP(S), FTP, BitTorrent, and Metalink"
PKGDEP="curl expat gcc-runtime glibc openssl sqlite zlib"
PKGSEC=net

ABTYPE=cmakeninja
CMAKE_AFTER=(
    "-DBUILD_TESTING=OFF"
    "-DCMAKE_INSTALL_PREFIX=/usr"
    "-DARIA2_SUPERBUILD=OFF"
    "-DARIA2_DEPENDENCY_LINKAGE=SHARED"
)

# FIXME: Error: opcode not supported on this processor: loongson3a (mips64r2)
NOLTO__LOONGSON3=1
