From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rong Bao <webmaster@csmantle.top>
Date: Mon, 9 Nov 2026 09:46:54 +0000
Subject: [PATCH 1/7] Bug 2089890 - [loong64] Allocate stack slot for
 cycle-breaking at use. r=#spidermonkey-reviewers!

This mirrors the MoveEmitterARM64 pattern.

Differential Revision: https://phabricator.services.mozilla.com/D340225
---
 js/src/jit-test/tests/wasm/simd/move-cycle.js | 45 +++++++++++++++++++
 js/src/jit/loong64/MoveEmitter-loong64.cpp    | 23 +++++-----
 js/src/jit/loong64/MoveEmitter-loong64.h      |  2 +-
 3 files changed, 58 insertions(+), 12 deletions(-)
 create mode 100644 js/src/jit-test/tests/wasm/simd/move-cycle.js

diff --git a/js/src/jit-test/tests/wasm/simd/move-cycle.js b/js/src/jit-test/tests/wasm/simd/move-cycle.js
new file mode 100644
index 0000000000000000000000000000000000000000..78352657afa81e383bcf8eb29dc2964959ccb181
--- /dev/null
+++ b/js/src/jit-test/tests/wasm/simd/move-cycle.js
@@ -0,0 +1,45 @@
+// |jit-test| skip-if: !wasmSimdEnabled()
+
+// A loop back edge that shifts a chain of v128 locals makes the register
+// allocator emit a parallel move of SIMD128 values containing a cycle, which
+// the move emitter must break.
+
+const pattern = 0xdeadbeefcafebaben;
+const lo = Number(pattern & 0xffffffffn);
+const hi = Number(pattern >> 32n);
+
+const { mem, f } = wasmEvalText(`(module
+  (memory (export "mem") 1)
+  (func (export "f") (param i32) (result i32)
+    (local $i i32)
+    (local $v0 v128)
+    (local $v1 v128)
+    (local $v2 v128)
+    (local $v3 v128)
+    (local $v4 v128)
+    (local $v5 v128)
+    (local.set $v0 (v128.load (i32.const 0)))
+    (local.set $v1 (v128.load (i32.const 16)))
+    (local.set $v2 (v128.load (i32.const 32)))
+    (local.set $v3 (v128.load (i32.const 48)))
+    (local.set $v4 (v128.load (i32.const 64)))
+    (local.set $v5 (v128.load (i32.const 80)))
+    (loop $L
+      (local.set $v0 (local.get $v1))
+      (local.set $v1 (local.get $v2))
+      (local.set $v2 (local.get $v3))
+      (local.set $v3 (local.get $v4))
+      (local.set $v4 (local.get $v5))
+      (local.set $v5 (v128.load (i32.const 128)))
+      (local.set $i (i32.add (local.get $i) (i32.const 1)))
+      (br_if $L (i32.lt_s (local.get $i) (i32.const 10))))
+    (i32x4.extract_lane 0 (i32x4.add (local.get $v0) (local.get $v5)))))`)
+  .exports;
+
+const words = new Uint32Array(mem.buffer);
+for (let i = 0; i < words.length; i += 2) {
+  words[i] = lo;
+  words[i + 1] = hi;
+}
+
+assertEq(f(0), (lo + lo) | 0);
diff --git a/js/src/jit/loong64/MoveEmitter-loong64.cpp b/js/src/jit/loong64/MoveEmitter-loong64.cpp
index bd0a272402044dca6bbe9db444af50ba4a2f7bf4..de06f807e3b92006b4fdab8b1c1b7278e19db226 100644
--- a/js/src/jit/loong64/MoveEmitter-loong64.cpp
+++ b/js/src/jit/loong64/MoveEmitter-loong64.cpp
@@ -234,15 +234,6 @@ void MoveEmitterLOONG64::emit(const MoveResolver& moves) {
       // We're lucky to have more than two spare scratch registers still
       // available. Grab another one as temporary storage for breaking cycles.
       cycleGeneralReg_ = temps.Acquire();
-    } else {
-      // Reserve stack for cycle resolution
-#if defined(ENABLE_JIT_SIMD)
-      static_assert(SpillSlotSize == 16);
-#else
-      static_assert(SpillSlotSize == 8);
-#endif
-      masm.reserveStack(SpillSlotSize);
-      pushedAtCycle_ = masm.framePushed();
     }
   }
 
@@ -253,8 +244,18 @@ void MoveEmitterLOONG64::emit(const MoveResolver& moves) {
   cycleGeneralReg_ = InvalidReg;
 }
 
-Address MoveEmitterLOONG64::cycleSlot() const {
-  MOZ_ASSERT(pushedAtCycle_ != -1, "pushedAtCycle_ not initialized");
+Address MoveEmitterLOONG64::cycleSlot() {
+  // Allocate a slot for breaking cycles if we have not already
+  if (pushedAtCycle_ == -1) {
+#if defined(ENABLE_JIT_SIMD)
+    static_assert(SpillSlotSize == 16);
+#else
+    static_assert(SpillSlotSize == 8);
+#endif
+    masm.reserveStack(SpillSlotSize);
+    pushedAtCycle_ = masm.framePushed();
+  }
+
   const int32_t offset = masm.framePushed() - pushedAtCycle_;
   MOZ_ASSERT(is_intN(offset, 12));
   return Address(StackPointer, offset);
diff --git a/js/src/jit/loong64/MoveEmitter-loong64.h b/js/src/jit/loong64/MoveEmitter-loong64.h
index c3a7583763ea975655f55678a1dbcf76d8f1c5c8..81817741071c830c63af76bd8687bd43cde8da32 100644
--- a/js/src/jit/loong64/MoveEmitter-loong64.h
+++ b/js/src/jit/loong64/MoveEmitter-loong64.h
@@ -35,7 +35,7 @@ class MoveEmitterLOONG64 {
   bool inCycle_ = false;
 
   void assertDone() { MOZ_ASSERT(!inCycle_); }
-  Address cycleSlot() const;
+  Address cycleSlot();
   int32_t getAdjustedOffset(const MoveOperand& operand) const;
   Address getAdjustedAddress(const MoveOperand& operand) const;
 

