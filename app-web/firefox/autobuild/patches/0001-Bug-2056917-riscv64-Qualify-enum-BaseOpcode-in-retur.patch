From 61f61a7b0e919b6283f315802fc9242e3c41802c Mon Sep 17 00:00:00 2001
From: Rong Bao <webmaster@csmantle.top>
Date: Wed, 22 Jul 2026 23:01:52 +0800
Subject: [PATCH 1/4] Bug 2056917 - [riscv64] Qualify enum BaseOpcode in return
 type position in InstructionBase. r=jandem!

Differential Revision: https://phabricator.services.mozilla.com/D313478
---
 js/src/jit/riscv64/base/Instruction.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/js/src/jit/riscv64/base/Instruction.h b/js/src/jit/riscv64/base/Instruction.h
index e146a7af8f5e444bb2d6dac8b201b3407132ca73..889d7622974fe45ab700b14cafb2a566e81c1df1 100644
--- a/js/src/jit/riscv64/base/Instruction.h
+++ b/js/src/jit/riscv64/base/Instruction.h
@@ -124,13 +124,13 @@ class InstructionBase {
   }
 
   // Accessors for the different named fields used in the RISC-V encoding.
-  inline BaseOpcode BaseOpcodeValue() const {
+  inline enum BaseOpcode BaseOpcodeValue() const {
     return static_cast<enum BaseOpcode>(
         Bits(kBaseOpcodeShift + kBaseOpcodeBits - 1, kBaseOpcodeShift));
   }
 
   // Return the fields at their original place in the instruction encoding.
-  inline BaseOpcode BaseOpcodeFieldRaw() const {
+  inline enum BaseOpcode BaseOpcodeFieldRaw() const {
     return static_cast<enum BaseOpcode>(InstructionBits() & kBaseOpcodeMask);
   }
 

