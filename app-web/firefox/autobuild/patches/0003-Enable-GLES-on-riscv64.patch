From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Han Gao <rabenda.cn@gmail.com>
Date: Wed, 1 Oct 2025 21:48:27 +0800
Subject: [PATCH 3/4] Enable GLES on riscv64.

---
 toolkit/xre/gfxtest/glxtest.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/toolkit/xre/gfxtest/glxtest.cpp b/toolkit/xre/gfxtest/glxtest.cpp
index 17709c0e9a3a5d8b93c941903c47bd26fd9ea2e2..cd0f7d296150a267292459889cdd4a66cf040572 100644
--- a/toolkit/xre/gfxtest/glxtest.cpp
+++ b/toolkit/xre/gfxtest/glxtest.cpp
@@ -513,7 +513,7 @@ static bool get_egl_gl_status(EGLDisplay dpy,
   PFNGLGETSTRING glGetString =
       cast<PFNGLGETSTRING>(eglGetProcAddress("glGetString"));
 
-#if defined(__arm__) || defined(__aarch64__)
+#if defined(__arm__) || defined(__aarch64__) || (defined(__riscv) && __riscv_xlen == 64)
   bool useGles = true;
 #else
   bool useGles = false;
