+++ b/Telegram/SourceFiles/core/core_settings.h
@@ -1183,11 +1183,7 @@ private:
 	rpl::variable<Media::OrderMode> _playerOrderMode;
 	bool _macWarnBeforeQuit = true;
 	std::vector<uint64> _accountsOrder;
