From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: miwu04 <me@alanlin.icu>
Date: Fri, 8 May 2026 19:32:31 +0800
Subject: [PATCH 2/4] AOSCOS: Adjust mozconfig

- Set prefix to /usr.
- Disable updater.
- Update dependency settings.
- Disable boostrapping.
- Disable Clang plugins, since we might not be using Clang at all.
- Disable explicit --{enable,disable}-lto, since Autobuild4 supplies its
  own LTO flags.

Author: Jiangjin Wang <the@salted.fish>
Co-authored-by: Rong Bao <rong.bao@csmantle.top>
---
 configs/common/mozconfig | 13 --------
 configs/linux/mozconfig  | 65 +++++++++++++++++-----------------------
 2 files changed, 28 insertions(+), 50 deletions(-)

diff --git a/configs/common/mozconfig b/configs/common/mozconfig
index 99fb2b98eb415638660f1f99a20fe7eeced07f94..5af38056e7bb5e87459242bd9d1e472c2b06ed4a 100644
--- a/configs/common/mozconfig
+++ b/configs/common/mozconfig
@@ -6,9 +6,6 @@
 ac_add_options --with-app-name=${binName}
 ac_add_options --with-app-basename=Zen
 
-# Localization (Must be an absolute path)
-ac_add_options --with-l10n-base="${topsrcdir}/browser/locales"
-
 export MOZ_APP_BASENAME=Zen
 export MOZ_BRANDING_DIRECTORY=${brandingDir}
 export MOZ_OFFICIAL_BRANDING_DIRECTORY=${brandingDir}
@@ -51,9 +48,6 @@ if test -f "$HOME/.zen-keys/google_location_service.dat"; then
 fi
 
 if test "$ZEN_RELEASE"; then
-
-  ac_add_options --enable-clang-plugin
-  
   if ! test "$ZEN_DISABLE_BOOTSTRAP"; then
     ac_add_options --enable-bootstrap=-sccache
   fi
@@ -71,13 +65,6 @@ if test "$ZEN_RELEASE"; then
   ac_add_options --disable-geckodriver
   ac_add_options --disable-rust-tests
 
-  if test "$ZEN_DISABLE_LTO"; then
-    ac_add_options --disable-lto
-  else
-    export MOZ_LTO=cross,thin
-    ac_add_options --enable-lto=cross,thin
-  fi
-
   mk_add_options MOZILLA_OFFICIAL=1
   MOZILLA_OFFICIAL=1
   export MOZILLA_OFFICIAL=1
diff --git a/configs/linux/mozconfig b/configs/linux/mozconfig
index d5d97ece4c7abdc0024ad934ceebda8f9729f477..003f441ddf6f4b4c98ccc6866e15bafbac4f168c 100644
--- a/configs/linux/mozconfig
+++ b/configs/linux/mozconfig
@@ -2,45 +2,36 @@
 # License, v. 2.0. If a copy of the MPL was not distributed with this
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-# Use the old libstdc++ ABI, matching upstream Firefox
-# (build/unix/mozconfig.stdcxx). Upstream keeps old-distro compatibility this
-# way. Without it, the Firefox 144 base (GCC 10 libstdc++ headers, bug 1981921)
-# makes our binaries require GLIBCXX_3.4.26, which glibc 2.28 systems lack.
-export MOZ_STDCXX_COMPAT=1
+# Disable DMD and necko-wifi
+ac_add_options --disable-dmd
+ac_add_options --disable-necko-wifi
 
-if test "$ZEN_RELEASE"; then
-    if test "$SURFER_COMPAT" = "x86_64"; then
-        ac_add_options --target=x86_64-pc-linux
-        ac_add_options --enable-eme=widevine
+# Common options
+ac_add_options --enable-alsa
+ac_add_options --enable-pulseaudio
 
-        # Enable Profile Guided Optimization
-        if ! test "$ZEN_GA_DISABLE_PGO"; then
-            export MOZ_LTO=cross,full
-            ac_add_options --enable-lto=cross,full
+# Basic path definitions.
+ac_add_options --prefix=/usr
+ac_add_options --libdir=/usr/lib
 
-            if test "$ZEN_GA_GENERATE_PROFILE"; then
-                mk_add_options "export MOZ_AUTOMATION_PACKAGE_GENERATED_SOURCES=0"
-                ac_add_options --enable-profile-generate=cross
-            else
-                ac_add_options --enable-profile-use=cross
-                ac_add_options --with-pgo-profile-path="$(echo ~)/artifact/merged.profdata"
-                ac_add_options --with-pgo-jarlog="$(echo ~)/artifact/en-US.log"
-            fi
-        fi
-    elif test "$SURFER_COMPAT" = "aarch64"; then
-        ac_add_options --target=aarch64-linux-gnu
+# Toolchain settings.
+ac_add_options --disable-strip
+ac_add_options --disable-install-strip
+ac_add_options --enable-hardening
 
-        # override LTO settings
-        export MOZ_LTO=cross,thin
-        ac_add_options --enable-lto=cross,thin
-    fi
+# Dependencies.
+ac_add_options --disable-bootstrap
+ac_add_options --enable-system-ffi
+ac_add_options --without-system-jpeg
+ac_add_options --with-system-libevent
+ac_add_options --with-system-libvpx
+ac_add_options --with-system-nspr
+ac_add_options --with-system-nss
+ac_add_options --with-system-zlib
+ac_add_options --without-system-icu
 
-    # Disable DMD and ELF hacks, enable linker lld
-    ac_add_options --enable-linker=lld
-    ac_add_options --disable-elf-hack
-
-    # Stripping options for release builds
-    ac_add_options --enable-install-strip
-    ac_add_options --enable-strip
-    export STRIP_FLAGS="--strip-debug --strip-unneeded"
-fi
+# Features.
+ac_add_options --enable-chrome-format=omni
+ac_add_options --enable-js-shell
+ac_add_options --disable-tests
+ac_add_options --disable-updater
