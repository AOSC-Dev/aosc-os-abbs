From 66af32b63e04e193a904c905854e32fb53baf980 Mon Sep 17 00:00:00 2001
From: huhubun <nongzc@outlook.com>
Date: Thu, 25 Dec 2025 02:04:43 +0800
Subject: [PATCH] Run selected steps only on x86_64 and aarch64

---
 configs/common/mozconfig | 6 ++++--
 configs/linux/mozconfig  | 6 +++++-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/configs/common/mozconfig b/configs/common/mozconfig
index 952c6c6..836b5f7 100644
--- a/configs/common/mozconfig
+++ b/configs/common/mozconfig
@@ -53,8 +53,10 @@ if test "$ZEN_RELEASE"; then
   ac_add_options --disable-debug-js-modules
   ac_add_options --disable-tests
 
-  ac_add_options --enable-rust-simd
-  ac_add_options --enable-wasm-simd
+  if test "$SURFER_COMPAT" = "x86_64" || test "$SURFER_COMPAT" = "aarch64"; then
+    ac_add_options --enable-rust-simd
+    ac_add_options --enable-wasm-simd
+  fi
 
   mk_add_options MOZ_PARALLEL_COMPILE=1
 
diff --git a/configs/linux/mozconfig b/configs/linux/mozconfig
index ad14bfc..8adf166 100644
--- a/configs/linux/mozconfig
+++ b/configs/linux/mozconfig
@@ -46,7 +46,11 @@ if test "$ZEN_RELEASE"; then
     # Disable DMD and ELF hacks, enable linker lld
     ac_add_options --disable-dmd
     ac_add_options --enable-linker=lld
-    ac_add_options --disable-elf-hack
+
+    if test "$SURFER_COMPAT" = "x86_64" || test "$SURFER_COMPAT" = "aarch64"; then
+        ac_add_options --disable-elf-hack
+    fi
+
     ac_add_options --disable-necko-wifi
 
     # Stripping options for release builds
-- 
2.52.0

