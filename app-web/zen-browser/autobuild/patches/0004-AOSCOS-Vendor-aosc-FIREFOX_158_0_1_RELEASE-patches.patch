+   asm("brk #0");
++#elif defined(__riscv)
++  asm("ebreak");
++#elif defined(__loongarch__)
++  asm("break 0");
+ #elif defined(SOLARIS)
+ #  if defined(__i386__) || defined(__i386) || defined(__x86_64__)
