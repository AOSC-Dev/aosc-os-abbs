PKGNAME=zen-browser
PKGSEC=web
PKGDES="A Firefox-based browser with the aim of improving your productivity"
PKGDEP="gtk-3 startup-notification dbus-glib alsa-lib \
        desktop-file-utils hicolor-icon-theme libevent nss sqlite \
        networkmanager mozilla-common ffmpeg openh264"
BUILDDEP="autoconf-2.13 rustc unzip llvm mercurial nodejs libnotify \
          xorg-server nasm yasm cbindgen llvm-runtime+wasi libvips"

ABTYPE=self
USECLANG=1

# FIXME: Causes crashes on loongson3.
USECLANG__LOONGSON3=0
# FIXME: Causes unexpected dynamic symbols in libglean_ffi.so
NOLTO__LOONGSON3=1
# FIXME: Causes SIGSEGV when building on loongson3.
BUILDDEP__LOONGSON3="${BUILDDEP/nodejs/nodejs-24}"

# FIXME: STL code can only be used with -fno-exceptions
AB_FLAGS_EXC=0

# Retro architectures should not use mainline Firefox
# Too heavy for your average 512M-RAM 2K0300
FAIL_ARCH="@(retro|loongarch64_nosimd)"
