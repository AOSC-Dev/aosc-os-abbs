PKGNAME=zen-browser
PKGSEC=web
PKGDEP="gtk-3 startup-notification dbus-glib alsa-lib \
        desktop-file-utils hicolor-icon-theme libevent nss hunspell \
        sqlite networkmanager ffmpeg icu openh264 libvips"
BUILDDEP="nodejs-22 python-3 pip dos2unix yasm nasm gcc gtk-2 \
          m4 util-linux alsa-lib curl dbus libdrm gtk-3 pkg-config \
          pulseaudio x11-lib xorg-server llvm libvips rustc cbindgen"
PKGDES="Firefox-based browser offering a calmer internet experience"

USECLANG=1

# FIXME: Disable Clang on ppc64el to avoid build failures:
#   clang: error: unknown argument: '-mminimal-toc' 
USECLANG__PPC64EL=0

# FIXME: STL code can only be used with -fno-exceptions
AB_FLAGS_EXC=0
