# Enable release-specific mozconfig settings and optimizations for Zen
export ZEN_RELEASE=1

# Keep consistent with Zen's official GitHub Actions build configuration
export ZEN_GA_DISABLE_PGO=1

# Specify the build platform for the Zen build tool (surfer)
export SURFER_PLATFORM="linux" 

# Specify the target CPU architecture for the Zen build tool (surfer)
if ab_match_arch amd64; then
    export SURFER_COMPAT="x86_64"
elif ab_match_arch arm64; then
    export SURFER_COMPAT="aarch64"
fi

abinfo "Preparing mozconfig ..."
cp -v "$SRCDIR"/autobuild/mozconfig "$SRCDIR"/mozconfig
