abinfo "Setting up dependencies via npm ..."
npm install

abinfo "Loading Surfer CI setup ..."
npm run surfer -- ci --brand release

abinfo "Downloading Firefox source and dependencies ..."
npm run download

abinfo "Importing resources ..."
npm run import

abinfo "Building language packs ..."
chmod -v +x "$SRCDIR"/scripts/*
sh "$SRCDIR"/scripts/download-language-packs.sh

abinfo "Building application ..."
npm run build

abinfo "Packaging build artifacts ..."
npm run package

abinfo "Installing application files ..."
mkdir -pv "$PKGDIR/usr/lib/$PKGNAME"
tar \
    -xvf "$(cat $SRCDIR/dist/package_name.txt)" \
    -C "$PKGDIR/usr/lib/$PKGNAME" \
    --strip-components=1

abinfo "Creating executable symlink ..."
mkdir -pv "$PKGDIR"/usr/bin/
ln -sv "../lib/$PKGNAME/zen" "$PKGDIR/usr/bin/$PKGNAME"

abinfo "Installing desktop entry ..."
install -Dvm644 "$SRCDIR/build/AppDir/zen.desktop" "$PKGDIR/usr/share/applications/$PKGNAME.desktop"

abinfo "Installing application icons ..."
for size in 16 22 24 32 48 64 128 256 512 1024; do
    install -Dvm644 "$SRCDIR/configs/branding/release/logo${size}.png" \
        "$PKGDIR/usr/share/icons/hicolor/${size}x${size}/apps/$PKGNAME.png"
done

abinfo "Installing distribution files ..."
cp -rv "$SRCDIR"/build/AppDir/distribution/ "$PKGDIR/usr/lib/$PKGNAME/"
