if ab_match_archgroup mainline_tier1; then
    abinfo "Enabling PGO for primary architectures (amd64, arm64, loongarch64) ..."
    export AOSC_PGO=1
fi

if ab_match_arch loongson3; then
    abinfo "Disabling LTO for loongson3 ..."
    export AOSC_LTO=
elif ab_match_arch riscv64; then
    abinfo "Disabling LTO for riscv64 ..."
    export AOSC_LTO=
else
    abinfo "Enabling LTO ..."
    export AOSC_LTO=1
fi

export SURFER_PLATFORM="linux"
export ZEN_RELEASE=1
export ZEN_RELEASE_BRANCH="release"
export ZEN_DISABLE_BOOTSTRAP=1
if ab_match_archgroup mainline_tier1; then
    abinfo "Building zen-browser with headless PGO ..."
    xvfb-run npm run build
else
    abinfo "Building zen-browser ..."
    npm run build
fi

abinfo "Building multi-locale package ..."
ALL_LOCALES=""
for LANG_CODE in $(cat "${SRCDIR}/lang-codes"); do
    ALL_LOCALES="$ALL_LOCALES ${LANG_CODE}"
done
./engine/mach package-multi-locale --locales $ALL_LOCALES
DIST_DIR="$(realpath "${SRCDIR}"/engine/obj-*/dist)"
PKG="${DIST_DIR}/$(cat "${DIST_DIR}/package_name.txt")"

abinfo "Unpacking multi-locale package..."
mkdir -pv "$PKGDIR/usr/lib"
tar -xvf "${PKG}" -C "$PKGDIR/usr/lib"
