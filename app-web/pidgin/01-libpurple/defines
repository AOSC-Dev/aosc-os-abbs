PKGNAME=libpurple
PKGSEC=libs
PKGDEP="avahi ca-certs cyrus-sasl dbus-glib dbus-python farstream gstreamer \
        libgadu libidn tk libnsl2 evolution-data-server gnutls"
PKGDEP__RETRO="ca-certs cyrus-sasl dbus-glib gnutls libidn libnsl2"
BUILDDEP="gtkspell intltool ncurses startup-notification libgnt"
BUILDDEP__RETRO="gtk-2 intltool ncurses libgnt"
PKGDES="Instant Messaging runtime libraries for Pidgin"

PKGBREAK="pidgin<=2.10.11-2"
PKGREP="pidgin<=2.10.11-2"

# Note: --enable-missing-dependencies ensures that configure aborts upon
# missing dependencies.
#
# Note: --disable-mono, Mono support is experimental.
AUTOTOOLS_AFTER=(
    '--enable-largefile'
    '--enable-nls'
    '--enable-missing-dependencies'
    '--enable-gtkui'
    '--enable-consoleui'
    '--enable-screensaver'
    '--enable-sm'
    '--enable-startup-notification'
    '--enable-gtkspell'
    '--enable-gevolution'
    '--enable-cap'
    '--enable-gestures'
    '--disable-schemas-install'
    '--enable-gstreamer'
    '--enable-gstreamer-video'
    '--enable-gstreamer-interfaces'
    '--enable-farstream'
    '--enable-vv'
    '--enable-idn'
    '--disable-meanwhile'
    '--enable-avahi'
    '--enable-plugins'
    '--enable-fortify'
    '--enable-dbus'
    '--enable-nm'
    '--disable-unity'
    '--disable-mono'
    '--enable-perl'
    '--enable-gnutls'
    '--disable-nss'
    '--enable-tcl'
    '--enable-tk'
    '--enable-cyrus-sasl'
    '--enable-pixmaps-install'
    '--enable-trayicon-compat'
    '--disable-doxygen'
    '--enable-dot'
    '--enable-devhelp'
    '--disable-fuzzing'
    '--disable-debug'
    '--with-x'
    '--with-gstreamer=1.0'
    '--with-system-ssl-certs=/etc/ssl/certs'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--enable-gnutls'
    '--disable-avahi'
    '--disable-gevolution'
    '--disable-gstreamer'
    '--disable-gtkspell'
    '--disable-perl'
    '--disable-startup-notification'
    '--disable-tcl'
    '--disable-tk'
    '--disable-vv'
)
