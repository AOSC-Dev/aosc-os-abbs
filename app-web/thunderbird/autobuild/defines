PKGNAME=thunderbird
PKGSEC=web
PKGDEP="alsa-lib dbus-glib desktop-file-utils gtk-2 hicolor-icon-theme \
        libevent libvpx mime-types sqlite startup-notification \
        libcanberra pulseaudio nettle nss nspr libffi openh264"
BUILDDEP="wireless-tools inetutils imake rustc llvm marco \
          nodejs nasm yasm cbindgen llvm-runtime+wasi"
PKGDES="Standalone mail and news reader from Mozilla"

PKGBREAK="thunderbird-i18n<=38.5.0"
PKGREP="thunderbird-i18n<=38.5.0"

USECLANG=1

# FIXME: Causes crashes on loongson3.
USECLANG__LOONGSON3=0
# FIXME: Causes unexpected dynamic symbols in libglean_ffi.so
NOLTO__LOONGSON3=1
# FIXME: Causes SIGSEGV when building on loongson3.
BUILDDEP__LOONGSON3="${BUILDDEP/nodejs/nodejs-24}"

# FIXME: STL code can only be used with -fno-exceptions
AB_FLAGS_EXC=0

# Retro architectures should not use mainline Firefox
# Too heavy for your average 512M-RAM 2K0300
FAIL_ARCH="@(retro|loongarch64_nosimd)"
