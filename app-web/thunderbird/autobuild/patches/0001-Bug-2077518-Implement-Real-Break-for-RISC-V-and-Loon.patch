From: Rong Bao <webmaster@csmantle.top>
Date: Tue, 6 Oct 2026 17:51:15 +0000
Subject: [PATCH 01/11] Bug 2077518 - Implement {,Real}Break() for RISC-V and
 LoongArch. r=nika!

Differential Revision: https://phabricator.services.mozilla.com/D330364
---
 xpcom/base/nsDebugImpl.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/xpcom/base/nsDebugImpl.cpp b/xpcom/base/nsDebugImpl.cpp
index 55e64fc59ea009e2e8e374414e6b96d45c8f4d7e..c3b82b562d6c3bdda547fca8b6aa0ff380904056 100644
--- a/xpcom/base/nsDebugImpl.cpp
+++ b/xpcom/base/nsDebugImpl.cpp
@@ -564,6 +564,10 @@ static void RealBreak() {
       "BKPT #0");
 #elif defined(__aarch64__)
   asm("brk #0");
+#elif defined(__riscv)
+  asm("ebreak");
+#elif defined(__loongarch__)
+  asm("break 0");
 #elif defined(SOLARIS)
 #  if defined(__i386__) || defined(__i386) || defined(__x86_64__)
   asm("int $3");
@@ -644,6 +648,10 @@ static void Break(const char* aMsg) {
   RealBreak();
 #elif defined(__arm__) || defined(__aarch64__)
   RealBreak();
+#elif defined(__riscv)
+  RealBreak();
+#elif defined(__loongarch__)
+  RealBreak();
 #elif defined(SOLARIS)
   RealBreak();
 #else

