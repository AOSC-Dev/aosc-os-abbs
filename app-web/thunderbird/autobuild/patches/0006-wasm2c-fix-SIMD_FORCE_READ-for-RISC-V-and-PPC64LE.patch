From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rong Bao <rong.bao@csmantle.top>
Date: Wed, 14 Oct 2026 22:06:59 +0800
Subject: [PATCH 06/10] wasm2c: fix SIMD_FORCE_READ for RISC-V and PPC64LE

Link: https://github.com/WebAssembly/wabt/pull/2878
Link: https://github.com/WebAssembly/wabt/pull/2880
---
 .../src/prebuilt/wasm2c_simd_source_declarations.cc       | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/third_party/wasm2c/src/prebuilt/wasm2c_simd_source_declarations.cc b/third_party/wasm2c/src/prebuilt/wasm2c_simd_source_declarations.cc
index 659bfdf73a098483dd026336d7ccd9e1735ac2ac..b547ba5900b247906a0f17be9531116770ac7648 100644
--- a/third_party/wasm2c/src/prebuilt/wasm2c_simd_source_declarations.cc
+++ b/third_party/wasm2c/src/prebuilt/wasm2c_simd_source_declarations.cc
@@ -16,7 +16,7 @@ R"w2c_template(#elif defined(__aarch64__)
 )w2c_template"
 R"w2c_template(#define SIMD_FORCE_READ(var) __asm__("" ::"w"(var));
 )w2c_template"
-R"w2c_template(#elif defined(__riscv)
+R"w2c_template(#elif defined(__riscv) && defined(__riscv_vector)
 )w2c_template"
 R"w2c_template(#define SIMD_FORCE_READ(var) __asm__("" ::"vr"(var));
 )w2c_template"
@@ -24,9 +24,13 @@ R"w2c_template(#elif defined(__s390x__)
 )w2c_template"
 R"w2c_template(#define SIMD_FORCE_READ(var) __asm__("" ::"d"(var));
 )w2c_template"
+R"w2c_template(#elif defined(__powerpc64__) || defined(__ppc64__)
+)w2c_template"
+R"w2c_template(#define SIMD_FORCE_READ(var) __asm__("" ::"v"(var));
+)w2c_template"
 R"w2c_template(#else
 )w2c_template"
-R"w2c_template(#define SIMD_FORCE_READ(var) __asm__("" ::"f"(var));
+R"w2c_template(#define SIMD_FORCE_READ(var) __asm__("" ::"m"(var));
 )w2c_template"
 R"w2c_template(#endif
 )w2c_template"
