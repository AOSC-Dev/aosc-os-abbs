PKGNAME=wget
PKGDES="Utility to retrieve files from networks and the Internet"
PKGSEC=web

PKGDEP="openssl glibc libidn2"
PKGDEP__RETRO="openssl glibc"

AUTOTOOLS_AFTER=(
    '--with-ssl=openssl'
    '--enable-nls'
    '--disable-rpath'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-iri'
    '--disable-pcre'
    '--disable-pcre2'
)
