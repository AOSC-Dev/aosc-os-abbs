abinfo "Installing dependencies ..."
pnpm ci

abinfo "Building web assets ..."
pnpm run build

abinfo "Building Sable Electron app ..."
cd "$SRCDIR"/electron 
pnpm run package --linux --dir

abinfo "Installing Sable ..."
mkdir -pv "$PKGDIR"/usr/lib/sable/
cp -rv "$SRCDIR"/electron/release/linux*-unpacked/* \
    "$PKGDIR"/usr/lib/sable/

abinfo "Creating symlink /usr/bin/sable -> ../lib/sable/sable"
mkdir -pv "$PKGDIR"/usr/bin/
ln -sv ../lib/sable/sable "$PKGDIR"/usr/bin/sable
