abinfo "Setting 'stable' build flavour ..."
export SABLE_BUILD_FLAVOR=stable

abinfo "Setting application version ..."
export VITE_APP_VERSION="$PKGVER"

# NOTE: sable requires wasm32-unknown-unknown target to compile
abinfo "Installing Rust wasm32-unknown-unknown target ..."
export RUSTUP_INIT_SKIP_PATH_CHECK=yes
curl https://sh.rustup.rs -sSf | sh -s -- --target wasm32-unknown-unknown -y
export PATH="$HOME"/.cargo/bin:"$PATH"

# NOTE: sable compiles its rust modules targeting wasm32-unknown-unknown, we
# need to unset CFLAGS targeting the host architecture to build ring for
# wasm32-unknown-unknown.
#
# warning: ring@0.17.14: clang: error: unsupported option '-march=' for target
# 'wasm32-unknown-unknown'
# warning: ring@0.17.14: clang: error: unsupported option '-msse2' for target
# 'wasm32-unknown-unknown'
abinfo "Unsetting CFLAGS ..."
unset CFLAGS
