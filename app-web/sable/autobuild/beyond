abinfo "Installing desktop entry ..."
install -Dvm644 "$SRCDIR"/packaging/flatpak/moe.sable.client.desktop \
    -t "$PKGDIR"/usr/share/applications/

abinfo "Installing AppStream MetaInfo ..."
install -Dvm644 "$SRCDIR"/packaging/flatpak/moe.sable.client.metainfo.xml \
    -t "$PKGDIR"/usr/share/metainfo/

abinfo "Installing icons ..."
for size in 32 64 128 256; do
    install -Dvm644 "$SRCDIR"/packaging/flatpak/icons/"$size"x"$size".png \
        "$PKGDIR"/usr/share/icons/hicolor/"$size"x"$size"/apps/moe.sable.client.png
done
