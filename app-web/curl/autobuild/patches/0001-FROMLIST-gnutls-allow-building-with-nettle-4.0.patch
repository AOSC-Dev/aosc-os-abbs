From d00089d40d4db940fddab748b9b876d76a62a6f2 Mon Sep 17 00:00:00 2001
From: Xi Ruoyao <xry111@xry111.site>
Date: Tue, 31 Mar 2026 10:25:39 +0800
Subject: [PATCH] FROMLIST: gnutls: allow building with nettle 4.0

Link: https://github.com/curl/curl/pull/21169
Signed-off-by: Xi Ruoyao <xry111@xry111.site>
---
 lib/curl_sha512_256.c | 8 ++++++--
 lib/md5.c             | 7 ++++++-
 lib/sha256.c          | 9 +++++++--
 lib/vtls/gtls.c       | 7 ++++++-
 m4/curl-gnutls.m4     | 4 ++--
 5 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/lib/curl_sha512_256.c b/lib/curl_sha512_256.c
index 648e3e38e9..65b4bd73a9 100644
--- a/lib/curl_sha512_256.c
+++ b/lib/curl_sha512_256.c
@@ -67,7 +67,8 @@
 #endif /* USE_OPENSSL */
 
 #if !defined(HAS_SHA512_256_IMPLEMENTATION) && defined(USE_GNUTLS)
-#  include <nettle/sha.h>
+#  include <nettle/sha2.h>
+#  include <nettle/version.h>
 #  ifdef SHA512_256_DIGEST_SIZE
 #    define USE_GNUTLS_SHA512_256           1
 #  endif
@@ -237,7 +238,10 @@ static CURLcode Curl_sha512_256_finish(unsigned char *digest, void *context)
   Curl_sha512_256_ctx * const ctx = (Curl_sha512_256_ctx *)context;
 
   sha512_256_digest(ctx,
-                    (size_t)CURL_SHA512_256_DIGEST_SIZE, (uint8_t *)digest);
+#if NETTLE_VERSION_MAJOR < 4
+                    (size_t)CURL_SHA512_256_DIGEST_SIZE,
+#endif
+                    (uint8_t *)digest);
 
   return CURLE_OK;
 }
diff --git a/lib/md5.c b/lib/md5.c
index c2bd176dc9..308917bb34 100644
--- a/lib/md5.c
+++ b/lib/md5.c
@@ -47,6 +47,7 @@
 
 #ifdef USE_GNUTLS
 #include <nettle/md5.h>
+#include <nettle/version.h>
 
 typedef struct md5_ctx my_md5_ctx;
 
@@ -64,7 +65,11 @@ static void my_md5_update(void *ctx,
 
 static void my_md5_final(unsigned char *digest, void *ctx)
 {
-  md5_digest(ctx, 16, digest);
+  md5_digest(ctx,
+#if NETTLE_VERSION_MAJOR < 4
+             16,
+#endif
+             digest);
 }
 
 #elif (defined(USE_OPENSSL) && \
diff --git a/lib/sha256.c b/lib/sha256.c
index 7b063659be..81eb98e05f 100644
--- a/lib/sha256.c
+++ b/lib/sha256.c
@@ -87,7 +87,8 @@ static void my_sha256_final(unsigned char *digest, void *in)
 }
 
 #elif defined(USE_GNUTLS)
-#include <nettle/sha.h>
+#include <nettle/sha2.h>
+#include <nettle/version.h>
 
 typedef struct sha256_ctx my_sha256_ctx;
 
@@ -106,7 +107,11 @@ static void my_sha256_update(void *ctx,
 
 static void my_sha256_final(unsigned char *digest, void *ctx)
 {
-  sha256_digest(ctx, SHA256_DIGEST_SIZE, digest);
+  sha256_digest(ctx,
+#if NETTLE_VERSION_MAJOR < 4
+                SHA256_DIGEST_SIZE,
+#endif
+                digest);
 }
 
 #elif defined(USE_MBEDTLS) && \
diff --git a/lib/vtls/gtls.c b/lib/vtls/gtls.c
index a0a465c360..ce52784cdc 100644
--- a/lib/vtls/gtls.c
+++ b/lib/vtls/gtls.c
@@ -37,6 +37,7 @@
 #include <gnutls/x509.h>
 #include <gnutls/crypto.h>
 #include <nettle/sha2.h>
+#include <nettle/version.h>
 
 #include "urldata.h"
 #include "curl_trc.h"
@@ -2253,7 +2254,11 @@ static CURLcode gtls_sha256sum(const unsigned char *tmp, /* input */
   struct sha256_ctx SHA256pw;
   sha256_init(&SHA256pw);
   sha256_update(&SHA256pw, (unsigned int)tmplen, tmp);
-  sha256_digest(&SHA256pw, (unsigned int)sha256len, sha256sum);
+  sha256_digest(&SHA256pw,
+#if NETTLE_VERSION_MAJOR < 4
+                (unsigned int)sha256len,
+#endif
+                sha256sum);
   return CURLE_OK;
 }
 
diff --git a/m4/curl-gnutls.m4 b/m4/curl-gnutls.m4
index 533d72129e..3c91eb985e 100644
--- a/m4/curl-gnutls.m4
+++ b/m4/curl-gnutls.m4
@@ -144,7 +144,7 @@ if test "$GNUTLS_ENABLED" = "1"; then
   dnl ---
   USE_GNUTLS_NETTLE=
   # First check if we can detect either crypto library via transitive linking
-  AC_CHECK_LIB(gnutls, nettle_MD5Init, [ USE_GNUTLS_NETTLE=1 ])
+  AC_CHECK_LIB(gnutls, nettle_md5_init, [ USE_GNUTLS_NETTLE=1 ])
 
   # If not, try linking directly to both of them to see if they are available
   if test -z "$USE_GNUTLS_NETTLE"; then
@@ -173,7 +173,7 @@ if test "$GNUTLS_ENABLED" = "1"; then
           CPPFLAGS="$CPPFLAGS $addcflags"
         fi
 
-        AC_CHECK_LIB(nettle, nettle_MD5Init,
+        AC_CHECK_LIB(nettle, nettle_md5_init,
         [
           USE_GNUTLS_NETTLE=1
         ],
-- 
2.53.0

