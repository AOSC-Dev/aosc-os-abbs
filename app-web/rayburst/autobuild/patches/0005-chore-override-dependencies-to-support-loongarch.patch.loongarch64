From 11c18e6e674c35cb60934b7c775ac152377f5372 Mon Sep 17 00:00:00 2001
From: miwu04 <me@alanlin.icu>
Date: Sun, 11 Oct 2026 13:14:51 +0800
Subject: [PATCH 5/5] chore: override dependencies to support loongarch

---
 pnpm-lock.yaml      | 3 +++
 pnpm-workspace.yaml | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/pnpm-lock.yaml b/pnpm-lock.yaml
index 4625a095..2b9d2d06 100644
--- a/pnpm-lock.yaml
+++ b/pnpm-lock.yaml
@@ -4,6 +4,9 @@ settings:
   autoInstallPeers: true
   excludeLinksFromLockfile: false
 
+overrides:
+  oxc-parser: npm:@loongdotjs/oxc-parser@0.142.1
+
 importers:
 
   .:
diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 87bb5df8..bbed1301 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -1,6 +1,9 @@
 allowBuilds:
   esbuild: true
 
+overrides:
+  oxc-parser: npm:@loongdotjs/oxc-parser@0.142.1
+
 minimumReleaseAgeExclude:
   - '@typescript-eslint/eslint-plugin@8.61.0'
   - '@typescript-eslint/parser@8.61.0'
-- 
2.56.0

