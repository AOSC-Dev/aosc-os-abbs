abinfo "Installing dependencies..."
cd "$SRCDIR"
pnpm install

abinfo "Building rayburst..."
cargo tauri build --no-bundle

abinfo "Installing Rayburst ..."
install -Dvm755 "$SRCDIR"/src-tauri/target/release/rayburst \
    "$PKGDIR"/usr/bin/rayburst

abinfo "Installing aria2 config and data..."
install -Dvm644 "$SRCDIR"/src-tauri/binaries/aria2.conf \
    "$PKGDIR"/usr/lib/Rayburst/binaries/aria2.conf
install -Dvm644 "$SRCDIR"/src-tauri/data/ed2k-bootstrap/server.met \
    "$PKGDIR"/usr/lib/Rayburst/data/ed2k-bootstrap/server.met
install -Dvm644 "$SRCDIR"/src-tauri/data/ed2k-bootstrap/nodes.dat \
    "$PKGDIR"/usr/lib/Rayburst/data/ed2k-bootstrap/nodes.dat
install -Dvm644 "$SRCDIR"/src-tauri/data/dbip-country-lite.mmdb \
    "$PKGDIR"/usr/lib/Rayburst/data/dbip-country-lite.mmdb
install -Dvm644 "$SRCDIR"/src-tauri/data/bt-peer-blocklist.txt \
    "$PKGDIR"/usr/lib/Rayburst/data/bt-peer-blocklist.txt

abinfo "Installing application icon ..."
for i in 32 64 128; do
    install -Dvm644 "$SRCDIR"/src-tauri/icons/${i}x${i}.png \
                    "$PKGDIR"/usr/share/icons/hicolor/${i}x${i}/apps/rayburst.png
done
