PKGNAME=civetweb
PKGSEC=web
PKGDEP="glibc zlib"
PKGDES="Embedded HTTP server"

ABTYPE=cmakeninja
CMAKE_AFTER=(
    '-DBUILD_TESTING=ON'
    '-DCIVETWEB_ALLOW_WARNINGS=ON'

    # Note: Force 32/64 bit architecture
    '-DCIVETWEB_ARCH=OFF'

    '-DCIVETWEB_BUILD_TESTING=OFF'
    '-DCIVETWEB_DISABLE_CACHING=OFF'
    '-DCIVETWEB_DISABLE_CGI=OFF'
    '-DCIVETWEB_ENABLE_ASAN=OFF'

    # Note: Defaults to off.
    '-DCIVETWEB_ENABLE_CXX=OFF'
    '-DCIVETWEB_CXX_ENABLE_LTO=ON'

    '-DCIVETWEB_ENABLE_DEBUG_TOOLS=OFF'

    # FIXME: Does not support our version of Duktape.
    '-DCIVETWEB_ENABLE_DUKTAPE=OFF'

    '-DCIVETWEB_ENABLE_IPV6=ON'
    '-DCIVETWEB_ENABLE_LTO=ON'

    # FIXME: Broken system component detection, unconditionally checks
    # for vendored luafilesystem.a.
    '-DCIVETWEB_ENABLE_LUA=OFF'
    '-DCIVETWEB_ENABLE_LUA_SHARED=ON'

    '-DCIVETWEB_ENABLE_MEMORY_DEBUGGING=OFF'
    '-DCIVETWEB_ENABLE_SERVER_EXECUTABLE=ON'
    '-DCIVETWEB_ENABLE_SERVER_STATS=ON'
    '-DCIVETWEB_ENABLE_SSL=ON'
    '-DCIVETWEB_ENABLE_SSL_DYNAMIC_LOADING=ON'
    '-DCIVETWEB_ENABLE_THIRD_PARTY_OUTPUT=OFF'
    '-DCIVETWEB_ENABLE_WEBSOCKETS=ON'
    '-DCIVETWEB_ENABLE_ZLIB=ON'
    '-DCIVETWEB_SERVE_NO_FILES=OFF'
    '-DCIVETWEB_SSL_OPENSSL_API_1_0=OFF'
    '-DCIVETWEB_SSL_OPENSSL_API_1_1=OFF'
    '-DCIVETWEB_SSL_OPENSSL_API_3_0=ON'
)

# Note: Static library needed.
NOSTATIC=0
