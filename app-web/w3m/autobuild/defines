PKGNAME=w3m
PKGSEC=web
PKGDES="Console Web browser and pager"

PKGDEP="openssl gc ncurses imlib2"
PKGDEP__RETRO="openssl ncurses gc"

AUTOTOOLS_AFTER=(
    '--enable-image=x11,fb'
    '--with-imagelib=imlib2'
    '--with-termlib=ncurses'
    '--disable-w3mmailer'
)
AUTOTOOLS_AFTER__RETRO=(
    "${AUTOTOOLS_AFTER[@]}"
    '--disable-image'
    '--without-imagelib'
)
