From 06ae1a2bce0974ea1f47df1e550c643e7526a467 Mon Sep 17 00:00:00 2001
From: Mingcong Bai <jeffbai@aosc.io>
Date: Mon, 7 Apr 2025 22:25:55 +0800
Subject: [PATCH 18/21] AOSCOS: build: use medium code model for LoongArch

This is needed to fix relaxation failure during linkage.

Link: https://github.com/AOSC-Dev/chromium-loongarch64/blob/chromium-148.0.7778.180-1/chromium/chromium-148.0.7778.180.4006-loongarch64-medium-cmodel.diff
Co-authored-by: Jiajie Chen <c@jia.je>
Signed-off-by: Mingcong Bai <jeffbai@aosc.io>
---
 build/rust/gni_impl/rust_target.gni | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/build/rust/gni_impl/rust_target.gni b/build/rust/gni_impl/rust_target.gni
index 31045ee..958aa01 100644
--- a/build/rust/gni_impl/rust_target.gni
+++ b/build/rust/gni_impl/rust_target.gni
@@ -501,6 +501,9 @@ template("rust_target") {
       if (_rustc_metadata != "") {
         rustflags += [ "-Cmetadata=${_rustc_metadata}" ]
       }
+      if (current_cpu == "loong64") {
+        rustflags += [ "-Ccode-model=medium" ]
+      }
       rustenv = _rustenv
 
       sources = _rust_sources
-- 
2.54.0

