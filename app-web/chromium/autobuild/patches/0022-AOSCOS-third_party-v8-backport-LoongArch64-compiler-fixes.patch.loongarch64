+}
+
+TEST(RunSelectWord64AddOvf) {
+  for (int64_t k = -50; k < 50; k++) {
+    int64_t v_true = k % 5, v_false = k % 11;
+    BufferedRawMachineAssemblerTester<int64_t> m(MachineType::Int64(),
+                                                 MachineType::Int64());
+    if (!m.machine()->Word64Select().IsSupported()) {
+      return;
+    }
