+    Node* not_ovf = m.Word32Equal(ovf, m.Int32Constant(0));
+    m.Return(m.Word64Select(not_ovf, m.Int64Constant(v_true),
+                            m.Int64Constant(v_false)));
+    int64_t result;
+    FOR_INT64_INPUTS(i) {
+      FOR_INT64_INPUTS(j) {
+        CHECK_EQ(m.Call(i, j), base::bits::SignedSubOverflow64(i, j, &result)
+                                   ? v_false
+                                   : v_true);
+      }
+    }
+  }
+}
