+        m.Word64Select(ovf, m.Int64Constant(v_true), m.Int64Constant(v_false)));
+    int64_t result;
+    FOR_INT64_INPUTS(i) {
+      FOR_INT64_INPUTS(j) {
+        CHECK_EQ(m.Call(i, j), base::bits::SignedAddOverflow64(i, j, &result)
+                                   ? v_true
+                                   : v_false);
+      }
