From 15888a6d5f327cefc9d582d31cd7fa371dad018c Mon Sep 17 00:00:00 2001
From: darkyzhou <me@zqy.io>
Date: Tue, 18 Nov 2025 00:28:38 +0800
Subject: [PATCH 19/21] AOSCOS: gpu: add Loongson GPU blocklist

Disable 2d acceleration on Loongson LG100/110 graphics due to corrupted
webpage rendering.

Link: https://github.com/AOSC-Dev/chromium-loongarch64/blob/chromium-148.0.7778.180-1/chromium/chromium-148.0.7778.180.4007-loongarch64-gpu.diff
Co-authored-by: Jiajie Chen <c@jia.je>
Signed-off-by: darkyzhou <me@zqy.io>
---
 gpu/config/software_rendering_list.json | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/gpu/config/software_rendering_list.json b/gpu/config/software_rendering_list.json
index 254008f..d54bc2d 100644
--- a/gpu/config/software_rendering_list.json
+++ b/gpu/config/software_rendering_list.json
@@ -1549,6 +1549,18 @@
       "features": [
         "skia_graphite"
       ]
-    }
+    },
+    {
+      "id": 190,
+      "description": "Corrupted webpage rendering on Loongson LG100/110 graphics with 2D acceleration enabled",
+      "os": {
+        "type" : "linux"
+      },
+      "vendor_id": "0x0014",
+      "device_id": [ "0x7a36" ],
+      "features": [
+        "accelerated_2d_canvas"
+      ]
+     }
   ]
 }
-- 
2.54.0

