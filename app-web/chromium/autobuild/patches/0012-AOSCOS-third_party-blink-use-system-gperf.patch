From 171d7afb8cde601f191ee52f87cf04ca67f789b3 Mon Sep 17 00:00:00 2001
From: darkyzhou <me@zqy.io>
Date: Mon, 27 Jul 2026 20:53:56 +0800
Subject: [PATCH 12/21] AOSCOS: third_party/blink: use system gperf

Since Chromium 148, gperf_exe on Linux points to a CIPD-provided
binary, which is an x86-64 ELF and cannot run on other architectures
such as AArch64 and LoongArch. Worse, gperf.py does not check the
exit code of gperf, so the generated files (css_value_keywords.cc,
css_property_names.cc, at_rule_descriptors.cc, color_data.cc) end up
as empty stubs and the final link fails with undefined symbols like
blink::GetCSSValueName.

Use the system gperf from PATH instead, as Chromium 142 did.

Signed-off-by: darkyzhou <me@zqy.io>
---
 .../blink/renderer/build/scripts/scripts.gni |  5 ++---
 third_party/blink/renderer/core/BUILD.gn     |  6 ++----
 third_party/blink/renderer/platform/BUILD.gn |  3 +--
 3 files changed, 5 insertions(+), 9 deletions(-)

diff --git a/third_party/blink/renderer/build/scripts/scripts.gni b/third_party/blink/renderer/build/scripts/scripts.gni
index 6bba8f2..1af6bca 100644
--- a/third_party/blink/renderer/build/scripts/scripts.gni
+++ b/third_party/blink/renderer/build/scripts/scripts.gni
@@ -109,7 +109,7 @@ if (host_os == "win") {
   }
   gperf_exe = _mac_bin_path + "gperf"
 } else {
-  gperf_exe = "//third_party/gperf/cipd/bin/gperf"
+  gperf_exe = "gperf"
 }
 
 # Templates --------------------------------------------------------------------
@@ -275,9 +275,8 @@ template("css_properties") {
     }
     other_args = [
       "--gperf",
-      rebase_path(gperf_exe, root_build_dir),
+      gperf_exe,
     ]
-    sources = [ gperf_exe ]
 
     outputs = invoker.outputs
   }
diff --git a/third_party/blink/renderer/core/BUILD.gn b/third_party/blink/renderer/core/BUILD.gn
index e90757c..e3abf81 100644
--- a/third_party/blink/renderer/core/BUILD.gn
+++ b/third_party/blink/renderer/core/BUILD.gn
@@ -865,9 +865,8 @@ code_generator("make_core_generated_atrule_names") {
   ]
   other_args = [
     "--gperf",
-    rebase_path(gperf_exe, root_build_dir),
+    gperf_exe,
   ]
-  sources = [ gperf_exe ]
 }
 
 code_generator("make_core_generated_media_features") {
@@ -925,9 +924,8 @@ code_generator("make_core_generated_css_value_keywords") {
   ]
   other_args = [
     "--gperf",
-    rebase_path(gperf_exe, root_build_dir),
+    gperf_exe,
   ]
-  sources = [ gperf_exe ]
 }
 
 process_json5_files("make_core_generated_html_element_factory") {
diff --git a/third_party/blink/renderer/platform/BUILD.gn b/third_party/blink/renderer/platform/BUILD.gn
index 87f64f5..7faab18 100644
--- a/third_party/blink/renderer/platform/BUILD.gn
+++ b/third_party/blink/renderer/platform/BUILD.gn
@@ -104,7 +104,6 @@ blink_python_runner("runtime_feature_state_override_context") {
 
 blink_python_runner("color_data") {
   script = "../build/scripts/gperf.py"
-  sources = [ gperf_exe ]
 
   color_data_gperf = "color_data.gperf"
   inputs = [
@@ -116,7 +115,7 @@ blink_python_runner("color_data") {
   outputs = [ output_file ]
 
   args = [
-    rebase_path(gperf_exe, root_build_dir),
+    gperf_exe,
     "--key-positions=*",
     "-D",
     "-s",
-- 
2.54.0

