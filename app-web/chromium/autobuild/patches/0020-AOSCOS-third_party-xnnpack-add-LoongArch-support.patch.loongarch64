From db81f04f885fd694148257b9fc1ec0f017a0f4bf Mon Sep 17 00:00:00 2001
From: darkyzhou <me@zqy.io>
Date: Sun, 14 Dec 2025 11:27:51 +0800
Subject: [PATCH 20/21] AOSCOS: third_party/xnnpack: add LoongArch support

BUILD.gn is generated by running `python3 generate_build_gn.py`.

Signed-off-by: darkyzhou <me@zqy.io>
---
 third_party/xnnpack/BUILD.gn                  | 19296 +++++++++++-----
 third_party/xnnpack/bazelroot/BUILD           |    13 +
 third_party/xnnpack/generate_build_gn.py      |     8 +-
 third_party/xnnpack/src/src/xnnpack/common.h  |     6 +
 .../xnnpack/src/src/xnnpack/hardware-config.h |     3 +
 5 files changed, 13475 insertions(+), 5851 deletions(-)

diff --git a/third_party/xnnpack/BUILD.gn b/third_party/xnnpack/BUILD.gn
index b7200d0..742ed8f 100644
--- a/third_party/xnnpack/BUILD.gn
+++ b/third_party/xnnpack/BUILD.gn
@@ -1992,6 +1992,268 @@ if (current_cpu == "x64" || current_cpu == "x86") {
       ":xx-transposev_riscv64_standalone",
     ]
   }
+} else if (current_cpu == "loong64") {
+  if (build_with_chromium) {
+    xnnpack_deps = [
