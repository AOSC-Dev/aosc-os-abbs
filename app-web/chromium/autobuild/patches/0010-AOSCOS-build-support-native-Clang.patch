From 5b8c5d40b9ee484751131049e969656215b10566 Mon Sep 17 00:00:00 2001
From: darkyzhou <me@zqy.io>
Date: Tue, 21 Jul 2026 22:16:00 +0800
Subject: [PATCH 10/21] AOSCOS: build: support native Clang

Chromium 148 enables flags that are only implemented by Chromium's patched
Clang builds. Restrict them to the official Chromium Clang base path so
distro LLVM builds can use native compilers.

Signed-off-by: darkyzhou <me@zqy.io>
---
 build/config/compiler/BUILD.gn | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index f2b1544..a066fa1 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -627,8 +627,8 @@ config("compiler") {
 
     # The performance improvement does not seem worth the risk. See
     # https://crbug.com/484082200 for background and https://crrev.com/c/7593035
-    # for discussion.
-    if (!is_wasm) {
+    # for discussion. This flag is currently Chromium-clang-only.
+    if (!is_wasm && clang_base_path == default_clang_base_path) {
       cflags += [ "-fno-lifetime-dse" ]
     }
 
@@ -1901,7 +1901,8 @@ config("clang_warning_suppression") {
 #
 # See also: https://crbug.com/40891132#comment10
 config("sanitize_c_array_bounds") {
-  if (!is_ubsan && is_clang && !(is_asan && target_cpu == "x86")) {
+  if (!is_ubsan && is_clang && !(is_asan && target_cpu == "x86") &&
+      clang_base_path == default_clang_base_path) {
     cflags = [
       "-fsanitize=array-bounds",
       "-fsanitize-trap=array-bounds",
@@ -1925,7 +1926,8 @@ config("sanitize_c_array_bounds") {
 # functions (https://crbug.com/489565636). This is equivalent to inserting
 # `NOTREACHED()` at the end of such functions.
 config("sanitize_return") {
-  if (!is_ubsan && is_clang) {
+  if (!is_ubsan && is_clang &&
+      clang_base_path == default_clang_base_path) {
     cflags = [
       "-fsanitize=return",
       "-fsanitize-trap=return",
-- 
2.54.0

