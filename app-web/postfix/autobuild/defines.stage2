PKGNAME=postfix
PKGSEC=net
PKGDEP="pcre cyrus-sasl libssh tinycdb db sqlite openssl icu libnsl2"
PKGDES="A fast, easy to administer, and secure mail server"
PKGSUG="mariadb postgresql openldap"

PKGPROV="mta mail-transfer-agent"
PKGCONFL="exim<=4.85-0 opensmtpd<=5.7.3p1"

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
