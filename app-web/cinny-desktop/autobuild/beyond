    "$PKGDIR"/usr/share/icons/hicolor/128x128/apps/cinny.png
install -Dvm644 "$SRCDIR"/icons/128x128@2x.png \
    "$PKGDIR"/usr/share/icons/hicolor/256x256/apps/cinny.png
