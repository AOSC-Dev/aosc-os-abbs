PKGNAME=llhttp
PKGSEC=libs
PKGDEP="glibc"
BUILDDEP="nodejs llvm"
PKGDES="llparse-based HTTP request/response parser"

ABTYPE=cmakeninja
USECLANG=1
# FIXME: error: unable to open output file 'build/native/http.o': 'No such file or directory'
NOPARALLEL=1
# FIXME: build/c/llhttp.o: file not recognized: file format not recognized
NOLTO=1

# After `make release`, the actual source code is located in the release folder.
CMAKE_AFTER=(
    "-S $SRCDIR/release"
)

# FIXME: npm crashed when running `npm ci` without throwing errors
FAIL_ARCH="@(loongson3|retro)"
