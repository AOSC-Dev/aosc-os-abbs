PKGNAME=libsoup
PKGSEC=libs
PKGDEP="glib-networking libxml2 sqlite python-3 libpsl brotli"
BUILDDEP="gtk-doc gobject-introspection intltool vala vim httpd php samba"
BUILDDEP__RETRO="intltool"
PKGDES="HTTP client/server library for GNOME (version 2)"

MESON_AFTER=(
	"-Dgssapi=enabled"
	"-Dntlm=enabled"
	"-Dbrotli=enabled"
	"-Dtls_check=true"
	"-Dgnome=true"
	"-Dintrospection=enabled"
	"-Dvapi=enabled"
	"-Dgtk_doc=true"
	"-Dinstalled_tests=false"
	"-Dsysprof=disabled"
)

MESON_AFTER__RETRO=(
	"${MESON_AFTER[@]}"
	"-Dgtk_doc=false"
	"-Dgssapi=disabled"
	"-Dntlm=disabled"
	"-Dintrospection=disabled"
	"-Dvapi=disabled"
)

# Needed by Afterglow, whereas FAIL_ARCH defaults to mainline-only.
FAIL_ARCH="!(mainline|retro)"
